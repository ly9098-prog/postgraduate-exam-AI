# Local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases and backups
*.db
*.sqlite
*.sqlite3
*.db.backup-*
*.db.*
backend/*.db
backend/*.sqlite
backend/*.sqlite3
backend/*.db.backup-*

# Production backup dumps
backups/*
!backups/.gitkeep
*.dump
*.backup
*.sql.gz
prod_*_backup_*

# Generated runtime data
logs/*
!logs/.gitkeep
logs.txt
logs_*.txt
*.log
tmp/
cache/
uploads/
static/uploads/
backend/logs/
backend/tmp/
backend/cache/
backend/uploads/
backend/static/uploads/
backend/static/
ocr_test/

# Frontend dependencies/build output
node_modules/
dist/
build/
.next/
miniprogram/miniprogram_npm/

# IDE and local tools
.idea/
.vscode/
*.swp
.claude/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Deployment secrets
*.pem
*.key
*.crt
deploy/nginx/ssl/*.pem
deploy/nginx/ssl/*.key
deploy/nginx/ssl/*.crt
deploy/logs/

# Generated export artifacts
exports/
backend/exports/

# Dev/import artifacts & one-off scripts（本地 dev 产物，不提交；已跟踪文件不受 gitignore 影响）
# 根级锚定(/)：避免匹配 deploy/scripts 等被跟踪的子目录
/artifacts/
/scripts/
/reports/
/tools/
/utils/
/fix/

# 项目文档属于源码，应持续纳入 Git 跟踪
!docs/
!docs/**
backend/scripts/
backend/reports/
backend/tools/
backend/artifacts/
backend/backups/
backend/var/
backend/.work/
backend/requirements/
backend/wheelhouse/
backend/backend/

# Sync tool generated files
backend/sync_package.json
backend/.last_sync
!artifacts/**/office-acceptance-checklist.md

# Downloaded font files
*.ttc
*.ttf
!**/fonts/**

# Pipeline runtime artifacts
.backend_cache/
backend/.backend_cache/

# Build artifacts
backend/requirements-lock.txt
pgdata/
redisdata/

# Large test fixtures
backend/tests/fixtures/*.pdf

# Root-level screenshots and debug images
/*.png

# Staging artifacts
.staging/

# Runtime logs
logs/

# GPU OCR virtualenv (too large for git)
backend/.venv-ocr-gpu/
backend/.venv-ocr-gpu-*/
backend/backend/.venv-ocr-gpu/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
