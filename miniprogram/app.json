{
  "pages": [
    "pages/login/login",
    "pages/agreement/user",
    "pages/agreement/privacy",
    "pages/agreement/ai",
    "pages/home/home",
    "pages/dashboard/dashboard",
    "pages/pomodoro/pomodoro"
  ],
  "window": {
    "navigationBarBackgroundColor": "#4F7FFF",
    "navigationBarTitleText": "MemoGrad",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#EEF5FF"
  },
  "subPackages": [
    {
      "root": "subpackages/animation",
      "name": "animation",
      "independent": false,
      "pages": [
        "animation-index/animation-index"
      ]
    },
    {
      "root": "subpackages/formulas",
      "name": "formulas",
      "independent": false,
      "pages": [
        "library/index",
        "reader/index"
      ]
    },
    {
      "root": "subpackages/productivity",
      "name": "productivity",
      "independent": false,
      "pages": [
        "pomodoro-stats/index"
      ]
    },
    {
      "root": "subpackages/study",
      "name": "study",
      "independent": false,
      "pages": [
        "practice/practice",
        "wrong-book/wrong-book",
        "wrong-detail/wrong-detail",
        "review-today/review-today",
        "practice-result/index"
      ]
    },
    {
      "root": "subpackages/exam",
      "name": "exam",
      "independent": false,
      "pages": [
        "paper-list/index",
        "exam-runner/index",
        "result/index",
        "history/index"
      ]
    },
    {
      "root": "subpackages/export",
      "name": "export",
      "independent": false,
      "pages": [
        "export-config/export-config",
        "export-records/export-records"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/home": {
      "network": "all",
      "packages": [
        "study",
        "exam"
      ]
    },
    "pages/dashboard/dashboard": {
      "network": "all",
      "packages": [
        "study"
      ]
    },
    "pages/pomodoro/pomodoro": {
      "network": "all",
      "packages": [
        "productivity"
      ]
    }
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
