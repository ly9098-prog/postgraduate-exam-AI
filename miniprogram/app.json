{
  "pages": [
    "pages/login/login",
    "pages/agreement/user",
    "pages/agreement/privacy",
    "pages/agreement/ai",
    "pages/home/home",
    "pages/practice/practice",
    "pages/wrong-book/wrong-book",
    "pages/wrong-detail/wrong-detail",
    "pages/review-today/review-today",
    "pages/dashboard/dashboard",
    "pages/pomodoro/pomodoro",
    "pages/export-config/export-config",
    "pages/export-records/export-records"
  ],
  "window": {
    "navigationBarBackgroundColor": "#4F7FFF",
    "navigationBarTitleText": "MemoGrad",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#EEF5FF"
  },
  "subPackages": [
    {
      "root": "subpackages/animation",
      "name": "animation",
      "independent": false,
      "pages": ["animation-index/animation-index"]
    },
    {
      "root": "subpackages/formulas",
      "name": "formulas",
      "independent": false,
      "pages": [
        "library/index",
        "reader/index"
      ]
    },
    {
      "root": "subpackages/productivity",
      "name": "productivity",
      "independent": false,
      "pages": [
        "pomodoro-stats/index",
        "practice-result/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/pomodoro/pomodoro": {
      "network": "all",
      "packages": ["productivity"]
    }
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
