@import 'styles/tokens.wxss';
@import 'styles/components.wxss';

/* 全局基础 */
page {
  min-height: 100%;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  color: #18233A;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view,
image,
canvas {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}
