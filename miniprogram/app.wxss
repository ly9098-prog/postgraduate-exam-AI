@import 'styles/tokens.wxss';
@import 'styles/components.wxss';

/* 全局基础 */
page {
  min-height: 100%;
  background-color: #F7F5F0;
  color: #2D3E50;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view,
image,
canvas {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}
