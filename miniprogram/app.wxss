@import 'styles/tokens.wxss';
@import 'styles/components.wxss';
@import 'styles/practice-subject-sheet.wxss';
@import 'styles/route-transition.wxss';

/* 全局基础 */
page {
  min-height: 100%;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  color: #18233A;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
scroll-view,
image,
canvas {
  box-sizing: border-box;
}

button {
  font-family: inherit;
}

button::after {
  border: none;
}

.is-locked {
  opacity: .58;
  filter: grayscale(.55);
}

.ui-lock {
  display: inline-block;
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
  vertical-align: middle;
  flex: 0 0 auto;
  opacity: .9;
}
