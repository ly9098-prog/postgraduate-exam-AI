/* ============================================
   2240AI Design System — Design Tokens
   Palette: learning blue + sky cyan + focused feedback
   Mood: modern, motivating, productized learning
   ============================================ */

/* ── Color: Backgrounds ── */
.bg-page { background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%); }
.bg-card { background: #FFFFFF; }
.bg-input { background: #F3F7FF; }
.bg-surface { background: #F6F9FF; }
.bg-glass { background: rgba(255, 255, 255, 0.72); }
.bg-wechat { background: #07C160; }

/* ── Color: Primary ── */
.color-primary { color: #4F7FFF; }
.bg-primary { background: #4F7FFF; }
.bg-primary-light { background: #EEF4FF; }
.bg-primary-gradient { background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%); }

/* ── Color: Success ── */
.color-success { color: #22C55E; }
.bg-success { background: #22C55E; }
.bg-success-light { background: #ECFDF3; }

/* ── Color: Warning ── */
.color-warning { color: #F59E0B; }
.bg-warning { background: #F59E0B; }
.bg-warning-light { background: #FFF7E8; }

/* ── Color: Danger ── */
.color-danger { color: #EF4444; }
.bg-danger { background: #EF4444; }
.bg-danger-light { background: #FEF2F2; }

/* ── Color: Text ── */
.color-text-primary { color: #18233A; }
.color-text-secondary { color: #617089; }
.color-text-hint { color: #8EA0BA; }
.color-text-placeholder { color: #B7C4D8; }
.color-border { color: #E2EAF7; }

/* ── Spacing (8rpx = 4px @2x) ── */
.p-xs { padding: 8rpx; }
.p-sm { padding: 12rpx; }
.p-md { padding: 16rpx; }
.p-lg { padding: 20rpx; }
.p-xl { padding: 24rpx; }
.p-2xl { padding: 30rpx; }
.p-3xl { padding: 40rpx; }
.p-4xl { padding: 60rpx; }

.px-md { padding-left: 16rpx; padding-right: 16rpx; }
.px-lg { padding-left: 20rpx; padding-right: 20rpx; }
.px-xl { padding-left: 24rpx; padding-right: 24rpx; }
.px-2xl { padding-left: 30rpx; padding-right: 30rpx; }

.py-sm { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-md { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-lg { padding-top: 20rpx; padding-bottom: 20rpx; }
.py-xl { padding-top: 24rpx; padding-bottom: 24rpx; }

.mt-xs { margin-top: 8rpx; }
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 16rpx; }
.mt-lg { margin-top: 20rpx; }
.mt-xl { margin-top: 24rpx; }
.mt-2xl { margin-top: 30rpx; }
.mt-3xl { margin-top: 40rpx; }

.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 16rpx; }
.mb-lg { margin-bottom: 20rpx; }
.mb-xl { margin-bottom: 24rpx; }
.mb-2xl { margin-bottom: 30rpx; }

.ml-xs { margin-left: 8rpx; }
.ml-sm { margin-left: 12rpx; }
.ml-md { margin-left: 16rpx; }
.ml-lg { margin-left: 20rpx; }

.mr-xs { margin-right: 8rpx; }
.mr-sm { margin-right: 12rpx; }
.mr-md { margin-right: 16rpx; }
.mr-lg { margin-right: 20rpx; }

.gap-xs { gap: 8rpx; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 16rpx; }
.gap-lg { gap: 20rpx; }
.gap-xl { gap: 24rpx; }

/* ── Typography ── */
.text-h1 { font-size: 36rpx; font-weight: 800; color: #18233A; line-height: 1.35; }
.text-h2 { font-size: 32rpx; font-weight: 700; color: #18233A; line-height: 1.4; }
.text-body { font-size: 28rpx; color: #18233A; line-height: 1.6; }
.text-caption { font-size: 24rpx; color: #617089; line-height: 1.5; }
.text-small { font-size: 22rpx; color: #8EA0BA; line-height: 1.45; }
.text-stat { font-size: 48rpx; font-weight: 800; color: #4F7FFF; line-height: 1.15; font-variant-numeric: tabular-nums; }
.text-stat-sm { font-size: 40rpx; font-weight: 800; color: #4F7FFF; line-height: 1.2; font-variant-numeric: tabular-nums; }

.text-center { text-align: center; }
.text-bold { font-weight: 700; }
.text-light { color: #617089; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ── Layout ── */
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

.full-width { width: 100%; }
.block { display: block; }
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* ── Border Radius ── */
.radius-sm { border-radius: 12rpx; }
.radius-md { border-radius: 16rpx; }
.radius-lg { border-radius: 24rpx; }
.radius-xl { border-radius: 32rpx; }
.radius-2xl { border-radius: 40rpx; }
.radius-full { border-radius: 999rpx; }

/* ── Effects ── */
.shadow-card { box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08); }
.shadow-card-hover { box-shadow: 0 14rpx 36rpx rgba(42, 84, 160, 0.12); }
.shadow-glow { box-shadow: 0 16rpx 44rpx rgba(79, 127, 255, 0.22); }
.border-soft { border: 1rpx solid rgba(226, 234, 247, 0.92); }
.active-opacity { opacity: 0.86; }
.active-surface { background: #EEF4FF; }
.tap-scale { transform: scale(0.98); opacity: 0.9; }

/* ── Semantic UI Shells ── */
.learning-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
}

.hero-panel {
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 56%, #8AAFC8 100%);
  background-color: #4F7FFF;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  overflow: hidden;
}

.gradient-primary { background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%); }
.soft-shadow { box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08); }
.pill-button { border-radius: 999rpx; font-weight: 800; }

.line-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  display: block;
  color: currentColor;
}

.line-icon::before,
.line-icon::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.icon-book::before { left: 5rpx; top: 4rpx; width: 20rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 5rpx; }
.icon-book::after { left: 10rpx; top: 8rpx; width: 2rpx; height: 14rpx; background: currentColor; }
.icon-review::before { left: 5rpx; top: 5rpx; width: 20rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-review::after { right: 3rpx; top: 2rpx; width: 9rpx; height: 9rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(22deg); }
.icon-list::before { left: 4rpx; top: 5rpx; width: 22rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 5rpx; }
.icon-list::after { left: 10rpx; top: 11rpx; width: 12rpx; height: 3rpx; background: currentColor; box-shadow: 0 6rpx 0 currentColor; }
.icon-chart::before { left: 5rpx; bottom: 4rpx; width: 4rpx; height: 11rpx; background: currentColor; border-radius: 4rpx; box-shadow: 8rpx -6rpx 0 currentColor, 16rpx -12rpx 0 currentColor; }
.icon-clock::before { left: 5rpx; top: 5rpx; width: 20rpx; height: 20rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-clock::after { left: 14rpx; top: 10rpx; width: 8rpx; height: 8rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; }
.icon-import::before { left: 7rpx; bottom: 4rpx; width: 16rpx; height: 11rpx; border: 3rpx solid currentColor; border-top: 0; border-radius: 0 0 5rpx 5rpx; }
.icon-import::after { left: 12rpx; top: 4rpx; width: 8rpx; height: 14rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); }
.icon-alert::before { left: 6rpx; top: 5rpx; width: 18rpx; height: 18rpx; border: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 4rpx; }
.icon-lock::before { left: 6rpx; top: 13rpx; width: 18rpx; height: 13rpx; border: 3rpx solid currentColor; border-radius: 4rpx; }
.icon-lock::after { left: 10rpx; top: 4rpx; width: 10rpx; height: 13rpx; border: 3rpx solid currentColor; border-bottom: 0; border-radius: 10rpx 10rpx 0 0; }
.icon-target::before { left: 4rpx; top: 4rpx; width: 22rpx; height: 22rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-target::after { left: 12rpx; top: 12rpx; width: 6rpx; height: 6rpx; background: currentColor; border-radius: 50%; }
.icon-trend::before { left: 4rpx; top: 17rpx; width: 22rpx; height: 3rpx; background: currentColor; transform: rotate(-28deg); border-radius: 3rpx; }
.icon-trend::after { right: 3rpx; top: 7rpx; width: 9rpx; height: 9rpx; border-top: 3rpx solid currentColor; border-right: 3rpx solid currentColor; transform: rotate(18deg); }
.icon-check::before { left: 8rpx; top: 12rpx; width: 7rpx; height: 12rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.icon-check-circle::before { left: 3rpx; top: 3rpx; width: 24rpx; height: 24rpx; border: 3rpx solid currentColor; border-radius: 50%; }
.icon-check-circle::after { left: 9rpx; top: 12rpx; width: 7rpx; height: 11rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.icon-chevron-right::before { left: 10rpx; top: 8rpx; width: 12rpx; height: 12rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); border-radius: 2rpx; }
.icon-chevron-left::before { left: 8rpx; top: 8rpx; width: 12rpx; height: 12rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.icon-chevron-down::before { left: 9rpx; top: 10rpx; width: 12rpx; height: 12rpx; border-left: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(-45deg); border-radius: 2rpx; }
.icon-play::before { left: 9rpx; top: 5rpx; width: 0; height: 0; border-top: 10rpx solid transparent; border-bottom: 10rpx solid transparent; border-left: 16rpx solid currentColor; }
.icon-pause::before { left: 9rpx; top: 5rpx; width: 4rpx; height: 20rpx; background: currentColor; border-radius: 2rpx; box-shadow: 8rpx 0 0 currentColor; }
.icon-stop::before { left: 6rpx; top: 6rpx; width: 18rpx; height: 18rpx; background: currentColor; border-radius: 4rpx; }
.icon-plus::before { left: 13rpx; top: 5rpx; width: 4rpx; height: 20rpx; background: currentColor; border-radius: 2rpx; }
.icon-plus::after { left: 5rpx; top: 13rpx; width: 20rpx; height: 4rpx; background: currentColor; border-radius: 2rpx; }
.icon-close::before { left: 5rpx; top: 13rpx; width: 20rpx; height: 4rpx; background: currentColor; border-radius: 2rpx; transform: rotate(45deg); }
.icon-close::after { left: 5rpx; top: 13rpx; width: 20rpx; height: 4rpx; background: currentColor; border-radius: 2rpx; transform: rotate(-45deg); }
.icon-exclamation::before { left: 12rpx; top: 5rpx; width: 5rpx; height: 12rpx; background: currentColor; border-radius: 4rpx; }
.icon-exclamation::after { left: 12rpx; top: 20rpx; width: 5rpx; height: 5rpx; background: currentColor; border-radius: 50%; }
.icon-up::before { left: 8rpx; top: 4rpx; width: 14rpx; height: 14rpx; border-top: 3rpx solid currentColor; border-left: 3rpx solid currentColor; transform: rotate(45deg); border-radius: 2rpx; }
.icon-up::after { left: 14rpx; top: 9rpx; width: 3rpx; height: 15rpx; background: currentColor; border-radius: 2rpx; }
.icon-dot::before { left: 50%; top: 50%; width: 8rpx; height: 8rpx; background: currentColor; border-radius: 50%; transform: translate(-50%, -50%); }

/* ── Motion ── */
.motion-page-enter { animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.motion-card-enter { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.motion-delay-1 { animation-delay: 0.04s; }
.motion-delay-2 { animation-delay: 0.08s; }
.motion-delay-3 { animation-delay: 0.12s; }
.motion-delay-4 { animation-delay: 0.16s; }
.motion-press { transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease; }
.motion-press { transform: scale(0.98); opacity: 0.9; }

@keyframes page-enter {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes card-enter {
  from { opacity: 0; transform: translateY(28rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── Shared Keyframes ── */
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ── Page Background Convention ── */
/*
  To prevent white blocks during scroll bounce/pull-to-refresh:
  1. In page JSON:  "backgroundColor", "backgroundColorTop", "backgroundColorBottom"
  2. In page WXSS:   page { background: <solid>; background-color: <solid>; }
  3. In page WXSS:   .page { background: linear-gradient(...); background-color: <solid>; }
  Light theme:  #F8FAFF (top) → #EEF5FF (bottom/solid)
  Dark  theme:  #0B1121 (solid)
  Import theme: #F7F5F0 (solid)
*/

@keyframes spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .motion-page-enter,
  .motion-card-enter,
  .animation-fade-in,
  .tap-scale,
  .motion-press {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
