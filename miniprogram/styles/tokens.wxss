/* ============================================
   2240AI Design System — Design Tokens
   Palette: learning blue + sky cyan + focused feedback
   Mood: modern, motivating, productized learning
   ============================================ */

/* ── Color: Backgrounds ── */
.bg-page { background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%); }
.bg-card { background: #FFFFFF; }
.bg-input { background: #F3F7FF; }
.bg-surface { background: #F6F9FF; }
.bg-glass { background: rgba(255, 255, 255, 0.72); }
.bg-wechat { background: #07C160; }

/* ── Color: Primary ── */
.color-primary { color: #4F7FFF; }
.bg-primary { background: #4F7FFF; }
.bg-primary-light { background: #EEF4FF; }
.bg-primary-gradient { background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%); }

/* ── Color: Success ── */
.color-success { color: #22C55E; }
.bg-success { background: #22C55E; }
.bg-success-light { background: #ECFDF3; }

/* ── Color: Warning ── */
.color-warning { color: #F59E0B; }
.bg-warning { background: #F59E0B; }
.bg-warning-light { background: #FFF7E8; }

/* ── Color: Danger ── */
.color-danger { color: #EF4444; }
.bg-danger { background: #EF4444; }
.bg-danger-light { background: #FEF2F2; }

/* ── Color: Text ── */
.color-text-primary { color: #18233A; }
.color-text-secondary { color: #617089; }
.color-text-hint { color: #8EA0BA; }
.color-text-placeholder { color: #B7C4D8; }
.color-border { color: #E2EAF7; }

/* ── Spacing (8rpx = 4px @2x) ── */
.p-xs { padding: 8rpx; }
.p-sm { padding: 12rpx; }
.p-md { padding: 16rpx; }
.p-lg { padding: 20rpx; }
.p-xl { padding: 24rpx; }
.p-2xl { padding: 30rpx; }
.p-3xl { padding: 40rpx; }
.p-4xl { padding: 60rpx; }

.px-md { padding-left: 16rpx; padding-right: 16rpx; }
.px-lg { padding-left: 20rpx; padding-right: 20rpx; }
.px-xl { padding-left: 24rpx; padding-right: 24rpx; }
.px-2xl { padding-left: 30rpx; padding-right: 30rpx; }

.py-sm { padding-top: 12rpx; padding-bottom: 12rpx; }
.py-md { padding-top: 16rpx; padding-bottom: 16rpx; }
.py-lg { padding-top: 20rpx; padding-bottom: 20rpx; }
.py-xl { padding-top: 24rpx; padding-bottom: 24rpx; }

.mt-xs { margin-top: 8rpx; }
.mt-sm { margin-top: 12rpx; }
.mt-md { margin-top: 16rpx; }
.mt-lg { margin-top: 20rpx; }
.mt-xl { margin-top: 24rpx; }
.mt-2xl { margin-top: 30rpx; }
.mt-3xl { margin-top: 40rpx; }

.mb-sm { margin-bottom: 12rpx; }
.mb-md { margin-bottom: 16rpx; }
.mb-lg { margin-bottom: 20rpx; }
.mb-xl { margin-bottom: 24rpx; }
.mb-2xl { margin-bottom: 30rpx; }

.ml-xs { margin-left: 8rpx; }
.ml-sm { margin-left: 12rpx; }
.ml-md { margin-left: 16rpx; }
.ml-lg { margin-left: 20rpx; }

.mr-xs { margin-right: 8rpx; }
.mr-sm { margin-right: 12rpx; }
.mr-md { margin-right: 16rpx; }
.mr-lg { margin-right: 20rpx; }

.gap-xs { gap: 8rpx; }
.gap-sm { gap: 12rpx; }
.gap-md { gap: 16rpx; }
.gap-lg { gap: 20rpx; }
.gap-xl { gap: 24rpx; }

/* ── Typography ── */
.text-h1 { font-size: 36rpx; font-weight: 800; color: #18233A; line-height: 1.35; }
.text-h2 { font-size: 32rpx; font-weight: 700; color: #18233A; line-height: 1.4; }
.text-body { font-size: 28rpx; color: #18233A; line-height: 1.6; }
.text-caption { font-size: 24rpx; color: #617089; line-height: 1.5; }
.text-small { font-size: 22rpx; color: #8EA0BA; line-height: 1.45; }
.text-stat { font-size: 48rpx; font-weight: 800; color: #4F7FFF; line-height: 1.15; font-variant-numeric: tabular-nums; }
.text-stat-sm { font-size: 40rpx; font-weight: 800; color: #4F7FFF; line-height: 1.2; font-variant-numeric: tabular-nums; }

.text-center { text-align: center; }
.text-bold { font-weight: 700; }
.text-light { color: #617089; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* ── Layout ── */
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { justify-content: center; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-1 { flex: 1; }
.flex-wrap { flex-wrap: wrap; }

.full-width { width: 100%; }
.block { display: block; }
.safe-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

/* ── Border Radius ── */
.radius-sm { border-radius: 12rpx; }
.radius-md { border-radius: 16rpx; }
.radius-lg { border-radius: 24rpx; }
.radius-xl { border-radius: 32rpx; }
.radius-2xl { border-radius: 40rpx; }
.radius-full { border-radius: 999rpx; }

/* ── Effects ── */
.shadow-card { box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08); }
.shadow-card-hover { box-shadow: 0 14rpx 36rpx rgba(42, 84, 160, 0.12); }
.shadow-glow { box-shadow: 0 16rpx 44rpx rgba(79, 127, 255, 0.22); }
.border-soft { border: 1rpx solid rgba(226, 234, 247, 0.92); }
.active-opacity:active { opacity: 0.86; }
.active-surface:active { background: #EEF4FF; }
.tap-scale:active { transform: scale(0.98); opacity: 0.9; }

/* ── Motion ── */
.motion-page-enter { animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.motion-card-enter { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.motion-delay-1 { animation-delay: 0.04s; }
.motion-delay-2 { animation-delay: 0.08s; }
.motion-delay-3 { animation-delay: 0.12s; }
.motion-delay-4 { animation-delay: 0.16s; }
.motion-press { transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease; }
.motion-press:active { transform: scale(0.98); opacity: 0.9; }

@keyframes page-enter {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes card-enter {
  from { opacity: 0; transform: translateY(28rpx) scale(0.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .motion-page-enter,
  .motion-card-enter,
  .animation-fade-in,
  .tap-scale,
  .motion-press {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
