/* ============================================
   2240AI — Component Classes
   Style: card-based, soft shadows, learning app feedback
   ============================================ */

/* ── Card ── */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.card-flat {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 12rpx 24rpx;
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.card-nopad {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 12rpx 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.card-compact {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 12rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

/* ── Buttons ── */
.btn {
  border-radius: 999rpx;
  padding: 26rpx 0;
  min-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
  width: 100%;
  border: none;
  transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease;
}

.btn[disabled] { opacity: 0.48; }

.btn-primary {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(79, 127, 255, 0.22);
}

.btn-secondary {
  background: #EEF4FF;
  color: #4F7FFF;
}

.btn-danger {
  background: #EF4444;
  color: #fff;
}

.btn-wechat {
  background: #07C160;
  color: #fff;
}

.btn-text {
  background: none;
  color: #8EA0BA;
  font-size: 28rpx;
  padding: 24rpx 0;
}

.btn-link {
  background: none;
  color: #4F7FFF;
  font-size: 28rpx;
  padding: 16rpx 0;
  width: auto;
  display: inline-block;
}

.btn-small {
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  min-height: 56rpx;
  border-radius: 999rpx;
  display: inline-block;
  border: none;
}

.btn-small-primary {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  min-height: 56rpx;
  border-radius: 999rpx;
  display: inline-block;
  border: none;
}

/* ── Icon Badge ── */
.icon-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  margin-right: 20rpx;
}

.icon-primary {
  color: #4F7FFF;
  background: #EEF4FF;
}

.icon-success {
  color: #22C55E;
  background: #ECFDF3;
}

.icon-warning {
  color: #F59E0B;
  background: #FFF7E8;
}

.icon-danger {
  color: #EF4444;
  background: #FEF2F2;
}

.icon-muted {
  color: #617089;
  background: #F3F7FF;
}

.icon-formula {
  color: #7C3AED;
  background: #F5F0FF;
}

.icon-plain {
  color: #4F7FFF;
}

/* ── Tags ── */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-primary {
  background: #EEF4FF;
  color: #4F7FFF;
}

.tag-success {
  background: #ECFDF3;
  color: #22C55E;
}

.tag-warning {
  background: #FFF7E8;
  color: #F59E0B;
}

.tag-danger {
  background: #FEF2F2;
  color: #EF4444;
}

/* ── List Item ── */
.list-item {
  display: flex;
  align-items: center;
  padding: 28rpx 30rpx;
  min-height: 88rpx;
  border-bottom: 1rpx solid #E2EAF7;
}

.list-item:last-child { border-bottom: none; }

.list-item-icon { font-size: 36rpx; margin-right: 20rpx; }

.list-item-text {
  flex: 1;
  font-size: 30rpx;
  color: #18233A;
}

.list-item-arrow {
  font-size: 36rpx;
  color: #B7C4D8;
}

/* ── Stat Number ── */
.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.stat-label {
  font-size: 24rpx;
  color: #8EA0BA;
  margin-top: 8rpx;
}

/* ── Progress Bar ── */
.progress-bg {
  height: 8rpx;
  background: #EAF0FF;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 100%);
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* ── Subject Selector ── */
.subject-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  background: #F3F7FF;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #617089;
  border: 2rpx solid transparent;
}

.subject-active {
  background: #EEF4FF;
  border-color: #4F7FFF;
  color: #4F7FFF;
  font-weight: 700;
}

.subject-icon { font-size: 48rpx; margin-bottom: 12rpx; }

/* ── Filter Chips ── */
.chip {
  padding: 10rpx 28rpx;
  min-height: 48rpx;
  font-size: 26rpx;
  color: #617089;
  background: #F3F7FF;
  border-radius: 999rpx;
  display: inline-block;
}

.chip-pressed { opacity: 0.88; }

.chip-active {
  background: #4F7FFF;
  color: #fff;
}

/* ── Empty State ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #8EA0BA;
  font-size: 30rpx;
  line-height: 1.6;
}

.empty-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #617089;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8EA0BA;
}

/* ── Loading ── */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #8EA0BA;
}

/* ── Page Title ── */
.page-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #18233A;
  padding: 28rpx 24rpx 16rpx;
}

/* ── Answer Options ── */
.option-btn {
  background: #F3F7FF;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin: 10rpx 0;
  min-height: 88rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
}

.option-selected {
  border-color: #4F7FFF;
  background: #EEF4FF;
}

.option-correct {
  border-color: #22C55E;
  background: #ECFDF3;
}

.option-wrong {
  border-color: #EF4444;
  background: #FEF2F2;
}

.option-key {
  font-weight: 700;
  width: 48rpx;
  color: #617089;
}

.option-text { flex: 1; color: #18233A; }

/* ── Result Badge ── */
.result-badge {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  padding: 20rpx;
  border-radius: 18rpx;
}

.badge-correct {
  background: #ECFDF3;
  color: #22C55E;
}

.badge-wrong {
  background: #FEF2F2;
  color: #EF4444;
}

/* ── Section Title ── */
.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #18233A;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

/* ── Subject Tag ── */
.subject-tag {
  font-size: 22rpx;
  color: #4F7FFF;
  background: #EEF4FF;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

/* ── Question Text ── */
.q-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: #18233A;
  margin-bottom: 24rpx;
}

/* ── Input ── */
.input-field {
  background: #F3F7FF;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  min-height: 88rpx;
  font-size: 30rpx;
  width: 100%;
  box-sizing: border-box;
  color: #18233A;
}

.input-field::placeholder {
  color: #B7C4D8;
}