/* 刷题页科目选择弹层：参考图的清新卡片式视觉。 */
.subject-sheet-layer .subject-sheet {
  height: auto;
  min-height: 0;
  max-height: 82vh;
  padding: 12rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 42rpx 42rpx 0 0;
  background: #FDFEF9;
  box-shadow: 0 -18rpx 52rpx rgba(15, 35, 22, .18);
}

.subject-sheet .sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 2rpx auto 22rpx;
  background: #B8C6BF;
}

.subject-sheet .sheet-header {
  padding: 0 4rpx 0 6rpx;
}

.subject-sheet .sheet-title {
  color: #10231A;
  font-size: 34rpx;
  line-height: 1.18;
  letter-spacing: .5rpx;
}

.subject-sheet .sheet-kicker {
  margin-top: 7rpx;
  color: #97A29C;
  font-size: 16rpx;
  letter-spacing: 2.5rpx;
}

.subject-sheet .sheet-close {
  width: 58rpx;
  height: 58rpx;
  border: 0;
  background: #F7F8F5;
  box-shadow: none;
}

.subject-sheet .sheet-close .line-icon {
  width: 27rpx;
  height: 27rpx;
  color: #1A2D24;
}

.all-subject-heading {
  margin: 28rpx 6rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.all-subject-accent {
  width: 6rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #86E200;
  box-shadow: 0 0 0 5rpx rgba(134, 226, 0, .07);
}

.subject-sheet .all-subject-label {
  margin: 0;
  padding: 0;
  color: #172A20;
  font-size: 25rpx;
  line-height: 1.3;
}

.subject-sheet .subject-tree-scroll {
  flex: none;
  height: auto;
  max-height: calc(82vh - 210rpx);
  padding: 0 2rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.subject-sheet .subject-tree {
  gap: 14rpx;
  padding: 0 0 14rpx;
}

.subject-sheet .subject-parent-block {
  border: 1rpx solid #DFE8E1;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 7rpx 18rpx rgba(30, 55, 39, .025);
}

.subject-sheet .subject-parent-block.expanded {
  border-color: #D8E3DA;
  box-shadow: 0 9rpx 24rpx rgba(30, 55, 39, .045);
}

.subject-sheet .subject-parent-row {
  min-height: 112rpx;
  padding: 0 20rpx 0 22rpx;
  gap: 16rpx;
  transition: background-color .18s ease;
}

.subject-sheet .subject-parent-row.selected {
  background: linear-gradient(105deg, #F3FFD9 0%, #F8FDEB 100%);
}

.subject-sheet .parent-main {
  gap: 20rpx;
}

.subject-sheet .parent-folder {
  width: 68rpx;
  height: 68rpx;
  border: 0;
  border-radius: 50%;
  background: #EDFFD2;
  color: #193426;
  font-family: Arial, sans-serif;
  font-size: 24rpx;
  font-weight: 800;
}

.subject-sheet .subject-parent-row.selected .parent-folder {
  background: #92E514;
  color: #142A1E;
}

.subject-icon-text {
  display: block;
  line-height: 1;
  letter-spacing: -1rpx;
}

.subject-icon-image {
  width: 34rpx;
  height: 34rpx;
  display: block;
}

.subject-sheet .parent-name {
  color: #182A21;
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 900;
}

.subject-sheet .parent-meta {
  margin-top: 6rpx;
  color: #9AA59F;
  font-size: 19rpx;
  line-height: 1.25;
}

.subject-sheet .subject-parent-row.selected .parent-name {
  color: #162A20;
}

.subject-sheet .subject-parent-row.selected .parent-meta {
  color: #91A097;
}

.subject-sheet .parent-right {
  gap: 0;
}

.subject-sheet .parent-expand-hit {
  width: 54rpx;
  height: 54rpx;
  margin-right: -9rpx;
  border-radius: 50%;
}

.subject-sheet .subject-parent-row.selected .parent-expand-hit {
  background: transparent;
}

.subject-sheet .parent-arrow {
  color: #70817A;
  font-family: Arial, sans-serif;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
  transition: transform .2s ease;
}

.subject-sheet .subject-parent-row.selected .parent-arrow {
  color: #506B5D;
}

.subject-sheet .parent-arrow.up {
  transform: rotate(90deg);
}

.subject-sheet .parent-leaf-arrow {
  padding-right: 5rpx;
}

.subject-sheet .child-subject-wrap {
  padding: 8rpx 14rpx 14rpx 90rpx;
  border-top: 1rpx solid #E7EDE8;
  background: #FCFDF9;
}

.subject-sheet .child-subject-row {
  min-height: 70rpx;
  border-radius: 15rpx;
  color: #4C5C53;
}

.subject-sheet .child-subject-row.active {
  background: #EDFACB;
  color: #173023;
}

.subject-sheet .child-select-mark {
  background: #8DE500;
  color: #153020;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
}

.subject-sheet .child-select-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
  flex-shrink: 0;
}
