.premium-nav-placeholder {
  width: 100%;
}

.premium-nav {
  width: 100%;
  box-sizing: border-box;
  transition: background-color 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
  z-index: 90;
}

.premium-nav.is-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}

.premium-nav-light {
  background: rgba(244, 244, 238, 0.96);
  color: #142219;
  box-shadow: 0 1rpx 0 rgba(20, 34, 25, 0.06);
}

.premium-nav-dark {
  background: #10251A;
  color: #FFFFFF;
  box-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.07);
}

.premium-nav-inner {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding-left: 24rpx;
  position: relative;
}

.premium-nav-back {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  transition: transform 0.15s ease, opacity 0.15s ease, background-color 0.15s ease;
}

.premium-nav-light .premium-nav-back {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #DDE2DA;
}

.premium-nav-dark .premium-nav-back {
  background: rgba(255, 255, 255, 0.07);
  border: 1rpx solid rgba(255, 255, 255, 0.11);
}

.premium-nav-back-pressed {
  transform: scale(0.94);
  opacity: 0.72;
}

.premium-nav-back-icon {
  display: block;
  font-family: Arial, sans-serif;
  font-size: 46rpx;
  line-height: 1;
  transform: translateY(-2rpx);
}

.premium-nav-copy {
  position: absolute;
  left: 50%;
  top: 50%;
  max-width: 360rpx;
  min-width: 0;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 10rpx;
  transform: translate(-50%, -50%);
  text-align: center;
}

.premium-nav-caption {
  flex-shrink: 0;
  font-size: 17rpx;
  font-weight: 850;
  letter-spacing: 3rpx;
  line-height: 1.2;
}

.premium-nav-light .premium-nav-caption { color: #6E7B71; }
.premium-nav-dark .premium-nav-caption { color: #B7E82A; }

.premium-nav-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 0.4rpx;
}

@media (prefers-reduced-motion: reduce) {
  .premium-nav,
  .premium-nav-back {
    transition: none !important;
  }
}
