.seg-text {
  display: inline;
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.8;
}
.seg-math-inline-wrap {
  display: inline-block;
  vertical-align: middle;
}
.seg-math-inline {
  height: 44rpx;
  max-width: 400rpx;
  margin: 0 4rpx;
}
.seg-math-display-wrap {
  display: block;
  text-align: center;
  margin: 16rpx 0;
}
.seg-math-display {
  max-width: 100%;
}
.seg-math-fallback {
  color: #C47A7A;
  font-size: 24rpx;
}
.seg-math-fallback-inline {
  display: inline;
}
.seg-newline {
  display: block;
  height: 16rpx;
}
.seg-image-wrap {
  display: block;
  margin: 16rpx 0;
  text-align: center;
}
.seg-visual-image {
  max-width: 100%;
  border-radius: 8rpx;
}
.seg-image-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 8rpx;
  border: 2rpx dashed #ddd;
  background: #fafafa;
  padding: 20rpx;
}
.seg-image-error-text {
  color: #999;
  font-size: 24rpx;
}
.seg-unknown {
  display: none;
}
