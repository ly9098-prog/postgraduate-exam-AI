<view class="sc-overlay {{visible ? 'sc-visible' : ''}}" catchtap="onCancel" catchtouchmove="noop">
  <view class="sc-card scenario-{{scenario}}" catchtap="noop">
    <view class="sc-top-accent"></view>

    <view class="sc-icon-circle">
      <text class="sc-icon-line line-icon {{scenario === 'unanswered' ? 'icon-exclamation' : 'icon-check'}}"></text>
    </view>

    <text class="sc-eyebrow">{{scenario === 'unanswered' ? 'UNFINISHED' : 'SUBMIT PAPER'}}</text>
    <text class="sc-title">{{title}}</text>
    <text class="sc-msg">{{message}}</text>

    <view class="sc-actions">
      <button class="sc-btn sc-btn-cancel" hover-class="sc-btn-cancel-pressed" bindtap="onCancel">{{cancelText}}</button>
      <button class="sc-btn sc-btn-confirm" hover-class="sc-btn-confirm-pressed" bindtap="onConfirm">
        <text>{{confirmText}}</text>
        <view class="sc-confirm-arrow"><text>›</text></view>
      </button>
    </view>
  </view>
</view>
