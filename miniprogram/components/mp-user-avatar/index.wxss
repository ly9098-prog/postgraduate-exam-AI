.mp-profile-row {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mp-avatar-button {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 26rpx;
  line-height: 0;
  background: transparent;
  overflow: hidden;
}

.mp-avatar-button::after {
  border: 0;
}

.mp-avatar {
  display: flex;
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
  align-items: center;
  justify-content: center;
}

.mp-avatar-placeholder {
  background: #e9f0df;
  color: #173e2b;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
}

.mp-profile-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 6rpx;
  text-align: left;
}

.mp-nickname {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 44rpx;
  box-sizing: border-box;
  padding: 0 2rpx 0 0;
  color: #14251d;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 44rpx;
  text-align: left;
}

.mp-nickname-placeholder {
  color: #90a097;
  font-size: 28rpx;
  font-weight: 600;
}

.mp-profile-hint {
  display: block;
  width: 100%;
  box-sizing: border-box;
  color: #8c968f;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: left;
  white-space: normal;
  word-break: break-all;
}

.mp-profile-check {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  color: #85928b;
  background: #f1f3ef;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.mp-profile-check.is-ready {
  color: #0e7a43;
  background: #e8f6ed;
}
