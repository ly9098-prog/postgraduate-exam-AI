<!-- celebration-lottie: Lottie 优先 → CSS 降级（无 Canvas 2D 中间层，避免原生组件层级问题）-->
<view class="celebration-shell {{visible ? 'active' : ''}} type-{{type}}" catchtap="onTap">
  <!-- 白色磨砂背景（独立 view） -->
  <view class="celeb-overlay-bg"></view>

  <!-- Canvas 层：仅 Lottie 路径使用 -->
  <view class="canvas-layer" wx:if="{{canvasReady && useLottie}}">
    <canvas
      type="2d"
      id="celebration-canvas"
      class="celebration-canvas"
    ></canvas>
  </view>

  <!-- CSS 降级层（非 Lottie 路径，无原生 canvas 层级问题） -->
  <view class="fallback-layer" wx:else>
    <view class="fallback-bg"></view>
    <view class="fallback-fireworks">
      <view class="fw fw-1"></view>
      <view class="fw fw-2"></view>
      <view class="fw fw-3"></view>
      <view class="fw fw-4"></view>
      <view class="fw fw-5"></view>
      <view class="fw fw-6"></view>
    </view>
    <view class="fallback-particles">
      <view class="fp fp-1"></view>
      <view class="fp fp-2"></view>
      <view class="fp fp-3"></view>
      <view class="fp fp-4"></view>
      <view class="fp fp-5"></view>
      <view class="fp fp-6"></view>
      <view class="fp fp-7"></view>
      <view class="fp fp-8"></view>
    </view>
    <view class="fallback-content">
      <view class="fb-badge {{type}}">
        <text wx:if="{{type === 'excellent' || type === 'final'}}">★</text>
        <text wx:elif="{{type === 'combo'}}">🔥</text>
        <text wx:elif="{{type === 'focus'}}">!</text>
        <text wx:else>✓</text>
      </view>
    </view>
  </view>

  <!-- 文字叠加：cover-view 用于 Lottie（可渲染在原生 canvas 上方），普通 view 用于 CSS 降级 -->
  <cover-view wx:if="{{canvasReady && useLottie}}" class="celeb-text-cover {{showContent ? 'content-in-cover' : ''}}">
    <cover-view class="celeb-progress-cover" wx:if="{{progressText}}">{{progressText}}</cover-view>
    <cover-view class="celeb-title-cover" wx:if="{{title}}">{{title}}</cover-view>
    <cover-view class="celeb-detail-cover" wx:if="{{detail}}">{{detail}}</cover-view>
    <cover-view class="celeb-reward-cover" wx:if="{{rewardText}}">
      <cover-view class="reward-spark-cover">★</cover-view>
      <cover-view class="reward-text-cover">{{rewardText}}</cover-view>
    </cover-view>
    <cover-view class="celeb-growth-cover" wx:if="{{growthLevel}}">
      <cover-view class="celeb-growth-head-cover">
        <cover-view class="celeb-growth-level-cover">{{growthLevel}}</cover-view>
        <cover-view class="celeb-growth-pct-cover">{{growthLevelPct}}%</cover-view>
      </cover-view>
      <cover-view class="celeb-growth-track-cover">
        <cover-view class="celeb-growth-fill-cover" style="width:{{growthLevelPct}}%"></cover-view>
      </cover-view>
      <cover-view class="celeb-growth-desc-cover">{{growthDesc}}</cover-view>
    </cover-view>
    <cover-view class="celeb-motto-cover" wx:if="{{motto}}">{{motto}}</cover-view>
    <cover-view class="celeb-tap-cover">点击继续</cover-view>
  </cover-view>

  <view wx:else class="celeb-text-overlay {{showContent ? 'content-in' : ''}}">
    <text class="celeb-progress-text" wx:if="{{progressText}}">{{progressText}}</text>
    <text class="celeb-title" wx:if="{{title}}">{{title}}</text>
    <text class="celeb-detail" wx:if="{{detail}}">{{detail}}</text>
    <view class="celeb-reward" wx:if="{{rewardText}}">
      <text class="reward-spark">★</text>
      <text>{{rewardText}}</text>
    </view>
    <view class="celeb-growth" wx:if="{{growthLevel}}">
      <view class="celeb-growth-head">
        <text class="celeb-growth-level">{{growthLevel}}</text>
        <text class="celeb-growth-pct">{{growthLevelPct}}%</text>
      </view>
      <view class="celeb-growth-track">
        <view class="celeb-growth-fill" style="width:{{growthLevelPct}}%"></view>
      </view>
      <text class="celeb-growth-desc">{{growthDesc}}</text>
    </view>
    <text class="celeb-motto" wx:if="{{motto}}">{{motto}}</text>
    <text class="celeb-tap-hint">点击继续</text>
  </view>
</view>
