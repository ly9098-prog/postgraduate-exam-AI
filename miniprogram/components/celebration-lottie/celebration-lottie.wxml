<animated-view
  show="{{show}}"
  type="{{type}}"
  title="{{title}}"
  detail="{{detail}}"
  motto="{{motto}}"
  reward-text="{{rewardText}}"
  progress-text="{{progressText}}"
  growth-level="{{growthLevel}}"
  growth-level-pct="{{growthLevelPct}}"
  growth-desc="{{growthDesc}}"
  duration="{{duration}}"
  gif-src="{{gifSrc}}"
  png-src="{{pngSrc}}"
  enable-lottie="{{enableLottie}}"
  bind:done="onDone"
/>
