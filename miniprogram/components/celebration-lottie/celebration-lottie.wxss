/* celebration-lottie — Lottie 优先 → Canvas 粒子 → CSS 降级
   风格：白色磨砂玻璃 + 蓝调（MemoGrad 学习 App 主题）
   与番茄钟的暗色沉浸风格明确区分 */

.celebration-shell {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.celebration-shell.active {
  opacity: 1;
  pointer-events: auto;
}

/* ── 白色磨砂背景（独立 view，避免被 canvas 原生层级覆盖）── */
.celeb-overlay-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* ── Canvas 粒子层 ── */
.canvas-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.celebration-canvas {
  width: 100%;
  height: 100%;
}

/* ── CSS 降级层 ── */
.fallback-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.fallback-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: rgba(248, 250, 255, 0.88);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.fallback-content {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fb-badge {
  width: 130rpx;
  height: 130rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 22rpx 56rpx rgba(79, 127, 255, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFFFFF;
  animation: fbPop 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.fb-badge.practice,
.fb-badge.steady {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 22rpx 56rpx rgba(79, 127, 255, 0.36);
}

.fb-badge.excellent,
.fb-badge.final {
  background: linear-gradient(135deg, #22C55E 0%, #7BD88F 100%);
  box-shadow: 0 22rpx 56rpx rgba(34, 197, 94, 0.36);
}

.fb-badge.combo {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 22rpx 56rpx rgba(245, 158, 11, 0.4);
}

.fb-badge.focus {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
  box-shadow: 0 22rpx 56rpx rgba(139, 92, 246, 0.36);
}

.fb-badge.group {
  background: linear-gradient(135deg, #6EC1FF 0%, #4F7FFF 100%);
  box-shadow: 0 22rpx 56rpx rgba(110, 193, 255, 0.36);
}

.fallback-hint {
  position: relative;
  z-index: 6;
  margin-top: 28rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  color: #4F7FFF;
  font-size: 24rpx;
  animation: fbTextIn 0.5s ease 0.3s both;
}

/* 粒子 */
.fallback-fireworks,
.fallback-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

.fw {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  animation: fwBurst 1.2s ease-out forwards;
}

.fw-1 { left: 20%; top: 30%; background: #4F7FFF; animation-delay: 0.1s; }
.fw-2 { left: 50%; top: 20%; background: #6EC1FF; animation-delay: 0.15s; }
.fw-3 { left: 72%; top: 38%; background: #22C55E; animation-delay: 0.2s; }
.fw-4 { right: 15%; top: 55%; background: #F59E0B; animation-delay: 0.25s; }
.fw-5 { left: 35%; top: 60%; background: #4F7FFF; animation-delay: 0.12s; }
.fw-6 { left: 58%; top: 70%; background: #6EC1FF; animation-delay: 0.28s; }

.fp {
  position: absolute;
  border-radius: 50%;
  animation: fpFloat 1.5s ease-out forwards;
}

.fp-1 { left: 15%; top: 50%; width: 6rpx; height: 6rpx; background: #4F7FFF; animation-delay: 0.05s; }
.fp-2 { left: 30%; top: 15%; width: 8rpx; height: 8rpx; background: #6EC1FF; animation-delay: 0.1s; }
.fp-3 { left: 65%; top: 25%; width: 5rpx; height: 5rpx; background: #22C55E; animation-delay: 0.15s; }
.fp-4 { right: 25%; top: 60%; width: 7rpx; height: 7rpx; background: #F59E0B; animation-delay: 0.2s; }
.fp-5 { left: 45%; bottom: 30%; width: 6rpx; height: 6rpx; background: #4F7FFF; animation-delay: 0.08s; }
.fp-6 { left: 75%; bottom: 40%; width: 8rpx; height: 8rpx; background: #6EC1FF; animation-delay: 0.22s; }
.fp-7 { left: 10%; bottom: 50%; width: 5rpx; height: 5rpx; background: #22C55E; animation-delay: 0.18s; }
.fp-8 { right: 30%; top: 40%; width: 7rpx; height: 7rpx; background: #4F7FFF; animation-delay: 0.25s; }

@keyframes fbPop {
  0% { transform: scale(0.4); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes fbTextIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fwBurst {
  0% { opacity: 1; transform: translate(0, 0) scale(1); }
  100% { opacity: 0; transform: translate(var(--dx, 60rpx), var(--dy, -80rpx)) scale(0.2); }
}

@keyframes fpFloat {
  0% { opacity: 0; transform: translateY(30rpx) scale(0.5); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-120rpx) scale(1.2); }
}

/* ── 文字庆祝内容（叠加层）── */
.celeb-text-overlay {
  position: absolute;
  top: 48%;
  left: 0;
  width: 100%;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translateY(20rpx);
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}

.celeb-text-overlay.content-in {
  opacity: 1;
  transform: translateY(0);
}

.celeb-progress-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
  margin-bottom: 10rpx;
}

.celeb-title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #1E293B;
  line-height: 1.2;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 12rpx rgba(79, 127, 255, 0.12);
}

.celeb-detail {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.45;
  margin-bottom: 14rpx;
}

.celeb-reward {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.12), rgba(110, 193, 255, 0.08));
  color: #4F7FFF;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.reward-spark {
  color: #F59E0B;
  font-size: 24rpx;
}

.celeb-motto {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 28rpx;
  padding: 0 48rpx;
  text-align: center;
}

/* 成长结算卡（final 类型使用） */
.celeb-growth {
  width: 480rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(79, 127, 255, 0.1);
}

.celeb-growth-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.celeb-growth-level {
  font-size: 28rpx;
  font-weight: 900;
  color: #1E293B;
}

.celeb-growth-pct {
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
}

.celeb-growth-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #E2E8F0;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.celeb-growth-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF, #6EC1FF);
  transition: width 0.4s ease-out;
}

.celeb-growth-desc {
  display: block;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
}

.celeb-tap-hint {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  color: #4F7FFF;
  font-size: 24rpx;
  pointer-events: auto;
}

@media (prefers-reduced-motion: reduce) {
  .fb-badge,
  .fallback-hint,
  .fw,
  .fp,
  .celeb-text-overlay {
    animation: none !important;
    transition: none !important;
    opacity: 1;
  }
  .celebration-shell {
    transition: none !important;
  }
  .celeb-text-overlay {
    transform: none !important;
  }
  .canvas-layer {
    display: none;
  }
}
