/* 与答题页统一的深墨绿 + 荧光绿确认弹层 */

.sc-overlay {
  position: fixed;
  inset: 0;
  z-index: 2100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(4, 13, 8, 0.68);
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
  opacity: 0;
  pointer-events: none;
  box-sizing: border-box;
  transition: opacity 0.22s ease;
}

.sc-overlay.sc-visible {
  opacity: 1;
  pointer-events: auto;
}

.sc-card {
  position: relative;
  width: 100%;
  max-width: 590rpx;
  padding: 48rpx 34rpx 32rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255,255,255,0.76);
  background: #FFFFFF;
  box-shadow: 0 30rpx 90rpx rgba(0,0,0,0.28);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  transform: translateY(42rpx) scale(0.96);
  opacity: 0;
  transition: transform 0.26s cubic-bezier(0.22,1,0.36,1), opacity 0.22s ease;
}

.sc-visible .sc-card {
  transform: translateY(0) scale(1);
  opacity: 1;
}

.sc-top-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #173524 0%, #AEEF00 72%, #D7FF68 100%);
}

.sc-card.scenario-unanswered .sc-top-accent {
  background: linear-gradient(90deg, #173524 0%, #D28A1C 70%, #F0B84B 100%);
}

.sc-icon-circle {
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #173524;
  box-shadow: 0 0 0 12rpx rgba(174,239,0,0.10), 0 12rpx 28rpx rgba(16,37,26,0.18);
}

.scenario-unanswered .sc-icon-circle {
  background: #6B4714;
  box-shadow: 0 0 0 12rpx rgba(210,138,28,0.12), 0 12rpx 28rpx rgba(107,71,20,0.18);
}

.sc-icon-line {
  width: 34rpx;
  height: 34rpx;
  color: #AEEF00;
}

.scenario-unanswered .sc-icon-line { color: #FFD27B; }

.sc-eyebrow {
  margin-top: 28rpx;
  color: #6F990E;
  font-size: 18rpx;
  font-weight: 850;
  letter-spacing: 3rpx;
}

.scenario-unanswered .sc-eyebrow { color: #A36A13; }

.sc-title {
  margin-top: 9rpx;
  color: #17251B;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 900;
  text-align: center;
}

.sc-msg {
  margin-top: 12rpx;
  color: #68746C;
  font-size: 25rpx;
  line-height: 1.65;
  text-align: center;
  white-space: pre-line;
}

.sc-actions {
  width: 100%;
  margin-top: 34rpx;
  display: flex;
  gap: 14rpx;
}

.sc-btn {
  height: 86rpx;
  border-radius: 18rpx;
  border: none;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 850;
  box-sizing: border-box;
}

.sc-btn::after { border: none; }

.sc-btn-cancel {
  flex: 0.82;
  color: #4E5D53;
  background: #F5F7F3;
  border: 1rpx solid #DDE4DD;
}

.sc-btn-confirm {
  position: relative;
  flex: 1.18;
  justify-content: center;
  padding-left: 58rpx;
  padding-right: 58rpx;
  color: #10251A;
  background: linear-gradient(100deg, #AEEF00 0%, #C8F72B 100%);
  box-shadow: 0 12rpx 26rpx rgba(123,174,0,0.18);
}

.scenario-unanswered .sc-btn-confirm {
  color: #FFFFFF;
  background: linear-gradient(110deg, #173524 0%, #0E2218 100%);
  box-shadow: 0 12rpx 26rpx rgba(16,37,26,0.18);
}

.sc-confirm-arrow {
  position: absolute;
  right: 15rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #10251A;
  color: #FFFFFF;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
  flex-shrink: 0;
}

.scenario-unanswered .sc-confirm-arrow {
  background: #AEEF00;
  color: #10251A;
}

.sc-confirm-arrow-text { transform: translateY(-2rpx); }
.sc-btn-cancel-pressed { background: #EBF0E9; transform: scale(0.985); }
.sc-btn-confirm-pressed { opacity: 0.86; transform: scale(0.985); }

@media (prefers-reduced-motion: reduce) {
  .sc-overlay,
  .sc-card {
    transition: none !important;
  }
  .sc-card { transform: none; }
}


/* Generic destructive/information variants */
.sc-card.scenario-danger .sc-top-accent { background: linear-gradient(90deg, #7E2F28 0%, #D9685B 72%, #F0A092 100%); }
.scenario-danger .sc-icon-circle { background: #6D2B25; box-shadow: 0 0 0 12rpx rgba(217,104,91,.12), 0 12rpx 28rpx rgba(109,43,37,.18); }
.scenario-danger .sc-icon-line { color: #FFD3CC; }
.scenario-danger .sc-eyebrow { color: #B24F43; }
.scenario-danger .sc-btn-confirm { color: #FFFFFF; background: #C95D52; box-shadow: 0 12rpx 26rpx rgba(201,93,82,.20); }
.scenario-danger .sc-confirm-arrow { background: rgba(255,255,255,.2); color: #FFFFFF; }
.sc-card.scenario-info .sc-top-accent { background: linear-gradient(90deg, #173524 0%, #6F8B55 72%, #B7E82A 100%); }
.scenario-info .sc-icon-circle { background: #173524; }
.scenario-info .sc-icon-line { color: #B7E82A; }
.scenario-info .sc-btn-confirm { flex: 1; justify-content: center; gap: 14rpx; }
.sc-actions .sc-btn-confirm:only-child { flex: 1; justify-content: center; }

/* Choice mode, used instead of native action sheets. */
.sc-card-options { align-items: stretch; padding-top: 38rpx; }
.sc-card-options .sc-title { margin-top: 0; text-align: left; font-size: 31rpx; }
.sc-card-options .sc-msg { text-align: left; font-size: 23rpx; line-height: 1.55; }
.sc-option-list { width: 100%; margin-top: 26rpx; display: flex; flex-direction: column; gap: 10rpx; }
.sc-option { width: 100%; height: 74rpx; margin: 0; padding: 0 22rpx; border-radius: 18rpx; background: #F4F6F2; color: #26382D; font-size: 25rpx; font-weight: 760; line-height: 74rpx; text-align: left; }
.sc-option::after, .sc-option-cancel::after { border: 0; }
.sc-option.danger { background: #FFF0ED; color: #B64E43; }
.sc-option-cancel { width: 100%; height: 72rpx; margin: 18rpx 0 0; border-radius: 18rpx; background: transparent; color: #78837C; font-size: 24rpx; font-weight: 700; line-height: 72rpx; }

/* Exam start prompt — reference style */
.sc-card-layout-exam-start {
  width: 100%;
  max-width: 660rpx;
  min-height: 704rpx;
  padding: 50rpx 44rpx 42rpx;
  border-radius: 46rpx;
  border: 1rpx solid rgba(224, 237, 230, .94);
  background:
    radial-gradient(circle at 76% 18%, rgba(187, 229, 207, .14), rgba(187, 229, 207, 0) 28%),
    radial-gradient(circle at 13% 88%, rgba(218, 238, 226, .22), rgba(218, 238, 226, 0) 34%),
    linear-gradient(180deg, rgba(255, 255, 255, .995) 0%, rgba(250, 253, 251, .985) 100%);
  box-shadow: 0 28rpx 86rpx rgba(25, 61, 47, .19);
}

.sc-card-layout-exam-start::before {
  content: '';
  position: absolute;
  left: -120rpx;
  right: -120rpx;
  top: 294rpx;
  height: 248rpx;
  background: linear-gradient(166deg, rgba(237, 246, 241, .78) 0%, rgba(247, 251, 248, .22) 52%, rgba(255, 255, 255, 0) 78%);
  transform: rotate(-1.8deg);
  transform-origin: center;
  pointer-events: none;
}

.sc-card-layout-exam-start::after {
  content: '';
  position: absolute;
  width: 420rpx;
  height: 420rpx;
  right: -238rpx;
  top: -182rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(210, 240, 224, .22) 0%, rgba(210, 240, 224, 0) 69%);
  pointer-events: none;
}

.sc-card-layout-exam-start .sc-exam-hero,
.sc-card-layout-exam-start .sc-title-exam,
.sc-card-layout-exam-start .sc-subtitle,
.sc-card-layout-exam-start .sc-meta-row,
.sc-card-layout-exam-start .sc-msg-exam,
.sc-card-layout-exam-start .sc-actions-exam {
  position: relative;
  z-index: 1;
}

.sc-exam-hero {
  width: 240rpx;
  height: 224rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sc-exam-hero-image {
  width: 236rpx;
  height: 220rpx;
}

.sc-title-exam {
  margin-top: 14rpx;
  color: #173E35;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 900;
  letter-spacing: .4rpx;
}

.sc-subtitle {
  margin-top: 18rpx;
  color: #718982;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: .3rpx;
}

.sc-meta-row {
  width: 100%;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  color: #78918A;
}

.sc-meta-item {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #78918A;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
}

.sc-meta-icon-image {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.sc-meta-text {
  white-space: nowrap;
}

.sc-meta-divider {
  width: 1rpx;
  height: 28rpx;
  margin: 0 18rpx;
  flex-shrink: 0;
  background: rgba(138, 162, 153, .30);
}

.sc-msg-exam {
  margin-top: 20rpx;
  color: #7B8F89;
  font-size: 22rpx;
  line-height: 1.65;
}

.sc-actions-exam {
  width: 100%;
  margin-top: 42rpx;
  gap: 16rpx;
}

.sc-card-layout-exam-start .sc-btn {
  height: 98rpx;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 850;
}

.sc-btn-cancel-exam {
  flex: .98;
  justify-content: center;
  gap: 12rpx;
  color: #397E67;
  background: linear-gradient(180deg, rgba(253, 255, 254, .98) 0%, rgba(245, 250, 247, .98) 100%);
  border: 2rpx solid rgba(177, 221, 197, .70);
  box-shadow: 0 10rpx 26rpx rgba(61, 132, 102, .07);
}

.sc-btn-confirm-exam {
  flex: 1.12;
  justify-content: center;
  gap: 16rpx;
  padding-left: 34rpx;
  padding-right: 32rpx;
  color: #FFFFFF;
  background: linear-gradient(132deg, #2FC27A 0%, #69D989 100%);
  box-shadow: 0 15rpx 32rpx rgba(64, 177, 112, .25);
}

.sc-action-icon {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}

.sc-action-icon-refresh {
  width: 36rpx;
  height: 36rpx;
}

.sc-action-icon-arrow {
  width: 34rpx;
  height: 34rpx;
}

.sc-card-layout-exam-start .sc-btn-cancel-pressed {
  background: #F0F7F3;
  transform: scale(.985);
}

.sc-card-layout-exam-start .sc-btn-confirm-pressed {
  opacity: .9;
  transform: scale(.985);
}

@media (max-width: 360px) {
  .sc-card-layout-exam-start {
    padding-left: 34rpx;
    padding-right: 34rpx;
  }

  .sc-meta-divider {
    margin-left: 12rpx;
    margin-right: 12rpx;
  }

  .sc-meta-item {
    font-size: 20rpx;
  }
}

/* Opt-in mint study result dialogs; unrelated/default callers are unchanged. */
.sc-theme-mint { background: rgba(35,72,60,.42); }
.sc-theme-mint .sc-top-accent { background: linear-gradient(90deg,#3A6F5B,#7ED8B5); }
.sc-theme-mint .sc-icon-circle { background: #EAF9F4; box-shadow: 0 0 0 12rpx rgba(126,216,181,.12); }
.sc-theme-mint .sc-icon-line { color: #3A6F5B; }
.sc-theme-mint .sc-title { color: #23483C; }
.sc-theme-mint .sc-msg, .sc-theme-mint .sc-eyebrow { color: #507568; }
.sc-theme-mint .sc-btn-cancel { background: #EAF9F4; color: #3A6F5B; border-color: #D8EEE6; }
.sc-theme-mint .sc-btn-confirm { color: #FFFFFF; background: #3A6F5B; box-shadow: 0 10rpx 24rpx rgba(58,111,91,.15); }
.sc-theme-mint .sc-confirm-arrow { background: #7ED8B5; color: #23483C; }
.sc-theme-mint .scenario-danger .sc-btn-confirm { background: #C95D52; }
