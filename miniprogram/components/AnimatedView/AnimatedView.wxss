/* AnimatedView - Lottie -> GIF -> PNG -> static -> hidden fallback
   风格：白色磨砂玻璃 + 蓝调（MemoGrad 学习 App 主题）
   与番茄钟的暗色沉浸风格明确区分 */

.celebration-shell {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.celebration-shell.active {
  opacity: 1;
  pointer-events: auto;
}

/* ── 白色磨砂背景（独立 view，避免被 canvas 原生层级覆盖）── */
/* backdrop-filter 在部分微信版本不支持，故将 alpha 降到 0.52 保证降级时也能透出底层内容 */
.celeb-overlay-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(145deg, rgba(15, 23, 42, 0.26), rgba(37, 99, 235, 0.12));
  backdrop-filter: blur(14rpx);
  -webkit-backdrop-filter: blur(14rpx);
}

.celeb-orb {
  position: absolute;
  border-radius: 999rpx;
  z-index: 2;
  opacity: 0.72;
  filter: blur(2rpx);
}

.orb-a {
  top: calc(50% - 350rpx);
  left: 64rpx;
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(110, 193, 255, 0.54), rgba(110, 193, 255, 0));
}

.orb-b {
  right: 44rpx;
  bottom: calc(50% - 380rpx);
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.34), rgba(245, 158, 11, 0));
}

.celeb-glass-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 624rpx;
  min-height: 1200rpx;
  border-radius: 48rpx;
  z-index: 3;
  overflow: hidden;
  transform: translate(-50%, -50%);
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.86), rgba(239, 246, 255, 0.64));
  border: 1rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 36rpx 96rpx rgba(15, 23, 42, 0.22), 0 10rpx 28rpx rgba(79, 127, 255, 0.12), inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(34rpx);
  -webkit-backdrop-filter: blur(34rpx);
}

.glass-rim {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  border-radius: 38rpx;
  border: 1rpx solid rgba(79, 127, 255, 0.11);
}

.glass-shine {
  position: absolute;
  top: -170rpx;
  left: -110rpx;
  width: 520rpx;
  height: 320rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  transform: rotate(-18deg);
}

.glass-stage {
  position: absolute;
  top: 74rpx;
  left: 50%;
  width: 380rpx;
  height: 300rpx;
  border-radius: 40rpx;
  transform: translateX(-50%);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.68), rgba(219, 234, 254, 0.34));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.86), 0 18rpx 46rpx rgba(79, 127, 255, 0.12);
}

/* ── Canvas 粒子层 ── */
.canvas-layer {
  position: absolute;
  top: calc(50% - 228rpx);
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  z-index: 4;
  transform: translateX(-50%);
}

.celebration-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
}


.media-layer {
  position: absolute;
  top: calc(50% - 228rpx);
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  transform: translateX(-50%);
}

.fallback-media {
  width: 300rpx;
  height: 300rpx;
}

.static-media {
  transform: scale(1);
}

/* ── CSS 降级层 ── */
.fallback-layer {
  position: absolute;
  top: calc(50% - 228rpx);
  left: 50%;
  width: 300rpx;
  height: 300rpx;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transform: translateX(-50%);
}

.fallback-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 2;
  background: transparent;
}

.fallback-content {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fb-badge {
  position: relative;
  z-index: 15;
  width: 180rpx;
  height: 180rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.fb-ring {
  position: absolute;
  width: 154rpx;
  height: 154rpx;
  border-radius: 999rpx;
  background: rgba(201, 247, 226, 0.92);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  transform: scale(0);
  opacity: 0;
  animation: fbSuccessRing 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
}

.fb-core {
  position: relative;
  z-index: 2;
  width: 130rpx;
  height: 130rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2CD992 0%, #22C55E 100%);
  box-shadow: 0 22rpx 56rpx rgba(34, 197, 94, 0.34);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  transform: scale(0);
  animation: fbSuccessCore 0.72s cubic-bezier(0.16, 1, 0.3, 1) 0.18s both;
}

.fb-check {
  position: relative;
  width: 82rpx;
  height: 58rpx;
  transform: rotate(-45deg);
}

.fb-check-stem,
.fb-check-tail {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  transform-origin: left center;
  transform: scaleX(0);
}

.fb-check-stem {
  width: 34rpx;
  height: 14rpx;
  animation: fbCheckDraw 0.18s ease-out 0.72s both;
}

.fb-check-tail {
  width: 76rpx;
  height: 14rpx;
  transform: rotate(90deg) scaleX(0);
  animation: fbCheckDrawTail 0.26s ease-out 0.88s both;
}

.fb-badge.practice .fb-core,
.fb-badge.steady .fb-core {
  background: linear-gradient(135deg, #2CD992 0%, #22C55E 100%);
  box-shadow: 0 22rpx 56rpx rgba(34, 197, 94, 0.34);
}

.fb-badge.excellent .fb-core,
.fb-badge.final .fb-core {
  background: linear-gradient(135deg, #22C55E 0%, #7BD88F 100%);
  box-shadow: 0 22rpx 56rpx rgba(34, 197, 94, 0.36);
}

.fb-badge.combo .fb-core {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 22rpx 56rpx rgba(245, 158, 11, 0.4);
}

.fb-badge.focus .fb-core {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
  box-shadow: 0 22rpx 56rpx rgba(139, 92, 246, 0.36);
}

.fb-badge.group .fb-core {
  background: linear-gradient(135deg, #6EC1FF 0%, #4F7FFF 100%);
  box-shadow: 0 22rpx 56rpx rgba(110, 193, 255, 0.36);
}

.fallback-hint {
  position: relative;
  z-index: 6;
  margin-top: 28rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  color: #4F7FFF;
  font-size: 24rpx;
  animation: fbTextIn 0.5s ease 0.3s both;
}

/* 粒子 */
.fallback-fireworks,
.fallback-particles {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  pointer-events: none;
}

.fw {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  animation: fwBurst 1.2s ease-out forwards;
}

.fw-1 { left: 20%; top: 30%; background: #4F7FFF; animation-delay: 0.1s; }
.fw-2 { left: 50%; top: 20%; background: #6EC1FF; animation-delay: 0.15s; }
.fw-3 { left: 72%; top: 38%; background: #22C55E; animation-delay: 0.2s; }
.fw-4 { right: 15%; top: 55%; background: #F59E0B; animation-delay: 0.25s; }
.fw-5 { left: 35%; top: 60%; background: #4F7FFF; animation-delay: 0.12s; }
.fw-6 { left: 58%; top: 70%; background: #6EC1FF; animation-delay: 0.28s; }

.fp {
  position: absolute;
  border-radius: 50%;
  animation: fpFloat 1.5s ease-out forwards;
}

.fp-1 { left: 15%; top: 50%; width: 6rpx; height: 6rpx; background: #4F7FFF; animation-delay: 0.05s; }
.fp-2 { left: 30%; top: 15%; width: 8rpx; height: 8rpx; background: #6EC1FF; animation-delay: 0.1s; }
.fp-3 { left: 65%; top: 25%; width: 5rpx; height: 5rpx; background: #22C55E; animation-delay: 0.15s; }
.fp-4 { right: 25%; top: 60%; width: 7rpx; height: 7rpx; background: #F59E0B; animation-delay: 0.2s; }
.fp-5 { left: 45%; bottom: 30%; width: 6rpx; height: 6rpx; background: #4F7FFF; animation-delay: 0.08s; }
.fp-6 { left: 75%; bottom: 40%; width: 8rpx; height: 8rpx; background: #6EC1FF; animation-delay: 0.22s; }
.fp-7 { left: 10%; bottom: 50%; width: 5rpx; height: 5rpx; background: #22C55E; animation-delay: 0.18s; }
.fp-8 { right: 30%; top: 40%; width: 7rpx; height: 7rpx; background: #4F7FFF; animation-delay: 0.25s; }

@keyframes fbSuccessRing {
  0% { opacity: 0; transform: scale(0.2); }
  35% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.38); }
}

@keyframes fbSuccessCore {
  0% { opacity: 0; transform: scale(0); }
  58% { opacity: 1; transform: scale(1.16); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes fbCheckDraw {
  from { transform: scaleX(0); }
  to { transform: scaleX(1); }
}

@keyframes fbCheckDrawTail {
  from { transform: rotate(90deg) scaleX(0); }
  to { transform: rotate(90deg) scaleX(1); }
}

@keyframes fbTextIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fwBurst {
  0% { opacity: 1; transform: translate(0, 0) scale(1); }
  100% { opacity: 0; transform: translate(var(--dx, 60rpx), var(--dy, -80rpx)) scale(0.2); }
}

@keyframes fpFloat {
  0% { opacity: 0; transform: translateY(30rpx) scale(0.5); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-120rpx) scale(1.2); }
}

/* ── 文字庆祝内容（cover-view 叠加层，用于 Lottie canvas 模式）── */
/* cover-view 可渲染在原生 canvas 上方，但 CSS 能力受限（无 flex/gradient/animation） */
.celeb-text-cover {
  position: absolute;
  top: calc(50% + 70rpx);
  left: 50%;
  width: 540rpx;
  z-index: 10;
  opacity: 0;
  text-align: center;
  transition: opacity 0.4s ease;
  transform: translateX(-50%);
}

.celeb-text-cover.content-in-cover {
  opacity: 1;
}

.celeb-progress-cover {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
  margin-bottom: 10rpx;
  text-align: center;
}

.celeb-title-cover {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #1E293B;
  line-height: 1.2;
  margin: 0 32rpx 12rpx;
  text-align: center;
}

.celeb-detail-cover {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.45;
  margin: 0 32rpx 14rpx;
  text-align: center;
}

.celeb-reward-cover {
  display: inline-block;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.12);
  color: #4F7FFF;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  text-align: center;
}

.reward-spark-cover {
  display: inline;
  color: #F59E0B;
  font-size: 24rpx;
}

.reward-text-cover {
  display: inline;
}

.celeb-motto-cover {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
  margin: 0 48rpx 28rpx;
  text-align: center;
}

.celeb-growth-cover {
  display: inline-block;
  width: 480rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(79, 127, 255, 0.1);
  text-align: center;
}

.celeb-growth-head-cover {
  display: block;
  text-align: center;
  margin-bottom: 12rpx;
}

.celeb-growth-level-cover {
  display: inline;
  font-size: 28rpx;
  font-weight: 900;
  color: #1E293B;
}

.celeb-growth-pct-cover {
  display: inline;
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
  margin-left: 16rpx;
}

.celeb-growth-track-cover {
  display: block;
  height: 10rpx;
  border-radius: 999rpx;
  background: #E2E8F0;
  overflow: hidden;
  margin-bottom: 10rpx;
  width: 100%;
}

.celeb-growth-fill-cover {
  display: block;
  height: 100%;
  border-radius: 999rpx;
  background: #4F7FFF;
}

.celeb-growth-desc-cover {
  display: block;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
  text-align: center;
}

.celeb-tap-cover {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  color: #4F7FFF;
  font-size: 24rpx;
}

/* ── 文字庆祝内容（view 叠加层，用于 CSS 降级模式）── */
.celeb-text-overlay {
  position: absolute;
  top: calc(50% + 70rpx);
  left: 50%;
  width: 540rpx;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0;
  transform: translate(-50%, 20rpx);
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}

.celeb-text-overlay.content-in {
  opacity: 1;
  transform: translate(-50%, 0);
}

.celeb-progress-text {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
  margin-bottom: 10rpx;
}

.celeb-title {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #1E293B;
  line-height: 1.2;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 12rpx rgba(79, 127, 255, 0.12);
}

.celeb-detail {
  display: block;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.45;
  margin-bottom: 14rpx;
}

.celeb-reward {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.12), rgba(110, 193, 255, 0.08));
  color: #4F7FFF;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.reward-spark {
  color: #F59E0B;
  font-size: 24rpx;
}

.celeb-motto {
  display: block;
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.5;
  margin-bottom: 28rpx;
  padding: 0 48rpx;
  text-align: center;
}

/* 成长结算卡（final 类型使用） */
.celeb-growth {
  width: 480rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(79, 127, 255, 0.1);
}

.celeb-growth-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.celeb-growth-level {
  font-size: 28rpx;
  font-weight: 900;
  color: #1E293B;
}

.celeb-growth-pct {
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
}

.celeb-growth-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #E2E8F0;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.celeb-growth-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF, #6EC1FF);
  transition: width 0.4s ease-out;
}

.celeb-growth-desc {
  display: block;
  font-size: 22rpx;
  color: #64748B;
  line-height: 1.4;
}

.celeb-tap-hint {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  color: #4F7FFF;
  font-size: 24rpx;
  pointer-events: auto;
}

/* ══════════════════════════════════════════════
   Dark theme — immersive dark glass for pomodoro / focus pages
   ══════════════════════════════════════════════ */
.theme-dark .celeb-overlay-bg {
  background: linear-gradient(145deg, rgba(11, 17, 33, 0.88), rgba(15, 23, 42, 0.82));
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

.theme-dark .celeb-glass-card {
  background: linear-gradient(155deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 36rpx 96rpx rgba(0, 0, 0, 0.4), 0 10rpx 28rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 rgba(255, 255, 255, 0.06);
}

.theme-dark .glass-rim {
  border-color: rgba(255, 255, 255, 0.04);
}

.theme-dark .glass-shine {
  opacity: 0.15;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.25), rgba(255, 255, 255, 0));
}

.theme-dark .glass-stage {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(11, 17, 33, 0.12));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06), 0 18rpx 46rpx rgba(0, 0, 0, 0.2);
}

.theme-dark .orb-a {
  background: radial-gradient(circle, rgba(59, 130, 246, 0.28), rgba(59, 130, 246, 0));
}

.theme-dark .orb-b {
  background: radial-gradient(circle, rgba(249, 115, 22, 0.18), rgba(249, 115, 22, 0));
}

/* cover-view text (Lottie mode) */
.theme-dark .celeb-title-cover {
  color: rgba(255, 255, 255, 0.9);
}

.theme-dark .celeb-detail-cover {
  color: rgba(255, 255, 255, 0.5);
}

.theme-dark .celeb-motto-cover {
  color: rgba(59, 130, 246, 0.6);
}

.theme-dark .celeb-tap-cover {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-dark .celeb-progress-cover {
  color: #60A5FA;
}

.theme-dark .celeb-reward-cover {
  background: rgba(59, 130, 246, 0.12);
  color: #60A5FA;
}

/* fallback view text */
.theme-dark .celeb-title {
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.15);
}

.theme-dark .celeb-detail {
  color: rgba(255, 255, 255, 0.5);
}

.theme-dark .celeb-motto {
  color: rgba(59, 130, 246, 0.55);
}

.theme-dark .celeb-tap-hint {
  background: rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.theme-dark .celeb-progress-text {
  color: #60A5FA;
}

.theme-dark .celeb-reward {
  background: rgba(59, 130, 246, 0.12);
  color: #60A5FA;
}

/* dark fallback & growth cards */
.theme-dark .celeb-growth {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.06);
  box-shadow: none;
}

/* dark fallback static layer */
.theme-dark .fb-ring {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.12);
}

.theme-dark .fb-core {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.6), rgba(6, 182, 212, 0.5));
  box-shadow: 0 22rpx 56rpx rgba(59, 130, 246, 0.3);
}

.theme-dark .fb-badge.excellent .fb-core,
.theme-dark .fb-badge.final .fb-core {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.65), rgba(6, 182, 212, 0.55));
  box-shadow: 0 22rpx 56rpx rgba(59, 130, 246, 0.25);
}

.theme-dark .fb-check-stem,
.theme-dark .fb-check-tail {
  background: rgba(255, 255, 255, 0.9);
}

.theme-dark .fw-1, .theme-dark .fw-5 { background: #60A5FA; }
.theme-dark .fw-2, .theme-dark .fw-6 { background: #38BDF8; }
.theme-dark .fw-3 { background: #22C55E; }
.theme-dark .fw-4 { background: #F59E0B; }

.theme-dark .fp-1, .theme-dark .fp-5, .theme-dark .fp-8 { background: #60A5FA; }
.theme-dark .fp-2, .theme-dark .fp-6 { background: #38BDF8; }
.theme-dark .fp-3, .theme-dark .fp-7 { background: #22C55E; }
.theme-dark .fp-4 { background: #F59E0B; }

.theme-dark .celeb-growth-level,
.theme-dark .celeb-growth-level-cover {
  color: rgba(255, 255, 255, 0.85);
}

.theme-dark .celeb-growth-pct,
.theme-dark .celeb-growth-pct-cover {
  color: #60A5FA;
}

.theme-dark .celeb-growth-track,
.theme-dark .celeb-growth-track-cover {
  background: rgba(255, 255, 255, 0.06);
}

.theme-dark .celeb-growth-desc,
.theme-dark .celeb-growth-desc-cover {
  color: rgba(255, 255, 255, 0.3);
}

.theme-dark .celeb-growth-cover {
  background: rgba(255, 255, 255, 0.04);
  border-color: rgba(255, 255, 255, 0.06);
}

@media (prefers-reduced-motion: reduce) {
  .fb-core,
  .fb-ring,
  .fb-check-stem,
  .fb-check-tail,
  .fallback-hint,
  .fw,
  .fp,
  .celeb-text-overlay,
  .celeb-text-cover {
    animation: none !important;
    transition: none !important;
    opacity: 1;
  }
  .celebration-shell {
    transition: none !important;
  }
  .celeb-text-overlay {
    transform: none !important;
  }
  .fb-core,
  .fb-ring,
  .fb-check-stem,
  .fb-check-tail {
    opacity: 1;
    transform: none !important;
  }
  .fb-check-tail {
    transform: rotate(90deg) !important;
  }
  .canvas-layer {
    display: none;
  }
}
