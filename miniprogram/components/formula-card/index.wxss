.formula-card-wrap {
  padding: 20rpx 0;
}

.fc-header {
  margin-bottom: 24rpx;
}

.fc-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #17251B;
  line-height: 1.4;
  display: block;
}

.fc-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.fc-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.fc-tag-basic { background: #EDF4E8; color: #3D754F; }
.fc-tag-high_frequency { background: #FFF3DF; color: #A96518; }
.fc-tag-error_prone { background: #FDEBE8; color: #B24F43; }
.fc-tag-must_memorize { background: #F0EBF6; color: #735C8A; }

.fc-formula-section {
  background: #F6F7F2;
  border-radius: 26rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.fc-formula-block {
  margin-bottom: 16rpx;
}
.fc-formula-block:last-child {
  margin-bottom: 0;
}

.fc-block-label {
  font-size: 26rpx;
  color: #68756C;
  display: block;
  margin-bottom: 8rpx;
}

.fc-block-note {
  font-size: 24rpx;
  color: #8A938C;
  display: block;
  margin-top: 8rpx;
}

.fc-graph-section {
  margin-bottom: 20rpx;
}

.fc-graph-image {
  width: 100%;
  border-radius: 26rpx;
}

.fc-section {
  margin-bottom: 20rpx;
}

.fc-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #26352C;
  display: block;
  margin-bottom: 8rpx;
}

.fc-collapse {
  border-top: 1rpx solid #E1E5DE;
}

.fc-collapse-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.fc-collapse-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #26352C;
}

.fc-collapse-arrow {
  font-size: 28rpx;
  color: #8A938C;
  transition: transform 0.2s;
}

.fc-collapse-arrow.expanded {
  transform: rotate(90deg);
}

.fc-collapse-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.fc-collapse-body.open {
  max-height: none;
  padding-bottom: 20rpx;
}

.fc-example {
  margin-bottom: 24rpx;
  padding: 16rpx;
  background: #F6F7F2;
  border-radius: 22rpx;
}

.fc-example-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #66844F;
  display: block;
  margin-bottom: 6rpx;
}

.fc-example-label.error {
  color: #C65A4E;
}

.fc-example-detail {
  margin-top: 12rpx;
}

.fc-header { padding-bottom:20rpx; border-bottom:1rpx solid #E1E5DE; }
.fc-formula-section { border:1rpx solid #E1E5DE; }
.fc-section { padding:20rpx 0; border-bottom:1rpx solid #E7EAE4; }
.fc-collapse-header { min-height:82rpx; }
.fc-collapse-arrow { width:26rpx; height:26rpx; font-size:0; position:relative; }
.fc-collapse-arrow::before { content:''; position:absolute; left:7rpx; top:6rpx; width:10rpx; height:10rpx; border-right:3rpx solid #79847C; border-bottom:3rpx solid #79847C; transform:rotate(-45deg); transition:transform .2s ease; }
.fc-collapse-arrow.expanded::before { transform:rotate(45deg); }
.fc-collapse-arrow.expanded { transform:none; }
