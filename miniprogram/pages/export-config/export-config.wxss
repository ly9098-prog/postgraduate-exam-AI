/* Export configuration page — warm, calm, professional */
page {
  background: #F3F4EE;
  background-color: #F3F4EE;
}

view, scroll-view, button, input, text, picker, switch {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.export-config-page {
  width: 100%;
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: linear-gradient(180deg, #F8F8F3 0%, #EFF2EB 100%);
  color: #17231A;
}

.config-scroll {
  width: 100%;
  height: 0;
  flex: 1;
}

.config-content {
  width: 100%;
  padding: 24rpx 26rpx 0;
  overflow: hidden;
}

/* ── Intro ── */
.page-intro {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-width: 0;
  gap: 18rpx;
  padding: 8rpx 4rpx 24rpx;
}

.page-intro-copy {
  min-width: 0;
  flex: 1;
}

.page-intro-title,
.page-intro-caption {
  display: block;
}

.page-intro-title {
  color: #17231A;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: 0.2rpx;
}

.page-intro-caption {
  max-width: 650rpx;
  margin-top: 9rpx;
  color: #7A867D;
  font-size: 23rpx;
  line-height: 1.55;
}

.records-entry {
  width: auto;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 9rpx;
  margin: 1rpx 0 0;
  padding: 0 17rpx;
  border: 1rpx solid rgba(87, 132, 101, 0.34);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #376B49;
  font-size: 20rpx;
  font-weight: 780;
  line-height: 58rpx;
  box-shadow: 0 5rpx 16rpx rgba(38, 73, 47, 0.07);
}

.records-entry-clock {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.records-entry-hand {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform-origin: 50% 100%;
}

.records-entry-hand-hour {
  height: 6rpx;
  transform: translate(-50%, -100%) rotate(0deg);
}

.records-entry-hand-minute {
  height: 7rpx;
  transform: translate(-50%, -100%) rotate(125deg);
}

.records-entry-pressed {
  transform: scale(0.97);
  opacity: 0.76;
}

/* ── Cards and headings ── */
.config-card {
  width: 100%;
  max-width: 100%;
  margin-bottom: 20rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(214, 220, 211, 0.95);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 10rpx 28rpx rgba(31, 55, 39, 0.06);
}

.section-heading {
  margin-bottom: 22rpx;
}

.section-title,
.section-caption {
  display: block;
}

.section-title {
  color: #17231A;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.section-caption {
  margin-top: 6rpx;
  color: #849087;
  font-size: 21rpx;
  line-height: 1.45;
}

/* ── Range cards ── */
.choice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.choice-card {
  width: 100%;
  min-height: 94rpx;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 17rpx 18rpx;
  border: 2rpx solid transparent;
  border-radius: 19rpx;
  background: #F5F7F2;
  transition: border-color 0.16s ease, background-color 0.16s ease, transform 0.16s ease;
}

.choice-card-active {
  border-color: #73B38B;
  background: #EAF5ED;
}

.choice-indicator {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid #B8C1BA;
  border-radius: 50%;
  background: #FFFFFF;
}

.choice-indicator-core {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: transparent;
  transform: scale(0.5);
  transition: transform 0.16s ease, background-color 0.16s ease;
}

.choice-card-active .choice-indicator {
  border-color: #2F8A55;
}

.choice-card-active .choice-indicator-core {
  background: #2F8A55;
  transform: scale(1);
}

.choice-copy {
  min-width: 0;
  flex: 1;
  margin-left: 16rpx;
}

.choice-title,
.choice-caption {
  display: block;
}

.choice-title {
  color: #26332A;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.choice-caption {
  margin-top: 4rpx;
  color: #849087;
  font-size: 20rpx;
  line-height: 1.4;
}

.choice-badge {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: #D8ECDD;
  color: #287748;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.35;
}

/* ── Format ── */
.format-grid {
  width: 100%;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.format-card {
  position: relative;
  width: 0;
  min-width: 0;
  flex: 1;
  min-height: 172rpx;
  padding: 18rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #F5F7F2;
  transition: border-color 0.16s ease, background-color 0.16s ease, opacity 0.16s ease;
}

.format-card-active {
  border-color: #73B38B;
  background: #EAF5ED;
}

.format-card-disabled {
  opacity: 0.5;
}

.format-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.format-token {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 11rpx;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 40rpx;
  letter-spacing: 0.5rpx;
}

.format-token-pdf {
  background: #E8EFF8;
  color: #386488;
}

.format-token-word {
  background: #EFEAF7;
  color: #65518A;
}

.format-check {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  border: 2rpx solid #BDC6BF;
  border-radius: 50%;
  background: #FFFFFF;
}

.format-card-active .format-check {
  position: relative;
  border-color: #2F8A55;
  background: #2F8A55;
}

.format-card-active .format-check::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 13rpx;
  border-right: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(45deg);
}

.format-title,
.format-caption,
.format-disabled-tip {
  display: block;
}

.format-title {
  margin-top: 17rpx;
  color: #26332A;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.35;
}

.format-caption {
  margin-top: 5rpx;
  color: #849087;
  font-size: 20rpx;
  line-height: 1.45;
}

.format-disabled-tip {
  margin-top: 9rpx;
  color: #9B6B3C;
  font-size: 19rpx;
  font-weight: 750;
}

.inline-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 21rpx;
  line-height: 1.45;
}

.inline-hint-warn {
  color: #A86629;
}

/* ── Reference-paper layout presets ── */
.section-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-heading-row > view {
  min-width: 0;
  flex: 1;
}

.custom-layout-badge {
  flex-shrink: 0;
  padding: 5rpx 11rpx;
  border-radius: 999rpx;
  background: #EEF1EC;
  color: #667169;
  font-size: 18rpx;
  font-weight: 780;
  line-height: 1.4;
}

.preset-grid {
  display: flex;
  flex-direction: column;
  gap: 11rpx;
}

.preset-card {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 15rpx 16rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: #F5F7F2;
  transition: border-color 0.16s ease, background-color 0.16s ease;
}

.preset-card-active {
  border-color: #73B38B;
  background: #EAF5ED;
}

.preset-radio {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid #B7C0B9;
  border-radius: 50%;
  background: #FFFFFF;
}

.preset-radio-core {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: transparent;
  transform: scale(0.5);
  transition: transform 0.16s ease, background-color 0.16s ease;
}

.preset-card-active .preset-radio {
  border-color: #2F8A55;
}

.preset-card-active .preset-radio-core {
  background: #2F8A55;
  transform: scale(1);
}

.preset-copy {
  min-width: 0;
  flex: 1;
  margin-left: 14rpx;
}

.preset-title,
.preset-caption {
  display: block;
}

.preset-title {
  color: #2A382F;
  font-size: 24rpx;
  font-weight: 820;
  line-height: 1.35;
}

.preset-caption {
  margin-top: 3rpx;
  color: #849087;
  font-size: 19rpx;
  line-height: 1.45;
}

.paper-style-preview {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid #E0E5DE;
  border-radius: 19rpx;
  background: #FAFBF8;
}

.paper-sheet {
  position: relative;
  width: 118rpx;
  height: 156rpx;
  flex-shrink: 0;
  overflow: hidden;
  border: 1rpx solid #D5DAD4;
  border-radius: 3rpx;
  background: #FFFFFF;
  box-shadow: 0 7rpx 16rpx rgba(35, 50, 40, 0.09);
}

.paper-mini-title,
.paper-mini-subtitle,
.paper-mini-section,
.paper-mini-line,
.paper-mini-options view {
  position: absolute;
  left: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #475048;
}

.paper-mini-title {
  top: 18rpx;
  left: 34rpx;
  width: 50rpx;
  height: 4rpx;
  background: #252C27;
}

.paper-mini-subtitle {
  top: 26rpx;
  left: 42rpx;
  width: 34rpx;
  background: #6E766F;
}

.paper-mini-section {
  top: 43rpx;
  width: 52rpx;
  height: 3rpx;
  background: #2D342F;
}

.paper-mini-line-one { top: 55rpx; width: 82rpx; }
.paper-mini-line-two { top: 63rpx; width: 72rpx; }
.paper-mini-line-three { top: 98rpx; width: 78rpx; }

.paper-mini-options {
  position: absolute;
  left: 22rpx;
  right: 16rpx;
  top: 76rpx;
  display: flex;
  justify-content: space-between;
}

.paper-mini-options view {
  position: static;
  width: 14rpx;
  height: 2rpx;
  background: #697169;
}

.paper-mini-page {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 7rpx;
  color: #788078;
  font-family: serif;
  font-size: 10rpx;
  line-height: 1;
  text-align: center;
}

.paper-preview-copy {
  min-width: 0;
  flex: 1;
}

.paper-preview-title,
.paper-preview-caption,
.paper-preview-summary {
  display: block;
}

.paper-preview-title {
  color: #29362D;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1.35;
}

.paper-preview-caption {
  margin-top: 6rpx;
  color: #7D8880;
  font-size: 19rpx;
  line-height: 1.5;
}

.paper-preview-summary {
  margin-top: 9rpx;
  color: #34724B;
  font-size: 18rpx;
  font-weight: 720;
  line-height: 1.5;
}

/* ── Paper information ── */
.field-block {
  min-width: 0;
}

.field-label,
.field-caption {
  display: block;
}

.field-label {
  color: #344139;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.field-caption {
  margin-top: 4rpx;
  color: #8A948D;
  font-size: 20rpx;
  line-height: 1.4;
}

.input-shell {
  position: relative;
  width: 100%;
  margin-top: 13rpx;
}

.title-input {
  width: 100%;
  height: 82rpx;
  padding: 0 100rpx 0 18rpx;
  border: 2rpx solid #DDE3DC;
  border-radius: 16rpx;
  background: #FAFBF8;
  color: #26332A;
  font-size: 25rpx;
  line-height: 82rpx;
}

.title-input:focus {
  border-color: #6BA985;
  background: #FFFFFF;
}

.input-placeholder {
  color: #A0A8A2;
}

.input-count {
  position: absolute;
  right: 17rpx;
  top: 50%;
  color: #A0A8A2;
  font-size: 18rpx;
  line-height: 1;
  transform: translateY(-50%);
}

.field-divider,
.setting-divider {
  width: 100%;
  height: 1rpx;
  background: #E9ECE7;
}

.field-divider {
  margin: 24rpx 0;
}

.date-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.date-setting-copy {
  min-width: 0;
  flex: 1;
}

.date-setting switch {
  flex-shrink: 0;
  transform: scale(0.84);
  transform-origin: right center;
}

.date-picker {
  display: block;
  width: 100%;
  margin-top: 17rpx;
}

.date-value-row {
  width: 100%;
  height: 72rpx;
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 0 16rpx;
  border: 1rpx solid #E0E5DE;
  border-radius: 15rpx;
  background: #F7F9F5;
}

.date-icon {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  border: 2rpx solid #748178;
  border-radius: 6rpx;
}

.date-icon::before,
.date-icon::after {
  content: '';
  position: absolute;
  top: -5rpx;
  width: 3rpx;
  height: 8rpx;
  border-radius: 2rpx;
  background: #748178;
}

.date-icon::before { left: 6rpx; }
.date-icon::after { right: 6rpx; }

.date-icon-line {
  position: absolute;
  left: 3rpx;
  right: 3rpx;
  top: 7rpx;
  height: 2rpx;
  background: #748178;
}

.date-text {
  min-width: 0;
  flex: 1;
  margin-left: 13rpx;
  color: #46534A;
  font-size: 24rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

/* ── Settings rows ── */
.settings-card {
  padding-bottom: 8rpx;
}

.setting-picker {
  display: block;
  width: 100%;
}

.setting-row {
  width: 100%;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 20rpx;
  padding: 15rpx 0;
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-label,
.setting-caption {
  display: block;
}

.setting-label {
  color: #344139;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.setting-caption {
  margin-top: 4rpx;
  color: #8A948D;
  font-size: 19rpx;
  line-height: 1.4;
}

.setting-value {
  max-width: 48%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
  gap: 13rpx;
  color: #526057;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: right;
}

.row-chevron {
  width: 13rpx;
  height: 13rpx;
  flex-shrink: 0;
  border-top: 2rpx solid #919B94;
  border-right: 2rpx solid #919B94;
  transform: rotate(45deg);
}

/* ── Errors ── */
.submit-error-panel {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 17rpx 19rpx;
  border-radius: 17rpx;
  background: #FCECEA;
  color: #AD4541;
  font-size: 21rpx;
  line-height: 1.5;
}

.submit-error-icon {
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 11rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  font-family: Arial, sans-serif;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
}

.config-safe-space {
  height: calc(152rpx + env(safe-area-inset-bottom));
}

/* ── Floating primary action ── */
.floating-submit-wrap {
  position: fixed;
  z-index: 30;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  min-height: 96rpx;
  transform-origin: center bottom;
  transition:
    opacity 240ms ease,
    transform 280ms cubic-bezier(0.22, 0.8, 0.28, 1),
    visibility 0s linear 280ms;
  will-change: opacity, transform;
}

.floating-submit-wrap-visible {
  visibility: visible;
  opacity: 1;
  transform: translate3d(0, 0, 0);
  pointer-events: auto;
  transition-delay: 0s;
}

.floating-submit-wrap-hidden {
  visibility: hidden;
  opacity: 0;
  transform: translate3d(0, 54rpx, 0);
  pointer-events: none;
}

.floating-submit-hint {
  min-height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 0 20rpx 12rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(190, 87, 78, 0.16);
  border-radius: 18rpx;
  background: rgba(255, 250, 248, 0.97);
  color: #A24D46;
  font-size: 19rpx;
  line-height: 1.45;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(58, 48, 43, 0.08);
}

.floating-submit-hint text {
  min-width: 0;
  flex: 1;
}

.floating-retry {
  width: auto;
  height: 42rpx;
  flex-shrink: 0;
  margin: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(46, 125, 76, 0.24);
  border-radius: 999rpx;
  background: #F4F8F3;
  color: #2E754A;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.floating-retry::after,
.floating-submit-btn::after {
  border: 0;
}

.floating-submit-btn {
  position: relative;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 82rpx 0 42rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  background: linear-gradient(135deg, #31905A 0%, #277B4A 58%, #226F42 100%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 96rpx;
  letter-spacing: 0.4rpx;
  box-shadow:
    0 18rpx 40rpx rgba(32, 111, 65, 0.28),
    0 4rpx 12rpx rgba(23, 72, 42, 0.16),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.22);
  transition:
    transform 160ms ease,
    opacity 160ms ease,
    box-shadow 180ms ease;
}

.floating-submit-wrap-visible .floating-submit-btn {
  animation: floating-submit-arrive 420ms cubic-bezier(0.18, 0.82, 0.25, 1) both;
}

.floating-submit-btn-actionable::before {
  content: '';
  position: absolute;
  top: -30%;
  bottom: -30%;
  left: -34%;
  width: 28%;
  pointer-events: none;
  background: linear-gradient(100deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.24) 48%, rgba(255,255,255,0) 100%);
  transform: skewX(-18deg);
  animation: floating-submit-shine 4.8s ease-in-out 1.2s infinite;
}

.floating-submit-btn-busy {
  opacity: 0.86;
}

.floating-submit-btn-disabled {
  background: linear-gradient(135deg, #B6C0B8 0%, #A3AFA6 100%);
  color: rgba(255, 255, 255, 0.95);
  border-color: rgba(255,255,255,0.18);
  box-shadow: 0 11rpx 26rpx rgba(58, 72, 62, 0.14);
}

.floating-submit-btn[disabled] {
  opacity: 1;
}

.floating-submit-btn-pressed {
  transform: translateY(2rpx) scale(0.985);
  opacity: 0.92;
  box-shadow:
    0 9rpx 20rpx rgba(38, 119, 71, 0.20),
    0 2rpx 6rpx rgba(23, 72, 42, 0.12);
}

.floating-submit-arrow {
  position: absolute;
  right: 18rpx;
  top: 50%;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  transform: translateY(-50%);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.15);
}

.floating-submit-arrow-line {
  position: relative;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
}

.floating-submit-arrow-line::before,
.floating-submit-arrow-line::after {
  content: '';
  position: absolute;
  right: -1rpx;
  width: 10rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
  transform-origin: right center;
}

.floating-submit-arrow-line::before {
  top: -1rpx;
  transform: rotate(45deg);
}

.floating-submit-arrow-line::after {
  bottom: -1rpx;
  transform: rotate(-45deg);
}

@keyframes floating-submit-arrive {
  0% {
    opacity: 0;
    transform: translateY(18rpx) scale(0.985);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes floating-submit-shine {
  0%, 72% {
    left: -34%;
    opacity: 0;
  }
  76% {
    opacity: 1;
  }
  90% {
    left: 112%;
    opacity: 0.1;
  }
  100% {
    left: 112%;
    opacity: 0;
  }
}

@media (max-width: 350px) {
  .page-intro {
    gap: 12rpx;
  }

  .records-entry {
    padding: 0 13rpx;
  }

  .records-entry text {
    font-size: 19rpx;
  }
}
