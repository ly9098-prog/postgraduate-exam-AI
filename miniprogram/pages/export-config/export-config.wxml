<!-- Export configuration page -->

<view class="page export-config-page">
  <premium-nav title="导出设置" show-back="{{true}}" bind:back="onBack" />

  <scroll-view
    class="config-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bindscroll="onConfigScroll"
    bindtouchstart="onPageInteraction"
  >
    <view class="config-content" bindtap="onPageInteraction">
      <view class="page-intro">
        <view class="page-intro-copy">
          <text class="page-intro-title">生成专属错题练习</text>
          <text class="page-intro-caption">选择题目范围和排版方式，导出后可在记录页预览或分享。</text>
        </view>
        <button class="records-entry" hover-class="records-entry-pressed" bindtap="onViewRecords">
          <view class="records-entry-clock">
            <view class="records-entry-hand records-entry-hand-hour"></view>
            <view class="records-entry-hand records-entry-hand-minute"></view>
          </view>
          <text>导出记录</text>
        </button>
      </view>

      <!-- Range -->
      <view class="config-card">
        <view class="section-heading">
          <text class="section-title">导出范围</text>
          <text class="section-caption">选择本次需要整理的错题</text>
        </view>

        <view class="choice-list">
          <view
            class="choice-card {{rangeType === 'all' ? 'choice-card-active' : ''}}"
            data-value="all"
            bindtap="onRangeChange"
          >
            <view class="choice-indicator"><view class="choice-indicator-core"></view></view>
            <view class="choice-copy">
              <text class="choice-title">全部错题</text>
              <text class="choice-caption">导出错题本中的全部题目</text>
            </view>
          </view>

          <view
            class="choice-card {{rangeType === 'filtered' ? 'choice-card-active' : ''}} {{!hasActiveFilters ? 'choice-card-disabled' : ''}}"
            data-value="filtered"
            bindtap="onRangeChange"
          >
            <view class="choice-indicator"><view class="choice-indicator-core"></view></view>
            <view class="choice-copy">
              <text class="choice-title">当前筛选结果</text>
              <text class="choice-caption">{{hasActiveFilters ? '沿用错题本当前的学科和条件筛选' : '当前没有筛选条件'}}</text>
            </view>
          </view>

          <view
            class="choice-card {{rangeType === 'selected' ? 'choice-card-active' : ''}} {{_selectedIds.length === 0 ? 'choice-card-disabled' : ''}}"
            data-value="selected"
            bindtap="onRangeChange"
          >
            <view class="choice-indicator"><view class="choice-indicator-core"></view></view>
            <view class="choice-copy">
              <text class="choice-title">已选错题</text>
              <text class="choice-caption">{{_selectedIds.length > 0 ? '仅导出你在错题本中勾选的题目' : '当前没有已选错题'}}</text>
            </view>
            <text wx:if="{{_selectedIds.length > 0}}" class="choice-badge">{{_selectedIds.length}} 道</text>
          </view>
        </view>
      </view>

      <!-- Format -->
      <view class="config-card">
        <view class="section-heading">
          <text class="section-title">文件格式</text>
          <text class="section-caption">根据阅读和编辑需求选择格式</text>
        </view>

        <view class="format-grid">
          <view
            class="format-card {{format === 'pdf' ? 'format-card-active' : ''}}"
            data-value="pdf"
            bindtap="onFormatChange"
          >
            <view class="format-card-top">
              <text class="format-token format-token-pdf">PDF</text>
              <view class="format-check"></view>
            </view>
            <text class="format-title">版式稳定</text>
            <text class="format-caption">适合预览、打印与分享</text>
          </view>

          <view
            class="format-card {{format === 'docx' ? 'format-card-active' : ''}} {{wordDisabled ? 'format-card-disabled' : ''}}"
            data-value="docx"
            bindtap="onFormatChange"
          >
            <view class="format-card-top">
              <text class="format-token format-token-word">Word</text>
              <view class="format-check"></view>
            </view>
            <text class="format-title">方便编辑</text>
            <text class="format-caption">适合后续修改和排版</text>
            <text wx:if="{{wordDisabled}}" class="format-disabled-tip">暂未开放</text>
          </view>
        </view>
        <text wx:if="{{wordTip}}" class="inline-hint inline-hint-warn">{{wordTip}}</text>
      </view>

      <!-- Reference-paper layout presets -->
      <view class="config-card layout-preset-card">
        <view class="section-heading section-heading-row">
          <view>
            <text class="section-title">版式模板</text>
            <text class="section-caption">默认采用上传真题的字体层级与试卷结构</text>
          </view>
          <text wx:if="{{layoutPreset === 'custom'}}" class="custom-layout-badge">已自定义</text>
        </view>

        <view class="preset-grid">
          <view
            wx:for="{{LAYOUT_PRESETS}}"
            wx:key="value"
            class="preset-card {{layoutPreset === item.value ? 'preset-card-active' : ''}}"
            data-value="{{item.value}}"
            bindtap="onPresetChange"
          >
            <view class="preset-radio"><view class="preset-radio-core"></view></view>
            <view class="preset-copy">
              <text class="preset-title">{{item.label}}</text>
              <text class="preset-caption">{{item.caption}}</text>
            </view>
          </view>
        </view>

        <view class="paper-style-preview">
          <view class="paper-sheet" aria-hidden="true">
            <view class="paper-mini-title"></view>
            <view class="paper-mini-subtitle"></view>
            <view class="paper-mini-section"></view>
            <view class="paper-mini-line paper-mini-line-one"></view>
            <view class="paper-mini-line paper-mini-line-two"></view>
            <view class="paper-mini-options">
              <view></view><view></view><view></view><view></view>
            </view>
            <view class="paper-mini-line paper-mini-line-three"></view>
            <view class="paper-mini-page">· 1 ·</view>
          </view>
          <view class="paper-preview-copy">
            <text class="paper-preview-title">真题式打印效果</text>
            <text class="paper-preview-caption">宋体正文、黑体分区标题、紧凑选项与居中页码</text>
            <text class="paper-preview-summary">{{layoutSummary}}</text>
          </view>
        </view>
      </view>

      <!-- Paper information -->
      <view class="config-card">
        <view class="section-heading">
          <text class="section-title">试卷信息</text>
          <text class="section-caption">设置显示在文件首页的信息</text>
        </view>

        <view class="field-block">
          <text class="field-label">试卷标题</text>
          <view class="input-shell">
            <input
              class="title-input"
              placeholder="{{titleDefault}}"
              placeholder-class="input-placeholder"
              value="{{title}}"
              bindinput="onTitleInput"
              bindfocus="onTitleFocus"
              bindblur="onTitleBlur"
              maxlength="120"
            />
            <text class="input-count">{{title.length}}/120</text>
          </view>
        </view>

      </view>

      <!-- Layout settings -->
      <view class="config-card settings-card">
        <view class="section-heading">
          <text class="section-title">内容与排版</text>
          <text class="section-caption">可在模板基础上继续调整，修改后自动标记为自定义</text>
        </view>

        <picker class="setting-picker" mode="selector" range="{{SORT_OPTIONS}}" range-key="label" value="{{sortByIndex}}" bindtap="onPickerOpen" bindchange="onSortChange" bindcancel="onPickerCancel">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-label">排序方式</text>
              <text class="setting-caption">决定题目在试卷中的先后顺序</text>
            </view>
            <view class="setting-value">
              <text>{{sortByLabel}}</text>
              <view class="row-chevron"></view>
            </view>
          </view>
        </picker>

        <view class="setting-divider"></view>

        <picker class="setting-picker" mode="selector" range="{{GROUP_OPTIONS}}" range-key="label" value="{{groupByIndex}}" bindtap="onPickerOpen" bindchange="onGroupChange" bindcancel="onPickerCancel">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-label">分组方式</text>
              <text class="setting-caption">控制不同题目之间的分区结构</text>
            </view>
            <view class="setting-value">
              <text>{{groupByLabel}}</text>
              <view class="row-chevron"></view>
            </view>
          </view>
        </picker>

        <view class="setting-divider"></view>

        <picker class="setting-picker" mode="selector" range="{{POSITION_OPTIONS}}" range-key="label" value="{{answerPositionIndex}}" bindtap="onPickerOpen" bindchange="onAnswerPositionChange" bindcancel="onPickerCancel">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-label">答案</text>
              <text class="setting-caption">选择答案是否打印及其位置</text>
            </view>
            <view class="setting-value">
              <text>{{answerPositionLabel}}</text>
              <view class="row-chevron"></view>
            </view>
          </view>
        </picker>

        <view class="setting-divider"></view>

        <picker class="setting-picker" mode="selector" range="{{POSITION_OPTIONS}}" range-key="label" value="{{analysisPositionIndex}}" bindtap="onPickerOpen" bindchange="onAnalysisPositionChange" bindcancel="onPickerCancel">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-label">解析</text>
              <text class="setting-caption">选择解析是否打印及其位置</text>
            </view>
            <view class="setting-value">
              <text>{{analysisPositionLabel}}</text>
              <view class="row-chevron"></view>
            </view>
          </view>
        </picker>

        <view class="setting-divider"></view>

        <picker class="setting-picker" mode="selector" range="{{SPACE_OPTIONS}}" range-key="label" value="{{spaceStyleIndex}}" bindtap="onPickerOpen" bindchange="onSpaceChange" bindcancel="onPickerCancel">
          <view class="setting-row">
            <view class="setting-copy">
              <text class="setting-label">答题空间</text>
              <text class="setting-caption">控制每道题下方预留的书写空间</text>
            </view>
            <view class="setting-value">
              <text>{{spaceStyleLabel}}</text>
              <view class="row-chevron"></view>
            </view>
          </view>
        </picker>
      </view>

      <view wx:if="{{submitError}}" class="submit-error-panel">
        <view class="submit-error-icon">!</view>
        <text>{{submitError}}</text>
      </view>

      <view class="config-safe-space"></view>
    </view>
  </scroll-view>

  <!-- Floating primary action -->
  <view
    class="floating-submit-wrap {{floatingVisible ? 'floating-submit-wrap-visible' : 'floating-submit-wrap-hidden'}}"
    bindtouchstart="onPageInteraction"
  >
    <view wx:if="{{capabilityError}}" class="floating-submit-hint floating-submit-hint-error">
      <text>{{capabilityError}}</text>
      <button class="floating-retry" bindtap="onRetryCapability">重试检查</button>
    </view>
    <view wx:elif="{{countError}}" class="floating-submit-hint floating-submit-hint-error">
      <text>{{previewCountReady ? '题目数量刷新失败，已保留当前数量' : countError}}</text>
      <button class="floating-retry" bindtap="onRetryPreviewCount">重新计算</button>
    </view>
    <view wx:elif="{{previewCountReady && previewCount > maxQuestionCount}}" class="floating-submit-hint floating-submit-hint-error">
      <text>单次最多导出 {{maxQuestionCount}} 道，请调整范围</text>
    </view>

    <button
      class="floating-submit-btn {{submitting || capabilityLoading || countLoading ? 'floating-submit-btn-busy' : ''}} {{!previewCountReady || previewCount === 0 || previewCount > maxQuestionCount ? 'floating-submit-btn-disabled' : 'floating-submit-btn-actionable'}}"
      hover-class="floating-submit-btn-pressed"
      disabled="{{submitting || capabilityLoading || countLoading || !previewCountReady || previewCount <= 0 || previewCount > maxQuestionCount}}"
      bindtap="onSubmit"
    >
      <text wx:if="{{submitting}}">正在创建导出…</text>
      <text wx:elif="{{capabilityLoading}}">正在检查导出能力…</text>
      <text wx:elif="{{countLoading}}">正在计算题目数量…</text>
      <text wx:elif="{{!previewCountReady}}">等待题目数量</text>
      <text wx:elif="{{previewCount > maxQuestionCount}}">最多 {{maxQuestionCount}} 道</text>
      <text wx:elif="{{previewCount === 0}}">暂无可导出题目</text>
      <text wx:else>生成 {{format === 'docx' ? 'Word' : 'PDF'}} · {{previewCount}} 道</text>
      <view
        wx:if="{{!submitting && !capabilityLoading && !countLoading && previewCountReady && previewCount > 0 && previewCount <= maxQuestionCount}}"
        class="floating-submit-arrow"
        aria-hidden="true"
      >
        <view class="floating-submit-arrow-line"></view>
      </view>
    </button>
  </view>
</view>
