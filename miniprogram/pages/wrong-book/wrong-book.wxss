@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

/* 统计面板 */
.stats-panel {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.mini-stat {
  min-width: 0;
  min-height: 126rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F7F6F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mini-stat.primary { background: #EDF1F5; }
.mini-stat.warning { background: #F5F1EB; }
.mini-stat.success { background: #EFF5EF; }

.mini-stat:active { opacity: 0.82; }

.mini-num {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-stat.warning .mini-num { color: #C49A6B; }
.mini-stat.success .mini-num { color: #6B9B6B; }

.mini-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

/* 标签栏卡片 */
.tab-card {
  margin: 18rpx 24rpx 0;
  padding: 22rpx 26rpx 18rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.tab-bar {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: #F3F2EF;
  border-radius: 999rpx;
}

.tab-item {
  flex: 1;
  min-height: 64rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
  color: #6B7B8D;
  transition: background 0.2s, color 0.2s;
}

.tab-item:active { opacity: 0.85; }

.tab-active {
  background: #5B7B9A;
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(91, 123, 154, 0.25);
}

.tab-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
  text-align: center;
}

/* 加载态 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* 空态 */
.empty-state {
  margin: 18rpx 24rpx 0;
  padding: 56rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 48rpx;
  line-height: 96rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #2D3E50;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9AABBA;
}

/* 错题卡片（全部 / 已掌握） */
.wrong-list {
  margin-top: 18rpx;
}

.wrong-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx 0;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.wrong-card:active { opacity: 0.82; }

.wrong-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.subject-tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
  background: #EDF1F5;
  color: #5B7B9A;
}

.error-tag,
.tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
  background: #F5F1EB;
  color: #C49A6B;
}

.tag-success {
  background: #EFF5EF;
  color: #6B9B6B;
}

.wrong-question {
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.58;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.wrong-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF1F5;
  font-size: 23rpx;
  line-height: 1.35;
  color: #9AABBA;
}

/* 复习卡片（今日待复习） */
.review-list {
  margin-top: 18rpx;
}

.review-card {
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border: 1rpx solid #EDF1F5;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
}

.review-card:active { opacity: 0.82; }

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.review-count {
  font-size: 22rpx;
  color: #9AABBA;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-question {
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.58;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meta-item {
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
  background: #F7F6F2;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
}

.review-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.review-button {
  min-width: 176rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
  border: none;
}

.review-button::after { border: none; }
.review-button:active { opacity: 0.82; }

/* 加载更多 */
.load-more {
  margin: 22rpx 24rpx 0;
  min-height: 82rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  text-align: center;
  line-height: 82rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.load-more:active { opacity: 0.82; }
