@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 88% 3%, rgba(79, 127, 255, 0.07), transparent 220rpx),
    radial-gradient(circle at 6% 22%, rgba(110, 193, 255, 0.05), transparent 200rpx),
    linear-gradient(180deg, #F8FAFF 0%, #F2F6FC 100%);
  background-color: #F2F6FC;
  padding: 28rpx 0 56rpx;
  animation: none;
}

/* ── Animations ── */
.page-header { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) both; }
.overview-card { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .04s both; }
.suggestion-card { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .08s both; }
.stat-band { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .10s both; }
.filter-panel { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .10s both; }
.section-zone { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .14s both; }
.analysis-card { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .18s both; }
.ai-card { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .22s both; }
.wrong-list-shell { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .24s both; }
.empty-state { animation: card-enter .42s cubic-bezier(.2,.8,.2,1) .18s both; }

/* ════════════════════════════════════════════
   Header
   ════════════════════════════════════════════ */
.page-header {
  margin: 0 24rpx 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}
.header-left { flex: 1; min-width: 0; }
.header-title-row {
  display: flex; align-items: center; gap: 10rpx;
}
.header-dot-line {
  display: flex; align-items: center; gap: 6rpx; flex-shrink: 0;
}
.header-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: linear-gradient(135deg, #4F7FFF, #6EC1FF);
}
.header-line {
  width: 28rpx; height: 3rpx; border-radius: 2rpx;
  background: linear-gradient(90deg, #4F7FFF, rgba(79,127,255,.3));
}
.header-title {
  display: block; font-size: 38rpx; font-weight: 800;
  color: #18233A; line-height: 1.25;
}
.header-desc {
  display: block; margin-top: 4rpx; font-size: 22rpx;
  color: #8391A8; line-height: 1.4;
}
.header-actions { flex-shrink: 0; }

.icon-btn {
  height: 64rpx; padding: 0 18rpx; border-radius: 18rpx;
  background: #FFFFFF; border: 1rpx solid #E2EAF7;
  display: flex; align-items: center; justify-content: center;
  transition: transform .15s, background .2s;
}
.icon-btn:active { transform: scale(.97); background: #F3F7FF; }
.icon-btn-active { background: #EDF3FF; border-color: #AFC5FF; }
.icon-btn-text { font-size: 23rpx; font-weight: 700; color: #44536A; line-height: 1.35; }
.icon-btn-active .icon-btn-text { color: #3157D5; }

/* ════════════════════════════════════════════
   Asymmetric overview card
   ════════════════════════════════════════════ */
.overview-card {
  margin: 0 24rpx 14rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, rgba(79,127,255,.07) 0%, rgba(79,127,255,0) 55%), #FFFFFF;
  border: 1rpx solid rgba(218,228,243,.9);
  box-shadow: 0 8rpx 24rpx rgba(42,84,160,.06);
  display: flex;
  align-items: center;
  gap: 16rpx;
  overflow: hidden;
}
.overview-main {
  flex: 0 0 56%;
  min-width: 0;
}
.overview-main-label {
  display: block; font-size: 20rpx; font-weight: 800;
  color: #74839A; line-height: 1.35; margin-bottom: 4rpx;
}
.overview-main-num {
  display: flex; align-items: baseline; gap: 8rpx;
}
.overview-number {
  font-size: 72rpx; font-weight: 900; color: #3157D5;
  line-height: 1; font-variant-numeric: tabular-nums; letter-spacing: -2rpx;
}
.overview-unit { font-size: 20rpx; font-weight: 800; color: #74839A; }
.overview-divider {
  width: 2rpx; height: 72rpx; background: #EDF1F7; flex-shrink: 0;
}
.overview-aux {
  flex: 1;
  display: flex; flex-direction: column; gap: 8rpx;
  align-items: center;
}
.overview-aux-item {
  display: flex; flex-direction: column; align-items: center;
}
.overview-aux-value {
  font-size: 32rpx; font-weight: 900; color: #18233A;
  line-height: 1.1; font-variant-numeric: tabular-nums;
}
.overview-aux-value.primary { color: #3157D5; }
.overview-aux-unit { font-size: 16rpx; color: #74839A; font-weight: 700; }
.overview-aux-label { font-size: 18rpx; color: #74839A; margin-top: 2rpx; }
.overview-aux-sep {
  width: 24rpx; height: 2rpx; border-radius: 1rpx;
  background: #DCE3F0; flex-shrink: 0;
}

/* ════════════════════════════════════════════
   Simplified suggestion card
   ════════════════════════════════════════════ */
.suggestion-card {
  margin: 0 24rpx 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F2F6FF;
  border: 1rpx solid #E2EAF7;
}
.suggestion-card.empty { background: #F8FAFC; }
.suggestion-tag {
  display: inline-block;
  font-size: 19rpx; font-weight: 800; color: #3157D5; line-height: 1.35;
  padding: 4rpx 14rpx; border-radius: 999rpx;
  background: rgba(79,127,255,.12);
  margin-bottom: 10rpx;
}
.suggestion-tag.muted { color: #8391A8; background: rgba(203,213,225,.4); }
.suggestion-title {
  display: block;
  font-size: 28rpx; font-weight: 800; color: #172554; line-height: 1.35;
  margin-bottom: 4rpx;
}
.suggestion-title.muted { color: #617089; }
.suggestion-meta {
  display: block;
  font-size: 21rpx; color: #617089; line-height: 1.45;
}
.suggestion-meta.muted { color: #8391A8; }

/* ════════════════════════════════════════════
   Open stat band
   ════════════════════════════════════════════ */
.stat-band {
  margin: 0 24rpx 14rpx;
  padding: 14rpx 8rpx;
  display: flex;
  align-items: center;
}
.stat-band-item {
  flex: 1; text-align: center; min-width: 0;
}
.stat-band-item + .stat-band-item {
  border-left: 1rpx solid #E2EAF7;
}
.stat-band-dot {
  width: 6rpx; height: 6rpx; border-radius: 50%;
  margin: 0 auto 6rpx;
}
.stat-band-dot.tone-danger { background: #EF4444; }
.stat-band-dot.tone-blue { background: #4F7FFF; }
.stat-band-dot.tone-success { background: #22C55E; }
.stat-band-dot.tone-gold { background: #F59E0B; }
.stat-band-value {
  display: block; font-size: 26rpx; font-weight: 800;
  color: #18233A; line-height: 1.2; font-variant-numeric: tabular-nums;
}
.stat-band-label {
  display: block; margin-top: 2rpx; font-size: 18rpx;
  color: #8391A8; line-height: 1.3;
}

/* ════════════════════════════════════════════
   Filter panel
   ════════════════════════════════════════════ */
.filter-panel {
  margin: 0 24rpx 14rpx;
  padding: 0 24rpx;
  max-height: 0; overflow: hidden;
  background: rgba(255,255,255,.92);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255,255,255,.8);
  transition: max-height .25s cubic-bezier(.22,1,.36,1), padding .25s ease;
}
.filter-open { max-height: 430rpx; padding: 22rpx 24rpx; }
.filter-section + .filter-section { margin-top: 18rpx; }
.filter-section-title {
  display: block; font-size: 21rpx; font-weight: 800;
  color: #7B8AA8; margin-bottom: 10rpx; line-height: 1.35;
}
.filter-chips, .weakness-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.chip {
  padding: 8rpx 20rpx; border-radius: 999rpx; font-size: 23rpx;
  font-weight: 700; line-height: 1.4; color: #5F6F90; background: #F1F6FF;
}
.chip:active { opacity: .82; }
.chip-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #4F7FFF, #6EC1FF);
  box-shadow: 0 8rpx 20rpx rgba(79,127,255,.22);
}

.topic-filter-bar {
  margin: 0 24rpx 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #EEF4FF;
  display: flex; align-items: center; justify-content: space-between; gap: 10rpx;
}
.topic-filter-label {
  font-size: 23rpx; font-weight: 700; color: #4F7FFF;
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.topic-filter-clear {
  flex-shrink: 0; font-size: 21rpx; color: #8EA0BA; font-weight: 700;
  padding: 6rpx 14rpx; border-radius: 999rpx; background: #FFFFFF;
}
.topic-filter-clear:active { opacity: .7; }

/* ════════════════════════════════════════════
   浅蓝分区: 薄弱点 + 复习轨迹
   ════════════════════════════════════════════ */
.section-zone {
  margin: 0 24rpx 18rpx;
  padding: 24rpx 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(238,244,253,.72);
}

.zone-head {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 16rpx;
}
.zone-head-icon {
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: linear-gradient(135deg, rgba(79,127,255,.16), rgba(110,193,255,.08));
  display: flex; align-items: center; justify-content: center;
}
.zone-head-icon .line-icon { width: 18rpx; height: 18rpx; color: #4F7FFF; }
.zone-head-title {
  font-size: 24rpx; font-weight: 800; color: #18233A; line-height: 1.3;
}
.zone-head-count {
  margin-left: auto; font-size: 20rpx; font-weight: 700; color: #8391A8;
}
.zone-pending { font-size: 22rpx; color: #8391A8; line-height: 1.5; }

.weakness-list {
  display: flex; flex-direction: column; gap: 10rpx;
  margin-bottom: 24rpx;
}
.weakness-row {
  display: flex; align-items: center; gap: 10rpx; padding: 6rpx 0;
}
.weakness-row.top { padding-bottom: 10rpx; }
.weakness-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%; flex-shrink: 0;
}
.weakness-dot.danger { background: #EF4444; }
.weakness-dot.blue { background: #4F7FFF; }
.weakness-row-label {
  flex: 1; font-size: 24rpx; font-weight: 700; color: #172554;
  line-height: 1.35; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.weakness-row-count {
  flex-shrink: 0; font-size: 21rpx; font-weight: 700; color: #617089;
}

/* ── Trajectory ── */
.trajectory {
  position: relative;
  padding-left: 8rpx;
}
.trajectory-line {
  position: absolute;
  left: 21rpx; top: 10rpx; bottom: 10rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #4F7FFF, rgba(79,127,255,.15));
}
.trajectory-step {
  position: relative;
  display: flex; gap: 14rpx; align-items: flex-start;
  padding: 8rpx 0;
}
.trajectory-dot {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 900;
  background: rgba(79,127,255,.1); color: #4F7FFF;
  position: relative; z-index: 1;
}
.trajectory-dot.active {
  background: #4F7FFF; color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(79,127,255,.3);
}
.trajectory-body {
  flex: 1; min-width: 0; padding-top: 8rpx;
}
.trajectory-title {
  display: block; font-size: 24rpx; font-weight: 800; color: #18233A; line-height: 1.35;
}
.trajectory-desc {
  display: block; margin-top: 3rpx; font-size: 21rpx; color: #617089; line-height: 1.45;
}

/* ════════════════════════════════════════════
   Analysis card — 能力雷达 + 学科
   ════════════════════════════════════════════ */
.analysis-card {
  margin: 0 24rpx 18rpx;
  padding: 24rpx;
  background: rgba(255,255,255,.94);
  border-radius: 28rpx;
  border: 1rpx solid rgba(226,234,247,.92);
}
.map-grid {
  display: flex; gap: 16rpx;
}
.map-block {
  flex: 1; min-width: 0;
  padding: 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F8FBFF, #F1F6FF);
}
.radar-block { flex: 1.3; }
.map-title {
  display: block; margin-bottom: 14rpx;
  color: #172554; font-size: 23rpx; font-weight: 900; line-height: 1.35;
}
.radar-panel { display: flex; gap: 14rpx; align-items: center; }
.radar-chart {
  position: relative; width: 160rpx; height: 160rpx; flex-shrink: 0;
}
.radar-ring, .radar-cross, .radar-shape, .radar-axis { position: absolute; }
.radar-ring {
  left: 50%; top: 50%;
  border: 1rpx solid rgba(79,127,255,.2);
  transform: translate(-50%,-50%) rotate(45deg);
}
.radar-ring-one { width: 120rpx; height: 120rpx; }
.radar-ring-two { width: 74rpx; height: 74rpx; }
.radar-cross { background: rgba(79,127,255,.12); }
.radar-cross-x { left: 18rpx; right: 18rpx; top: 50%; height: 1rpx; }
.radar-cross-y { top: 18rpx; bottom: 18rpx; left: 50%; width: 1rpx; }
.radar-shape {
  left: 18rpx; top: 18rpx; right: 18rpx; bottom: 18rpx;
  background: linear-gradient(135deg, rgba(79,127,255,.78), rgba(110,193,255,.58));
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.28), 0 10rpx 24rpx rgba(79,127,255,.16);
}
.radar-axis {
  max-width: 72rpx; color: #5F6F90; font-size: 17rpx;
  line-height: 1.2; font-weight: 800; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap;
}
.radar-axis-top { left: 50%; top: 0; transform: translateX(-50%); }
.radar-axis-right { right: 0; top: 50%; transform: translateY(-50%); text-align: right; }
.radar-axis-bottom { left: 50%; bottom: 0; transform: translateX(-50%); }
.radar-axis-left { left: 0; top: 50%; transform: translateY(-50%); }
.radar-legend { flex: 1; min-width: 0; }
.radar-legend-item { display: flex; align-items: center; gap: 6rpx; }
.radar-legend-item + .radar-legend-item { margin-top: 8rpx; }
.legend-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: #4F7FFF; flex-shrink: 0;
}
.legend-label {
  flex: 1; color: #5F6F90; font-size: 18rpx; line-height: 1.3;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.legend-count { color: #3157D5; font-size: 18rpx; font-weight: 900; flex-shrink: 0; }

.subject-map {
  height: 120rpx; display: flex; align-items: flex-end;
  justify-content: space-around; gap: 10rpx;
}
.subject-dot {
  flex: 1; min-width: 30rpx; max-width: 48rpx;
  border-radius: 999rpx 999rpx 12rpx 12rpx;
  background: linear-gradient(180deg, #6EC1FF, #4F7FFF);
  display: flex; justify-content: center; align-items: flex-start;
  padding-top: 6rpx;
}
.subject-count { color: #FFFFFF; font-size: 18rpx; font-weight: 900; }
.subject-labels {
  margin-top: 10rpx; display: flex; justify-content: space-around; gap: 6rpx;
}
.subject-label {
  flex: 1; color: #7B8AA8; font-size: 17rpx;
  text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.mini-pending { font-size: 22rpx; color: #91A0BA; }

/* ════════════════════════════════════════════
   AI 诊断 card
   ════════════════════════════════════════════ */
.ai-card {
  margin: 0 24rpx 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #F6F9FF, #EEF4FF);
  border: 1rpx solid rgba(79,127,255,.12);
}
.ai-head-tag { font-size: 20rpx; font-weight: 800; color: #3157D5; }
.ai-head-badge {
  padding: 3rpx 10rpx; border-radius: 999rpx;
  background: #4F7FFF; color: #FFFFFF; font-size: 17rpx; font-weight: 800;
}
.ai-head-badge.local { background: #E2EAF7; color: #4F7FFF; }
.ai-summary {
  display: block; font-size: 23rpx; color: #617089;
  line-height: 1.55; margin-bottom: 16rpx;
}
.ai-columns { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.ai-col { flex: 1; min-width: 0; }
.ai-col-title {
  display: block; font-size: 20rpx; font-weight: 900;
  margin-bottom: 8rpx; padding-bottom: 6rpx;
  border-bottom: 2rpx solid rgba(79,127,255,.08);
}
.ai-col-title.weak { color: #EF4444; }
.ai-col-title.strong { color: #22C55E; }
.ai-item {
  padding: 10rpx 12rpx; margin-bottom: 6rpx;
  border-radius: 14rpx; background: #FFFFFF; border: 1rpx solid #E2EAF7;
}
.ai-item-kp {
  display: block; font-size: 22rpx; font-weight: 700; color: #18233A; margin-bottom: 3rpx;
}
.ai-item-acc {
  display: inline-block; padding: 2rpx 8rpx; border-radius: 999rpx;
  background: #FEF2F2; color: #EF4444; font-size: 18rpx; font-weight: 800; margin-bottom: 3rpx;
}
.ai-item-acc.good { background: #ECFDF3; color: #22C55E; }
.ai-item-tip {
  display: block; font-size: 20rpx; color: #617089; line-height: 1.45;
}
.ai-suggestions { padding-top: 14rpx; border-top: 1rpx solid rgba(79,127,255,.08); }
.ai-sug-title {
  display: block; font-size: 20rpx; font-weight: 900; color: #4F7FFF; margin-bottom: 8rpx;
}
.ai-sug-item {
  display: block; font-size: 21rpx; color: #18233A; line-height: 1.55; padding: 4rpx 0;
}

/* ── AI 诊断骨架屏 ── */
.ai-skeleton-card {
  margin: 0 24rpx 18rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #F6F9FF, #EEF4FF);
  border: 1rpx solid rgba(79,127,255,.12);
}
.ais-head { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.ais-badge {
  width: 80rpx; height: 28rpx; border-radius: 999rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
.ais-label {
  width: 50rpx; height: 24rpx; border-radius: 999rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
.ais-summary { margin-bottom: 18rpx; }
.ais-line {
  height: 20rpx; border-radius: 999rpx; margin-top: 12rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
.ais-line.long { width: 88%; }
.ais-line.medium { width: 66%; }
.ais-line.short { width: 44%; }
.ais-columns { display: flex; gap: 14rpx; margin-bottom: 18rpx; }
.ais-col { flex: 1; min-width: 0; }
.ais-col-title {
  width: 100rpx; height: 24rpx; border-radius: 999rpx; margin-bottom: 12rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
.ais-item {
  padding: 16rpx; border-radius: 14rpx; background: rgba(255,255,255,.7);
  margin-bottom: 8rpx; border: 1rpx solid rgba(226,234,247,.6);
}
.ais-item-line {
  height: 18rpx; border-radius: 999rpx; margin-top: 8rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
.ais-item-line.long { width: 82%; }
.ais-item-line.medium { width: 60%; }
.ais-item-line.short { width: 38%; }
.ais-suggestions { padding-top: 14rpx; border-top: 1rpx solid rgba(79,127,255,.08); }
.ais-sug-title {
  width: 100rpx; height: 22rpx; border-radius: 999rpx; margin-bottom: 10rpx;
  background: linear-gradient(90deg, #E2ECFF 25%, #F6F9FF 50%, #E2ECFF 75%);
  background-size: 200% 100%;
  animation: aisShimmer 1.6s ease-in-out infinite;
}
@keyframes aisShimmer {
  0% { opacity: .5; }
  50% { opacity: 1; }
  100% { opacity: .5; }
}
@media (prefers-reduced-motion: reduce) {
  .ais-badge, .ais-label, .ais-line, .ais-col-title, .ais-item-line, .ais-sug-title {
    animation: none !important;
    background: #E2ECFF !important;
  }
}

/* AI 卡片刷新态 — 轻量提示 */
.ai-card.is-refreshing {
  opacity: .82;
  transition: opacity .25s;
}
.ai-card.is-stale {
  border-color: rgba(245, 158, 11, 0.2);
}
.ai-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(79,127,255,.08);
}
.ai-disclaimer {
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  line-height: 1.4;
  flex: 1;
}
.ai-feedback-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #4F7FFF;
  background: rgba(79,127,255,.08);
}

/* AI 头部操作区 */
.ai-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.ai-head-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}
.ai-head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.ai-cache-time {
  font-size: 18rpx;
  color: #8EA0BA;
  font-weight: 600;
  line-height: 1.3;
  white-space: nowrap;
}
.ai-refresh-action {
  font-size: 20rpx;
  color: #4F7FFF;
  font-weight: 700;
  line-height: 1.3;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(79,127,255,.1);
  white-space: nowrap;
}
.ai-refresh-action:active {
  opacity: .7;
}
.ai-refresh-action.disabled {
  opacity: .45;
  pointer-events: none;
}

/* AI 错误态（无缓存时加载失败） */
.ai-error-state {
  margin: 0 24rpx 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FDF6F6;
  border: 1rpx solid rgba(239,68,68,.1);
}
.ai-error-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.ai-error-text {
  font-size: 23rpx;
  color: #64748B;
  font-weight: 600;
  line-height: 1.4;
}
.ai-error-action {
  font-size: 22rpx;
  color: #EF4444;
  font-weight: 700;
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(239,68,68,.08);
}
.ai-error-action:active {
  opacity: .72;
}

/* ════════════════════════════════════════════
   Loading / Empty
   ════════════════════════════════════════════ */
.loading-wrap {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; padding: 120rpx 0;
}
.empty-state {
  margin: 18rpx 24rpx 0; padding: 80rpx 30rpx;
  background: #FFFFFF; border-radius: 28rpx;
  border: 1rpx solid rgba(226,234,247,.92);
  display: flex; flex-direction: column; align-items: center; text-align: center;
}
.empty-icon {
  width: 96rpx; height: 96rpx; border-radius: 999rpx;
  background: #EAF8F0; display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
}
.empty-title { font-size: 30rpx; font-weight: 900; color: #172554; line-height: 1.35; }
.empty-desc { margin-top: 8rpx; font-size: 23rpx; color: #7B8AA8; line-height: 1.5; }

/* ════════════════════════════════════════════
   Wrong question list — unified shell
   ════════════════════════════════════════════ */
.wrong-list-shell { margin-top: 6rpx; }

.wl-header {
  margin: 0 28rpx 12rpx;
  display: flex; align-items: baseline; gap: 10rpx;
}
.wl-header-text {
  color: #8391A8; font-size: 22rpx; font-weight: 700;
}
.wl-header-hint {
  color: #B7C4DA; font-size: 20rpx; font-weight: 600;
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.wl-header-count {
  color: #3157D5; font-size: 21rpx; font-weight: 700; flex-shrink: 0;
}

.wl-item {
  margin: 0 24rpx;
  padding: 20rpx 0 20rpx 24rpx;
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  transition: background .15s;
  border-radius: 18rpx;
  position: relative;
}
.wl-item:active { background: rgba(238,244,255,.7); }

.wl-status-line {
  width: 5rpx;
  height: auto;
  border-radius: 3rpx;
  flex-shrink: 0;
  align-self: stretch;
}

.wl-body { flex: 1; min-width: 0; }

.wl-top {
  display: flex; align-items: center; justify-content: space-between; gap: 10rpx;
  margin-bottom: 10rpx;
}
.wl-tags { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; min-width: 0; }
.wl-subject-tag, .wl-error-tag {
  display: inline-block; padding: 4rpx 12rpx; border-radius: 999rpx;
  font-size: 19rpx; line-height: 1.4; font-weight: 800;
}
.wl-subject-tag { background: #EEF5FF; color: #3157D5; }
.wl-error-tag.type-concept_mistake { background: #FFF7ED; color: #D97706; }
.wl-error-tag.type-calculation { background: #FEF2F2; color: #EF4444; }
.wl-error-tag.type-careless { background: #F1F5FF; color: #4F7FFF; }
.wl-error-tag.type-method { background: #EAF8F0; color: #16A34A; }
.wl-error-tag.type-other { background: #F1F5F9; color: #64748B; }

.wl-meta-right { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; }
.wl-time { font-size: 20rpx; color: #91A0BA; }
.wl-arrow { width: 18rpx; height: 18rpx; color: #C8D4E8; }

.wl-stem { line-height: 0; }
.wl-stem-text {
  display: block; font-size: 27rpx; color: #18233A;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  word-break: break-word; white-space: pre-wrap;
}

.wl-meta {
  display: flex; align-items: center; justify-content: space-between; gap: 12rpx;
  margin-top: 12rpx;
}
.wl-meta-left { display: flex; align-items: center; gap: 8rpx; }
.wl-meta-stat { font-size: 20rpx; color: #8391A8; }
.wl-meta-num { font-weight: 800; color: #18233A; }
.wl-meta-sep { font-size: 18rpx; color: #D6DFEE; }

.wl-mastery { display: flex; align-items: center; gap: 6rpx; flex-shrink: 0; }
.wl-mastery-label { font-size: 19rpx; font-weight: 700; }
.wl-mastery-pct { font-size: 21rpx; font-weight: 900; }
.wl-mastery.low .wl-mastery-label { color: #EF4444; }
.wl-mastery.low .wl-mastery-pct { color: #EF4444; }
.wl-mastery.mid .wl-mastery-label { color: #4F7FFF; }
.wl-mastery.mid .wl-mastery-pct { color: #4F7FFF; }
.wl-mastery.high .wl-mastery-label { color: #22C55E; }
.wl-mastery.high .wl-mastery-pct { color: #22C55E; }

.wl-bar-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: #E8EEF8;
  overflow: hidden;
  margin-top: 12rpx;
}
.wl-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width .3s ease;
}

.wl-sep {
  position: absolute;
  left: 24rpx; right: 0; bottom: 0;
  height: 1rpx;
  background: #E8EEF5;
}

/* ── Load more ── */
.wl-load-more {
  margin: 8rpx 24rpx 0;
  height: 64rpx;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  background: transparent;
  color: #3157D5;
  font-size: 23rpx; font-weight: 700;
}
.wl-load-more:active { opacity: .72; }
.wl-load-more-text { color: #3157D5; }
.wl-load-more-icon { width: 20rpx; height: 20rpx; color: #7BA3FF; }

/* ── Accessibility ── */
.sr-summary {
  position: absolute; width: 1rpx; height: 1rpx;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; opacity: 0;
}

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .filter-panel, .loading-spinner, .wrong-card {
    animation: none !important; transition: none !important;
    transform: none !important; opacity: 1 !important;
  }
}
