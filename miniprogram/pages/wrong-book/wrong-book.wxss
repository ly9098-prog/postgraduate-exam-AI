/* wrong-book — 错题本专属样式 */
@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

.wrong-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #F5F1EB 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.wrong-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #C49A6B;
  opacity: 0.4;
}

.wrong-hero::after {
  content: '';
  position: absolute;
  right: -54rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #F5F1EB;
  font-size: 21rpx;
  line-height: 1.35;
  color: #C49A6B;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.hero-badge {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
  border: 10rpx solid #F5F1EB;
}

.hero-badge-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #C49A6B;
  font-variant-numeric: tabular-nums;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6B7B8D;
}

.stats-panel,
.filter-card,
.empty-state {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.stats-panel {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.mini-stat {
  min-width: 0;
  min-height: 126rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F7F6F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.mini-stat.primary { background: #EDF1F5; }
.mini-stat.warning { background: #F5F1EB; }
.mini-stat.success { background: #EFF5EF; }

.mini-stat:active,
.chip:active,
.wrong-card:active,
.load-more:active {
  opacity: 0.82;
}

.mini-num {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-stat.warning .mini-num { color: #C49A6B; }
.mini-stat.success .mini-num { color: #6B9B6B; }

.mini-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
}

.chip {
  flex: 1;
  min-height: 68rpx;
  border-radius: 999rpx;
  background: #F7F6F2;
  color: #6B7B8D;
  font-size: 24rpx;
  line-height: 68rpx;
  text-align: center;
  font-weight: 700;
}

.chip-active {
  background: #5B7B9A;
  color: #FFFFFF;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56rpx 30rpx;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 48rpx;
  line-height: 96rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #2D3E50;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9AABBA;
}

.wrong-list {
  margin-top: 18rpx;
}

.wrong-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 16rpx 24rpx 0;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.wrong-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.subject-tag,
.error-tag,
.tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
}

.subject-tag {
  background: #EDF1F5;
  color: #5B7B9A;
}

.error-tag,
.tag {
  background: #F5F1EB;
  color: #C49A6B;
}

.tag-success {
  background: #EFF5EF;
  color: #6B9B6B;
}

.wrong-question {
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.58;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.wrong-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF1F5;
  font-size: 23rpx;
  line-height: 1.35;
  color: #9AABBA;
}

.load-more {
  margin: 22rpx 24rpx 0;
  min-height: 82rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  text-align: center;
  line-height: 82rpx;
  font-size: 27rpx;
  font-weight: 700;
}
