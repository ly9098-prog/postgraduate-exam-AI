@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

/* ── 顶部统计条 ── */
.stats-bar {
  margin: 18rpx 24rpx 0;
  padding: 0 26rpx;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stats-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #EDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stats-icon-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #5B7B9A;
  line-height: 1;
}

.stats-info {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
}

.stats-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #2D3E50;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}

.stats-label {
  font-size: 26rpx;
  color: #6B7B8D;
  line-height: 1.35;
}

.stats-filter-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #F3F2EF;
  height: 56rpx;
  display: flex;
  align-items: center;
}

.stats-filter-btn:active { opacity: 0.82; }

.filter-btn-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #5B7B9A;
  line-height: 1.35;
}

/* ── 筛选面板 ── */
.filter-panel {
  margin: 12rpx 24rpx 0;
  padding: 0 26rpx;
  max-height: 0;
  overflow: hidden;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  transition: max-height 0.25s cubic-bezier(0.22, 1, 0.36, 1), padding 0.25s ease;
}

.filter-open {
  max-height: 400rpx;
  padding: 22rpx 26rpx;
}

.filter-section + .filter-section {
  margin-top: 20rpx;
}

.filter-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #9AABBA;
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #6B7B8D;
  background: #F3F2EF;
}

.chip:active { opacity: 0.82; }

.chip-active {
  color: #FFFFFF;
  background: #5B7B9A;
}

/* ── 加载态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* ── 空态 ── */
.empty-state {
  margin: 18rpx 24rpx 0;
  padding: 80rpx 30rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.empty-icon-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #6B9B6B;
  line-height: 1;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2D3E50;
  line-height: 1.35;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9AABBA;
  line-height: 1.5;
}

/* ── 错题卡片列表 ── */
.card-list {
  margin-top: 18rpx;
}

.wrong-card {
  margin: 12rpx 24rpx 0;
  padding: 22rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.05);
  border: 1rpx solid rgba(232, 229, 224, 0.5);
  transition: box-shadow 0.2s, transform 0.15s;
}

.wrong-card:active {
  opacity: 0.86;
  transform: scale(0.985);
}

.card-top {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}

.subject-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 700;
  background: #EDF1F5;
  color: #5B7B9A;
}

.error-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 1.4;
  font-weight: 700;
}

.type-concept_mistake { background: #F5F1EB; color: #C49A6B; }
.type-calculation { background: #F5EFEF; color: #C47A7A; }
.type-careless { background: #F0F0F5; color: #7A8AB6; }
.type-method { background: #EFF5EF; color: #6B9B6B; }
.type-other { background: #F3F2EF; color: #6B7B8D; }

.card-body {
  line-height: 0;
}

.card-question {
  display: block;
  font-size: 27rpx;
  color: #2D3E50;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F0EEE9;
}

.card-review-count {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.35;
}

.card-time {
  font-size: 22rpx;
  color: #BCC8D4;
  line-height: 1.35;
}

/* ── 加载更多 ── */
.load-more {
  margin: 22rpx 24rpx 0;
  height: 76rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  text-align: center;
  line-height: 76rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.load-more:active { opacity: 0.82; }
