@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding: 18rpx 0 56rpx;
  animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.hero-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.insight-grid { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.04s both; }
.filter-panel { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s both; }
.analysis-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.12s both; }
.card-list { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.16s both; }
.empty-state { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.12s both; }
.loading-wrap { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.12s both; }

/* ── 顶部 Hero ── */
.hero-card {
  position: relative;
  margin: 0 24rpx;
  min-height: 300rpx;
  padding: 34rpx 32rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 18rpx 44rpx rgba(79, 127, 255, 0.26);
  overflow: hidden;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-glow {
  position: absolute;
  right: -60rpx;
  bottom: -80rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}

.hero-glow::before {
  content: '';
  position: absolute;
  left: -90rpx;
  top: -60rpx;
  width: 130rpx;
  height: 130rpx;
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.14);
  transform: rotate(18deg);
}

.hero-content {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.hero-kicker {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.88);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-title {
  margin-top: 24rpx;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-number-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.hero-number {
  color: #FFFFFF;
  font-size: 92rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -3rpx;
  font-variant-numeric: tabular-nums;
}

.hero-unit {
  margin-left: 10rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 30rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.hero-filter-btn {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-filter-btn:active { opacity: 0.82; }

.filter-btn-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.35;
}

/* ── 诊断概览 ── */
.insight-grid {
  margin: -28rpx 24rpx 0;
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.insight-card {
  min-height: 104rpx;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 234, 247, 0.9);
  box-shadow: 0 10rpx 28rpx rgba(42, 84, 160, 0.1);
}

.insight-value,
.insight-label {
  display: block;
}

.insight-value {
  color: #172554;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.insight-label {
  margin-top: 8rpx;
  color: #7B8AA8;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.tone-danger { background: linear-gradient(180deg, #FFF7ED 0%, #FFFFFF 100%); }
.tone-blue { background: linear-gradient(180deg, #EEF5FF 0%, #FFFFFF 100%); }
.tone-success { background: linear-gradient(180deg, #EAF8F0 0%, #FFFFFF 100%); }
.tone-gold { background: linear-gradient(180deg, #FFFAEB 0%, #FFFFFF 100%); }

/* ── 筛选面板 ── */
.filter-panel {
  margin: 16rpx 24rpx 0;
  padding: 0 26rpx;
  max-height: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(79, 127, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: max-height 0.25s cubic-bezier(0.22, 1, 0.36, 1), padding 0.25s ease;
}

.filter-open {
  max-height: 430rpx;
  padding: 24rpx 26rpx;
}

.filter-section + .filter-section {
  margin-top: 20rpx;
}

.filter-section-title {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #7B8AA8;
  margin-bottom: 12rpx;
  line-height: 1.35;
}

.filter-chips,
.weakness-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  padding: 9rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #5F6F90;
  background: #F1F6FF;
}

.chip:active { opacity: 0.82; }

.chip-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 8rpx 20rpx rgba(79, 127, 255, 0.22);
}

/* ── 知识漏洞分析 ── */
.analysis-card {
  position: relative;
  margin: 18rpx 24rpx 0;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #172554;
  line-height: 1.3;
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #7B8AA8;
  line-height: 1.45;
}

.weakness-tags {
  margin-top: 22rpx;
}

.weakness-tag {
  padding: 11rpx 18rpx;
  border-radius: 999rpx;
  background: #EEF5FF;
  border: 1rpx solid rgba(79, 127, 255, 0.12);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.weakness-label {
  color: #3157D5;
  font-size: 23rpx;
  font-weight: 800;
}

.weakness-count {
  color: #7B8AA8;
  font-size: 21rpx;
  font-weight: 700;
}

.analysis-pending,
.mini-pending {
  color: #91A0BA;
  font-size: 24rpx;
  line-height: 1.5;
}

.analysis-pending { margin-top: 22rpx; }

.action-plan {
  margin-top: 24rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F6FF 100%);
}

.plan-item {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.plan-item + .plan-item {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(79, 127, 255, 0.1);
}

.plan-dot {
  margin-top: 9rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  box-shadow: 0 0 14rpx rgba(79, 127, 255, 0.28);
  flex-shrink: 0;
}

.plan-copy {
  min-width: 0;
}

.plan-title,
.plan-desc {
  display: block;
}

.plan-title {
  color: #172554;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.plan-desc {
  margin-top: 5rpx;
  color: #7B8AA8;
  font-size: 21rpx;
  line-height: 1.45;
}

.focus-diagnosis {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #172554 0%, #3157D5 100%);
  box-shadow: 0 14rpx 32rpx rgba(49, 87, 213, 0.18);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.focus-copy {
  flex: 1;
  min-width: 0;
}

.focus-kicker,
.focus-title,
.focus-desc {
  display: block;
}

.focus-kicker {
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.focus-title {
  margin-top: 8rpx;
  color: #FFFFFF;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 900;
}

.focus-desc {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
  line-height: 1.45;
}

.focus-score {
  width: 78rpx;
  height: 78rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 30rpx;
  line-height: 78rpx;
  text-align: center;
  font-weight: 900;
  flex-shrink: 0;
}

/* ── AI 深度诊断 ── */
.ai-diagnosis-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F6F9FF 0%, #EEF4FF 100%);
  border: 1rpx solid rgba(79, 127, 255, 0.12);
}

.ai-diag-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.ai-diag-kicker {
  font-size: 24rpx;
  font-weight: 900;
  color: #4F7FFF;
}

.ai-diag-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 800;
}

.ai-diag-badge.local {
  background: #E2EAF7;
  color: #4F7FFF;
}

.ai-diag-summary {
  display: block;
  font-size: 24rpx;
  color: #617089;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.ai-diag-columns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.ai-diag-col {
  flex: 1;
  min-width: 0;
}

.ai-diag-col-title {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid rgba(79, 127, 255, 0.08);
}

.ai-diag-col-title.weak { color: #EF4444; }
.ai-diag-col-title.strong { color: #22C55E; }

.ai-diag-item {
  padding: 12rpx 14rpx;
  margin-bottom: 8rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2EAF7;
}

.ai-diag-kp {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #18233A;
  margin-bottom: 4rpx;
}

.ai-diag-acc {
  display: inline-block;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #FEF2F2;
  color: #EF4444;
  font-size: 20rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.ai-diag-acc.good {
  background: #ECFDF3;
  color: #22C55E;
}

.ai-diag-tip {
  display: block;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.ai-diag-suggestions {
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(79, 127, 255, 0.08);
}

.ai-diag-sug-title {
  display: block;
  font-size: 22rpx;
  font-weight: 900;
  color: #4F7FFF;
  margin-bottom: 10rpx;
}

.ai-diag-sug-item {
  display: block;
  font-size: 23rpx;
  color: #18233A;
  line-height: 1.6;
  padding: 6rpx 0;
}

.ai-diagnosis-loading {
  margin-top: 20rpx;
  padding: 40rpx 24rpx;
  border-radius: 24rpx;
  background: #F6F9FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.ai-loading-pulse {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F7FFF, #6EC1FF);
  animation: aiPulse 1.5s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}

.ai-loading-text {
  font-size: 24rpx;
  color: #617089;
}

@media (prefers-reduced-motion: reduce) {
  .ai-loading-pulse {
    animation: none;
    opacity: 0.6;
  }
}

.map-grid {
  margin-top: 24rpx;
  display: flex;
  gap: 18rpx;
}

.map-block {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #F8FBFF 0%, #F1F6FF 100%);
}

.radar-block {
  flex: 1.25;
}

.map-title {
  display: block;
  margin-bottom: 18rpx;
  color: #172554;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.radar-panel {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.radar-chart {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}

.radar-ring,
.radar-cross,
.radar-shape,
.radar-axis {
  position: absolute;
}

.radar-ring {
  left: 50%;
  top: 50%;
  border: 1rpx solid rgba(79, 127, 255, 0.2);
  transform: translate(-50%, -50%) rotate(45deg);
}

.radar-ring-one {
  width: 132rpx;
  height: 132rpx;
}

.radar-ring-two {
  width: 82rpx;
  height: 82rpx;
}

.radar-cross {
  background: rgba(79, 127, 255, 0.12);
}

.radar-cross-x {
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  height: 1rpx;
}

.radar-cross-y {
  top: 18rpx;
  bottom: 18rpx;
  left: 50%;
  width: 1rpx;
}

.radar-shape {
  left: 18rpx;
  top: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.78) 0%, rgba(110, 193, 255, 0.58) 100%);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.28), 0 10rpx 24rpx rgba(79, 127, 255, 0.16);
}

.radar-axis {
  max-width: 78rpx;
  color: #5F6F90;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.radar-axis-top {
  left: 50%;
  top: 0;
  transform: translateX(-50%);
}

.radar-axis-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: right;
}

.radar-axis-bottom {
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
}

.radar-axis-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}

.radar-legend {
  flex: 1;
  min-width: 0;
}

.radar-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.radar-legend-item + .radar-legend-item {
  margin-top: 10rpx;
}

.legend-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  box-shadow: 0 0 12rpx rgba(79, 127, 255, 0.3);
  flex-shrink: 0;
}

.legend-label {
  flex: 1;
  min-width: 0;
  color: #5F6F90;
  font-size: 20rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-count {
  color: #3157D5;
  font-size: 20rpx;
  line-height: 1.3;
  font-weight: 900;
  flex-shrink: 0;
}

.subject-map {
  height: 136rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 12rpx;
}

.subject-dot {
  flex: 1;
  min-width: 34rpx;
  max-width: 54rpx;
  border-radius: 999rpx 999rpx 14rpx 14rpx;
  background: linear-gradient(180deg, #6EC1FF 0%, #4F7FFF 100%);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding-top: 8rpx;
  box-shadow: 0 8rpx 18rpx rgba(79, 127, 255, 0.18);
}

.subject-count {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 900;
}

.subject-labels {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-around;
  gap: 8rpx;
}

.subject-label {
  flex: 1;
  color: #7B8AA8;
  font-size: 19rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 加载态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #DDEAFF;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #7B8AA8;
  margin-top: 16rpx;
}

/* ── 空态 ── */
.empty-state {
  margin: 18rpx 24rpx 0;
  padding: 80rpx 30rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 999rpx;
  background: #EAF8F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.empty-icon-text {
  color: #22C55E;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 900;
  color: #172554;
  line-height: 1.35;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7B8AA8;
  line-height: 1.5;
}

/* ── 错题卡片列表 ── */
.card-list {
  margin-top: 22rpx;
}

.list-title-row {
  margin: 0 28rpx 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.list-title {
  color: #172554;
  font-size: 31rpx;
  font-weight: 900;
}

.list-subtitle {
  color: #91A0BA;
  font-size: 22rpx;
}

.wrong-card {
  margin: 14rpx 24rpx 0;
  padding: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  transition: box-shadow 0.2s, transform 0.15s;
}

.wrong-card:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.subject-tag,
.error-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.4;
  font-weight: 800;
}

.subject-tag {
  background: #EEF5FF;
  color: #3157D5;
}

.type-concept_mistake { background: #FFF7ED; color: #D97706; }
.type-calculation { background: #FEF2F2; color: #EF4444; }
.type-careless { background: #F1F5FF; color: #4F7FFF; }
.type-method { background: #EAF8F0; color: #16A34A; }
.type-other { background: #F1F5F9; color: #64748B; }

.card-arrow {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  color: #B7C4DA;
}

.card-body {
  line-height: 0;
}

.card-question {
  display: block;
  font-size: 28rpx;
  color: #24324F;
  line-height: 1.65;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
  white-space: pre-wrap;
}

.metric-row {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.metric-pill {
  flex: 1;
  min-width: 0;
  padding: 14rpx 10rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.metric-pill.danger { background: #FEF2F2; }
.metric-pill.blue { background: #EEF5FF; }
.metric-pill.soft { background: #F8FAFC; }

.metric-value {
  max-width: 100%;
  color: #172554;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-value.small { font-size: 24rpx; }

.metric-label {
  color: #7B8AA8;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.mastery-block {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF4FF;
}

.mastery-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.mastery-title {
  color: #172554;
  font-size: 24rpx;
  font-weight: 900;
}

.mastery-percent {
  color: #5F6F90;
  font-size: 22rpx;
  font-weight: 700;
}

.mastery-track {
  margin-top: 12rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #DDEAFF;
  overflow: hidden;
}

.mastery-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #22C55E 0%, #6EC1FF 100%);
}

/* ── 加载更多 ── */
.load-more {
  margin: 24rpx 24rpx 0;
  height: 80rpx;
  border-radius: 999rpx;
  background: #E4EEFF;
  color: #3157D5;
  text-align: center;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.load-more:active { opacity: 0.82; }

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .filter-panel,
  .insight-card,
  .loading-spinner,
  .wrong-card,
  .hero-glow::before {
    animation: none !important;
    transition: none !important;
    transform: none !important;
    opacity: 1 !important;
  }
}

/* ── Accessibility ── */
.sr-summary {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  opacity: 0;
}
