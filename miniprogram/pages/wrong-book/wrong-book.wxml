<view class="page">
  <!-- 统计 -->
  <view class="stats-panel">
    <view class="mini-stat primary" bindtap="switchFilter" data-filter="all">
      <text class="mini-num">{{stats.total || 0}}</text>
      <text class="mini-label">全部</text>
    </view>
    <view class="mini-stat warning" bindtap="switchFilter" data-filter="unmastered">
      <text class="mini-num">{{stats.unmastered || 0}}</text>
      <text class="mini-label">待复习</text>
    </view>
    <view class="mini-stat success" bindtap="switchFilter" data-filter="mastered">
      <text class="mini-num">{{stats.mastered || 0}}</text>
      <text class="mini-label">已掌握</text>
    </view>
  </view>

  <!-- 筛选 -->
  <view class="filter-card">
    <view class="section-head">
      <view>
        <text class="section-title">错题列表</text>
        <text class="section-subtitle">按掌握状态筛选，优先处理待复习题目</text>
      </view>
      <text class="section-chip">{{filter === 'all' ? '全部' : filter === 'mastered' ? '已掌握' : '待复习'}}</text>
    </view>
    <view class="filter-bar">
      <view class="chip {{filter==='all' ? 'chip-active' : ''}}" bindtap="switchFilter" data-filter="all">全部</view>
      <view class="chip {{filter==='unmastered' ? 'chip-active' : ''}}" bindtap="switchFilter" data-filter="unmastered">待复习</view>
      <view class="chip {{filter==='mastered' ? 'chip-active' : ''}}" bindtap="switchFilter" data-filter="mastered">已掌握</view>
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{loading && list.length === 0}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载错题...</text>
  </view>

  <view wx:if="{{!loading && list.length === 0}}" class="empty-state">
    <view class="empty-mark">✓</view>
    <text class="empty-title">没有错题，继续保持</text>
    <text class="empty-desc">后续练习中产生的错题会自动沉淀到这里</text>
  </view>

  <view class="wrong-list" wx:if="{{list.length > 0}}">
    <view wx:for="{{list}}" wx:key="id" class="wrong-card" bindtap="goDetail" data-id="{{item.id}}">
      <view class="wrong-header">
        <text class="subject-tag">{{subjectLabel(item.subject)}}</text>
        <text class="error-tag tag {{item.error_type}}">{{errorTypeLabel(item.error_type)}}</text>
        <text wx:if="{{item.mastered}}" class="tag tag-success">已掌握</text>
      </view>
      <block wx:if="{{enableMathImage && item.content && item.content.render_mode === 'segments'}}">
        <math-question segments="{{item.content.segments}}" />
      </block>
      <block wx:else>
        <view class="wrong-question">{{item.content && item.content.text}}</view>
      </block>
      <view class="wrong-meta">
        <text>复习 {{item.review_count}} 次</text>
        <text wx:if="{{!item.mastered}}">待复习</text>
      </view>
    </view>
  </view>

  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>
</view>