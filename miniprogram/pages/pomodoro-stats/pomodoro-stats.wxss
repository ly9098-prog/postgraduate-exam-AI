/* ============================================
   🎯 极夜·专注 — Pomodoro Stats
   Dark immersive theme for focus analytics
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0B1121 0%, #1A1F35 50%, #111827 100%);
}

.page-inner {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.stats-content {
  flex: 1;
  padding-top: 48rpx;
}

/* ── Entrance Animation ── */
.animation-entrance {
  opacity: 0;
}

.animation-entrance.entered {
  animation: page-enter 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes page-enter {
  to {
    opacity: 1;
  }
}

/* ── Loading ── */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.06);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   OVERVIEW SECTION
   ============================================ */
.overview-section {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.ov-row {
  display: flex;
  gap: 2rpx;
}

.ov-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  background: rgba(255, 255, 255, 0.04);
  gap: 8rpx;
}

.ov-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.ov-value {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.1;
}

.ov-accent {
  color: #3B82F6;
}

.ov-green {
  color: #10B981;
}

/* ============================================
   CARD SECTIONS
   ============================================ */
.card-section {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
  margin-bottom: 22rpx;
}

/* ============================================
   TREND CHART
   ============================================ */
.chart-wrap {
  width: 100%;
  height: 280rpx;
}

.trend-canvas {
  width: 100%;
  height: 280rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chart-legend .legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   SUBJECT DISTRIBUTION
   ============================================ */
.subj-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subj-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.subj-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 150rpx;
  flex-shrink: 0;
}

.subj-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.subj-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subj-bar-wrap {
  flex: 1;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 7rpx;
  overflow: hidden;
}

.subj-bar {
  height: 100%;
  border-radius: 7rpx;
  min-width: 4rpx;
  transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.subj-dur {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  width: 90rpx;
  text-align: right;
  flex-shrink: 0;
  font-weight: 500;
}

/* ============================================
   HISTORY
   ============================================ */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.2);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  -webkit-tap-highlight-color: transparent;
}

.history-item:active {
  background: rgba(255, 255, 255, 0.04);
}

.hist-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hist-subject {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.hist-meta {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
}

.hist-right {
  display: flex;
  align-items: center;
}

.hist-status {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.status-done {
  color: rgba(16, 185, 129, 0.6);
  background: rgba(16, 185, 129, 0.08);
}

.status-interrupt {
  color: rgba(244, 63, 94, 0.6);
  background: rgba(244, 63, 94, 0.08);
}

/* ============================================
   PIE CHART
   ============================================ */
.pie-wrap {
  position: relative;
  width: 100%;
  height: 500rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12rpx;
  overflow: visible;
}

.pie-wrap::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 78rpx;
  width: 420rpx;
  height: 110rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.34) 0%, rgba(0, 0, 0, 0.18) 46%, rgba(0, 0, 0, 0) 72%);
  filter: blur(16rpx);
}

.pie-canvas {
  position: relative;
  z-index: 1;
  width: 500rpx;
  height: 500rpx;
}

.subject-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx 20rpx;
  padding: 18rpx 20rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.subject-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 36rpx;
}

.subject-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.08);
}

.subject-legend-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  font-weight: 500;
  line-height: 1.4;
}

/* ── Pie Tap Feedback ── */
.pie-wrap.pie-tapped {
  animation: pie-tap-feedback 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes pie-tap-feedback {
  0% { transform: scale(1); }
  40% { transform: scale(0.96); }
  100% { transform: scale(1); }
}

/* ============================================
   DETAIL POPUP
   ============================================ */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.detail-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.detail-overlay::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(11, 17, 33, 0.85);
  backdrop-filter: blur(12rpx);
}

.detail-card {
  position: relative;
  z-index: 2;
  width: 520rpx;
  padding: 40rpx 36rpx;
  background: linear-gradient(180deg, #1A1F35 0%, #111827 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  animation: popup-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes popup-in {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.detail-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-subject {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.detail-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 400;
}

.detail-value {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
}

.detail-close-wrap {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.detail-close-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 2rpx;
}

/* ── Bottom Spacer ── */
.bottom-spacer {
  height: 40rpx;
}

@media (prefers-reduced-motion: reduce) {
  .page,
  .loading-spinner,
  .detail-modal {
    animation: none !important;
    transition: none !important;
  }
}
