/* ============================================
   🎯 极夜·专注 — Pomodoro Stats
   Dark immersive theme for focus analytics
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0B1121 0%, #1A1F35 50%, #111827 100%);
}

.page-inner {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
}

.stats-content {
  flex: 1;
  padding-top: 48rpx;
}

/* ── Entrance Animation ── */
.animation-entrance {
  opacity: 0;
}

.animation-entrance.entered {
  animation: page-enter 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes page-enter {
  to {
    opacity: 1;
  }
}

/* ── Loading ── */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.06);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   OVERVIEW SECTION
   ============================================ */
.overview-section {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.ov-row {
  display: flex;
  gap: 2rpx;
}

.ov-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 16rpx;
  background: rgba(255, 255, 255, 0.04);
  gap: 8rpx;
}

.ov-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 500;
  letter-spacing: 2rpx;
}

.ov-value {
  font-size: 48rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.1;
}

.ov-accent {
  color: #3B82F6;
}

.ov-green {
  color: #10B981;
}

/* ============================================
   CARD SECTIONS
   ============================================ */
.card-section {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
  margin-bottom: 22rpx;
}

/* ============================================
   TREND CHART
   ============================================ */
.chart-wrap {
  width: 100%;
  height: 280rpx;
}

.trend-canvas {
  width: 100%;
  height: 280rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   SUBJECT DISTRIBUTION
   ============================================ */
.subj-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.subj-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.subj-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 150rpx;
  flex-shrink: 0;
}

.subj-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.subj-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subj-bar-wrap {
  flex: 1;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 7rpx;
  overflow: hidden;
}

.subj-bar {
  height: 100%;
  border-radius: 7rpx;
  min-width: 4rpx;
  transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}

.subj-dur {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
  width: 90rpx;
  text-align: right;
  flex-shrink: 0;
  font-weight: 500;
}

/* ============================================
   HISTORY
   ============================================ */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.2);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.02);
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
}

.history-item:active {
  background: rgba(255, 255, 255, 0.04);
}

.hist-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hist-subject {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.hist-meta {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.25);
}

.hist-right {
  display: flex;
  align-items: center;
}

.hist-status {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.status-done {
  color: rgba(16, 185, 129, 0.6);
  background: rgba(16, 185, 129, 0.08);
}

.status-interrupt {
  color: rgba(244, 63, 94, 0.6);
  background: rgba(244, 63, 94, 0.08);
}

/* ── Bottom Spacer ── */
.bottom-spacer {
  height: 40rpx;
}
