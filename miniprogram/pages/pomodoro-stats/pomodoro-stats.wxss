@import '../../styles/tokens.wxss';

.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #F7F5F0;
}

.loading-wrap {
  padding: 200rpx 0;
  text-align: center;
}

.loading-text {
  font-size: 28rpx;
  color: #9AABBA;
}

/* ── 概览卡片：2×2 网格 ── */
.overview-card {
  padding: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E5E0;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(43, 60, 80, 0.05);
}

.overview-row {
  display: flex;
  flex-wrap: wrap;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 50%;
  padding: 28rpx 16rpx;
  box-sizing: border-box;
}

.overview-divider-v {
  width: 1rpx;
  background: #E8E5E0;
}

.overview-divider-h {
  width: 100%;
  height: 1rpx;
  background: #E8E5E0;
}

.ov-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.ov-num {
  font-size: 44rpx;
  font-weight: 800;
  color: #5B7B9A;
  line-height: 1.2;
}

.ov-num.accent {
  color: #C49A6B;
}

.ov-num.green {
  color: #6B9B6B;
}

.ov-label {
  font-size: 22rpx;
  color: #6B7B8D;
  margin-top: 6rpx;
  font-weight: 500;
}

/* ── 分区卡片 ── */
.section-card {
  padding: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E5E0;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(43, 60, 80, 0.05);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E50;
  display: block;
  margin-bottom: 22rpx;
}

/* ── 趋势图 ── */
.chart-wrap {
  width: 100%;
  height: 320rpx;
}

.trend-canvas {
  width: 100%;
  height: 320rpx;
}

.trend-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 22rpx;
  color: #6B7B8D;
}

/* ── 科目分布 ── */
.subject-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.subject-row:last-child {
  margin-bottom: 0;
}

.subj-label {
  font-size: 24rpx;
  color: #2D3E50;
  width: 150rpx;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 500;
}

.subj-bar-wrap {
  flex: 1;
  height: 16rpx;
  background: #EDF1F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.subj-bar {
  height: 100%;
  border-radius: 8rpx;
  min-width: 8rpx;
}

.subj-dur {
  font-size: 22rpx;
  color: #6B7B8D;
  width: 90rpx;
  text-align: right;
  flex-shrink: 0;
  font-weight: 500;
}

/* ── 记录列表 ── */
.empty-hint {
  text-align: center;
  padding: 60rpx 0;
  font-size: 24rpx;
  color: #9AABBA;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #FAF9F7;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #F3F2EF;
}

.history-item:last-child {
  margin-bottom: 0;
}

.history-item:active {
  background: #F5F3F0;
}

.hist-left {
  display: flex;
  flex-direction: column;
}

.hist-date {
  font-size: 24rpx;
  color: #6B7B8D;
  font-weight: 500;
}

.hist-subject {
  font-size: 22rpx;
  color: #9AABBA;
  margin-top: 4rpx;
}

.hist-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.hist-duration {
  font-size: 28rpx;
  color: #2D3E50;
  font-weight: 700;
}

.hist-status {
  font-size: 20rpx;
  margin-top: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.status-done {
  color: #5A8F5A;
  background: #EFF5EF;
}

.status-interrupt {
  color: #C47A7A;
  background: #F5EFEF;
}
