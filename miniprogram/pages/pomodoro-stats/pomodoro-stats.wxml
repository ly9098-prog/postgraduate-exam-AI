<view class="page">
  <view class="page-inner animation-entrance {{pageEntered ? 'entered' : ''}}">

    <block wx:if="{{loading}}">
      <view class="loading-wrap">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
    </block>

    <block wx:if="{{!loading}}">
      <view class="stats-content">
        <!-- ===== OVERVIEW ===== -->
        <view class="overview-section">
          <view class="ov-row">
            <view class="ov-card">
              <text class="ov-label">今日番茄</text>
              <text class="ov-value">{{todaySessions}}</text>
            </view>
            <view class="ov-card">
              <text class="ov-label">今日专注</text>
              <text class="ov-value ov-accent">{{todayDurationText}}</text>
            </view>
          </view>
          <view class="ov-row">
            <view class="ov-card">
              <text class="ov-label">本周番茄</text>
              <text class="ov-value">{{weekSessions}}</text>
            </view>
            <view class="ov-card">
              <text class="ov-label">本周专注</text>
              <text class="ov-value ov-green">{{weekDurationText}}</text>
            </view>
          </view>
        </view>

        <!-- ===== TREND CHART ===== -->
        <view class="card-section">
          <text class="section-title">最近 7 天趋势</text>
          <view class="chart-wrap">
            <canvas class="trend-canvas" canvas-id="trend-bars-canvas" id="trend-bars-canvas"></canvas>
          </view>
          <view class="chart-legend">
            <view class="legend-item"><view class="legend-dot" style="background: #3B82F6;"></view><text class="legend-text">有记录</text></view>
            <view class="legend-item"><view class="legend-dot" style="background: rgba(255,255,255,0.08);"></view><text class="legend-text">无记录</text></view>
          </view>
        </view>

        <!-- ===== SUBJECTS DISTRIBUTION ===== -->
        <view class="card-section" wx:if="{{subjects.length > 0}}">
          <text class="section-title">今日科目分布</text>
          <view class="subj-list">
            <view class="subj-row" wx:for="{{subjects}}" wx:key="subject">
              <view class="subj-left">
                <text class="subj-dot" style="background: {{item._color}};"></text>
                <text class="subj-name">{{item._label}}</text>
              </view>
              <view class="subj-bar-wrap">
                <view class="subj-bar" style="width: {{item._barPct}}%; background: {{item._color}};"></view>
              </view>
              <text class="subj-dur">{{item._durationText}}</text>
            </view>
          </view>
        </view>

        <!-- ===== HISTORY ===== -->
        <view class="card-section">
          <text class="section-title">最近记录</text>
          <view wx:if="{{history.length === 0}}" class="empty-hint">
            <text>暂无记录，开始你的第一个番茄钟吧</text>
          </view>
          <view class="history-list" wx:if="{{history.length > 0}}">
            <view class="history-item" wx:for="{{history}}" wx:key="id">
              <view class="hist-left">
                <text class="hist-subject">{{item._subjectLabel}}</text>
                <text class="hist-meta">{{item._date}} {{item._time}} · {{item._duration}}</text>
              </view>
              <view class="hist-right">
                <text class="hist-status {{item._statusClass}}">{{item._statusLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- bottom spacer -->
        <view class="bottom-spacer"></view>
      </view>
    </block>
  </view>
</view>
