<view class="page">
  <block wx:if="{{showCelebration}}">
    <view class="celebration-overlay celebration-{{celebrationType}}" catchtap="dismissCelebration">
      <view class="celeb-bg"></view>
      <view class="firework-container">
        <view class="firework f1"></view>
        <view class="firework f2"></view>
        <view class="firework f3"></view>
      </view>
      <view class="celeb-content">
        <view class="celeb-badge-halo"></view>
        <view class="celeb-check-wrap">
          <text class="celeb-check">{{celebrationIcon}}</text>
        </view>
        <text class="celeb-title">{{celebrationTitle}}</text>
        <text class="celeb-detail">{{celebrationDetail}}</text>
        <view class="celeb-reward">
          <text class="reward-spark">★</text>
          <text>{{celebrationRewardText}}</text>
        </view>
        <text class="celeb-motto">{{celebrationMotto}}</text>
        <text class="celeb-tap-hint">点击继续</text>
      </view>
      <view class="particle-container">
        <view class="particle p1"></view>
        <view class="particle p2"></view>
        <view class="particle p3"></view>
        <view class="particle p4"></view>
        <view class="particle p5"></view>
        <view class="particle p6"></view>
        <view class="particle p7"></view>
        <view class="particle p8"></view>
        <view class="particle p9"></view>
        <view class="particle p10"></view>
      </view>
    </view>
  </block>

  <!-- 结果头部 -->
  <view class="result-hero {{passRate >= 60 ? 'pass' : 'fail'}} motion-card-enter">
    <view class="hero-copy">
      <text class="eyebrow">练习结果</text>
      <text class="hero-title">{{passRate >= 60 ? '做得不错' : '继续加油'}}</text>
      <text class="hero-desc">{{passRate >= 60 ? '保持节奏，继续巩固薄弱题型' : '先复盘错题，再开启下一组练习'}}</text>
    </view>
    <view class="score-ring">
      <text class="score-num">{{passRate || 0}}</text>
      <text class="score-percent">%</text>
      <text class="score-label">正确率</text>
    </view>
  </view>

  <!-- 统计数据 -->
  <view class="stats-card motion-card-enter motion-delay-1">
    <view class="section-head">
      <view>
        <text class="section-title">本次概览</text>
        <text class="section-subtitle">先看整体结果，再决定是否复盘错题</text>
      </view>
      <text class="section-chip">{{subjectDisplay}}</text>
    </view>
    <view class="stats-grid">
      <view class="stat-item primary">
        <text class="stat-num">{{total || 0}}</text>
        <text class="stat-label">总题数</text>
      </view>
      <view class="stat-item success">
        <text class="stat-num">{{correct || 0}}</text>
        <text class="stat-label">正确</text>
      </view>
      <view class="stat-item danger">
        <text class="stat-num">{{wrong || 0}}</text>
        <text class="stat-label">错误</text>
      </view>
    </view>
    <view class="duration-row">
      <text class="duration-label">本次用时</text>
      <text class="duration-value">{{durationText}}</text>
    </view>
    <view class="growth-card">
      <view class="growth-orb"></view>
      <view class="growth-copy">
        <text class="growth-kicker">成长结算</text>
        <text class="growth-title">{{growthTitle}}</text>
        <text class="growth-desc">{{growthDesc}}</text>
        <view class="growth-level-bar" wx:if="{{growthLevel}}">
          <view class="growth-level-head">
            <text class="growth-level-label">{{growthLevel}}</text>
            <text class="growth-level-pct">{{growthLevelPct}}%</text>
          </view>
          <view class="growth-level-track">
            <view class="growth-level-fill" style="width:{{growthLevelPct}}%"></view>
          </view>
          <text class="growth-exp-text">{{growthExpText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 逐题结果 -->
  <view class="detail-card motion-card-enter motion-delay-2" wx:if="{{results.length > 0}}">
    <view class="detail-toggle" bindtap="toggleDetail">
      <view>
        <text class="section-title">答题详情</text>
        <text class="section-subtitle">查看每道题的判定结果和正确答案</text>
      </view>
      <text class="toggle-arrow">{{showDetail ? '收起' : '展开'}}</text>
    </view>
    <view class="detail-list" wx:if="{{showDetail}}">
      <view class="detail-item {{item._cls}}" wx:for="{{results}}" wx:key="question_id">
        <text class="detail-num">#{{index + 1}}</text>
        <text class="detail-mark">{{item._label}}</text>
        <text class="detail-answer">答案：{{item.correct_answer}}</text>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="actions motion-card-enter motion-delay-3">
    <button class="btn-primary" bindtap="goWrongBook">查看错题</button>
    <button class="btn-secondary" bindtap="practiceAgain">再来一组</button>
    <button class="btn-text" bindtap="goHome">返回首页</button>
  </view>
</view>