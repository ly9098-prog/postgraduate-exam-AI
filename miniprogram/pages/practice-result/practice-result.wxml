<view class="page">
  <animated-view
    wx:if="{{showCelebration && shouldShowCelebration}}"
    show="{{showCelebration}}"
    type="{{celebrationType}}"
    title="{{celebrationTitle}}"
    detail="{{celebrationDetail}}"
    motto="{{celebrationMotto}}"
    reward-text="{{celebrationRewardText}}"
    duration="{{2600}}"
    gif-src="/assets/animation/celebration.gif"
    png-src="/assets/animation/celebration-static.png"
    bind:done="dismissCelebration"
  />

  <!-- 1. Result Hero -->
  <view class="result-summary {{resultLevelClass}}">
    <view class="summary-main">
      <text class="summary-kicker">{{subjectDisplay}}</text>
      <text class="summary-title">{{resultTitle || (passRate >= 60 ? '做得不错' : '继续加油')}}</text>
      <text class="summary-desc">{{resultDesc || (passRate >= 60 ? '保持节奏，继续巩固薄弱题型' : '先复盘错题，再开启下一组练习')}}</text>
    </view>
    <view class="score-block">
      <text class="score-value">{{passRate || 0}}</text>
      <text class="score-unit">%</text>
      <text class="score-label">正确率</text>
    </view>
  </view>

  <!-- 2. Core Stats -->
  <view class="card metrics-card">
    <view class="metrics-grid">
      <view class="metric-item">
        <text class="metric-value">{{correct || 0}}</text>
        <text class="metric-label">答对</text>
      </view>
      <view class="metric-item">
        <text class="metric-value wrong-color">{{wrong || 0}}</text>
        <text class="metric-label">错题</text>
      </view>
      <view class="metric-item">
        <text class="metric-value">{{total || 0}}</text>
        <text class="metric-label">总题</text>
      </view>
      <view class="metric-item" wx:if="{{skipped > 0}}">
        <text class="metric-value warn-color">{{skipped || 0}}</text>
        <text class="metric-label">跳过</text>
      </view>
      <view class="metric-item" wx:else>
        <text class="metric-value duration-text">{{durationText}}</text>
        <text class="metric-label">用时</text>
      </view>
    </view>
    <view class="metrics-row" wx:if="{{skipped > 0}}">
      <text class="metrics-duration-label">用时</text>
      <text class="metrics-duration-value">{{durationText}}</text>
    </view>
  </view>

  <!-- 3. Smart Suggestion -->
  <view class="card next-step-card {{nextStepType}}" wx:if="{{nextStepTitle}}">
    <view class="next-step-head">
      <text class="next-step-title">{{nextStepTitle}}</text>
      <text class="next-step-tag" wx:if="{{nextStepTag}}">{{nextStepTag}}</text>
    </view>
    <text class="next-step-desc">{{nextStepDesc}}</text>
  </view>

  <!-- 4. Wrong / Perfect Summary -->
  <view class="card wrong-summary-card" wx:if="{{wrong > 0}}">
    <view class="wrong-summary-main">
      <text class="wrong-summary-title">本次产生 {{wrong}} 道错题</text>
      <text class="wrong-summary-desc">建议优先复盘错题，再继续下一组练习</text>
    </view>
    <button class="wrong-summary-btn" bindtap="goWrongBook">去复盘</button>
  </view>

  <view class="card perfect-card" wx:elif="{{total > 0 && wrong === 0}}">
    <text class="perfect-title">本组没有错题</text>
    <text class="perfect-desc">可以继续保持节奏，再来一组巩固手感</text>
  </view>

  <!-- 5. Growth (weak) -->
  <view class="card growth-mini-card" wx:if="{{growthLevel}}">
    <view class="growth-mini-head">
      <view>
        <text class="growth-mini-title">{{growthTitle}}</text>
        <text class="growth-mini-desc">{{growthDesc}}</text>
      </view>
      <text class="growth-mini-level">{{growthLevel}}</text>
    </view>
    <view class="growth-mini-track" wx:if="{{growthLevelPct > 0}}">
      <view class="growth-mini-fill" style="width:{{growthLevelPct}}%"></view>
    </view>
    <text class="growth-mini-text" wx:if="{{growthExpText}}">{{growthExpText}}</text>
  </view>

  <!-- 6. Detail List (collapsed) -->
  <view class="card detail-card" wx:if="{{results.length > 0}}">
    <view class="detail-toggle" bindtap="toggleDetail">
      <view>
        <text class="section-title">答题详情</text>
        <text class="section-subtitle">查看每道题的正确 / 错误情况</text>
      </view>
      <text class="toggle-arrow">{{showDetail ? '收起' : '展开'}}</text>
    </view>

    <view class="detail-list" wx:if="{{showDetail}}">
      <view
        class="detail-row {{item._cls}}"
        wx:for="{{results}}"
        wx:key="question_id"
      >
        <view class="detail-row-left">
          <text class="detail-index">{{index + 1}}</text>
          <text class="detail-status {{item._cls}}">{{item._label}}</text>
        </view>
        <view class="detail-row-body">
          <text class="detail-stem" wx:if="{{item._stemPreview}}">{{item._stemPreview}}</text>
          <view class="detail-answer-line">
            <text class="detail-user-answer" wx:if="{{item._userAnswer}}">我的：{{item._userAnswer}}</text>
            <text class="detail-right-answer">正确：{{item.correct_answer}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 7. Bottom Actions -->
  <view class="bottom-safe-space"></view>

  <view class="bottom-actions">
    <block wx:if="{{wrong > 0}}">
      <button class="action-primary" bindtap="goWrongBook">复盘错题</button>
      <button class="action-secondary" bindtap="practiceAgain">继续练习</button>
    </block>
    <block wx:elif="{{total > 0}}">
      <button class="action-primary" bindtap="practiceAgain">再来一组</button>
      <button class="action-secondary" bindtap="goHome">返回首页</button>
    </block>
    <block wx:else>
      <button class="action-primary" bindtap="practiceAgain">返回练习</button>
      <button class="action-secondary" bindtap="goHome">返回首页</button>
    </block>
  </view>
</view>