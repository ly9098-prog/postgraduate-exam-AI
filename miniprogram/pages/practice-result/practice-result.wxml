<view class="page result-page">
  <animated-view
    wx:if="{{showCelebration && shouldShowCelebration}}"
    show="{{showCelebration}}"
    type="{{celebrationType}}"
    title="{{celebrationTitle}}"
    detail="{{celebrationDetail}}"
    motto="{{celebrationMotto}}"
    reward-text="{{celebrationRewardText}}"
    duration="{{2600}}"
    gif-src="/assets/animation/celebration.gif"
    png-src="/assets/animation/celebration-static.png"
    bind:done="dismissCelebration"
  />

  <!-- 1. Main Result Summary Card -->
  <view class="result-summary-card {{resultLevelClass}} anim-card-1">
    <view class="summary-top">
      <view class="accuracy-block">
        <view class="accuracy-number">
          <text class="accuracy-value">{{passRate || 0}}</text>
          <text class="accuracy-unit">%</text>
        </view>
        <view class="accuracy-track" wx:if="{{total > 0}}">
          <view class="accuracy-fill" style="width:{{passRate}}%"></view>
        </view>
        <text class="accuracy-label">正确率</text>
      </view>
      <view class="summary-status">
        <text class="status-text">{{statusText}}</text>
        <text class="status-desc">{{statusDesc}}</text>
      </view>
    </view>

    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-value">{{correct || 0}}</text>
        <text class="summary-label">答对</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{wrong || 0}}</text>
        <text class="summary-label">错题</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{total || 0}}</text>
        <text class="summary-label">总题</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{durationText}}</text>
        <text class="summary-label">用时</text>
      </view>
    </view>

    <view class="summary-extra" wx:if="{{skipped > 0 || subjectDisplay || growthExpText}}">
      <text wx:if="{{subjectDisplay}}">{{subjectDisplay}}</text>
      <text wx:if="{{subjectDisplay && skipped > 0}}"> · </text>
      <text wx:if="{{skipped > 0}}">跳过 {{skipped}} 题</text>
      <text wx:if="{{(subjectDisplay || skipped > 0) && growthExpText}}"> · </text>
      <text wx:if="{{growthExpText}}">{{growthExpText}}</text>
    </view>

    <view class="growth-mini-line" wx:if="{{growthLevel && growthLevelPct >= 0}}">
      <view class="growth-mini-texts">
        <text class="growth-mini-title">{{growthTitle || '成长进度'}}</text>
        <text class="growth-mini-level">{{growthLevel}}</text>
      </view>
      <view class="growth-mini-track" wx:if="{{growthLevelPct > 0}}">
        <view class="growth-mini-fill" style="width:{{growthLevelPct}}%"></view>
      </view>
    </view>
  </view>

  <!-- 3. Advice Card -->
  <view class="result-advice-card {{nextStepType}} anim-card-2" wx:if="{{nextStepTitle}}">
    <view class="advice-head">
      <text class="advice-title">{{nextStepTitle}}</text>
      <text class="advice-tag" wx:if="{{nextStepTag}}">{{nextStepTag}}</text>
    </view>
    <text class="advice-desc">{{nextStepDesc}}</text>
  </view>

  <!-- 4. Detail List (collapsed) -->
  <view class="detail-card anim-card-4" wx:if="{{results.length > 0}}">
    <view class="detail-toggle" bindtap="toggleDetail">
      <view>
        <text class="detail-title">答题详情</text>
        <text class="detail-subtitle">查看每道题的对错情况</text>
      </view>
      <text class="detail-toggle-text">{{showDetail ? '收起' : '展开'}}</text>
    </view>

    <view class="detail-list" wx:if="{{showDetail}}">
      <view
        class="detail-row {{item._cls}}"
        wx:for="{{compactResults}}"
        wx:key="question_id"
      >
        <view class="detail-row-left">
          <text class="detail-index">{{item._displayIndex}}</text>
          <text class="detail-status {{item._cls}}">{{item._label}}</text>
        </view>
        <view class="detail-row-body">
          <text class="detail-stem" wx:if="{{item._stemPreview}}">{{item._stemPreview}}</text>
          <view class="detail-answer-line">
            <text class="detail-user-answer {{item._cls}}" wx:if="{{item._userAnswer}}">我的：{{item._userAnswer}}</text>
            <text class="detail-right-answer" wx:if="{{item.correct_answer}}">正确：{{item.correct_answer}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-safe-space"></view>

  <!-- 6. Bottom Actions -->
  <view class="bottom-actions">
    <button class="action-primary" wx:if="{{wrong > 0}}" bindtap="goWrongBook">复盘错题</button>
    <button class="action-primary" wx:elif="{{total > 0}}" bindtap="practiceAgain">再来一组</button>
    <button class="action-primary" wx:else bindtap="practiceAgain">返回练习</button>

    <button class="action-secondary" wx:if="{{wrong > 0}}" bindtap="practiceAgain">继续练习</button>
    <button class="action-secondary" wx:else bindtap="goHome">返回首页</button>
  </view>
</view>
