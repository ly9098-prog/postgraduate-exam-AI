@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding-bottom: 48rpx;
  animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

/* 结果头部 */
.result-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  position: relative;
  overflow: hidden;
}

.result-hero.pass {
  background: linear-gradient(135deg, #FFFFFF 0%, #F6FBFF 56%, #ECFDF3 100%);
}

.result-hero.fail {
  background: linear-gradient(135deg, #FFFFFF 0%, #F6FBFF 56%, #FEF2F2 100%);
}

.result-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #22C55E;
  opacity: 0.34;
}

.result-hero.fail::before {
  background: #EF4444;
}

.result-hero::after {
  content: '';
  position: absolute;
  right: -52rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  font-size: 21rpx;
  line-height: 1.35;
  color: #4F7FFF;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #18233A;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #617089;
}

.score-ring {
  width: 156rpx;
  height: 156rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(42, 84, 160, 0.06);
  border: 10rpx solid #EEF4FF;
}

.result-hero.fail .score-ring {
  border-color: #FEF2F2;
}

.score-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score-percent {
  font-size: 22rpx;
  font-weight: 700;
  color: #4F7FFF;
  margin-top: 2rpx;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: #617089;
  margin-top: 5rpx;
}

/* 统计卡片 */
.stats-card,
.detail-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.section-head,
.detail-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.section-chip,
.toggle-arrow {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.stat-item {
  min-width: 0;
  min-height: 126rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F6F9FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item.primary { background: #EEF4FF; }
.stat-item.success { background: #ECFDF3; }
.stat-item.danger { background: #FEF2F2; }
.stat-item.warning { background: #FFFBEB; }

.stat-num {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-item.success .stat-num { color: #22C55E; }
.stat-item.danger .stat-num { color: #EF4444; }
.stat-item.warning .stat-num { color: #F59E0B; }

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #617089;
}

.duration-row {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F6F9FF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.duration-label {
  font-size: 24rpx;
  color: #617089;
}

.duration-value {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  font-variant-numeric: tabular-nums;
}


.growth-card {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #172554 0%, #3157D5 100%);
  box-shadow: 0 14rpx 34rpx rgba(49, 87, 213, 0.18);
  display: flex;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
  position: relative;
}

.growth-card::after {
  content: '';
  position: absolute;
  right: -40rpx;
  top: -48rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.growth-orb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #F59E0B 0%, #FDE68A 100%);
  box-shadow: 0 12rpx 28rpx rgba(245, 158, 11, 0.28);
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.growth-orb::before {
  content: '';
  position: absolute;
  left: 22rpx;
  top: 16rpx;
  width: 28rpx;
  height: 40rpx;
  border-radius: 999rpx 999rpx 10rpx 10rpx;
  background: rgba(255, 255, 255, 0.82);
}

.growth-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.growth-kicker,
.growth-title,
.growth-desc {
  display: block;
}

.growth-kicker {
  color: rgba(255, 255, 255, 0.65);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.growth-title {
  margin-top: 6rpx;
  color: #FFFFFF;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 900;
}

.growth-desc {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  line-height: 1.45;
}

.growth-level-bar {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.growth-level-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.growth-level-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  font-weight: 700;
}

.growth-level-pct {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 800;
}

.growth-level-track {
  margin-top: 10rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
}

.growth-level-fill {
  height: 100%;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 0 10rpx rgba(255, 255, 255, 0.3);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.growth-exp-text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.55);
}

/* 答题详情 */
.detail-toggle {
  margin-bottom: 0;
}

.detail-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF4FF;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-item {
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F6F9FF;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-item.correct {
  background: #ECFDF3;
}

.detail-item.wrong {
  background: #FEF2F2;
}

.detail-num {
  width: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #617089;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.detail-mark {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  color: #22C55E;
  flex-shrink: 0;
}

.detail-item.wrong .detail-mark {
  color: #EF4444;
}

.detail-answer {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: #18233A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.detail-stem {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #617089;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-answers {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.detail-answer.wrong-answer {
  color: #EF4444;
}

.detail-answer.right-answer {
  color: #22C55E;
}

/* 操作按钮 */
.actions {
  padding: 24rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-text {
  width: 100%;
  min-height: 88rpx;
  font-size: 29rpx;
  font-weight: 700;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
}

.btn-secondary {
  background: #EEF4FF;
  color: #4F7FFF;
}

.btn-text {
  background: transparent;
  color: #8EA0BA;
}

.btn-primary::after,
.btn-secondary::after,
.btn-text::after {
  border: none;
}

.btn-primary:active,
.btn-secondary:active,
.btn-text:active,
.detail-toggle:active {
  opacity: 0.82;
}

/* 完成反馈已迁移至 AnimatedView 组件 */

@media (prefers-reduced-motion: reduce) {
  .page { animation: none !important; }
}
