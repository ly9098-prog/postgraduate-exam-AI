@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F3F4F1;
  color: #18231C;
}

.page,
.result-page {
  min-height: 100vh;
  background: #F3F4F1;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ==================== Hero ==================== */

.result-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 86rpx;
  background:
    radial-gradient(circle at 82% 14%, rgba(174,239,0,0.18) 0, rgba(174,239,0,0) 34%),
    linear-gradient(145deg, #173524 0%, #0E2218 60%, #09150F 100%);
  color: #FFFFFF;
  box-sizing: border-box;
}

.result-hero-grid {
  position: absolute;
  top: -34rpx;
  right: -36rpx;
  width: 330rpx;
  height: 270rpx;
  opacity: 0.055;
  transform: rotate(7deg);
  background-image:
    linear-gradient(rgba(255,255,255,0.7) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255,255,255,0.7) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
  pointer-events: none;
}

.result-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.result-nav-back {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-nav-back-icon {
  color: #FFFFFF;
  font-size: 48rpx;
  line-height: 1;
  transform: translateY(-2rpx);
  font-family: Arial, sans-serif;
}

.result-nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 800;
}

.result-nav-capsule-space {
  margin-left: auto;
  width: 190rpx;
}

.result-control-pressed {
  opacity: 0.72;
  transform: scale(0.96);
}

.result-hero-content {
  position: relative;
  z-index: 2;
  padding: 26rpx 34rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  box-sizing: border-box;
}

.result-hero-copy {
  flex: 1;
  min-width: 0;
}

.result-eyebrow,
.detail-eyebrow,
.advice-eyebrow {
  display: block;
  color: #AEEF00;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.result-title {
  display: block;
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 900;
}

.result-subject {
  display: block;
  margin-top: 8rpx;
  color: rgba(255,255,255,0.7);
  font-size: 23rpx;
  font-weight: 700;
}

.result-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255,255,255,0.58);
  font-size: 22rpx;
  line-height: 1.55;
}

.accuracy-ring {
  width: 210rpx;
  height: 210rpx;
  padding: 13rpx;
  border-radius: 50%;
  box-sizing: border-box;
  flex-shrink: 0;
  animation: ringEnter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
}

.accuracy-ring-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #10251A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(255,255,255,0.08);
}

.accuracy-number {
  display: flex;
  align-items: baseline;
  line-height: 1;
}

.accuracy-value {
  font-size: 72rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  font-variant-numeric: tabular-nums;
  animation: numberEnter 0.58s cubic-bezier(0.34, 1.56, 0.64, 1) 0.12s both;
}

.accuracy-unit {
  margin-left: 2rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #D7FF68;
}

.accuracy-label {
  margin-top: 9rpx;
  color: rgba(255,255,255,0.62);
  font-size: 21rpx;
}

@keyframes ringEnter {
  from { opacity: 0; transform: scale(0.82) rotate(-18deg); }
  to { opacity: 1; transform: scale(1) rotate(0deg); }
}

@keyframes numberEnter {
  from { opacity: 0; transform: translateY(16rpx) scale(0.85); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* ==================== Main content ==================== */

.result-content {
  position: relative;
  z-index: 3;
  margin-top: -58rpx;
  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.summary-panel,
.advice-panel,
.detail-panel {
  background: #FFFFFF;
  border: 1rpx solid #E1E6E1;
  box-shadow: 0 14rpx 38rpx rgba(16,37,26,0.065);
  box-sizing: border-box;
}

.summary-panel {
  border-radius: 28rpx;
  padding: 26rpx 24rpx 22rpx;
}

.summary-grid {
  display: flex;
  align-items: stretch;
}

.summary-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 5rpx 4rpx;
  text-align: center;
}

.summary-divider {
  width: 1rpx;
  background: #E8ECE8;
  margin: 2rpx 4rpx;
}

.summary-value {
  display: block;
  color: #18231C;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.correct-value { color: #238B55; }
.wrong-value { color: #D94C44; }

.summary-time {
  font-size: 25rpx;
  white-space: nowrap;
}

.summary-label {
  display: block;
  margin-top: 7rpx;
  color: #858F87;
  font-size: 20rpx;
}

.growth-line {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #E8ECE8;
}

.growth-line-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.growth-copy {
  min-width: 0;
}

.growth-title {
  display: block;
  color: #1D2C22;
  font-size: 24rpx;
  font-weight: 850;
}

.growth-desc {
  display: block;
  margin-top: 5rpx;
  color: #7B867E;
  font-size: 21rpx;
}

.growth-level {
  color: #527D00;
  font-size: 23rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.growth-track {
  margin-top: 14rpx;
  height: 9rpx;
  border-radius: 999rpx;
  background: #E9EEE7;
  overflow: hidden;
}

.growth-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6B9E00 0%, #AEEF00 100%);
  transition: width 0.6s cubic-bezier(0.22, 1, 0.36, 1);
}

.growth-foot {
  margin-top: 9rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #96A098;
  font-size: 19rpx;
}

/* ==================== Advice ==================== */

.advice-panel {
  position: relative;
  margin-top: 18rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
}

.advice-accent {
  width: 8rpx;
  flex-shrink: 0;
  background: #AEEF00;
}

.advice-panel.review .advice-accent { background: #173524; }
.advice-panel.start .advice-accent { background: #D28A1C; }

.advice-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx 24rpx;
}

.advice-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.advice-eyebrow {
  color: #6F990E;
}

.advice-title {
  display: block;
  margin-top: 7rpx;
  color: #18231C;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 900;
}

.advice-tag {
  flex-shrink: 0;
  padding: 6rpx 13rpx;
  border-radius: 8rpx;
  background: #EDF4E7;
  color: #527D00;
  font-size: 19rpx;
  font-weight: 800;
}

.advice-desc {
  display: block;
  margin-top: 11rpx;
  color: #6E7971;
  font-size: 23rpx;
  line-height: 1.6;
}

/* ==================== Details ==================== */

.detail-panel {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-eyebrow {
  color: #6F990E;
}

.detail-title {
  display: block;
  margin-top: 7rpx;
  color: #18231C;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #858F87;
  font-size: 21rpx;
  line-height: 1.5;
}

.detail-count {
  min-width: 78rpx;
  padding: 10rpx 12rpx;
  border-radius: 15rpx;
  background: #F2F5F1;
  text-align: center;
  flex-shrink: 0;
}

.detail-count-value {
  display: block;
  color: #D94C44;
  font-size: 30rpx;
  font-weight: 900;
}

.detail-count-label {
  display: block;
  margin-top: 2rpx;
  color: #8A948C;
  font-size: 18rpx;
}

.all-correct-state {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #F1F8EE;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.all-correct-mark {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #AEEF00;
  color: #173524;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.all-correct-title {
  display: block;
  color: #1E3828;
  font-size: 24rpx;
  font-weight: 850;
}

.all-correct-desc {
  display: block;
  margin-top: 4rpx;
  color: #6F7B72;
  font-size: 20rpx;
  line-height: 1.5;
}

.detail-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-row {
  padding: 20rpx;
  border-radius: 19rpx;
  border: 1rpx solid #E1E6E1;
  background: #FAFBF9;
  box-sizing: border-box;
}

.detail-row.wrong {
  border-color: #F1C9C5;
  background: #FFF8F7;
}

.detail-row.skipped {
  border-color: #E0E4E0;
  background: #F6F7F5;
}

.detail-row.correct {
  border-color: #CAE7D4;
  background: #F6FCF8;
}

.detail-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.detail-row-index-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.detail-index {
  color: #18231C;
  font-size: 24rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.detail-status {
  padding: 4rpx 10rpx;
  border-radius: 7rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.detail-status.wrong { background: #FFE4E1; color: #D94C44; }
.detail-status.skipped { background: #E9ECE9; color: #6E7971; }
.detail-status.correct { background: #DDF4E5; color: #238B55; }

.detail-analysis-btn {
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  background: #173524;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.detail-analysis-btn-pressed { opacity: 0.78; transform: scale(0.97); }
.detail-analysis-arrow { color: #AEEF00; font-size: 26rpx; line-height: 1; }

.detail-stem-wrap {
  margin-top: 16rpx;
}

.detail-stem {
  display: block;
  max-width: 100%;
  color: #202B23;
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: normal;
}

.detail-answer-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.detail-answer-section,
.detail-correct-answer-line {
  min-width: 0;
}

.detail-answer-label {
  display: block;
  margin-bottom: 7rpx;
  color: #A0443E;
  font-size: 20rpx;
  font-weight: 800;
}

.detail-answer-label.correct { color: #238B55; }

.detail-answer-box {
  min-height: 58rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E1E6E1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.detail-answer-box.user {
  border-color: #F0C4C0;
  background: #FFF3F1;
}

.detail-answer-box.right {
  border-color: #C5E5D0;
  background: #EFFAF3;
}

.detail-answer-value {
  color: #202B23;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-word;
}

.detail-answer-value.user { color: #D94C44; }
.detail-answer-value.right { color: #238B55; }

.detail-skipped-line {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 11rpx;
  background: #ECEFEC;
  color: #707A72;
  font-size: 22rpx;
}

.detail-correct-answer-line {
  margin-top: 14rpx;
}

.detail-toggle-all {
  margin-top: 20rpx;
  min-height: 62rpx;
  border-top: 1rpx solid #E7EBE7;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 7rpx;
  color: #416300;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-toggle-all-pressed { opacity: 0.7; }
.detail-toggle-arrow { font-size: 26rpx; transition: transform 0.2s ease; }
.detail-toggle-arrow.up { transform: rotate(180deg); }

.detail-rich-text {
  display: block;
  max-width: 100%;
  overflow-x: hidden;
}

/* ==================== Actions ==================== */

.bottom-actions {
  padding: 26rpx 0 8rpx;
}

.action-primary {
  width: 100%;
  min-height: 92rpx;
  border-radius: 19rpx;
  border: none;
  background: linear-gradient(110deg, #173524 0%, #0E2218 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 92rpx;
  box-shadow: 0 14rpx 30rpx rgba(16,37,26,0.16);
}

.action-primary::after { border: none; }
.action-primary[disabled] { opacity: 0.55; }
.action-primary-pressed { transform: scale(0.99); opacity: 0.88; }

.action-secondary {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #526158;
  font-size: 23rpx;
  font-weight: 750;
}

.action-secondary-pressed { opacity: 0.58; }

/* ==================== Entry animations ==================== */

.anim-card-1 { animation: fadeSlideUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.08s both; }
.anim-card-2 { animation: fadeSlideUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.16s both; }
.anim-card-3 { animation: fadeSlideUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.24s both; }

@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 360px) {
  .result-hero-content { gap: 18rpx; padding-left: 26rpx; padding-right: 26rpx; }
  .accuracy-ring { width: 184rpx; height: 184rpx; }
  .accuracy-value { font-size: 64rpx; }
  .result-title { font-size: 34rpx; }
  .detail-answer-grid { grid-template-columns: 1fr; }
  .summary-time { font-size: 22rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .accuracy-ring,
  .accuracy-value,
  .anim-card-1,
  .anim-card-2,
  .anim-card-3,
  .growth-fill,
  .detail-toggle-arrow {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* ==================== Round 2 result actions ==================== */

.bottom-actions {
  padding: 24rpx 0 8rpx;
}

.action-primary {
  min-height: 100rpx;
  padding: 0 18rpx 0 26rpx;
  border-radius: 22rpx;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
}

.action-primary-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.action-primary-title {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.action-primary-desc {
  margin-top: 5rpx;
  color: rgba(255,255,255,0.58);
  font-size: 20rpx;
  line-height: 1.35;
  font-weight: 650;
}

.action-primary-arrow {
  width: 50rpx;
  height: 50rpx;
  margin-left: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #AEEF00;
  color: #10251A;
  font-family: Arial, sans-serif;
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(174,239,0,0.18);
}

.action-primary-arrow text { transform: translateY(-2rpx); }

.action-primary[disabled] .action-primary-arrow {
  opacity: 0.62;
}

.action-secondary {
  min-height: 68rpx;
  gap: 7rpx;
}

.action-secondary-arrow {
  color: #6F990E;
  font-family: Arial, sans-serif;
  font-size: 28rpx;
  transform: translateY(-1rpx);
}
