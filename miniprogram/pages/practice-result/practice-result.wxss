@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding-bottom: 48rpx;
}

/* 结果头部 */
.result-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  position: relative;
  overflow: hidden;
}

.result-hero.pass {
  background: linear-gradient(135deg, #FFFFFF 0%, #F6FBFF 56%, #ECFDF3 100%);
}

.result-hero.fail {
  background: linear-gradient(135deg, #FFFFFF 0%, #F6FBFF 56%, #FEF2F2 100%);
}

.result-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #22C55E;
  opacity: 0.34;
}

.result-hero.fail::before {
  background: #EF4444;
}

.result-hero::after {
  content: '';
  position: absolute;
  right: -52rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  font-size: 21rpx;
  line-height: 1.35;
  color: #4F7FFF;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #18233A;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #617089;
}

.score-ring {
  width: 156rpx;
  height: 156rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(42, 84, 160, 0.06);
  border: 10rpx solid #EEF4FF;
}

.result-hero.fail .score-ring {
  border-color: #FEF2F2;
}

.score-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score-percent {
  font-size: 22rpx;
  font-weight: 700;
  color: #4F7FFF;
  margin-top: 2rpx;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: #617089;
  margin-top: 5rpx;
}

/* 统计卡片 */
.stats-card,
.detail-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.section-head,
.detail-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.section-chip,
.toggle-arrow {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.stat-item {
  min-width: 0;
  min-height: 126rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F6F9FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item.primary { background: #EEF4FF; }
.stat-item.success { background: #ECFDF3; }
.stat-item.danger { background: #FEF2F2; }

.stat-num {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-item.success .stat-num { color: #22C55E; }
.stat-item.danger .stat-num { color: #EF4444; }

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #617089;
}

.duration-row {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F6F9FF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.duration-label {
  font-size: 24rpx;
  color: #617089;
}

.duration-value {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  font-variant-numeric: tabular-nums;
}

/* 答题详情 */
.detail-toggle {
  margin-bottom: 0;
}

.detail-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF4FF;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-item {
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F6F9FF;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-item.correct {
  background: #ECFDF3;
}

.detail-item.wrong {
  background: #FEF2F2;
}

.detail-num {
  width: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #617089;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.detail-mark {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  color: #22C55E;
  flex-shrink: 0;
}

.detail-item.wrong .detail-mark {
  color: #EF4444;
}

.detail-answer {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: #18233A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮 */
.actions {
  padding: 24rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-text {
  width: 100%;
  min-height: 88rpx;
  font-size: 29rpx;
  font-weight: 700;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
}

.btn-secondary {
  background: #EEF4FF;
  color: #4F7FFF;
}

.btn-text {
  background: transparent;
  color: #8EA0BA;
}

.btn-primary::after,
.btn-secondary::after,
.btn-text::after {
  border: none;
}

.btn-primary:active,
.btn-secondary:active,
.btn-text:active,
.detail-toggle:active {
  opacity: 0.82;
}

/* 完成反馈 */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: celeb-fade-in 0.28s ease both;
}

.celeb-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(11, 17, 33, 0.9);
  backdrop-filter: blur(18rpx);
}

.celeb-content {
  position: relative;
  z-index: 2;
  width: 620rpx;
  padding: 56rpx 40rpx 48rpx;
  border-radius: 36rpx;
  background: linear-gradient(160deg, rgba(79, 127, 255, 0.22), rgba(110, 193, 255, 0.08));
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.24);
}

.celeb-check-wrap {
  width: 144rpx;
  height: 144rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.18);
  border: 4rpx solid rgba(110, 193, 255, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  animation: celeb-check 0.72s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.celeb-check {
  font-size: 66rpx;
  color: #FFFFFF;
  font-weight: 900;
}

.celeb-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.25;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.16s both;
}

.celeb-detail {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.45;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.24s both;
}

.celeb-motto {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.5;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.32s both;
}

.celeb-tap-hint {
  margin-top: 30rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  animation: celeb-text-in 0.5s ease 0.4s both;
}

.particle-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  top: 50%;
  left: 50%;
  margin-top: -7rpx;
  margin-left: -7rpx;
}

.p1 { background: #6EC1FF; animation: p1 1.45s ease-out 0s forwards; }
.p2 { background: #4F7FFF; animation: p2 1.45s ease-out 0.08s forwards; }
.p3 { background: #F59E0B; animation: p3 1.45s ease-out 0.16s forwards; }
.p4 { background: #22C55E; animation: p4 1.45s ease-out 0.24s forwards; }
.p5 { background: #EF4444; animation: p5 1.45s ease-out 0.32s forwards; }
.p6 { background: #8B5CF6; animation: p6 1.45s ease-out 0.4s forwards; }

@keyframes celeb-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes celeb-check {
  0% { transform: scale(0) rotate(-18deg); opacity: 0; }
  55% { transform: scale(1.14) rotate(5deg); opacity: 1; }
  78% { transform: scale(0.96) rotate(-2deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes celeb-text-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes p1 { to { transform: translate(-230rpx, -280rpx) scale(0); opacity: 0; } }
@keyframes p2 { to { transform: translate(230rpx, -260rpx) scale(0); opacity: 0; } }
@keyframes p3 { to { transform: translate(-280rpx, 40rpx) scale(0); opacity: 0; } }
@keyframes p4 { to { transform: translate(280rpx, 70rpx) scale(0); opacity: 0; } }
@keyframes p5 { to { transform: translate(-150rpx, 280rpx) scale(0); opacity: 0; } }
@keyframes p6 { to { transform: translate(150rpx, 280rpx) scale(0); opacity: 0; } }
