@import '../../styles/tokens.wxss';

/* ══════════════════════════════════
   practice-result — Precision Dashboard
   ══════════════════════════════════ */

/* ── Page ── */
page,
.result-page,
.detail-list,
.detail-row,
.detail-row-body,
.detail-stem-wrap,
.detail-answer-block,
.detail-answer-box {
  max-width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}
.result-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 0;
  background-color: #F4F7FE;
  background-image: radial-gradient(#D6E0F0 1rpx, transparent 1rpx);
  background-size: 24rpx 24rpx;
  box-sizing: border-box;
}

/* ── 1. Main Result Summary Card ── */
.anim-card-1 {
  animation: fadeSlideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
}

.result-summary-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2EAF7;
  box-shadow: 0 12rpx 32rpx rgba(27, 59, 114, 0.06);
}

.summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EEF2F8;
}

.accuracy-block {
  min-width: 190rpx;
}

.accuracy-number {
  display: flex;
  align-items: baseline;
}

.accuracy-value {
  display: inline;
  font-size: 72rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  animation: accuracyPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

.accuracy-unit {
  display: inline;
  font-size: 30rpx;
  font-weight: 800;
  color: #4F7FFF;
  margin-left: 2rpx;
  animation: accuracyPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s both;
}

.accuracy-track {
  margin-top: 12rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  overflow: hidden;
}

.accuracy-fill {
  height: 100%;
  border-radius: 999rpx;
  transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
}

.result-summary-card.excellent .accuracy-fill { background: #22C55E; }
.result-summary-card.good .accuracy-fill { background: #4F7FFF; }
.result-summary-card.normal .accuracy-fill { background: #F59E0B; }
.result-summary-card.weak .accuracy-fill { background: #EF4444; }

.accuracy-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8EA0BA;
}

.summary-status {
  flex: 1;
  text-align: right;
}

.status-text {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #18233A;
}

.status-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #617089;
  line-height: 1.5;
}

/* ── Summary Grid ── */
.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
}

.summary-item {
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  background: #F7FAFF;
  text-align: center;
}

.summary-item-pressed {
  background: #EEF4FF;
}

.summary-value {
  display: block;
  font-size: 32rpx;
  font-weight: 850;
  color: #18233A;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8EA0BA;
}

/* ── Summary Extra ── */
.summary-extra {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E2EAF7;
  font-size: 24rpx;
  color: #617089;
  line-height: 1.5;
}

/* ── Growth Mini ── */
.growth-mini-line {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E2EAF7;
}

.growth-mini-texts {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.growth-mini-title {
  font-size: 24rpx;
  color: #617089;
}

.growth-mini-level {
  font-size: 24rpx;
  font-weight: 700;
  color: #4F7FFF;
}

.growth-mini-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  overflow: hidden;
}

.growth-mini-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4F7FFF;
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

/* ── State Colors ── */
.result-summary-card.excellent .accuracy-value,
.result-summary-card.excellent .accuracy-unit {
  color: #22C55E;
}

.result-summary-card.good .accuracy-value,
.result-summary-card.good .accuracy-unit {
  color: #4F7FFF;
}

.result-summary-card.normal .accuracy-value,
.result-summary-card.normal .accuracy-unit {
  color: #F59E0B;
}

.result-summary-card.weak .accuracy-value,
.result-summary-card.weak .accuracy-unit {
  color: #EF4444;
}

/* ── 3. Advice Card ── */
.anim-card-2 {
  animation: fadeSlideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
}

.result-advice-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2EAF7;
}

.result-advice-card.continue { border-left: 6rpx solid #22C55E; }
.result-advice-card.review { border-left: 6rpx solid #4F7FFF; }
.result-advice-card.start { border-left: 6rpx solid #F59E0B; }

.advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.advice-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #18233A;
}

.advice-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 21rpx;
  font-weight: 700;
}

.result-advice-card.continue .advice-tag { background: #ECFDF3; color: #22C55E; }

.advice-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.55;
}

/* ── 5. Detail Card ── */
.anim-card-4 {
  animation: fadeSlideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.34s both;
}

.detail-card {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2EAF7;
}

.detail-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-toggle-pressed {
  opacity: 0.75;
}

.detail-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #18233A;
}

.detail-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8EA0BA;
}

.detail-toggle-text {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  background: #F6F9FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
}

.detail-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF4FF;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-row {
  position: relative;
  width: 100%;
  max-width: 100%;
  padding: 16rpx 16rpx 16rpx 24rpx;
  border-radius: 16rpx;
  background: #F7FAFF;
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  box-sizing: border-box;
  overflow: hidden;
  border-left: 6rpx solid transparent;
}

.detail-row.correct {
  background: #F0FDF4;
  border-left-color: #22C55E;
}

.detail-row.wrong {
  background: #FEF2F2;
  border-left-color: #EF4444;
}

.detail-row.skipped {
  background: #F6F9FF;
  border-left-color: #8EA0BA;
}

.detail-row-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 48rpx;
  flex-shrink: 0;
}

.detail-index {
  font-size: 22rpx;
  font-weight: 700;
  color: #617089;
  font-variant-numeric: tabular-nums;
}

.detail-status-pill {
  font-size: 18rpx;
  font-weight: 700;
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.detail-status-pill.correct { background: rgba(34, 197, 94, 0.15); color: #22C55E; }
.detail-status-pill.wrong { background: rgba(239, 68, 68, 0.15); color: #EF4444; }
.detail-status-pill.skipped { background: rgba(142, 160, 186, 0.15); color: #617089; }

.detail-row-body {
  flex: 1;
  min-width: 0;
}

.detail-stem-wrap {
  margin-bottom: 10rpx;
}

.detail-stem {
  display: block;
  max-width: 100%;
  font-size: 25rpx;
  line-height: 1.65;
  color: #18233A;
  word-break: break-word;
  overflow-wrap: anywhere;
  white-space: normal;
}





.detail-skipped-line {
  font-size: 22rpx;
  color: #8EA0BA;
  line-height: 1.45;
}

.detail-answer-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.86);
}

.detail-answer-block.wrong {
  background: rgba(255,255,255,0.85);
}

.detail-answer-block.correct {
  background: rgba(255,255,255,0.7);
}

.detail-answer-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-answer-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #617089;
  line-height: 1.4;
}

.detail-answer-label.correct {
  color: #22C55E;
}

.detail-answer-box {
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #F8FAFF;
  border: 1rpx solid #E2EAF7;
}

.detail-answer-box.user {
  background: #FFF7F7;
  border-color: #FECACA;
}

.detail-answer-box.right {
  background: #F0FDF4;
  border-color: #BBF7D0;
}

.detail-answer-value {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-word;
  white-space: pre-wrap;
}

.detail-answer-value.user {
  color: #18233A;
}

.detail-answer-value.right {
  color: #18233A;
}

.detail-rich-text {
  font-size: 24rpx;
  line-height: 1.65;
  color: inherit;
}

/* ── 6. Bottom Actions ── */
.bottom-safe-space {
  height: 300rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(226, 234, 247, 0.9);
  display: flex;
  gap: 16rpx;
  z-index: 20;
}

.action-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 800;
  padding: 0;
  border: none;
  line-height: 88rpx;
  text-align: center;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.action-secondary {
  width: 210rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  border: none;
  line-height: 88rpx;
  text-align: center;
  transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.action-primary::after,
.action-secondary::after {
  border: none;
}

.action-primary-pressed {
  opacity: 0.9;
  transform: scale(0.97);
}

.action-secondary-pressed {
  opacity: 0.85;
  transform: scale(0.97);
}

/* ── Keyframes ── */

/* ── Force black text for all detail content ── */
.detail-stem,
.detail-answer-value,
.detail-rich-text,
.detail-stem-rich {
  color: #18233A !important;
}

.detail-answer-label {
  color: #4B5563;
}

.detail-answer-label.correct {
  color: #4B5563;
}
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes accuracyPop {
  from { opacity: 0; transform: scale(0.6); }
  to { opacity: 1; transform: scale(1); }
}

/* ── Reduced Motion ── */
@media (prefers-reduced-motion: reduce) {
  .anim-card-1,
  .anim-card-2,
  .anim-card-4 {
    animation: none;
  }

  .accuracy-value,
  .accuracy-unit {
    animation: none;
  }

  .growth-mini-fill,
  .accuracy-fill {
    transition: none;
  }

  .action-primary-pressed,
  .action-secondary-pressed {
    transform: none;
  }

  .wrong-inline-tip-pressed {
    transform: none;
  }
}
