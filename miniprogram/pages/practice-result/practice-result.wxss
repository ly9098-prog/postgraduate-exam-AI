@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

/* 结果头部 */
.result-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.result-hero.pass {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #EFF5EF 100%);
}

.result-hero.fail {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #F5F1EB 100%);
}

.result-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #6B9B6B;
  opacity: 0.34;
}

.result-hero.fail::before {
  background: #C49A6B;
}

.result-hero::after {
  content: '';
  position: absolute;
  right: -52rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  font-size: 21rpx;
  line-height: 1.35;
  color: #5B7B9A;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.score-ring {
  width: 156rpx;
  height: 156rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
  border: 10rpx solid #EFF5EF;
}

.result-hero.fail .score-ring {
  border-color: #F5F1EB;
}

.score-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #5B7B9A;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score-percent {
  font-size: 22rpx;
  font-weight: 700;
  color: #5B7B9A;
  margin-top: 2rpx;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: #6B7B8D;
  margin-top: 5rpx;
}

/* 统计卡片 */
.stats-card,
.detail-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.section-head,
.detail-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip,
.toggle-arrow {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}

.stat-item {
  min-width: 0;
  min-height: 126rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F7F6F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item.primary { background: #EDF1F5; }
.stat-item.success { background: #EFF5EF; }
.stat-item.danger { background: #F5EFEF; }

.stat-num {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-item.success .stat-num { color: #6B9B6B; }
.stat-item.danger .stat-num { color: #C47A7A; }

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.duration-row {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F7F6F2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.duration-label {
  font-size: 24rpx;
  color: #6B7B8D;
}

.duration-value {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #2D3E50;
  font-variant-numeric: tabular-nums;
}

/* 答题详情 */
.detail-toggle {
  margin-bottom: 0;
}

.detail-list {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EDF1F5;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.detail-item {
  min-height: 72rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: #F7F6F2;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.detail-item.correct {
  background: #EFF5EF;
}

.detail-item.wrong {
  background: #F5EFEF;
}

.detail-num {
  width: 58rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #6B7B8D;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.detail-mark {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
  color: #6B9B6B;
  flex-shrink: 0;
}

.detail-item.wrong .detail-mark {
  color: #C47A7A;
}

.detail-answer {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.45;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮 */
.actions {
  padding: 24rpx 24rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-primary,
.btn-secondary,
.btn-text {
  width: 100%;
  min-height: 88rpx;
  font-size: 29rpx;
  font-weight: 700;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 88rpx;
  text-align: center;
}

.btn-primary {
  background: #5B7B9A;
  color: #FFFFFF;
}

.btn-secondary {
  background: #EDF1F5;
  color: #5B7B9A;
}

.btn-text {
  background: transparent;
  color: #9AABBA;
}

.btn-primary::after,
.btn-secondary::after,
.btn-text::after {
  border: none;
}

.btn-primary:active,
.btn-secondary:active,
.btn-text:active,
.detail-toggle:active {
  opacity: 0.82;
}
