@import '../../styles/tokens.wxss';

/* ── Page ── */
page {
  min-height: 100vh;
  background: #EEF5FF;
  background-color: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  background-color: #EEF5FF;
  padding: 0 0 200rpx;
}

/* ── Card Base ── */
.card {
  margin: 16rpx 20rpx 0;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(42, 84, 160, 0.06);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

/* ── 1. Result Summary ── */
.result-summary {
  margin: 0 20rpx;
  padding: 30rpx 24rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F6FBFF 56%, #EEF4FF 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.summary-main {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #EEF4FF;
  font-size: 20rpx;
  line-height: 1.4;
  color: #4F7FFF;
  font-weight: 700;
}

.summary-title {
  display: block;
  margin-top: 14rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #18233A;
}

.summary-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #617089;
}

.score-block {
  flex-shrink: 0;
  min-width: 140rpx;
  text-align: center;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: #EEF4FF;
}

.score-value {
  display: inline;
  font-size: 48rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score-unit {
  display: inline;
  font-size: 24rpx;
  font-weight: 700;
  color: #4F7FFF;
  margin-left: 2rpx;
}

.score-label {
  display: block;
  font-size: 20rpx;
  color: #617089;
  margin-top: 4rpx;
}

.result-summary.weak {
  background: linear-gradient(135deg, #FFFFFF 0%, #FEF2F2 100%);
}
.result-summary.weak .score-block { background: #FEF2F2; }
.result-summary.weak .score-value,
.result-summary.weak .score-unit { color: #EF4444; }

.result-summary.empty .summary-title { color: #8EA0BA; }

/* ── 2. Metrics Card ── */
.metrics-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8rpx;
}

.metric-item {
  min-width: 0;
  min-height: 100rpx;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #F6F9FF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.metric-value {
  max-width: 100%;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-value.wrong-color { color: #EF4444; }
.metric-value.warn-color { color: #F59E0B; }
.metric-value.duration-text {
  font-size: 26rpx;
  color: #18233A;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #617089;
}

.metrics-row {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #F6F9FF;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metrics-duration-label {
  font-size: 22rpx;
  color: #617089;
}

.metrics-duration-value {
  font-size: 24rpx;
  font-weight: 800;
  color: #18233A;
  font-variant-numeric: tabular-nums;
}

/* ── 3. Next Step Card ── */
.next-step-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.next-step-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #18233A;
}

.next-step-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.next-step-card.continue { border-left: 6rpx solid #22C55E; }
.next-step-card.review { border-left: 6rpx solid #4F7FFF; }

.next-step-card.continue .next-step-tag { background: #ECFDF3; color: #22C55E; }

.next-step-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: #617089;
}

/* ── 4. Wrong / Perfect Summary ── */
.wrong-summary-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.wrong-summary-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #EF4444;
}

.wrong-summary-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #617089;
}

.wrong-summary-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FEF2F2;
  color: #EF4444;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
  padding: 0;
}

.wrong-summary-btn::after { border: none; }
.wrong-summary-btn:active { opacity: 0.8; }

.perfect-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #22C55E;
  display: block;
}

.perfect-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #617089;
}

/* ── 5. Growth Mini Card ── */
.growth-mini-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.growth-mini-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #18233A;
}

.growth-mini-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.growth-mini-level {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.growth-mini-track {
  margin-top: 14rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  overflow: hidden;
}

.growth-mini-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4F7FFF;
  transition: width 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.growth-mini-text {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8EA0BA;
}

/* ── 6. Detail List ── */
.detail-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.toggle-arrow {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #F6F9FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-list {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEF4FF;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-row {
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #F6F9FF;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.detail-row.correct { background: #ECFDF3; }
.detail-row.wrong { background: #FEF2F2; }

.detail-row-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 44rpx;
  flex-shrink: 0;
}

.detail-index {
  font-size: 20rpx;
  font-weight: 700;
  color: #617089;
  font-variant-numeric: tabular-nums;
}

.detail-status {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 6rpx;
  font-size: 16rpx;
  font-weight: 700;
}

.detail-status.correct { background: rgba(34, 197, 94, 0.15); color: #22C55E; }
.detail-status.wrong { background: rgba(239, 68, 68, 0.15); color: #EF4444; }

.detail-row-body {
  flex: 1;
  min-width: 0;
}

.detail-stem {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
  color: #617089;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-row.wrong .detail-stem { color: #18233A; }

.detail-answer-line {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.detail-user-answer,
.detail-right-answer {
  font-size: 20rpx;
  line-height: 1.45;
  white-space: normal;
  overflow: visible;
  word-break: break-word;
}

.detail-user-answer { color: #EF4444; }
.detail-right-answer { color: #22C55E; }

/* ── 7. Bottom Actions ── */
.bottom-safe-space {
  height: 24rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border-top: 1rpx solid rgba(226, 234, 247, 0.9);
  display: flex;
  gap: 14rpx;
  z-index: 20;
}

.action-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  padding: 0;
  border: none;
  line-height: 88rpx;
  text-align: center;
}

.action-secondary {
  width: 200rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0;
  border: none;
  line-height: 88rpx;
  text-align: center;
}

.action-primary::after,
.action-secondary::after {
  border: none;
}

.action-primary:active,
.action-secondary:active {
  opacity: 0.82;
}

/* ── Reduced Motion ── */
@media (prefers-reduced-motion: reduce) {
  .page { animation: none !important; }
}
