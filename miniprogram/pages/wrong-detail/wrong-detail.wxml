<view wx:if="{{loading}}" class="loading-wrap">
  <loading-lottie text="正在加载错题详情..." size="large" />
</view>

<!-- 错误态 -->
<view wx:elif="{{errorText}}" class="error-state">
  <view class="error-icon-wrap">
    <text class="line-icon icon-exclamation" style="width:48rpx;height:48rpx;color:#EF4444;"></text>
  </view>
  <text class="error-title">{{errorText}}</text>
  <text class="error-desc">该错题记录可能已被移除或不存在</text>
  <view class="error-actions">
    <button class="error-btn primary" bindtap="reloadData">重新加载</button>
    <button class="error-btn secondary" bindtap="goBack">返回错题本</button>
  </view>
</view>

<view class="page" wx:elif="{{!loading && wq}}">
  <view wx:if="{{switching}}" class="switch-loading-overlay">
    <loading-lottie text="正在切换错题..." size="small" />
  </view>

  <quiz-runner
    mode="wrong-detail"
    title="错题复盘"
    subtitle="{{currentIdx + 1}} / {{totalQuestions}}"
    subjectName="{{subjectLabelText}}"
    questions="{{wrongQuestions}}"
    currentQuestion="{{currentQuestion}}"
    currentIndex="{{currentIdx}}"
    totalCount="{{totalQuestions}}"
    answeredCount="{{totalQuestions}}"
    progressPercent="{{runnerProgressPercent}}"
    readonly="{{true}}"
    showAnswer="{{true}}"
    showFeedback="{{false}}"
    submitDisabled="{{true}}"
    submitText="继续复盘"
    showSubmitButton="{{false}}"
    swipeEnabled="{{true}}"
    allowSwipeInReadonly="{{true}}"
    bind:prev="goPrevWrong"
    bind:next="goNextWrong"
    bind:jump="goWrongQuestion"
  />

  <!-- AI 分析：手动触发 -->
  <view class="ai-card">
    <view class="section-head">
      <view>
        <text class="section-title">AI 错题复盘</text>
        <text class="section-subtitle">{{aiRequested ? '定位错因、补齐考点、安排下一次复练' : '点击后生成，不再自动请求'}}</text>
      </view>
      <text class="section-chip">AI</text>
    </view>

    <!-- 未请求状态 -->
    <view wx:if="{{!aiRequested && !aiLoading && !aiResult && !aiFallback}}" class="ai-idle">
      <text class="ai-idle-title">需要 AI 帮你复盘这道错题吗？</text>
      <text class="ai-idle-desc">点击后将生成错因诊断、补漏重点和复练任务。</text>
      <button class="ai-action-btn" bindtap="onTapAiAnalysis">生成 AI 错题复盘</button>
    </view>

    <!-- 加载状态 / 重新生成中 -->
    <view wx:elif="{{aiLoading || aiRegenerating}}" class="ai-loading-state">
      <view class="section-head compact">
        <view>
          <text class="section-title small">正在生成</text>
          <text class="section-subtitle">AI 正在分析题目，请稍候</text>
        </view>
        <view class="chip-loading">
          <view class="loading-spinner mini"></view>
          <text class="chip-loading-text">生成中</text>
        </view>
      </view>
      <view class="ai-loading-skeleton">
        <view class="skeleton-block" style="width:35%;height:20rpx;margin-bottom:12rpx;"></view>
        <view class="skeleton-block" style="width:85%;height:16rpx;margin-bottom:8rpx;"></view>
        <view class="skeleton-block" style="width:70%;height:16rpx;margin-bottom:8rpx;"></view>
        <view class="skeleton-block" style="width:55%;height:16rpx;"></view>
      </view>
      <text class="ai-hint">生成时间较长时，可以稍后重试</text>
    </view>

    <!-- 成功状态：增强卡片布局，支持 LaTeX 渲染 -->
    <view wx:elif="{{aiCards && !aiFallback}}" class="ai-result-state">
      <view class="ai-section ai-section-diagnosis" wx:if="{{aiCards.mistakeDiagnosis.raw}}">
        <view class="ai-label-row">
          <view class="ai-index">1</view>
          <view>
            <text class="ai-label">错因诊断</text>
            <text class="ai-label-desc">先定位这道题为什么错</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.mistakeDiagnosis.needsRich}}"
          content="{{aiCards.mistakeDiagnosis.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.mistakeDiagnosis.text}}</text>
      </view>

      <view class="ai-section ai-section-knowledge" wx:if="{{aiCards.knowledgePatch.raw}}">
        <view class="ai-label-row">
          <view class="ai-index">2</view>
          <view>
            <text class="ai-label">补漏重点</text>
            <text class="ai-label-desc">明确这道题暴露的薄弱点</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.knowledgePatch.needsRich}}"
          content="{{aiCards.knowledgePatch.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.knowledgePatch.text}}</text>
      </view>

      <view class="ai-section ai-section-task" wx:if="{{aiCards.reviewTask.raw}}">
        <view class="ai-label-row">
          <view class="ai-index">3</view>
          <view>
            <text class="ai-label">复练任务</text>
            <text class="ai-label-desc">给出下一步可执行动作</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.reviewTask.needsRich}}"
          content="{{aiCards.reviewTask.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.reviewTask.text}}</text>
      </view>

      <text class="ai-hint">{{aiFromCache ? '来自历史缓存，仅供参考' : '内容由 AI 生成，仅供参考'}}</text>
      <button class="ai-secondary-btn" bindtap="regenerateAiAnalysis">{{aiRegenerating ? '重新生成中...' : '重新生成'}}</button>
    </view>

    <!-- 失败 / 降级状态 -->
    <view wx:elif="{{aiFallback}}" class="ai-fallback">
      <view class="fallback-mark">
        <view class="line-icon icon-exclamation"></view>
      </view>
      <text class="fallback-title">AI 错题复盘暂时不可用</text>
      <text class="fallback-desc">{{aiErrorText || '建议先查看题目解析并手动标记错因，稍后再试。'}}</text>
      <button class="ai-action-btn retry" bindtap="regenerateAiAnalysis">{{aiRegenerating ? '重新生成中...' : '重新生成'}}</button>
    </view>
  </view>
</view>