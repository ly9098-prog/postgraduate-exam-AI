<view wx:if="{{loading}}" class="loading-wrap">
  <loading-lottie text="正在加载错题详情..." size="large" />
</view>

<!-- 错误态 -->
<view wx:elif="{{errorText}}" class="error-state">
  <view class="error-icon-wrap">
    <text class="line-icon icon-exclamation" style="width:48rpx;height:48rpx;color:#EF4444;"></text>
  </view>
  <text class="error-title">{{errorText}}</text>
  <text class="error-desc">该错题记录可能已被移除或不存在</text>
  <view class="error-actions">
    <button class="error-btn primary" bindtap="reloadData">重新加载</button>
    <button class="error-btn secondary" bindtap="goBack">返回错题本</button>
  </view>
</view>

<view class="page" wx:elif="{{!loading && wq}}">
  <view wx:if="{{showSwitchMask}}" class="switch-mask">
    <text class="switch-mask-text">切换中...</text>
  </view>

  <quiz-runner
    mode="wrong-detail"
    title="错题复盘"
    subtitle="{{currentIdx + 1}} / {{totalQuestions}}"
    subjectName="{{subjectLabelText}}"
    questions="{{wrongQuestions}}"
    currentQuestion="{{currentQuestion}}"
    currentIndex="{{currentIdx}}"
    totalCount="{{totalQuestions}}"
    answeredCount="{{totalQuestions}}"
    progressPercent="{{runnerProgressPercent}}"
    readonly="{{true}}"
    showAnswer="{{true}}"
    showFeedback="{{false}}"
    submitDisabled="{{true}}"
    submitText="继续复盘"
    showSubmitButton="{{false}}"
    swipeEnabled="{{true}}"
    allowSwipeInReadonly="{{true}}"
    compactReviewMode="{{true}}"
    bind:prev="goPrevWrong"
    bind:next="goNextWrong"
    bind:jump="goWrongQuestion"
  />

  <!-- AI 分析卡片 -->
  <view class="ai-card" id="ai-card">
    <view class="section-head">
      <view>
        <text class="section-title">AI 错题复盘</text>
        <text class="section-subtitle" wx:if="{{aiRequested}}">定位错因、补齐考点、安排复练</text>
      </view>
      <text class="section-chip">AI</text>
    </view>

    <!-- 2. 骨架屏（优先于内容，re-generate 或首次加载时展示） -->
    <view wx:if="{{aiSkeletonVisible || (aiLoading && !aiCards)}}" class="ai-loading-state">
      <view class="ai-skeleton-section">
        <view class="skeleton-title-row">
          <view class="skeleton-index"></view>
          <view class="skeleton-title"></view>
        </view>
        <view class="skeleton-line long"></view>
        <view class="skeleton-line medium"></view>
        <view class="skeleton-line short"></view>
      </view>

      <view class="ai-skeleton-section">
        <view class="skeleton-title-row">
          <view class="skeleton-index"></view>
          <view class="skeleton-title"></view>
        </view>
        <view class="skeleton-line long"></view>
        <view class="skeleton-line medium"></view>
      </view>

      <view class="ai-skeleton-section">
        <view class="skeleton-title-row">
          <view class="skeleton-index"></view>
          <view class="skeleton-title"></view>
        </view>
        <view class="skeleton-line medium"></view>
        <view class="skeleton-line short"></view>
      </view>
    </view>

    <!-- 1. 已有结果：优先展示（包括 re-generate 期间） -->
    <view wx:elif="{{aiCards && !aiFallback}}" class="ai-result-state {{aiRegenerating ? 'is-regenerating' : ''}}">
      <!-- 重新生成中的提示条 -->
      <view wx:if="{{aiRegenerating}}" class="ai-regenerating-banner">
        <view class="loading-spinner mini"></view>
        <text class="ai-regenerating-text">正在重新生成，当前先保留旧解析</text>
      </view>

      <!-- 格式异常：AI 返回了无法解析的结构化数据 -->
      <view wx:if="{{aiCards.formatError && !aiCards.mistakeDiagnosis.raw && !aiCards.knowledgePatch.raw && !aiCards.reviewTask.raw}}" class="ai-fallback inside">
        <view class="fallback-mark">
          <view class="line-icon icon-exclamation"></view>
        </view>
        <text class="fallback-title">AI 解析格式异常</text>
        <text class="fallback-desc">返回数据格式无法识别，请重新生成</text>
      </view>

      <view wx:elif="{{aiCards.mistakeDiagnosis.raw}}" class="ai-section ai-section-diagnosis">
        <view class="ai-label-row">
          <view class="ai-index">1</view>
          <view>
            <text class="ai-label">错因诊断</text>
            <text class="ai-label-desc">先定位这道题为什么错</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.mistakeDiagnosis.needsRich}}"
          content="{{aiCards.mistakeDiagnosis.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.mistakeDiagnosis.text}}</text>
      </view>

      <view class="ai-section ai-section-knowledge" wx:if="{{aiCards.knowledgePatch.raw}}">
        <view class="ai-label-row">
          <view class="ai-index">2</view>
          <view>
            <text class="ai-label">补漏重点</text>
            <text class="ai-label-desc">明确这道题暴露的薄弱点</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.knowledgePatch.needsRich}}"
          content="{{aiCards.knowledgePatch.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.knowledgePatch.text}}</text>
      </view>

      <view class="ai-section ai-section-task" wx:if="{{aiCards.reviewTask.raw}}">
        <view class="ai-label-row">
          <view class="ai-index">3</view>
          <view>
            <text class="ai-label">复练任务</text>
            <text class="ai-label-desc">给出下一步可执行动作</text>
          </view>
        </view>
        <mp-html
          wx:if="{{aiCards.reviewTask.needsRich}}"
          content="{{aiCards.reviewTask.html}}"
          class="ai-rich-text"
          lazy-load
        />
        <text wx:else class="ai-text">{{aiCards.reviewTask.text}}</text>
      </view>

      <text wx:if="{{aiInlineNotice}}" class="ai-inline-notice">{{aiInlineNotice}}</text>
      <text wx:elif="{{!aiInlineNotice}}" class="ai-hint">{{aiFromCache ? '来自历史缓存，仅供参考' : '内容由 AI 生成，仅供参考'}}</text>
      <button class="ai-secondary-btn {{aiRegenerating ? 'loading' : ''}}" disabled="{{aiRegenerating}}" bindtap="regenerateAiAnalysis">
        {{aiRegenerating ? '重新生成中...' : '重新生成'}}
      </button>
    </view>



    <!-- 3. 失败空态（仅无旧内容时） -->
    <view wx:elif="{{aiFallback && !aiCards}}" class="ai-fallback">
      <view class="fallback-mark">
        <view class="line-icon icon-exclamation"></view>
      </view>
      <text class="fallback-title">AI 错题复盘暂时不可用</text>
      <text class="fallback-desc">{{aiErrorText || '建议先查看题目解析并手动标记错因，稍后再试。'}}</text>
      <button class="ai-action-btn retry" bindtap="regenerateAiAnalysis">重新生成</button>
    </view>

    <!-- 4. 未请求态 — 仅保留生成按钮 -->
    <view wx:elif="{{!aiRequested && !aiCards}}" class="ai-idle minimal">
      <button class="ai-action-btn" bindtap="onTapAiAnalysis">生成 AI 解析</button>
    </view>
  </view>
</view>