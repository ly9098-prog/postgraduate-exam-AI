/* wrong-detail — 错题详情专属样式 */
@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
  overflow-x: hidden;
}

.detail-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #F5F1EB 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.detail-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #C49A6B;
  opacity: 0.4;
}

.detail-hero::after {
  content: '';
  position: absolute;
  right: -54rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #F5F1EB;
  font-size: 21rpx;
  line-height: 1.35;
  color: #C49A6B;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.hero-badge {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
  border: 10rpx solid #F5F1EB;
}

.hero-badge.mastered {
  border-color: #EFF5EF;
}

.hero-badge-main {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #C49A6B;
}

.hero-badge.mastered .hero-badge-main {
  color: #6B9B6B;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6B7B8D;
}

.detail-card,
.ai-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.subject-tag,
.error-type-tag,
.tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
}

.subject-tag {
  background: #EDF1F5;
  color: #5B7B9A;
}

.error-type-tag,
.tag {
  background: #F5F1EB;
  color: #C49A6B;
}

.tag-success {
  background: #EFF5EF;
  color: #6B9B6B;
}

.question-block {
  padding: 18rpx 0;
}

.q-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.72;
  color: #2D3E50;
  white-space: pre-wrap;
  word-break: break-word;
}

.options-list {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF1F5;
  border-radius: 12rpx;
  overflow: hidden;
}

.blank-options {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EDF1F5;
}

.blank-group {
  padding: 18rpx 0;
}

.blank-group + .blank-group {
  border-top: 1rpx dashed #EDF1F5;
}

.blank-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.blank-group-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #5B7B9A;
}

.blank-group-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-line,
.blank-option-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}

.blank-option-item {
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  background: #F7F6F2;
  align-items: flex-start;
  border: 2rpx solid transparent;
}

.blank-option-item.correct {
  background: #E8F5E9;
  border: 2rpx solid #6B9B6B;
}

.blank-option-item.correct .option-key {
  color: #6B9B6B;
}

.blank-option-item.user-answer {
  background: #E3F2FD;
  border: 2rpx solid #5B7B9A;
}

.blank-option-item.user-answer .option-key {
  color: #5B7B9A;
}

.option-body {
  flex: 1;
  min-width: 0;
  color: #2D3E50;
  word-break: break-word;
}

.option-key {
  color: #5B7B9A;
  font-weight: 800;
  flex-shrink: 0;
}

.option-text,
.option-value {
  display: inline;
  color: inherit;
  word-break: break-word;
}

.option-line.correct {
  background: #E8F5E9;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.option-line.user-answer {
  background: #E3F2FD;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.option-value.right {
  color: #2E7D32;
  font-weight: 800;
}

.option-value.wrong {
  color: #1565C0;
  font-weight: 800;
}

.sm2-info {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #EDF1F5;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #5B7B9A;
  text-align: center;
}

.master-btn {
  margin-top: 24rpx;
  width: 100%;
  min-height: 86rpx;
  border-radius: 999rpx;
  background: #6B9B6B;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 86rpx;
  border: none;
}

.master-btn::after {
  border: none;
}

.master-btn:active {
  opacity: 0.84;
  transform: scale(0.97);
}

.option-line:active {
  background: #F3F2EF;
}

.blank-option-item:active {
  background: #EDF1F5;
  border-color: #D0D5DD;
}

.blank-option-item.correct:active {
  background: #C8E6C9;
}

.blank-option-item.user-answer:active {
  background: #BBDEFB;
}

/* AI 分析 */
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-head.compact {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ai-section {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #F7F6F2;
  border-radius: 20rpx;
}

.ai-label {
  font-size: 25rpx;
  font-weight: 800;
  color: #5B7B9A;
  display: block;
  margin-bottom: 8rpx;
}

.ai-text {
  display: block;
  font-size: 27rpx;
  color: #2D3E50;
  line-height: 1.7;
  white-space: pre-wrap;
}

.ai-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #9AABBA;
  margin-top: 18rpx;
}

.ai-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28rpx 12rpx;
}

.fallback-mark {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #F5F1EB;
  color: #C49A6B;
  font-size: 36rpx;
  line-height: 82rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.fallback-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #2D3E50;
}

.fallback-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9AABBA;
}

.loading-wrap {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F7F5F0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
}

.loading-spinner.mini {
  width: 20rpx;
  height: 20rpx;
  border-width: 2rpx;
}

.chip-loading {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
}
.chip-loading-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #5B7B9A;
  line-height: 1.35;
}

.ai-loading-skeleton {
  padding: 18rpx;
  background: #F7F6F2;
  border-radius: 20rpx;
}
.skeleton-block {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #EDF1F5 25%, #E2E8EC 50%, #EDF1F5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* 进度条 */
.progress-area {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 8rpx 24rpx 0;
}
.progress-track {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #C49A6B;
  transition: width 0.25s ease;
}
.progress-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #9AABBA;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* 滑动提示 */
.swipe-hint {
  text-align: center;
  margin-top: 8rpx;
  animation: fadeInOut 3s ease forwards;
}
.swipe-hint-text {
  font-size: 20rpx;
  color: #BCC8D4;
}
@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(-4rpx); }
  10% { opacity: 1; transform: translateY(0); }
  70% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4rpx); }
}

/* 答案图例 */
.answer-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #F7F6F2;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.legend-dot.correct {
  background: #6B9B6B;
}
.legend-dot.user-answer {
  background: #5B7B9A;
  margin-left: 12rpx;
}
.legend-label {
  font-size: 20rpx;
  color: #6B7B8D;
  line-height: 1;
}

/* 滑动动画 */
.slide-out-left {
  animation: slideOutLeft 0.12s ease;
}
.slide-out-right {
  animation: slideOutRight 0.12s ease;
}
.slide-in {
  animation: slideIn 0.12s ease;
}
.edge-left {
  animation: edgeShakeLeft 0.2s ease;
}
.edge-right {
  animation: edgeShakeRight 0.2s ease;
}

@keyframes slideOutLeft {
  to { transform: translateX(-30%); opacity: 0; }
}
@keyframes slideOutRight {
  to { transform: translateX(30%); opacity: 0; }
}
@keyframes slideIn {
  from { transform: translateX(30%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}
@keyframes edgeShakeLeft {
  25% { transform: translateX(-12rpx); }
  50% { transform: translateX(6rpx); }
  75% { transform: translateX(-3rpx); }
}
@keyframes edgeShakeRight {
  25% { transform: translateX(12rpx); }
  50% { transform: translateX(-6rpx); }
  75% { transform: translateX(3rpx); }
}
