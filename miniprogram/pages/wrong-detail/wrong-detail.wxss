@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  color: #15231A;
  overflow-x: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.page {
  min-height: 100vh;
  background: #F4F4EE;
  padding-bottom: 0;
  overflow-x: hidden;
}

/* loading */
.loading-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #F4F4EE;
}

.loading-hero-skeleton {
  height: 180rpx;
  padding: 38rpx 28rpx;
  box-sizing: border-box;
  background: #10251A;
}

.loading-hero-line,
.loading-line,
.loading-chip,
.loading-option {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E1E5DE, #F1F2ED, #E1E5DE);
  animation: skeletonPulse 1.2s ease-in-out infinite;
}

.loading-hero-line { background: rgba(255,255,255,.13); }
.loading-hero-line.short { width: 170rpx; height: 20rpx; }
.loading-hero-line.long { width: 380rpx; max-width: 78%; height: 30rpx; margin-top: 20rpx; }
.loading-question-card,
.loading-ai-card {
  margin: -20rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FBFBF7;
  border: 1rpx solid #DFE3DC;
  box-shadow: 0 14rpx 34rpx rgba(16,37,26,.06);
}
.loading-ai-card { margin-top: 18rpx; }
.loading-chip { width: 110rpx; height: 28rpx; }
.loading-line { height: 22rpx; margin-top: 18rpx; }
.loading-line.long { width: 94%; }
.loading-line.medium { width: 72%; }
.loading-line.short { width: 38%; }
.loading-option { height: 82rpx; margin-top: 15rpx; border-radius: 18rpx; background: #EEF0EB; }

/* error */
.error-state {
  min-height: calc(100vh - 120rpx);
  padding: 80rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #F4F4EE;
}
.error-mark { width: 108rpx; height: 108rpx; border-radius: 32rpx; background: #F0DED8; color: #B55B48; display: flex; align-items: center; justify-content: center; font-size: 55rpx; font-weight: 950; }
.error-kicker { margin-top: 30rpx; font-size: 19rpx; font-weight: 900; letter-spacing: 3rpx; color: #B05A45; }
.error-title { margin-top: 12rpx; font-size: 39rpx; line-height: 1.3; font-weight: 950; color: #142219; }
.error-desc { margin-top: 12rpx; max-width: 560rpx; font-size: 24rpx; line-height: 1.65; color: #737E75; }
.error-primary,
.error-secondary { width: 100%; max-width: 520rpx; min-height: 84rpx; border-radius: 22rpx; font-size: 27rpx; font-weight: 900; }
.error-primary { margin-top: 34rpx; background: #B7E82A; color: #10251A; }
.error-secondary { margin-top: 12rpx; background: #E9ECE6; color: #46534A; }

/* header context */
.detail-intro {
  padding: 28rpx 28rpx 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20rpx;
}
.detail-intro-kicker { display: block; font-size: 19rpx; font-weight: 900; letter-spacing: 2.5rpx; color: #7C887E; }
.detail-intro-title { display: block; margin-top: 8rpx; font-size: 34rpx; line-height: 1.3; font-weight: 950; color: #142219; }
.detail-intro-count { flex-shrink: 0; padding: 9rpx 14rpx; border-radius: 999rpx; background: #E8EBE5; color: #4D5A51; font-size: 20rpx; font-weight: 850; font-variant-numeric: tabular-nums; }

/* switch mask */
.switch-mask { position: fixed; inset: 0; z-index: 70; display: flex; align-items: center; justify-content: center; pointer-events: none; }
.switch-pill { padding: 13rpx 22rpx; border-radius: 999rpx; background: #10251A; color: rgba(255,255,255,.78); display: flex; align-items: center; gap: 10rpx; box-shadow: 0 14rpx 36rpx rgba(16,37,26,.24); font-size: 21rpx; }
.switch-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #B7E82A; animation: switchPulse .8s ease-in-out infinite; }

/* AI */
.ai-card {
  margin: 18rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #FBFBF7;
  border: 1rpx solid #DEE3DC;
  box-shadow: 0 14rpx 34rpx rgba(16,37,26,.06);
}
.ai-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.ai-head-copy { min-width: 0; }
.ai-kicker { display: block; font-size: 19rpx; font-weight: 900; letter-spacing: 3rpx; color: #728069; }
.ai-title { display: block; margin-top: 7rpx; font-size: 34rpx; line-height: 1.25; font-weight: 950; color: #15231A; }
.ai-subtitle { display: block; margin-top: 7rpx; font-size: 21rpx; line-height: 1.45; color: #879087; }
.ai-mark { width: 70rpx; height: 46rpx; padding: 0 13rpx; border-radius: 999rpx; background: #10251A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; gap: 7rpx; box-sizing: border-box; font-size: 19rpx; font-weight: 900; letter-spacing: 1rpx; flex-shrink: 0; }
.ai-mark-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #B7E82A; box-shadow: 0 0 0 7rpx rgba(183,232,42,.10); }

.ai-result-state { margin-top: 24rpx; display: flex; flex-direction: column; gap: 15rpx; }
.ai-section { position: relative; overflow: hidden; padding: 24rpx; border-radius: 24rpx; display: flex; align-items: flex-start; gap: 18rpx; border: 1rpx solid #E0E4DD; background: #F5F6F2; }
.ai-section.diagnosis { background: #F3E9DE; border-color: #E8D9C9; }
.ai-section.knowledge { background: #E9EDE1; border-color: #DBE1D2; }
.ai-section.task { background: #E6F0E8; border-color: #D5E4D8; }
.ai-section-index { width: 54rpx; height: 54rpx; border-radius: 18rpx; background: rgba(255,255,255,.66); color: #845738; display: flex; align-items: center; justify-content: center; font-size: 19rpx; font-weight: 950; font-variant-numeric: tabular-nums; flex-shrink: 0; }
.ai-section.knowledge .ai-section-index { color: #596B45; }
.ai-section.task .ai-section-index { color: #2A7650; }
.ai-section-copy { min-width: 0; flex: 1; }
.ai-section-kicker { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 2rpx; color: #9A7258; }
.ai-section.knowledge .ai-section-kicker { color: #71805F; }
.ai-section.task .ai-section-kicker { color: #5B836C; }
.ai-section-title { display: block; margin-top: 5rpx; margin-bottom: 12rpx; font-size: 27rpx; font-weight: 950; color: #1A281E; }
.ai-text,
.ai-rich-text { display: block; font-size: 26rpx; line-height: 1.76; color: #28362D; word-break: break-word; white-space: pre-wrap; }
.ai-hint,
.ai-inline-notice { display: block; text-align: center; margin-top: 5rpx; font-size: 20rpx; line-height: 1.45; color: #8A938C; }
.ai-inline-notice { color: #A26942; }
.ai-secondary-btn { width: 100%; min-height: 78rpx; margin-top: 2rpx; border-radius: 20rpx; background: #ECEFE9; color: #39483E; font-size: 24rpx; font-weight: 900; }
.ai-secondary-btn[disabled] { opacity: .52; }

.ai-regenerating-banner { padding: 13rpx 16rpx; border-radius: 16rpx; background: #F4EBDD; color: #9A6843; display: flex; align-items: center; gap: 10rpx; font-size: 21rpx; }
.loading-spinner { width: 42rpx; height: 42rpx; border: 4rpx solid #DDE1DA; border-top-color: #6E831F; border-radius: 50%; animation: spin .8s linear infinite; box-sizing: border-box; }
.loading-spinner.mini { width: 20rpx; height: 20rpx; border-width: 2rpx; }

.ai-idle { margin-top: 24rpx; padding: 30rpx 24rpx 8rpx; border-radius: 24rpx; background: #EEF1E9; text-align: center; display: flex; flex-direction: column; align-items: center; }
.ai-idle-curve { width: 250rpx; height: 110rpx; position: relative; margin-bottom: 20rpx; }
.idle-line { position: absolute; height: 4rpx; border-radius: 999rpx; background: #173426; transform-origin: left center; }
.il-1 { width: 64rpx; left: 12rpx; top: 76rpx; transform: rotate(-27deg); }
.il-2 { width: 69rpx; left: 69rpx; top: 47rpx; transform: rotate(20deg); }
.il-3 { width: 78rpx; left: 132rpx; top: 70rpx; transform: rotate(-34deg); background: #91B600; }
.idle-dot { position: absolute; width: 15rpx; height: 15rpx; border-radius: 50%; background: #EEF1E9; border: 4rpx solid #173426; box-sizing: border-box; }
.id-1 { left: 12rpx; top: 73rpx; }
.id-2 { left: 72rpx; top: 44rpx; }
.id-3 { left: 136rpx; top: 67rpx; }
.id-4 { left: 202rpx; top: 26rpx; border-color: #91B600; box-shadow: 0 0 0 11rpx rgba(145,182,0,.10); }
.ai-idle-title { font-size: 28rpx; font-weight: 950; line-height: 1.4; color: #173426; }
.ai-idle-desc { margin-top: 9rpx; max-width: 520rpx; font-size: 22rpx; line-height: 1.6; color: #7D887E; }
.ai-action-btn { width: 100%; min-height: 84rpx; margin-top: 24rpx; border-radius: 21rpx; background: #B7E82A; color: #10251A; font-size: 26rpx; font-weight: 950; box-shadow: 0 12rpx 28rpx rgba(103,139,0,.15); }

.ai-loading-state { margin-top: 20rpx; }
.ai-skeleton-section { padding: 22rpx; margin-top: 14rpx; border-radius: 22rpx; background: #F1F3EE; border: 1rpx solid #E1E5DE; }
.skeleton-title-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.skeleton-index { width: 48rpx; height: 48rpx; border-radius: 16rpx; background: #E0E4DD; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-title { width: 180rpx; height: 23rpx; border-radius: 999rpx; background: #E0E4DD; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-line { height: 20rpx; margin-top: 12rpx; border-radius: 999rpx; background: #E0E4DD; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-line.long { width: 94%; }
.skeleton-line.medium { width: 72%; }
.skeleton-line.short { width: 48%; }

.ai-fallback { margin-top: 24rpx; padding: 28rpx 18rpx 8rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }
.ai-fallback.inside { margin-top: 0; padding: 24rpx; border-radius: 22rpx; background: #F4E3DE; border: 1rpx solid #E8D0C8; }
.fallback-mark { width: 72rpx; height: 72rpx; border-radius: 24rpx; background: #F0DED8; color: #B45A46; display: flex; align-items: center; justify-content: center; font-size: 38rpx; font-weight: 950; }
.fallback-title { margin-top: 15rpx; font-size: 27rpx; font-weight: 950; color: #1B291F; }
.fallback-desc { margin-top: 8rpx; font-size: 22rpx; line-height: 1.55; color: #7D877F; }

/* fixed actions */
.page-bottom-space { height: 190rpx; }
.detail-bottom-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); background: #FBFBF7; border-top: 1rpx solid #DEE3DC; display: grid; grid-template-columns: 1fr 96rpx; gap: 12rpx; }
.master-action { min-width: 0; min-height: 88rpx; padding: 0 20rpx; border-radius: 23rpx; background: #B7E82A; color: #10251A; display: flex; align-items: center; gap: 14rpx; text-align: left; }
.master-action.is-mastered { background: #DFE8D4; color: #285D3D; }
.master-action[disabled] { opacity: 1; }
.master-action-icon { width: 46rpx; height: 46rpx; border-radius: 50%; background: #10251A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 900; flex-shrink: 0; }
.master-action.is-mastered .master-action-icon { background: #2E7E50; }
.master-action-copy { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.master-action-copy text:first-child { font-size: 26rpx; font-weight: 950; line-height: 1.3; }
.master-action-copy text:last-child { font-size: 18rpx; font-weight: 700; line-height: 1.35; opacity: .62; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.more-action { width: 96rpx; min-height: 88rpx; border-radius: 23rpx; background: #E9ECE6; color: #455249; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; }
.more-dots { font-size: 30rpx; line-height: 1; letter-spacing: 2rpx; }
.more-label { font-size: 18rpx; font-weight: 800; }

/* sheets */
.modal-overlay { position: fixed; inset: 0; z-index: 130; display: flex; align-items: flex-end; justify-content: center; background: rgba(5,13,8,.60); }
.decision-sheet,
.more-sheet { width: 100%; padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #FBFBF7; box-shadow: 0 -24rpx 60rpx rgba(0,0,0,.18); animation: sheetRise .22s ease-out both; }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 27rpx; border-radius: 999rpx; background: #D1D6CE; }
.decision-kicker { display: block; font-size: 19rpx; font-weight: 900; letter-spacing: 3rpx; color: #73806F; }
.decision-kicker.danger { color: #B35A46; }
.decision-title { display: block; margin-top: 9rpx; font-size: 38rpx; font-weight: 950; line-height: 1.25; color: #142219; }
.decision-desc { display: block; margin-top: 13rpx; font-size: 24rpx; line-height: 1.65; color: #707B73; }
.decision-actions { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.decision-primary,
.decision-secondary,
.decision-danger { height: 84rpx; min-height: 84rpx; padding: 0 20rpx; border-radius: 21rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 900; line-height: 1; }
.decision-primary { background: #B7E82A; color: #10251A; }
.decision-secondary { background: #ECEFE8; color: #445249; }
.decision-danger { background: #C25F4A; color: #FFFFFF; }
.more-sheet-title { display: block; font-size: 34rpx; font-weight: 950; color: #142219; }
.more-sheet-item { margin-top: 22rpx; min-height: 106rpx; padding: 0 22rpx; border-radius: 23rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; background: #F2E5E0; border: 1rpx solid #E8D3CB; }
.more-item-title { display: block; font-size: 27rpx; font-weight: 950; color: #A94E3A; }
.more-item-desc { display: block; margin-top: 6rpx; font-size: 20rpx; line-height: 1.45; color: #9A7568; }
.more-item-arrow { font-family: Arial,sans-serif; font-size: 44rpx; color: #B65B46; }
.more-cancel { width: 100%; min-height: 82rpx; margin-top: 14rpx; border-radius: 21rpx; background: #ECEFE8; color: #46534A; font-size: 26rpx; font-weight: 900; }

.undo-toast-layer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  z-index: 160;
  display: flex;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  transform: translateY(160%);
  opacity: 0;
  pointer-events: none;
  transition: transform .22s ease, opacity .22s ease;
}
.undo-toast-layer.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}
.undo-toast {
  flex: none;
  width: 458rpx;
  max-width: calc(100vw - 48rpx);
  min-height: 76rpx;
  padding: 0 14rpx 0 22rpx;
  border-radius: 999rpx;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 18rpx 42rpx rgba(16,37,26,.26);
}
.undo-toast-text {
  flex: 0 1 auto;
  min-width: 0;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255,255,255,.78);
}
.undo-divider {
  flex: 0 0 1rpx;
  width: 1rpx;
  height: 30rpx;
  margin: 0 16rpx;
  background: rgba(255,255,255,.16);
}
.undo-action {
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  height: 48rpx;
  min-height: 48rpx;
  margin: 0 !important;
  padding: 0 !important;
  border: 1rpx solid rgba(183,232,42,.72);
  border-radius: 999rpx;
  background: rgba(183,232,42,.08);
  color: #C8F14D;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1;
}
.undo-action::after { border: 0; }
.undo-action-pressed { background: rgba(183,232,42,.18); }

@keyframes skeletonPulse { 0%,100% { opacity: .5; } 50% { opacity: 1; } }
@keyframes switchPulse { 0%,100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1); } }
@keyframes sheetRise { from { transform: translateY(42rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 360px) {
  .detail-intro-title { font-size: 31rpx; }
  .master-action-copy text:last-child { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .loading-hero-line,
  .loading-line,
  .loading-chip,
  .loading-option,
  .skeleton-index,
  .skeleton-title,
  .skeleton-line,
  .switch-dot,
  .loading-spinner,
  .decision-sheet,
  .more-sheet { animation: none !important; }
  .undo-toast-layer { transition: none !important; }
}


/* ==================== Phase 2 detail-page polish ==================== */
.detail-intro {
  padding: 20rpx 28rpx 6rpx;
  align-items: center;
}
.detail-intro-title {
  margin-top: 5rpx;
  font-size: 31rpx;
}
.detail-intro-count {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
}
.loading-question-card,
.loading-ai-card,
.ai-card { border-radius: 32rpx; }
.ai-section { border-radius: 26rpx; }
.detail-bottom-actions {
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -14rpx 36rpx rgba(16,37,26,.07);
}
.master-action,
.more-action { border-radius: 25rpx; }
.decision-sheet,
.more-sheet { border-radius: 38rpx 38rpx 0 0; }

/* ==================== Master undo + AI button alignment ==================== */
.ai-action-btn {
  height: 84rpx;
  min-height: 84rpx;
  padding: 0 24rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.ai-action-btn::after { border: 0; }
.ai-generate-btn .ai-action-btn-label {
  display: block;
  line-height: 1;
  transform: translateY(2rpx);
}
