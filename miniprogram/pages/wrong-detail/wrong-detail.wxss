/* wrong-detail — 错题详情专属样式（Modern Learning App 蓝色主题） */
@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #EEF5FF;
  background-color: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  background-color: #EEF5FF;
  padding-bottom: 32rpx;
  overflow-x: hidden;
}

.swiper-content {
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.swiper-content.slide-out-left {
  transform: translateX(-25%);
  opacity: 0;
}

.swiper-content.slide-out-right {
  transform: translateX(25%);
  opacity: 0;
}

.swiper-content.from-left {
  transform: translateX(-25%);
  opacity: 0;
  transition: none;
}

.swiper-content.from-right {
  transform: translateX(25%);
  opacity: 0;
  transition: none;
}

.swiper-content.edge-left {
  transform: translateX(-3%);
  transition: transform 0.2s ease;
}

.swiper-content.edge-right {
  transform: translateX(3%);
  transition: transform 0.2s ease;
}

/* AI 分析卡片 */
.ai-card {
  margin: 14rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

/* AI 分析 */
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-head.compact {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.section-chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 38rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}


.ai-text {
  display: block;
  font-size: 27rpx;
  color: #18233A;
  line-height: 1.7;
  white-space: pre-wrap;
}

.ai-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8EA0BA;
  margin-top: 18rpx;
}

.ai-idle {
  padding: 26rpx 18rpx;
  border-radius: 20rpx;
  background: #F6F9FF;
  text-align: center;
}

.ai-action-btn,
.ai-secondary-btn {
  margin-top: 22rpx;
  width: 100%;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: normal;
}

.ai-action-btn {
  color: #FFFFFF;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 12rpx 26rpx rgba(79, 127, 255, 0.22);
}

.ai-action-btn.retry {
  margin-top: 22rpx;
}

.ai-secondary-btn {
  color: #4F7FFF;
  background: #E8F0FF;
}

.ai-secondary-btn.loading,
.ai-secondary-btn[disabled] {
  opacity: 0.6;
}

.ai-action-btn::after,
.ai-secondary-btn::after {
  border: none;
}

.ai-action-btn:active,
.ai-secondary-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.ai-result-state {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.ai-section {
  margin-top: 0;
  padding: 22rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #FFFFFF 100%);
  border-radius: 22rpx;
  border: 1rpx solid #E2EAF7;
  box-shadow: 0 6rpx 18rpx rgba(42, 84, 160, 0.06);
  position: relative;
  overflow: hidden;
}

.ai-section::before {
  content: '';
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
}

.ai-label-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.ai-index {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ai-label {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.3;
}

.ai-label-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #8EA0BA;
}

.ai-text,
.ai-rich-text {
  display: block;
  font-size: 27rpx;
  color: #18233A;
  line-height: 1.75;
  word-break: break-word;
}

.ai-section-diagnosis .ai-index {
  background: #FFF7E8;
  color: #F59E0B;
}

.ai-section-diagnosis::before {
  background: #F59E0B;
}

.ai-section-knowledge .ai-index {
  background: #EEF4FF;
  color: #4F7FFF;
}

.ai-section-knowledge::before {
  background: #4F7FFF;
}

.ai-section-task .ai-index {
  background: #ECFDF3;
  color: #22C55E;
}

.ai-section-task::before {
  background: #22C55E;
}

/* 重新生成中的提示条 — 不改变布局 */
.ai-regenerating-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 18rpx;
  background: #FFF7E8;
  border-radius: 14rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.ai-regenerating-text {
  font-size: 22rpx;
  color: #B87509;
  font-weight: 600;
  line-height: 1.35;
}

/* 底部行内提示 — 不改变布局 */
.ai-inline-notice {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #F59E0B;
  margin-top: 14rpx;
  line-height: 1.4;
}

.ai-idle.minimal {
  padding: 28rpx 0 8rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ai-idle.minimal .ai-action-btn {
  width: 360rpx;
  margin: 0 auto;
}

/* ===== 骨架屏 ===== */
.ai-loading-state {
  display: block;
  min-height: 520rpx;
}

.ai-skeleton-section {
  padding: 22rpx;
  border-radius: 20rpx;
  background: #F8FAFF;
  border: 1rpx solid #E2EAF7;
  margin-top: 18rpx;
}

.skeleton-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.skeleton-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #EDF3FF 0%, #F8FAFF 50%, #EDF3FF 100%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.3s linear infinite;
}

.skeleton-title {
  width: 180rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #EDF3FF 0%, #F8FAFF 50%, #EDF3FF 100%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.3s linear infinite;
}

.skeleton-line {
  height: 22rpx;
  border-radius: 999rpx;
  margin-top: 12rpx;
  background: linear-gradient(90deg, #EDF3FF 0%, #F8FAFF 50%, #EDF3FF 100%);
  background-size: 200% 100%;
  animation: skeletonShimmer 1.3s linear infinite;
}

.skeleton-line.long { width: 92%; }
.skeleton-line.medium { width: 72%; }
.skeleton-line.short { width: 48%; }

@keyframes skeletonShimmer {
  0% { opacity: 0.55; }
  50% { opacity: 1; }
  100% { opacity: 0.55; }
}

.ai-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28rpx 12rpx;
}

.fallback-mark {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.fallback-mark .line-icon {
  width: 36rpx;
  height: 36rpx;
  color: #4F7FFF;
}

.fallback-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #18233A;
}

.fallback-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8EA0BA;
}

.loading-wrap {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E2EAF7;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
}

.loading-spinner.mini {
  width: 20rpx;
  height: 20rpx;
  border-width: 2rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #8EA0BA;
  margin-top: 16rpx;
}

/* 切换加载态 — 轻量文字提示，不影响布局 */
.switch-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.switch-mask-text {
  font-size: 22rpx;
  color: #8EA0BA;
  background: rgba(255,255,255,0.85);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 16rpx rgba(42, 84, 160, 0.08);
}

@media (prefers-reduced-motion: reduce) {
  .loading-spinner,
  .loading-spinner.small,
  .loading-spinner.mini {
    animation: none !important;
  }
  .skeleton-index,
  .skeleton-title,
  .skeleton-line {
    animation: none !important;
    background: #E2EAF7 !important;
  }
}

/* Error state */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 48rpx 40rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.error-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #FEF2F2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.35;
  text-align: center;
  margin-bottom: 8rpx;
}

.error-desc {
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
  margin-bottom: 36rpx;
}

.error-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
  max-width: 400rpx;
}

.error-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: normal;
  border: none;
}

.error-btn::after { border: none; }

.error-btn.primary {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
}

.error-btn.secondary {
  background: #E8F0FF;
  color: #4F7FFF;
}

.error-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}
