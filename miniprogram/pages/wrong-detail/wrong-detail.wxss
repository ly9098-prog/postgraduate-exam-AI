/* wrong-detail — 错题详情专属样式（Modern Learning App 蓝色主题） */
@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding-bottom: 48rpx;
  overflow-x: hidden;
}

.swiper-content {
  transition: transform 0.18s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.18s cubic-bezier(0.22, 1, 0.36, 1);
}

.swiper-content.slide-out-left {
  transform: translateX(-25%);
  opacity: 0;
}

.swiper-content.slide-out-right {
  transform: translateX(25%);
  opacity: 0;
}

.swiper-content.from-left {
  transform: translateX(-25%);
  opacity: 0;
  transition: none;
}

.swiper-content.from-right {
  transform: translateX(25%);
  opacity: 0;
  transition: none;
}

.swiper-content.edge-left {
  transform: translateX(-3%);
  transition: transform 0.2s ease;
}

.swiper-content.edge-right {
  transform: translateX(3%);
  transition: transform 0.2s ease;
}

.detail-card,
.ai-card {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}

.subject-tag,
.error-type-tag,
.tag {
  display: inline-block;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
}

.subject-tag {
  background: #EEF4FF;
  color: #4F7FFF;
}

.error-type-tag,
.tag {
  background: #FFF7E8;
  color: #F59E0B;
}

.tag-success {
  background: #ECFDF3;
  color: #22C55E;
}

.question-block {
  padding: 18rpx 0;
}

.q-text {
  display: block;
  font-size: 30rpx;
  line-height: 1.72;
  color: #18233A;
  white-space: pre-wrap;
  word-break: break-word;
}

.options-list {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E2EAF7;
  border-radius: 12rpx;
  overflow: hidden;
}

.blank-options {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #E2EAF7;
}

.blank-group {
  padding: 18rpx 0;
}

.blank-group + .blank-group {
  border-top: 1rpx dashed #E2EAF7;
}

.blank-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.blank-group-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #4F7FFF;
}

.blank-group-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.option-line,
.blank-option-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}

.blank-option-item {
  padding: 16rpx 14rpx;
  border-radius: 18rpx;
  background: #F6F9FF;
  align-items: flex-start;
  border: 2rpx solid transparent;
}

.blank-option-item.correct {
  background: #ECFDF3;
  border: 2rpx solid #22C55E;
}

.blank-option-item.correct .option-key {
  color: #22C55E;
}

.blank-option-item.user-answer {
  background: #EEF4FF;
  border: 2rpx solid #4F7FFF;
}

.blank-option-item.user-answer .option-key {
  color: #4F7FFF;
}

.option-body {
  flex: 1;
  min-width: 0;
  color: #18233A;
  word-break: break-word;
}

.option-key {
  color: #4F7FFF;
  font-weight: 800;
  flex-shrink: 0;
}

.option-text,
.option-value {
  display: inline;
  color: inherit;
  word-break: break-word;
}

.option-line.correct {
  background: #ECFDF3;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.option-line.user-answer {
  background: #EEF4FF;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
}

.option-value.right {
  color: #22C55E;
  font-weight: 800;
}

.option-value.wrong {
  color: #4F7FFF;
  font-weight: 800;
}

.option-line:active {
  background: #EEF4FF;
}

.blank-option-item:active {
  background: #EEF4FF;
  border-color: #D0D5DD;
}

.blank-option-item.correct:active {
  background: #D1FAE0;
}

.blank-option-item.user-answer:active {
  background: #D4E4FF;
}

/* AI 分析 */
.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-head.compact {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #8EA0BA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ai-section {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #F6F9FF;
  border-radius: 20rpx;
}

.ai-label {
  font-size: 25rpx;
  font-weight: 800;
  color: #4F7FFF;
  display: block;
  margin-bottom: 8rpx;
}

.ai-text {
  display: block;
  font-size: 27rpx;
  color: #18233A;
  line-height: 1.7;
  white-space: pre-wrap;
}

.ai-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #8EA0BA;
  margin-top: 18rpx;
}

.ai-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 28rpx 12rpx;
}

.fallback-mark {
  width: 82rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.fallback-mark .line-icon {
  width: 36rpx;
  height: 36rpx;
  color: #4F7FFF;
}

.fallback-title {
  font-size: 29rpx;
  font-weight: 800;
  color: #18233A;
}

.fallback-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8EA0BA;
}

.loading-wrap {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E2EAF7;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
}

.loading-spinner.mini {
  width: 20rpx;
  height: 20rpx;
  border-width: 2rpx;
}

.chip-loading {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
}
.chip-loading-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #617089;
  line-height: 1.35;
}

.ai-loading-skeleton {
  padding: 18rpx;
  background: #F6F9FF;
  border-radius: 20rpx;
}
.skeleton-block {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E2EAF7 25%, #D5DFF0 50%, #E2EAF7 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.loading-text {
  font-size: 26rpx;
  color: #8EA0BA;
  margin-top: 16rpx;
}

/* 进度条 */
.progress-area {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx 0;
}
.progress-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #4F7FFF;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}
.progress-track {
  flex: 1;
  height: 4rpx;
  border-radius: 999rpx;
  background: #E2EAF7;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4F7FFF;
  transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 滑动提示 */
.swipe-hint {
  text-align: center;
  margin-top: 8rpx;
  animation: fadeInOut 3s ease forwards;
}
.swipe-hint-text {
  font-size: 20rpx;
  color: #8EA0BA;
}
@keyframes fadeInOut {
  0% { opacity: 0; transform: translateY(-4rpx); }
  10% { opacity: 1; transform: translateY(0); }
  70% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-4rpx); }
}

/* 答案图例 */
.answer-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-top: 18rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #F6F9FF;
}
.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}
.legend-dot.correct {
  background: #22C55E;
}
.legend-dot.user-answer {
  background: #4F7FFF;
  margin-left: 12rpx;
}
.legend-label {
  font-size: 20rpx;
  color: #617089;
  line-height: 1;
}

@media (prefers-reduced-motion: reduce) {
  .swiper-content,
  .swiper-content.slide-out-left,
  .swiper-content.slide-out-right,
  .swiper-content.from-left,
  .swiper-content.from-right,
  .swiper-content.edge-left,
  .swiper-content.edge-right {
    transition: none !important;
    transform: none !important;
    opacity: 1 !important;
  }
  .loading-spinner,
  .loading-spinner.small,
  .loading-spinner.mini {
    animation: none !important;
  }
  .skeleton-block {
    animation: none !important;
    background: #E2EAF7 !important;
  }
  .swipe-hint {
    animation: none !important;
    opacity: 1 !important;
  }
  .progress-fill {
    transition: none !important;
  }
}

/* ==================== Code block (CODE render mode) ==================== */
.code-block {
  white-space: pre-wrap;
  font-family: 'Courier New', Courier, monospace;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  overflow-x: auto;
}
