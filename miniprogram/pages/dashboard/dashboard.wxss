  color: #FFFFFF;
}
.api-content {
  flex: 1;
  min-width: 0;
}
.api-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
  line-height: 1.3;
}
.api-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.4;
}
.api-arrow {
  width: 28rpx;
  height: 28rpx;
  color: var(--text-hint, #8EA0BA);
  flex-shrink: 0;
}

/* ════════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════════ */
@media screen and (max-width: 370px) {
  .hero-stats { gap: 8rpx; }
  .hero-stat-val { font-size: 32rpx; }
  .risk-grid { gap: 10rpx; }
  .yearly-stats { gap: 10rpx; }
  .subject-chart-area { flex-direction: column; }
  .subject-donut-wrap { width: 100%; flex-direction: row; gap: 16rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .dashboard-page.ready,
  .motion-card-enter,
  .tab-btn {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
