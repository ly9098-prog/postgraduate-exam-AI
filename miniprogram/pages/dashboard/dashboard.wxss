@import '../../styles/tokens.wxss';

/* ── Page ── */
.dashboard-page {
  min-height: 100vh;
  background: var(--bg-page, linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%));
  padding: 0 20rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
}
.dashboard-page.ready {
  animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

/* Background refresh bar */
.bg-refresh-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  margin-bottom: 8rpx;
}
.bg-refresh-text {
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
  animation: bg-pulse 1.2s ease-in-out infinite;
}
@keyframes bg-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ── Section ── */
.dashboard-section { margin-bottom: 32rpx; }
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 6rpx;
}
.section-head-left { min-width: 0; }
.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--text-primary, #18233A);
}
.section-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
  line-height: 1.4;
}

/* ── Tab Switch ── */
.tab-switch {
  display: flex;
  background: var(--bg-surface, #F6F9FF);
  border-radius: 999rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.tab-btn {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary, #617089);
  border-radius: 999rpx;
  transition: all 0.25s ease;
}
.tab-btn.active {
  background: #FFFFFF;
  color: var(--text-primary, #18233A);
  box-shadow: 0 2rpx 8rpx rgba(42, 84, 160, 0.08);
}

/* ════════════════════════════════════════════
   LOADING / ERROR / EMPTY
   ════════════════════════════════════════════ */
.dashboard-loading,
.dashboard-error,
.dashboard-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 60rpx 20rpx;
}
.loading-skeleton {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.sk-hero {
  height: 320rpx;
  border-radius: 36rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-card {
  height: 160rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-chart {
  height: 280rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer {
  from { background-position: -200% 0; }
  to { background-position: 200% 0; }
}
.error-card { text-align: center; }
.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #18233A);
}
.error-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #617089);
}
.error-action { margin-top: 32rpx; }
.empty-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: var(--primary-light, #EEF4FF);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.empty-icon-wrap .line-icon {
  width: 40rpx;
  height: 40rpx;
  color: var(--primary, #4F7FFF);
}
.empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  text-align: center;
}
.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-hint, #8EA0BA);
  text-align: center;
}
.empty-action { margin-top: 32rpx; }

/* ════════════════════════════════════════════
   HERO
   ════════════════════════════════════════════ */
.hero-section {
  position: relative;
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 56%, #8AAFC8 100%);
  border-radius: 36rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  overflow: hidden;
  margin-bottom: 28rpx;
}
.hero-glow {
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.hero-content {
  position: relative;
  z-index: 1;
  padding: 28rpx 24rpx 30rpx;
}
.hero-top { margin-bottom: 24rpx; }
.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.3;
}
.hero-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.5;
}
.hero-metrics {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}
.hero-metric {
  width: 164rpx;
  height: 164rpx;
  position: relative;
  flex-shrink: 0;
}
.hero-ring-canvas {
  width: 164rpx;
  height: 164rpx;
}
.hero-ring-center {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.hero-ring-pct {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #FFFFFF;
  font-variant-numeric: tabular-nums;
}
.hero-ring-sym { font-size: 20rpx; color: rgba(255, 255, 255, 0.7); }
.hero-ring-label {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}
.hero-stats {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.hero-stat-item {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.hero-stat-val {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.hero-stat-unit { font-size: 20rpx; color: rgba(255, 255, 255, 0.7); }
.hero-stat-unit-sm { font-size: 20rpx; color: rgba(255, 255, 255, 0.7); }
.hero-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}
.hero-stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 1rpx;
  flex-shrink: 0;
}
.hero-actions {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.hero-action-primary {
  flex: 1;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: var(--primary, #4F7FFF);
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.hero-action-secondary {
  flex: 0.6;
  padding: 22rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.primary-action {
  display: inline-flex;
  padding: 22rpx 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 127, 255, 0.28);
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.primary-action-pressed { transform: scale(0.97); opacity: 0.88; }
.secondary-action-pressed { transform: scale(0.97); opacity: 0.8; }

/* ════════════════════════════════════════════
   INSIGHT
   ════════════════════════════════════════════ */
.insight-card {
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.insight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.insight-priority-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-light, #EEF4FF);
  color: var(--primary, #4F7FFF);
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.3;
}
.insight-priority-tag.tag-wrong {
  background: var(--danger-light, #FEF2F2);
  color: var(--danger, #EF4444);
}
.insight-priority-tag.tag-subject {
  background: var(--warning-light, #FFF7E8);
  color: var(--warning, #F59E0B);
}
.insight-priority-tag.tag-keep {
  background: var(--success-light, #ECFDF3);
  color: var(--success, #22C55E);
}
.insight-priority-tag.tag-empty {
  background: var(--bg-surface, #F6F9FF);
  color: var(--text-hint, #8EA0BA);
}
.insight-arrow {
  width: 36rpx;
  height: 36rpx;
  color: var(--text-hint, #8EA0BA);
}
.insight-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary, #18233A);
  line-height: 1.3;
  margin-bottom: 8rpx;
}
.insight-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.5;
}
.insight-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.insight-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--bg-surface, #F6F9FF);
  color: var(--text-secondary, #617089);
  font-size: 20rpx;
  font-weight: 600;
}

/* ════════════════════════════════════════════
   TRENDS
   ════════════════════════════════════════════ */
.trend-card { padding: 24rpx; }
.trend-chart-wrap {
  height: 260rpx;
  margin: 0 -4rpx;
}
.trend-canvas {
  width: 100%;
  height: 260rpx;
}
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
.trend-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #617089);
}
.trend-legend-bar {
  width: 20rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: rgba(79, 127, 255, 0.32);
}
.trend-legend-line {
  width: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(34, 197, 94, 0.72);
}
.trend-error-text {
  font-size: 26rpx;
  color: var(--text-secondary, #617089);
}
.trend-error-action {
  margin-top: 16rpx;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--bg-surface, #F6F9FF);
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
  min-height: 44px;
  display: flex;
  align-items: center;
}
.trend-meta {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color, #E2EAF7);
}
.trend-meta-item { text-align: center; }
.trend-meta-val {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  color: var(--text-primary, #18233A);
  font-variant-numeric: tabular-nums;
}
.trend-meta-val.green { color: var(--success, #22C55E); }
.trend-meta-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-hint, #8EA0BA);
}
.trend-meta-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #617089);
}
.trend-summary {
  display: block;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(79, 127, 255, 0.08);
  color: var(--text-secondary, #617089);
  font-size: 22rpx;
  line-height: 1.5;
}

.trend-container {
  position: relative;
  min-height: 420rpx;
  overflow: hidden;
}
.trend-loading-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 30rpx;
}
.trend-error-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-card, #FFFFFF);
  border-radius: 30rpx;
}

/* ════════════════════════════════════════════
   SUBJECTS — donut + card list (no progress bars)
   ════════════════════════════════════════════ */
.subject-summary-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.subject-summary-item {
  flex: 1;
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(79, 127, 255, 0.08);
  text-align: center;
}
.subject-summary-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  margin-bottom: 6rpx;
}
.subject-summary-val {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-primary, #18233A);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-summary-val.warn { color: var(--warning, #F59E0B); }

.subject-chart-area {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}
.subject-donut-wrap {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.subject-donut-canvas {
  width: 140rpx;
  height: 140rpx;
}
.subject-donut-label {
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  text-align: center;
}
.subject-card-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}
.subject-card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  min-height: 88rpx;
  -webkit-tap-highlight-color: transparent;
}
.sci-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex: 1;
}
.sci-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.sci-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sci-meta {
  display: block;
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  line-height: 1.3;
  margin-top: 2rpx;
}
.sci-pct {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  margin-left: 12rpx;
}
.sci-pct.green { color: var(--success, #22C55E); }
.sci-pct.orange { color: var(--warning, #F59E0B); }
.sci-pct.red { color: var(--danger, #EF4444); }

/* ════════════════════════════════════════════
   REVIEW RISK
   ════════════════════════════════════════════ */
.risk-grid {
  display: flex;
  gap: 14rpx;
  margin-bottom: 16rpx;
}
.risk-item {
  flex: 1;
  padding: 20rpx 12rpx;
  background: var(--bg-card, #FFFFFF);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid var(--border-color, #E2EAF7);
  text-align: center;
}
.risk-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  margin-bottom: 6rpx;
}
.risk-num.danger { color: var(--danger, #EF4444); }
.risk-num.warning { color: var(--warning, #F59E0B); }
.risk-num.primary { color: var(--primary, #4F7FFF); }
.risk-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-primary, #18233A);
}
.risk-topics { padding: 20rpx 24rpx; margin-bottom: 12rpx; }
.risk-topics-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #18233A);
  margin-bottom: 12rpx;
}
.risk-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.risk-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--danger-light, #FEF2F2);
  color: var(--danger, #EF4444);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.4;
}
.risk-cta-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-card, #FFFFFF);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid var(--border-color, #E2EAF7);
  min-height: 44px;
}
.risk-cta {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
}
.risk-cta-wrap .line-icon {
  width: 28rpx;
  height: 28rpx;
  color: var(--text-hint, #8EA0BA);
}
.risk-free-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}
.risk-free-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  color: var(--success, #22C55E);
}
.risk-free-copy { flex: 1; }
.risk-free-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
}
.risk-free-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
}

/* ════════════════════════════════════════════
   MASTERY GAUGE — semi-gauge replaces progress bar
   ════════════════════════════════════════════ */
.mastery-gauge-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.mastery-gauge-layout {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mastery-gauge-chart {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
}
.mastery-gauge-canvas {
  width: 140rpx;
  height: 140rpx;
}
.mastery-gauge-info { flex: 1; min-width: 0; }
.mastery-gauge-pct {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: var(--primary, #4F7FFF);
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.mastery-gauge-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  margin-top: 4rpx;
}
.mastery-gauge-status {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: var(--primary-light, #EEF4FF);
  color: var(--primary, #4F7FFF);
}
.mastery-gauge-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
}

/* ════════════════════════════════════════════
   GROWTH — ring chart replaces progress bar
   ════════════════════════════════════════════ */
.growth-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.growth-level-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}
.growth-level-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
