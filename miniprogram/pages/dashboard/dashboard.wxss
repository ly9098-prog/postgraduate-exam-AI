/* ════════════════════════════════════════════
   LLM ANALYSIS
   ════════════════════════════════════════════ */
.llm-card {
  padding: 28rpx;
  text-align: center;
  margin-bottom: 28rpx;
}
.llm-card-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #617089);
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.llm-generate-btn {
  display: inline-flex;
  height: 80rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 127, 255, 0.28);
}
.llm-loading-wrap { padding: 20rpx 0; }
.llm-loading-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary, #617089);
  margin-bottom: 20rpx;
}
.llm-loading-bar {
  width: 120rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #4F7FFF, #6EC1FF, #4F7FFF);
