@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

/* Hero */
.dashboard-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #EDF1F5 100%);
  color: #2D3E50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  overflow: hidden;
  position: relative;
}

.dashboard-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #C49A6B;
  opacity: 0.42;
}

.dashboard-hero::after {
  content: '';
  position: absolute;
  right: -46rpx;
  top: -54rpx;
  width: 188rpx;
  height: 188rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  font-size: 21rpx;
  line-height: 1.35;
  color: #5B7B9A;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.hero-score-card {
  width: 172rpx;
  height: 172rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
}

.score-ring-canvas {
  width: 172rpx;
  height: 172rpx;
}

.score-center {
  position: absolute;
  left: 30rpx;
  top: 30rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-num {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.score-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6B7B8D;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* KPI */
.kpi-strip {
  margin: 0 24rpx 18rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: stretch;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.05);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.kpi-item {
  flex: 1;
  min-width: 0;
  min-height: 98rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}

.kpi-item.emphasis {
  background: #F7F6F2;
}

.kpi-divider {
  width: 1rpx;
  background: #E8E5E0;
  margin: 8rpx 8rpx;
}

.kpi-value {
  max-width: 100%;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-value.compact { font-size: 28rpx; line-height: 1.45; }
.kpi-value.warning { color: #C49A6B; }

.kpi-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

/* Shared cards */
.chart-card,
.risk-panel {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-head.in-card { margin-bottom: 24rpx; }

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

/* Today */
.today-card { background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%); }

.today-metrics {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.today-metric {
  min-height: 136rpx;
  padding: 20rpx 20rpx 18rpx;
  border-radius: 22rpx;
  background: #F7F6F2;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
}

.today-metric.primary { background: #EDF1F5; }
.today-metric.success { background: #EFF5EF; }
.today-metric.warning { background: #F5F1EB; }
.today-metric.muted { background: #F3F2EF; }

.today-kicker {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  line-height: 1.3;
  color: #6B7B8D;
  font-weight: 700;
}

.today-num {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.today-num.small { font-size: 30rpx; line-height: 1.42; }
.today-metric.success .today-num { color: #6B9B6B; }
.today-metric.warning .today-num { color: #C49A6B; }
.today-metric.muted .today-num { color: #6B7B8D; }

.today-label {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6B7B8D;
}

/* Donut */
.subject-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FCFBF8 100%);
}

.donut-layout {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.donut-wrap {
  width: 256rpx;
  height: 256rpx;
  position: relative;
  flex-shrink: 0;
}

.donut-canvas {
  width: 256rpx;
  height: 256rpx;
}

.donut-center {
  position: absolute;
  left: 72rpx;
  top: 72rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.08);
}

.donut-total {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #2D3E50;
  font-variant-numeric: tabular-nums;
}

.donut-label {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9AABBA;
}

.subject-legend {
  flex: 1;
  min-width: 0;
}

.subject-row {
  display: flex;
  align-items: center;
  min-height: 62rpx;
  margin: 10rpx 0;
  padding: 8rpx 0;
}

.legend-mark {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.subject-main {
  flex: 1;
  min-width: 0;
}

.subject-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.subject-name {
  display: block;
  font-size: 25rpx;
  font-weight: 700;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-share {
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: #F3F2EF;
  font-size: 18rpx;
  line-height: 1.35;
  color: #6B7B8D;
  font-weight: 700;
}

.subject-meta {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  color: #9AABBA;
}

.subject-acc {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.subject-acc.green { color: #6B9B6B; }
.subject-acc.orange { color: #C49A6B; }
.subject-acc.red { color: #C47A7A; }

.subject-bars {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #EDF1F5;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.subject-bar-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.subject-bar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.subject-bar-name,
.subject-bar-count {
  font-size: 22rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.subject-bar-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-bar-count {
  flex-shrink: 0;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.subject-bar-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  overflow: hidden;
}

.subject-bar-fill {
  height: 100%;
  min-width: 10rpx;
  border-radius: 999rpx;
}

/* Line + timeline */
.trend-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FBFCFB 100%);
}

.trend-legend-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: -8rpx 0 16rpx;
}

.trend-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-legend-mark {
  width: 22rpx;
  height: 6rpx;
  border-radius: 999rpx;
}

.trend-legend-mark.primary { background: #5B7B9A; }
.trend-legend-mark.success { background: #6B9B6B; }

.trend-legend-text {
  font-size: 21rpx;
  color: #6B7B8D;
}

.line-chart-wrap {
  height: 288rpx;
  background: linear-gradient(180deg, #FAFBFC 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  border: 1rpx solid #EDF1F5;
  overflow: hidden;
}

.line-canvas {
  width: 100%;
  height: 288rpx;
}

.trend-summary-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.trend-summary-card {
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  background: #EDF1F5;
  text-align: center;
}

.trend-summary-card.success { background: #EFF5EF; }
.trend-summary-card.warning { background: #F5F1EB; }

.trend-summary-kicker {
  display: block;
  margin-bottom: 6rpx;
  font-size: 19rpx;
  line-height: 1.3;
  color: #6B7B8D;
  font-weight: 700;
}

.trend-summary-value {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trend-summary-card.success .trend-summary-value { color: #6B9B6B; }
.trend-summary-card.warning .trend-summary-value { color: #C49A6B; }

.trend-summary-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6B7B8D;
}

.trend-timeline {
  position: relative;
  display: flex;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 26rpx;
  padding-top: 20rpx;
}

.trend-timeline::before {
  content: '';
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 30rpx;
  height: 2rpx;
  background: #E8E5E0;
}

.trend-day {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-date,
.trend-num {
  font-size: 20rpx;
  color: #9AABBA;
  white-space: nowrap;
}

.trend-date {
  margin-bottom: 8rpx;
}

.trend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #5B7B9A;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 2rpx #EDF1F5;
  margin-bottom: 10rpx;
}

.trend-dot.green { background: #6B9B6B; box-shadow: 0 0 0 2rpx #EFF5EF; }
.trend-dot.orange { background: #C49A6B; box-shadow: 0 0 0 2rpx #F5F1EB; }
.trend-dot.red { background: #C47A7A; box-shadow: 0 0 0 2rpx #F5EFEF; }

.trend-acc {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.trend-acc.green { color: #6B9B6B; }
.trend-acc.orange { color: #C49A6B; }
.trend-acc.red { color: #C47A7A; }

/* Behavior bars */
.behavior-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
}

.behavior-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.behavior-time-card {
  min-height: 108rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  background: #F7F6F2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.behavior-row {
  display: flex;
  flex-direction: column;
}

.behavior-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.behavior-label {
  display: block;
  font-size: 26rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.behavior-label.strong {
  color: #2D3E50;
  font-weight: 700;
}

.behavior-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.4;
  color: #9AABBA;
}

.behavior-value,
.behavior-time-value {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 800;
  color: #2D3E50;
  font-variant-numeric: tabular-nums;
}

.behavior-time-value {
  color: #5B7B9A;
}

.behavior-value.danger { color: #C47A7A; }

.hbar-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  overflow: hidden;
}

.hbar-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
}

.hbar-fill.primary { background: #5B7B9A; }
.hbar-fill.danger { background: #C47A7A; }

/* Risk */
.risk-panel {
  background: #fff;
}

.risk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14rpx;
}

.risk-card {
  min-height: 178rpx;
  border-radius: 22rpx;
  padding: 18rpx 10rpx;
  text-align: center;
}

.risk-card.danger { background: #F5EFEF; }
.risk-card.warning { background: #F5F1EB; }
.risk-card.primary { background: #EDF1F5; }

.risk-priority {
  display: inline-block;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 18rpx;
  line-height: 1.3;
  color: #6B7B8D;
  font-weight: 700;
}

.risk-num {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.risk-card.danger .risk-num { color: #C47A7A; }
.risk-card.warning .risk-num { color: #C49A6B; }

.risk-label {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #2D3E50;
}

.risk-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

/* Empty */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin: 18rpx 24rpx 0;
  padding: 48rpx 28rpx;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 6rpx 24rpx rgba(43, 60, 80, 0.05);
}

.empty-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #6B7B8D;
}

.empty-desc {
  font-size: 24rpx;
  color: #9AABBA;
  margin-top: 8rpx;
  line-height: 1.5;
}
