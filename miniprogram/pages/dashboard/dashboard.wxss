@import '../../styles/tokens.wxss';

/* ── Page ── */
.dashboard-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 90% 2%, rgba(79, 127, 255, 0.07), transparent 220rpx),
    radial-gradient(circle at 4% 18%, rgba(110, 193, 255, 0.05), transparent 200rpx),
    linear-gradient(180deg, #F8FAFF 0%, #F2F6FC 100%);
  padding: 0 20rpx calc(32rpx + env(safe-area-inset-bottom));
  opacity: 0;
}
.dashboard-page.ready {
  animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
}

/* Background refresh bar */
.bg-refresh-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  margin-bottom: 8rpx;
}
.bg-refresh-text {
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
  animation: bg-pulse 1.2s ease-in-out infinite;
}
@keyframes bg-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* ── Section ── */
.dashboard-section { margin-bottom: 32rpx; }
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 6rpx;
}
.section-head-left {
  min-width: 0;
}
.section-head-icon-wrap {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}
.section-head-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.16), rgba(110, 193, 255, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}
.section-head-icon .line-icon {
  width: 20rpx;
  height: 20rpx;
  color: #4F7FFF;
}
.section-more {
  flex-shrink: 0;
  font-size: 21rpx;
  color: var(--primary, #4F7FFF);
  font-weight: 600;
  padding: 6rpx 0;
}
.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.3;
  color: var(--text-primary, #18233A);
}
.section-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
  line-height: 1.4;
}

/* ── Trend Head ── */
.trend-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
  gap: 12rpx;
}
.trend-head-text {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary, #18233A);
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── Tab Switch ── */
.tab-switch {
  display: flex;
  background: var(--bg-surface, #F6F9FF);
  border-radius: 999rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.tab-btn {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary, #617089);
  border-radius: 999rpx;
  transition: all 0.25s ease;
}
.tab-btn.active {
  background: #FFFFFF;
  color: var(--text-primary, #18233A);
  box-shadow: 0 2rpx 8rpx rgba(42, 84, 160, 0.08);
}

/* ════════════════════════════════════════════
   LOADING / ERROR / EMPTY
   ════════════════════════════════════════════ */
.dashboard-loading,
.dashboard-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 60rpx 20rpx;
}
.loading-skeleton {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.sk-header {
  height: 68rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-card {
  height: 160rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-card-tall {
  height: 260rpx;
  border-radius: 28rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-card-short {
  height: 140rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
.sk-chart {
  height: 280rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #E8EEF8 25%, #F3F7FF 50%, #E8EEF8 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer {
  from { background-position: -200% 0; }
  to { background-position: 200% 0; }
}
.error-card { text-align: center; }
.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-primary, #18233A);
}
.error-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary, #617089);
}
.error-action { margin-top: 32rpx; }
/* ── Dashboard Empty ── */
.dash-empty {
  position: relative;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  overflow: hidden;
}
.dash-empty-deco {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
  opacity: .72;
}
.dash-empty-deco-a {
  width: 180rpx; height: 180rpx;
  left: -56rpx; top: 120rpx;
  background: rgba(111,193,255,.16);
}
.dash-empty-deco-b {
  width: 240rpx; height: 240rpx;
  right: -90rpx; top: 280rpx;
  background: rgba(79,127,255,.12);
}
.dash-empty-deco-c {
  width: 120rpx; height: 120rpx;
  left: 76rpx; bottom: 100rpx;
  background: rgba(95,222,171,.13);
}
.dash-empty-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 640rpx;
  padding: 48rpx 36rpx 36rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 60rpx rgba(74,101,153,.13);
  border: 1rpx solid rgba(226,234,247,.92);
  text-align: center;
}
.dash-empty-visual {
  position: relative;
  width: 260rpx;
  height: 210rpx;
  margin: 0 auto 22rpx;
}
.dev-orbit {
  position: absolute;
  left: 35rpx; top: 16rpx;
  width: 190rpx; height: 150rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(79,127,255,.18);
  transform: rotate(-12deg);
}
.dev-report {
  position: absolute;
  left: 68rpx; top: 32rpx;
  width: 124rpx; height: 142rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F7FAFF, #EEF5FF);
  border: 1rpx solid rgba(221,232,255,.9);
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(79,127,255,.10);
}
.dev-report-title-line {
  width: 48rpx; height: 6rpx;
  border-radius: 999rpx;
  background: #D8E6FF;
  margin-bottom: 14rpx;
}
.dev-report-bar {
  height: 10rpx; border-radius: 999rpx;
  background: #D8E6FF;
  margin-top: 10rpx;
}
.dev-report-bar.long { width: 90%; }
.dev-report-bar.medium { width: 66%; }
.dev-report-bar.short { width: 42%; }
.dev-report-dot-row {
  display: flex; gap: 6rpx; margin-top: 14rpx;
}
.dev-report-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #D8E6FF;
}
.dev-report-dot.active { background: #4F7FFF; }
.dev-mini-card {
  position: absolute;
  width: 64rpx; height: 80rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,.95);
  box-shadow: 0 8rpx 20rpx rgba(74,101,153,.10);
  border: 1rpx solid rgba(221,232,255,.92);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
}
.dev-mini-left {
  left: 2rpx; top: 96rpx;
  transform: rotate(-9deg);
}
.dev-mini-right {
  right: 0; top: 28rpx;
  transform: rotate(8deg);
}
.dev-mini-bar {
  width: 36rpx; height: 8rpx; border-radius: 999rpx;
  background: #E2ECFF;
}
.dev-mini-bar.tall { height: 14rpx; }
.dev-mini-bar.short { width: 24rpx; }
.dev-mini-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #E2ECFF;
}
.dev-mini-dot.active { background: #5FDEAB; }
.dev-spark {
  position: absolute;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #FFD66E;
  box-shadow: 0 0 18rpx rgba(255,214,110,.55);
}
.dev-spark.spark-a { left: 44rpx; top: 28rpx; }
.dev-spark.spark-b { right: 42rpx; top: 150rpx; background: #6EC1FF; }
.dev-spark.spark-c { left: 132rpx; bottom: 8rpx; background: #5FDEAB; }
.dash-empty-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.28;
  margin-bottom: 12rpx;
}
.dash-empty-desc {
  display: block;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.6;
  margin: 0 auto 24rpx;
  max-width: 520rpx;
}
.dash-empty-status {
  display: flex;
  align-items: center;
  margin: 0 0 24rpx;
  padding: 18rpx 14rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #F7FAFF, #EEF5FF);
  border: 1rpx solid rgba(221,232,255,.95);
}
.dash-empty-status-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.dash-empty-status-label {
  font-size: 21rpx;
  color: #8EA0BA;
  font-weight: 600;
}
.dash-empty-status-value {
  font-size: 28rpx;
  color: #4F7FFF;
  font-weight: 900;
}
.dash-empty-status-divider {
  width: 1rpx; height: 40rpx;
  background: #DDE8FF;
}
.dash-empty-refresh {
  margin-bottom: 16rpx;
  padding: 8rpx;
}
.dash-empty-refresh-text {
  font-size: 22rpx;
  color: #4F7FFF;
  font-weight: 700;
  animation: bg-pulse 1.2s ease-in-out infinite;
}
.dash-empty-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.dash-empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 86rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  border: none;
  line-height: normal;
  box-sizing: border-box;
}
.dash-empty-btn.primary {
  background: linear-gradient(135deg, #4F7FFF, #6EC1FF);
  color: #FFFFFF;
  box-shadow: 0 14rpx 28rpx rgba(79,127,255,.22);
}
.dash-empty-btn.secondary {
  background: #FFFFFF;
  color: #4F7FFF;
  border: 1rpx solid #DDE8FF;
}
.dash-empty-btn::after { border: none; }
.dash-empty-btn-pressed { opacity: .88; transform: scale(.98); }

/* ════════════════════════════════════════════
   DASHBOARD HEADER
   ════════════════════════════════════════════ */
.dash-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 0 4rpx;
  margin-bottom: 24rpx;
}
.dash-header-left {
  flex: 1;
  min-width: 0;
}
.dash-header-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.dash-header-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.16), rgba(110, 193, 255, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.dash-header-icon .line-icon {
  width: 20rpx;
  height: 20rpx;
  color: #4F7FFF;
}
.dash-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #18233A;
  line-height: 1.25;
}

.dash-header-accent {
  width: 48rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #4F7FFF, rgba(79, 127, 255, 0.2));
  margin-top: 10rpx;
  margin-bottom: 2rpx;
}
.dash-header-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8391A8;
  line-height: 1.45;
}

/* ════════════════════════════════════════════
   OVERVIEW CARD — dashboard
   ════════════════════════════════════════════ */
.overview-card-dash {
  position: relative;
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(218, 228, 243, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.06);
  padding: 28rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.overview-dash-deco {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(79, 127, 255, 0.05);
  right: -36rpx;
  top: -40rpx;
  pointer-events: none;
}

.overview-dash-deco::after {
  content: '';
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(110, 193, 255, 0.06);
  right: 44rpx;
  top: 28rpx;
  pointer-events: none;
}
.overview-dash-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.overview-dash-main {
  flex: 1;
  min-width: 0;
}
.overview-dash-main-label {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #74839A;
  line-height: 1.35;
  margin-bottom: 6rpx;
}
.overview-dash-number-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.overview-dash-main-num {
  font-size: 76rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
}
.overview-dash-ring {
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.overview-dash-canvas {
  width: 130rpx;
  height: 130rpx;
}
.overview-dash-metrics {
  display: flex;
  align-items: center;
  gap: 0;
  padding-top: 20rpx;
  border-top: 1rpx solid #EDF1F7;
}
.overview-dash-metric {
  flex: 1;
  text-align: center;
  min-width: 0;
}
.overview-dash-metric-val {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #18233A;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.overview-dash-metric-val.primary {
  color: #3157D5;
}
.overview-dash-metric-unit {
  font-size: 18rpx;
  color: #74839A;
  font-weight: 700;
}
.overview-dash-metric-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #74839A;
  line-height: 1.3;
}
.overview-dash-divider {
  width: 1rpx;
  height: 40rpx;
  background: #EDF1F7;
  flex-shrink: 0;
}

/* ════════════════════════════════════════════
   QUICK ACTIONS — asymmetric
   ════════════════════════════════════════════ */
.quick-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.quick-action-primary {
  flex: 0 0 56%;
  background: #F3F7FF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(79,127,255,.15);
  padding: 22rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  transition: transform .15s;
}
.quick-action-primary-icon {
  width: 48rpx; height: 48rpx; border-radius: 14rpx;
  background: #4F7FFF;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.quick-action-primary-icon .line-icon { width: 24rpx; height: 24rpx; color: #FFFFFF; }
.quick-action-primary-copy { flex: 1; min-width: 0; }
.quick-action-primary-name {
  display: block; font-size: 26rpx; font-weight: 800; color: #18233A; line-height: 1.3;
}
.quick-action-primary-desc {
  display: block; margin-top: 2rpx; font-size: 20rpx; color: #617089;
}
.quick-action-aux-group {
  flex: 1; display: flex; flex-direction: column; gap: 10rpx;
}
.quick-action-aux {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid rgba(218,228,243,.9);
  padding: 12rpx 16rpx;
  display: flex; align-items: center; gap: 10rpx;
  transition: transform .15s;
}
.quick-action-aux-icon {
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: #EEF4FF;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.quick-action-aux-icon .line-icon { width: 18rpx; height: 18rpx; color: #4F7FFF; }
.quick-action-aux-name { font-size: 22rpx; font-weight: 700; color: #18233A; flex: 1; }
.quick-action-aux-count {
  font-size: 20rpx; font-weight: 900; color: #3157D5; padding: 2rpx 8rpx;
  border-radius: 999rpx; background: rgba(79,127,255,.1);
}
.quick-action-aux-arrow { width: 18rpx; height: 18rpx; color: #B7C4DA; }

/* ════════════════════════════════════════════
   KPI SECTION — varied layout
   ════════════════════════════════════════════ */
.kpi-section { margin-bottom: 32rpx; }

.kpi-primary {
  background: #F3F7FF;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 14rpx;
}
.kpi-primary-inner {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
}
.kpi-primary-info { flex: 1; min-width: 0; }
.kpi-primary-label {
  display: block; font-size: 22rpx; font-weight: 800; color: #74839A; margin-bottom: 4rpx;
}
.kpi-primary-score {
  display: block; font-size: 56rpx; font-weight: 900; line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.kpi-primary-status {
  display: block; margin-top: 4rpx; font-size: 22rpx; color: #617089;
}
.kpi-primary-canvas {
  width: 110rpx; height: 110rpx; flex-shrink: 0;
  overflow: hidden;
}
.kpi-primary-meta {
  display: flex; gap: 16rpx; margin-top: 14rpx; padding-top: 14rpx;
  border-top: 1rpx solid rgba(79,127,255,.1);
  font-size: 20rpx; color: #617089;
}

.kpi-grid {
  display: flex; gap: 12rpx; margin-bottom: 14rpx;
}
.kpi-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(218,228,243,.9);
  padding: 20rpx 16rpx;
  text-align: center;
}
.kpi-label {
  display: block; font-size: 22rpx; font-weight: 700; color: #18233A; margin-bottom: 10rpx;
}
.kpi-score-wrap {
  position: relative; width: 100rpx; height: 100rpx; margin: 0 auto;
}
.kpi-canvas { width: 100rpx; height: 100rpx; }
.kpi-score-center {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.kpi-score-num {
  font-size: 32rpx; font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1;
}
.kpi-sub {
  display: block; margin-top: 8rpx; font-size: 20rpx; color: #8391A8;
}
.kpi-big-num {
  font-size: 44rpx; font-weight: 900; line-height: 1.1; font-variant-numeric: tabular-nums;
}
.kpi-risk-bar {
  display: flex; gap: 6rpx; justify-content: center; margin-top: 12rpx;
}
.kpi-risk-seg {
  width: 28rpx; height: 6rpx; border-radius: 3rpx;
  background: #E8EEF8;
}
.kpi-risk-seg.active { background: #EF4444; }

.kpi-compare {
  display: flex; align-items: center; gap: 20rpx;
  padding: 18rpx 20rpx;
  background: rgba(255,255,255,.7);
  border-radius: 24rpx;
  border: 1rpx solid rgba(218,228,243,.9);
}
.kpi-compare-item { flex: 1; text-align: center; }
.kpi-compare-label {
  display: block; font-size: 20rpx; color: #8391A8; margin-bottom: 4rpx;
}
.kpi-compare-val {
  display: block; font-size: 36rpx; font-weight: 900; line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.kpi-compare-val.green { color: #22C55E; }
.kpi-compare-val.orange { color: #F59E0B; }
.kpi-compare-vs {
  display: flex; align-items: flex-end; gap: 8rpx; height: 72rpx; padding-bottom: 4rpx;
}
.kpi-compare-bar {
  width: 16rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: rgba(79,127,255,.15);
}
