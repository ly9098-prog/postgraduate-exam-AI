.trend-meta-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-hint, #8EA0BA);
}
.trend-meta-label {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #617089);
}
.trend-summary {
  display: block;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(79, 127, 255, 0.08);
  color: var(--text-secondary, #617089);
  font-size: 22rpx;
  line-height: 1.5;
}

.trend-container {
  position: relative;
  min-height: 420rpx;
  overflow: hidden;
}
.trend-loading-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 30rpx;
}
.trend-error-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-card, #FFFFFF);
  border-radius: 30rpx;
}

/* ════════════════════════════════════════════
   SUBJECTS — donut + card list (no progress bars)
   ════════════════════════════════════════════ */
