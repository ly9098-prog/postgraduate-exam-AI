}

/* ════════════════════════════════════════════
   YEARLY
   ════════════════════════════════════════════ */
.yearly-preview {
  padding: 24rpx;
  margin-bottom: 12rpx;
}
.yearly-stats {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.yearly-stat-item {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(79, 127, 255, 0.08);
  text-align: center;
}
.yearly-stat-val {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text-primary, #18233A);
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}
.yearly-stat-val.small { font-size: 22rpx; }
.yearly-stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 18rpx;
  color: var(--text-hint, #8EA0BA);
}
.yearly-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: var(--bg-surface, #F6F9FF);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary, #4F7FFF);
  min-height: 44px;
}
.yearly-toggle .line-icon {
  width: 24rpx;
  height: 24rpx;
}
.yearly-heatmap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}
.yearly-heatmap.expanded { max-height: 600rpx; }
.yearly-heat-scroll {
  width: 100%;
  white-space: nowrap;
}
.yearly-heat-grid {
  display: inline-flex;
  gap: 6rpx;
  min-width: 100%;
  padding: 16rpx 0 12rpx;
}
.year-week {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.year-day {
  width: 16rpx;
  height: 16rpx;
  border-radius: 5rpx;
  background: #E8EEF8;
  position: relative;
}
.year-day.lv1, .legend-cell.lv1 { background: #DDE8FF; }
.year-day.lv2, .legend-cell.lv2 { background: #AFC8FF; }
.year-day.lv3, .legend-cell.lv3 { background: #79A5FF; }
.year-day.lv4, .legend-cell.lv4 { background: var(--primary, #4F7FFF); }
.year-day-tip {
  position: absolute;
  bottom: calc(100% + 8rpx);
  left: 50%;
  transform: translateX(-50%);
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(24, 35, 58, 0.9);
  color: #FFFFFF;
  font-size: 18rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
  z-index: 4;
}
.year-day:active .year-day-tip { opacity: 1; }
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: var(--text-hint, #8EA0BA);
  font-size: 20rpx;
  padding-bottom: 16rpx;
}
.legend-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: #E8EEF8;
}
.yearly-loading { padding: 40rpx; text-align: center; }
.yearly-loading-text { font-size: 24rpx; color: var(--text-hint, #8EA0BA); }
.yearly-error { padding: 40rpx; text-align: center; }
.yearly-error .yetxt { font-size: 24rpx; color: var(--text-hint, #8EA0BA); }

/* ── Footer ── */
.footer-safe { height: 20rpx; }

/* ════════════════════════════════════════════
   DIAGNOSIS GRID
   ════════════════════════════════════════════ */
