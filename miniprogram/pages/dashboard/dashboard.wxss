/* v6: both hero reports stay mounted in one grid cell.
   The deck height is the max intrinsic height of both reports, so switching can
   cross-fade without relayout, scroll jumps, or the whole-screen flash seen in v4/v5. */
.hero-card-deck {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto;
}
.hero-card-panel {
  grid-column: 1;
  grid-row: 1;
  min-width: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateX(18rpx) scale(.994);
  transition:
    opacity 280ms cubic-bezier(.22,1,.36,1),
    transform 320ms cubic-bezier(.22,1,.36,1),
    visibility 0s linear 320ms;
  will-change: opacity, transform;
}
.hero-card-panel.is-left { transform: translateX(-18rpx) scale(.994); }
.hero-card-panel.is-right { transform: translateX(18rpx) scale(.994); }
.hero-card-panel.is-active {
  z-index: 2;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateX(0) scale(1);
  transition-delay: 0s, 0s, 0s;
}
@media (prefers-reduced-motion: reduce) {
  .hero-card-panel { transition: none !important; transform: none !important; }
}

/* Recommendation subject controls use the dashboard's existing green state. */
.knowledge-diagnosis-card-heading{align-items:center;padding-bottom:24rpx}
.knowledge-diagnosis-card-title{margin-top:0;font-size:36rpx}
.knowledge-diagnosis-period{color:#58676D;font-size:22rpx;white-space:nowrap}
.knowledge-subject-filter{position:relative;z-index:1;padding-top:8rpx}
.knowledge-subject-filter .knowledge-subject-entry{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%;min-height:88rpx;box-sizing:border-box;margin:0;padding:12rpx 0;border:0;border-radius:12rpx;background:transparent;text-align:left;line-height:1.5}
.knowledge-subject-label{flex-shrink:0;color:#58676D;font-size:23rpx;font-weight:600}
.knowledge-subject-entry-value{display:flex;align-items:center;justify-content:flex-end;gap:12rpx;min-width:0;color:#17693A}
.knowledge-subject-current{overflow:hidden;font-size:26rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}
.knowledge-subject-entry-value .line-icon{flex-shrink:0;width:24rpx;height:24rpx;color:#58676D}
.knowledge-subject-entry[disabled]{background:transparent;color:#58676D}
.knowledge-subject-skeleton{width:180rpx;height:30rpx;border-radius:8rpx;background:#E9EEEB}
.knowledge-subject-entry::after,.knowledge-subject-retry::after,.knowledge-subject-sheet-close::after,.knowledge-subject-tile::after{border:0}
.knowledge-subject-retry{display:inline-flex;align-items:center;justify-content:center;min-height:72rpx;margin:12rpx 0 0;padding:12rpx 18rpx;border:0;border-radius:16rpx;background:#E8F8ED;color:#17693A;font-size:23rpx;line-height:1.5}
.knowledge-subject-empty{display:block;margin-top:18rpx;color:#58676D;font-size:23rpx;line-height:1.5}
.knowledge-diagnosis-body {
  position: relative;
  z-index: 1;
  min-height: 440rpx;
}
.knowledge-diagnosis-loading-body {
  position: absolute;
  inset: 0;
  padding-top: 36rpx;
  animation: knowledge-diagnosis-loading-reveal .12s ease-out .1s both;
}
.knowledge-diagnosis-empty-body { padding-top: 36rpx; }
.knowledge-diagnosis-refresh,
.knowledge-diagnosis-refresh-error {
  position: absolute;
  top: 0;
  right: 0;
  margin: 0;
  color: #58676D;
  font-size: 20rpx;
  line-height: 1.5;
}
.knowledge-diagnosis-refresh-error {
  min-height: 0;
  padding: 0;
  background: transparent;
}
.knowledge-diagnosis-loading-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 138rpx;
  margin-bottom: 30rpx;
}
.knowledge-diagnosis-loading-icon {
  width: 138rpx;
  height: 138rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F1F4F2;
}
.knowledge-diagnosis-loading-copy { flex: 1; }
.knowledge-diagnosis-loading-body .knowledge-diagnosis-skeleton { background: #E9EEEB; }
.knowledge-diagnosis-loading-metrics {
  height: 116rpx;
  border-radius: 24rpx;
  background: #F1F4F2;
}
.knowledge-diagnosis-loading-action {
  width: 60%;
  height: 82rpx;
  margin-top: 32rpx;
  border-radius: 999rpx;
  background: #E9EEEB;
}

.knowledge-subject-sheet-layer{position:fixed;inset:0;z-index:110}
.knowledge-subject-sheet-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(18, 29, 25, .18);
}
.knowledge-subject-sheet-layer.is-closing .knowledge-subject-sheet-backdrop {
  animation: knowledge-subject-backdrop-exit .18s ease-out forwards;
}
.knowledge-subject-sheet-layer.is-closing .knowledge-subject-sheet {
  animation: knowledge-subject-sheet-exit .18s cubic-bezier(.4, 0, 1, 1) forwards;
}
.knowledge-subject-sheet {
  --sheet-ink: #263B34;
  --sheet-accent: #27634B;
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 38rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: rgba(250, 253, 251, .96);
  box-shadow: 0 -12rpx 60rpx rgba(19, 40, 30, .08);
  animation: knowledge-subject-sheet-enter .22s cubic-bezier(.16, 1, .3, 1);
}
@supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .knowledge-subject-sheet {
    background: rgba(250, 253, 251, .82);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
  }
}
.knowledge-subject-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 26rpx;
}
.knowledge-subject-sheet-title {
  color: var(--sheet-ink);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  letter-spacing: .5rpx;
}
.knowledge-subject-sheet .knowledge-subject-sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin: -20rpx -20rpx -20rpx 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  color: #53665D;
}
.knowledge-subject-sheet-close .line-icon { width: 28rpx; height: 28rpx; }
.knowledge-subject-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx 20rpx;
}
.knowledge-subject-grid .knowledge-subject-tile {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  width: 100%;
  min-width: 0;
  min-height: 198rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 30rpx 10rpx;
  border: 0;
  border-radius: 20rpx;
  background: transparent;
  color: var(--sheet-ink);
  line-height: 1.5;
  transition: background-color .09s ease-out, color .09s ease-out;
}
.knowledge-subject-grid .knowledge-subject-tile.is-selected {
  background: rgba(39, 99, 75, .065);
  color: var(--sheet-accent);
}
.knowledge-subject-tile-icon { display: block; width: 54rpx; height: 54rpx; }
.knowledge-subject-tile-name {
  max-width: 100%;
  font-size: 26rpx;
  font-weight: 500;
  overflow-wrap: break-word;
}
.knowledge-subject-tile.is-selected .knowledge-subject-tile-name { font-weight: 600; }
@keyframes knowledge-subject-sheet-enter {
  from { transform: translateY(48rpx); }
  to { transform: translateY(0); }
}
@keyframes knowledge-subject-sheet-exit {
  from { transform: translateY(0); }
  to { transform: translateY(100%); }
}
@keyframes knowledge-subject-backdrop-exit {
  from { opacity: 1; }
  to { opacity: 0; }
}
@keyframes knowledge-diagnosis-loading-reveal {
  from { opacity: 0; }
  to { opacity: 1; }
}
@media (prefers-reduced-motion:reduce) {
  .knowledge-subject-sheet,
  .knowledge-subject-sheet-layer.is-closing .knowledge-subject-sheet,
  .knowledge-subject-sheet-layer.is-closing .knowledge-subject-sheet-backdrop,
  .knowledge-diagnosis-loading-body { animation: none; }
  .knowledge-subject-tile { transition: none; }
}
@media (max-width:350px){.knowledge-diagnosis-card-title{font-size:32rpx}.knowledge-subject-current{font-size:24rpx}.knowledge-subject-sheet{padding-right:24rpx;padding-left:24rpx}}
