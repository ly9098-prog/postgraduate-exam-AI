@import '../../styles/tokens.wxss';

page {
  background: #F2F3F5;
  background-color: #F2F3F5;
}

.dashboard-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx calc(44rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 0%, rgba(102,132,79,.07), transparent 300rpx),
    linear-gradient(180deg, #F7F7F8 0%, #F1F3F6 100%);
  opacity: 0;
}

.dashboard-page.ready {
  animation: dashboard-enter .34s cubic-bezier(.2, .8, .2, 1) forwards;
}

@keyframes dashboard-enter {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Shared */
.dashboard-section { margin-top: 42rpx; }
.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}
.compact-heading { margin-bottom: 14rpx; }
.section-kicker,
.report-eyebrow,
.deep-analysis-kicker,
.state-kicker {
  display: block;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 2.6rpx;
  color: #7E8795;
}
.section-title {
  display: block;
  margin-top: 5rpx;
  color: #11141A;
  font-size: 34rpx;
  line-height: 1.22;
  font-weight: 900;
  letter-spacing: -.6rpx;
}
.section-side-note {
  color: #858E9B;
  font-size: 22rpx;
  padding-bottom: 4rpx;
}
.surface-pressed { opacity: .74; transform: scale(.992); }
.button-pressed { opacity: .88; transform: scale(.985); }
.inline-action { color: #66844F; font-weight: 800; }
.footer-safe { height: 24rpx; }

/* Loading and states */
.dashboard-loading,
.dashboard-state {
  min-height: 72vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
}
.loading-skeleton { width: 100%; }
.sk-line,
.sk-hero,
.sk-card {
  background: linear-gradient(90deg, #E3E6EB 20%, #F2F3F6 50%, #E3E6EB 80%);
  background-size: 220% 100%;
  animation: shimmer 1.4s infinite linear;
}
.sk-line { height: 30rpx; border-radius: 10rpx; }
.sk-line-short { width: 42%; margin-bottom: 24rpx; }
.sk-hero { height: 390rpx; border-radius: 32rpx; margin-bottom: 24rpx; }
.sk-card { height: 320rpx; border-radius: 28rpx; margin-bottom: 20rpx; }
.sk-card-small { height: 210rpx; }
@keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
.state-mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  color: #FFFFFF;
  background: #11141A;
  font-size: 40rpx;
  font-weight: 900;
}
.empty-visual {
  width: 300rpx;
  height: 200rpx;
  border-radius: 36rpx;
  background: #111827;
  position: relative;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 28rpx 70rpx rgba(15, 23, 42, .18);
}
.empty-chart-line {
  position: absolute;
  left: 36rpx;
  height: 7rpx;
  border-radius: 99rpx;
  transform-origin: left center;
}
.line-a { width: 76rpx; top: 128rpx; background: #66844F; transform: rotate(-20deg); }
.line-b { width: 86rpx; top: 102rpx; left: 100rpx; background: #86CFA9; transform: rotate(18deg); }
.line-c { width: 100rpx; top: 124rpx; left: 170rpx; background: #D99A45; transform: rotate(-38deg); }
.empty-chart-dot {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  right: 35rpx;
  top: 74rpx;
  background: #FFFFFF;
  box-shadow: 0 0 0 8rpx rgba(183,232,42,.22);
}
.state-title {
  display: block;
  margin-top: 12rpx;
  color: #11141A;
  font-size: 38rpx;
  font-weight: 900;
}
.state-desc {
  display: block;
  max-width: 550rpx;
  margin-top: 16rpx;
  color: #707986;
  font-size: 25rpx;
  line-height: 1.65;
}
.state-button,
.hero-primary-button,
.ai-button {
  border: 0;
  margin: 32rpx 0 0;
  padding: 0 34rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #66844F;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 88rpx;
  box-shadow: 0 16rpx 38rpx rgba(102,132,79,.20);
}
.state-button::after,
.hero-primary-button::after,
.ai-button::after { border: 0; }
.state-link { margin-top: 22rpx; color: #596273; font-size: 24rpx; }
.refresh-hint {
  margin: -4rpx 0 16rpx;
  text-align: center;
  color: #7E8795;
  font-size: 21rpx;
}

/* Intro */
.report-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 6rpx 4rpx 22rpx;
}
.report-title {
  display: block;
  margin-top: 7rpx;
  color: #11141A;
  font-size: 45rpx;
  line-height: 1.16;
  font-weight: 950;
  letter-spacing: -1.2rpx;
}
.report-period {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #495260;
  font-size: 22rpx;
  font-weight: 750;
  box-shadow: 0 8rpx 26rpx rgba(17, 20, 26, .05);
}

/* Hero */
.hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 30rpx;
  color: #FFFFFF;
  background:
    linear-gradient(145deg, rgba(19, 34, 61, .96) 0%, #101827 52%, #0B111C 100%);
  box-shadow: 0 30rpx 72rpx rgba(14, 23, 40, .24);
}
.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
  pointer-events: none;
}
.hero-glow-primary {
  width: 280rpx;
  height: 280rpx;
  right: -100rpx;
  top: -110rpx;
  background: radial-gradient(circle, rgba(102,132,79,.42), rgba(102,132,79,0) 70%);
}
.hero-glow-green {
  width: 210rpx;
  height: 210rpx;
  left: -100rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(91, 228, 169, .2), rgba(91, 228, 169, 0) 70%);
}
.hero-topline,
.hero-main,
.hero-metrics,
.hero-actions { position: relative; z-index: 1; }
.hero-topline { display: flex; align-items: center; }
.hero-status-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: #86CFA9;
  box-shadow: 0 0 0 8rpx rgba(117, 230, 180, .12);
}
.hero-status { margin-left: 14rpx; font-size: 23rpx; font-weight: 800; color: #EAF1FF; }
.hero-period { margin-left: auto; font-size: 18rpx; letter-spacing: 1.7rpx; color: rgba(226, 234, 247, .56); }
.hero-main {
  display: flex;
  align-items: flex-end;
  gap: 28rpx;
  margin-top: 35rpx;
}
.hero-score-block { flex-shrink: 0; }
.hero-score-row { display: flex; align-items: flex-start; }
.hero-score {
  font-size: 106rpx;
  line-height: .9;
  font-weight: 950;
  letter-spacing: -5rpx;
  font-variant-numeric: tabular-nums;
}
.hero-score-unit { margin: 5rpx 0 0 7rpx; font-size: 34rpx; font-weight: 850; color: #A7BE92; }
.hero-score-label { display: block; margin-top: 15rpx; font-size: 21rpx; color: rgba(231, 237, 247, .62); }
.hero-copy { flex: 1; min-width: 0; padding-bottom: 5rpx; }
.hero-copy-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.42;
  font-weight: 850;
  color: #FFFFFF;
}
.hero-copy-desc {
  display: -webkit-box;
  margin-top: 9rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: rgba(225, 232, 243, .58);
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.hero-metrics {
  display: flex;
  align-items: center;
  margin-top: 35rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, .1);
  border-bottom: 1rpx solid rgba(255, 255, 255, .1);
}
.hero-metric { flex: 1; text-align: center; }
.hero-metric-value { display: block; font-size: 35rpx; font-weight: 900; font-variant-numeric: tabular-nums; }
.hero-metric-label { display: block; margin-top: 5rpx; font-size: 19rpx; color: rgba(226, 233, 243, .55); }
.hero-metric-divider { width: 1rpx; height: 48rpx; background: rgba(255, 255, 255, .1); }
.accent-green { color: #86CFA9; }
.accent-orange { color: #D99A45; }
.hero-actions { display: flex; align-items: center; gap: 14rpx; margin-top: 24rpx; }
.hero-primary-button {
  flex: 1;
  height: 82rpx;
  margin: 0;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  line-height: 82rpx;
  font-size: 25rpx;
  background: #66844F;
  box-shadow: 0 14rpx 34rpx rgba(102,132,79,.20);
}
.hero-primary-button .line-icon { width: 24rpx; height: 24rpx; }
.hero-secondary-button {
  height: 82rpx;
  padding: 0 25rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #F0F4FA;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .1);
  font-size: 24rpx;
  font-weight: 800;
}
.hero-secondary-button .line-icon { width: 24rpx; height: 24rpx; }

/* Period switch */
.period-switch {
  display: flex;
  align-items: center;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #E7E9ED;
}
.period-item {
  min-width: 65rpx;
  padding: 10rpx 12rpx;
  text-align: center;
  color: #717A86;
  font-size: 21rpx;
  font-weight: 750;
  border-radius: 999rpx;
}
.period-item.active {
  color: #FFFFFF;
  background: #11141A;
  box-shadow: 0 7rpx 16rpx rgba(17, 20, 26, .14);
}

/* Trend */
.trend-card,
.deep-analysis-shell {
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 38rpx rgba(20, 27, 39, .06);
}
.trend-card { padding: 24rpx 22rpx 20rpx; }
.trend-chart-wrap { height: 300rpx; }
.trend-canvas { width: 100%; height: 300rpx; }
.trend-loading { height: 300rpx; display: flex; align-items: center; }
.trend-loading-line {
  width: 100%;
  height: 150rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #F0F2F5 25%, #E3E6EB 50%, #F0F2F5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.3s infinite linear;
}
.trend-error { height: 260rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #7B8491; font-size: 23rpx; }
.trend-legend { display: flex; justify-content: center; gap: 30rpx; margin-top: 6rpx; color: #78818E; font-size: 20rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-bar { width: 17rpx; height: 17rpx; border-radius: 5rpx; background: rgba(102,132,79,.18); }
.legend-line { width: 23rpx; height: 4rpx; border-radius: 99rpx; background: #86CFA9; }
.trend-stats {
  display: flex;
  margin-top: 22rpx;
  padding-top: 21rpx;
  border-top: 1rpx solid #EDF0F3;
}
.trend-stat { flex: 1; text-align: center; }
.trend-stat-value { display: block; color: #141820; font-size: 32rpx; font-weight: 900; }
.trend-stat-value.green { color: #2D9B68; }
.trend-stat-unit { color: #A0A7B1; font-size: 22rpx; }
.trend-stat-label { display: block; margin-top: 4rpx; color: #8B939F; font-size: 20rpx; }

/* Weak focus */
.focus-card {
  padding: 27rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #66844F 0%, #789360 58%, #8AA773 100%);
  color: #FFFFFF;
  box-shadow: 0 19rpx 48rpx rgba(102,132,79,.17);
}
.focus-card-top { display: flex; align-items: center; }
.focus-index {
  width: 56rpx;
  height: 56rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, .17);
  color: rgba(255, 255, 255, .8);
  font-size: 20rpx;
  font-weight: 850;
}
.focus-title-wrap { flex: 1; min-width: 0; margin-left: 17rpx; }
.focus-subject { display: block; color: rgba(255, 255, 255, .67); font-size: 20rpx; }
.focus-title { display: block; margin-top: 5rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 31rpx; font-weight: 900; }
.focus-percent { margin-left: 18rpx; font-size: 43rpx; font-weight: 950; font-variant-numeric: tabular-nums; }
.focus-progress-track { height: 9rpx; margin-top: 25rpx; border-radius: 99rpx; background: rgba(9, 32, 92, .2); overflow: hidden; }
.focus-progress-fill { height: 100%; min-width: 10rpx; border-radius: inherit; background: #86CFA9; }
.focus-footer { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 17rpx; color: rgba(255, 255, 255, .68); font-size: 21rpx; }
.focus-action { display: flex; align-items: center; color: #FFFFFF; font-weight: 850; flex-shrink: 0; }
.focus-action .line-icon { width: 22rpx; height: 22rpx; }
.focus-mini-list { margin-top: 13rpx; padding: 0 8rpx; background: #FFFFFF; border-radius: 25rpx; box-shadow: 0 12rpx 34rpx rgba(20, 27, 39, .05); }
.focus-mini-item { display: flex; align-items: center; min-height: 104rpx; padding: 0 18rpx; border-bottom: 1rpx solid #EDF0F3; }
.focus-mini-item:last-child { border-bottom: 0; }
.focus-mini-rank { width: 48rpx; color: #A1A8B2; font-size: 20rpx; font-weight: 850; }
.focus-mini-copy { flex: 1; min-width: 0; }
.focus-mini-title { display: block; color: #171B22; font-size: 25rpx; font-weight: 850; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.focus-mini-sub { display: block; margin-top: 5rpx; color: #929AA5; font-size: 20rpx; }
.focus-mini-value { margin-left: 15rpx; color: #66844F; font-size: 27rpx; font-weight: 900; }

/* Snapshot */
.snapshot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.snapshot-card {
  min-width: 0;
  min-height: 170rpx;
  padding: 20rpx 17rpx;
  box-sizing: border-box;
  border-radius: 25rpx;
  background: #111827;
  color: #FFFFFF;
  box-shadow: 0 13rpx 32rpx rgba(17, 24, 39, .11);
}
.snapshot-card.orange { background: #FFF0DE; color: #19140F; box-shadow: none; }
.snapshot-card.green { background: #DFF7EC; color: #101813; box-shadow: none; }
.snapshot-label { display: block; min-height: 48rpx; color: rgba(255, 255, 255, .56); font-size: 19rpx; line-height: 1.25; }
.snapshot-card.orange .snapshot-label,
.snapshot-card.green .snapshot-label { color: rgba(20, 25, 22, .56); }
.snapshot-value { display: block; margin-top: 9rpx; font-size: 38rpx; font-weight: 950; font-variant-numeric: tabular-nums; }
.snapshot-note { display: block; margin-top: 7rpx; color: rgba(255, 255, 255, .5); font-size: 18rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.snapshot-card.orange .snapshot-note,
.snapshot-card.green .snapshot-note { color: rgba(20, 25, 22, .52); }

/* Deep analysis */
.deep-analysis-shell { margin-top: 42rpx; overflow: hidden; }
.deep-analysis-toggle { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 142rpx; padding: 0 27rpx; }
.deep-analysis-title { display: block; margin-top: 5rpx; color: #141820; font-size: 31rpx; font-weight: 900; }
.deep-analysis-desc { display: block; margin-top: 7rpx; color: #89919C; font-size: 20rpx; }
.deep-analysis-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 21rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #11141A;
  background: #EFF1F4;
  transition: transform .22s ease;
}
.deep-analysis-icon.expanded { transform: rotate(180deg); }
.deep-analysis-icon .line-icon { width: 26rpx; height: 26rpx; }
.deep-analysis-content { padding: 0 18rpx 20rpx; }
.deep-block { margin-top: 12rpx; padding: 24rpx; border-radius: 26rpx; background: #F6F7F9; }
.deep-block-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 19rpx; }
.deep-block-title { display: block; color: #171B22; font-size: 27rpx; font-weight: 900; }
.deep-block-subtitle { display: block; margin-top: 5rpx; color: #8B939F; font-size: 19rpx; }
.deep-block-meta { color: #8B939F; font-size: 20rpx; }
.subject-list { background: #FFFFFF; border-radius: 21rpx; padding: 0 17rpx; }
.subject-row { padding: 19rpx 2rpx; border-bottom: 1rpx solid #EDF0F3; }
.subject-row:last-child { border-bottom: 0; }
.subject-row-main { display: flex; align-items: center; }
.subject-dot { width: 12rpx; height: 12rpx; border-radius: 50%; flex-shrink: 0; }
.subject-copy { flex: 1; min-width: 0; margin-left: 13rpx; }
.subject-name { display: block; color: #181C23; font-size: 24rpx; font-weight: 850; }
.subject-meta { display: block; margin-top: 5rpx; color: #929AA5; font-size: 19rpx; }
.subject-accuracy { margin-left: 12rpx; font-size: 25rpx; font-weight: 900; }
.subject-accuracy.green { color: #26B778; }
.subject-accuracy.orange { color: #E39128; }
.subject-accuracy.red { color: #E75A5A; }
.subject-progress-track { height: 6rpx; margin: 14rpx 0 0 25rpx; border-radius: 99rpx; overflow: hidden; background: #EDF0F3; }
.subject-progress-fill { height: 100%; min-width: 7rpx; border-radius: inherit; background: #66844F; }
.subject-progress-fill.green { background: #75D8AC; }
.subject-progress-fill.orange { background: #D99A45; }
.subject-progress-fill.red { background: #FF7777; }
.deep-stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; }
.deep-stat { min-height: 112rpx; padding: 17rpx; box-sizing: border-box; border-radius: 21rpx; background: #FFFFFF; }
.deep-stat-value { display: block; color: #66844F; font-size: 31rpx; font-weight: 950; }
.deep-stat-value.green { color: #26B778; }
.deep-stat-value.orange { color: #E39128; }
.deep-stat-label { display: block; margin-top: 5rpx; color: #89919C; font-size: 19rpx; }
.deep-conclusion { display: block; margin-top: 14rpx; padding: 16rpx 18rpx; border-radius: 18rpx; background: #FFFFFF; color: #66707D; font-size: 21rpx; line-height: 1.5; }
.topic-chip-list { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 14rpx; }
.topic-chip { padding: 10rpx 15rpx; border-radius: 999rpx; background: #FFF0DE; color: #B46413; font-size: 19rpx; }
.growth-summary { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.growth-level { display: flex; align-items: center; min-width: 0; }
.growth-level-badge { padding: 12rpx 15rpx; border-radius: 16rpx; background: #111827; color: #FFFFFF; font-size: 20rpx; font-weight: 900; margin-right: 13rpx; }
.growth-title { display: block; color: #171B22; font-size: 24rpx; font-weight: 850; }
.growth-desc { display: block; margin-top: 4rpx; color: #8B939F; font-size: 19rpx; }
.growth-year { text-align: right; flex-shrink: 0; }
.growth-year-value { display: block; color: #66844F; font-size: 34rpx; font-weight: 950; }
.growth-year-label { display: block; margin-top: 3rpx; color: #8B939F; font-size: 18rpx; }
.growth-progress { height: 8rpx; margin-top: 18rpx; border-radius: 99rpx; overflow: hidden; background: #E3E7EC; }
.growth-progress-fill { height: 100%; min-width: 8rpx; border-radius: inherit; background: linear-gradient(90deg, #66844F, #86CFA9); }
.yearly-entry { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; margin-top: 17rpx; padding-top: 16rpx; border-top: 1rpx solid #E7EAEE; color: #697380; font-size: 20rpx; }
.yearly-heatmap { margin-top: 18rpx; padding: 15rpx; border-radius: 18rpx; background: #FFFFFF; }
.yearly-heat-scroll { width: 100%; }
.yearly-heat-grid { display: flex; gap: 5rpx; width: max-content; }
.year-week { display: flex; flex-direction: column; gap: 5rpx; }
.year-day { width: 12rpx; height: 12rpx; border-radius: 3rpx; background: #EBEEF2; }
.year-day.lv1 { background: #D8E3FF; }
.year-day.lv2 { background: #9DB8FF; }
.year-day.lv3 { background: #628CFF; }
.year-day.lv4 { background: #66844F; }
.ai-block { background: #101827; color: #FFFFFF; }
.ai-block .deep-block-title { color: #FFFFFF; }
.ai-block .deep-block-subtitle { color: rgba(228, 235, 246, .55); }
.ai-badge { width: 52rpx; height: 52rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; background: #66844F; color: #FFFFFF; font-size: 20rpx; font-weight: 950; }
.ai-badge.data { width: auto; min-width: 52rpx; padding: 0 12rpx; background: rgba(255, 255, 255, .12); color: rgba(235, 240, 247, .78); }
.ai-empty { color: rgba(229, 235, 245, .67); font-size: 22rpx; line-height: 1.6; }
.ai-button { width: 100%; height: 76rpx; margin-top: 20rpx; line-height: 76rpx; border-radius: 23rpx; font-size: 24rpx; }
.ai-loading,
.ai-error { padding: 25rpx 0; text-align: center; color: rgba(229, 235, 245, .67); font-size: 21rpx; }
.ai-error { display: flex; flex-direction: column; gap: 12rpx; }
.ai-fallback-note { margin-bottom: 14rpx; padding: 14rpx 16rpx; border: 1rpx solid rgba(255, 255, 255, .10); border-radius: 16rpx; color: rgba(229, 235, 245, .62); font-size: 19rpx; line-height: 1.5; }
.ai-summary { display: block; padding: 20rpx; border-radius: 20rpx; background: rgba(255, 255, 255, .07); color: #FFFFFF; font-size: 22rpx; line-height: 1.6; }
.ai-result-group { margin-top: 20rpx; }
.ai-result-title { display: block; color: rgba(231, 237, 247, .56); font-size: 19rpx; font-weight: 850; letter-spacing: 1rpx; }
.ai-result-row { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; color: #E8EDF5; font-size: 21rpx; line-height: 1.55; }
.ai-result-dot { width: 9rpx; height: 9rpx; border-radius: 50%; margin-top: 11rpx; flex-shrink: 0; background: #86CFA9; }
.ai-risk-dot { background: #E1AA69; }
.ai-action-row { display: flex; align-items: center; justify-content: space-between; gap: 13rpx; margin-top: 11rpx; padding: 17rpx; border-radius: 18rpx; background: rgba(255, 255, 255, .07); }
.ai-action-title { display: block; color: #FFFFFF; font-size: 22rpx; font-weight: 850; }
.ai-action-desc { display: block; margin-top: 4rpx; color: rgba(229, 235, 245, .55); font-size: 19rpx; }
.ai-action-row .line-icon { color: #7FA3FF; flex-shrink: 0; }
.ai-footer { display: flex; justify-content: flex-end; gap: 26rpx; margin-top: 18rpx; color: rgba(228, 235, 246, .54); font-size: 19rpx; }

@media (prefers-reduced-motion: reduce) {
  .dashboard-page.ready,
  .deep-analysis-icon,
  .surface-pressed,
  .button-pressed { animation: none !important; transition: none !important; transform: none !important; }
}

/* ═══════════════════════════════════════════════════════════
   Dashboard V3 — editorial black data + restrained neon accents
   ═══════════════════════════════════════════════════════════ */
page {
  background: #F4F4F1;
  background-color: #F4F4F1;
}
.dashboard-page {
  background: #F4F4F1;
  padding-left: 24rpx;
  padding-right: 24rpx;
}
.dashboard-section { margin-top: 46rpx; }
.section-heading { margin-bottom: 20rpx; }
.section-title.no-kicker,
.deep-analysis-title.no-kicker { margin-top: 0; }
.section-kicker,
.report-eyebrow { color: #8B8D91; }
.section-title,
.report-title { color: #111214; }
.report-period {
  background: rgba(255,255,255,.72);
  border: 1rpx solid rgba(17,18,20,.06);
  box-shadow: none;
}

/* Hero: charcoal rather than blue; one restrained electric-blue sheen. */
.hero-card {
  border-radius: 30rpx;
  padding: 31rpx;
  background:
    radial-gradient(circle at 92% 5%, rgba(75, 117, 255, .22), transparent 250rpx),
    linear-gradient(145deg, #292A2D 0%, #1C1D20 56%, #151619 100%);
  border: 1rpx solid rgba(255,255,255,.07);
  box-shadow:
    0 38rpx 82rpx rgba(18, 19, 22, .27),
    0 8rpx 24rpx rgba(18, 19, 22, .14);
}
.hero-glow-primary {
  width: 230rpx;
  height: 230rpx;
  right: -88rpx;
  top: -98rpx;
  background: radial-gradient(circle, rgba(77,124,255,.25), rgba(77,124,255,0) 72%);
}
.hero-glow-green { display: none; }
.hero-status-dot {
  background: #66E3B4;
  box-shadow: 0 0 0 7rpx rgba(102,227,180,.10);
}
.hero-score-unit { color: #668EFF; }
.hero-copy-desc,
.hero-score-label,
.hero-metric-label { color: rgba(244,246,249,.54); }
.hero-metrics {
  border-color: rgba(255,255,255,.09);
}
.hero-primary-button {
  color: #151619;
  background: #F9F9F7;
  box-shadow:
    inset 0 1rpx 0 rgba(255,255,255,.95),
    0 12rpx 30rpx rgba(0,0,0,.18);
}
.hero-primary-button .line-icon { color: #B7E82A; }
.hero-secondary-button {
  height: 72rpx;
  padding: 0 23rpx;
  border-radius: 24rpx;
  color: rgba(255,255,255,.9);
  background: linear-gradient(180deg, rgba(255,255,255,.11), rgba(255,255,255,.055));
  border: 1rpx solid rgba(255,255,255,.13);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.08);
}
.hero-secondary-button .line-icon { color: #78A0FF; }

/* Controls repeat the hero's dark anchor. */
.period-switch {
  padding: 4rpx;
  background: rgba(17,18,20,.055);
  border: 1rpx solid rgba(17,18,20,.045);
}
.period-item { color: #777A80; }
.period-item.active {
  background: #17181B;
  box-shadow: 0 8rpx 20rpx rgba(17,18,20,.14);
}

/* Trend: one metric at a time, no conventional legend. */
.trend-card {
  padding: 25rpx 22rpx 18rpx;
  border: 1rpx solid rgba(17,18,20,.065);
  background: rgba(255,255,255,.82);
  box-shadow: none;
}
.trend-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 3rpx 8rpx;
}
.metric-switch {
  display: flex;
  align-items: center;
  padding: 5rpx;
  border-radius: 15rpx;
  background: #ECEDEA;
}
.metric-item {
  min-width: 94rpx;
  padding: 11rpx 16rpx;
  border-radius: 11rpx;
  color: #777A80;
  font-size: 21rpx;
  font-weight: 780;
  text-align: center;
}
.metric-item.active {
  color: #FFFFFF;
  background: #17181B;
  box-shadow: 0 7rpx 18rpx rgba(17,18,20,.16);
}
.trend-summary-block { text-align: right; }
.trend-primary-row { display: flex; align-items: baseline; justify-content: flex-end; }
.trend-primary-value {
  color: #111214;
  font-size: 43rpx;
  line-height: 1;
  font-weight: 950;
  letter-spacing: -1.2rpx;
  font-variant-numeric: tabular-nums;
}
.trend-primary-unit { margin-left: 5rpx; color: #7F8288; font-size: 20rpx; font-weight: 750; }
.trend-compare { display: block; margin-top: 8rpx; color: #888B90; font-size: 19rpx; }
.trend-compare.up { color: #23A873; }
.trend-compare.down { color: #D9832D; }
.trend-chart-wrap,
.trend-canvas { height: 286rpx; }
.trend-loading { height: 286rpx; }
.trend-loading-line { background: linear-gradient(90deg, #ECEDEB 25%, #F6F6F3 50%, #ECEDEB 75%); }
.trend-legend,
.trend-stats { display: none; }
.trend-foot {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(17,18,20,.07);
}
.trend-foot-item { flex: 1; text-align: center; }
.trend-foot-divider { width: 1rpx; height: 42rpx; background: rgba(17,18,20,.08); }
.trend-foot-value { display: block; color: #17181B; font-size: 29rpx; font-weight: 920; font-variant-numeric: tabular-nums; }
.trend-foot-unit { color: #96999D; font-size: 19rpx; }
.trend-foot-label { display: block; margin-top: 4rpx; color: #8A8D92; font-size: 18rpx; }

/* Focus: white editorial card with a single luminous progress object. */
.focus-card {
  padding: 28rpx;
  color: #111214;
  background: rgba(255,255,255,.9);
  border: 1rpx solid rgba(17,18,20,.07);
  box-shadow: none;
}
.focus-index {
  color: #FFFFFF;
  background: #17181B;
}
.focus-subject { color: #8A8D92; }
.focus-title { color: #111214; }
.focus-percent { color: #111214; }
.focus-progress-track {
  position: relative;
  height: 30rpx;
  margin-top: 27rpx;
  overflow: visible;
  border-radius: 999rpx;
  background: #D8D9D7;
  box-shadow: inset 0 1rpx 2rpx rgba(17,18,20,.08);
}
.focus-progress-fill {
  position: relative;
  height: 100%;
  min-width: 30rpx;
  border-radius: inherit;
  background: linear-gradient(90deg, #B7E82A 0%, #56BFF3 48%, #62E6B2 100%);
  box-shadow:
    0 0 18rpx rgba(77,124,255,.34),
    0 0 26rpx rgba(98,230,178,.25);
}
.focus-progress-fill::after {
  content: '';
  position: absolute;
  top: 3rpx;
  right: 4rpx;
  width: 18rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.42);
  filter: blur(3rpx);
}
.focus-footer { color: #777A80; }
.focus-action { color: #17181B; }
.focus-action .line-icon { color: #B7E82A; }
.focus-mini-list {
  border: 1rpx solid rgba(17,18,20,.06);
  box-shadow: none;
  background: rgba(255,255,255,.78);
}
.focus-mini-value { color: #17181B; }

/* Secondary cards are flatter; only the first snapshot repeats dark mode. */
.deep-analysis-shell {
  border: 1rpx solid rgba(17,18,20,.055);
  background: rgba(255,255,255,.78);
  box-shadow: none;
}
.snapshot-card {
  background: #17181B;
  border: 1rpx solid rgba(17,18,20,.06);
  box-shadow: 0 13rpx 30rpx rgba(17,18,20,.10);
}
.snapshot-card.orange,
.snapshot-card.green {
  color: #17181B;
  background: rgba(255,255,255,.82);
  border: 1rpx solid rgba(17,18,20,.065);
}
.snapshot-card.orange .snapshot-value { color: #DF872D; }
.snapshot-card.green .snapshot-value { color: #22A873; }
.snapshot-card.orange .snapshot-label,
.snapshot-card.green .snapshot-label,
.snapshot-card.orange .snapshot-note,
.snapshot-card.green .snapshot-note { color: #7F8287; }
.deep-analysis-icon { background: #ECEDEA; }
.deep-block { background: #EFefec; }
.ai-block { background: #1B1C1F; }

/* ═══════════════════════════════════════════════════════════
   Dashboard V4 — stable trend switching + tabbed deep analysis
   ═══════════════════════════════════════════════════════════ */

/* Keep the trend canvas mounted at a fixed height while data refreshes. */
.trend-card {
  position: relative;
  overflow: hidden;
}
.trend-chart-stage {
  position: relative;
  height: 286rpx;
  min-height: 286rpx;
  overflow: hidden;
}
.trend-chart-wrap,
.trend-canvas {
  width: 100%;
  height: 286rpx;
}
.trend-chart-wrap {
  opacity: 1;
  transition: opacity .18s ease;
}
.trend-chart-stage.is-updating .trend-chart-wrap {
  opacity: .52;
}
.trend-updating-badge {
  position: absolute;
  z-index: 4;
  top: 12rpx;
  right: 10rpx;
  height: 46rpx;
  padding: 0 17rpx;
  display: flex;
  align-items: center;
  gap: 9rpx;
  border-radius: 999rpx;
  color: #5F6268;
  background: rgba(244, 244, 241, .92);
  border: 1rpx solid rgba(17, 18, 20, .07);
  backdrop-filter: blur(14rpx);
  font-size: 18rpx;
  font-weight: 750;
  pointer-events: none;
}
.trend-updating-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #17181B;
  animation: trend-dot-pulse .8s ease-in-out infinite alternate;
}
@keyframes trend-dot-pulse {
  from { opacity: .3; transform: scale(.78); }
  to { opacity: 1; transform: scale(1); }
}
.trend-error-overlay {
  position: absolute;
  z-index: 3;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: rgba(244, 244, 241, .95);
}
/* Remove the old in-flow loader if stale markup remains in a local merge. */
.trend-loading { display: none !important; height: 0 !important; }

/* Deep analysis no longer has one large white wrapper. */
.deep-analysis-shell {
  margin-top: 48rpx;
  overflow: visible;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}
.deep-analysis-toggle {
  min-height: 118rpx;
  padding: 22rpx 4rpx;
  border-top: 1rpx solid rgba(17, 18, 20, .09);
  border-bottom: 1rpx solid rgba(17, 18, 20, .09);
}
.deep-analysis-title {
  font-size: 32rpx;
  letter-spacing: -.6rpx;
}
.deep-analysis-desc {
  margin-top: 7rpx;
  color: #84878C;
  font-size: 20rpx;
}
.deep-analysis-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  color: #161719;
  background: rgba(255, 255, 255, .72);
  border: 1rpx solid rgba(17, 18, 20, .065);
  box-shadow: none;
}
.deep-analysis-content {
  padding: 26rpx 0 12rpx;
}

/* Rule-based diagnosis — conclusion first, evidence second. */
.diagnosis-card {
  padding: 27rpx 27rpx 25rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .84);
  border: 1rpx solid rgba(17, 18, 20, .065);
}
.diagnosis-topline {
  display: flex;
  align-items: center;
  min-width: 0;
}
.diagnosis-signal-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #B7E82A;
  box-shadow: 0 0 0 7rpx rgba(77, 124, 255, .09);
}
.diagnosis-signal-dot.orange {
  background: #DF872D;
  box-shadow: 0 0 0 7rpx rgba(223, 135, 45, .10);
}
.diagnosis-signal-dot.green {
  background: #31B57B;
  box-shadow: 0 0 0 7rpx rgba(49, 181, 123, .10);
}
.diagnosis-kicker {
  flex: 1;
  min-width: 0;
  color: #8A8D92;
  font-size: 17rpx;
  font-weight: 850;
  letter-spacing: 1.5rpx;
}
.diagnosis-level {
  padding: 8rpx 13rpx;
  border-radius: 999rpx;
  color: #F5F5F2;
  background: #17181B;
  font-size: 17rpx;
  font-weight: 800;
}
.diagnosis-title {
  display: block;
  margin-top: 23rpx;
  color: #111214;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 950;
  letter-spacing: -1rpx;
}
.diagnosis-desc {
  display: block;
  margin-top: 11rpx;
  color: #6E7177;
  font-size: 21rpx;
  line-height: 1.58;
}
.diagnosis-evidence {
  display: flex;
  align-items: stretch;
  margin-top: 25rpx;
  padding-top: 21rpx;
  border-top: 1rpx solid rgba(17, 18, 20, .075);
}
.diagnosis-evidence-item {
  position: relative;
  flex: 1;
  min-width: 0;
  text-align: center;
}
.diagnosis-evidence-item + .diagnosis-evidence-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 5rpx;
  bottom: 5rpx;
  width: 1rpx;
  background: rgba(17, 18, 20, .075);
}
.diagnosis-evidence-value {
  display: block;
  color: #17181B;
  font-size: 29rpx;
  line-height: 1.1;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}
.diagnosis-evidence-value.orange { color: #DF872D; }
.diagnosis-evidence-value.blue { color: #B7E82A; }
.diagnosis-evidence-value.green { color: #26A873; }
.diagnosis-evidence-label {
  display: block;
  margin-top: 7rpx;
  color: #8A8D92;
  font-size: 18rpx;
}

/* Compact tabs; active state repeats the charcoal language used by Hero. */
.analysis-tabs-scroll {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}
.analysis-tabs {
  display: inline-flex;
  min-width: 100%;
  box-sizing: border-box;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #E8E8E4;
}
.analysis-tab {
  flex: 1;
  min-width: 132rpx;
  padding: 13rpx 18rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  text-align: center;
  color: #74777C;
  font-size: 20rpx;
  font-weight: 800;
  transition: color .16s ease, background .16s ease, transform .16s ease;
}
.analysis-tab.active {
  color: #FFFFFF;
  background: #17181B;
  box-shadow: 0 8rpx 18rpx rgba(17, 18, 20, .14);
}
.analysis-panel-stage {
  min-height: 520rpx;
  margin-top: 23rpx;
}
.analysis-panel {
  animation: analysis-panel-in .2s ease both;
}
@keyframes analysis-panel-in {
  from { opacity: .45; transform: translateY(7rpx); }
  to { opacity: 1; transform: translateY(0); }
}
.analysis-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 17rpx;
  padding: 0 3rpx;
}
.analysis-panel-title {
  display: block;
  color: #141517;
  font-size: 28rpx;
  font-weight: 930;
}
.analysis-panel-desc {
  display: block;
  margin-top: 5rpx;
  color: #8A8D92;
  font-size: 19rpx;
  line-height: 1.45;
}
.analysis-panel-meta {
  flex-shrink: 0;
  color: #8A8D92;
  font-size: 19rpx;
}
.analysis-empty,
.analysis-note {
  display: block;
  padding: 36rpx 24rpx;
  border-radius: 25rpx;
  text-align: center;
  color: #8A8D92;
  background: rgba(255, 255, 255, .74);
  border: 1rpx solid rgba(17, 18, 20, .055);
  font-size: 20rpx;
}

/* Subjects: true horizontal bar chart, sorted from weakest to strongest. */
.subject-bar-chart {
  padding: 20rpx 22rpx 17rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .86);
  border: 1rpx solid rgba(17, 18, 20, .055);
}
.subject-bar-row {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  padding: 4rpx 0;
  transition: opacity .16s ease, transform .16s ease;
}
.subject-bar-row-pressed {
  opacity: .72;
  transform: translateX(3rpx);
}
.subject-bar-name {
  width: 164rpx;
  flex-shrink: 0;
  overflow: hidden;
  color: #20242B;
  font-size: 22rpx;
  font-weight: 720;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-bar-plot {
  position: relative;
  height: 46rpx;
  flex: 1;
  min-width: 0;
}
.subject-bar-mark {
  position: absolute;
  top: 13rpx;
  left: 0;
  height: 20rpx;
  min-width: 5rpx;
  border-radius: 3rpx;
  background: #1A2232;
  box-shadow: 0 3rpx 8rpx rgba(26, 34, 50, .08);
}
.subject-bar-mark.weakest {
  background: #E76D48;
  box-shadow: 0 4rpx 11rpx rgba(231, 109, 72, .16);
}
.subject-bar-value {
  position: absolute;
  top: 7rpx;
  min-width: 70rpx;
  color: #6F747C;
  font-size: 22rpx;
  font-weight: 760;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.subject-bar-value.weakest {
  color: #C95D3B;
  font-weight: 900;
}
.subject-chart-note {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 13rpx 0 0 164rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid rgba(17, 18, 20, .06);
  color: #979A9F;
  font-size: 17rpx;
}
.subject-chart-note-dot {
  width: 8rpx;
  height: 8rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #E76D48;
}

/* Memory and efficiency: risk markers + dumbbell comparison. */
.compare-panel {
  padding: 25rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .86);
  border: 1rpx solid rgba(17, 18, 20, .055);
}
.compare-panel + .compare-panel { margin-top: 15rpx; }
.compare-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
}
.compare-panel-title {
  color: #17181B;
  font-size: 24rpx;
  font-weight: 900;
}
.compare-panel-status {
  color: #7E8186;
  font-size: 18rpx;
  font-weight: 760;
}
.compare-panel-status.orange { color: #C97925; }
.compare-panel-status.green { color: #24976B; }
.compare-panel-status.blue { color: #B7E82A; }
.risk-comparison {
  display: flex;
  align-items: stretch;
  margin-top: 25rpx;
}
.risk-comparison-item {
  position: relative;
  flex: 1;
  min-width: 0;
  padding-bottom: 18rpx;
}
.risk-comparison-line {
  width: 1rpx;
  height: 63rpx;
  margin: 1rpx 18rpx 0;
  background: rgba(17, 18, 20, .075);
}
.risk-comparison-value {
  display: block;
  color: #17181B;
  font-size: 36rpx;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
  transition: color .18s ease;
}
.risk-comparison-item.active .risk-comparison-value { color: #D9792D; }
.risk-comparison-label {
  display: block;
  margin-top: 6rpx;
  color: #8B8D92;
  font-size: 17rpx;
  line-height: 1.35;
}
.risk-current-mark {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 5rpx;
  border-radius: 99rpx;
  background: #E79042;
  opacity: 0;
  transition: width .22s ease, opacity .18s ease;
