  font-size: 26rpx;
  color: var(--danger, #EF4444);
  margin-bottom: 16rpx;
}
.llm-retry-btn {
  display: inline-flex;
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: var(--bg-surface, #F6F9FF);
  color: var(--primary, #4F7FFF);
  font-size: 24rpx;
  font-weight: 700;
  min-height: 44px;
  align-items: center;
}
.llm-result-card {
  padding: 28rpx;
  background: var(--bg-card, #FFFFFF);
  border-radius: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid var(--border-color, #E2EAF7);
  margin-bottom: 28rpx;
}
.llm-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.llm-result-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-light, #EEF4FF);
  color: var(--primary, #4F7FFF);
  font-size: 20rpx;
  font-weight: 800;
}
.llm-result-actions {
  display: flex;
  gap: 16rpx;
}
.llm-action-link {
  font-size: 22rpx;
  color: var(--primary, #4F7FFF);
  font-weight: 600;
  min-height: 44px;
  display: flex;
  align-items: center;
}
.llm-summary {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  line-height: 1.4;
  margin-bottom: 18rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--border-color, #E2EAF7);
}
.llm-section { margin-bottom: 18rpx; }
.llm-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  margin-bottom: 10rpx;
}
.llm-finding-item {
  display: flex;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.5;
  margin-bottom: 8rpx;
}
.llm-bullet {
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--primary, #4F7FFF);
  flex-shrink: 0;
  margin-top: 10rpx;
}
.llm-bullet.warn { background: var(--warning, #F59E0B); }
.llm-action-item {
  padding: 16rpx;
  border-radius: 18rpx;
  background: var(--bg-surface, #F6F9FF);
  margin-bottom: 10rpx;
  -webkit-tap-highlight-color: transparent;
}
.llm-action-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
  margin-bottom: 4rpx;
}
.llm-action-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.4;
}
.llm-generated-at {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
