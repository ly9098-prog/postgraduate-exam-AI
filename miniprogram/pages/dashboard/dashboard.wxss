/* ════════════════════════════════════════════
   ADAPTIVE — mini gauge replaces progress bar
   ════════════════════════════════════════════ */
.adaptive-card {
  padding: 20rpx 24rpx;
}
.adaptive-header { margin-bottom: 14rpx; }
.adaptive-status-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--primary-light, #EEF4FF);
  color: var(--primary, #4F7FFF);
