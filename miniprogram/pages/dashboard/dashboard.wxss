}
.llm-action-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
  margin-bottom: 4rpx;
}
.llm-action-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.4;
}
.llm-generated-at {
  display: block;
  margin-top: 14rpx;
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  text-align: right;
}
.llm-result-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(79,127,255,.08);
}
.llm-disclaimer {
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  line-height: 1.4;
  flex: 1;
}
.llm-feedback-btn {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #4F7FFF;
  background: rgba(79,127,255,.08);
}

/* ════════════════════════════════════════════
   YEARLY — info strip
   ════════════════════════════════════════════ */
.yearly-section { margin-bottom: 32rpx; }
.yearly-strip {
  display: flex; align-items: center; gap: 14rpx;
  padding: 20rpx 24rpx;
  background: rgba(238,244,253,.7);
  border-radius: 24rpx;
}
.yearly-dots {
  display: flex; align-items: center; gap: 6rpx; flex-shrink: 0;
}
.yearly-dot {
  width: 8rpx; height: 8rpx; border-radius: 50%;
  background: linear-gradient(135deg, #4F7FFF, #6EC1FF);
}
.yearly-dash {
  width: 16rpx; height: 2rpx; border-radius: 1rpx;
  background: rgba(79,127,255,.3);
}
.yearly-info { flex: 1; min-width: 0; }
.yearly-info-title {
  display: block; font-size: 24rpx; font-weight: 800; color: #18233A; line-height: 1.3;
}
.yearly-info-sub {
  display: block; margin-top: 2rpx; font-size: 20rpx; color: #8391A8;
}
.yearly-more {
  flex-shrink: 0;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: #4F7FFF;
}
.yearly-more-pressed { opacity: 0.7; }
.yearly-heatmap {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
}
.yearly-heatmap.expanded { max-height: 600rpx; }
.yearly-heat-scroll {
  width: 100%;
  white-space: nowrap;
}
.yearly-heat-grid {
  display: inline-flex;
  gap: 6rpx;
  min-width: 100%;
  padding: 16rpx 0 12rpx;
}
.year-week {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.year-day {
  width: 16rpx;
  height: 16rpx;
  border-radius: 5rpx;
  background: #E8EEF8;
  position: relative;
}
.year-day.lv1, .legend-cell.lv1 { background: #DDE8FF; }
.year-day.lv2, .legend-cell.lv2 { background: #AFC8FF; }
.year-day.lv3, .legend-cell.lv3 { background: #79A5FF; }
.year-day.lv4, .legend-cell.lv4 { background: var(--primary, #4F7FFF); }
.year-day-tip {
  position: absolute;
  bottom: calc(100% + 8rpx);
  left: 50%;
  transform: translateX(-50%);
  padding: 6rpx 10rpx;
  border-radius: 10rpx;
  background: rgba(24, 35, 58, 0.9);
  color: #FFFFFF;
  font-size: 18rpx;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.18s ease;
  z-index: 4;
}
.year-day-pressed .year-day-tip { opacity: 1; }
.heat-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: var(--text-hint, #8EA0BA);
  font-size: 20rpx;
  padding-bottom: 16rpx;
}
.legend-cell {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: #E8EEF8;
}
.yearly-loading { padding: 40rpx; text-align: center; }
.yearly-loading-text { font-size: 24rpx; color: var(--text-hint, #8EA0BA); }
.yearly-error { padding: 40rpx; text-align: center; }
.yearly-error .yetxt { font-size: 24rpx; color: var(--text-hint, #8EA0BA); }

/* ── Footer ── */
.footer-safe { height: 20rpx; }

/* ════════════════════════════════════════════
   DIAGNOSIS GRID
   ════════════════════════════════════════════ */
.diagnosis-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.diag-card {
  padding: 24rpx 16rpx;
  text-align: center;
}
.diag-label {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary, #18233A);
  margin-bottom: 12rpx;
}
.diag-score-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
}
.diag-score-canvas {
  width: 120rpx;
  height: 120rpx;
}
.diag-score-center {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.diag-score-num {
  font-size: 38rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.diag-score-unit {
  font-size: 18rpx;
  font-weight: 400;
  color: var(--text-hint, #8EA0BA);
}
.diag-score-label {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary, #617089);
}
.diag-meta {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
}
.diag-big-text {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.diag-big-val {
  font-size: 52rpx;
  font-weight: 900;
  color: var(--warning, #F59E0B);
  font-variant-numeric: tabular-nums;
  line-height: 1;
}
.diag-big-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-hint, #8EA0BA);
}

/* ════════════════════════════════════════════
   SUBJECT CARDS (enhanced)
   ════════════════════════════════════════════ */
.sci-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.sci-arrow {
  color: var(--text-hint, #8EA0BA);
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}
.sci-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  margin-top: 4rpx;
}
.sci-status-tag {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.4;
}
.sci-status-tag.tag-green { background: var(--success-light, #ECFDF3); color: var(--success, #22C55E); }
.sci-status-tag.tag-orange { background: var(--warning-light, #FFF7E8); color: var(--warning, #F59E0B); }
.sci-status-tag.tag-red { background: var(--danger-light, #FEF2F2); color: var(--danger, #EF4444); }
.sci-meta-tag {
  font-size: 18rpx;
  color: var(--text-hint, #8EA0BA);
}
.sci-bottom {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
  width: 100%;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--border-color, #E2EAF7);
}
.sci-weak-label {
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
  flex-shrink: 0;
}
.sci-weak-topic {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--danger-light, #FEF2F2);
  color: var(--danger, #EF4444);
  font-size: 20rpx;
  font-weight: 600;
}
.sci-suggestion {
  width: 100%;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--primary, #4F7FFF);
  font-weight: 600;
  line-height: 1.4;
}

/* ════════════════════════════════════════════
   WEAK SECTION — no-card list
   ════════════════════════════════════════════ */
.weak-section {
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}
.weak-head {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 14rpx;
  padding: 0 2rpx;
}
.weak-head .zone-head-icon {
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: linear-gradient(135deg, rgba(79,127,255,.16), rgba(110,193,255,.08));
  display: flex; align-items: center; justify-content: center;
}
.weak-head .zone-head-icon .line-icon { width: 18rpx; height: 18rpx; color: #4F7FFF; }
.weak-head-title {
  font-size: 24rpx; font-weight: 800; color: #18233A; line-height: 1.3;
}
.weak-head-hint {
  margin-left: auto; font-size: 20rpx; color: #8391A8; font-weight: 600;
}
.weak-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(218,228,243,.9);
  overflow: hidden;
}
.weak-item {
  display: flex; align-items: center;
  padding: 18rpx 20rpx; gap: 12rpx;
  transition: background .15s;
}
.weak-item-pressed { background: #F8FAFF; }
.weak-item + .weak-item {
  border-top: 1rpx solid #EDF1F7;
}
.weak-rank {
  font-size: 24rpx; font-weight: 900;
  width: 34rpx; text-align: center; flex-shrink: 0;
}
.weak-info { flex: 1; min-width: 0; }
.weak-name {
  display: block; font-size: 24rpx; font-weight: 700;
  color: #18233A; line-height: 1.35;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.weak-subject {
  display: block; font-size: 18rpx; color: #8391A8; margin-top: 2rpx;
}
.weak-mastery {
  flex-shrink: 0; font-size: 24rpx; font-weight: 800;
}
.weak-mastery.danger { color: #EF4444; }
.weak-mastery.warning { color: #F59E0B; }
.weak-mastery.primary { color: #4F7FFF; }
.weak-count {
  flex-shrink: 0; font-size: 18rpx; color: #8391A8; margin-left: 4rpx;
}

/* ════════════════════════════════════════════
   REPEAT WRONG ANALYSIS
   ════════════════════════════════════════════ */
.repeat-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
}
.repeat-stat {
  text-align: center;
  flex-shrink: 0;
}
.repeat-stat-val {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}
.repeat-stat-val.danger { color: var(--danger, #EF4444); }
.repeat-stat-val.primary { color: var(--primary, #4F7FFF); }
.repeat-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint, #8EA0BA);
}
.repeat-info { flex: 1; min-width: 0; }
.repeat-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.4;
}
.repeat-topics {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 10rpx;
}
.repeat-topics-label {
  font-size: 20rpx;
  color: var(--text-hint, #8EA0BA);
}
.repeat-topic-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--warning-light, #FFF7E8);
  color: var(--warning, #F59E0B);
  font-size: 20rpx;
  font-weight: 600;
}

/* ════════════════════════════════════════════
   SPEED — data dialogue
   ════════════════════════════════════════════ */
.speed-section { margin-bottom: 32rpx; padding: 0 4rpx; }
.speed-head {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 14rpx;
}
.speed-head .zone-head-icon {
  width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: linear-gradient(135deg, rgba(79,127,255,.16), rgba(110,193,255,.08));
  display: flex; align-items: center; justify-content: center;
}
.speed-head .zone-head-icon .line-icon { width: 18rpx; height: 18rpx; color: #4F7FFF; }
.speed-head-title {
  font-size: 24rpx; font-weight: 800; color: #18233A; line-height: 1.3;
}
.speed-head-diff {
  font-size: 20rpx; font-weight: 800; color: #F59E0B;
  padding: 2rpx 10rpx; border-radius: 999rpx;
  background: rgba(245,158,11,.1);
}
.speed-compare {
  display: flex; align-items: flex-start; gap: 0;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid rgba(218,228,243,.9);
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
}
.speed-side { flex: 1; text-align: center; }
.speed-side-label {
  display: block; font-size: 20rpx; color: #8391A8; margin-bottom: 4rpx;
}
.speed-side-num {
  display: block; font-size: 38rpx; font-weight: 900; line-height: 1.1;
  font-variant-numeric: tabular-nums; margin-bottom: 6rpx;
}
.speed-side-num.green { color: #22C55E; }
.speed-side-num.orange { color: #F59E0B; }
.speed-bar-correct, .speed-bar-wrong {
  height: 6rpx; border-radius: 3rpx; max-width: 100%;
}
.speed-bar-correct { background: rgba(34,197,94,.3); margin-left: auto; }
.speed-bar-wrong { background: rgba(245,158,11,.3); margin-right: auto; }
.speed-divider {
  width: 1rpx; height: 60rpx;
  background: #E2EAF7; flex-shrink: 0; margin: 8rpx 20rpx 0;
}
.speed-conclusion {
  display: block;
  padding: 12rpx 18rpx; border-radius: 18rpx;
  background: rgba(79,127,255,.08);
  font-size: 22rpx; color: #617089; line-height: 1.5;
}

/* ════════════════════════════════════════════
   NVR — continuous data
   ════════════════════════════════════════════ */
.nvr-section {
  margin-bottom: 32rpx;
  padding: 0 4rpx;
}
.nvr-head {
  display: flex; align-items: center; gap: 8rpx;
  margin-bottom: 10rpx;
}
.nvr-head-title {
  font-size: 20rpx; font-weight: 700; color: #74839A;
}
.nvr-head-val {
  font-size: 22rpx; font-weight: 800; color: #18233A;
  font-variant-numeric: tabular-nums;
}
.nvr-head-val.green { color: #22C55E; }
.nvr-head-count {
  font-size: 18rpx; color: #8391A8;
}
.nvr-head-divider {
  width: 1rpx; height: 24rpx; background: #E2EAF7; margin: 0 4rpx;
}
.nvr-bar-track {
  height: 8rpx;
  border-radius: 999rpx;
  background: #E8EEF8;
  overflow: hidden;
  margin-bottom: 10rpx;
}
.nvr-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF, #6EC1FF);
}
.nvr-summary {
  display: block;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.5;
  padding: 10rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(79,127,255,.08);
}

/* ════════════════════════════════════════════
   ACTION PLAN
   ════════════════════════════════════════════ */
.action-plan-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  min-height: 44px;
}
.api-priority {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.api-num {
  font-size: 22rpx;
  font-weight: 900;
  color: #FFFFFF;
}
.api-content {
  flex: 1;
  min-width: 0;
}
.api-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary, #4F7FFF);
  line-height: 1.3;
}
.api-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #617089);
  line-height: 1.4;
}
.api-arrow {
  width: 28rpx;
  height: 28rpx;
  color: var(--text-hint, #8EA0BA);
  flex-shrink: 0;
}

/* ════════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════════ */
@media screen and (max-width: 370px) {
  .risk-grid { gap: 10rpx; }
  .yearly-stats { gap: 10rpx; }
  .quick-actions { gap: 10rpx; }
  .subject-chart-area { flex-direction: column; }
  .subject-donut-wrap { width: 100%; flex-direction: row; gap: 16rpx; }
}
@media (prefers-reduced-motion: reduce) {
  .dashboard-page.ready,
  .tab-btn {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
