  margin-top: 14rpx;
}
.insight-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--bg-surface, #F6F9FF);
  color: var(--text-secondary, #617089);
  font-size: 20rpx;
  font-weight: 600;
}

/* ════════════════════════════════════════════
   TRENDS
   ════════════════════════════════════════════ */
.trend-card { padding: 24rpx; }
.trend-chart-wrap {
  height: 260rpx;
  margin: 0 -4rpx;
}
.trend-canvas {
  width: 100%;
  height: 260rpx;
}
.trend-legend {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-top: 16rpx;
}
.trend-legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #617089);
}
.trend-legend-bar {
  width: 20rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: rgba(79, 127, 255, 0.32);
}
.trend-legend-line {
  width: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: rgba(34, 197, 94, 0.72);
}
.trend-error-text {
  font-size: 26rpx;
  color: var(--text-secondary, #617089);
}
.trend-error-action {
