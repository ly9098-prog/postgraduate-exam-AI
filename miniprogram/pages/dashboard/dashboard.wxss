  font-size: 28rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(79, 127, 255, 0.28);
  transition: transform 0.16s ease, opacity 0.16s ease;
}
.primary-action-pressed { transform: scale(0.97); opacity: 0.88; }

/* ════════════════════════════════════════════
   INSIGHT
   ════════════════════════════════════════════ */
.insight-card {
  padding: 28rpx;
  margin-bottom: 28rpx;
}
.insight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.insight-priority-tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
