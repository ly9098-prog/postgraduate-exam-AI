<view class="page {{darkMode ? 'dark' : ''}} {{pageEntered ? 'entered' : ''}}">

  <!-- ===== LOADING ===== -->
  <view class="load-wrap" wx:if="{{loading}}">
    <view class="load-dots">
      <view class="load-dot" style="animation-delay:0ms"></view>
      <view class="load-dot" style="animation-delay:150ms"></view>
      <view class="load-dot" style="animation-delay:300ms"></view>
    </view>
    <text class="load-text">加载学习数据...</text>
  </view>

  <!-- ===== MAIN CONTENT ===== -->
  <block wx:else>

    <!-- ════════════════════════════════════════════
         TIER 1 · 今日概览
         ════════════════════════════════════════════ -->
    <view class="section">
      <view class="today-bento">
        <!-- Score Ring + Mini Stats -->
        <view class="t1-ring-card">
          <view class="ring-wrap">
            <canvas class="ring-canvas" canvas-id="score-ring" id="score-ring"></canvas>
            <view class="ring-center">
              <text class="ring-pct">{{overview._accuracyPct || '0'}}<text class="ring-pct-sym">%</text></text>
              <text class="ring-label">总正确率</text>
            </view>
          </view>
          <view class="t1-stats">
            <text class="t1-eyebrow">今日学习</text>
            <view class="t1-stat-row">
              <text class="t1-stat-label">刷题</text>
              <text class="t1-stat-value">{{overview.today_questions || 0}}</text>
              <text class="t1-stat-unit">题</text>
            </view>
            <view class="t1-stat-row">
              <text class="t1-stat-label">正确</text>
              <text class="t1-stat-value t1-correct">{{overview.today_correct || 0}}</text>
              <text class="t1-stat-unit">题</text>
            </view>
            <view class="t1-stat-row">
              <text class="t1-stat-label">时长</text>
              <text class="t1-stat-value t1-duration">{{overview._todayDurationText || '0min'}}</text>
            </view>
          </view>
        </view>

        <!-- Streak + Due Reviews -->
        <view class="t1-compact-row">
          <view class="t1-compact-card streak-card">
            <view class="compact-icon-wrap streak-icon-wrap">
              <text class="compact-icon">🔥</text>
            </view>
            <text class="compact-num">{{overview.consecutive_days || 0}}</text>
            <text class="compact-label">连续学习</text>
            <text class="compact-hint">天数</text>
          </view>
          <view class="t1-compact-card due-card">
            <view class="compact-icon-wrap due-icon-wrap">
              <text class="compact-icon">📝</text>
            </view>
            <text class="compact-num">{{overview.due_review_count || 0}}</text>
            <text class="compact-label">待复习</text>
            <text class="compact-hint">题目</text>
          </view>
          <view class="t1-compact-card total-card">
            <view class="compact-icon-wrap total-icon-wrap">
              <text class="compact-icon">📊</text>
            </view>
            <text class="compact-num">{{overview.total_questions || 0}}</text>
            <text class="compact-label">累计刷题</text>
            <text class="compact-hint">总题量</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ════════════════════════════════════════════
         TIER 2 · 学习趋势
         ════════════════════════════════════════════ -->
    <view class="section">
      <view class="section-head">
        <view class="sh-left">
          <text class="sh-title">学习趋势</text>
          <text class="sh-desc">观察节奏，保持稳定</text>
        </view>
        <view class="tab-switch">
          <text class="tab-btn {{trendDays === 7 ? 'active' : ''}}" data-days="7" bindtap="onTrendTab">7天</text>
          <text class="tab-btn {{trendDays === 30 ? 'active' : ''}}" data-days="30" bindtap="onTrendTab">30天</text>
        </view>
      </view>

      <view class="card trend-card" wx:if="{{trends.length > 0}}">
        <view class="trend-chart-wrap">
          <canvas class="trend-canvas" canvas-id="trend-line" id="trend-line"></canvas>
        </view>
        <view class="trend-meta">
          <view class="trend-meta-item">
            <text class="trend-meta-val">{{trendMeta.totalQuestions || 0}}</text>
            <text class="trend-meta-label">累计做题</text>
          </view>
          <view class="trend-meta-item">
            <text class="trend-meta-val">{{trendMeta.avgAccuracyText || '0%'}}</text>
            <text class="trend-meta-label">平均正确率</text>
          </view>
          <view class="trend-meta-item">
            <text class="trend-meta-val">{{trendMeta.activeDays || 0}}<text class="trend-meta-unit">/{{trendDays}}</text></text>
            <text class="trend-meta-label">活跃天数</text>
          </view>
        </view>
        <!-- Activity heat dots -->
        <view class="heat-bar">
          <view class="heat-cell {{d._heatClass}}" wx:for="{{trends}}" wx:key="date" wx:for-index="di">
            <text class="heat-tip">{{d._shortDate}}</text>
          </view>
        </view>
      </view>
      <view class="empty-card" wx:if="{{trends.length === 0}}">
        <text class="empty-icon">📈</text>
        <text class="empty-title">暂无趋势数据</text>
        <text class="empty-desc">坚持练习后会生成学习趋势</text>
      </view>
    </view>

    <!-- ════════════════════════════════════════════
         TIER 3 · 学科分析
         ════════════════════════════════════════════ -->
    <view class="section">
      <view class="section-head">
        <view class="sh-left">
          <text class="sh-title">学科分析</text>
          <text class="sh-desc">看清强弱项，调整复习策略</text>
        </view>
      </view>

      <block wx:if="{{subjects.length > 0}}">
        <!-- Donut + Legend -->
        <view class="card subject-card">
          <view class="subject-top">
            <view class="donut-wrap">
              <canvas class="donut-canvas" canvas-id="subject-donut" id="subject-donut"></canvas>
              <view class="donut-center">
                <text class="donut-total">{{subjectTotal}}</text>
                <text class="donut-label">总题量</text>
              </view>
            </view>
            <view class="subject-legend">
              <view class="subj-legend-row" wx:for="{{subjects}}" wx:key="subject" data-subject="{{item.subject}}" bindtap="onSubjectTap">
                <view class="legend-dot" style="background:{{item._color}}"></view>
                <view class="legend-info">
                  <text class="legend-name">{{item._label}}</text>
                  <text class="legend-share">{{item._sharePct}}%</text>
                </view>
                <text class="legend-acc {{item._accClass}}">{{item._accPct}}%</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Subject accuracy bars -->
        <view class="card subj-bars-card">
          <view class="card-label-row">
            <text class="card-label">各科正确率</text>
            <text class="card-label-hint">点击查看详情</text>
          </view>
          <view class="subj-bars">
            <view class="subj-bar-row" wx:for="{{subjects}}" wx:key="subject" data-subject="{{item.subject}}" bindtap="onSubjectTap">
              <view class="sbar-top">
                <view class="sbar-dot" style="background:{{item._color}}"></view>
                <text class="sbar-name">{{item._label}}</text>
                <text class="sbar-pct {{item._accClass}}">{{item._accPct}}%</text>
              </view>
              <view class="sbar-track">
                <view class="sbar-fill" style="width:{{item._accPct}}%;background:{{item._accColor}}"></view>
              </view>
              <view class="sbar-meta">
                <text>{{item.total_questions}}题</text>
                <text>{{item._durationText}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="empty-card" wx:if="{{subjects.length === 0}}">
        <text class="empty-icon">📚</text>
        <text class="empty-title">暂无学科数据</text>
        <text class="empty-desc">开始练习后会生成学科分布</text>
      </view>
    </view>

    <!-- ════════════════════════════════════════════
         TIER 4 · 掌握与成就
         ════════════════════════════════════════════ -->
    <view class="section">
      <view class="section-head">
        <view class="sh-left">
          <text class="sh-title">掌握情况</text>
          <text class="sh-desc">了解薄弱点，及时复盘</text>
        </view>
      </view>

      <view class="mastery-grid" wx:if="{{forgetting && forgetting._hasRisk}}">
        <!-- 高频遗忘 -->
        <view class="mastery-card mc-danger">
          <view class="mc-icon-wrap">
            <text class="mc-icon">⚠️</text>
          </view>
          <text class="mc-num">{{forgetting.high_forget_count || 0}}</text>
          <text class="mc-label">高频遗忘</text>
          <text class="mc-desc">反复出错，优先复盘</text>
        </view>
        <!-- 长期未掌握 -->
        <view class="mastery-card mc-warning">
          <view class="mc-icon-wrap">
            <text class="mc-icon">🔒</text>
          </view>
          <text class="mc-num">{{forgetting.stuck_questions || 0}}</text>
          <text class="mc-label">长期未掌握</text>
          <text class="mc-desc">需要拆解知识点</text>
        </view>
        <!-- 假掌握 -->
        <view class="mastery-card mc-primary">
          <view class="mc-icon-wrap">
            <text class="mc-icon">🎯</text>
          </view>
          <text class="mc-num">{{forgetting._pseudoMasteredCount || 0}}</text>
          <text class="mc-label">假掌握</text>
          <text class="mc-desc">需要巩固验证</text>
        </view>
      </view>

      <!-- Overall mastery progress -->
      <view class="card mastery-progress-card" wx:if="{{overview.total_questions > 0}}">
        <view class="mp-header">
          <text class="mp-title">总掌握进度</text>
          <text class="mp-pct">{{overview._masteryPct}}%</text>
        </view>
        <view class="mp-track">
          <view class="mp-fill" style="width:{{overview._masteryPct}}%"></view>
        </view>
        <view class="mp-meta">
          <text class="mp-meta-item">已掌握 {{overview.mastered_count || 0}} 题</text>
          <text class="mp-meta-item">总错题 {{overview._wrongTotal || 0}} 题</text>
        </view>
      </view>

      <!-- Average answer time mini card -->
      <view class="card avg-time-card" wx:if="{{behavior && behavior.avg_time_sec > 0}}">
        <view class="at-left">
          <text class="at-label">平均答题用时</text>
          <text class="at-hint">解题速度监测</text>
        </view>
        <view class="at-right">
          <text class="at-value">{{behavior._avgTimeText || '0秒'}}</text>
        </view>
      </view>
    </view>

    <!-- ════════════════════════════════════════════
         FOOTER
         ════════════════════════════════════════════ -->
    <view class="footer-safe"></view>
  </block>
</view>
