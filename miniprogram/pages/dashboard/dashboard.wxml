<premium-nav title="学习报告" variant="light" bind:back="goBack" />
<app-dialog id="appDialog"></app-dialog>
<view class="dashboard-page {{pageReady ? 'ready' : ''}}">
  <!-- Initial loading -->
  <view class="dashboard-loading" wx:if="{{initialLoading && !pageReady}}">
    <view class="loading-skeleton">
      <view class="sk-line sk-line-short"></view>
      <view class="sk-hero"></view>
      <view class="sk-card"></view>
      <view class="sk-card sk-card-small"></view>
    </view>
  </view>

  <!-- Error -->
  <view class="dashboard-state" wx:elif="{{error && !pageReady}}">
    <view class="state-mark">!</view>
    <text class="state-title">学习报告加载失败</text>
    <text class="state-desc">检查网络后重新加载</text>
    <button class="state-button" bindtap="onRetry">重新加载</button>
  </view>

  <!-- Empty -->
  <view class="dashboard-state" wx:elif="{{!initialLoading && !error && pageReady && !_hasData}}">
    <view class="empty-visual">
      <view class="empty-chart-line line-a"></view>
      <view class="empty-chart-line line-b"></view>
      <view class="empty-chart-line line-c"></view>
      <view class="empty-chart-dot"></view>
    </view>
    <text class="state-kicker">MEMOGRAD REPORT</text>
    <text class="state-title">从第一组练习开始</text>
    <text class="state-desc">完成练习后，这里会生成趋势、薄弱点与诊断报告。</text>
    <button class="state-button" bindtap="goPractice">开始练习</button>
    <text class="state-link" bindtap="goWrongBook">查看错题本</text>
  </view>

  <!-- Main -->
  <block wx:else>
    <view class="refresh-hint" wx:if="{{backgroundRefreshing}}">正在更新学习数据…</view>

    <!-- Page intro -->
    <view class="report-intro">
      <view>
        <text class="report-eyebrow">LEARNING REPORT</text>
        <text class="report-title">最近学得怎么样</text>
      </view>
      <view class="report-period">近 {{trend ? trend.days : 7}} 天</view>
    </view>

    <!-- Shared hero region: both panels stay mounted so switching never changes page height. -->
    <view class="hero-card hero-card-{{heroCardMode}}" wx:if="{{hero}}">
      <view class="hero-glow hero-glow-primary"></view>
      <view class="hero-glow hero-glow-green"></view>

      <view class="hero-card-deck">
        <view class="hero-card-panel {{heroCardMode === 'summary' ? 'is-active' : 'is-inactive is-left'}}" aria-hidden="{{heroCardMode !== 'summary'}}">
          <view class="hero-topline">
            <view class="hero-status-dot"></view>
            <text class="hero-status">{{trend ? trend.statusTitle : '学习状态'}}</text>
            <view class="hero-top-actions">
              <text class="hero-period">RECENT {{trend ? trend.days : 7}} DAYS</text>
              <view class="hero-mode-switch" bindtap="toggleHeroCard" hover-class="surface-pressed" aria-role="button" aria-label="切换到选择题失分预算">
                <text>失分预算</text>
                <text class="line-icon icon-chevron-right"></text>
              </view>
            </view>
          </view>

          <view class="hero-main">
            <view class="hero-score-block">
              <view class="hero-score-row">
                <text class="hero-score">{{trend ? trend.avgAccuracyPct : hero.totalAccuracyPct}}</text>
                <text class="hero-score-unit">%</text>
              </view>
              <text class="hero-score-label">平均正确率</text>
            </view>
            <view class="hero-copy">
              <text class="hero-copy-title">{{subtitle}}</text>
              <text class="hero-copy-desc" wx:if="{{trend && trend.summary}}">{{trend.summary}}</text>
              <text class="hero-copy-desc" wx:else>持续练习后，报告会越来越准确。</text>
            </view>
          </view>

          <view class="hero-metrics">
            <view class="hero-metric">
              <text class="hero-metric-value">{{trend ? trend.totalQuestions : hero.totalQuestions}}</text>
              <text class="hero-metric-label">累计做题</text>
            </view>
            <view class="hero-metric-divider"></view>
            <view class="hero-metric">
              <text class="hero-metric-value accent-green">{{trend ? trend.activeDays : hero.consecutiveDays}}</text>
              <text class="hero-metric-label">活跃天数</text>
            </view>
            <view class="hero-metric-divider"></view>
            <view class="hero-metric">
              <text class="hero-metric-value accent-orange">{{hero.dueReviewCount}}</text>
              <text class="hero-metric-label">待复习</text>
            </view>
          </view>

          <view class="hero-actions">
            <button class="hero-primary-button" bindtap="goPractice" hover-class="button-pressed">
              <text class="line-icon icon-play"></text>
              <text>继续练习</text>
            </button>
            <view class="hero-secondary-button" bindtap="goReview" hover-class="surface-pressed">
              <text>去复习</text>
              <text class="line-icon icon-chevron-right"></text>
            </view>
          </view>
        </view>

        <view class="hero-card-panel {{heroCardMode === 'budget' ? 'is-active' : 'is-inactive is-right'}}" aria-hidden="{{heroCardMode !== 'budget'}}">
          <view class="hero-topline">
            <view class="hero-status-dot"></view>
            <text class="hero-status">选择题失分预算</text>
            <view class="hero-top-actions">
              <text class="hero-period">TARGET 130 · CHOICE ONLY</text>
              <view class="hero-mode-switch" bindtap="toggleHeroCard" hover-class="surface-pressed" aria-role="button" aria-label="切换到学习状态">
                <text>学习状态</text>
                <text class="line-icon icon-chevron-right"></text>
              </view>
            </view>
          </view>

          <view class="hero-budget-main">
            <view class="hero-budget-score-block">
              <view class="hero-budget-score-row">
                <text class="hero-budget-prefix">≤</text>
                <text class="hero-budget-score">{{choiceLossBudget.lossBudgetPoints}}</text>
                <text class="hero-budget-unit">分</text>
              </view>
              <text class="hero-score-label">选择题允许失分</text>
            </view>
            <view class="hero-copy hero-budget-copy">
              <text class="hero-copy-title">目标 ≥ {{choiceLossBudget.targetPoints}} / {{choiceLossBudget.totalPoints}} 分</text>
              <text class="hero-copy-desc">{{choiceLossBudget.statusText}}</text>
              <text class="hero-budget-note">130 分目标下建议最多错 {{choiceLossBudget.maxWrongQuestions}} 题；仅按已有四科选择题正确率估算。</text>
            </view>
          </view>

          <view class="hero-budget-subjects">
            <view class="hero-budget-subject" wx:for="{{choiceLossBudget.subjects}}" wx:key="code">
              <text class="hero-budget-subject-name">{{item.name}}</text>
              <text class="hero-budget-subject-value {{item.hasData ? '' : 'is-empty'}}">{{item.lossText}}</text>
            </view>
          </view>

          <view class="hero-budget-coverage">
            <view class="hero-budget-coverage-head">
              <text>科目数据覆盖</text>
              <text>{{choiceLossBudget.coveredSubjects}} / 4</text>
            </view>
            <view class="hero-budget-coverage-track">
              <view class="hero-budget-coverage-fill" style="width: {{choiceLossBudget.coveragePct}}%;"></view>
            </view>
          </view>

          <view class="hero-actions hero-budget-actions">
            <button class="hero-primary-button" bindtap="goPractice" hover-class="button-pressed">
              <text class="line-icon icon-play"></text>
              <text>继续积累数据</text>
            </button>
            <view class="hero-secondary-button" bindtap="toggleHeroCard" hover-class="surface-pressed">
              <text>返回学习状态</text>
              <text class="line-icon icon-chevron-right"></text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- P0: Trend -->
    <view class="dashboard-section trend-section">
      <view class="section-heading">
        <view>
          <text class="section-kicker">TREND</text>
          <text class="section-title">学习趋势</text>
        </view>
        <view class="period-switch">
          <text class="period-item {{_activeTabDays == 7 ? 'active' : ''}}" data-days="7" bindtap="onTrendTab">7天</text>
          <text class="period-item {{_activeTabDays == 30 ? 'active' : ''}}" data-days="30" bindtap="onTrendTab">30天</text>
          <text class="period-item {{_activeTabDays == 90 ? 'active' : ''}}" data-days="90" bindtap="onTrendTab">90天</text>
        </view>
      </view>

      <view class="trend-card">
        <view class="trend-toolbar" wx:if="{{trend}}">
          <view class="metric-switch">
            <text class="metric-item {{trendMetric == 'accuracy' ? 'active' : ''}}" data-metric="accuracy" bindtap="onTrendMetric">正确率</text>
            <text class="metric-item {{trendMetric == 'questions' ? 'active' : ''}}" data-metric="questions" bindtap="onTrendMetric">做题量</text>
          </view>
          <view class="trend-summary-block">
            <view class="trend-primary-row">
              <text class="trend-primary-value" wx:if="{{trendMetric == 'accuracy'}}">{{trend.avgAccuracyPct}}%</text>
              <text class="trend-primary-value" wx:else>{{trend.totalQuestions}}</text>
              <text class="trend-primary-unit" wx:if="{{trendMetric == 'questions'}}">题</text>
            </view>
            <text class="trend-compare {{trendMetric == 'accuracy' ? trend.accuracyCompareClass : trend.questionsCompareClass}}">
              {{trendMetric == 'accuracy' ? trend.accuracyCompareText : trend.questionsCompareText}}
            </text>
          </view>
        </view>

        <view class="trend-series-key" wx:if="{{trend}}">
          <view class="trend-key-set" wx:if="{{trendMetric == 'questions'}}">
            <view class="trend-key-item"><text class="trend-key-swatch correct"></text><text>正确题</text></view>
            <view class="trend-key-item"><text class="trend-key-swatch current"></text><text>本期总量</text></view>
            <view class="trend-key-item" wx:if="{{trend.hasPrevious}}"><text class="trend-key-swatch previous"></text><text>上期总量</text></view>
          </view>
          <view class="trend-key-set" wx:else>
            <view class="trend-key-item"><text class="trend-key-swatch accuracy-current"></text><text>本期</text></view>
            <view class="trend-key-item" wx:if="{{trend.hasPrevious}}"><text class="trend-key-swatch accuracy-previous"></text><text>上期</text></view>
          </view>
        </view>

        <view class="trend-chart-stage {{trendLoading ? 'is-updating' : ''}}">
          <view class="trend-chart-wrap" hidden="{{!trend}}">
            <canvas class="trend-canvas" canvas-id="trend-chart" id="trend-chart"></canvas>
          </view>
          <view class="trend-updating-badge" wx:if="{{trendLoading}}">
            <view class="trend-updating-dot"></view>
            <text>更新中</text>
          </view>
          <view class="trend-error trend-error-overlay" wx:if="{{trendError && !trend}}">
            <text>{{trendError}}</text>
            <text class="inline-action" bindtap="onRetryTrend">重新加载</text>
          </view>
        </view>

        <view class="trend-foot" wx:if="{{trend}}">
          <view class="trend-foot-item">
            <text class="trend-foot-value">{{trend.activeDays}}<text class="trend-foot-unit">/{{trend.days}}</text></text>
            <text class="trend-foot-label">活跃天数</text>
          </view>
          <view class="trend-foot-divider"></view>
          <view class="trend-foot-item">
            <text class="trend-foot-value">{{trend.totalQuestions}}</text>
            <text class="trend-foot-label">本期做题</text>
          </view>
          <view class="trend-foot-divider"></view>
          <view class="trend-foot-item">
            <text class="trend-foot-value">{{trend.avgAccuracyPct}}%</text>
            <text class="trend-foot-label">本期正确率</text>
          </view>
        </view>
      </view>
    </view>

    <!-- P0: Weak focus -->
    <view class="dashboard-section" wx:if="{{(insights && insights.weakTopics && insights.weakTopics.items.length) || (subjects && subjects.focusItem)}}">
      <view class="section-heading">
        <view>
          <text class="section-kicker">FOCUS</text>
          <text class="section-title">当前薄弱点</text>
        </view>
        <text class="section-side-note">优先处理</text>
      </view>

      <view class="focus-card focus-card-light" wx:if="{{insights && insights.weakTopics && insights.weakTopics.items.length}}"
        data-topic="{{insights.weakTopics.items[0].name}}"
        data-subject-id="{{insights.weakTopics.items[0].subjectId}}"
        bindtap="goTopicDetail" hover-class="surface-pressed">
        <view class="focus-card-top">
          <view class="focus-index">01</view>
          <view class="focus-title-wrap">
            <text class="focus-subject">{{insights.weakTopics.items[0].subjectLabel}}</text>
            <text class="focus-title">{{insights.weakTopics.items[0].name}}</text>
          </view>
          <text class="focus-percent">{{insights.weakTopics.items[0].masteryScore}}%</text>
        </view>
        <view class="focus-progress-track">
          <view class="focus-progress-fill" style="width:{{insights.weakTopics.items[0].masteryScore}}%;"></view>
        </view>
        <view class="focus-footer">
          <text>{{insights.weakTopics.items[0].wrongCount}} 次错误 · {{insights.weakTopics.items[0].attemptCount}} 次练习</text>
          <view class="focus-action">专项巩固 <text class="line-icon icon-chevron-right"></text></view>
        </view>
      </view>

      <view class="focus-card focus-card-light" wx:elif="{{subjects && subjects.focusItem}}"
        data-subject-id="{{subjects.focusItem.subjectId}}" bindtap="goSubjectWrongBook" hover-class="surface-pressed">
        <view class="focus-card-top">
          <view class="focus-index">01</view>
          <view class="focus-title-wrap">
            <text class="focus-subject">最需加强的科目</text>
            <text class="focus-title">{{subjects.focusItem.label}}</text>
          </view>
          <text class="focus-percent">{{subjects.focusItem.accuracyPct}}%</text>
        </view>
        <view class="focus-progress-track">
          <view class="focus-progress-fill" style="width:{{subjects.focusItem.accuracyPct}}%;"></view>
        </view>
        <view class="focus-footer">
          <text>{{subjects.focusItem.totalQuestions}} 题 · {{subjects.focusItem.wrongCount}} 错</text>
          <view class="focus-action">查看错题 <text class="line-icon icon-chevron-right"></text></view>
        </view>
      </view>

      <view class="focus-mini-list" wx:if="{{insights && insights.weakTopics && insights.weakTopics.items.length > 1}}">
        <block wx:for="{{insights.weakTopics.items}}" wx:for-item="topic" wx:key="knowledgePointId">
          <view class="focus-mini-item" wx:if="{{index > 0 && index < 3}}"
            data-topic="{{topic.name}}" data-subject-id="{{topic.subjectId}}" bindtap="goTopicDetail" hover-class="surface-pressed">
            <view class="focus-mini-rank">0{{index + 1}}</view>
            <view class="focus-mini-copy">
              <text class="focus-mini-title">{{topic.name}}</text>
              <text class="focus-mini-sub">{{topic.subjectLabel}} · {{topic.wrongCount}}错</text>
            </view>
            <text class="focus-mini-value">{{topic.masteryScore}}%</text>
          </view>
        </block>
      </view>
    </view>

    <!-- Knowledge hierarchy diagnosis · full analysis belongs in this existing report page -->
    <view id="knowledge-diagnosis-section" class="dashboard-section knowledge-diagnosis-section" wx:if="{{knowledgeDiagnosisLoading || knowledgeDiagnosis || knowledgeDiagnosisError}}">
      <view class="knowledge-diagnosis-card is-loading" wx:if="{{knowledgeDiagnosisLoading && !knowledgeDiagnosis}}">
        <view class="knowledge-diagnosis-skeleton skeleton-title"></view>
        <view class="knowledge-diagnosis-skeleton skeleton-line"></view>
        <view class="knowledge-diagnosis-skeleton skeleton-line short"></view>
      </view>

      <view class="knowledge-diagnosis-card is-error" wx:elif="{{knowledgeDiagnosisError && !knowledgeDiagnosis}}">
        <view class="knowledge-diagnosis-copy">
          <text class="knowledge-diagnosis-title">章节诊断暂不可用</text>
          <text class="knowledge-diagnosis-reason">知识图谱与其他学习报告不受影响。</text>
        </view>
        <view class="knowledge-diagnosis-link" bindtap="retryKnowledgeDiagnosis" hover-class="surface-pressed">重试</view>
      </view>

      <view class="knowledge-diagnosis-card" wx:elif="{{knowledgeDiagnosis && knowledgeDiagnosis.primary}}">
        <view class="knowledge-diagnosis-card-heading">
          <view>
            <text class="knowledge-diagnosis-kicker">KNOWLEDGE DIAGNOSIS</text>
            <text class="knowledge-diagnosis-card-title">章节学习诊断</text>
          </view>
          <text class="knowledge-diagnosis-period">{{knowledgeDiagnosis.subjectName}} · 近{{knowledgeDiagnosis.periodDays}}天</text>
        </view>
        <view class="knowledge-diagnosis-head">
          <view class="knowledge-diagnosis-icon">
            <image src="/assets/icons/dashboard/knowledge-diagnosis.png" mode="aspectFit" />
          </view>
          <view class="knowledge-diagnosis-divider"></view>
          <view class="knowledge-diagnosis-copy">
            <text class="knowledge-diagnosis-label">当前优先章节</text>
            <text class="knowledge-diagnosis-title">{{knowledgeDiagnosis.primary.title}}</text>
            <text class="knowledge-diagnosis-reason">{{knowledgeDiagnosis.primary.reason}}</text>
          </view>
        </view>

        <view class="knowledge-diagnosis-metrics">
          <view class="knowledge-diagnosis-metric"><text class="metric-main">{{knowledgeDiagnosis.primary.masteryText}}</text><text class="metric-sub">掌握</text></view>
          <view class="knowledge-diagnosis-metric"><text class="metric-main">{{knowledgeDiagnosis.primary.coverageText}}</text><text class="metric-sub">覆盖</text></view>
          <view class="knowledge-diagnosis-metric"><text class="metric-main">{{knowledgeDiagnosis.primary.weakCount}}</text><text class="metric-sub">薄弱点</text></view>
          <view class="knowledge-diagnosis-metric"><text class="metric-main">{{knowledgeDiagnosis.report.sessionCount}}</text><text class="metric-sub">章节专项</text></view>
        </view>

        <view class="knowledge-diagnosis-actions">
          <view class="knowledge-diagnosis-primary" bindtap="startKnowledgeDiagnosisPractice" hover-class="primary-action-pressed">
            <text>{{knowledgeDiagnosis.primary.actionLabel}}</text><text class="knowledge-diagnosis-primary-arrow">→</text>
          </view>
          <view class="knowledge-diagnosis-secondary" bindtap="openKnowledgeDiagnosisMap" hover-class="surface-pressed">查看知识图谱 ›</view>
        </view>
      </view>
    </view>

    <!-- P1: Error-cause diagnosis · Scheme 2 / data-visualization card -->
    <view class="dashboard-section diagnosis-report-section">
      <view class="error-pattern-card {{errorDiagnosisPrimary ? 'has-pattern' : 'is-empty-pattern'}}">
        <view class="error-pattern-ambient"></view>

        <view class="error-pattern-bars" aria-hidden="true">
          <view class="bar bar-a"></view>
          <view class="bar bar-b"></view>
          <view class="bar bar-c"></view>
        </view>

        <view class="error-pattern-content">
          <view class="error-pattern-title-row">
            <view class="error-pattern-title-copy">
              <text class="error-pattern-eyebrow">ERROR PATTERN</text>
              <text class="error-pattern-title">错误诊断</text>
            </view>
            <text class="error-pattern-window">近 {{errorDiagnosisStats ? errorDiagnosisStats.window_days : trendDays}} 天</text>
          </view>

          <view class="error-pattern-summary-panel">
            <text class="error-pattern-summary">{{errorDiagnosisLoading && !errorDiagnosisStats ? '正在分析近期错误模式…' : errorDiagnosisSummary}}</text>
            <view class="error-pattern-meta" wx:if="{{errorDiagnosisStats}}">
              <view class="error-pattern-meta-item"><text class="meta-value">{{errorDiagnosisStats.total_errors}}</text><text class="meta-label">次错误</text></view>
              <view class="error-pattern-meta-divider"></view>
              <view class="error-pattern-meta-item"><text class="meta-value">{{errorDiagnosisStats.confirmed_count}}</text><text class="meta-label">次已确认</text></view>
              <view class="error-pattern-meta-divider" wx:if="{{errorDiagnosisStats.unknown_count}}"></view>
              <view class="error-pattern-meta-item" wx:if="{{errorDiagnosisStats.unknown_count}}"><text class="meta-value">{{errorDiagnosisStats.unknown_count}}</text><text class="meta-label">次待分类</text></view>
            </view>
          </view>

          <view class="error-pattern-focus-card" wx:if="{{errorDiagnosisPrimary}}">
            <view class="error-pattern-primary-head">
              <view class="error-pattern-symbol">
                <image class="error-pattern-symbol-image" src="/assets/icons/dashboard/error-diagnosis.png" mode="aspectFit" />
              </view>
              <text class="error-pattern-primary-label">{{errorDiagnosisPrimary.label}}</text>
              <text class="error-pattern-primary-count">{{errorDiagnosisPrimary.count}} 次 · {{errorDiagnosisPrimary.percentPct}}%</text>
            </view>

            <view class="error-pattern-progress-row">
              <view class="error-pattern-track">
                <view class="error-pattern-fill" style="width:{{errorDiagnosisPrimary.percentPct}}%;"></view>
              </view>
              <text class="error-pattern-track-value">{{errorDiagnosisPrimary.percentPct}}%</text>
            </view>

            <view class="error-pattern-change" wx:if="{{errorDiagnosisPrimaryChange}}">
              <view class="change-arrow">↗</view>
              <text>{{errorDiagnosisPrimaryChange.label}} {{errorDiagnosisPrimaryChange.deltaText}}</text>
            </view>

            <view class="error-pattern-kp" wx:if="{{errorDiagnosisTopKnowledge}}">
              <view class="error-pattern-kp-mark"><view class="kp-dot"></view></view>
              <view class="error-pattern-kp-copy">
                <text class="error-pattern-kp-label">近期高频知识点：</text>
                <text class="error-pattern-kp-name">{{errorDiagnosisTopKnowledge.name}}</text>
              </view>
              <text class="error-pattern-kp-meta">{{errorDiagnosisTopKnowledge.count}} 次 · 主要{{errorDiagnosisTopKnowledge.topLabel}}</text>
            </view>
          </view>

          <view class="error-pattern-empty" wx:elif="{{!errorDiagnosisLoading}}">近期暂无已分类错因，完成错题复盘后会在这里形成趋势。</view>
        </view>
      </view>
    </view>

    <!-- Compact overview -->
    <view class="dashboard-section" wx:if="{{insights || wrongQuestionCount > 0}}">
      <view class="section-heading compact-heading">
        <view>
          <text class="section-title no-kicker">数据速览</text>
        </view>
      </view>
      <view class="snapshot-grid">
        <view class="snapshot-card">
          <text class="snapshot-label">学习稳定性</text>
          <text class="snapshot-value">{{insights && insights.weeklyConsistency ? insights.weeklyConsistency.displayScore : '--'}}</text>
          <text class="snapshot-note">{{insights && insights.weeklyConsistency ? insights.weeklyConsistency.activeDays + '/' + insights.weeklyConsistency.days + '天活跃' : '数据积累中'}}</text>
        </view>
        <view class="snapshot-card orange">
          <text class="snapshot-label">错题复发率</text>
          <text class="snapshot-value">{{insights && insights.repeatWrong ? insights.repeatWrong.repeatRatePct + '%' : '--'}}</text>
          <text class="snapshot-note">{{insights && insights.repeatWrong ? insights.repeatWrong.statusLabel : '数据积累中'}}</text>
        </view>
        <view class="snapshot-card green">
          <text class="snapshot-label">错题掌握率</text>
          <text class="snapshot-value">{{wrongQuestionCount > 0 ? masteryRatePct + '%' : '--'}}</text>
          <text class="snapshot-note">{{wrongQuestionCount > 0 ? masteredWrongCount + '/' + wrongQuestionCount + '道' : '暂无错题'}}</text>
        </view>
      </view>
    </view>

    <!-- Deep analysis: diagnosis + tabbed evidence -->
    <view class="deep-analysis-shell">
      <view class="deep-analysis-toggle" bindtap="onToggleDeepAnalysis" hover-class="surface-pressed">
        <view>
          <text class="deep-analysis-title no-kicker">深入分析</text>
          <text class="deep-analysis-desc">从诊断结论进入科目分析、记忆效率、成长与 AI</text>
        </view>
        <view class="deep-analysis-icon {{showDeepAnalysis ? 'expanded' : ''}}">
          <text class="line-icon icon-chevron-down"></text>
        </view>
      </view>

      <view class="deep-analysis-content" wx:if="{{showDeepAnalysis}}">
        <!-- Dynamic diagnosis -->
        <view class="diagnosis-card" wx:if="{{deepDiagnosis}}">
          <view class="diagnosis-topline">
            <view class="diagnosis-signal-dot {{deepDiagnosis.tone}}"></view>
            <text class="diagnosis-kicker">CURRENT SIGNAL</text>
            <text class="diagnosis-level">{{deepDiagnosis.levelLabel}}</text>
          </view>
          <text class="diagnosis-title">{{deepDiagnosis.title}}</text>
          <text class="diagnosis-desc">{{deepDiagnosis.desc}}</text>
          <view class="diagnosis-evidence">
            <view class="diagnosis-evidence-item" wx:for="{{deepDiagnosis.evidence}}" wx:key="label">
              <text class="diagnosis-evidence-value {{item.tone}}">{{item.value}}</text>
              <text class="diagnosis-evidence-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- Analysis tabs -->
        <scroll-view class="analysis-tabs-scroll" scroll-x enhanced show-scrollbar="false">
          <view class="analysis-tabs">
            <text class="analysis-tab {{analysisActiveTab == 'subjects' ? 'active' : ''}}" data-tab="subjects" bindtap="onAnalysisTab">科目</text>
            <text class="analysis-tab {{analysisActiveTab == 'memory' ? 'active' : ''}}" data-tab="memory" bindtap="onAnalysisTab">记忆效率</text>
            <text class="analysis-tab {{analysisActiveTab == 'growth' ? 'active' : ''}}" data-tab="growth" bindtap="onAnalysisTab">成长</text>
            <text class="analysis-tab {{analysisActiveTab == 'ai' ? 'active' : ''}}" data-tab="ai" bindtap="onAnalysisTab">AI 诊断</text>
          </view>
        </scroll-view>

        <view class="analysis-panel-stage">
          <!-- Subjects ranking -->
          <view class="analysis-panel" wx:if="{{analysisActiveTab == 'subjects'}}">
            <view class="analysis-panel-head">
              <view>
                <text class="analysis-panel-title">各科表现</text>
                <text class="analysis-panel-desc">按当前正确率由低到高排列</text>
              </view>
              <text class="analysis-panel-meta" wx:if="{{subjects}}">{{subjects.totalQuestions}} 题</text>
            </view>
            <view class="subject-bar-chart" wx:if="{{subjects && subjects.itemsByWeak.length}}">
              <view class="subject-bar-row" wx:for="{{subjects.itemsByWeak}}" wx:for-item="subject" wx:key="subject_id"
                data-subject-id="{{subject.subjectId}}" bindtap="goSubjectWrongBook" hover-class="subject-bar-row-pressed">
                <text class="subject-bar-name">{{subject.label}}</text>
                <view class="subject-bar-plot">
                  <view class="subject-bar-mark {{index == 0 ? 'weakest' : ''}}" style="width:{{subject.barWidthPct}}%;"></view>
                  <text class="subject-bar-value {{index == 0 ? 'weakest' : ''}}" style="left:{{subject.valueLeftPct}}%;">{{subject.accuracyPct}}%</text>
                </view>
              </view>
              <view class="subject-chart-note">
                <text class="subject-chart-note-dot"></text>
                <text>暖橙色表示当前最薄弱的科目</text>
              </view>
            </view>
            <view class="analysis-empty" wx:else>完成更多练习后显示科目排名。</view>
          </view>

          <!-- Memory and efficiency comparisons -->
          <view class="analysis-panel" wx:if="{{analysisActiveTab == 'memory'}}">
            <view class="analysis-panel-head">
              <view>
                <text class="analysis-panel-title">记忆与效率</text>
                <text class="analysis-panel-desc">把风险数量与答题耗时放在同一关系中看</text>
              </view>
            </view>

            <view class="compare-panel memory-compare-panel">
              <view class="compare-panel-head">
                <text class="compare-panel-title">记忆风险</text>
                <text class="compare-panel-status {{memoryCompare.riskTone}}">{{memoryCompare.riskLabel}}</text>
              </view>
              <view class="risk-comparison">
                <view class="risk-comparison-item {{memoryCompare.primaryRisk == 'highForget' ? 'active' : ''}}">
                  <text class="risk-comparison-value">{{memoryCompare.highForget}}</text>
                  <text class="risk-comparison-label">高频遗忘</text>
                  <view class="risk-current-mark"></view>
                </view>
                <view class="risk-comparison-line"></view>
                <view class="risk-comparison-item {{memoryCompare.primaryRisk == 'stuck' ? 'active' : ''}}">
                  <text class="risk-comparison-value">{{memoryCompare.stuck}}</text>
                  <text class="risk-comparison-label">长期未掌握</text>
                  <view class="risk-current-mark"></view>
                </view>
                <view class="risk-comparison-line"></view>
                <view class="risk-comparison-item {{memoryCompare.primaryRisk == 'pseudo' ? 'active' : ''}}">
                  <text class="risk-comparison-value">{{memoryCompare.pseudo}}</text>
                  <text class="risk-comparison-label">疑似假掌握</text>
                  <view class="risk-current-mark"></view>
                </view>
              </view>
              <view class="topic-chip-list editorial-chips" wx:if="{{memoryCompare.topTopics.length}}">
                <text class="topic-chip" wx:for="{{memoryCompare.topTopics}}" wx:key="topic" data-topic="{{item.topic}}" bindtap="goTopicWrongBook">{{item.topic}} · {{item.count}}次</text>
                <text class="topic-chip topic-chip-more" wx:if="{{memoryCompare.remainingTopicCount > 0}}">+{{memoryCompare.remainingTopicCount}}</text>
              </view>
            </view>

            <view class="compare-panel speed-compare-panel">
              <view class="compare-panel-head">
                <text class="compare-panel-title">答题效率</text>
                <text class="compare-panel-status">{{memoryCompare.speedRatioText}}</text>
              </view>
              <view class="dumbbell-chart {{memoryCompare.hasSpeedData ? '' : 'empty'}}">
                <view class="dumbbell-axis"></view>
                <view class="dumbbell-link" wx:if="{{memoryCompare.hasSpeedData}}"
                  style="left:{{memoryCompare.linkLeftPct}}%;width:{{memoryCompare.linkWidthPct}}%;"></view>
                <view class="dumbbell-node correct" wx:if="{{memoryCompare.hasSpeedData}}" style="left:{{memoryCompare.correctPositionPct}}%;">
                  <view class="dumbbell-copy above">
                    <text class="dumbbell-value">{{memoryCompare.correctSec}}s</text>
                    <text class="dumbbell-label">正确题</text>
                  </view>
                  <view class="dumbbell-dot"></view>
                </view>
                <view class="dumbbell-node wrong" wx:if="{{memoryCompare.hasSpeedData}}" style="left:{{memoryCompare.wrongPositionPct}}%;">
                  <view class="dumbbell-dot"></view>
                  <view class="dumbbell-copy below">
                    <text class="dumbbell-value">{{memoryCompare.wrongSec}}s</text>
                    <text class="dumbbell-label">错题</text>
                  </view>
                </view>
                <text class="dumbbell-empty-text" wx:else>完成更多练习后显示耗时差异</text>
              </view>
              <view class="efficiency-summary" wx:if="{{memoryCompare.hasSpeedData}}">
                <text class="efficiency-summary-main">{{memoryCompare.speedDiffText}}</text>
                <text class="efficiency-summary-sub">{{memoryCompare.speedRatioText}}</text>
              </view>
              <text class="compare-conclusion">{{memoryCompare.speedConclusion}}</text>
            </view>
          </view>

          <!-- Growth achievement band -->
          <view class="analysis-panel" wx:if="{{analysisActiveTab == 'growth'}}">
            <view class="analysis-panel-head">
              <view>
                <text class="analysis-panel-title">成长记录</text>
                <text class="analysis-panel-desc">用长期节奏，而不是单次成绩衡量进步</text>
              </view>
            </view>
            <view class="achievement-band" wx:if="{{growth || yearly}}">
              <view class="achievement-main">
                <view class="achievement-level" wx:if="{{growth}}">LV{{growth.level}}</view>
                <view class="achievement-copy">
                  <text class="achievement-title">{{growth ? growth.levelTitle : '学习记录'}}</text>
                  <text class="achievement-desc">{{growth ? '距下一等级 ' + (100 - growth.levelProgressPct) + '%' : '继续积累学习天数'}}</text>
                </view>
                <view class="achievement-year" wx:if="{{yearly}}">
                  <text class="achievement-year-value">{{yearly.activeDays}}</text>
                  <text class="achievement-year-label">今年学习天数</text>
                </view>
              </view>
              <view class="achievement-track" wx:if="{{growth}}"><view class="achievement-fill" style="width:{{growth.levelProgressPct}}%;"></view></view>
              <view class="achievement-footer" wx:if="{{yearly}}" bindtap="onToggleYearly">
                <text>最长连续 {{yearly.bestDayText}}</text>
                <text class="inline-action">{{showYearlyHeatmap ? '收起记录' : '查看年度记录'}}</text>
              </view>
            </view>
            <view class="yearly-heatmap editorial-heatmap" wx:if="{{showYearlyHeatmap && yearlyHeatmapWeeks.length}}">
              <scroll-view class="yearly-heat-scroll" scroll-x enhanced show-scrollbar="false">
                <view class="yearly-heat-grid">
                  <view class="year-week" wx:for="{{yearlyHeatmapWeeks}}" wx:for-item="week" wx:key="key">
                    <view class="year-day {{day.heatClass}}" wx:for="{{week.days}}" wx:for-item="day" wx:key="date"></view>
                  </view>
                </view>
              </scroll-view>
            </view>
            <text class="analysis-note" wx:if="{{yearlyLoading}}">年度记录加载中…</text>
            <text class="analysis-note" wx:if="{{yearlyError}}">{{yearlyError}}</text>
          </view>

          <!-- AI dark panel -->
          <view class="analysis-panel" wx:if="{{analysisActiveTab == 'ai'}}">
            <view class="ai-diagnosis-panel">
              <view class="ai-panel-head">
                <view>
                  <text class="ai-panel-kicker">MEMOGRAD AI</text>
                  <text class="ai-panel-title">AI 学习诊断</text>
                  <text class="ai-panel-desc">将当前数据整理成下一步最值得执行的方向</text>
                </view>
                <view class="ai-badge {{llmAnalysis && llmAnalysis.generated == false ? 'data' : ''}}">{{llmAnalysis && llmAnalysis.generated == false ? '数据' : 'AI'}}</view>
              </view>

              <view class="ai-empty" wx:if="{{!llmAnalysis && !llmAnalysisLoading && !llmAnalysisError}}">
                <text>生成一份聚焦结论、风险与行动建议的学习诊断。</text>
                <button class="ai-button" bindtap="onGenerateLlmAnalysis">生成分析</button>
              </view>
              <view class="ai-loading" wx:if="{{llmAnalysisLoading}}">正在分析学习数据…</view>
              <view class="ai-error" wx:if="{{llmAnalysisError}}">
                <text>{{llmAnalysisError}}</text>
                <text class="inline-action" bindtap="onRetryLlmAnalysis">重试</text>
              </view>
              <view class="ai-result" wx:if="{{llmAnalysis}}">
                <view class="ai-fallback-note" wx:if="{{llmAnalysis.generated == false}}">AI 服务本次未返回可用结果，先展示基于当前学习数据的诊断。</view>
                <text class="ai-summary" wx:if="{{llmAnalysis.summary}}">{{llmAnalysis.summary}}</text>
                <view class="ai-result-group" wx:if="{{llmAnalysis.findings && llmAnalysis.findings.length}}">
                  <text class="ai-result-title">主要发现</text>
                  <view class="ai-result-row" wx:for="{{llmAnalysis.findings}}" wx:key="*this"><view class="ai-result-dot"></view><text>{{item}}</text></view>
                </view>
                <view class="ai-result-group" wx:if="{{llmAnalysis.risks && llmAnalysis.risks.length}}">
                  <text class="ai-result-title">风险提醒</text>
                  <view class="ai-result-row" wx:for="{{llmAnalysis.risks}}" wx:key="*this"><view class="ai-result-dot ai-risk-dot"></view><text>{{item}}</text></view>
                </view>
                <view class="ai-result-group" wx:if="{{llmAnalysis.actions && llmAnalysis.actions.length}}">
                  <text class="ai-result-title">下一步建议</text>
                  <view class="ai-action-row" wx:for="{{llmAnalysis.actions}}" wx:for-item="aiAction" wx:key="title" data-type="{{aiAction.type}}" bindtap="goLlmAction">
                    <view><text class="ai-action-title">{{aiAction.title}}</text><text class="ai-action-desc">{{aiAction.desc}}</text></view>
                    <text class="line-icon icon-chevron-right"></text>
                  </view>
                </view>
                <view class="ai-footer"><text bindtap="onClearLlmAnalysis">清除结果</text><text wx:if="{{llmAnalysis.generated == false}}" bindtap="onRetryLlmAnalysis">重试 AI</text><text wx:else bindtap="onLlmFeedback">结果有误</text></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-safe"></view>
  </block>
</view>
