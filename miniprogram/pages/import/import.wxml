<view class="page">
  <!-- Hero -->
  <view class="import-hero">
    <view class="hero-copy">
      <text class="eyebrow">题目导入</text>
      <text class="hero-title">上传题目文件</text>
      <text class="hero-desc">支持拍照、相册图片及聊天文件，系统将自动解析题目内容</text>
    </view>
  </view>

  <!-- 上传区域 -->
  <view class="upload-section">
    <view class="upload-zone" bindtap="chooseFile">
      <view class="upload-icon-wrap">
        <text class="upload-icon line-icon icon-plus" style="width:44rpx;height:44rpx;color:#5B7B9A;"></text>
      </view>
      <text class="upload-title">选择文件上传</text>
      <text class="upload-desc">拍照 / 相册图片 / PDF / TXT / Excel</text>
      <view class="upload-formats">
        <text class="format-tag">PDF</text>
        <text class="format-tag">图片</text>
        <text class="format-tag">TXT</text>
        <text class="format-tag">Excel</text>
      </view>
    </view>
  </view>

  <!-- 页码范围（仅 PDF） -->
  <view class="page-range-section" wx:if="{{showPageRange}}">
    <text class="page-range-hint">页码范围（可选，留空处理全部页面）</text>
    <view class="page-range-inputs">
      <input class="page-range-input" type="number" placeholder="起始页" value="{{pageStart}}" bindinput="onPageStartInput" />
      <text class="page-range-sep">—</text>
      <input class="page-range-input" type="number" placeholder="结束页" value="{{pageEnd}}" bindinput="onPageEndInput" />
    </view>
    <view class="page-range-confirm" bindtap="confirmUpload">
      <text class="page-range-confirm-text">开始上传</text>
    </view>
  </view>

  <!-- 导入进度卡片 -->
  <view class="pipeline-task-card" wx:if="{{pipelineTask}}">
    <view class="pipeline-task-row">
      <view class="pipeline-task-left">
        <view class="pipeline-icon {{pipelineTask.status}}">
          <text>{{pipelineTask.source_type || '导'}}</text>
        </view>
        <view class="pipeline-task-info">
          <text class="pipeline-task-title">{{pipelineTask.source_file || '导入任务'}}</text>
          <text class="pipeline-task-type" wx:if="{{pipelineTask.source_type}}">{{pipelineTask.source_type}}</text>
        </view>
      </view>
      <text class="pipeline-task-status {{pipelineTask.status}}">{{pipelineTask.statusLabel || pipelineTask.status}}</text>
    </view>

    <!-- 进度条 -->
    <view class="pipeline-progress" wx:if="{{pipelinePolling}}">
      <view class="pipeline-progress-header">
        <text class="pipeline-progress-stage">{{pipelineTask.currentStageLabel || '准备中'}}</text>
        <text class="pipeline-progress-pct">{{pipelineTask.progressPercent}}%</text>
      </view>
      <view class="pipeline-progress-bar">
        <view class="pipeline-progress-fill" style="width: {{pipelineTask.progressPercent}}%"></view>
      </view>
      <view class="pipeline-progress-meta">
        <text class="pipeline-progress-elapsed" wx:if="{{pipelineTask.elapsed}}">已耗时 {{pipelineTask.elapsed}}</text>
        <text class="pipeline-progress-ocr" wx:if="{{pipelineTask.ocr_progress}}">{{pipelineTask.ocr_progress}}</text>
      </view>
    </view>

    <!-- 轮询错误 & 恢复 -->
    <view class="pipeline-poll-error" wx:if="{{pipelinePollError && pipelineTask && pipelineTask.status !== 'completed' && pipelineTask.status !== 'failed' && pipelineTask.status !== 'paused'}}">
      <text class="pipeline-poll-error-text">{{pipelinePollError}}</text>
      <button class="pipeline-poll-retry-btn" bindtap="resumePipelinePolling">继续查询</button>
    </view>

    <!-- 暂停/失败 恢复导入 -->
    <view class="pipeline-resume-area" wx:if="{{pipelineTask && (pipelineTask.status === 'paused' || pipelineTask.status === 'failed')}}">
      <text class="pipeline-resume-desc">导入中断，可选择原 PDF 恢复导入，或重新上传开始新的导入。</text>
      <button class="pipeline-resume-btn" bindtap="resumePipeline" wx:if="{{!uploading}}">选择原 PDF 并恢复导入</button>
      <view class="pipeline-uploading" wx:if="{{uploading}}">
        <loading-lottie text="正在恢复导入..." size="small" />
      </view>
    </view>

    <!-- 阶段步骤列表 -->
    <view class="pipeline-stages" wx:if="{{pipelineTask.stageList.length > 0 && pipelinePolling}}">
      <view class="pipeline-stage-item {{item.status}}" wx:for="{{pipelineTask.stageList}}" wx:key="key">
        <view class="pipeline-stage-dot"></view>
        <text class="pipeline-stage-label">{{item.label}}</text>
      </view>
    </view>

    <!-- 分块失败列表 -->
    <view class="pipeline-failed-chunks" wx:if="{{pipelineTask.failed_chunk_details.length > 0}}">
      <text class="pipeline-failed-title">失败分块（{{pipelineTask.failed_chunk_details.length}} 个）</text>
      <view class="pipeline-failed-item" wx:for="{{pipelineTask.failed_chunk_details}}" wx:key="chunk_index">
        <text class="pipeline-failed-range">第 {{item.page_start}}–{{item.page_end}} 页</text>
        <text class="pipeline-failed-error" wx:if="{{item.error_message}}">{{item.error_message}}</text>
      </view>
    </view>

    <!-- 完成/失败提示 -->
    <view class="pipeline-result" wx:if="{{pipelineTask.status === 'completed'}}">
      <text class="pipeline-result-icon line-icon icon-check" style="width:32rpx;height:32rpx;color:#22C55E;"></text>
      <text class="pipeline-result-text">导入完成，共解析 {{pipelineTask.question_count || 0}} 题</text>
    </view>
    <view class="pipeline-result error" wx:if="{{pipelineTask.status === 'failed'}}">
      <text class="pipeline-result-icon line-icon icon-close" style="width:32rpx;height:32rpx;color:#EF4444;"></text>
      <text class="pipeline-result-text">{{pipelineTask.error_message || '导入失败，请重试'}}</text>
    </view>
  </view>

  <!-- 模板下载 -->
  <view class="template-bar" bindtap="downloadTemplate">
    <view class="template-icon">
      <text>模</text>
    </view>
    <view class="template-info">
      <text class="template-label">下载导入模板</text>
      <text class="template-desc">适合批量整理 Excel 题库，按字段填写更稳定</text>
    </view>
    <text class="template-arrow line-icon icon-chevron-right" style="width:28rpx;height:28rpx;color:#B7C4DA;"></text>
  </view>
</view>
