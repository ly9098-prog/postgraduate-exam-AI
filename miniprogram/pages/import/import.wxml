<view class="page">
  <view class="import-hero">
    <view class="hero-copy">
      <text class="eyebrow">题库管理</text>
      <text class="hero-title">题库导入</text>
      <text class="hero-desc">上传文件后先解析成待审核题目，确认无误再入库</text>
    </view>
    <view class="hero-badge">
      <text class="hero-badge-main">审</text>
      <text class="hero-badge-label">人工确认</text>
    </view>
  </view>

  <!-- 统一上传区域 -->
  <view class="upload-section">
    <view class="section-head">
      <view>
        <text class="section-title">统一导入入口</text>
        <text class="section-subtitle">支持文件、图片与扫描材料，系统异步解析后进入审核</text>
      </view>
      <text class="section-chip">Upload</text>
    </view>
    <view class="upload-zone" bindtap="chooseFile">
      <view class="upload-icon-wrap">
        <text class="upload-icon">传</text>
      </view>
      <text class="upload-title">上传题目文件</text>
      <text class="upload-desc">Excel / PDF / TXT / 图片均可从这里导入</text>
      <view class="upload-hint">
        <text class="hint-dot"></text>
        <text class="hint-text">所有导入结果都需要人工审核后才会进入题库</text>
      </view>
      <view class="upload-formats">
        <text class="format-tag">XLSX</text>
        <text class="format-tag">PDF</text>
        <text class="format-tag">TXT</text>
        <text class="format-tag">JPG</text>
        <text class="format-tag">PNG</text>
      </view>
    </view>
  </view>

  <!-- 页码范围（仅PDF） -->
  <view class="page-range-section" wx:if="{{showPageRange}}">
    <text class="page-range-hint">页码范围（可选，留空处理全部页面）</text>
    <view class="page-range-inputs">
      <input class="page-range-input" type="number" placeholder="起始页"
        value="{{pageStart}}" bindinput="onPageStartInput" />
      <text class="page-range-sep">—</text>
      <input class="page-range-input" type="number" placeholder="结束页"
        value="{{pageEnd}}" bindinput="onPageEndInput" />
    </view>
    <view class="page-range-confirm" bindtap="confirmUpload">
      <text class="page-range-confirm-text">开始上传</text>
    </view>
  </view>

  <!-- 导入进度卡片 -->
  <view class="pipeline-task-card" wx:if="{{pipelineTask}}">
    <view class="pipeline-task-row">
      <view class="pipeline-task-left">
        <view class="pipeline-icon {{pipelineTask.status}}">{{pipelineTask.source_type || '导'}}</view>
        <view class="pipeline-task-info">
          <text class="pipeline-task-title">{{pipelineTask.source_file || '导入任务'}}</text>
          <text class="pipeline-task-type" wx:if="{{pipelineTask.source_type}}">{{pipelineTask.source_type}}</text>
        </view>
      </view>
      <text class="pipeline-task-status {{pipelineTask.status}}">{{pipelineTask.statusLabel || pipelineTask.status}}</text>
    </view>

    <!-- 进度条区域 -->
    <view class="pipeline-progress" wx:if="{{pipelinePolling}}">
      <view class="pipeline-progress-header">
        <text class="pipeline-progress-stage">{{pipelineTask.currentStageLabel || '准备中'}}</text>
        <text class="pipeline-progress-pct">{{pipelineTask.progressPercent}}%</text>
      </view>
      <view class="pipeline-progress-bar">
        <view class="pipeline-progress-fill" style="width: {{pipelineTask.progressPercent}}%"></view>
      </view>
      <view class="pipeline-progress-meta">
        <text class="pipeline-progress-elapsed" wx:if="{{pipelineTask.elapsed}}">已耗时 {{pipelineTask.elapsed}}</text>
        <text class="pipeline-progress-ocr" wx:if="{{pipelineTask.ocr_progress}}">{{pipelineTask.ocr_progress}}</text>
      </view>
    </view>

    <!-- 阶段步骤列表 -->
    <view class="pipeline-stages" wx:if="{{pipelineTask.stageList.length > 0 && pipelinePolling}}">
      <view class="pipeline-stage-item {{item.status}}" wx:for="{{pipelineTask.stageList}}" wx:key="key">
        <view class="pipeline-stage-dot"></view>
        <text class="pipeline-stage-label">{{item.label}}</text>
      </view>
    </view>

    <!-- P2-6: 分块失败列表 + 恢复入口 -->
    <view class="pipeline-failed-chunks" wx:if="{{pipelineTask.failed_chunk_details.length > 0}}">
      <text class="pipeline-failed-title">失败分块（{{pipelineTask.failed_chunk_details.length}} 个）</text>
      <view class="pipeline-failed-item" wx:for="{{pipelineTask.failed_chunk_details}}" wx:key="chunk_index">
        <text class="pipeline-failed-range">第 {{item.page_start}}–{{item.page_end}} 页</text>
        <text class="pipeline-failed-error" wx:if="{{item.error_message}}">{{item.error_message}}</text>
      </view>
      <view class="pipeline-resume-btn" wx:if="{{pipelineTask.canResume}}" bindtap="resumePipeline">
        <text class="pipeline-resume-text">重新选择 PDF 恢复导入</text>
      </view>
    </view>

    <text class="pipeline-task-desc completed" wx:if="{{pipelineTask.batch_id}}">已生成审核批次：{{pipelineTask.batch_id}}</text>
    <text class="pipeline-task-desc error" wx:if="{{pipelineTask.status === 'failed' && pipelineTask.error_message}}">{{pipelineTask.error_message}}</text>
    <text class="pipeline-preview" wx:if="{{pipelineTask.raw_text_preview}}">{{pipelineTask.raw_text_preview}}</text>
  </view>

  <!-- 模板下载 -->
  <view class="template-bar" bindtap="downloadTemplate">
    <view class="template-icon">模</view>
    <view class="template-info">
      <text class="template-label">下载导入模板</text>
      <text class="template-desc">适合批量整理 Excel 题库，按字段填写更稳定</text>
    </view>
    <text class="template-arrow">›</text>
  </view>

  <!-- 导入记录 -->
  <view class="records-panel">
    <view class="section-head records-head">
      <view>
        <text class="section-title">导入记录</text>
        <text class="section-subtitle">查看解析批次与待审核题目状态</text>
      </view>
      <text class="section-chip">记录</text>
    </view>

    <!-- 加载态 -->
    <view class="loading-wrap" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在加载导入记录...</text>
    </view>

    <!-- 错误态 -->
    <view class="empty-state" wx:elif="{{error}}">
      <view class="empty-icon danger">!</view>
      <text class="empty-title">{{error}}</text>
      <text class="empty-desc">下拉刷新重试</text>
    </view>

    <!-- 空态 -->
    <view class="empty-state" wx:elif="{{batches.length === 0}}">
      <view class="empty-icon">空</view>
      <text class="empty-title">暂无导入记录</text>
      <text class="empty-desc">点击上方上传区域，解析完成后会在这里生成审核批次</text>
    </view>

    <!-- 导入批次列表 -->
    <view class="batch-list" wx:else>
      <view
        class="batch-card"
        wx:for="{{batches}}"
        wx:key="batch_id"
        data-batch-id="{{item.batch_id}}"
        bindtap="goBatch"
      >
        <view class="batch-top">
          <view class="batch-left">
            <view class="batch-icon {{item.source_type}}">
              {{item.source_type === 'excel' ? '表' : item.source_type === 'image' ? '图' : '文'}}
            </view>
            <view class="batch-info">
              <text class="batch-name">{{item.source_file || item.batch_id}}</text>
              <text class="batch-meta">{{item.total}} 道题 · {{item._date}}</text>
            </view>
          </view>
          <text class="batch-arrow">›</text>
        </view>
        <view class="batch-stats">
          <view class="stat-chip stat-pending" wx:if="{{item.pending > 0}}">
            <text class="stat-dot"></text>
            {{item.pending}} 待审核
          </view>
          <view class="stat-chip stat-approved" wx:if="{{item.approved > 0}}">
            <text class="stat-dot"></text>
            {{item.approved}} 已通过
          </view>
          <view class="stat-chip stat-rejected" wx:if="{{item.rejected > 0}}">
            <text class="stat-dot"></text>
            {{item.rejected}} 已拒绝
          </view>
        </view>
      </view>
    </view>
  </view>
</view>