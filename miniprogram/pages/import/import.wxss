@import '../../styles/tokens.wxss';

page {
  background: #F7F5F0;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #F7F5F0;
}

.import-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #EDF1F5 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.import-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #C49A6B;
  opacity: 0.4;
}

.import-hero::after {
  content: '';
  position: absolute;
  right: -54rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(107, 155, 107, 0.09);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  font-size: 21rpx;
  line-height: 1.35;
  color: #5B7B9A;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.hero-badge {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
  border: 10rpx solid #F5F1EB;
}

.hero-badge-main {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #C49A6B;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6B7B8D;
}

.upload-section,
.pipeline-task-card,
.template-bar,
.records-panel {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.records-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.upload-zone {
  padding: 44rpx 28rpx 34rpx;
  background: linear-gradient(180deg, #FAFBFC 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  border: 2rpx dashed #D8D6D0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-zone:active,
.template-bar:active,
.batch-card:active {
  opacity: 0.84;
}

.upload-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.62);
}

.upload-icon {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B7B9A;
}

.upload-title {
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.upload-desc {
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7B8D;
  text-align: center;
}

.upload-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  background: #F7F6F2;
  border-radius: 999rpx;
}

.hint-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #C49A6B;
  flex-shrink: 0;
}

.hint-text {
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.upload-formats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.format-tag {
  font-size: 20rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.pipeline-task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pipeline-task-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.pipeline-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.pipeline-icon.completed {
  background: #EFF5EF;
  color: #6B9B6B;
}

.pipeline-icon.failed {
  background: #F5EFEF;
  color: #C47A7A;
}

.pipeline-task-info {
  flex: 1;
  min-width: 0;
}

.pipeline-task-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pipeline-task-type {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.pipeline-task-status {
  font-size: 22rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.pipeline-task-status.failed {
  color: #C47A7A;
  background: #F5EFEF;
}

.pipeline-task-status.completed {
  color: #6B9B6B;
  background: #EFF5EF;
}

.pipeline-task-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7B8D;
}

.pipeline-task-desc.completed {
  color: #6B9B6B;
}

.pipeline-task-desc.error {
  color: #C47A7A;
}

.pipeline-preview {
  display: block;
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F7F6F2;
  color: #6B7B8D;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 进度条 */
.pipeline-progress {
  margin-top: 18rpx;
}

.pipeline-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.pipeline-progress-stage {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 600;
}

.pipeline-progress-pct {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 700;
}

.pipeline-progress-bar {
  height: 12rpx;
  background: #EDF1F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.pipeline-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7BA3C4, #5B8DB8);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.pipeline-progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.pipeline-progress-elapsed,
.pipeline-progress-ocr {
  font-size: 22rpx;
  color: #8FA3B3;
}

/* 阶段列表 */
.pipeline-stages {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.pipeline-stage-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pipeline-stage-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D4DBE2;
}

.pipeline-stage-item.completed .pipeline-stage-dot {
  background: #6B9B6B;
}

.pipeline-stage-item.running .pipeline-stage-dot {
  background: #5B8DB8;
  animation: pulse 1s infinite;
}

.pipeline-stage-item.failed .pipeline-stage-dot {
  background: #C47A7A;
}

.pipeline-stage-label {
  font-size: 22rpx;
  color: #8FA3B3;
}

.pipeline-stage-item.completed .pipeline-stage-label {
  color: #6B9B6B;
}

.pipeline-stage-item.running .pipeline-stage-label {
  color: #5B8DB8;
  font-weight: 600;
}

.pipeline-stage-item.failed .pipeline-stage-label {
  color: #C47A7A;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.template-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.template-icon,
.empty-icon,
.batch-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F5F1EB;
  color: #C49A6B;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-info {
  flex: 1;
  min-width: 0;
}

.template-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E50;
  line-height: 1.35;
  display: block;
}

.template-desc {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.45;
  display: block;
  margin-top: 4rpx;
}

.template-arrow,
.batch-arrow {
  font-size: 34rpx;
  color: #BCC8D4;
  flex-shrink: 0;
}

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 54rpx 28rpx;
}

.empty-icon {
  margin-bottom: 18rpx;
  background: #EDF1F5;
  color: #5B7B9A;
}

.empty-icon.danger {
  background: #F5EFEF;
  color: #C47A7A;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #2D3E50;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #9AABBA;
}

.batch-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.batch-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #EDF1F5;
}

.batch-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.batch-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.batch-icon.excel {
  background: #EFF5EF;
  color: #6B9B6B;
}

.batch-icon.image {
  background: #F5F1EB;
  color: #C49A6B;
}

.batch-info {
  flex: 1;
  min-width: 0;
}

.batch-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E50;
  line-height: 1.35;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.batch-meta {
  font-size: 22rpx;
  color: #9AABBA;
  display: block;
  margin-top: 5rpx;
}

.batch-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EDF1F5;
}

.stat-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 21rpx;
  line-height: 1.35;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.stat-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.stat-pending {
  background: #F5F1EB;
  color: #C49A6B;
}

.stat-pending .stat-dot {
  background: #C49A6B;
}

.stat-approved {
  background: #EFF5EF;
  color: #6B9B6B;
}

.stat-approved .stat-dot {
  background: #6B9B6B;
}

.stat-rejected {
  background: #F5EFEF;
  color: #C47A7A;
}

.stat-rejected .stat-dot {
  background: #C47A7A;
}

/* 页码范围 */
.page-range-section {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FAFBFC;
  border-radius: 16rpx;
  border: 1rpx solid #E8ECF0;
}

.page-range-hint {
  font-size: 24rpx;
  color: #8A9BAE;
  display: block;
  margin-bottom: 16rpx;
}

.page-range-inputs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.page-range-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border: 1rpx solid #DDE3EA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.page-range-sep {
  font-size: 28rpx;
  color: #8A9BAE;
}

.page-range-confirm {
  margin-top: 20rpx;
  height: 72rpx;
  background: #4A7C6F;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-range-confirm-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
