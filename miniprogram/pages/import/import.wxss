@import '../../styles/tokens.wxss';

page {
  background: #F7F5F0;
}

.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #F7F5F0;
}

/* ===== Hero ===== */
.import-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 58%, #EDF1F5 100%);
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.import-hero::after {
  content: '';
  position: absolute;
  right: -54rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(107, 155, 107, 0.09);
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  font-size: 21rpx;
  line-height: 1.35;
  color: #5B7B9A;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

/* ===== Cards ===== */
.upload-section,
.pipeline-task-card,
.template-bar {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

/* ===== Upload Zone ===== */
.upload-zone {
  padding: 44rpx 28rpx 34rpx;
  background: linear-gradient(180deg, #FAFBFC 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  border: 2rpx dashed #D8D6D0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.upload-zone:active,
.template-bar:active {
  opacity: 0.84;
}

.upload-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.62);
}

.upload-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-title {
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.upload-desc {
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7B8D;
  text-align: center;
}

.upload-formats {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.format-tag {
  font-size: 20rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

/* ===== Pipeline Task Card ===== */
.pipeline-task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pipeline-task-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.pipeline-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 22rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pipeline-icon.completed {
  background: #EFF5EF;
  color: #6B9B6B;
}

.pipeline-icon.failed {
  background: #F5EFEF;
  color: #C47A7A;
}

.pipeline-task-info {
  flex: 1;
  min-width: 0;
}

.pipeline-task-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pipeline-task-type {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.pipeline-task-status {
  font-size: 22rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.pipeline-task-status.failed {
  color: #C47A7A;
  background: #F5EFEF;
}

.pipeline-task-status.completed {
  color: #6B9B6B;
  background: #EFF5EF;
}

/* ===== Progress ===== */
.pipeline-progress {
  margin-top: 18rpx;
}

.pipeline-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.pipeline-progress-stage {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 600;
}

.pipeline-progress-pct {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 700;
}

.pipeline-progress-bar {
  height: 12rpx;
  background: #EDF1F5;
  border-radius: 6rpx;
  overflow: hidden;
}

.pipeline-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7BA3C4, #5B8DB8);
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

.pipeline-progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
}

.pipeline-progress-elapsed,
.pipeline-progress-ocr {
  font-size: 22rpx;
  color: #8FA3B3;
}

/* ===== Poll Error ===== */
.pipeline-poll-error {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #FFFBEB;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.pipeline-poll-error-text {
  font-size: 24rpx;
  color: #D97706;
  line-height: 1.45;
  text-align: center;
}

.pipeline-poll-retry-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: #4F7FFF;
  border-radius: 999rpx;
  border: none;
}

.pipeline-poll-retry-btn::after {
  border: none;
}

/* ===== Stage List ===== */
.pipeline-stages {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.pipeline-stage-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pipeline-stage-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D4DBE2;
}

.pipeline-stage-item.completed .pipeline-stage-dot {
  background: #6B9B6B;
}

.pipeline-stage-item.running .pipeline-stage-dot {
  background: #5B8DB8;
  animation: pulse 1s infinite;
}

.pipeline-stage-item.failed .pipeline-stage-dot {
  background: #C47A7A;
}

.pipeline-stage-label {
  font-size: 22rpx;
  color: #8FA3B3;
}

.pipeline-stage-item.completed .pipeline-stage-label {
  color: #6B9B6B;
}

.pipeline-stage-item.running .pipeline-stage-label {
  color: #5B8DB8;
  font-weight: 600;
}

.pipeline-stage-item.failed .pipeline-stage-label {
  color: #C47A7A;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ===== Result (Completed / Failed) ===== */
.pipeline-result {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #EFF5EF;
  border-radius: 16rpx;
}

.pipeline-result.error {
  background: #F5EFEF;
}

.pipeline-result-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #6B9B6B;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pipeline-result.error .pipeline-result-icon {
  background: #C47A7A;
}

.pipeline-result-text {
  font-size: 25rpx;
  font-weight: 600;
  color: #2D3E50;
  line-height: 1.4;
}

/* ===== Failed Chunks ===== */
.pipeline-failed-chunks {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #FBF1EE;
  border: 1rpx solid #F0CFC4;
  border-radius: 14rpx;
}

.pipeline-failed-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #B85C4A;
  margin-bottom: 10rpx;
}

.pipeline-failed-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 8rpx 0;
  border-top: 1rpx dashed #E5C4BB;
}

.pipeline-failed-item:first-of-type {
  border-top: none;
}

.pipeline-failed-range {
  font-size: 22rpx;
  color: #6B7B8D;
  font-weight: 600;
}

.pipeline-failed-error {
  font-size: 22rpx;
  color: #B85C4A;
  line-height: 1.5;
}

/* ===== Page Range ===== */
.page-range-section {
  margin: 0 32rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FAFBFC;
  border-radius: 16rpx;
  border: 1rpx solid #E8ECF0;
}

.page-range-hint {
  font-size: 24rpx;
  color: #8A9BAE;
  display: block;
  margin-bottom: 16rpx;
}

.page-range-inputs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.page-range-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border: 1rpx solid #DDE3EA;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.page-range-sep {
  font-size: 28rpx;
  color: #8A9BAE;
}

.page-range-confirm {
  margin-top: 20rpx;
  height: 72rpx;
  background: #4A7C6F;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.page-range-confirm:active {
  opacity: 0.84;
}

.page-range-confirm-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* ===== Template Bar ===== */
.template-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.template-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F5F1EB;
  color: #C49A6B;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-info {
  flex: 1;
  min-width: 0;
}

.template-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E50;
  line-height: 1.35;
  display: block;
}

.template-desc {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.45;
  display: block;
  margin-top: 4rpx;
}

.template-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
}
