/* plan — 复习计划专属样式 */
@import '../../styles/tokens.wxss';

/* 统计行 */
.stats-row {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 24rpx;
}

.stat-item {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A90D9;
}

.stat-label {
  font-size: 22rpx;
  color: #9AABBA;
  margin-top: 4rpx;
}

.review-card {
  margin-bottom: 14rpx;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-count {
  font-size: 24rpx;
  color: #9AABBA;
}

.review-question {
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-meta {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #BCC8D4;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.review-actions {
  margin-top: 16rpx;
}

/* ── 加载 ── */
.loading-wrap {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 100rpx 0;
}
.loading-spinner {
  width: 48rpx; height: 48rpx;
  border: 4rpx solid #EDF1F5; border-top-color: #5B7B9A;
  border-radius: 50%; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { font-size: 26rpx; color: #9AABBA; margin-top: 16rpx; }
