/* plan — 复习计划专属样式 */
@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

.plan-hero {
  margin: 24rpx 24rpx 18rpx;
  padding: 34rpx 30rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFBF8 62%, #EFF5EF 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.9);
  position: relative;
  overflow: hidden;
}

.plan-hero::before {
  content: '';
  position: absolute;
  left: 30rpx;
  bottom: 24rpx;
  width: 92rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #6B9B6B;
  opacity: 0.34;
}

.plan-hero::after {
  content: '';
  position: absolute;
  right: -52rpx;
  top: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.08);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B9B6B;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.16;
  color: #2D3E50;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7B8D;
}

.hero-badge {
  width: 152rpx;
  height: 152rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.06);
  border: 10rpx solid #EDF1F5;
}

.hero-badge-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #6B7B8D;
}

.stats-panel,
.review-section,
.plan-empty {
  margin: 18rpx 24rpx 0;
  padding: 26rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.list-head {
  margin-bottom: 18rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #9AABBA;
}

.section-chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.35;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 12rpx;
}

.stat-item {
  min-width: 0;
  min-height: 122rpx;
  padding: 18rpx 8rpx;
  border-radius: 20rpx;
  background: #F7F6F2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-item.primary { background: #EDF1F5; }
.stat-item.success { background: #EFF5EF; }
.stat-item.sage { background: #F0F4EF; }
.stat-item.muted { background: #F3F2EF; }

.stat-num {
  max-width: 100%;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.18;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-item.success .stat-num,
.stat-item.sage .stat-num { color: #6B9B6B; }
.stat-item.muted .stat-num { color: #6B7B8D; }

.stat-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.progress-list {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #EDF1F5;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-row {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.progress-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-label,
.progress-value {
  font-size: 22rpx;
  line-height: 1.35;
  color: #6B7B8D;
}

.progress-value {
  flex-shrink: 0;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: 999rpx;
}

.progress-fill.primary { background: #5B7B9A; }
.progress-fill.success { background: #6B9B6B; }

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

.plan-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 52rpx 30rpx;
}

.empty-mark {
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 48rpx;
  line-height: 96rpx;
  font-weight: 800;
  margin-bottom: 22rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #2D3E50;
}

.empty-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #9AABBA;
}

.empty-action {
  margin-top: 34rpx;
  min-width: 220rpx;
  height: 80rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: #5B7B9A;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 80rpx;
}

.empty-action:active,
.review-card:active,
.review-button:active {
  opacity: 0.82;
}

.review-section {
  padding-bottom: 12rpx;
}

.review-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border: 1rpx solid #EDF1F5;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.subject-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 700;
}

.review-count {
  min-width: 0;
  font-size: 22rpx;
  color: #9AABBA;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-question {
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.58;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.review-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meta-item {
  font-size: 21rpx;
  line-height: 1.35;
  color: #6B7B8D;
  background: #F7F6F2;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
}

.review-actions {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.review-button {
  min-width: 176rpx;
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 68rpx;
}
