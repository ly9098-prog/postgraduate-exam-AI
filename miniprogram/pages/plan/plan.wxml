<view class="page">
  <view class="plan-hero">
    <view class="hero-copy">
      <text class="eyebrow">间隔复习</text>
      <text class="hero-title">今日复习</text>
      <text class="hero-desc">把容易遗忘的题，按节奏重新捡回来</text>
    </view>
    <view class="hero-badge">
      <text class="hero-badge-num">{{stats.due_today || 0}}</text>
      <text class="hero-badge-label">待复习</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在整理复习计划...</text>
  </view>

  <block wx:else>
    <!-- 复习统计 -->
    <view class="stats-panel" wx:if="{{stats}}">
      <view class="section-head">
        <view>
          <text class="section-title">复习进度</text>
          <text class="section-subtitle">今天先处理到期错题，再补充新的练习</text>
        </view>
        <text class="section-chip">SM-2</text>
      </view>
      <view class="stats-grid">
        <view class="stat-item primary">
          <text class="stat-num">{{stats.due_today || 0}}</text>
          <text class="stat-label">待复习</text>
        </view>
        <view class="stat-item success">
          <text class="stat-num">{{stats.reviewed_today || 0}}</text>
          <text class="stat-label">已复习</text>
        </view>
        <view class="stat-item sage">
          <text class="stat-num">{{stats.mastered || 0}}</text>
          <text class="stat-label">已掌握</text>
        </view>
        <view class="stat-item muted">
          <text class="stat-num">{{stats.total_wrong || 0}}</text>
          <text class="stat-label">总错题</text>
        </view>
      </view>
      <view class="progress-list">
        <view class="progress-row">
          <view class="progress-top">
            <text class="progress-label">今日完成度</text>
            <text class="progress-value">{{stats.reviewed_today || 0}} / {{(stats.reviewed_today || 0) + (stats.due_today || 0)}}</text>
          </view>
          <view class="progress-track"><view class="progress-fill primary" style="width:{{stats._reviewProgressPct}}%"></view></view>
        </view>
        <view class="progress-row">
          <view class="progress-top">
            <text class="progress-label">掌握比例</text>
            <text class="progress-value">{{stats.mastered || 0}} / {{stats.total_wrong || 0}}</text>
          </view>
          <view class="progress-track"><view class="progress-fill success" style="width:{{stats._masteredPct}}%"></view></view>
        </view>
      </view>
    </view>

    <!-- 空态 -->
    <view wx:if="{{dueList.length === 0}}" class="empty-state plan-empty">
      <view class="empty-mark">✓</view>
      <text class="empty-title">今日没有待复习的错题</text>
      <text class="empty-desc">可以继续刷题，让系统为你安排下一轮复盘</text>
      <button class="empty-action" bindtap="goPractice">去刷题</button>
    </view>

    <!-- 待复习列表 -->
    <view class="review-section" wx:if="{{dueList.length > 0}}">
      <view class="section-head list-head">
        <view>
          <text class="section-title">待复习错题</text>
          <text class="section-subtitle">按到期顺序处理，优先稳住记忆曲线</text>
        </view>
        <text class="section-chip">{{dueList.length}} 题</text>
      </view>
      <view wx:for="{{dueList}}" wx:key="id" class="review-card" bindtap="goReview" data-id="{{item.id}}">
        <view class="review-header">
          <text class="subject-tag">{{item._subjectLabel}}</text>
          <text class="review-count">已复习 {{item.review_count || 0}} 次</text>
        </view>
        <view class="review-question">{{item.content.text}}</view>
        <view class="review-meta">
          <text class="meta-item" wx:if="{{item.efactor}}">难度因子 {{item.efactor}}</text>
          <text class="meta-item">间隔 {{item._intervalLabel}}</text>
        </view>
        <view class="review-actions">
          <button class="review-button" catchtap="goReview" data-id="{{item.id}}">开始复习</button>
        </view>
      </view>
    </view>
  </block>
</view>