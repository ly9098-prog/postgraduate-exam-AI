<view class="page-title">今日复习</view>

<!-- 复习统计 -->
<view class="stats-row" wx:if="{{!loading && stats}}">
  <view class="stat-item">
    <text class="stat-num">{{stats.due_today || 0}}</text>
    <text class="stat-label">待复习</text>
  </view>
  <view class="stat-item">
    <text class="stat-num">{{stats.reviewed_today || 0}}</text>
    <text class="stat-label">已复习</text>
  </view>
  <view class="stat-item">
    <text class="stat-num">{{stats.mastered || 0}}</text>
    <text class="stat-label">已掌握</text>
  </view>
  <view class="stat-item">
    <text class="stat-num">{{stats.total_wrong || 0}}</text>
    <text class="stat-label">总错题</text>
  </view>
</view>

<view wx:if="{{loading}}" class="loading-wrap">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>

<!-- 空态 -->
<view wx:if="{{!loading && dueList.length === 0}}" class="empty-state">
  <text style="font-size:60rpx;margin-bottom:20rpx">🎉</text>
  <text>今日没有待复习的错题</text>
  <text style="font-size:26rpx;color:#bbb;margin-top:12rpx">去刷几道题积累错题吧</text>
  <button class="btn-primary" style="margin-top:40rpx;width:auto;padding:20rpx 80rpx" bindtap="goPractice">去刷题</button>
</view>

<!-- 待复习列表 -->
<view wx:for="{{dueList}}" wx:key="id" class="card review-card" bindtap="goReview" data-id="{{id}}">
  <view class="review-header">
    <text class="subject-tag">{{subjectLabel(subject)}}</text>
    <text class="review-count">已复习 {{review_count}} 次</text>
  </view>
  <view class="review-question">{{content.text}}</view>
  <view class="review-meta">
    <text class="meta-item" wx:if="{{efactor}}">难度因子 {{efactor}}</text>
    <text class="meta-item">间隔 {{intervalLabel(interval)}}</text>
  </view>
  <view class="review-actions">
    <button class="btn-small" catchtap="goReview" data-id="{{id}}">开始复习</button>
  </view>
</view>
