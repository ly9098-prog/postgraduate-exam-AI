<view class="login-page">
  <view class="sky-layer sky-one"></view>
  <view class="sky-layer sky-two"></view>
  <view class="grid-layer"></view>

  <view class="login-shell">
    <view class="brand-stage">
      <view class="hero-brand-card">
        <view class="hero-orb hero-orb-one"></view>
        <view class="hero-orb hero-orb-two"></view>
        <view class="hero-content">
          <view class="hero-topline">
            <text class="hero-label">考研错题成长助手</text>
            <text class="hero-status">AI Review</text>
          </view>
          <text class="hero-brand-name">MemoGrad</text>
          <text class="hero-slogan">每天进步一点点</text>
          <text class="hero-desc">让错题成为成长的阶梯</text>
          <view class="hero-note-row">
            <view class="hero-note-dot"></view>
            <text class="hero-note-text">登录后同步错题、复习计划与学习进度</text>
          </view>
        </view>
        <view class="growth-illustration" aria-label="学习成长插画">
          <view class="illustration-particle ip-1"></view>
          <view class="illustration-particle ip-2"></view>
          <view class="illustration-particle ip-3"></view>
          <view class="illustration-particle ip-4"></view>
          <view class="book-stack book-back"></view>
          <view class="book-stack book-front"></view>
          <view class="growth-card mini-card-one">
            <text class="mini-card-value">LV</text>
            <text class="mini-card-label">成长</text>
          </view>
          <view class="growth-card mini-card-two">
            <text class="mini-card-value">+1</text>
            <text class="mini-card-label">复习</text>
          </view>
          <view class="growth-sprout">
            <view class="sprout-stem"></view>
            <view class="sprout-leaf leaf-left"></view>
            <view class="sprout-leaf leaf-right"></view>
          </view>
        </view>
      </view>

      <view class="insight-row">
        <view class="insight-card">
          <text class="insight-num">SRS</text>
          <text class="insight-label">间隔复习</text>
        </view>
        <view class="insight-card middle">
          <text class="insight-num">AI</text>
          <text class="insight-label">解析辅助</text>
        </view>
        <view class="insight-card">
          <text class="insight-num">3科</text>
          <text class="insight-label">考研场景</text>
        </view>
      </view>
    </view>

    <view class="login-panel">
      <view class="panel-header">
        <text class="panel-label">微信同步</text>
        <text class="panel-title">开启你的学习成长档案</text>
        <text class="panel-desc">用微信身份保存错题、复习计划和连续学习记录</text>
      </view>

      <button class="wechat-login-btn" bindtap="onWechatLogin" loading="{{loading}}" disabled="{{loading}}">
        <text class="wechat-login-text">微信一键登录</text>
      </button>

      <view class="agreement-box">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-check">
            <checkbox value="agreed" checked="{{agreed}}" color="#4F7FFF" />
            <text class="agreement-text">我已阅读并同意以下协议</text>
          </label>
        </checkbox-group>
        <view class="agreement-links">
          <text class="agreement-link" data-type="user" bindtap="openAgreement">《用户协议》</text>
          <text class="agreement-link" data-type="privacy" bindtap="openAgreement">《隐私政策》</text>
          <text class="agreement-link" data-type="ai" bindtap="openAgreement">《AI免责声明》</text>
        </view>
      </view>

      <view wx:if="{{showDevLogin}}" class="dev-entry" bindtap="onDevLogin">
        <text class="dev-text">开发者模式</text>
        <text class="dev-arrow line-icon icon-chevron-right" style="width:28rpx;height:28rpx;color:#315CFF;"></text>
      </view>

      <view wx:if="{{error}}" class="error-msg">{{error}}</view>
    </view>

    <view class="footer">
      <text class="footer-text">学习数据用于错题记录与智能刷题服务</text>
      <text class="footer-text">ICP备案号：桂ICP备2026003057号</text>
    </view>
  </view>
</view>
