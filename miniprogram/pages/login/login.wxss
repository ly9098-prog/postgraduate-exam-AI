@import '../../styles/brand-shell.wxss';

.entry-pending {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F4F4EE;
}

.entry-pending-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}

.entry-pending-brand {
  color: #173426;
  font-size: 52rpx;
  font-weight: 700;
}

.entry-pending-title {
  margin-top: 32rpx;
  color: #173426;
  font-size: 30rpx;
}

.entry-pending-desc {
  margin-top: 12rpx;
  color: #53665A;
  font-size: 24rpx;
}

.entry-pending-indicator {
  width: 36rpx;
  height: 36rpx;
  margin-top: 32rpx;
  border: 3rpx solid #D9E1D9;
  border-top-color: #173426;
  border-radius: 50%;
  animation: entry-pending-spin 900ms linear infinite;
}

@keyframes entry-pending-spin {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .entry-pending-indicator { animation: none; }
}

page {
  min-height: 100vh;
  background: #F4F4EE;
  color: #15231A;
}

.login-root {
  min-height: 100vh;
  background: #F4F4EE;
}

.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 100% 6%, rgba(183, 232, 42, .10), transparent 330rpx),
    linear-gradient(180deg, #F6F6F0 0%, #F1F2EC 100%);
}

.ambient-grid {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 250rpx;
  bottom: 120rpx;
  opacity: .58;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(49, 73, 58, .055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(49, 73, 58, .045) 1rpx, transparent 1rpx);
  background-size: 100% 54rpx, 46rpx 46rpx;
  mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 80%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 16%, #000 80%, transparent 100%);
}

.ambient-glow {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
  filter: blur(2rpx);
}

.glow-one {
  width: 480rpx;
  height: 480rpx;
  right: -260rpx;
  top: 160rpx;
  background: rgba(183, 232, 42, .08);
}

.glow-two {
  width: 420rpx;
  height: 420rpx;
  left: -270rpx;
  bottom: 160rpx;
  background: rgba(21, 51, 35, .045);
}

.login-shell {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - env(safe-area-inset-bottom));
  padding: 24rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.brand-stage {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hero-brand-card {
  position: relative;
  min-height: 360rpx;
  padding: 28rpx 28rpx 25rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .08);
  border-radius: 36rpx;
  background: #10251A;
  box-shadow: 0 20rpx 46rpx rgba(18, 45, 30, .18);
}

.hero-grid {
  position: absolute;
  inset: 0;
  opacity: .38;
  background-image:
    linear-gradient(rgba(255, 255, 255, .055) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, .045) 1rpx, transparent 1rpx);
  background-size: 50rpx 50rpx;
  mask-image: linear-gradient(90deg, #000 0%, #000 60%, transparent 100%);
  -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 60%, transparent 100%);
}

.hero-glow {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -140rpx;
  top: -160rpx;
  border-radius: 50%;
  background: rgba(183, 232, 42, .12);
  box-shadow: 0 0 100rpx rgba(183, 232, 42, .08);
}

.hero-chart {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  width: 210rpx;
  height: 105rpx;
  opacity: .58;
}

.chart-line {
  position: absolute;
  height: 3rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .35);
  transform-origin: left center;
}

.chart-line-a { width: 60rpx; left: 0; top: 74rpx; transform: rotate(-22deg); }
.chart-line-b { width: 72rpx; left: 56rpx; top: 51rpx; transform: rotate(18deg); }
.chart-line-c { width: 78rpx; left: 123rpx; top: 73rpx; transform: rotate(-35deg); background: #B7E82A; }

.chart-node {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid rgba(255, 255, 255, .64);
  border-radius: 50%;
  background: #10251A;
}

.node-a { left: -2rpx; top: 68rpx; }
.node-b { left: 55rpx; top: 44rpx; }
.node-c { left: 121rpx; top: 67rpx; }
.node-d { right: 3rpx; top: 20rpx; }
.chart-node.active { border-color: #B7E82A; box-shadow: 0 0 0 11rpx rgba(183, 232, 42, .10); }

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 470rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.hero-label,
.hero-status {
  padding: 7rpx 13rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .065);
  color: rgba(255, 255, 255, .70);
  font-size: 18rpx;
  font-weight: 850;
  line-height: 1.3;
  letter-spacing: .5rpx;
}

.hero-status {
  color: #B7E82A;
  border-color: rgba(183, 232, 42, .16);
  background: rgba(183, 232, 42, .07);
}

.hero-brand-name {
  display: block;
  margin-top: 26rpx;
  color: #FFFFFF;
  font-size: 62rpx;
  font-weight: 950;
  line-height: 1;
  letter-spacing: -2rpx;
}

.hero-slogan {
  display: block;
  margin-top: 15rpx;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  display: block;
  margin-top: 7rpx;
  color: rgba(239, 245, 240, .64);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.hero-note-row {
  display: inline-flex;
  align-items: center;
  gap: 11rpx;
  margin-top: 24rpx;
  padding: 13rpx 17rpx;
  border: 1rpx solid rgba(255, 255, 255, .10);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .055);
}

.hero-note-dot {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #B7E82A;
  box-shadow: 0 0 0 7rpx rgba(183, 232, 42, .10);
}

.hero-note-text {
  color: rgba(255, 255, 255, .68);
  font-size: 19rpx;
  font-weight: 780;
  line-height: 1.35;
}

.growth-illustration {
  position: absolute;
  z-index: 1;
  right: 7rpx;
  bottom: 2rpx;
  width: 225rpx;
  height: 190rpx;
  opacity: .98;
}

.book-stack {
  position: absolute;
  border-radius: 22rpx;
  box-shadow: 0 14rpx 30rpx rgba(0, 0, 0, .18);
}

.book-back {
  width: 144rpx;
  height: 82rpx;
  right: 20rpx;
  bottom: 26rpx;
  background: rgba(255, 255, 255, .18);
  transform: rotate(-10deg);
}

.book-front {
  width: 154rpx;
  height: 96rpx;
  right: 37rpx;
  bottom: 5rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #E9EDDF 100%);
  transform: rotate(5deg);
}

.growth-card {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, .7);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, .14);
}

.mini-card-one {
  width: 76rpx;
  height: 74rpx;
  left: 2rpx;
  top: 18rpx;
  transform: rotate(-8deg);
}

.mini-card-two {
  width: 74rpx;
  height: 70rpx;
  right: 0;
  top: 48rpx;
  transform: rotate(9deg);
}

.mini-card-value {
  color: #173426;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.1;
}

.mini-card-label {
  margin-top: 3rpx;
  color: #708078;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.2;
}

.growth-sprout {
  position: absolute;
  left: 72rpx;
  top: 57rpx;
  width: 70rpx;
  height: 94rpx;
}

.sprout-stem {
  position: absolute;
  left: 33rpx;
  bottom: 0;
  width: 7rpx;
  height: 73rpx;
  border-radius: 999rpx;
  background: #79A300;
}

.sprout-leaf {
  position: absolute;
  width: 43rpx;
  height: 27rpx;
  border-radius: 999rpx 999rpx 999rpx 7rpx;
  background: #B7E82A;
}

.leaf-left { left: 0; top: 18rpx; transform: rotate(-28deg); }
.leaf-right { right: 0; top: 4rpx; transform: rotate(34deg) scaleX(-1); }

.insight-row {
  display: flex;
  gap: 10rpx;
}

.insight-card {
  flex: 1;
  min-width: 0;
  padding: 17rpx 8rpx 15rpx;
  border: 1rpx solid #DDE2DA;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .62);
  box-shadow: 0 9rpx 24rpx rgba(23, 52, 38, .05);
  text-align: center;
}

.insight-num {
  display: block;
  color: #173426;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1.15;
}

.insight-label {
  display: block;
  margin-top: 4rpx;
  color: #78847C;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.3;
}

.login-panel {
  padding: 36rpx 28rpx 34rpx;
  border: 1rpx solid #DDE2DA;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .72);
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .06);
}

.panel-header {
  margin-bottom: 25rpx;
}

.panel-label {
  display: inline-block;
  color: #748078;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.panel-title {
  display: block;
  margin-top: 9rpx;
  color: #132118;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.25;
  letter-spacing: -.5rpx;
}

.panel-desc {
  display: block;
  margin-top: 7rpx;
  color: #758078;
  font-size: 22rpx;
  line-height: 1.55;
}

.wechat-login-btn {
  width: 100%;
  height: 88rpx;
  padding: 0 14rpx 0 26rpx;
  border: none;
  border-radius: 24rpx;
  background: #B7E82A;
  color: #10251A;
  box-shadow: 0 14rpx 30rpx rgba(104, 140, 0, .17);
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: transform .16s ease, opacity .16s ease;
}

.wechat-login-btn::after { border: none; }
.wechat-login-btn-pressed { transform: scale(.985); opacity: .84; }
.wechat-login-btn[disabled] { opacity: .62; }

.wechat-login-text {
  flex: 1;
  padding-left: 40rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 950;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 800;
}

/* ── 左中：品牌文字 ── */

.brand-text {
  display: flex;
  flex-direction: column;
  margin-left: 22rpx;
  position: relative;
  z-index: 1;
}

.login-arrow {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 28rpx;
  font-weight: 700;
}

.agreement-box {
  margin-top: 22rpx;
  padding: 21rpx 18rpx 19rpx;
  border: 1rpx dashed #D7DDD4;
  border-radius: 22rpx;
  background: rgba(246, 247, 242, .72);
}

.agreement-check {
  display: flex;
  align-items: center;
}

.agreement-check checkbox {
  transform: scale(.82);
  transform-origin: left center;
}

.agreement-text {
  margin-left: -3rpx;
  color: #69766E;
  font-size: 20rpx;
  line-height: 1.45;
}

.agreement-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 13rpx;
  margin-top: 10rpx;
  padding-left: 42rpx;
}

.agreement-link {
  color: #315A42;
  font-size: 19rpx;
  font-weight: 850;
  line-height: 1.45;
  text-decoration: underline;
  text-decoration-color: rgba(49, 90, 66, .28);
  text-underline-offset: 5rpx;
}

.agreement-link-pressed { opacity: .58; }

.dev-entry {
  margin-top: 16rpx;
  min-height: 68rpx;
  padding: 0 14rpx 0 18rpx;
  border-top: 1rpx solid #E1E5DF;
  color: #536158;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 21rpx;
  font-weight: 800;
}

.dev-entry-pressed { opacity: .6; }
.dev-arrow { color: #173426; font-size: 28rpx; font-weight: 900; }

.error-msg {
  margin-top: 14rpx;
  padding: 15rpx 17rpx;
  border: 1rpx solid rgba(185, 28, 28, .12);
  border-radius: 18rpx;
  background: rgba(254, 242, 242, .82);
  color: #B42318;
  font-size: 20rpx;
  line-height: 1.5;
  word-break: break-all;
}

.value-panel {
  overflow: hidden;
  border: 1rpx solid #DDE2DA;
  border-radius: 30rpx;
  background: rgba(250, 251, 247, .72);
  box-shadow: 0 12rpx 32rpx rgba(23, 52, 38, .045);
}

.value-panel-head {
  min-height: 64rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(215, 221, 212, .78);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.value-eyebrow {
  flex-shrink: 0;
  color: #66746B;
  font-size: 16rpx;
  font-weight: 950;
  line-height: 1.2;
  letter-spacing: 2.2rpx;
}

.value-caption {
  overflow: hidden;
  color: #8A948D;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.value-list {
  padding: 5rpx 20rpx 7rpx;
}

.value-item {
  min-height: 54rpx;
  padding: 4rpx;
  display: flex;
  align-items: center;
}

.value-item + .value-item {
  border-top: 1rpx solid rgba(220, 225, 218, .72);
}

.value-marker {
  width: 47rpx;
  height: 35rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(183, 232, 42, .28);
  border-radius: 999rpx;
  background: rgba(183, 232, 42, .13);
  color: #486300;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 15rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: .5rpx;
}

.value-copy {
  min-width: 0;
  margin-left: 15rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.value-title {
  flex-shrink: 0;
  color: #173426;
  font-size: 22rpx;
  font-weight: 920;
  line-height: 1.35;
}

.value-desc {
  min-width: 0;
  overflow: hidden;
  color: #7C8880;
  font-size: 18rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.footer {
  padding: 7rpx 20rpx 0;
  text-align: center;
}

.footer-text {
  display: block;
  color: #98A098;
  font-size: 17rpx;
  line-height: 1.55;
}

.page-enter { animation: pageEnter .36s cubic-bezier(.2, .8, .2, 1) both; }
.delay-one { animation-delay: .05s; }
.delay-two { animation-delay: .10s; }
.delay-three { animation-delay: .15s; }

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .page-enter,
  .wechat-login-btn {
    animation: none !important;
    transition: none !important;
  }
}
