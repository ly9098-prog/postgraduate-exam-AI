page {
  background: #F8FAFF;
}

.login-page {
  position: relative;
  min-height: 100vh;
  padding: 26rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.82) 0%, transparent 28%),
    radial-gradient(circle at 88% 22%, rgba(79, 127, 255, 0.16) 0%, transparent 26%),
    linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.sky-layer {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.sky-one {
  width: 620rpx;
  height: 620rpx;
  right: -260rpx;
  top: -230rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.74) 0%, rgba(110, 193, 255, 0.2) 40%, transparent 72%);
}

.sky-two {
  width: 520rpx;
  height: 520rpx;
  left: -250rpx;
  bottom: 210rpx;
  background: radial-gradient(circle, rgba(110, 193, 255, 0.22) 0%, rgba(79, 127, 255, 0.08) 42%, transparent 72%);
}

.grid-layer {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 240rpx;
  bottom: 132rpx;
  border-radius: 44rpx;
  background-image:
    linear-gradient(rgba(79, 127, 255, 0.08) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(110, 193, 255, 0.06) 1rpx, transparent 1rpx);
  background-size: 100% 54rpx, 46rpx 46rpx;
  mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
  pointer-events: none;
}

.login-shell {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 58rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.brand-stage {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.hero-brand-card {
  position: relative;
  overflow: hidden;
  min-height: 430rpx;
  padding: 34rpx;
  border-radius: 42rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  box-shadow: 0 22rpx 54rpx rgba(79, 127, 255, 0.26);
  animation: cardEnter 0.34s ease-out both;
}

.hero-orb {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.hero-orb-one {
  width: 340rpx;
  height: 340rpx;
  right: -120rpx;
  top: -120rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero-orb-two {
  width: 260rpx;
  height: 260rpx;
  left: -90rpx;
  bottom: -120rpx;
  background: rgba(255, 255, 255, 0.13);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 470rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hero-label,
.hero-status {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 800;
}

.hero-status {
  background: rgba(255, 255, 255, 0.13);
}

.hero-brand-name {
  display: block;
  margin-top: 30rpx;
  font-size: 66rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 900;
  letter-spacing: -2rpx;
}

.hero-slogan {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  line-height: 1.22;
  color: #FFFFFF;
  font-weight: 900;
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
  font-weight: 700;
}

.hero-note-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 34rpx;
  padding: 16rpx 20rpx;
  max-width: 470rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
}

.hero-note-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.hero-note-text {
  font-size: 23rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 800;
}

.growth-illustration {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 250rpx;
  height: 230rpx;
  z-index: 1;
}

.book-stack {
  position: absolute;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(23, 37, 84, 0.18);
}

.book-back {
  width: 154rpx;
  height: 92rpx;
  right: 24rpx;
  bottom: 32rpx;
  background: rgba(255, 255, 255, 0.46);
  transform: rotate(-10deg);
}

.book-front {
  width: 164rpx;
  height: 108rpx;
  right: 42rpx;
  bottom: 8rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #EAF2FF 100%);
  transform: rotate(5deg);
}

.growth-card {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(23, 37, 84, 0.14);
}

.mini-card-one {
  width: 84rpx;
  height: 82rpx;
  left: 4rpx;
  top: 28rpx;
  transform: rotate(-8deg);
}

.mini-card-two {
  width: 82rpx;
  height: 78rpx;
  right: 2rpx;
  top: 58rpx;
  transform: rotate(9deg);
}

.mini-card-value {
  font-size: 26rpx;
  line-height: 1.1;
  color: #172554;
  font-weight: 900;
}

.mini-card-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 1.2;
  color: #6B7C99;
  font-weight: 800;
}

.growth-sprout {
  position: absolute;
  left: 82rpx;
  top: 70rpx;
  width: 76rpx;
  height: 104rpx;
}

.sprout-stem {
  position: absolute;
  left: 36rpx;
  bottom: 0;
  width: 8rpx;
  height: 82rpx;
  border-radius: 999rpx;
  background: #22C55E;
}

.sprout-leaf {
  position: absolute;
  width: 48rpx;
  height: 30rpx;
  border-radius: 999rpx 999rpx 999rpx 8rpx;
  background: #BBF7D0;
}

.leaf-left {
  left: 0;
  top: 18rpx;
  transform: rotate(-28deg);
}

.leaf-right {
  right: 0;
  top: 4rpx;
  transform: rotate(34deg) scaleX(-1);
}

.insight-row {
  display: flex;
  gap: 14rpx;
}

.insight-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  box-shadow: 0 12rpx 28rpx rgba(42, 84, 160, 0.1);
  text-align: center;
  animation: cardEnter 0.34s ease-out both;
}

.insight-card.middle {
  transform: translateY(10rpx);
  animation-delay: 0.04s;
}

.insight-num {
  display: block;
  font-size: 30rpx;
  line-height: 1.2;
  color: #172554;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.insight-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #6B7C99;
  font-weight: 800;
}

.login-panel {
  margin-top: 8rpx;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96) 0%, rgba(246, 249, 255, 0.94) 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(42, 84, 160, 0.1);
  animation: cardEnter 0.34s ease-out 0.08s both;
}

.panel-header {
  margin-bottom: 24rpx;
}

.panel-label {
  display: inline-block;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.1);
  font-size: 20rpx;
  line-height: 1.35;
  color: #315CFF;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.panel-title {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  line-height: 1.25;
  color: #172554;
  font-weight: 900;
}

.panel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6B7C99;
}

.wechat-login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 16rpx 34rpx rgba(79, 127, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.dev-entry:active,
.agreement-link:active {
  opacity: 0.82;
}

.wechat-login-btn[disabled] {
  opacity: 0.66;
  box-shadow: none;
}

.wechat-login-text {
  font-size: 29rpx;
  color: #FFFFFF;
  font-weight: 900;
}

.agreement-box {
  margin-top: 20rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.58);
  border: 1rpx dashed rgba(79, 127, 255, 0.24);
}

.agreement-check {
  display: flex;
  align-items: center;
  min-height: 56rpx;
}

.agreement-check checkbox {
  transform: scale(0.82);
  margin-right: 4rpx;
}

.agreement-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #42526B;
}

.agreement-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  padding-left: 58rpx;
  margin-top: 8rpx;
}

.agreement-link {
  font-size: 24rpx;
  line-height: 1.75;
  color: #315CFF;
  font-weight: 900;
  padding: 4rpx 0;
}

.dev-entry {
  margin: 18rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: fit-content;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  border: 1rpx solid rgba(79, 127, 255, 0.12);
}

.dev-text {
  font-size: 23rpx;
  line-height: 1.35;
  color: #3E5874;
  font-weight: 800;
}

.dev-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #315CFF;
}

.error-msg {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #FEF2F2;
  border: 1rpx solid rgba(239, 68, 68, 0.14);
  color: #C24141;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.footer {
  margin-top: auto;
  padding: 4rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.footer-text {
  font-size: 21rpx;
  line-height: 1.45;
  color: #8EA0BA;
  text-align: center;
}

@keyframes cardEnter {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-brand-card,
  .insight-card,
  .login-panel {
    animation: none;
  }

  .wechat-login-btn {
    transition: none;
  }
}
