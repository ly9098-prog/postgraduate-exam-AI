page {
  background: #F4EFE5;
}

.login-page {
  position: relative;
  min-height: 100vh;
  padding: 26rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 16% 12%, rgba(255, 255, 255, 0.82) 0%, transparent 28%),
    radial-gradient(circle at 88% 22%, rgba(52, 49, 43, 0.12) 0%, transparent 26%),
    linear-gradient(180deg, #F8F1E4 0%, #F3E9D8 58%, #EEE4D2 100%);
}

.sky-layer {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.sky-one {
  width: 620rpx;
  height: 620rpx;
  right: -260rpx;
  top: -230rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.72) 0%, rgba(255, 247, 232, 0.28) 38%, transparent 72%);
}

.sky-two {
  width: 520rpx;
  height: 520rpx;
  left: -250rpx;
  bottom: 210rpx;
  background: radial-gradient(circle, rgba(214, 187, 142, 0.24) 0%, rgba(52, 49, 43, 0.06) 42%, transparent 72%);
}

.grid-layer {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 240rpx;
  bottom: 132rpx;
  border-radius: 44rpx;
  background-image:
    linear-gradient(rgba(157, 126, 80, 0.09) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(157, 126, 80, 0.045) 1rpx, transparent 1rpx);
  background-size: 100% 54rpx, 46rpx 46rpx;
  mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
  -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 82%, transparent 100%);
  pointer-events: none;
}

.login-shell {
  position: relative;
  z-index: 1;
  min-height: calc(100vh - 58rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.brand-stage {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.paper-brand-card {
  position: relative;
  overflow: hidden;
  min-height: 310rpx;
  padding: 34rpx 34rpx 32rpx 54rpx;
  border-radius: 38rpx;
  background: linear-gradient(145deg, #FFFDF7 0%, #FFF7E8 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 22rpx 48rpx rgba(118, 91, 49, 0.13);
}

.paper-brand-card::before {
  content: '';
  position: absolute;
  left: 86rpx;
  right: 26rpx;
  top: 112rpx;
  height: 2rpx;
  background: rgba(214, 187, 142, 0.28);
  box-shadow: 0 58rpx 0 rgba(214, 187, 142, 0.22), 0 116rpx 0 rgba(214, 187, 142, 0.18);
}

.paper-brand-card::after {
  content: '';
  position: absolute;
  width: 210rpx;
  height: 210rpx;
  right: -74rpx;
  bottom: -88rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(52, 49, 43, 0.1), transparent 70%);
}

.paper-bookmark {
  position: absolute;
  left: 0;
  top: 0;
  width: 18rpx;
  height: 100%;
  background: linear-gradient(180deg, #34312B 0%, #5A5247 100%);
}

.paper-pin {
  position: absolute;
  right: 34rpx;
  top: 32rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(52, 49, 43, 0.1);
  border: 1rpx solid rgba(52, 49, 43, 0.2);
}

.paper-pin::after {
  content: '';
  position: absolute;
  left: 17rpx;
  top: 17rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #34312B;
}

.paper-content {
  position: relative;
  z-index: 1;
}

.paper-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 76rpx;
}

.paper-label,
.paper-date {
  font-size: 21rpx;
  line-height: 1.35;
  color: #8A7657;
  font-weight: 800;
}

.paper-date {
  color: #34312B;
}

.paper-brand-name {
  display: block;
  margin-top: 34rpx;
  font-size: 58rpx;
  line-height: 1.08;
  color: #172033;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.paper-slogan {
  display: block;
  margin-top: 18rpx;
  max-width: 560rpx;
  font-size: 35rpx;
  line-height: 1.3;
  color: #2C3A4B;
  font-weight: 900;
}

.paper-note-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 44rpx;
  padding: 16rpx 20rpx;
  width: fit-content;
  max-width: 100%;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.09);
}

.paper-note-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #34312B;
  flex-shrink: 0;
}

.paper-note-text {
  font-size: 24rpx;
  line-height: 1.35;
  color: #3E5874;
  font-weight: 900;
}

.insight-row {
  display: flex;
  gap: 14rpx;
}

.insight-card {
  flex: 1;
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 253, 247, 0.86);
  border: 1rpx solid rgba(224, 199, 158, 0.52);
  box-shadow: 0 12rpx 26rpx rgba(118, 91, 49, 0.08);
  text-align: center;
}

.insight-card.middle {
  transform: translateY(10rpx);
}

.insight-num {
  display: block;
  font-size: 30rpx;
  line-height: 1.2;
  color: #2C3A4B;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.insight-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: #8A7657;
  font-weight: 800;
}

.login-panel {
  margin-top: 8rpx;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 253, 247, 0.96) 0%, rgba(255, 247, 232, 0.94) 100%);
  border: 1rpx solid rgba(224, 199, 158, 0.56);
  box-shadow: 0 18rpx 40rpx rgba(118, 91, 49, 0.1);
}

.panel-header {
  margin-bottom: 24rpx;
}

.panel-label {
  display: inline-block;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.09);
  font-size: 20rpx;
  line-height: 1.35;
  color: #34312B;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.panel-title {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  line-height: 1.25;
  color: #2C3A4B;
  font-weight: 900;
}

.panel-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8A7657;
}

.wechat-login-btn {
  width: 100%;
  height: 94rpx;
  line-height: 94rpx;
  padding: 0;
  border: none;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #24221E 0%, #5A5247 100%);
  box-shadow: 0 16rpx 32rpx rgba(52, 49, 43, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-login-btn::after {
  border: none;
}

.wechat-login-btn:active,
.dev-entry:active,
.agreement-link:active {
  opacity: 0.82;
}

.wechat-login-btn[disabled] {
  opacity: 0.66;
  box-shadow: none;
}

.wechat-login-text {
  font-size: 29rpx;
  color: #FFFFFF;
  font-weight: 900;
}

.agreement-box {
  margin-top: 20rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx dashed rgba(157, 126, 80, 0.3);
}

.agreement-check {
  display: flex;
  align-items: center;
  min-height: 56rpx;
}

.agreement-check checkbox {
  transform: scale(0.82);
  margin-right: 4rpx;
}

.agreement-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #6F5B3E;
}

.agreement-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 18rpx;
  padding-left: 58rpx;
  margin-top: 8rpx;
}

.agreement-link {
  font-size: 24rpx;
  line-height: 1.75;
  color: #2C3A4B;
  font-weight: 900;
  padding: 4rpx 0;
}

.dev-entry {
  margin: 18rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: fit-content;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.08);
  border: 1rpx solid rgba(79, 127, 255, 0.12);
}

.dev-text {
  font-size: 23rpx;
  line-height: 1.35;
  color: #3E5874;
  font-weight: 800;
}

.dev-arrow {
  font-size: 30rpx;
  line-height: 1;
  color: #34312B;
}

.error-msg {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #FEF2F2;
  border: 1rpx solid rgba(239, 68, 68, 0.14);
  color: #C24141;
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.footer {
  margin-top: auto;
  padding: 4rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.footer-text {
  font-size: 21rpx;
  line-height: 1.45;
  color: #9A8565;
  text-align: center;
}
