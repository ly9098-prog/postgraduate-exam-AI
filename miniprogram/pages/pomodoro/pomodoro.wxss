.theme-light.page-free .ring-time-free {
  color: #10B981;
  text-shadow:
    0 0 12rpx rgba(16, 185, 129, .22),
    0 0 34rpx rgba(16, 185, 129, .12);
}
.theme-dark.page-free .ring-time-free {
  color: #6EE7B7;
  text-shadow:
    0 0 14rpx rgba(52, 211, 153, .34),
    0 0 38rpx rgba(16, 185, 129, .18);
}

