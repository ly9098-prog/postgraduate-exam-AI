@import '../../styles/tokens.wxss';

/* ── Page ── */
.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #F7F5F0;
}

/* ── 顶部卡片 ── */
.top-card {
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E5E0;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(43, 60, 80, 0.04);
}

.top-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.date-text {
  font-size: 26rpx;
  color: #6B7B8D;
  font-weight: 500;
}

.today-stats {
  display: flex;
  gap: 12rpx;
}

.stat-badge {
  font-size: 22rpx;
  color: #5B7B9A;
  background: #EDF1F5;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

/* ── 上下文标签 ── */
.context-tag {
  margin-bottom: 24rpx;
  padding: 14rpx 22rpx;
  background: #F5F1EB;
  border-radius: 16rpx;
  border-left: 4rpx solid #C49A6B;
}

.context-text {
  font-size: 24rpx;
  color: #B8864E;
}

/* ── 分区卡片 ── */
.section-card {
  padding: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E5E0;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(43, 60, 80, 0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D3E50;
  display: block;
  margin-bottom: 22rpx;
}

/* ── 科目选择 ── */
.subject-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.subject-item {
  padding: 14rpx 26rpx;
  border-radius: 20rpx;
  background: #F8F7F5;
  font-size: 26rpx;
  color: #6B7B8D;
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.subject-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #BCC8D4;
}

.subject-item:active {
  opacity: 0.82;
}

.subject-selected {
  background: #EDF1F5;
  color: #5B7B9A;
  border-color: rgba(91, 123, 154, 0.3);
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(91, 123, 154, 0.08);
}

.subject-selected .subject-dot {
  background: #5B7B9A;
}

/* ── 模式选择 ── */
.preset-row {
  display: flex;
  gap: 14rpx;
}

.preset-item {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  background: #F8F7F5;
  text-align: center;
  border: 2rpx solid transparent;
}

.preset-item:active {
  opacity: 0.82;
}

.preset-selected {
  background: #EDF1F5;
  border-color: rgba(91, 123, 154, 0.25);
  box-shadow: 0 2rpx 12rpx rgba(91, 123, 154, 0.08);
}

.preset-icon {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.preset-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2D3E50;
}

.preset-selected .preset-label {
  color: #5B7B9A;
}

.preset-desc {
  display: block;
  font-size: 22rpx;
  color: #9AABBA;
  margin-top: 6rpx;
}

/* ── 自定义时长 ── */
.custom-row {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EDE9E3;
}

.custom-item {
  margin-bottom: 20rpx;
}

.custom-item:last-child {
  margin-bottom: 0;
}

.custom-label {
  display: block;
  font-size: 24rpx;
  color: #6B7B8D;
  margin-bottom: 10rpx;
  font-weight: 500;
}

/* ── 开始按钮 ── */
.start-area {
  padding: 48rpx 0 32rpx;
  text-align: center;
}

.btn-start {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 104rpx;
  margin: 0 auto;
  background: #5B7B9A;
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 52rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(91, 123, 154, 0.25);
}

.btn-start:active {
  opacity: 0.86;
}

/* ── 计时器卡片 ── */
.timer-card {
  margin-top: 40rpx;
  text-align: center;
  padding: 40rpx 0;
}

.timer-subject {
  display: block;
  font-size: 28rpx;
  color: #6B7B8D;
  margin-bottom: 48rpx;
  font-weight: 500;
}

.timer-ring {
  position: relative;
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
}

.ring-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 460rpx;
  height: 460rpx;
}

.timer-display {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.timer-time {
  font-size: 96rpx;
  font-weight: 800;
  color: #2D3E50;
  line-height: 1;
}

.break-time {
  color: #5A8F5A;
}

.timer-hint {
  font-size: 24rpx;
  color: #9AABBA;
  margin-top: 16rpx;
  font-weight: 500;
}

.timer-actions {
  margin-top: 56rpx;
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.btn-end {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 80rpx;
  background: #F5EFEF;
  color: #C47A7A;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: 1rpx solid #EFE0E0;
}

.btn-end:active {
  opacity: 0.84;
}

.btn-skip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 80rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: 1rpx solid #E0EBE0;
}

.btn-skip:active {
  opacity: 0.84;
}

/* ── 统计入口 ── */
.stats-entry {
  text-align: center;
  margin-top: 36rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #E8E5E0;
}

.stats-entry:active {
  background: #F8F7F5;
}

.stats-entry-text {
  font-size: 26rpx;
  color: #5B7B9A;
  font-weight: 600;
}
