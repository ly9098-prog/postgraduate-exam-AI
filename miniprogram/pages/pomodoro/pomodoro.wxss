/* v4 idle controls: airy section spacing and circular subject launchers. */
.task-type-section {
  width: 100%;
  margin-top: 12rpx;
  margin-bottom: 46rpx;
}
.mode-section {
  margin-top: 0;
}
.section-label-divider {
  margin-bottom: 26rpx;
  letter-spacing: 2rpx;
  font-size: 22rpx;
  opacity: .88;
}
.subj-section {
  margin-bottom: 36rpx;
}
.subj-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 12rpx;
  row-gap: 22rpx;
  width: 100%;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.subj-card {
  width: auto;
  height: 142rpx;
  min-width: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  gap: 9rpx;
  transform: none;
}
.subj-card.active {
  border: 0;
  background: transparent;
  box-shadow: none;
  transform: translateY(-2rpx);
}
.subj-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(160, 184, 166, .28);
  border-radius: 50%;
  background: rgba(223, 238, 225, .66);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.82), 0 7rpx 20rpx rgba(42,78,52,.045);
  transition: transform .18s cubic-bezier(.22,1,.36,1), border-color .18s ease, background-color .18s ease, box-shadow .18s ease;
}
.subj-card.active .subj-icon-wrap {
  border-color: rgba(55, 151, 82, .46);
  background: rgba(219, 242, 221, .96);
  box-shadow: 0 0 0 7rpx rgba(72, 191, 98, .08), 0 10rpx 22rpx rgba(42, 112, 62, .08);
  transform: translateY(-2rpx) scale(1.035);
}
.subj-card-pressed .subj-icon-wrap {
  transform: scale(.94);
}
.subj-emoji {
  font-size: 50rpx;
  line-height: 1;
}
.subj-name {
  width: 100%;
  max-width: 146rpx;
  padding: 0 4rpx;
  color: rgba(255,255,255,.52);
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 650;
  text-align: center;
}
.theme-light .subj-card,
.theme-light .subj-card.active {
  border: 0;
  background: transparent;
  box-shadow: none;
}
.theme-light .subj-icon-wrap {
  border-color: #DCE8DD;
  background: linear-gradient(145deg, rgba(238,248,239,.96), rgba(224,240,226,.88));
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.98), 0 8rpx 22rpx rgba(44,84,53,.055);
}
.theme-light .subj-card.active .subj-icon-wrap {
  border-color: rgba(48, 139, 72, .44);
  background: linear-gradient(145deg,#E7F8E8,#D8F1DB);
  box-shadow: 0 0 0 7rpx rgba(71,187,96,.075), 0 10rpx 24rpx rgba(48,111,68,.10);
}
.theme-light .subj-name { color: #627067; }
.theme-light .subj-card.active .subj-name { color: #244C31; font-weight: 780; }
@media (max-width: 350px) {
  .subj-grid { column-gap: 6rpx; row-gap: 18rpx; }
  .subj-card { height: 132rpx; }
  .subj-icon-wrap { width: 84rpx; height: 84rpx; flex-basis: 84rpx; }
  .subj-emoji { font-size: 45rpx; }
