}

.size-large .confirm-cover-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
}

/* ── Confirm Theme: focus (blue/cyan) ── */
.confirm-theme-focus .confirm-cover-card {
  background: rgba(15, 23, 42, 0.98);
  border: 1rpx solid rgba(96, 165, 250, 0.24);
  box-shadow:
    0 0 50rpx rgba(59, 130, 246, 0.22),
