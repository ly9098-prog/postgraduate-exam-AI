}

/* Timer digits are display information, not body copy. Keep a luminous
   treatment in both themes so the dial remains visually consistent with the
   cyan/emerald progress ring. Free timing keeps the animated emerald text
   gradient defined above; `color` is only its safe fallback. */
.theme-light.page-focus .ring-time {
  color: #168CB8;
  text-shadow:
    0 0 10rpx rgba(34, 184, 220, .24),
    0 0 30rpx rgba(34, 184, 220, .12);
}
.theme-dark.page-focus .ring-time {
