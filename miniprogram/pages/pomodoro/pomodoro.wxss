  background-color: #059669;
  background-image: linear-gradient(135deg, #10B981, #059669);
  color: #FFFFFF;
}


@media (prefers-reduced-motion: reduce) {
  .page,
  .font-size-btn,
  .stats-link {
    animation: none !important;
    transition: none !important;
  }
}

/* Nine compact, equal-width choices: eight leaves plus one 408 distribution. */
.subj-grid {
  display: flex;
  width: 100%;
  justify-content: space-between;
  column-gap: 12rpx;
  row-gap: 14rpx;
  flex-wrap: wrap;
}
.subj-card {
  width: 31%;
  flex: 0 0 31%;
  min-width: 0;
  height: 168rpx;
  gap: 9rpx;
  border-radius: 20rpx;
  padding: 10rpx 6rpx;
  box-sizing: border-box;
  transition: background-color .16s ease, border-color .16s ease, opacity .16s ease;
}
.subj-card-pressed { transform: none; opacity: .78; }
.subj-card.disabled { opacity: .48; }
.subj-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 68rpx;
}
.subj-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}
.subj-name {
  max-width: 100%;
  padding: 0;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
  white-space: normal;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.subj-subtitle {
  max-width: 100%;
  color: var(--text-secondary, #657269);
  font-size: 17rpx;
  line-height: 1.1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.theme-dark .subj-subtitle { color: rgba(213, 223, 235, .72); }
.theme-light .subj-card.disabled,
.theme-dark .subj-card.disabled { box-shadow: none; }
@media (max-width: 350px) {
  .subj-grid { column-gap: 8rpx; row-gap: 10rpx; }
  .subj-card { height: 158rpx; padding-left: 3rpx; padding-right: 3rpx; }
  .subj-name { font-size: 20rpx; }
  .subj-subtitle { font-size: 15rpx; }
}

/* ============================================
   LIGHT / DARK THEME BRIDGE
   Light palette follows the Home study-desk language.
   Existing dark selectors above remain the dark source of truth.
   ============================================ */
.page {
  position: relative;
  isolation: isolate;
  color: #FFFFFF;
}

.page-inner {
  position: relative;
  z-index: 1;
}

.theme-backdrop {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0;
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 232, 42, 0.12), transparent 380rpx),
    radial-gradient(circle at 0% 62%, rgba(21, 51, 35, 0.05), transparent 420rpx),
    linear-gradient(180deg, #F7F7F1 0%, #EFF1EA 100%);
  transition: opacity 480ms cubic-bezier(0.22, 1, 0.36, 1), background 480ms ease;
}

.theme-light .theme-backdrop {
  opacity: 1;
}

.theme-light.page-break .theme-backdrop {
  background:
    radial-gradient(circle at 100% 0%, rgba(249, 115, 22, 0.11), transparent 380rpx),
    radial-gradient(circle at 0% 68%, rgba(244, 63, 94, 0.045), transparent 440rpx),
    linear-gradient(180deg, #FBF7EF 0%, #F4EEE6 100%);
}

.theme-light.page-free .theme-backdrop {
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 232, 42, 0.13), transparent 380rpx),
    radial-gradient(circle at 0% 65%, rgba(16, 185, 129, 0.075), transparent 440rpx),
    linear-gradient(180deg, #F5F7EE 0%, #EDF3EA 100%);
}

/* Theme toggle — current mode is represented by sun / moon. */
.theme-toggle {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  flex: none;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: transform 220ms ease, background 420ms ease, border-color 420ms ease, box-shadow 420ms ease;
  -webkit-tap-highlight-color: transparent;
}

.theme-toggle-pressed {
  transform: scale(0.92);
}

.theme-glyph {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  line-height: 1;
  opacity: 0;
  transform: rotate(-80deg) scale(0.45);
  transition: opacity 340ms ease, transform 440ms cubic-bezier(0.22, 1, 0.36, 1), color 420ms ease;
}

.theme-toggle-light .theme-glyph-sun,
.theme-toggle-dark .theme-glyph-moon {
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

.theme-toggle-light .theme-glyph-sun {
  color: #173426;
  text-shadow: 0 0 16rpx rgba(183, 232, 42, 0.34);
}

.theme-toggle-dark .theme-glyph-moon {
  color: #BFDBFE;
  text-shadow: 0 0 16rpx rgba(96, 165, 250, 0.35);
}

.theme-toggle-switching .theme-glyph {
  animation: theme-glyph-pop 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes theme-glyph-pop {
  0% { transform: rotate(-25deg) scale(0.72); }
  58% { transform: rotate(12deg) scale(1.16); }
  100% { transform: rotate(0deg) scale(1); }
}

/* Shared color transitions; transforms and Canvas animation stay untouched. */
.exam-label,
.exam-count,
.stat-pill,
.stat-num,
.section-label,
.subj-card,
.subj-name,
.dot-ring,
.dot-fill,
.dot-label,
.mode-info,
.custom-label,
.context-hint,
.notify-row,
.notify-title,
.notify-sub,
.ceremony-subject,
.ceremony-divider,
.ceremony-duration,
.ceremony-preset,
.ceremony-status,
.spinner-ring,
.timer-subject,
.timer-hint,
.ring-time,
.ctrl-primary,
.ctrl-secondary,
.ctrl-label,
.break-skip,
.stats-link,
.stats-arrow,
.font-size-btn,
.font-size-icon {
  transition-property: color, background-color, background, border-color, box-shadow, opacity, text-shadow;
  transition-duration: 440ms;
  transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
}

