/* ============================================
   🎯 极夜·专注 — Pomodoro Timer
   Dark immersive theme for deep focus
   ============================================ */
@import '../../styles/tokens.wxss';

/* ── Native page (dark fallback for scroll bounce area) ── */
page {
  min-height: 100vh;
  background: #F4F4EE;
  background-color: #F4F4EE;
}

/* ── Page ── */
.page {
  min-height: 100vh;
  transition: background 1.5s ease;
}

.page-focus {
  background: linear-gradient(180deg, #0B1121 0%, #1A1F35 50%, #111827 100%);
}

.page-break {
  background: linear-gradient(180deg, #1A0A0A 0%, #2D1B1B 50%, #1A0F0F 100%);
}

.page-inner {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Entrance Animation (opacity only — no transform to protect Canvas) ── */
.animation-entrance {
  opacity: 0;
}

.animation-entrance.entered {
  animation: page-enter 0.18s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes page-enter {
  to {
    opacity: 1;
  }
}

/* ============================================
   TOP BAR — Exam countdown + today stats
   ============================================ */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0 8rpx;
  flex-shrink: 0;
}

.top-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.exam-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  font-weight: 400;
}

.exam-count {
  font-size: 34rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
  letter-spacing: 2rpx;
}

.debug-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #F59E0B;
  padding: 2rpx 8rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 6rpx;
  margin-left: 8rpx;
  letter-spacing: 2rpx;
}

.top-right {
  display: flex;
  gap: 12rpx;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
}

.stat-icon {
  font-size: 22rpx;
}

.stat-num {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
}

/* ============================================
   MAIN CONTENT — flex center
   ============================================ */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* ============================================
   IDLE STATE
   ============================================ */
.idle-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

/* ── Section Labels ── */
.section-label {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  letter-spacing: 6rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

/* ── Subject Grid ── */
.subj-section {
  width: 100%;
  margin-bottom: 48rpx;
}

.subj-loading,
.subj-error,
.subj-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 40rpx 0;
}

.subj-loading-text,
.subj-empty-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.subj-error-text {
  font-size: 24rpx;
  color: rgba(249, 115, 22, 0.5);
}

.subj-retry {
  font-size: 22rpx;
  color: #3B82F6;
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  border-radius: 999rpx;
}

.subj-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}

.subj-card {
  width: 156rpx;
  height: 170rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  -webkit-tap-highlight-color: transparent;
}

.subj-card-pressed {
  transform: scale(0.95);
  opacity: 0.6;
}

.subj-card.active {
  background: rgba(59, 130, 246, 0.1);
  border-color: rgba(59, 130, 246, 0.3);
  box-shadow: 0 0 40rpx rgba(59, 130, 246, 0.12);
  transform: translateY(-4rpx);
}

.subj-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.subj-name {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.45);
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.subj-card.active .subj-name {
  color: rgba(255, 255, 255, 0.85);
}

/* ── Mode Selection ── */
.mode-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.mode-row {
  display: flex;
  gap: 32rpx;
  align-items: center;
}

.mode-dot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
  transition: transform 0.2s ease, opacity 0.2s ease;
}

.mode-dot-pressed {
  transform: scale(0.92);
  opacity: 0.7;
}

.dot-ring {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.mode-dot.active .dot-ring {
  border-color: rgba(59, 130, 246, 0.6);
  box-shadow: 0 0 20rpx rgba(59, 130, 246, 0.15);
}

.mode-dot.active .debug-ring {
  border-color: rgba(245, 158, 11, 0.5);
  box-shadow: 0 0 20rpx rgba(245, 158, 11, 0.15);
}

.dot-fill {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  transition: all 0.3s ease;
}

.mode-dot.active .dot-fill {
  background: #3B82F6;
}

.dot-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  transition: color 0.3s ease;
}

.mode-dot.active .dot-label {
  color: rgba(255, 255, 255, 0.7);
}

.mode-info {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-top: 20rpx;
  letter-spacing: 1rpx;
}

/* ── Custom Sliders ── */
.custom-area {
  width: 100%;
  max-width: 460rpx;
  margin-top: 12rpx;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: all 0.4s ease;
}

.custom-area.visible {
  max-height: 400rpx;
  opacity: 1;
  margin-top: 28rpx;
}

.custom-row {
  margin-bottom: 16rpx;
}

.custom-row:last-child {
  margin-bottom: 0;
}

.custom-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 6rpx;
}

/* ── Context Hint ── */
.context-hint {
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.25);
  margin-bottom: 24rpx;
}

/* ── Notify Toggle Row ── */
.notify-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  margin: 0 0 32rpx;
}

.notify-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 24rpx;
}

.notify-title {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.notify-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.32);
  margin-top: 6rpx;
}

.notify-row switch {
  transform: scale(0.78);
  transform-origin: right center;
}

/* ── Start Button ── */
.btn-start {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 420rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #06B6D4 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 40rpx rgba(59, 130, 246, 0.3);
  margin: 0 auto;
  padding: 0;
  transition: all 0.3s ease;
}

.btn-start::after {
  border: none;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.97);
  box-shadow: 0 4rpx 20rpx rgba(59, 130, 246, 0.2);
}

.btn-start-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

/* ============================================
   CEREMONY STATE
   ============================================ */
.ceremony-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  animation: ceremony-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes ceremony-in {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.ceremony-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  animation: celeb-check 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.ceremony-subject {
  font-size: 42rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 24rpx;
}

.ceremony-divider {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(59, 130, 246, 0.4), transparent);
  margin-bottom: 24rpx;
}

.ceremony-duration {
  font-size: 64rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.ceremony-preset {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.3);
  margin-bottom: 40rpx;
}

.ceremony-spinner {
  margin-bottom: 24rpx;
}

.spinner-ring {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.06);
  border-top-color: #3B82F6;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.ceremony-status {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.35);
  letter-spacing: 6rpx;
  animation: ceremony-pulse 1.5s ease-in-out infinite;
}

@keyframes ceremony-pulse {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 0.7; }
}

@keyframes celeb-check {
  0% {
    transform: scale(0) rotate(-20deg);
    opacity: 0;
  }
  50% {
    transform: scale(1.15) rotate(5deg);
    opacity: 1;
  }
  70% {
    transform: scale(0.95) rotate(-2deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

/* ============================================
   TIMER STATE (Running / Break)
   ============================================ */
.timer-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: timer-in 0.18s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes timer-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.timer-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 40rpx;
}

.timer-subject {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

.timer-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 4rpx;
}

/* ── Ring Stage (transform-free zone for Canvas) ── */
.ring-stage {
  position: relative;
  width: 520rpx;
  height: 520rpx;
  flex: none;
  margin: 0 auto;
  transform: none;
}

.ring-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  transform: none;
}

.ring-glow {
  position: absolute;
  top: -30rpx;
  left: -30rpx;
  right: -30rpx;
  bottom: -30rpx;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  animation: ring-breath 3s ease-in-out infinite;
}

.page-focus .ring-glow {
  box-shadow:
    0 0 40rpx rgba(59, 130, 246, 0.25),
    0 0 80rpx rgba(59, 130, 246, 0.12),
    0 0 140rpx rgba(6, 182, 212, 0.08);
}

.page-break .ring-glow {
  box-shadow:
    0 0 40rpx rgba(249, 115, 22, 0.25),
    0 0 80rpx rgba(249, 115, 22, 0.12),
    0 0 140rpx rgba(244, 63, 94, 0.08);
}

@keyframes ring-breath {
  0%, 100% {
    opacity: 0.6;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.03);
  }
}

.ring-canvas {
  /* Keep the native Canvas in normal flow inside the fixed-size ring stage.
     Double absolute-positioning can lose the ancestor Y offset when a real
     device rebuilds the native layer after page re-entry. */
  position: relative;
  width: 520rpx;
  height: 520rpx;
  display: block;
  box-sizing: border-box;
  z-index: 1;
  opacity: 0;
  transition: opacity 0.12s ease;
}

.ring-canvas-ready {
  opacity: 1;
}

.ring-canvas-preparing {
  opacity: 0;
}

.ring-wrapper-confirming .ring-glow {
  opacity: 0;
  animation: none;
}

.ring-wrapper-confirming .ring-canvas {
  opacity: 0;
  pointer-events: none;
}


.ring-center {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-time {
  font-size: 88rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 8rpx;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.time-warm {
  color: rgba(255, 255, 255, 0.85);
}

.ring-status {
  font-size: 26rpx;
  color: rgba(249, 115, 22, 0.6);
  margin-top: 16rpx;
  letter-spacing: 4rpx;
}

/* ── Controls ── */
.controls-row {
  display: flex;
  gap: 40rpx;
  align-items: center;
  margin-top: 80rpx;
}

.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: all 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.ctrl-primary {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  justify-content: center;
}

.page-break .ctrl-primary {
  background: rgba(249, 115, 22, 0.1);
  border-color: rgba(249, 115, 22, 0.2);
}

.ctrl-secondary {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  justify-content: center;
}

.ctrl-skip {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(249, 115, 22, 0.06);
  border: 2rpx solid rgba(249, 115, 22, 0.12);
  justify-content: center;
}

.ctrl-icon {
  width: 36rpx;
  height: 36rpx;
}

.ctrl-icon--pause {
  width: 48rpx;
  height: 48rpx;
}

.ctrl-icon--stop {
  width: 34rpx;
  height: 34rpx;
  opacity: 0.55;
}

.ctrl-icon--skip {
  width: 44rpx;
  height: 44rpx;
}

.ctrl-label {
  font-size: 20rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 1rpx;
}

.ctrl-primary-pressed {
  background: rgba(59, 130, 246, 0.18);
  border-color: rgba(59, 130, 246, 0.3);
  box-shadow: 0 0 32rpx rgba(59, 130, 246, 0.2);
}

.ctrl-secondary-pressed {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.12);
}

/* ── Skip Break (inside break timer-wrap) ── */
.break-skip {
  margin-top: 28rpx;
  padding: 16rpx 40rpx;
  background: rgba(249, 115, 22, 0.06);
  border: 2rpx solid rgba(249, 115, 22, 0.12);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: rgba(249, 115, 22, 0.5);
}

/* ============================================
   BOTTOM BAR
   ============================================ */
.bottom-bar {
  flex-shrink: 0;
  padding: 20rpx 0;
  text-align: center;
}

.stats-link {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
  transition: all 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.stats-link-pressed {
  background: rgba(255, 255, 255, 0.06);
}

.stats-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
}

/* ============================================
   FONT SIZE TOGGLE
   ============================================ */
.font-size-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  transition: all 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.font-size-btn-pressed {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.92);
}

.font-size-icon {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.35);
  transition: color 0.2s ease;
}

.font-size-icon.active {
  color: #3B82F6;
}

/* ── Large size overrides ── */
.size-large .exam-label { font-size: 28rpx; }
.size-large .stat-num { font-size: 28rpx; }
.size-large .stat-icon { font-size: 26rpx; }
.size-large .section-label { font-size: 28rpx; }
.size-large .subj-emoji { font-size: 62rpx; }
.size-large .subj-name { font-size: 28rpx; }
.size-large .subj-card {
  width: 172rpx;
  height: 186rpx;
}
.size-large .dot-label { font-size: 26rpx; }
.size-large .mode-info { font-size: 26rpx; }
.size-large .custom-label { font-size: 28rpx; }
.size-large .context-hint { font-size: 26rpx; }
.size-large .notify-title { font-size: 30rpx; }
.size-large .notify-sub { font-size: 24rpx; }
.size-large .btn-start-text { font-size: 38rpx; }
.size-large .btn-start {
  width: 460rpx;
  height: 104rpx;
}
.size-large .ceremony-subject { font-size: 48rpx; }
.size-large .ceremony-duration { font-size: 72rpx; }
.size-large .ceremony-preset { font-size: 30rpx; }
.size-large .ceremony-status { font-size: 30rpx; }
.size-large .timer-subject { font-size: 34rpx; }
.size-large .timer-hint { font-size: 28rpx; }
.size-large .ring-time { font-size: 100rpx; }
.size-large .ring-status { font-size: 30rpx; }
.size-large .ctrl-icon { width: 42rpx; height: 42rpx; }
.size-large .ctrl-icon--pause { width: 56rpx; height: 56rpx; }
.size-large .ctrl-icon--stop { width: 40rpx; height: 40rpx; }
.size-large .ctrl-icon--skip { width: 52rpx; height: 52rpx; }
.size-large .ctrl-label { font-size: 24rpx; }
.size-large .ctrl-primary {
  width: 132rpx;
  height: 132rpx;
}
.size-large .ctrl-secondary {
  width: 110rpx;
  height: 110rpx;
}
.size-large .stats-link { font-size: 28rpx; }

/* ============================================
   🔥 EMBER FLOW — Free timer design system
   Warm emerald / teal palette for unbounded focus.
   Contrasts with the cool cyan of countdown mode.
   ============================================ */

/* ── Mode selector dot — emerald pulse ── */
.dot-ring-free {
  border-color: rgba(16, 185, 129, 0.35) !important;
  transition: all 0.4s ease !important;
}

.mode-dot.active .dot-ring-free {
  border-color: rgba(16, 185, 129, 0.7) !important;
  box-shadow: 0 0 30rpx rgba(16, 185, 129, 0.25), inset 0 0 20rpx rgba(16, 185, 129, 0.08) !important;
  animation: free-dot-glow 2.5s ease-in-out infinite !important;
}

@keyframes free-dot-glow {
  0%, 100% { box-shadow: 0 0 20rpx rgba(16, 185, 129, 0.2), inset 0 0 20rpx rgba(16, 185, 129, 0.05); }
  50% { box-shadow: 0 0 45rpx rgba(16, 185, 129, 0.35), inset 0 0 25rpx rgba(16, 185, 129, 0.1); }
}

.dot-fill-free {
  background: rgba(16, 185, 129, 0.35) !important;
  transition: all 0.3s ease !important;
}

.mode-dot.active .dot-fill-free {
  background: #10B981 !important;
  box-shadow: 0 0 16rpx rgba(16, 185, 129, 0.5);
}

/* ── Page-level shift — warm undertone ── */
.page-free {
  background: linear-gradient(180deg, #0B1121 0%, #0F1E1E 40%, #111827 100%) !important;
}

/* ── Ring glow — emerald breathing ── */
.page-free .ring-glow {
  box-shadow:
    0 0 60rpx rgba(16, 185, 129, 0.25),
    0 0 120rpx rgba(16, 185, 129, 0.1),
    0 0 200rpx rgba(5, 150, 105, 0.06) !important;
  animation: free-ring-breathe 3.5s ease-in-out infinite !important;
}

@keyframes free-ring-breathe {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.05);
  }
}

/* ── HH:MM:SS — gradient shimmer ── */
.ring-time-free {
  font-size: 80rpx;
  font-weight: 200;
  letter-spacing: 6rpx;
  background: linear-gradient(90deg, #6EE7B7 0%, #34D399 25%, #10B981 50%, #059669 75%, #34D399 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: free-shimmer 4s linear infinite;
  transition: opacity 0.4s ease, filter 0.4s ease;
}

@keyframes free-shimmer {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

.ring-time-free.time-dim {
  opacity: 0.45;
  animation: none;
  background: linear-gradient(135deg, rgba(110, 231, 183, 0.5), rgba(16, 185, 129, 0.35));
  background-size: 100% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ── Status indicator — emerald breathing dot ── */
.free-status-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.free-status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 16rpx rgba(16, 185, 129, 0.6);
  animation: free-dot-breathe 1.8s ease-in-out infinite;
}

@keyframes free-dot-breathe {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.75);
    box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.3);
  }
  50% {
    opacity: 1;
    transform: scale(1.15);
    box-shadow: 0 0 24rpx rgba(16, 185, 129, 0.7);
  }
}

.free-hint {
  font-size: 24rpx;
  color: rgba(16, 185, 129, 0.6) !important;
  letter-spacing: 4rpx;
  font-weight: 500;
}

/* ── Paused state — amber shift ── */
.free-status-dot.dot-paused {
  background: #F59E0B;
  box-shadow: 0 0 16rpx rgba(245, 158, 11, 0.5);
  animation: none;
  opacity: 0.8;
  transform: scale(1);
}

.hint-paused {
  color: rgba(245, 158, 11, 0.5) !important;
}

/* ── Free timer control buttons ── */
.page-free .ctrl-primary {
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.18);
}

.page-free .ctrl-primary-pressed {
  background: rgba(16, 185, 129, 0.18);
  border-color: rgba(16, 185, 129, 0.3);
  box-shadow: 0 0 36rpx rgba(16, 185, 129, 0.2);
}

.page-free .ctrl-secondary {
  background: rgba(251, 146, 60, 0.05);
  border-color: rgba(251, 146, 60, 0.1);
}

.page-free .ctrl-secondary-pressed {
  background: rgba(251, 146, 60, 0.12);
  border-color: rgba(251, 146, 60, 0.2);
}

/* ============================================
   🌿 CONFIRMATION OVERLAY — cover-view over canvas
   ============================================ */
.confirm-cover-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999999;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}

.confirm-cover-card {
  width: 560rpx;
  border-radius: 32rpx;
  padding: 52rpx 40rpx 36rpx;
  background: rgba(30, 41, 59, 0.98);
  box-sizing: border-box;
}

.confirm-cover-title {
  display: block;
  text-align: center;
  font-size: 36rpx;
  font-weight: 800;
  color: #6EE7B7;
  margin-bottom: 20rpx;
}

.confirm-cover-body {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  font-size: 28rpx;
  color: rgba(255,255,255,0.72);
  line-height: 1.55;
  margin-bottom: 44rpx;
}

.confirm-cover-body-line {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
}

.confirm-cover-body-line-secondary {
  margin-top: 4rpx;
}

.confirm-cover-actions {
  display: flex;
  align-items: center;
}

.confirm-cover-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.confirm-cover-cancel {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.86);
}

.confirm-cover-ok {
  margin-left: 32rpx;
  /* cover-view 真机不支持 linear-gradient，以 background-color 为回退 */
  background-color: #10B981;
  background-image: linear-gradient(135deg, #10B981, #047857);
  color: #FFFFFF;
}

.confirm-cover-ok.disabled {
  opacity: 0.55;
}

/* ── Large size overrides ── */
.size-large .ring-time-free {
  font-size: 92rpx;
  letter-spacing: 8rpx;
}

.size-large .free-hint {
