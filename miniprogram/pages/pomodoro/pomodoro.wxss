  color: #FFFFFF;
}

/* ── Confirm Theme: break (amber/orange) ── */
.confirm-theme-break .confirm-cover-card {
  background: rgba(30, 23, 15, 0.98);
  border: 1rpx solid rgba(251, 146, 60, 0.25);
  box-shadow:
    0 0 50rpx rgba(249, 115, 22, 0.22),
