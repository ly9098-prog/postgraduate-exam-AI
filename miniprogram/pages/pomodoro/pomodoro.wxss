    0 0 10rpx rgba(249, 115, 22, .20),
    0 0 28rpx rgba(249, 115, 22, .10);
}
.theme-dark.page-break .ring-time {
  color: #F8B96B;
  text-shadow:
    0 0 12rpx rgba(251, 146, 60, .30),
    0 0 32rpx rgba(249, 115, 22, .16);
