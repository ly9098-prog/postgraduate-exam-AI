<view class="page page-{{phase === 'break' ? 'break' : 'focus'}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="page-inner animation-entrance size-{{fontSizeLevel}} {{pageEntered ? 'entered' : ''}}">

    <!-- ===== TOP BAR ===== -->
    <view class="top-bar">
      <view class="top-left" catchtap="onExamTap">
        <text class="exam-label">距考研</text>
        <text class="exam-count">{{examDays}}</text>
        <text class="exam-label">天</text>
        <text wx:if="{{debugMode}}" class="debug-badge">DEV</text>
      </view>
      <view class="top-right">
        <view class="stat-pill">
          <text class="stat-icon">🍅</text>
          <text class="stat-num">{{todaySessions}}</text>
        </view>
        <view class="stat-pill">
          <text class="stat-icon">⏱</text>
          <text class="stat-num">{{todayDurationText}}</text>
        </view>
        <view class="font-size-btn" catchtap="cycleFontSize">
          <text class="font-size-icon {{fontSizeLevel === 'large' ? 'active' : ''}}">Aa</text>
        </view>
      </view>
    </view>

    <!-- ===== MAIN CONTENT ===== -->
    <view class="main-content">

      <!-- ===== IDLE STATE ===== -->
      <block wx:if="{{phase === 'idle'}}">
        <view class="idle-wrap">
          <!-- Subject Grid -->
          <view class="subj-section">
            <text class="section-label">选择科目</text>
            <view class="subj-grid">
              <view
                class="subj-card {{selectedSubject === item.key ? 'active' : ''}}"
                wx:for="{{subjects}}" wx:key="key"
                catchtap="selectSubject"
                data-key="{{item.key}}"
              >
                <text class="subj-emoji">{{item.emoji}}</text>
                <text class="subj-name">{{item.label}}</text>
              </view>
            </view>
          </view>

          <!-- Mode Dots -->
          <view class="mode-section">
            <text class="section-label">时长</text>
            <view class="mode-row">
              <view
                class="mode-dot {{selectedPreset === item.key ? 'active' : ''}}"
                wx:for="{{presets}}" wx:key="key"
                catchtap="selectPreset"
                data-key="{{item.key}}"
              >
                <view class="dot-ring">
                  <view class="dot-fill"></view>
                </view>
                <text class="dot-label">{{item.label}}</text>
              </view>
              <view
                wx:if="{{debugMode}}"
                class="mode-dot {{selectedPreset === 'debug' ? 'active' : ''}}"
                catchtap="selectPreset"
                data-key="debug"
              >
                <view class="dot-ring debug-ring">
                  <view class="dot-fill"></view>
                </view>
                <text class="dot-label">10s测试</text>
              </view>
            </view>
            <text class="mode-info">{{selectedPreset === 'debug' ? '10秒学习 · 5秒休息' : workDuration + ' 分钟学习 · ' + breakDuration + ' 分钟休息'}}</text>
            <!-- Custom sliders -->
            <view class="custom-area {{showCustom ? 'visible' : ''}}" catchtouchstart="onCustomAreaTouch" catchtouchend="onCustomAreaTouch">
              <view class="custom-row">
                <text class="custom-label">学习</text>
                <slider
                  min="5" max="120" value="{{workDuration}}"
                  bindchange="onWorkChange" show-value
                  activeColor="#3B82F6" block-size="16" block-color="#ffffff"
                  backgroundColor="rgba(255,255,255,0.06)"
                />
              </view>
              <view class="custom-row">
                <text class="custom-label">休息</text>
                <slider
                  min="5" max="120" value="{{breakDuration}}"
                  bindchange="onBreakChange" show-value
                  activeColor="#F97316" block-size="16" block-color="#ffffff"
                  backgroundColor="rgba(255,255,255,0.06)"
                />
              </view>
            </view>
          </view>

          <!-- Context hint from practice page -->
          <view class="context-hint" wx:if="{{fromSubject && selectedSubject}}">
            <text>从刷题进入 · {{subjectLabel(selectedSubject)}}</text>
          </view>

<!-- START BUTTON -->
          <button class="btn-start" catchtap="startSession" hover-class="btn-hover">
            <text class="btn-start-text">开始专注</text>
          </button>
        </view>
      </block>

      <!-- ===== CEREMONY STATE ===== -->
      <block wx:if="{{phase === 'ceremony'}}">
        <view class="ceremony-wrap">
          <text class="ceremony-emoji">{{subjectEmoji(selectedSubject)}}</text>
          <text class="ceremony-subject">{{subjectLabel(selectedSubject)}}</text>
          <view class="ceremony-divider"></view>
          <text class="ceremony-duration">{{selectedPreset === 'debug' ? '10 秒' : workDuration + ' 分钟'}}</text>
          <text class="ceremony-preset">{{presetLabel(selectedPreset)}}</text>
          <view class="ceremony-spinner">
            <view class="spinner-ring"></view>
          </view>
          <text class="ceremony-status">准备开始</text>
        </view>
      </block>

      <!-- ===== RUNNING / BREAK STATE ===== -->
      <block wx:if="{{phase === 'running' || phase === 'break'}}">
        <view class="timer-wrap">
          <view class="timer-header">
            <text class="timer-subject">{{subjectEmoji(selectedSubject)}} {{subjectLabel(selectedSubject)}}</text>
            <text class="timer-hint">{{phase === 'break' ? '休息时间' : '专注中'}}</text>
          </view>

          <!-- Progress Ring -->
          <view class="ring-wrapper">
            <view class="ring-glow"></view>
            <canvas class="ring-canvas" type="2d" id="progress-ring"></canvas>
            <view class="ring-center">
              <text class="ring-time {{phase === 'break' ? 'time-warm' : ''}}">{{displayMin}}:{{displaySec}}</text>
              <text class="ring-status" wx:if="{{isPaused}}">已暂停</text>
            </view>
          </view>

          <!-- Controls: running -->
          <view class="controls-row" wx:if="{{phase === 'running'}}">
            <view class="ctrl-btn ctrl-secondary" catchtap="interruptSession">
              <image class="ctrl-icon ctrl-icon--stop" src="/assets/images/terminate.png" mode="aspectFit"></image>
            </view>
            <view class="ctrl-btn ctrl-primary" catchtap="togglePause">
              <image class="ctrl-icon ctrl-icon--pause" src="/assets/images/pulse.png" mode="aspectFit"></image>
            </view>
          </view>
          <!-- Controls: break -->
          <view class="controls-row" wx:if="{{phase === 'break'}}">
            <view class="ctrl-btn ctrl-primary" catchtap="skipBreak">
              <image class="ctrl-icon ctrl-icon--skip" src="/assets/images/skip.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- ===== BOTTOM BAR ===== -->
    <view class="bottom-bar">
      <view class="stats-link" catchtap="goStats">
        <text>学习统计</text>
        <view class="stats-arrow line-icon icon-chevron-right" style="color:#637394;"></view>
      </view>
    </view>
  </view>

  <!-- ===== CELEBRATION OVERLAY (Lottie) ===== -->
  <animated-view
    show="{{showCelebration}}"
    type="{{celebrationType}}"
    theme="dark"
    title="完成一个番茄钟"
    detail="专注 {{workDuration}} 分钟"
    motto="{{celebrationMotto}}"
    duration="{{3500}}"
    bind:done="dismissCelebration"
  />
</view>
