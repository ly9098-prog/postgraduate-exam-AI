<view class="page theme-{{themeMode}} page-{{phase === 'break' ? 'break' : 'focus'}} {{isFreeTimer ? 'page-free' : ''}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="theme-backdrop"></view>
  <view class="page-inner animation-entrance size-{{fontSizeLevel}} {{pageEntered ? 'entered' : ''}}">

    <!-- ===== TOP BAR ===== -->
    <view class="top-bar">
      <view class="top-left" catchtap="onExamTap">
        <text class="exam-label">距考研</text>
        <text class="exam-count">{{examDays}}</text>
        <text class="exam-label">天</text>
        <text wx:if="{{debugMode}}" class="debug-badge">DEV</text>
      </view>
      <view class="top-right">
        <view class="stat-pill">
          <text class="stat-icon">🍅</text>
          <text class="stat-num">{{todaySessions}}</text>
        </view>
        <view class="stat-pill">
          <text class="stat-icon">⏱</text>
          <text class="stat-num">{{todayDurationText}}</text>
        </view>
        <view class="font-size-btn" hover-class="font-size-btn-pressed" hover-start-time="20" hover-stay-time="80" catchtap="cycleFontSize">
          <text class="font-size-icon {{fontSizeLevel === 'large' ? 'active' : ''}}">Aa</text>
        </view>
        <view
          class="theme-toggle theme-toggle-{{themeMode}} {{themeSwitching ? 'theme-toggle-switching' : ''}}"
          hover-class="theme-toggle-pressed"
          hover-start-time="20"
          hover-stay-time="80"
          catchtap="toggleTheme"
          aria-label="{{themeMode === 'light' ? '切换深色模式' : '切换浅色模式'}}"
        >
          <text class="theme-glyph theme-glyph-sun">☼</text>
          <text class="theme-glyph theme-glyph-moon">☾</text>
        </view>
      </view>
    </view>

    <!-- ===== MAIN CONTENT ===== -->
    <view class="main-content">

      <!-- ===== IDLE STATE ===== -->
      <block wx:if="{{phase === 'idle'}}">
        <view class="idle-wrap">
          <!-- Subject Grid -->
          <view class="subj-section">
            <view class="control-section-title"><view class="control-section-line"></view><text class="control-section-text">选择科目</text><view class="control-section-line"></view></view>
            <view wx:if="{{subjectsLoading}}" class="subj-loading">
              <text class="subj-loading-text">科目加载中...</text>
            </view>
            <view wx:elif="{{subjectsError}}" class="subj-error">
              <text class="subj-error-text">{{subjectsError}}</text>
              <text class="subj-retry" catchtap="_loadSubjects">重新加载</text>
            </view>
            <view wx:elif="{{subjects.length === 0}}" class="subj-empty">
              <text class="subj-empty-text">暂无可用科目</text>
            </view>
            <view wx:else class="subj-grid">
              <view
                class="subj-card {{selectedSubjectId === item.id ? 'active' : ''}}"
                wx:for="{{subjects}}" wx:key="id"
                hover-class="subj-card-pressed" hover-start-time="20" hover-stay-time="80"
                catchtap="selectSubject"
                data-id="{{item.id}}"
              >
                <view class="subj-icon-wrap"><text class="subj-emoji">{{item._emoji}}</text></view>
                <text class="subj-name">{{item.name}}</text>
              </view>
            </view>
          </view>

          <!-- Task Type -->
          <view class="task-type-section">
            <view class="control-section-title"><view class="control-section-line"></view><text class="control-section-text">任务类型</text><view class="control-section-line"></view></view>
            <view class="task-type-scroll">
              <view class="task-type-row">
                <view
                  class="task-type-chip {{selectedTaskType === item.value ? 'active' : ''}}"
                  wx:for="{{taskTypes}}" wx:key="value"
                  data-type="{{item.value}}"
                  catchtap="selectTaskType"
                  hover-class="task-type-chip-pressed"
                >{{item.label}}</view>
              </view>
            </view>
          </view>

          <!-- Mode Dots -->
          <view class="mode-section">
            <view class="control-section-title"><view class="control-section-line"></view><text class="control-section-text">时长</text><view class="control-section-line"></view></view>
            <view class="mode-row">
              <view
                class="mode-dot {{selectedPreset === item.key ? 'active' : ''}}"
                wx:for="{{presets}}" wx:key="key"
                hover-class="mode-dot-pressed" hover-start-time="20" hover-stay-time="80"
                catchtap="selectPreset"
                data-key="{{item.key}}"
              >
                <view class="dot-ring {{item.key === 'free' ? 'dot-ring-free' : ''}}">
                  <view class="dot-fill {{item.key === 'free' ? 'dot-fill-free' : ''}}"></view>
                </view>
                <text class="dot-label">{{item.label}}</text>
              </view>
              <view
                wx:if="{{debugMode}}"
                class="mode-dot {{selectedPreset === 'debug' ? 'active' : ''}}"
                catchtap="selectPreset"
                data-key="debug"
              >
                <view class="dot-ring debug-ring">
                  <view class="dot-fill"></view>
                </view>
                <text class="dot-label">10s测试</text>
              </view>
            </view>
            <text class="mode-info">{{selectedPreset === 'debug' ? '10秒学习 · 5秒休息' : selectedPreset === 'free' ? '正向计时 · 最长5小时' : workDuration + ' 分钟学习 · ' + breakDuration + ' 分钟休息'}}</text>
            <!-- Custom sliders -->
            <view class="custom-area {{showCustom ? 'visible' : ''}}" catchtouchstart="onCustomAreaTouch" catchtouchend="onCustomAreaTouch">
              <view class="custom-row">
                <text class="custom-label">学习</text>
                <slider
                  min="5" max="120" value="{{workDuration}}"
                  bindchange="onWorkChange" show-value
                  activeColor="#3B82F6" block-size="16" block-color="{{sliderBlockColor}}"
                  backgroundColor="{{sliderTrackColor}}"
                />
              </view>
              <view class="custom-row">
                <text class="custom-label">休息</text>
                <slider
                  min="5" max="120" value="{{breakDuration}}"
                  bindchange="onBreakChange" show-value
                  activeColor="#F97316" block-size="16" block-color="{{sliderBlockColor}}"
                  backgroundColor="{{sliderTrackColor}}"
                />
              </view>
            </view>
          </view>

          <!-- Context hint from practice page -->
          <view class="context-hint" wx:if="{{fromSubjectId && selectedSubject}}">
            <text>从刷题进入 · {{selectedSubjectLabel}}</text>
          </view>

<!-- START BUTTON -->
          <button class="btn-start" catchtap="startSession" hover-class="btn-hover">
            <text class="btn-start-text">开始专注</text>
          </button>
        </view>
      </block>

      <!-- ===== CEREMONY STATE ===== -->
      <block wx:if="{{phase === 'ceremony'}}">
        <view class="ceremony-wrap">
          <text class="ceremony-emoji">{{selectedSubjectEmoji}}</text>
          <text class="ceremony-subject">{{selectedSubjectLabel}} · {{selectedTaskTypeLabel}}</text>
          <view class="ceremony-divider"></view>
          <text class="ceremony-duration">{{selectedPreset === 'debug' ? '10 秒' : workDuration + ' 分钟'}}</text>
          <text class="ceremony-preset">{{selectedPresetLabel}}</text>
          <view class="ceremony-spinner">
            <view class="spinner-ring"></view>
          </view>
          <text class="ceremony-status">准备开始</text>
        </view>
      </block>

      <!-- ===== RUNNING / BREAK STATE ===== -->
      <block wx:if="{{phase === 'running' || phase === 'break'}}">
        <view class="timer-wrap">
          <view class="timer-header">
            <text class="timer-subject">{{selectedSubjectEmoji}} {{selectedSubjectLabel}} · {{selectedTaskTypeLabel}}</text>
            <block wx:if="{{isFreeTimer}}">
              <view class="free-status-wrap">
                <view class="free-status-dot {{isPaused ? 'dot-paused' : ''}}"></view>
                <text class="timer-hint free-hint {{isPaused ? 'hint-paused' : ''}}">{{isPaused ? '已暂停' : '自由计时中'}}</text>
              </view>
            </block>
            <block wx:else>
              <text class="timer-hint">{{phase === 'break' ? '休息时间' : '专注中'}}</text>
            </block>
          </view>

          <!-- Progress Ring (ring-stage is transform-free zone for Canvas) -->
          <view class="ring-stage">
            <view class="ring-wrapper {{showEndConfirm ? 'ring-wrapper-confirming' : ''}}">
              <view class="ring-glow"></view>
              <canvas
                hidden="{{showEndConfirm || !ringCanvasVisible}}"
                class="ring-canvas {{ringCanvasPaintReady ? 'ring-canvas-ready' : 'ring-canvas-preparing'}}"
                type="2d"
                id="progress-ring"
              ></canvas>
              <view class="ring-center">
                <block wx:if="{{isFreeTimer}}">
                  <text class="ring-time ring-time-free {{isPaused ? 'time-dim' : ''}}">{{freeDisplayTime}}</text>
                </block>
                <block wx:else>
                  <text class="ring-time {{phase === 'break' ? 'time-warm' : ''}}">{{displayMin}}:{{displaySec}}</text>
                </block>
                <text class="ring-status" wx:if="{{isPaused}}">已暂停</text>
              </view>
            </view>
          </view>

          <!-- Controls: running -->
          <view class="controls-row" wx:if="{{phase === 'running'}}">
            <view class="ctrl-btn ctrl-secondary" hover-class="ctrl-secondary-pressed" hover-start-time="20" hover-stay-time="80" catchtap="interruptSession">
              <image class="ctrl-icon ctrl-icon--stop" src="/assets/images/terminate.png" mode="aspectFit"></image>
            </view>
            <view class="ctrl-btn ctrl-primary" hover-class="ctrl-primary-pressed" hover-start-time="20" hover-stay-time="80" catchtap="togglePause">
              <image class="ctrl-icon ctrl-icon--pause" src="{{isPaused ? '/assets/images/continue.png' : '/assets/images/pulse.png'}}" mode="aspectFit"></image>
            </view>
          </view>
          <!-- Controls: break -->
          <view class="controls-row" wx:if="{{phase === 'break'}}">
            <view class="ctrl-btn ctrl-primary" hover-class="ctrl-primary-pressed" hover-start-time="20" hover-stay-time="80" catchtap="skipBreak">
              <image class="ctrl-icon ctrl-icon--skip" src="/assets/images/skip.png" mode="aspectFit"></image>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- ===== BOTTOM BAR ===== -->
    <view class="bottom-bar">
      <view class="stats-link" hover-class="stats-link-pressed" hover-start-time="20" hover-stay-time="80" catchtap="goStats">
        <text>学习统计</text>
        <view class="stats-arrow line-icon icon-chevron-right"></view>
      </view>
    </view>
  </view>

  <!-- ===== CELEBRATION OVERLAY (Lottie) ===== -->
  <animated-view
    show="{{showCelebration}}"
    type="{{celebrationType}}"
    theme="{{celebrationTheme}}"
    title="完成一个番茄钟"
    detail="专注 {{workDuration}} 分钟"
    motto="{{celebrationMotto}}"
    duration="{{3500}}"
    bind:done="dismissCelebration"
  />

  <!-- ===== 结束计时确认弹窗（cover-view 覆盖 canvas） ===== -->
  <cover-view wx:if="{{showEndConfirm}}" class="confirm-cover-overlay theme-{{themeMode}} confirm-theme-{{endConfirmTheme}}" catchtap="cancelEndConfirm">
    <cover-view class="confirm-cover-card" catchtap="noop">
      <cover-view class="confirm-cover-title">{{endConfirmTitle}}</cover-view>
      <cover-view class="confirm-cover-body">
        <cover-view class="confirm-cover-body-line">{{endConfirmLine1 || endConfirmText}}</cover-view>
        <cover-view wx:if="{{endConfirmLine2}}" class="confirm-cover-body-line confirm-cover-body-line-secondary">{{endConfirmLine2}}</cover-view>
        <cover-view wx:if="{{endConfirmLine3}}" class="confirm-cover-body-line confirm-cover-body-line-secondary">{{endConfirmLine3}}</cover-view>
      </cover-view>
      <cover-view class="confirm-cover-actions">
        <cover-view class="confirm-cover-btn confirm-cover-cancel" catchtap="cancelEndConfirm">{{endConfirmCancelText}}</cover-view>
        <cover-view class="confirm-cover-btn confirm-cover-ok {{actionLoading ? 'disabled' : ''}}" catchtap="confirmEndTimer">{{actionLoading ? '处理中...' : endConfirmOkText}}</cover-view>
      </cover-view>
    </cover-view>
  </cover-view>
</view>
