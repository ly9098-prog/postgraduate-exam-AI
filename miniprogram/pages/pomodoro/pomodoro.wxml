<view class="page">
  <!-- 顶部：日期 + 今日统计 -->
  <view class="card top-card">
    <view class="top-row">
      <text class="date-text">{{getDateStr()}}</text>
      <view class="today-stats">
        <text class="stat-badge">🍅 {{todaySessions}}</text>
        <text class="stat-badge">⏱ {{todayDurationText}}</text>
      </view>
    </view>
  </view>

  <!-- 从刷题页面带来的上下文 -->
  <view class="context-tag" wx:if="{{fromSubject && selectedSubject}}">
    <text class="context-text">从刷题页面进入 · 已自动选择「{{subjectLabel(selectedSubject)}}」</text>
  </view>

  <!-- ==================== 空闲态：设置 ==================== -->
  <block wx:if="{{phase === 'idle'}}">
    <!-- 科目选择 -->
    <view class="card section-card">
      <text class="section-title">选择科目</text>
      <view class="subject-grid">
        <view
          class="subject-item {{selectedSubject === item.key ? 'subject-selected' : ''}}"
          wx:for="{{subjects}}"
          wx:key="key"
          bindtap="selectSubject"
          data-key="{{item.key}}"
        >
          <view class="subject-dot" style="background: {{selectedSubject === item.key ? subjectColor(item.key) : '#BCC8D4'}}"></view>
          <text>{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 模式选择 -->
    <view class="card section-card">
      <text class="section-title">学习模式</text>
      <view class="preset-row">
        <view
          class="preset-item {{selectedPreset === item.key ? 'preset-selected' : ''}}"
          wx:for="{{presets}}"
          wx:key="key"
          bindtap="selectPreset"
          data-key="{{item.key}}"
        >
          <text class="preset-icon">{{item.key === 'standard' ? '⏰' : (item.key === 'long' ? '🔥' : '⚙')}}</text>
          <text class="preset-label">{{item.label}}</text>
          <text class="preset-desc" wx:if="{{item.key !== 'custom'}}">{{item.work}}分学习 · {{item.break}}分休息</text>
        </view>
      </view>

      <!-- 自定义时长 -->
      <view class="custom-row" wx:if="{{showCustom}}">
        <view class="custom-item">
          <text class="custom-label">学习时长（分）</text>
          <slider
            min="5" max="120" value="{{workDuration}}"
            bindchange="onWorkChange" show-value
            activeColor="#5B7B9A" block-size="20"
          />
        </view>
        <view class="custom-item">
          <text class="custom-label">休息时长（分）</text>
          <slider
            min="5" max="120" value="{{breakDuration}}"
            bindchange="onBreakChange" show-value
            activeColor="#6B9B6B" block-size="20"
          />
        </view>
      </view>
    </view>

    <!-- 开始按钮 -->
    <view class="start-area">
      <button class="btn-start" bindtap="startSession">开始学习</button>
    </view>
  </block>

  <!-- ==================== 运行态：计时器 ==================== -->
  <block wx:if="{{phase === 'running'}}">
    <view class="timer-card">
      <text class="timer-subject">{{subjectLabel(selectedSubject)}}</text>
      <view class="timer-ring">
        <canvas class="ring-canvas" canvas-id="progress-ring" id="progress-ring"></canvas>
        <view class="timer-display">
          <text class="timer-time">{{displayMin}}:{{displaySec}}</text>
          <text class="timer-hint">{{isPaused ? '已暂停' : '专注学习中'}}</text>
        </view>
      </view>
      <view class="timer-actions">
        <button class="btn-pause" bindtap="togglePause">{{isPaused ? '继续' : '暂停'}}</button>
        <button class="btn-end" bindtap="interruptSession">结束</button>
      </view>
    </view>
  </block>

  <!-- ==================== 休息态 ==================== -->
  <block wx:if="{{phase === 'break'}}">
    <view class="timer-card break-card">
      <text class="timer-subject">☕ 休息时间</text>
      <view class="timer-ring">
        <canvas class="ring-canvas" canvas-id="progress-ring-break" id="progress-ring-break"></canvas>
        <view class="timer-display">
          <text class="timer-time break-time">{{displayMin}}:{{displaySec}}</text>
          <text class="timer-hint">放松一下</text>
        </view>
      </view>
      <view class="timer-actions">
        <button class="btn-skip" bindtap="skipBreak">跳过休息</button>
      </view>
    </view>
  </block>

  <!-- 查看统计 -->
  <view class="stats-entry" bindtap="goStats">
    <text class="stats-entry-text">查看学习统计 ›</text>
  </view>
</view>
