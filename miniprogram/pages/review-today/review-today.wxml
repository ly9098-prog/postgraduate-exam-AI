<animated-view
  show="{{showCelebration}}"
  type="{{celebrationType}}"
  title="{{celebrationTitle}}"
  detail="{{celebrationDetail}}"
  motto="{{celebrationMotto}}"
  reward-text="{{celebrationRewardText}}"
  progress-text="{{celebrationProgressText}}"
  growth-level="{{growthLevel}}"
  growth-level-pct="{{growthLevelPct}}"
  growth-desc="{{growthDesc}}"
  duration="{{celebrationDuration}}"
  gif-src="/assets/animation/celebration.gif"
  png-src="/assets/animation/celebration-static.png"
  bind:done="dismissCelebration"
/>

<!-- ==================== 入口页 ==================== -->
<view class="page review-entry" wx:if="{{phase === 'entry'}}">
  <view wx:if="{{entryLoading}}" class="loading-wrap">
    <loading-lottie text="正在读取今日复习任务..." size="large" />
  </view>

  <view wx:else class="entry-wrap">
    <view class="review-hero animation-fade-in motion-card-enter">
      <view class="hero-orbit hero-orbit-one"></view>
      <view class="hero-orbit hero-orbit-two"></view>
      <view class="hero-copy">
        <text class="eyebrow">今日复习 · {{_dateStr}}</text>
        <text class="hero-title">把遗忘曲线拉回掌控</text>
        <text class="hero-desc">按组复习到期错题，完成后系统会更新你的复习计划</text>
      </view>
      <view class="ring-section" wx:if="{{stats}}">
        <view class="ring-container">
          <view class="ring-bg"></view>
          <view class="ring-fg" style="{{_ringStyle}}"></view>
          <view class="ring-center">
            <text class="ring-num">{{stats.total_scheduled - stats.remaining_today}}</text>
            <text class="ring-label">已完成</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mission-card animation-fade-in" wx:if="{{stats}}">
      <view class="mission-head">
        <view>
          <text class="mission-kicker">今日待复习</text>
          <text class="mission-title">{{stats.remaining_today}} 题</text>
        </view>
        <view class="mission-badge">{{entryDone ? '全部完成' : '记忆加固'}}</view>
      </view>
      <text class="motivation-text">{{_motivationMsg}}</text>
      <view class="glass-card">
        <view class="glass-item">
          <text class="glass-num warning">{{stats.remaining_today}}</text>
          <text class="glass-label">待攻克</text>
        </view>
        <view class="glass-divider"></view>
        <view class="glass-item">
          <text class="glass-num">{{stats.total_scheduled}}</text>
          <text class="glass-label">总排期</text>
        </view>
        <view class="glass-divider"></view>
        <view class="glass-item">
          <text class="glass-num success">{{_accuracyLast7dText}}</text>
          <text class="glass-label">近7天正确率</text>
        </view>
      </view>
    </view>

    <view class="group-size-section animation-fade-in" wx:if="{{stats && stats.remaining_today > 0}}">
      <view class="section-head">
        <view>
          <text class="section-title">选择复习节奏</text>
          <text class="section-subtitle">短组适合碎片时间，大组适合沉浸攻克</text>
        </view>
        <text class="section-chip">{{groupSize}}题/组</text>
      </view>
      <view class="size-options">
        <view
          wx:for="{{groupSizeOptions}}" wx:key="*this"
          class="size-chip {{groupSize === item ? 'active' : ''}}"
          hover-class="tap-scale"
          catchtap="selectGroupSize"
          data-size="{{item}}"
        >{{item}}题</view>
      </view>
      <text class="size-hint" wx:if="{{stats.remaining_today > groupSize}}">
        预计分为 {{_reviewGroupCountText}} 组完成
      </text>
    </view>

    <button class="gradient-btn" wx:if="{{stats && stats.remaining_today > 0}}" bindtap="startReview">
      开始今日复习
    </button>
    <view wx:elif="{{stats && stats.remaining_today === 0 && stats.total_scheduled > 0}}" class="done-wrap animation-fade-in">
      <view class="done-check"><text class="line-icon icon-check done-check-icon"></text></view>
      <text class="done-title">今日复习已完成</text>
      <text class="done-desc">记忆曲线已更新，明天继续保持</text>
    </view>
    <view wx:elif="{{stats && stats.total_scheduled === 0}}" class="done-wrap animation-fade-in">
      <view class="done-check mute">记</view>
      <text class="done-title">暂无复习安排</text>
      <text class="done-desc">刷题后系统会自动安排复习</text>
    </view>
  </view>
</view>

<!-- ==================== 练习页 ==================== -->
<view class="page review-practice" wx:if="{{phase === 'practice'}}">
  <view wx:if="{{practiceLoading}}" class="loading-wrap">
    <loading-lottie text="正在准备复习题目..." size="large" />
  </view>

  <quiz-runner
    wx:else
    mode="review"
    title="今日复习"
    subtitle="{{runnerSubtitle}}"
    subjectName="{{runnerSubjectName}}"
    questions="{{groupQuestions}}"
    currentQuestion="{{currentQuestion}}"
    currentIndex="{{currentIndex}}"
    totalCount="{{groupQuestions.length}}"
    answeredCount="{{_answeredCount}}"
    progressPercent="{{runnerProgressPercent}}"
    readonly="{{false}}"
    submitting="{{submittingGroup}}"
    showFeedback="{{false}}"
    submitText="提交本组复盘"
    showMasterButton="{{true}}"
    bind:selectoption="selectOption"
    bind:selectblankoption="selectBlankOption"
    bind:prev="goPrev"
    bind:next="goNext"
    bind:jump="goQuestion"
    bind:submit="submitGroup"
    bind:master="tapMaster"
  />
</view>

<!-- ==================== 组结果页（数据优先） ==================== -->
<view class="result-page" wx:if="{{phase === 'group-result'}}">
  <view class="grp anim-grp-1">
    <!-- 1. 紧凑摘要卡 -->
    <view class="grp-summary-card">
      <view class="grp-summary-top">
        <text class="grp-group-tag">第 {{currentGroupIdx + 1}} / {{groups.length}} 组</text>
        <view class="grp-accuracy">
          <text class="grp-accuracy-value">{{groupQuestions.length > 0 ? Math.round(groupCorrect / groupQuestions.length * 100) : 0}}%</text>
          <text class="grp-accuracy-label">正确率</text>
        </view>
      </view>
      <view class="grp-summary-grid">
        <view class="grp-summary-item">
          <text class="grp-summary-val">{{groupQuestions.length}}</text>
          <text class="grp-summary-lbl">本组题数</text>
        </view>
        <view class="grp-summary-item">
          <text class="grp-summary-val success">{{groupCorrect}}</text>
          <text class="grp-summary-lbl">正确</text>
        </view>
        <view class="grp-summary-item">
          <text class="grp-summary-val danger">{{groupWrong}}</text>
          <text class="grp-summary-lbl">需巩固</text>
        </view>
        <view class="grp-summary-item">
          <text class="grp-summary-val muted">{{_groupSkipped}}</text>
          <text class="grp-summary-lbl">跳过</text>
        </view>
      </view>
    </view>

    <!-- 2. 复习调度反馈 -->
    <view class="grp-schedule-card" wx:if="{{groupResults.length > 0}}">
      <text class="grp-schedule-title">复习调度</text>
      <text class="grp-schedule-desc">已更新记忆曲线 · 本组错题将进入后续复习安排</text>
    </view>

    <!-- 3. 答题详情 -->
    <view class="grp-detail-section">
      <text class="grp-detail-title">答题详情</text>
      <view
        wx:for="{{groupResults}}" wx:key="schedule_id"
        class="grp-detail-item {{item.wasSkipped ? 'grp-skipped' : (item.isCorrect ? 'grp-correct' : 'grp-wrong')}}"
      >
        <view class="grp-detail-left">
          <text class="grp-detail-idx">{{index + 1}}</text>
          <view class="grp-detail-status">
            <text wx:if="{{item.isCorrect && !item.wasSkipped}}" class="grp-status-pill correct">正确</text>
            <text wx:elif="{{!item.wasSkipped}}" class="grp-status-pill wrong">错误</text>
            <text wx:else class="grp-status-pill skipped">跳过</text>
          </view>
        </view>
        <view class="grp-detail-body">
          <view class="grp-detail-stem">
            <block wx:if="{{item._renderModel.mode === 'SEGMENTS'}}">
              <math-question segments="{{item._renderModel.segments}}" />
            </block>
            <rich-text wx:elif="{{item._renderModel.mode === 'RICH_TEXT'}}" nodes="{{item._renderModel.richTextNodes}}"></rich-text>
            <scroll-view wx:elif="{{item._renderModel.mode === 'CODE'}}" scroll-x class="code-wrapper"><text decode="false" space="preserve" class="code-text">{{item._renderModel.rawText}}</text></scroll-view>
            <mp-html wx:elif="{{item._renderModel.mode === 'LATEX'}}" content="{{item._renderModel.html}}" lazy-load></mp-html>
            <block wx:elif="{{item._renderModel.mode === 'MIXED'}}">
              <block wx:for="{{item._renderModel.blocks}}" wx:key="index">
                <rich-text wx:if="{{item.type === 'RICH_TEXT'}}" class="mixed-text-block" nodes="{{item.richTextNodes}}" />
                <mp-html wx:elif="{{item.type === 'LATEX'}}" class="mixed-latex-block" content="{{item.html}}" lazy-load />
                <scroll-view wx:elif="{{item.type === 'CODE'}}" scroll-x class="code-wrapper mixed-code-block"><text decode="false" space="preserve" class="code-text">{{item.rawText}}</text></scroll-view>
              </block>
            </block>
          </view>
          <text class="grp-detail-answer" wx:if="{{!item.wasSkipped && !item.isCorrect}}">
            你的：{{item.userAnswer || '未作答'}}　正确：{{item.correctAnswer}}
          </text>
        </view>
      </view>
    </view>

    <button class="gradient-btn" bindtap="nextGroup" disabled="{{resultTransitioning}}" loading="{{resultTransitioning}}">
      {{currentGroupIdx + 1 >= groups.length ? '查看总体结果' : '进入下一组'}}
    </button>

    <view class="grp-bottom-safe"></view>
  </view>
</view>

<!-- ==================== 最终结果页（蓝白数据化） ==================== -->
<view class="fr-page" wx:if="{{phase === 'final-result' && reviewResultVm}}">
  <view class="fr-wrap anim-fr">
    <!-- 1. 总览摘要卡 -->
    <view class="fr-card fr-summary {{reviewResultVm.resultLevelClass}}">
      <view class="fr-summary-row">
        <view class="fr-accuracy-block">
          <text class="fr-accuracy-val">{{reviewResultVm.accuracy}}<text class="fr-accuracy-unit">%</text></text>
          <text class="fr-accuracy-lbl">已答正确率</text>
        </view>
        <view class="fr-status-block">
          <text class="fr-status-tag {{reviewResultVm.resultLevelClass}}">{{reviewResultVm.statusText}}</text>
          <text class="fr-status-desc">{{reviewResultVm.statusDesc}}</text>
        </view>
      </view>

      <view class="fr-divider"></view>

      <view class="fr-grid-2x3">
        <view class="fr-cell">
          <text class="fr-cell-val">{{reviewResultVm.submittedTotal || reviewResultVm.total}}</text>
          <text class="fr-cell-lbl">已提交</text>
        </view>
        <view class="fr-cell">
          <text class="fr-cell-val success">{{reviewResultVm.correct}}</text>
          <text class="fr-cell-lbl">答对</text>
        </view>
        <view class="fr-cell">
          <text class="fr-cell-val danger">{{reviewResultVm.wrong}}</text>
          <text class="fr-cell-lbl">错题</text>
        </view>
        <view class="fr-cell">
          <text class="fr-cell-val">{{reviewResultVm.skipped}}</text>
          <text class="fr-cell-lbl">跳过</text>
        </view>
        <view class="fr-cell">
          <text class="fr-cell-val">{{reviewResultVm.masteredCount}}</text>
          <text class="fr-cell-lbl">已掌握</text>
        </view>
        <view class="fr-cell">
          <text class="fr-cell-val">{{reviewResultVm.completedGroupCount}}/{{reviewResultVm.groupCount}}</text>
          <text class="fr-cell-lbl">完成组</text>
        </view>
      </view>
    </view>

    <!-- 2. 完成度 + 正确率条 -->
    <view class="fr-card fr-progress-card">
      <view class="fr-progress-row">
        <text class="fr-progress-title">完成度</text>
        <text class="fr-progress-pct">{{reviewResultVm.completionRate}}%</text>
      </view>
      <view class="fr-bar-track">
        <view class="fr-bar-fill" style="width:{{reviewResultVm.completionRate}}%"></view>
      </view>
      <view class="fr-progress-row" wx:if="{{reviewResultVm.hasSkipped}}">
        <text class="fr-progress-sub">仍有 <text class="fr-progress-em">{{reviewResultVm.skipped}}</text> 题待处理，可返回继续完成</text>
      </view>
      <view class="fr-progress-row" wx:elif="{{reviewResultVm.isPerfect}}">
        <text class="fr-progress-sub success">今日复习已完成，当前无待处理题目</text>
      </view>
      <view class="fr-progress-row" wx:else>
        <text class="fr-progress-sub">今日错题已纳入复习计划</text>
      </view>
    </view>

    <!-- 3. 薄弱点卡（仅错题 > 0 时展示） -->
    <view class="fr-card fr-weak-card" wx:if="{{reviewResultVm.hasWrong}}">
      <view class="fr-weak-head">
        <text class="fr-weak-title">薄弱点</text>
        <text class="fr-weak-count">{{reviewResultVm.wrong}} 题错</text>
      </view>
      <text class="fr-weak-desc">错题占比 {{reviewResultVm.wrongRate}}%，建议立即复盘巩固</text>
      <!-- Subject stats -->
      <view wx:if="{{reviewResultVm.subjectStats && reviewResultVm.subjectStats.length > 0}}" class="fr-weak-subjects">
        <text class="fr-weak-subject-item" wx:for="{{reviewResultVm.subjectStats}}" wx:for-item="stat" wx:key="subject">
          {{stat.stats.reviewed > 0 && stat.stats.wrong / stat.stats.reviewed * 100 > 50 ? '⚠ ' : ''}}{{stat.subject}} · 错{{stat.stats.wrong}}/{{stat.stats.reviewed}}
        </text>
      </view>
    </view>

    <!-- 4. 下一步建议 -->
    <view class="fr-card fr-advice {{reviewResultVm.nextStepType}}">
      <view class="fr-advice-head">
        <text class="fr-advice-title">{{reviewResultVm.nextStepTitle}}</text>
        <text class="fr-advice-tag {{reviewResultVm.nextStepType}}">{{reviewResultVm.nextStepTag}}</text>
      </view>
      <text class="fr-advice-desc">{{reviewResultVm.nextStepDesc}}</text>
    </view>

    <view class="fr-bottom-safe"></view>
  </view>

  <!-- 底部固定按钮 -->
  <view class="fr-bottom-actions">
    <button class="fr-action-primary" wx:if="{{reviewResultVm.total === 0}}" bindtap="startReview">开始复习</button>
    <button class="fr-action-primary" wx:elif="{{reviewResultVm.hasWrong}}" bindtap="goWrongBook">复盘错题</button>
    <button class="fr-action-primary" wx:else bindtap="goHome">完成</button>
    <button class="fr-action-secondary" wx:if="{{reviewResultVm.total === 0}}" bindtap="goHome">返回首页</button>
    <button class="fr-action-secondary" wx:else bindtap="goPractice">继续练习</button>
  </view>
</view>

<!-- ==================== 已掌握确认弹窗 ==================== -->
<view class="master-overlay" wx:if="{{masterConfirmId}}" catchtap="cancelMaster">
  <view class="master-dialog" catchtap="noop">
    <text class="master-dialog-title">标记为已掌握</text>
    <text class="master-dialog-desc">该题将从复习池中移除，不再出现在今日复习中</text>
    <view class="master-dialog-actions">
      <button class="master-btn-cancel" bindtap="cancelMaster">取消</button>
      <button class="master-btn-confirm" bindtap="confirmMaster">确认掌握</button>
    </view>
  </view>
</view>
