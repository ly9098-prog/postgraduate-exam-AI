<animated-view
  show="{{showCelebration}}"
  type="{{celebrationType}}"
  title="{{celebrationTitle}}"
  detail="{{celebrationDetail}}"
  motto="{{celebrationMotto}}"
  reward-text="{{celebrationRewardText}}"
  progress-text="{{celebrationProgressText}}"
  growth-level="{{growthLevel}}"
  growth-level-pct="{{growthLevelPct}}"
  growth-desc="{{growthDesc}}"
  duration="{{celebrationDuration}}"
  gif-src="/assets/animation/celebration.gif"
  png-src="/assets/animation/celebration-static.png"
  bind:done="dismissCelebration"
/>

<!-- ==================== 入口页 ==================== -->
<view class="page review-entry" wx:if="{{phase === 'entry'}}">
  <view wx:if="{{entryLoading}}" class="loading-wrap">
    <loading-lottie text="正在读取今日复习任务..." size="large" />
  </view>

  <view wx:else class="entry-wrap">
    <view class="review-hero animation-fade-in motion-card-enter">
      <view class="hero-orbit hero-orbit-one"></view>
      <view class="hero-orbit hero-orbit-two"></view>
      <view class="hero-copy">
        <text class="eyebrow">今日复习 · {{_dateStr}}</text>
        <text class="hero-title">把遗忘曲线拉回掌控</text>
        <text class="hero-desc">按组复习到期错题，完成后系统会更新你的复习计划</text>
      </view>
      <view class="ring-section" wx:if="{{stats}}">
        <view class="ring-container">
          <view class="ring-bg"></view>
          <view class="ring-fg" style="{{_ringStyle}}"></view>
          <view class="ring-center">
            <text class="ring-num">{{stats.total_scheduled - stats.remaining_today}}</text>
            <text class="ring-label">已完成</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mission-card animation-fade-in" wx:if="{{stats}}">
      <view class="mission-head">
        <view>
          <text class="mission-kicker">今日待复习</text>
          <text class="mission-title">{{stats.remaining_today}} 题</text>
        </view>
        <view class="mission-badge">{{entryDone ? '全部完成' : '记忆加固'}}</view>
      </view>
      <text class="motivation-text">{{_motivationMsg}}</text>
      <view class="glass-card">
        <view class="glass-item">
          <text class="glass-num warning">{{stats.remaining_today}}</text>
          <text class="glass-label">待攻克</text>
        </view>
        <view class="glass-divider"></view>
        <view class="glass-item">
          <text class="glass-num">{{stats.total_scheduled}}</text>
          <text class="glass-label">总排期</text>
        </view>
        <view class="glass-divider"></view>
        <view class="glass-item">
          <text class="glass-num success">{{_accuracyLast7dText}}</text>
          <text class="glass-label">近7天正确率</text>
        </view>
      </view>
    </view>

    <view class="group-size-section animation-fade-in" wx:if="{{stats && stats.remaining_today > 0}}">
      <view class="section-head">
        <view>
          <text class="section-title">选择复习节奏</text>
          <text class="section-subtitle">短组适合碎片时间，大组适合沉浸攻克</text>
        </view>
        <text class="section-chip">{{groupSize}}题/组</text>
      </view>
      <view class="size-options">
        <view
          wx:for="{{groupSizeOptions}}" wx:key="*this"
          class="size-chip {{groupSize === item ? 'active' : ''}}"
          hover-class="tap-scale"
          catchtap="selectGroupSize"
          data-size="{{item}}"
        >{{item}}题</view>
      </view>
      <text class="size-hint" wx:if="{{stats.remaining_today > groupSize}}">
        预计分为 {{_reviewGroupCountText}} 组完成
      </text>
    </view>

    <button class="gradient-btn" wx:if="{{stats && stats.remaining_today > 0}}" bindtap="startReview">
      开始今日复习
    </button>
    <view wx:elif="{{stats && stats.remaining_today === 0 && stats.total_scheduled > 0}}" class="done-wrap animation-fade-in">
      <view class="done-check"><text class="line-icon icon-check done-check-icon"></text></view>
      <text class="done-title">今日复习已完成</text>
      <text class="done-desc">记忆曲线已更新，明天继续保持</text>
    </view>
    <view wx:elif="{{stats && stats.total_scheduled === 0}}" class="done-wrap animation-fade-in">
      <view class="done-check mute">记</view>
      <text class="done-title">暂无复习安排</text>
      <text class="done-desc">刷题后系统会自动安排复习</text>
    </view>
  </view>
</view>

<!-- ==================== 练习页 ==================== -->
<view class="page review-practice" wx:if="{{phase === 'practice'}}">
  <view wx:if="{{practiceLoading}}" class="loading-wrap">
    <loading-lottie text="正在准备复习题目..." size="large" />
  </view>

  <quiz-runner
    wx:else
    mode="review"
    title="今日复习"
    subtitle="{{runnerSubtitle}}"
    subjectName="{{runnerSubjectName}}"
    questions="{{groupQuestions}}"
    currentQuestion="{{currentQuestion}}"
    currentIndex="{{currentIndex}}"
    totalCount="{{groupQuestions.length}}"
    answeredCount="{{_answeredCount}}"
    progressPercent="{{runnerProgressPercent}}"
    readonly="{{false}}"
    submitting="{{submittingGroup}}"
    showFeedback="{{false}}"
    submitText="提交本组复盘"
    showMasterButton="{{true}}"
    bind:selectoption="selectOption"
    bind:selectblankoption="selectBlankOption"
    bind:prev="goPrev"
    bind:next="goNext"
    bind:jump="goQuestion"
    bind:submit="submitGroup"
    bind:master="tapMaster"
  />
</view>

<!-- ==================== 组结果页 ==================== -->
<view class="page result-page" wx:if="{{phase === 'group-result'}}">
  <view class="result-wrap animation-fade-in">
    <view class="result-medal">
      <text class="result-medal-main">{{groupCorrect >= groupWrong ? '优' : '练'}}</text>
      <text class="result-medal-sub">本组完成</text>
    </view>
    <text class="result-title">第 {{currentGroupIdx + 1}} 组复盘完成</text>
    <text class="result-desc">继续下一组，把短期记忆变成长期掌握</text>

    <view class="group-reward-strip">
      <view class="group-reward-main">
        <view class="group-reward-icon">
          <text wx:if="{{groupCorrect >= groupWrong}}" class="line-icon icon-check" style="width:40rpx;height:40rpx;color:#FFFFFF;"></text>
          <text wx:else class="line-icon icon-trend" style="width:40rpx;height:40rpx;color:#FFFFFF;"></text>
        </view>
        <view class="group-reward-copy">
          <text class="group-reward-title">{{groupCorrect >= groupWrong ? '本组记忆稳定' : '本组已完成诊断'}}</text>
          <text class="group-reward-desc">{{groupCorrect >= groupWrong ? '获得专注星光 +1，继续保持节奏' : '获得复盘能量 +1，错题会进入巩固计划'}}</text>
        </view>
      </view>
      <view class="group-progress-track">
        <view class="group-progress-fill" style="{{_groupProgressStyle}}"></view>
      </view>
      <text class="group-progress-text">今日组进度 {{currentGroupIdx + 1}} / {{groups.length}}</text>
    </view>

    <view class="result-stats">
      <view class="result-stat-item">
        <text class="result-stat-val">{{groupQuestions.length}}</text>
        <text class="result-stat-lbl">本组题数</text>
      </view>
      <view class="result-stat-item">
        <text class="result-stat-val success">{{groupCorrect}}</text>
        <text class="result-stat-lbl">正确</text>
      </view>
      <view class="result-stat-item">
        <text class="result-stat-val danger">{{groupWrong}}</text>
        <text class="result-stat-lbl">需巩固</text>
      </view>
    </view>

    <view class="group-answers">
      <view
        wx:for="{{groupResults}}" wx:key="schedule_id"
        class="ga-item {{item.wasSkipped ? 'ga-skipped' : (item.isCorrect ? 'ga-correct' : 'ga-wrong')}}"
      >
        <view class="ga-status">
          <text wx:if="{{item.isCorrect}}" class="line-icon icon-check" style="width:22rpx;height:22rpx;color:#FFFFFF;"></text>
          <text wx:else class="line-icon icon-exclamation" style="width:22rpx;height:22rpx;color:#FFFFFF;"></text>
        </view>
        <view class="ga-body">
          <view class="ga-stem">
            <block wx:if="{{item._renderModel.mode === 'SEGMENTS'}}">
              <math-question segments="{{item._renderModel.segments}}" />
            </block>
            <rich-text wx:elif="{{item._renderModel.mode === 'RICH_TEXT'}}" nodes="{{item._renderModel.richTextNodes}}"></rich-text>
            <scroll-view wx:elif="{{item._renderModel.mode === 'CODE'}}" scroll-x class="code-wrapper"><text decode="false" space="preserve" class="code-text">{{item._renderModel.rawText}}</text></scroll-view>
            <mp-html wx:elif="{{item._renderModel.mode === 'LATEX'}}" content="{{item._renderModel.html}}" lazy-load></mp-html>
            <block wx:elif="{{item._renderModel.mode === 'MIXED'}}">
              <block wx:for="{{item._renderModel.blocks}}" wx:key="index">
                <rich-text wx:if="{{item.type === 'RICH_TEXT'}}" class="mixed-text-block" nodes="{{item.richTextNodes}}" />
                <mp-html wx:elif="{{item.type === 'LATEX'}}" class="mixed-latex-block" content="{{item.html}}" lazy-load />
                <scroll-view wx:elif="{{item.type === 'CODE'}}" scroll-x class="code-wrapper mixed-code-block"><text decode="false" space="preserve" class="code-text">{{item.rawText}}</text></scroll-view>
              </block>
            </block>
          </view>
          <text class="ga-answer" wx:if="{{!item.isCorrect}}">
            你的：{{item.userAnswer || '未作答'}}　正确：{{item.correctAnswer}}
          </text>
        </view>
      </view>
    </view>

    <button class="gradient-btn result-btn" bindtap="nextGroup" disabled="{{resultTransitioning}}" loading="{{resultTransitioning}}">
      {{currentGroupIdx + 1 >= groups.length ? '查看总体结果' : '进入下一组'}}
    </button>
  </view>
</view>

<!-- ==================== 最终结果页（紧凑版） ==================== -->
<view class="review-result-page" wx:if="{{phase === 'final-result' && reviewResultVm}}">
  <!-- 顶部简短标题 -->
  <view class="result-header anim-s1">
    <text class="result-title">{{reviewResultVm.resultTitle}}</text>
    <text class="result-subtitle">{{reviewResultVm.resultDesc}}</text>
  </view>

  <!-- 集中式结果摘要卡 -->
  <view class="result-summary-card {{reviewResultVm.resultLevelClass}} anim-s2">
    <view class="card-accent {{reviewResultVm.resultLevelClass}}"></view>
    <view class="summary-top">
      <view class="accuracy-block">
        <text class="accuracy-value">{{reviewResultVm.accuracy}}<text class="accuracy-unit">%</text></text>
        <text class="accuracy-label">正确率</text>
      </view>
      <view class="summary-status">
        <text class="status-text">{{reviewResultVm.statusText}}</text>
        <text class="status-desc">{{reviewResultVm.statusDesc}}</text>
      </view>
    </view>

    <view class="summary-divider"></view>

    <view class="summary-grid">
      <view class="summary-item">
        <text class="summary-value">{{reviewResultVm.total}}</text>
        <text class="summary-label">复习题数</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{reviewResultVm.correct}}</text>
        <text class="summary-label">答对</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{reviewResultVm.wrong}}</text>
        <text class="summary-label">错题</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{reviewResultVm.completedGroupCount}}/{{reviewResultVm.groupCount}}</text>
        <text class="summary-label">完成组</text>
      </view>
    </view>

    <view class="summary-extra" wx:if="{{reviewResultVm.hasSkipped || reviewResultVm.masteredCount > 0}}">
      <text wx:if="{{reviewResultVm.hasSkipped}}">未完成 {{reviewResultVm.skipped}} 题</text>
      <text wx:if="{{reviewResultVm.hasSkipped && reviewResultVm.masteredCount > 0}}"> · </text>
      <text wx:if="{{reviewResultVm.masteredCount > 0}}">已掌握 {{reviewResultVm.masteredCount}} 题</text>
    </view>
  </view>

  <!-- 建议与入口 -->
  <view class="result-advice-card anim-s3">
    <view class="advice-marker {{reviewResultVm.nextStepType}}"></view>
    <view class="advice-body">
      <view class="advice-head">
        <text class="advice-title">{{reviewResultVm.nextStepTitle}}</text>
        <text class="advice-tag {{reviewResultVm.nextStepType}}">{{reviewResultVm.nextStepTag}}</text>
      </view>
      <text class="advice-desc">{{reviewResultVm.nextStepDesc}}</text>
    </view>
  </view>

  <view class="wrong-inline-tip anim-s3" wx:if="{{reviewResultVm.hasWrong}}" bindtap="goWrongBook">
    <view class="wrong-marker"></view>
    <view class="wrong-body">
      <text class="wrong-tip-text">今日新增 <text class="wrong-count">{{reviewResultVm.wrong}}</text> 道错题，建议立即复盘</text>
      <text class="wrong-tip-action">去复盘</text>
    </view>
  </view>

  <view class="bottom-safe-space"></view>

  <!-- 底部固定按钮 -->
  <view class="review-bottom-actions anim-s4">
    <button class="action-primary" wx:if="{{reviewResultVm.total === 0}}" bindtap="startReview">开始复习</button>
    <button class="action-primary" wx:elif="{{reviewResultVm.hasWrong}}" bindtap="goWrongBook">复盘错题</button>
    <button class="action-primary" wx:else bindtap="goHome">完成</button>
    <button class="action-secondary" wx:if="{{reviewResultVm.total === 0}}" bindtap="goHome">返回首页</button>
    <button class="action-secondary" wx:else bindtap="goPractice">继续练习</button>
  </view>
</view>

<!-- ==================== 已掌握确认弹窗 ==================== -->
<view class="master-overlay" wx:if="{{masterConfirmId}}" catchtap="cancelMaster">
  <view class="master-dialog" catchtap="noop">
    <text class="master-dialog-title">标记为已掌握</text>
    <text class="master-dialog-desc">该题将从复习池中移除，不再出现在今日复习中</text>
    <view class="master-dialog-actions">
      <button class="master-btn-cancel" bindtap="cancelMaster">取消</button>
      <button class="master-btn-confirm" bindtap="confirmMaster">确认掌握</button>
    </view>
  </view>
</view>
