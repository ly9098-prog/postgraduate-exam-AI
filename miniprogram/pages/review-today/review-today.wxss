@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: #F7F5F0;
  padding-bottom: 48rpx;
}

/* ==================== 通用 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* ==================== 入口页 ==================== */
.entry-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
}

/* 渐变头部 */
.header-gradient {
  width: 100%;
  background: linear-gradient(180deg, #5B7B9A 0%, #7BA0BE 100%);
  padding: 60rpx 24rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 48rpx 48rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.header-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

/* 环形进度 */
.ring-section {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.ring-container {
  position: relative;
  width: 224rpx;
  height: 224rpx;
}

.ring-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
}

.ring-fg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.ring-center {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.08);
}

.ring-num {
  font-size: 56rpx;
  font-weight: 800;
  color: #2D3E50;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.ring-label {
  font-size: 24rpx;
  color: #9AABBA;
  line-height: 1.35;
  margin-top: 6rpx;
}

/* 激励文案 */
.motivation-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  line-height: 1.5;
  text-align: center;
}

/* 玻璃统计卡片 */
.glass-card {
  margin: -40rpx 24rpx 0;
  width: calc(100% - 48rpx);
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 40rpx rgba(43, 60, 80, 0.08);
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.glass-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.glass-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #5B7B9A;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.glass-num.warning { color: #C49A6B; }
.glass-num.success { color: #6B9B6B; }

.glass-label {
  font-size: 22rpx;
  color: #6B7B8D;
  line-height: 1.35;
}

.glass-divider {
  width: 1rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.06);
  flex-shrink: 0;
}

/* 渐变按钮 */
.gradient-btn {
  margin: 40rpx 24rpx 0;
  width: calc(100% - 48rpx);
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5B7B9A 0%, #6B8EAA 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(91, 123, 154, 0.35);
  letter-spacing: 2rpx;
}

.gradient-btn::after { border: none; }
.gradient-btn:active { opacity: 0.88; transform: scale(0.97); }

/* 完成状态 */
.done-wrap {
  margin-top: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.done-check {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #E8F5E9;
  color: #6B9B6B;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
  margin-bottom: 16rpx;
}

.done-check.mute {
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 40rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2D3E50;
  line-height: 1.35;
  margin-bottom: 6rpx;
}

.done-desc {
  font-size: 26rpx;
  color: #9AABBA;
  line-height: 1.5;
}

/* ==================== 练习页 ==================== */
.review-practice {
  background: linear-gradient(180deg, rgba(91, 123, 154, 0.04) 0%, #F7F5F0 30%);
  overflow-x: hidden;
}

.practice-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* 进度条 */
.review-progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx 0;
}

.progress-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #5B7B9A;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.progress-track {
  flex: 1;
  height: 6rpx;
  border-radius: 999rpx;
  background: #E8E5E0;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5B7B9A, #7BA0BE);
  transition: width 0.3s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 滑动动画 */
.question-card {
  flex: 1;
  padding: 0 24rpx;
  margin-top: 18rpx;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.question-card.slide-out-left {
  transform: translateX(-20%);
  opacity: 0;
}

.question-card.slide-out-right {
  transform: translateX(20%);
  opacity: 0;
}

.question-card.slide-in {
  animation: slideIn 0.12s ease;
}

@keyframes slideIn {
  from { transform: translateX(10%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* 学科标签 */
.q-subject {
  margin-bottom: 16rpx;
}

.subject-badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #EDF1F5;
  color: #5B7B9A;
  line-height: 1.4;
}

/* 题干 */
.q-stem {
  margin-bottom: 28rpx;
}

.q-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.72;
  color: #2D3E50;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 选项 */
.q-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 26rpx 24rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #EDEBE6;
  transition: border-color 0.15s, background 0.15s;
}

.option-item:active {
  background: #F7F6F2;
}

.option-item.opt-selected {
  border-color: #5B7B9A;
  background: #EDF1F5;
}

.option-item.opt-correct {
  border-color: #6B9B6B;
  background: #E8F5E9;
}

.option-item.opt-wrong {
  border-color: #C47A7A;
  background: #F5EFEF;
}

.option-item.opt-reveal {
  border-color: #6B9B6B;
  background: #EFF5EF;
}

.opt-key {
  font-size: 30rpx;
  font-weight: 800;
  color: #5B7B9A;
  flex-shrink: 0;
  line-height: 1.6;
}

.opt-val {
  flex: 1;
  font-size: 30rpx;
  color: #2D3E50;
  line-height: 1.6;
  word-break: break-word;
  min-width: 0;
}

/* 反馈 */
.feedback {
  padding: 0 0 32rpx;
  opacity: 0;
  transform: translateY(10rpx);
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.feedback-show {
  opacity: 1;
  transform: translateY(0);
}

.feedback-badge {
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.badge-right {
  background: #E8F5E9;
  color: #6B9B6B;
}

.badge-wrong {
  background: #F5EFEF;
  color: #C47A7A;
}

.next-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 86rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5B7B9A 0%, #6B8EAA 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 86rpx;
  border: none;
}

.next-btn::after { border: none; }
.next-btn:active { opacity: 0.86; }

/* ==================== 结果页 ==================== */
.result-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 24rpx 0;
}

.result-icon {
  margin-bottom: 16rpx;
}

.result-icon-text {
  font-size: 96rpx;
  line-height: 1;
}

.result-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #2D3E50;
  line-height: 1.3;
  margin-bottom: 36rpx;
}

.result-stats {
  width: 100%;
  display: flex;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  padding: 28rpx 0;
}

.result-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #EDEBE6;
}

.result-stat-item:last-child { border-right: none; }

.result-stat-val {
  font-size: 48rpx;
  font-weight: 800;
  color: #5B7B9A;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.result-stat-val.success { color: #6B9B6B; }
.result-stat-val.danger { color: #C47A7A; }

.result-stat-lbl {
  font-size: 24rpx;
  color: #9AABBA;
  line-height: 1.35;
  margin-top: 8rpx;
}

/* 正确率环形图 */
.accuracy-section {
  margin: 36rpx 0;
  display: flex;
  justify-content: center;
}

.accuracy-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.accuracy-bg {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #EDF1F5;
}

.accuracy-fg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.accuracy-center {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.accuracy-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #6B9B6B;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.accuracy-lbl {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.35;
  margin-top: 4rpx;
}

.next-hint {
  margin-bottom: 36rpx;
}

.next-hint-text {
  font-size: 24rpx;
  color: #9AABBA;
  line-height: 1.5;
  text-align: center;
}

.finish-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5B7B9A 0%, #6B8EAA 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 96rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(91, 123, 154, 0.35);
}

.finish-btn::after { border: none; }
.finish-btn:active { opacity: 0.88; transform: scale(0.97); }

/* ==================== 组量选择 ==================== */
.group-size-section {
  width: 100%;
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-label {
  font-size: 24rpx;
  color: #9AABBA;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.size-options {
  display: flex;
  gap: 16rpx;
}

.size-chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: rgba(91, 123, 154, 0.06);
  border: 2rpx solid rgba(91, 123, 154, 0.1);
  font-size: 26rpx;
  color: #7A8A9A;
  transition: all 0.25s ease;
}

.size-chip.active {
  background: rgba(91, 123, 154, 0.12);
  border-color: #5B7B9A;
  color: #5B7B9A;
  font-weight: 600;
}

.size-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #BCC8D6;
}

/* ==================== 练习页 - 组头 ==================== */
.group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4A5C6E;
}

.group-meta {
  font-size: 24rpx;
  color: #9AABBA;
}

/* ==================== 题号导航点 ==================== */
.question-dots {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.q-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #EDF1F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9AABBA;
  font-weight: 600;
  transition: all 0.25s ease;
}

.q-dot.answered {
  background: rgba(91, 123, 154, 0.15);
  color: #5B7B9A;
  border: 2rpx solid rgba(91, 123, 154, 0.3);
}

.q-dot.current {
  background: #5B7B9A;
  color: #FFFFFF;
  transform: scale(1.1);
  box-shadow: 0 4rpx 12rpx rgba(91, 123, 154, 0.3);
}

/* ==================== 题目顶部栏 ==================== */
.q-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.master-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(91, 123, 154, 0.06);
  border: 2rpx solid rgba(91, 123, 154, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.master-btn:active {
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.3);
  transform: scale(0.92);
}

.master-icon {
  font-size: 28rpx;
  color: #7A8A9A;
  font-weight: 700;
}

/* ==================== 导航按钮 ==================== */
.nav-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.nav-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  border: none;
  font-size: 26rpx;
  color: #5B7B9A;
  font-weight: 600;
  line-height: 72rpx;
}

.nav-btn::after { border: none; }
.nav-btn:active { opacity: 0.85; transform: scale(0.97); }
.nav-btn[disabled] { opacity: 0.4; }

/* ==================== 提交本组按钮 ==================== */
.submit-group-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #5B7B9A 0%, #6B8EAA 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  margin-top: 32rpx;
  line-height: 88rpx;
  box-shadow: 0 6rpx 28rpx rgba(91, 123, 154, 0.3);
}

.submit-group-btn::after { border: none; }
.submit-group-btn:active { opacity: 0.88; transform: scale(0.97); }

/* ==================== 组结果 - 逐题回顾 ==================== */
.group-answers {
  width: 100%;
  margin-bottom: 32rpx;
}

.ga-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  background: #F5F3EE;
}

.ga-item.ga-correct {
  background: rgba(16, 185, 129, 0.06);
}

.ga-item.ga-wrong {
  background: rgba(239, 68, 68, 0.06);
}

.ga-status {
  font-size: 28rpx;
  font-weight: 700;
  min-width: 36rpx;
  text-align: center;
}

.ga-correct .ga-status { color: #10B981; }
.ga-wrong .ga-status { color: #EF4444; }

.ga-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ga-stem {
  font-size: 24rpx;
  color: #4A5C6E;
  line-height: 1.5;
}

.ga-answer {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.4;
}

/* ==================== 已掌握确认弹窗 ==================== */
.master-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.master-dialog {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.12);
}

.master-dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 12rpx;
}

.master-dialog-desc {
  font-size: 26rpx;
  color: #9AABBA;
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.master-dialog-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.master-btn-cancel {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  border: none;
  font-size: 28rpx;
  color: #7A8A9A;
  font-weight: 600;
  line-height: 80rpx;
}

.master-btn-cancel::after { border: none; }

.master-btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border: none;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
  line-height: 80rpx;
}

.master-btn-confirm::after { border: none; }
.master-btn-confirm:active { opacity: 0.88; transform: scale(0.97); }
