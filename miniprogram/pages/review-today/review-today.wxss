  overflow-y: auto;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.review-practice .reviewing-progress-strip {
  position: static;
  flex-shrink: 0;
  padding: 8rpx 24rpx 6rpx;
