}

.review-stat-label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8EA0BA;
  line-height: 1.3;
}

.review-plan-card {
  background: #F7FAFF;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border-left: 6rpx solid #4F7FFF;
}

.review-plan-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  line-height: 1.3;
}

.review-plan-desc {
