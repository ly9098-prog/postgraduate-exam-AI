  font-size: 30rpx;
  font-weight: 900;
  line-height: normal;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.primary-review-btn::after { border: none; }
.primary-review-btn:active { transform: scale(0.98); opacity: 0.92; }

/* ==================== review-practice 紧凑布局 ==================== */

.review-practice {
  min-height: 100vh;
