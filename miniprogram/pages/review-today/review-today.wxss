@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  color: #15231A;
  overflow-x: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: #F4F4EE;
}

.page-ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-one {
  width: 340rpx;
  height: 340rpx;
  right: -170rpx;
  top: 150rpx;
  background: rgba(187, 215, 169, 0.28);
}

.ambient-two {
  width: 250rpx;
  height: 250rpx;
  left: -130rpx;
  bottom: 150rpx;
  background: rgba(235, 215, 171, 0.28);
}

.motion-page-enter { animation: premiumEnter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }

/* loading */
.state-page {
  padding: 90rpx 30rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-shell,
.state-shell {
  width: 100%;
  max-width: 650rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-mark {
  width: 280rpx;
  height: 170rpx;
  position: relative;
  margin-bottom: 42rpx;
}

.memory-line,
.curve-segment,
.memory-update-line,
.clear-line {
  position: absolute;
  height: 5rpx;
  border-radius: 999rpx;
  transform-origin: left center;
}

.loading-mark .memory-line { background: #173426; }
.loading-mark .line-1 { width: 78rpx; left: 22rpx; top: 112rpx; transform: rotate(-28deg); }
.loading-mark .line-2 { width: 82rpx; left: 88rpx; top: 76rpx; transform: rotate(17deg); }
.loading-mark .line-3 { width: 90rpx; left: 162rpx; top: 99rpx; transform: rotate(-34deg); background: #A9D800; }

.memory-dot {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border-radius: 50%;
  background: #F4F4EE;
  border: 6rpx solid #173426;
  box-sizing: border-box;
}
.loading-mark .d-1 { left: 24rpx; top: 113rpx; }
.loading-mark .d-2 { left: 94rpx; top: 77rpx; }
.loading-mark .d-3 { left: 168rpx; top: 100rpx; }
.loading-mark .d-4 { left: 246rpx; top: 48rpx; border-color: #A9D800; box-shadow: 0 0 0 14rpx rgba(169,216,0,0.12); }

.loading-title { font-size: 36rpx; font-weight: 900; line-height: 1.35; color: #15231A; }
.loading-desc { margin-top: 12rpx; font-size: 25rpx; color: #748077; line-height: 1.5; }
.loading-bars { width: 420rpx; margin-top: 44rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.loading-bar { height: 18rpx; border-radius: 999rpx; background: linear-gradient(90deg, #E4E7DF, #F2F3EE, #E4E7DF); animation: skeletonPulse 1.2s ease-in-out infinite; }
.loading-bar.long { width: 100%; }
.loading-bar.medium { width: 78%; animation-delay: .1s; }
.loading-bar.short { width: 52%; animation-delay: .2s; }

/* overview */
.overview-page { padding: 34rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); }
.overview-shell { position: relative; z-index: 2; }
.overview-heading { padding: 12rpx 6rpx 30rpx; }
.page-kicker,
.result-kicker,
.state-kicker,
.section-kicker,
.final-kicker,
.final-focus-kicker,
.decision-kicker,
.advice-label,
.mission-eyebrow {
  display: block;
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.35;
}
.page-kicker { color: #748077; }
.page-title { display: block; margin-top: 16rpx; max-width: 610rpx; font-size: 50rpx; font-weight: 950; line-height: 1.15; letter-spacing: -1rpx; color: #132118; }
.page-intro { display: block; margin-top: 16rpx; max-width: 590rpx; font-size: 26rpx; line-height: 1.65; color: #68756C; }

.mission-panel {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  padding: 32rpx;
  color: #FFFFFF;
  background: linear-gradient(145deg, #183528 0%, #10251A 58%, #0A1810 100%);
  box-shadow: 0 24rpx 54rpx rgba(16, 37, 26, 0.20);
}
.mission-grid {
  position: absolute;
  right: -24rpx;
  top: -28rpx;
  width: 320rpx;
  height: 250rpx;
  opacity: .05;
  transform: rotate(8deg);
  background-image: linear-gradient(rgba(255,255,255,.8) 1rpx, transparent 1rpx), linear-gradient(90deg, rgba(255,255,255,.8) 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
}
.mission-glow {
  position: absolute;
  right: -110rpx;
  bottom: -140rpx;
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(183,232,42,.14);
  box-shadow: 0 0 0 48rpx rgba(183,232,42,.025), 0 0 0 92rpx rgba(183,232,42,.018);
}
.mission-top,
.mission-main,
.mission-progress-card { position: relative; z-index: 2; }
.mission-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; }
.mission-eyebrow { color: #B7E82A; }
.mission-label { display: block; margin-top: 8rpx; font-size: 25rpx; color: rgba(255,255,255,.68); }
.mission-batch { padding: 10rpx 16rpx; border-radius: 999rpx; border: 1rpx solid rgba(255,255,255,.12); background: rgba(255,255,255,.06); font-size: 20rpx; font-weight: 750; color: rgba(255,255,255,.74); }
.mission-batch-pressed { opacity: .7; transform: scale(.96); }
.mission-main { margin-top: 28rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.mission-number-wrap { display: flex; align-items: baseline; line-height: 1; }
.mission-number { font-size: 118rpx; font-weight: 950; letter-spacing: -7rpx; font-variant-numeric: tabular-nums; }
.mission-unit { margin-left: 10rpx; font-size: 28rpx; font-weight: 800; color: #B7E82A; }
.curve-stage { width: 280rpx; height: 140rpx; position: relative; flex-shrink: 0; }
.curve-axis { position: absolute; left: 0; right: 0; bottom: 14rpx; height: 1rpx; background: rgba(255,255,255,.13); }
.curve-segment { background: rgba(255,255,255,.62); height: 4rpx; }
.cs-1 { width: 58rpx; left: 8rpx; top: 98rpx; transform: rotate(-31deg); }
.cs-2 { width: 66rpx; left: 58rpx; top: 68rpx; transform: rotate(24deg); }
.cs-3 { width: 68rpx; left: 117rpx; top: 94rpx; transform: rotate(-37deg); }
.cs-4 { width: 75rpx; left: 170rpx; top: 54rpx; transform: rotate(19deg); background: #B7E82A; }
.curve-node { position: absolute; width: 15rpx; height: 15rpx; border-radius: 50%; background: #10251A; border: 4rpx solid rgba(255,255,255,.72); box-sizing: border-box; }
.cn-1 { left: 8rpx; top: 95rpx; }
.cn-2 { left: 61rpx; top: 65rpx; }
.cn-3 { left: 122rpx; top: 91rpx; }
.cn-4 { left: 178rpx; top: 50rpx; }
.curve-node.active { border-color: #B7E82A; box-shadow: 0 0 0 14rpx rgba(183,232,42,.12); }
.mission-progress-card {
  margin-top: 28rpx;
  padding: 22rpx 22rpx 19rpx;
  border: 1rpx solid rgba(255,255,255,.11);
  border-radius: 24rpx;
  background: rgba(255,255,255,.055);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.045);
}
.mission-progress-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.mission-progress-copy { min-width: 0; }
.mission-progress-kicker { display: block; font-size: 17rpx; line-height: 1.3; font-weight: 900; letter-spacing: 2.6rpx; color: rgba(183,232,42,.78); }
.mission-progress-title { display: block; margin-top: 5rpx; font-size: 24rpx; line-height: 1.35; font-weight: 850; color: rgba(255,255,255,.88); }
.mission-progress-percent { display: flex; align-items: baseline; line-height: 1; color: #FFFFFF; font-variant-numeric: tabular-nums; }
.mission-progress-percent-num { font-size: 42rpx; font-weight: 950; letter-spacing: -2rpx; }
.mission-progress-percent-unit { margin-left: 3rpx; font-size: 20rpx; font-weight: 900; color: #B7E82A; }
.mission-progress-rail {
  height: 14rpx;
  margin-top: 19rpx;
  padding: 3rpx;
  border-radius: 999rpx;
  background: rgba(3,12,7,.30);
  border: 1rpx solid rgba(255,255,255,.08);
  box-sizing: border-box;
  overflow: hidden;
}
.mission-progress-fill {
  position: relative;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #90B900 0%, #B7E82A 72%, #D1F36E 100%);
  transition: width .38s ease;
  box-shadow: 0 0 18rpx rgba(183,232,42,.24);
}
.mission-progress-tip {
  position: absolute;
  right: 0;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  margin-top: -4rpx;
  border-radius: 50%;
  background: #F8FFD9;
  box-shadow: 0 0 0 4rpx rgba(248,255,217,.18);
}
.mission-progress-meta { margin-top: 12rpx; display: flex; justify-content: space-between; gap: 20rpx; font-size: 18rpx; line-height: 1.35; color: rgba(255,255,255,.48); }

.overview-stats { margin-top: 20rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.stat-card { min-width: 0; padding: 25rpx 24rpx; border-radius: 26rpx; background: #FBFBF7; border: 1rpx solid #E3E5DE; box-shadow: 0 12rpx 30rpx rgba(23,52,38,.06); }
.stat-card.stat-overdue { background: #F6F0E4; border-color: #E9DDC4; }
.stat-caption { display: block; font-size: 21rpx; font-weight: 750; color: #6C786F; }
.stat-value-row { margin-top: 10rpx; display: flex; align-items: baseline; gap: 7rpx; }
.stat-value { font-size: 52rpx; font-weight: 950; line-height: 1; color: #173426; font-variant-numeric: tabular-nums; }
.stat-overdue .stat-value { color: #B76838; }
.stat-unit { font-size: 21rpx; color: #7B867E; font-weight: 750; }
.stat-foot { display: block; margin-top: 12rpx; font-size: 20rpx; line-height: 1.45; color: #8A938C; }

.advice-card { margin-top: 20rpx; padding: 26rpx; border-radius: 28rpx; background: #E7EBDD; border: 1rpx solid #D8DDCC; display: flex; align-items: flex-start; gap: 20rpx; }
.advice-icon { width: 64rpx; height: 64rpx; border-radius: 20rpx; background: #173426; position: relative; flex-shrink: 0; }
.advice-pulse { position: absolute; left: 50%; top: 50%; width: 14rpx; height: 14rpx; border-radius: 50%; background: #B7E82A; transform: translate(-50%,-50%); box-shadow: 0 0 0 10rpx rgba(183,232,42,.12); }
.advice-copy { min-width: 0; }
.advice-label { color: #6A7B5D; }
.advice-title { display: block; margin-top: 7rpx; font-size: 28rpx; line-height: 1.45; font-weight: 900; color: #173426; }
.advice-desc { display: block; margin-top: 8rpx; font-size: 21rpx; line-height: 1.5; color: #7D887A; }

.primary-action {
  width: 100%;
  min-height: 94rpx;
  margin-top: 24rpx;
  padding: 0 24rpx 0 32rpx;
  border-radius: 24rpx;
  border: none;
  background: #B7E82A;
  color: #10251A;
  box-shadow: 0 16rpx 32rpx rgba(103,139,0,.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.2;
  transition: transform .15s ease, opacity .15s ease;
}
.primary-action[disabled] { opacity: .46; }
.primary-action-pressed { transform: scale(.985); opacity: .88; }
.primary-action-arrow { width: 54rpx; height: 54rpx; border-radius: 50%; background: #10251A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.secondary-action { width: 100%; min-height: 86rpx; margin-top: 12rpx; border-radius: 22rpx; background: transparent; border: 1rpx solid #CDD2C9; color: #173426; font-size: 27rpx; font-weight: 850; }
.secondary-action-pressed { background: #E9ECE5; }

/* reviewing */
.reviewing-page { background: #F4F5F1; overflow: visible; }
.review-context-bar { height: 58rpx; padding: 0 25rpx; display: flex; align-items: center; justify-content: space-between; background: #10251A; color: rgba(255,255,255,.64); border-top: 1rpx solid rgba(255,255,255,.06); font-size: 20rpx; font-weight: 750; }
.review-context-group { color: #B7E82A; letter-spacing: 1rpx; }
.review-practice-content { min-height: calc(100vh - 58rpx); }
.batch-loading-shell { min-height: 75vh; background: #F4F5F1; }
.batch-loading-head { height: 230rpx; background: linear-gradient(145deg,#183528,#10251A); }
.batch-loading-card { margin: -20rpx 24rpx 0; padding: 30rpx 26rpx; border-radius: 28rpx; background: #FFFFFF; border: 1rpx solid #E0E5DE; }
.batch-loading-tag { width: 110rpx; height: 28rpx; border-radius: 8rpx; background: #E9EEE6; animation: skeletonPulse 1.2s ease-in-out infinite; }
.batch-loading-line { height: 24rpx; margin-top: 22rpx; border-radius: 999rpx; background: #E9EEE6; animation: skeletonPulse 1.2s ease-in-out infinite; }
.batch-loading-line.long { width: 92%; }
.batch-loading-line.medium { width: 68%; }
.batch-loading-option { height: 84rpx; margin-top: 16rpx; border-radius: 18rpx; background: #F0F2ED; border: 1rpx solid #E4E8E1; animation: skeletonPulse 1.2s ease-in-out infinite; }

/* group result */
.result-page { padding: 28rpx 26rpx calc(54rpx + env(safe-area-inset-bottom)); overflow: visible; }
.result-shell { max-width: 700rpx; margin: 0 auto; }
.result-celebrate-card { position: relative; overflow: hidden; padding: 34rpx 30rpx; border-radius: 34rpx; background: #153323; color: #FFFFFF; box-shadow: 0 22rpx 48rpx rgba(16,37,26,.16); }
.result-orbit { position: absolute; width: 270rpx; height: 270rpx; right: -100rpx; top: -92rpx; border-radius: 50%; border: 1rpx solid rgba(183,232,42,.16); box-shadow: 0 0 0 42rpx rgba(183,232,42,.025); }
.result-kicker { color: #B7E82A; position: relative; }
.result-title { display: block; position: relative; margin-top: 12rpx; font-size: 44rpx; line-height: 1.2; font-weight: 950; }
.result-desc { display: block; position: relative; margin-top: 12rpx; font-size: 24rpx; line-height: 1.55; color: rgba(255,255,255,.62); }
.result-score-row { position: relative; margin-top: 30rpx; display: flex; align-items: flex-end; gap: 22rpx; }
.result-score-main { display: flex; align-items: baseline; line-height: 1; }
.result-score-num { font-size: 92rpx; font-weight: 950; letter-spacing: -5rpx; }
.result-score-unit { font-size: 28rpx; font-weight: 850; color: #B7E82A; }
.result-score-copy { padding-bottom: 8rpx; }
.result-score-label { display: block; font-size: 22rpx; font-weight: 850; }
.result-score-note { display: block; margin-top: 6rpx; max-width: 310rpx; font-size: 20rpx; line-height: 1.45; color: rgba(255,255,255,.54); }
.result-stat-strip { position: relative; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.10); display: grid; grid-template-columns: repeat(3,1fr); }
.result-stat { display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: rgba(255,255,255,.54); font-size: 19rpx; }
.result-stat-value { font-size: 33rpx; font-weight: 950; color: #FFFFFF; }
.result-stat-value.success { color: #7ED09D; }
.result-stat-value.danger { color: #E9917D; }
.result-stat-value.muted { color: #C4CCC5; }

.memory-update-card,
.wrong-summary-card,
.all-clear-card,
.detail-fold-card { margin-top: 18rpx; border-radius: 26rpx; border: 1rpx solid #E0E3DC; background: #FBFBF7; box-shadow: 0 10rpx 28rpx rgba(23,52,38,.055); }
.memory-update-card { padding: 24rpx; display: flex; align-items: center; gap: 18rpx; background: #E8ECDf; }
.memory-update-icon { width: 68rpx; height: 56rpx; position: relative; flex-shrink: 0; }
.memory-update-line { height: 4rpx; background: #173426; }
.memory-update-line.l1 { width: 22rpx; left: 3rpx; top: 35rpx; transform: rotate(-32deg); }
.memory-update-line.l2 { width: 23rpx; left: 22rpx; top: 23rpx; transform: rotate(24deg); }
.memory-update-line.l3 { width: 27rpx; left: 42rpx; top: 31rpx; transform: rotate(-38deg); background: #91B600; }
.memory-update-title { display: block; font-size: 27rpx; font-weight: 900; color: #173426; }
.memory-update-desc { display: block; margin-top: 5rpx; font-size: 21rpx; line-height: 1.5; color: #788279; }
.wrong-summary-card { padding: 26rpx; }
.section-heading-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.section-kicker { color: #B76838; }
.section-title { display: block; margin-top: 6rpx; font-size: 32rpx; font-weight: 950; color: #17251B; }
.section-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #F3E4DC; color: #AF5730; font-size: 20rpx; font-weight: 850; }
.wrong-summary-item { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #E8EAE4; }
.wrong-summary-item:last-child { border-bottom: none; padding-bottom: 0; }
.wrong-summary-index { width: 42rpx; height: 42rpx; border-radius: 50%; background: #F2E2DB; color: #B05A35; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 900; flex-shrink: 0; }
.wrong-summary-body { min-width: 0; flex: 1; }
.wrong-summary-stem { max-height: 108rpx; overflow: hidden; font-size: 25rpx; line-height: 1.55; color: #243229; }
.wrong-summary-answer { display: block; margin-top: 10rpx; font-size: 20rpx; color: #B05A35; }
.all-clear-card { padding: 25rpx; display: flex; align-items: center; gap: 18rpx; }
.all-clear-mark { width: 62rpx; height: 62rpx; border-radius: 50%; background: #DCEBDD; color: #246541; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 900; flex-shrink: 0; }
.all-clear-title { display: block; font-size: 27rpx; font-weight: 900; color: #173426; }
.all-clear-desc { display: block; margin-top: 5rpx; font-size: 21rpx; color: #788279; }
.detail-fold-card { overflow: hidden; }
.detail-fold-trigger { min-height: 100rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.detail-fold-trigger-pressed { background: #F0F2ED; }
.detail-fold-title { display: block; font-size: 25rpx; font-weight: 900; color: #27352B; }
.detail-fold-desc { display: block; margin-top: 5rpx; font-size: 20rpx; color: #8B948D; }
.detail-fold-arrow { font-size: 34rpx; color: #617067; transition: transform .2s ease; }
.detail-fold-arrow.open { transform: rotate(180deg); }
.detail-list { padding: 0 22rpx 12rpx; border-top: 1rpx solid #E8EAE4; }
.detail-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #ECEEE9; }
.detail-item:last-child { border-bottom: none; }
.detail-status-dot { width: 14rpx; height: 14rpx; margin-top: 10rpx; border-radius: 50%; background: #9AA39C; flex-shrink: 0; }
.detail-item.is-correct .detail-status-dot { background: #2F9A61; }
.detail-item.is-wrong .detail-status-dot { background: #C7624D; }
.detail-item-body { min-width: 0; flex: 1; }
.detail-stem { max-height: 94rpx; overflow: hidden; font-size: 23rpx; line-height: 1.5; color: #344139; }
.detail-answer { display: block; margin-top: 7rpx; font-size: 19rpx; color: #A45A45; }
.detail-status-text { flex-shrink: 0; font-size: 19rpx; font-weight: 800; color: #849087; }
.result-next { margin-top: 20rpx; }

/* final */
.final-page { padding: 28rpx 26rpx 0; overflow: visible; }
.final-shell { max-width: 700rpx; margin: 0 auto; }
.final-hero { position: relative; overflow: hidden; padding: 34rpx 30rpx 30rpx; border-radius: 34rpx; background: #153323; color: #FFFFFF; box-shadow: 0 22rpx 48rpx rgba(16,37,26,.16); }
.final-grid { position: absolute; right: -30rpx; top: -30rpx; width: 300rpx; height: 240rpx; opacity: .05; transform: rotate(8deg); background-image: linear-gradient(#fff 1rpx,transparent 1rpx),linear-gradient(90deg,#fff 1rpx,transparent 1rpx); background-size: 30rpx 30rpx; }
.final-kicker { position: relative; color: #B7E82A; }
.final-title { display: block; position: relative; margin-top: 12rpx; font-size: 43rpx; line-height: 1.25; font-weight: 950; }
.final-desc { display: block; position: relative; margin-top: 10rpx; font-size: 23rpx; line-height: 1.55; color: rgba(255,255,255,.60); }
.final-score-row { position: relative; margin-top: 28rpx; display: flex; align-items: flex-end; gap: 22rpx; }
.final-score { display: flex; align-items: baseline; font-size: 92rpx; line-height: 1; font-weight: 950; letter-spacing: -5rpx; }
.final-score-unit { font-size: 28rpx; color: #B7E82A; }
.final-score-label { padding-bottom: 8rpx; display: flex; flex-direction: column; gap: 5rpx; color: rgba(255,255,255,.55); font-size: 21rpx; }
.final-score-label text:first-child { color: #FFFFFF; font-weight: 850; }
.final-progress-module {
  position: relative;
  margin-top: 27rpx;
  padding: 21rpx 21rpx 18rpx;
  border-radius: 23rpx;
  border: 1rpx solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.055);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.04);
}
.final-progress-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.final-progress-kicker { display: block; font-size: 16rpx; line-height: 1.3; font-weight: 900; letter-spacing: 2.4rpx; color: rgba(183,232,42,.75); }
.final-progress-title { display: block; margin-top: 5rpx; font-size: 22rpx; line-height: 1.35; font-weight: 850; color: rgba(255,255,255,.86); }
.final-progress-percent { display: flex; align-items: baseline; color: #FFFFFF; font-size: 38rpx; line-height: 1; font-weight: 950; letter-spacing: -1rpx; font-variant-numeric: tabular-nums; }
.final-progress-percent-unit { margin-left: 3rpx; font-size: 18rpx; color: #B7E82A; }
.final-progress-segments { margin-top: 18rpx; display: grid; grid-template-columns: repeat(10,1fr); gap: 5rpx; }
.final-progress-segment { height: 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.10); box-shadow: inset 0 0 0 1rpx rgba(255,255,255,.025); }
.final-progress-segment.active { background: #B7E82A; box-shadow: 0 0 12rpx rgba(183,232,42,.14); }
.final-progress-foot { margin-top: 12rpx; display: flex; justify-content: space-between; gap: 18rpx; color: rgba(255,255,255,.48); font-size: 18rpx; line-height: 1.35; }
.final-progress-foot text:last-child { color: rgba(255,255,255,.66); }
.final-stats-grid { margin-top: 18rpx; display: grid; grid-template-columns: repeat(4,1fr); gap: 12rpx; }
.final-stat { min-width: 0; padding: 20rpx 6rpx; border-radius: 22rpx; background: #FBFBF7; border: 1rpx solid #E0E3DC; display: flex; flex-direction: column; align-items: center; gap: 6rpx; color: #879087; font-size: 19rpx; }
.final-stat-num { font-size: 34rpx; line-height: 1; font-weight: 950; color: #173426; }
.final-stat-num.success { color: #2E8D58; }
.final-stat-num.danger { color: #BE5D48; }
.final-focus-card { margin-top: 18rpx; padding: 27rpx; border-radius: 28rpx; background: #E9EDDF; border: 1rpx solid #DCE1D1; }
.final-focus-card.review { background: #F2E9DF; border-color: #E8D7C7; }
.final-focus-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.final-focus-kicker { color: #6A7B5D; }
.final-focus-card.review .final-focus-kicker { color: #9E6542; }
.final-focus-tag { padding: 7rpx 13rpx; border-radius: 999rpx; background: #D5DEBE; color: #52643F; font-size: 19rpx; font-weight: 850; }
.final-focus-card.review .final-focus-tag { background: #E9D5C4; color: #975B39; }
.final-focus-title { display: block; margin-top: 13rpx; font-size: 31rpx; font-weight: 950; color: #173426; }
.final-focus-desc { display: block; margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; color: #758075; }
.weak-subjects { margin-top: 18rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.weak-subject { padding: 8rpx 13rpx; border-radius: 999rpx; background: rgba(255,255,255,.55); color: #8D5A3D; font-size: 19rpx; font-weight: 750; }
.final-bottom-space { height: 200rpx; }
.final-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #FBFBF7; border-top: 1rpx solid #E0E3DC; display: grid; grid-template-columns: 1.15fr .85fr; gap: 12rpx; }
.final-primary,
.final-secondary { min-height: 82rpx; border-radius: 21rpx; font-size: 26rpx; font-weight: 900; }
.final-primary { background: #B7E82A; color: #10251A; }
.final-secondary { background: #ECEFE8; color: #415047; }

/* empty/error */
.state-visual { width: 280rpx; height: 220rpx; position: relative; margin-bottom: 36rpx; }
.clear-ring { position: absolute; border-radius: 50%; border: 1rpx solid #BBC5B9; }
.ring-one { width: 180rpx; height: 180rpx; left: 50rpx; top: 18rpx; }
.ring-two { width: 124rpx; height: 124rpx; left: 78rpx; top: 46rpx; border-color: #D7DDD3; }
.clear-check { position: absolute; width: 94rpx; height: 94rpx; left: 93rpx; top: 61rpx; border-radius: 50%; background: #173426; color: #B7E82A; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 900; box-shadow: 0 18rpx 36rpx rgba(23,52,38,.18); }
.clear-line { background: #8B9D89; height: 4rpx; }
.cl-1 { width: 54rpx; left: 12rpx; top: 118rpx; transform: rotate(-24deg); }
.cl-2 { width: 50rpx; right: 4rpx; top: 78rpx; transform: rotate(18deg); background: #B7E82A; }
.cl-3 { width: 46rpx; right: 24rpx; bottom: 28rpx; transform: rotate(-18deg); }
.state-kicker { color: #73806F; }
.state-kicker.danger { color: #B65A47; }
.state-title { display: block; margin-top: 13rpx; font-size: 42rpx; line-height: 1.25; font-weight: 950; color: #142219; }
.state-desc { display: block; margin-top: 14rpx; max-width: 580rpx; font-size: 25rpx; line-height: 1.65; color: #727D75; }
.empty-status-row { width: 100%; margin-top: 32rpx; padding: 22rpx 0; border-radius: 24rpx; background: #FBFBF7; border: 1rpx solid #E0E3DC; display: grid; grid-template-columns: 1fr 1rpx 1fr; align-items: center; }
.empty-status-row > view:not(.empty-status-divider) { display: flex; flex-direction: column; gap: 7rpx; color: #859087; font-size: 20rpx; }
.empty-status-value { color: #173426; font-size: 25rpx; font-weight: 900; }
.empty-status-divider { width: 1rpx; height: 48rpx; background: #E0E3DC; }
.error-mark { width: 106rpx; height: 106rpx; margin-bottom: 30rpx; border-radius: 32rpx; background: #F0DED8; color: #B55B48; display: flex; align-items: center; justify-content: center; font-size: 55rpx; font-weight: 950; }

/* modal and undo */
.modal-overlay { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; justify-content: center; background: rgba(5,13,8,.60); }
.decision-sheet { width: 100%; padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #FBFBF7; box-shadow: 0 -24rpx 60rpx rgba(0,0,0,.18); animation: sheetRise .22s ease-out both; }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 27rpx; border-radius: 999rpx; background: #D1D6CE; }
.decision-kicker { color: #73806F; }
.decision-title { display: block; margin-top: 9rpx; font-size: 38rpx; font-weight: 950; line-height: 1.25; color: #142219; }
.decision-desc { display: block; margin-top: 13rpx; font-size: 24rpx; line-height: 1.65; color: #707B73; }
.decision-actions { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.decision-primary,
.decision-secondary { min-height: 84rpx; border-radius: 21rpx; font-size: 26rpx; font-weight: 900; }
.decision-primary { background: #B7E82A; color: #10251A; }
.decision-secondary { background: #ECEFE8; color: #445249; }
.undo-toast { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); z-index: 150; min-height: 84rpx; padding: 0 22rpx; border-radius: 22rpx; background: #10251A; color: #FFFFFF; display: flex; align-items: center; transform: translateY(150%); opacity: 0; pointer-events: none; transition: transform .22s ease, opacity .22s ease; box-shadow: 0 18rpx 42rpx rgba(16,37,26,.26); }
.undo-toast.show { transform: translateY(0); opacity: 1; pointer-events: auto; }
.undo-toast-text { min-width: 0; flex: 1; font-size: 22rpx; line-height: 1.4; color: rgba(255,255,255,.78); }
.undo-divider { width: 1rpx; height: 36rpx; margin: 0 18rpx; background: rgba(255,255,255,.14); }
.undo-action { flex-shrink: 0; font-size: 24rpx; font-weight: 900; color: #B7E82A; }

@keyframes premiumEnter { from { opacity: 0; transform: translateY(22rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes skeletonPulse { 0%,100% { opacity: .52; } 50% { opacity: 1; } }
@keyframes sheetRise { from { transform: translateY(42rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

@media (max-width: 360px) {
  .page-title { font-size: 45rpx; }
  .mission-number { font-size: 102rpx; }
  .curve-stage { width: 238rpx; transform: scale(.9); transform-origin: right bottom; }
  .final-stats-grid { grid-template-columns: repeat(2,1fr); }
}

@media (prefers-reduced-motion: reduce) {
  .motion-page-enter,
  .loading-bar,
  .batch-loading-tag,
  .batch-loading-line,
  .batch-loading-option,
  .decision-sheet { animation: none !important; }
  .mission-progress-fill,
  .detail-fold-arrow,
  .undo-toast,
  .primary-action { transition: none !important; }
}


/* ==================== Phase 2 completion hierarchy ==================== */
.final-score-row { align-items: center; }
.final-score-label { padding-bottom: 0; }
.final-progress-state {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(183,232,42,.12);
  color: #D7FF68;
  font-size: 18rpx;
  line-height: 1.3;
  font-weight: 900;
}
.final-stat-num.accuracy { color: #173426; font-size: 30rpx; letter-spacing: -1rpx; }
.final-actions {
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -14rpx 36rpx rgba(16,37,26,.07);
}
.final-primary,
.final-secondary { border-radius: 25rpx; }

/* ==================== 每组题数底部弹层 ==================== */

.batch-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(4, 20, 13, 0.58);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: batchMaskIn 200ms ease-out both;
}

.batch-sheet {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 14rpx 28rpx 28rpx;
  border-radius: 40rpx;
  background: #f7f8f1;
  box-shadow: 0 24rpx 64rpx rgba(4, 22, 14, 0.24);
  animation: batchSheetIn 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.batch-sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #D1D6CE;
}

/* 标题区域 */
.batch-sheet-head { margin-bottom: 24rpx; padding: 0 4rpx; }
.batch-sheet-kicker {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2.6rpx;
  color: #748077;
}
.batch-sheet-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.2;
  color: #132118;
}
.batch-sheet-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6C786F;
}

/* 选项网格：两列 */
.batch-size-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.batch-size-option {
  position: relative;
  min-height: 128rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #FBFBF7;
  border: 2rpx solid #E0E3DC;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
}

.batch-size-option:active {
  transform: scale(0.97);
}

/* 临时选中态 */
.batch-size-option.is-pending {
  background: linear-gradient(135deg, #a9ef12, #c9f83c);
  background-color: #b8f21c;
  border-color: #8bcb00;
  border-width: 3rpx;
  box-shadow: 0 6rpx 20rpx rgba(169, 216, 0, 0.20);
}

/* 当前生效但未临时选择 */
.batch-size-option.is-current {
  border-color: #b8f21c;
  border-width: 3rpx;
  background: #F3F8E8;
}

.batch-size-option-top {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}

.batch-size-num {
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1;
  color: #132118;
  font-variant-numeric: tabular-nums;
}

.batch-size-unit {
  font-size: 22rpx;
  font-weight: 800;
  color: #415047;
}

.batch-size-check {
  margin-left: auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #10251A;
  color: #b8f21c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.batch-size-label {
  font-size: 20rpx;
  color: #6C786F;
  line-height: 1.3;
}

.batch-size-option.is-pending .batch-size-label { color: #3B5F10; }
.batch-size-option.is-pending .batch-size-unit { color: #3B5F10; }

/* 推荐角标（仅 10 道） */
.batch-size-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #10251A;
  color: #b8f21c;
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

/* 当前选择提示 */
.batch-sheet-current-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6C786F;
  text-align: center;
  line-height: 1.4;
}

/* 操作按钮 */
.batch-sheet-actions {
  display: flex;
  align-items: stretch;
  width: 100%;
  gap: 16rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮重置——修复微信 <button> 默认 margin/padding 导致的溢出 */
.batch-sheet-action {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  height: 84rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 84rpx;
  text-align: center;
  overflow: visible;
  display: block;
}

.batch-sheet-action::after {
  border: 0;
}

/* 取消按钮 */
.batch-sheet-cancel {
  background: #ECEFE8;
  color: #415047;
  border: 1rpx solid #CDD2C9;
}

.batch-sheet-cancel:active {
  background: #E0E3DC;
}

/* 确认按钮 */
.batch-sheet-confirm {
  background-color: #b8f21c;
  background-image: linear-gradient(135deg, #a9ef12, #c9f83c);
  color: #0b2b1c;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(169, 216, 0, 0.18);
}

.batch-sheet-confirm:active {
  opacity: 0.88;
}

/* 动画 */
@keyframes batchMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes batchSheetIn {
  from { opacity: 0; transform: translateY(42rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .batch-sheet-mask { animation: none !important; }
  .batch-sheet { animation: none !important; }
  .batch-size-option { transition: none !important; }
}

@media (max-width: 360px) {
  .batch-sheet-title { font-size: 33rpx; }
  .batch-size-num { font-size: 38rpx; }
  .batch-sheet { margin-left: 16rpx; margin-right: 16rpx; }
}
