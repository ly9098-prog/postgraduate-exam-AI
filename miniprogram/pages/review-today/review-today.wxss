/* ==================== 加载失败 ==================== */

.review-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 24rpx;
}

.error-wrap {
  text-align: center;
  max-width: 480rpx;
}

.error-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.error-title {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
  color: #18233A;
  margin-bottom: 10rpx;
}

.error-desc {
  display: block;
  font-size: 26rpx;
  color: #617089;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.error-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 48rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  line-height: normal;
}

.error-retry::after { border: none; }
.error-retry:active { opacity: 0.9; transform: scale(0.97); }
