@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #EEF5FF;
  background-color: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  background-color: #EEF5FF;
  padding: 24rpx 0 48rpx;
  overflow-x: hidden;
  animation: none;
}

.review-hero { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.mission-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.04s both; }
.question-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s both; }

.animation-fade-in {
  animation: fadeSlideIn 0.58s ease-out;
  transform: translateZ(0);
}

/* ==================== 通用 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid #E2EAF7;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #617089;
  margin-top: 18rpx;
  font-weight: 700;
}

/* ==================== 入口页 ==================== */
.entry-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.review-hero {
  margin: 0 24rpx 16rpx;
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 56%, #8AAFC8 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  position: relative;
  overflow: hidden;
}

.review-hero::before {
  content: '';
  position: absolute;
  left: -82rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24) 0%, transparent 70%);
}

.review-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -78rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.28) 0%, transparent 70%);
}

.hero-orbit {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.26);
  pointer-events: none;
}

.hero-orbit-one {
  width: 210rpx;
  height: 210rpx;
  right: 64rpx;
  top: -38rpx;
}

.hero-orbit-two {
  width: 128rpx;
  height: 128rpx;
  right: 106rpx;
  top: 2rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.28);
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

.ring-section {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.ring-container {
  position: relative;
  width: 164rpx;
  height: 164rpx;
}

.ring-bg,
.ring-fg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-bg {
  background: rgba(255,255,255,0.24);
}

.ring-fg {
  background: conic-gradient(#22C55E 0deg, rgba(255,255,255,0.24) 0deg);
}

.ring-center {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(42, 84, 160, 0.12);
}

.ring-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ring-label {
  font-size: 19rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 4rpx;
  font-weight: 700;
}

.mission-card {
  margin: 0 24rpx 18rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 14rpx 38rpx rgba(79, 127, 255, 0.12);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.mission-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
}

.mission-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.mission-badge {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFF7E8, #FFE9B8);
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.motivation-text {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
}

.glass-card {
  margin-top: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.glass-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.glass-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.glass-num.warning { color: #F59E0B; }
.glass-num.success { color: #22C55E; }

.glass-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
}

.glass-divider {
  width: 1rpx;
  height: 52rpx;
  background: #E2EAF7;
  flex-shrink: 0;
}

.group-size-section {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #617089;
}

.section-chip {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.size-options {
  display: flex;
  gap: 16rpx;
}

.size-chip {
  flex: 1;
  text-align: center;
  min-height: 76rpx;
  line-height: 76rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #617089;
  font-weight: 800;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.tap-scale,
.size-chip:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.size-chip.active {
  background: linear-gradient(135deg, #E8F0FF, #F2F8FF);
  border-color: #4F7FFF;
  color: #4F7FFF;
  box-shadow: inset 0 0 0 1rpx rgba(79, 127, 255, 0.18);
}

.size-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  text-align: center;
}

.gradient-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 30rpx 24rpx 0;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: normal;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.gradient-btn::after { border: none; }
.gradient-btn:active { transform: scale(0.98); opacity: 0.92; }

.done-wrap {
  margin: 56rpx 24rpx 0;
  padding: 44rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.done-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ECFDF3;
  color: #22C55E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.done-check-icon {
  width: 44rpx;
  height: 44rpx;
  color: #22C55E;
}

.done-check.mute {
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 38rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.35;
}

.done-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
}

/* ==================== 结果页 ==================== */
.result-page {
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.result-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 24rpx 0;
  overflow: hidden;
}

.final-wrap {
  min-height: 100vh;
}

.celebrate-bg {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.celebrate-one {
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  top: 10rpx;
  background: radial-gradient(circle, rgba(79,127,255,0.14) 0%, transparent 70%);
}

.celebrate-two {
  width: 280rpx;
  height: 280rpx;
  left: -120rpx;
  top: 220rpx;
  background: radial-gradient(circle, rgba(34,197,94,0.14) 0%, transparent 70%);
}

.result-medal {
  width: 156rpx;
  height: 156rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #FFF7E8 0%, #FFE9B8 100%);
  border: 8rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 16rpx 36rpx rgba(245, 158, 11, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  position: relative;
  z-index: 1;
}

.final-medal {
  background: linear-gradient(145deg, #ECFDF3 0%, #DFF8EA 100%);
  box-shadow: 0 16rpx 36rpx rgba(34, 197, 94, 0.18);
}

.result-medal-main {
  font-size: 48rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.05;
}

.final-medal .result-medal-main {
  color: #16823A;
}

.result-medal-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A6425;
  font-weight: 800;
  line-height: 1.2;
}

.final-medal .result-medal-sub {
  color: #16823A;
}

.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.3;
  text-align: center;
}

.result-desc {
  display: block;
  margin: 10rpx 20rpx 28rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
}

.group-reward-strip {
  width: 100%;
  margin: 0 0 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255,255,255,0.96) 0%, rgba(238,245,255,0.95) 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(79, 127, 255, 0.1);
  position: relative;
  z-index: 1;
  animation: reward-pop 0.48s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s both;
}

.group-reward-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.group-reward-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(79, 127, 255, 0.18);
  flex-shrink: 0;
}

.group-reward-copy {
  flex: 1;
  min-width: 0;
}

.group-reward-title {
  display: block;
  font-size: 28rpx;
  color: #18233A;
  line-height: 1.35;
  font-weight: 900;
}

.group-reward-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.group-progress-track {
  margin-top: 20rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #E2EAF7;
  overflow: hidden;
}

.group-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 58%, #22C55E 100%);
  box-shadow: 0 0 18rpx rgba(79, 127, 255, 0.24);
  transition: width 0.3s ease;
}

.group-progress-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  text-align: center;
  line-height: 1.35;
}

.result-stats {
  width: 100%;
  display: flex;
  background: rgba(255,255,255,0.94);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  padding: 28rpx 0;
  position: relative;
  z-index: 1;
}

.result-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #E2EAF7;
}

.result-stat-item:last-child { border-right: none; }

.result-stat-val {
  font-size: 46rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.result-stat-val.success { color: #22C55E; }
.result-stat-val.danger { color: #EF4444; }

.result-stat-lbl {
  font-size: 23rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 8rpx;
}

.result-meta {
  margin-top: 16rpx;
  text-align: center;
}

.result-meta-text {
  font-size: 22rpx;
  color: #8EA0BA;
  line-height: 1.45;
}

.accuracy-section {
  width: 100%;
  margin: 36rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.accuracy-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.accuracy-bg,
.accuracy-fg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.accuracy-bg {
  background: #E2EAF7;
}

.accuracy-fg {
  background: conic-gradient(#22C55E 0deg, #E2EAF7 0deg);
}

.accuracy-center {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(42, 84, 160, 0.1);
}

.accuracy-num {
  font-size: 45rpx;
  font-weight: 900;
  color: #22C55E;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.accuracy-lbl {
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 5rpx;
}

.final-growth-card {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #F7FAFF 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(42, 84, 160, 0.08);
}

.final-growth-kicker {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #ECFDF3;
  color: #16823A;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 900;
}

.final-growth-title {
  display: block;
  margin-top: 14rpx;
  font-size: 31rpx;
  color: #18233A;
  line-height: 1.3;
  font-weight: 900;
}

.final-growth-desc {
  display: block;
  margin-top: 7rpx;
  font-size: 23rpx;
  color: #617089;
  line-height: 1.45;
}

.reward-card {
  width: 100%;
  margin: 8rpx 0 30rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #FFEEC7 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.reward-title {
  display: block;
  font-size: 25rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.35;
}

.reward-desc {
  display: block;
  margin-top: 7rpx;
  font-size: 24rpx;
  color: #8A6425;
  line-height: 1.45;
}

.finish-btn {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: normal;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.finish-btn::after { border: none; }
.finish-btn:active { opacity: 0.92; transform: scale(0.98); }

.group-answers {
  width: 100%;
  margin: 24rpx 0 32rpx;
}

.ga-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
}

.ga-item.ga-correct {
  background: #ECFDF3;
  border-color: rgba(34, 197, 94, 0.18);
}

.ga-item.ga-wrong {
  background: #FFF1F2;
  border-color: rgba(239, 68, 68, 0.16);
}

.ga-item.ga-skipped {
  background: #F6F9FF;
  border-color: rgba(142, 160, 186, 0.16);
}

.ga-status {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.ga-correct .ga-status {
  background: #22C55E;
  color: #FFFFFF;
}

.ga-wrong .ga-status {
  background: #EF4444;
  color: #FFFFFF;
}

.ga-skipped .ga-status {
  background: #8EA0BA;
  color: #FFFFFF;
}

.ga-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ga-stem {
  font-size: 24rpx;
  color: #18233A;
  line-height: 1.5;
}

.ga-answer {
  font-size: 22rpx;
  color: #617089;
  line-height: 1.4;
}

.result-btn {
  margin: 0;
  width: 100%;
}

/* ==================== 已掌握确认弹窗 ==================== */
.master-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(23, 32, 51, 0.46);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes reward-pop {
  0% { opacity: 0; transform: scale(0.92) translateY(12rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.master-dialog {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(23, 32, 51, 0.16);
}

.master-dialog-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #18233A;
  margin-bottom: 12rpx;
}

.master-dialog-desc {
  font-size: 26rpx;
  color: #617089;
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.master-dialog-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.master-btn-cancel,
.master-btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.master-btn-cancel {
  background: #E8F0FF;
  color: #4F7FFF;
}

.master-btn-confirm {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #FFFFFF;
}

.master-btn-cancel::after,
.master-btn-confirm::after { border: none; }

.master-btn-cancel:active,
.master-btn-confirm:active { opacity: 0.9; transform: scale(0.97); }

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .group-reward-strip,
  .group-progress-fill,
  .animation-fade-in,
  .loading-spinner,
  .question-card,
  .question-card.slide-in,
  .master-overlay {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* ==================== Code block ==================== */
.code-wrapper {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin: 16rpx 0 28rpx;
  overflow: hidden;
}
.code-text {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  white-space: pre;
  font-family: 'Courier New', Courier, monospace;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A2E;
}

/* ==================== 垂直居中修复：按钮和胶囊标签 ==================== */
.submit-group-btn {
  line-height: normal;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.size-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: normal;
}

.mission-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  line-height: 1;
  box-sizing: border-box;
}

.section-chip,
.group-meta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  line-height: 1;
  box-sizing: border-box;
}

.subject-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 15rpx;
  line-height: 1;
  box-sizing: border-box;
}

.blank-group-title {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  line-height: 1;
  box-sizing: border-box;
}

.final-growth-kicker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  line-height: 1;
  box-sizing: border-box;
}

.master-btn-cancel,
.master-btn-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 20rpx;
  line-height: normal;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}

/* Mixed mode blocks */
.mixed-text-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-latex-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-code-block {
  margin: 16rpx 0 28rpx;
}
