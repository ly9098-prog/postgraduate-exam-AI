  box-sizing: border-box;
}

/* ==================== 复习进度条 ==================== */

.reviewing-progress-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  background: rgba(255,255,255,0.92);
  border-bottom: 1rpx solid #E2EAF7;
  position: sticky;
  top: 0;
  z-index: 10;
}

.rps-group {
  font-size: 24rpx;
  font-weight: 800;
  color: #4F7FFF;
}

.rps-progress {
  font-size: 22rpx;
  color: #617089;
  font-weight: 600;
}

