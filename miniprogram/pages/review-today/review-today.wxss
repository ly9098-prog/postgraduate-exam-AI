@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding-bottom: 48rpx;
  overflow-x: hidden;
  animation: page-enter 0.38s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.review-hero { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.mission-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.04s both; }
.question-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s both; }

.animation-fade-in {
  animation: fadeSlideIn 0.58s ease-out;
  transform: translateZ(0);
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==================== 通用 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid #E2EAF7;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #617089;
  margin-top: 18rpx;
  font-weight: 700;
}

/* ==================== 入口页 ==================== */
.entry-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.review-hero {
  margin: 24rpx 24rpx 16rpx;
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 56%, #8AAFC8 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  position: relative;
  overflow: hidden;
}

.review-hero::before {
  content: '';
  position: absolute;
  left: -82rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24) 0%, transparent 70%);
}

.review-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -78rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.28) 0%, transparent 70%);
}

.hero-orbit {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.26);
  pointer-events: none;
}

.hero-orbit-one {
  width: 210rpx;
  height: 210rpx;
  right: 64rpx;
  top: -38rpx;
}

.hero-orbit-two {
  width: 128rpx;
  height: 128rpx;
  right: 106rpx;
  top: 2rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.28);
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

.ring-section {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.ring-container {
  position: relative;
  width: 164rpx;
  height: 164rpx;
}

.ring-bg,
.ring-fg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-bg {
  background: rgba(255,255,255,0.24);
}

.ring-fg {
  background: conic-gradient(#22C55E 0deg, rgba(255,255,255,0.24) 0deg);
}

.ring-center {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(42, 84, 160, 0.12);
}

.ring-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ring-label {
  font-size: 19rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 4rpx;
  font-weight: 700;
}

.mission-card {
  margin: 0 24rpx 18rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 14rpx 38rpx rgba(79, 127, 255, 0.12);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.mission-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
}

.mission-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.mission-badge {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFF7E8, #FFE9B8);
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.motivation-text {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
}

.glass-card {
  margin-top: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.glass-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.glass-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.glass-num.warning { color: #F59E0B; }
.glass-num.success { color: #22C55E; }

.glass-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
}

.glass-divider {
  width: 1rpx;
  height: 52rpx;
  background: #E2EAF7;
  flex-shrink: 0;
}

.group-size-section {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #617089;
}

.section-chip {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.size-options {
  display: flex;
  gap: 16rpx;
}

.size-chip {
  flex: 1;
  text-align: center;
  min-height: 76rpx;
  line-height: 76rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #617089;
  font-weight: 800;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.tap-scale,
.size-chip:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.size-chip.active {
  background: linear-gradient(135deg, #E8F0FF, #F2F8FF);
  border-color: #4F7FFF;
  color: #4F7FFF;
  box-shadow: inset 0 0 0 1rpx rgba(79, 127, 255, 0.18);
}

.size-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  text-align: center;
}

.gradient-btn {
  display: block;
  margin: 30rpx 24rpx 0;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  min-height: 92rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.gradient-btn::after { border: none; }
.gradient-btn:active { transform: scale(0.98); opacity: 0.92; }

.done-wrap {
  margin: 56rpx 24rpx 0;
  padding: 44rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.done-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ECFDF3;
  color: #22C55E;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 96rpx;
  text-align: center;
  margin-bottom: 18rpx;
}

.done-check.mute {
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 38rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.35;
}

.done-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
}

/* ==================== 练习页 ==================== */
.review-practice {
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  overflow-x: hidden;
}

.practice-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: 36rpx;
}

.group-header {
  margin: 24rpx 24rpx 14rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  box-shadow: 0 10rpx 28rpx rgba(79, 127, 255, 0.08);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.group-title {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.3;
}

.group-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.35;
}

.group-meta {
  flex-shrink: 0;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #FFF7E8;
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.review-progress {
  padding: 0 24rpx;
}

.question-dots {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.q-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 2rpx solid #E2EAF7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8EA0BA;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 14rpx rgba(42, 84, 160, 0.05);
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.q-dot:active {
  transform: scale(0.94);
}

.q-dot.answered {
  background: #ECFDF3;
  border-color: rgba(34, 197, 94, 0.28);
  color: #16823A;
}

.q-dot.current {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(79, 127, 255, 0.22);
}

.question-card {
  margin: 18rpx 24rpx 0;
  padding: 30rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.96);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  box-shadow: 0 14rpx 34rpx rgba(42, 84, 160, 0.08);
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.question-card.slide-out-left {
  transform: translateX(-60rpx);
  opacity: 0;
}

.question-card.slide-out-right {
  transform: translateX(60rpx);
  opacity: 0;
}

.question-card.slide-in {
  animation: slideIn 0.15s ease;
}

@keyframes slideIn {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.q-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.subject-badge {
  display: inline-block;
  padding: 6rpx 15rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  background: #E8F0FF;
  color: #4F7FFF;
  line-height: 1.35;
}

.q-kicker {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  line-height: 1.35;
}

.master-btn {
  width: 62rpx;
  height: 62rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #ECFDF3 0%, #E8FFF0 100%);
  border: 2rpx solid rgba(34, 197, 94, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(34, 197, 94, 0.1);
}

.master-btn:active {
  transform: scale(0.94);
}

.master-icon {
  font-size: 28rpx;
  color: #22C55E;
  font-weight: 900;
}

.q-stem {
  margin-bottom: 34rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #18233A;
  word-break: break-word;
}

.q-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.8;
  color: #18233A;
  white-space: pre-wrap;
  word-break: break-word;
}

.q-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  background: #F7FAFF;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.option-item:active,
.option-pressed {
  transform: scale(0.985);
  background: #EEF5FF;
}

.option-item.opt-selected {
  background: linear-gradient(180deg, #EEF5FF 0%, #F8FBFF 100%);
  border-color: #4F7FFF;
  box-shadow: 0 8rpx 22rpx rgba(79, 127, 255, 0.1);
}

.opt-key {
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
  flex-shrink: 0;
  line-height: 1.6;
}

.opt-val {
  flex: 1;
  font-size: 28rpx;
  color: #18233A;
  line-height: 1.6;
  word-break: break-word;
  min-width: 0;
  white-space: pre-wrap;
}

.nav-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.nav-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  border: none;
  font-size: 26rpx;
  color: #4F7FFF;
  font-weight: 800;
  line-height: 78rpx;
}

.nav-btn::after { border: none; }
.nav-btn:active { opacity: 0.85; transform: scale(0.97); }
.nav-btn[disabled] { opacity: 0.38; }

.submit-group-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #18233A 0%, #27446E 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  border: none;
  margin-top: 22rpx;
  line-height: 90rpx;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 51, 0.14);
}

.submit-group-btn::after { border: none; }
.submit-group-btn:active { opacity: 0.9; transform: scale(0.99); }

/* ==================== 结果页 ==================== */
.result-page {
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

.result-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58rpx 24rpx 0;
  overflow: hidden;
}

.final-wrap {
  min-height: 100vh;
}

.celebrate-bg {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.celebrate-one {
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  top: 10rpx;
  background: radial-gradient(circle, rgba(79,127,255,0.14) 0%, transparent 70%);
}

.celebrate-two {
  width: 280rpx;
  height: 280rpx;
  left: -120rpx;
  top: 220rpx;
  background: radial-gradient(circle, rgba(34,197,94,0.14) 0%, transparent 70%);
}

.result-medal {
  width: 156rpx;
  height: 156rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #FFF7E8 0%, #FFE9B8 100%);
  border: 8rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 16rpx 36rpx rgba(245, 158, 11, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  position: relative;
  z-index: 1;
}

.final-medal {
  background: linear-gradient(145deg, #ECFDF3 0%, #DFF8EA 100%);
  box-shadow: 0 16rpx 36rpx rgba(34, 197, 94, 0.18);
}

.result-medal-main {
  font-size: 48rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.05;
}

.final-medal .result-medal-main {
  color: #16823A;
}

.result-medal-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8A6425;
  font-weight: 800;
  line-height: 1.2;
}

.final-medal .result-medal-sub {
  color: #16823A;
}

.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.3;
  text-align: center;
}

.result-desc {
  display: block;
  margin: 10rpx 20rpx 28rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
}

.group-reward-strip {
  width: 100%;
  margin: 0 0 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: linear-gradient(145deg, rgba(255,255,255,0.96) 0%, rgba(238,245,255,0.95) 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(79, 127, 255, 0.1);
  position: relative;
  z-index: 1;
  animation: reward-pop 0.48s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s both;
}

.group-reward-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.group-reward-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(79, 127, 255, 0.18);
  flex-shrink: 0;
}

.group-reward-copy {
  flex: 1;
  min-width: 0;
}

.group-reward-title {
  display: block;
  font-size: 28rpx;
  color: #18233A;
  line-height: 1.35;
  font-weight: 900;
}

.group-reward-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.group-progress-track {
  margin-top: 20rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #E2EAF7;
  overflow: hidden;
}

.group-progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 58%, #22C55E 100%);
  box-shadow: 0 0 18rpx rgba(79, 127, 255, 0.24);
  transition: width 0.3s ease;
}

.group-progress-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  text-align: center;
  line-height: 1.35;
}

.result-stats {
  width: 100%;
  display: flex;
  background: rgba(255,255,255,0.94);
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  padding: 28rpx 0;
  position: relative;
  z-index: 1;
}

.result-stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-right: 1rpx solid #E2EAF7;
}

.result-stat-item:last-child { border-right: none; }

.result-stat-val {
  font-size: 46rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.result-stat-val.success { color: #22C55E; }
.result-stat-val.danger { color: #EF4444; }

.result-stat-lbl {
  font-size: 23rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 8rpx;
}

.accuracy-section {
  width: 100%;
  margin: 36rpx 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.accuracy-ring {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.accuracy-bg,
.accuracy-fg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.accuracy-bg {
  background: #E2EAF7;
}

.accuracy-fg {
  background: conic-gradient(#22C55E 0deg, #E2EAF7 0deg);
}

.accuracy-center {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(42, 84, 160, 0.1);
}

.accuracy-num {
  font-size: 45rpx;
  font-weight: 900;
  color: #22C55E;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.accuracy-lbl {
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 5rpx;
}

.final-growth-card {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #F7FAFF 100%);
  border: 1rpx solid rgba(226, 234, 247, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(42, 84, 160, 0.08);
}

.final-growth-kicker {
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #ECFDF3;
  color: #16823A;
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 900;
}

.final-growth-title {
  display: block;
  margin-top: 14rpx;
  font-size: 31rpx;
  color: #18233A;
  line-height: 1.3;
  font-weight: 900;
}

.final-growth-desc {
  display: block;
  margin-top: 7rpx;
  font-size: 23rpx;
  color: #617089;
  line-height: 1.45;
}

.reward-card {
  width: 100%;
  margin: 8rpx 0 30rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #FFEEC7 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.reward-title {
  display: block;
  font-size: 25rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.35;
}

.reward-desc {
  display: block;
  margin-top: 7rpx;
  font-size: 24rpx;
  color: #8A6425;
  line-height: 1.45;
}

.finish-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 92rpx;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.finish-btn::after { border: none; }
.finish-btn:active { opacity: 0.92; transform: scale(0.98); }

.group-answers {
  width: 100%;
  margin: 24rpx 0 32rpx;
}

.ga-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: rgba(255,255,255,0.92);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
}

.ga-item.ga-correct {
  background: #ECFDF3;
  border-color: rgba(34, 197, 94, 0.18);
}

.ga-item.ga-wrong {
  background: #FFF1F2;
  border-color: rgba(239, 68, 68, 0.16);
}

.ga-status {
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  text-align: center;
  line-height: 38rpx;
  font-size: 24rpx;
  font-weight: 900;
  flex-shrink: 0;
  margin-top: 3rpx;
}

.ga-correct .ga-status {
  background: #22C55E;
  color: #FFFFFF;
}

.ga-wrong .ga-status {
  background: #EF4444;
  color: #FFFFFF;
}

.ga-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.ga-stem {
  font-size: 24rpx;
  color: #18233A;
  line-height: 1.5;
}

.ga-answer {
  font-size: 22rpx;
  color: #617089;
  line-height: 1.4;
}

.result-btn {
  margin: 0;
  width: 100%;
}

/* ==================== 已掌握确认弹窗 ==================== */
.master-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(23, 32, 51, 0.46);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.master-dialog {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(23, 32, 51, 0.16);
}

.master-dialog-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #18233A;
  margin-bottom: 12rpx;
}

.master-dialog-desc {
  font-size: 26rpx;
  color: #617089;
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.master-dialog-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.master-btn-cancel,
.master-btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.master-btn-cancel {
  background: #E8F0FF;
  color: #4F7FFF;
}

.master-btn-confirm {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #FFFFFF;
}

.master-btn-cancel::after,
.master-btn-confirm::after { border: none; }

.master-btn-cancel:active,
.master-btn-confirm:active { opacity: 0.9; transform: scale(0.97); }

/* ==================== 完成反馈 ==================== */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: celeb-fade-in 0.28s ease both;
}

.celeb-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: radial-gradient(circle at 50% 34%, rgba(79, 127, 255, 0.28), rgba(11, 17, 33, 0.92) 58%);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.celebration-final .celeb-bg {
  background: radial-gradient(circle at 50% 28%, rgba(245, 158, 11, 0.28), rgba(79, 127, 255, 0.2) 36%, rgba(11, 17, 33, 0.94) 66%);
}

.celeb-content {
  position: relative;
  z-index: 2;
  width: 620rpx;
  padding: 60rpx 40rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(160deg, rgba(79, 127, 255, 0.28), rgba(34, 197, 94, 0.12));
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.24);
  overflow: hidden;
}

.celebration-final .celeb-content {
  background: linear-gradient(160deg, rgba(255, 247, 232, 0.18), rgba(79, 127, 255, 0.28), rgba(34, 197, 94, 0.1));
}

.celeb-badge-halo {
  position: absolute;
  top: 34rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(110, 193, 255, 0.32) 0%, rgba(110, 193, 255, 0) 68%);
  animation: celeb-halo 1.8s ease-in-out infinite;
}

.celebration-final .celeb-badge-halo {
  background: radial-gradient(circle, rgba(245, 158, 11, 0.38) 0%, rgba(245, 158, 11, 0) 68%);
}

.celeb-check-wrap {
  width: 154rpx;
  height: 154rpx;
  border-radius: 999rpx;
  background: rgba(79, 127, 255, 0.2);
  border: 4rpx solid rgba(110, 193, 255, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
  animation: celeb-check 0.72s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.celebration-final .celeb-check-wrap {
  background: linear-gradient(145deg, rgba(245, 158, 11, 0.36), rgba(34, 197, 94, 0.22));
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 44rpx rgba(245, 158, 11, 0.28);
}

.celeb-check {
  font-size: 66rpx;
  color: #FFFFFF;
  font-weight: 900;
}

.celeb-progress {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  font-weight: 800;
  animation: celeb-text-in 0.5s ease 0.1s both;
}

.celeb-title {
  margin-top: 18rpx;
  font-size: 40rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.25;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.16s both;
}

.celeb-detail {
  margin-top: 14rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.45;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.24s both;
}

.celeb-reward {
  margin-top: 20rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 10rpx;
  animation: reward-pop 0.58s cubic-bezier(0.34, 1.56, 0.64, 1) 0.32s both;
}

.reward-spark {
  color: #FCD34D;
  font-size: 26rpx;
  animation: spark-pulse 0.9s ease-in-out infinite;
}

.celeb-motto {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.68);
  line-height: 1.5;
  text-align: center;
  animation: celeb-text-in 0.5s ease 0.4s both;
}

.celeb-tap-hint {
  margin-top: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  animation: celeb-text-in 0.5s ease 0.48s both;
}

.firework-container,
.particle-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.firework {
  position: absolute;
  width: 150rpx;
  height: 150rpx;
  border-radius: 999rpx;
  opacity: 0;
  background: repeating-conic-gradient(from 0deg, transparent 0deg 13deg, rgba(255,255,255,0.9) 14deg 16deg, transparent 17deg 30deg);
  mask: radial-gradient(circle, transparent 0 42rpx, #000 44rpx 48rpx, transparent 50rpx);
  -webkit-mask: radial-gradient(circle, transparent 0 42rpx, #000 44rpx 48rpx, transparent 50rpx);
}

.f1 { left: 66rpx; top: 180rpx; animation: firework-burst 1.5s ease-out 0.06s infinite; }
.f2 { right: 58rpx; top: 132rpx; animation: firework-burst 1.5s ease-out 0.28s infinite; }
.f3 { left: 50%; bottom: 150rpx; margin-left: -75rpx; animation: firework-burst 1.5s ease-out 0.5s infinite; }

.particle {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  top: 50%;
  left: 50%;
  margin-top: -7rpx;
  margin-left: -7rpx;
}

.p1 { background: #6EC1FF; animation: p1 1.6s ease-out 0s forwards; }
.p2 { background: #4F7FFF; animation: p2 1.6s ease-out 0.08s forwards; }
.p3 { background: #F59E0B; animation: p3 1.6s ease-out 0.16s forwards; }
.p4 { background: #22C55E; animation: p4 1.6s ease-out 0.24s forwards; }
.p5 { background: #EF4444; animation: p5 1.6s ease-out 0.32s forwards; }
.p6 { background: #8B5CF6; animation: p6 1.6s ease-out 0.4s forwards; }
.p7 { background: #FCD34D; animation: p7 1.6s ease-out 0.12s forwards; }
.p8 { background: #FFFFFF; animation: p8 1.6s ease-out 0.2s forwards; }
.p9 { background: #A7F3D0; animation: p9 1.6s ease-out 0.28s forwards; }
.p10 { background: #BFDBFE; animation: p10 1.6s ease-out 0.36s forwards; }

@keyframes celeb-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes celeb-check {
  0% { transform: scale(0) rotate(-18deg); opacity: 0; }
  55% { transform: scale(1.14) rotate(5deg); opacity: 1; }
  78% { transform: scale(0.96) rotate(-2deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes celeb-halo {
  0%, 100% { transform: scale(0.92); opacity: 0.58; }
  50% { transform: scale(1.12); opacity: 0.9; }
}

@keyframes celeb-text-in {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes reward-pop {
  from { opacity: 0; transform: translateY(20rpx) scale(0.86); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes spark-pulse {
  0%, 100% { transform: scale(1) rotate(0deg); }
  50% { transform: scale(1.28) rotate(16deg); }
}

@keyframes firework-burst {
  0% { transform: scale(0.1) rotate(0deg); opacity: 0; }
  35% { opacity: 0.85; }
  100% { transform: scale(1.2) rotate(24deg); opacity: 0; }
}

@keyframes p1 { to { transform: translate(-250rpx, -300rpx) scale(0); opacity: 0; } }
@keyframes p2 { to { transform: translate(250rpx, -280rpx) scale(0); opacity: 0; } }
@keyframes p3 { to { transform: translate(-300rpx, 20rpx) scale(0); opacity: 0; } }
@keyframes p4 { to { transform: translate(300rpx, 48rpx) scale(0); opacity: 0; } }
@keyframes p5 { to { transform: translate(-170rpx, 300rpx) scale(0); opacity: 0; } }
@keyframes p6 { to { transform: translate(170rpx, 300rpx) scale(0); opacity: 0; } }
@keyframes p7 { to { transform: translate(-42rpx, -340rpx) scale(0); opacity: 0; } }
@keyframes p8 { to { transform: translate(42rpx, 340rpx) scale(0); opacity: 0; } }
@keyframes p9 { to { transform: translate(-320rpx, -140rpx) scale(0); opacity: 0; } }
@keyframes p10 { to { transform: translate(320rpx, -120rpx) scale(0); opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .group-reward-strip,
  .group-progress-fill,
  .animation-fade-in,
  .loading-spinner,
  .question-card,
  .question-card.slide-in,
  .master-overlay,
  .celebration-overlay,
  .celeb-badge-halo,
  .celeb-check-wrap,
  .celeb-progress,
  .celeb-title,
  .celeb-detail,
  .celeb-reward,
  .reward-spark,
  .celeb-motto,
  .celeb-tap-hint,
  .firework,
  .particle {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
