@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #EEF5FF;
  background-color: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  background-color: #EEF5FF;
  padding: 24rpx 0 48rpx;
  overflow-x: hidden;
  animation: none;
}

.review-hero { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.mission-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.04s both; }
.question-card { animation: card-enter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) 0.08s both; }

.animation-fade-in {
  animation: fadeSlideIn 0.58s ease-out;
  transform: translateZ(0);
}

/* ==================== 通用 ==================== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}

.loading-spinner {
  width: 54rpx;
  height: 54rpx;
  border: 5rpx solid #E2EAF7;
  border-top-color: #4F7FFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: #617089;
  margin-top: 18rpx;
  font-weight: 700;
}

/* ==================== 入口页 ==================== */
.entry-wrap {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.review-hero {
  margin: 0 24rpx 16rpx;
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 56%, #8AAFC8 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  position: relative;
  overflow: hidden;
}

.review-hero::before {
  content: '';
  position: absolute;
  left: -82rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24) 0%, transparent 70%);
}

.review-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -78rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.28) 0%, transparent 70%);
}

.hero-orbit {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.26);
  pointer-events: none;
}

.hero-orbit-one {
  width: 210rpx;
  height: 210rpx;
  right: 64rpx;
  top: -38rpx;
}

.hero-orbit-two {
  width: 128rpx;
  height: 128rpx;
  right: 106rpx;
  top: 2rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.28);
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

.ring-section {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.ring-container {
  position: relative;
  width: 164rpx;
  height: 164rpx;
}

.ring-bg,
.ring-fg {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-bg {
  background: rgba(255,255,255,0.24);
}

.ring-fg {
  background: conic-gradient(#22C55E 0deg, rgba(255,255,255,0.24) 0deg);
}

.ring-center {
  position: absolute;
  top: 22rpx;
  left: 22rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(42, 84, 160, 0.12);
}

.ring-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.ring-label {
  font-size: 19rpx;
  color: #617089;
  line-height: 1.35;
  margin-top: 4rpx;
  font-weight: 700;
}

.mission-card {
  margin: 0 24rpx 18rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.9);
  border: 1rpx solid rgba(255,255,255,0.72);
  box-shadow: 0 14rpx 38rpx rgba(79, 127, 255, 0.12);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.mission-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
}

.mission-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.mission-badge {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFF7E8, #FFE9B8);
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.motivation-text {
  display: block;
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
}

.glass-card {
  margin-top: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F7FAFF 0%, #FFFFFF 100%);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}

.glass-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.glass-num {
  font-size: 34rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.glass-num.warning { color: #F59E0B; }
.glass-num.success { color: #22C55E; }

.glass-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
}

.glass-divider {
  width: 1rpx;
  height: 52rpx;
  background: #E2EAF7;
  flex-shrink: 0;
}

.group-size-section {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.94);
  border: 1rpx solid rgba(226, 234, 247, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #18233A;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #617089;
}

.section-chip {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.size-options {
  display: flex;
  gap: 16rpx;
}

.size-chip {
  flex: 1;
  text-align: center;
  min-height: 76rpx;
  line-height: 76rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #617089;
  font-weight: 800;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.tap-scale,
.size-chip:active {
  transform: scale(0.97);
  opacity: 0.92;
}

.size-chip.active {
  background: linear-gradient(135deg, #E8F0FF, #F2F8FF);
  border-color: #4F7FFF;
  color: #4F7FFF;
  box-shadow: inset 0 0 0 1rpx rgba(79, 127, 255, 0.18);
}

.size-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8EA0BA;
  text-align: center;
}

.gradient-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 30rpx 24rpx 0;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  line-height: normal;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.gradient-btn::after { border: none; }
.gradient-btn:active { transform: scale(0.98); opacity: 0.92; }

.done-wrap {
  margin: 56rpx 24rpx 0;
  padding: 44rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 10rpx 30rpx rgba(42, 84, 160, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.done-check {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ECFDF3;
  color: #22C55E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.done-check-icon {
  width: 44rpx;
  height: 44rpx;
  color: #22C55E;
}

.done-check.mute {
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 38rpx;
}

.done-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.35;
}

.done-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #617089;
  line-height: 1.5;
  text-align: center;
}

/* ==================== 组结果页（数据优先） ==================== */
.result-page {
  background: #EEF5FF;
  min-height: 100vh;
  padding: 0;
}

.grp {
  padding: 24rpx;
}

.grp > view {
  margin-bottom: 18rpx;
}

.anim-grp-1 > view {
  animation: fadeSlideIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.anim-grp-1 > view:nth-child(1) { animation-delay: 0.02s; }
.anim-grp-1 > view:nth-child(2) { animation-delay: 0.06s; }
.anim-grp-1 > view:nth-child(3) { animation-delay: 0.1s; }

.grp-summary-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(42, 84, 160, 0.06);
  border: 1rpx solid #E2EAF7;
}

.grp-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.grp-group-tag {
  font-size: 24rpx;
  font-weight: 800;
  color: #4F7FFF;
  background: #EEF4FF;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

.grp-accuracy {
  text-align: right;
}

.grp-accuracy-value {
  font-size: 40rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.grp-accuracy-label {
  font-size: 20rpx;
  color: #8EA0BA;
  line-height: 1.35;
  margin-top: 4rpx;
}

.grp-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  background: #F7FAFF;
  border-radius: 18rpx;
  overflow: hidden;
}

.grp-summary-item {
  text-align: center;
  padding: 18rpx 4rpx;
  border-right: 1rpx solid #E2EAF7;
}
.grp-summary-item:last-child { border-right: none; }

.grp-summary-val {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.grp-summary-val.success { color: #22C55E; }
.grp-summary-val.danger { color: #EF4444; }
.grp-summary-val.muted { color: #8EA0BA; }

.grp-summary-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8EA0BA;
  line-height: 1.35;
}

.grp-schedule-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #E2EAF7;
  border-left: 6rpx solid #4F7FFF;
}

.grp-schedule-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  line-height: 1.3;
}

.grp-schedule-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.5;
}

.grp-detail-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #E2EAF7;
}

.grp-detail-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  margin-bottom: 16rpx;
}

.grp-detail-item {
  display: flex;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  background: #F7FAFF;
  border: 1rpx solid transparent;
  align-items: flex-start;
}

.grp-detail-item.grp-correct {
  background: #ECFDF3;
  border-color: rgba(34, 197, 94, 0.15);
}

.grp-detail-item.grp-wrong {
  background: #FEF2F2;
  border-color: rgba(239, 68, 68, 0.12);
}

.grp-detail-item.grp-skipped {
  background: #F6F9FF;
  border-color: rgba(142, 160, 186, 0.12);
}

.grp-detail-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-width: 50rpx;
  flex-shrink: 0;
}

.grp-detail-idx {
  font-size: 20rpx;
  font-weight: 700;
  color: #617089;
  font-variant-numeric: tabular-nums;
}

.grp-status-pill {
  font-size: 18rpx;
  font-weight: 700;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.grp-status-pill.correct { background: rgba(34, 197, 94, 0.15); color: #22C55E; }
.grp-status-pill.wrong { background: rgba(239, 68, 68, 0.15); color: #EF4444; }
.grp-status-pill.skipped { background: rgba(142, 160, 186, 0.15); color: #617089; }

.grp-detail-body {
  flex: 1;
  min-width: 0;
}

.grp-detail-stem {
  font-size: 24rpx;
  color: #18233A;
  line-height: 1.55;
}

.grp-detail-answer {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.4;
}

.grp-bottom-safe {
  height: 40rpx;
}

/* ==================== 已掌握确认弹窗 ==================== */
.master-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(23, 32, 51, 0.46);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.master-dialog {
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 20rpx 60rpx rgba(23, 32, 51, 0.16);
}

.master-dialog-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #18233A;
  margin-bottom: 12rpx;
}

.master-dialog-desc {
  font-size: 26rpx;
  color: #617089;
  text-align: center;
  margin-bottom: 36rpx;
  line-height: 1.5;
}

.master-dialog-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.master-btn-cancel,
.master-btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 80rpx;
}

.master-btn-cancel {
  background: #E8F0FF;
  color: #4F7FFF;
}

.master-btn-confirm {
  background: linear-gradient(135deg, #22C55E 0%, #16A34A 100%);
  color: #FFFFFF;
}

.master-btn-cancel::after,
.master-btn-confirm::after { border: none; }

.master-btn-cancel:active,
.master-btn-confirm:active { opacity: 0.9; transform: scale(0.97); }

@media (prefers-reduced-motion: reduce) {
  .animation-fade-in,
  .loading-spinner,
  .master-overlay,
  .grp > view {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* ==================== 最终结果页（蓝白数据化） ==================== */
.fr-page {
  min-height: 100vh;
  background: #EEF5FF;
  padding-bottom: 0;
}

.fr-wrap {
  padding: 24rpx 24rpx 180rpx;
}

.anim-fr > view {
  animation: fadeSlideIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
}
.anim-fr > view:nth-child(1) { animation-delay: 0.02s; }
.anim-fr > view:nth-child(2) { animation-delay: 0.06s; }
.anim-fr > view:nth-child(3) { animation-delay: 0.1s; }
.anim-fr > view:nth-child(4) { animation-delay: 0.14s; }

.fr-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 20rpx rgba(42, 84, 160, 0.06);
  border: 1rpx solid #E2EAF7;
}

/* — Summary — */
.fr-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 0;
}

.fr-accuracy-block {
  min-width: 160rpx;
}

.fr-accuracy-val {
  font-size: 56rpx;
  font-weight: 900;
  color: #4F7FFF;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.fr-summary.excellent .fr-accuracy-val { color: #22C55E; }
.fr-summary.good .fr-accuracy-val { color: #4F7FFF; }
.fr-summary.normal .fr-accuracy-val { color: #F59E0B; }
.fr-summary.weak .fr-accuracy-val { color: #EF4444; }

.fr-accuracy-unit {
  font-size: 24rpx;
  font-weight: 700;
  margin-left: 2rpx;
  opacity: 0.6;
}

.fr-accuracy-lbl {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8EA0BA;
  line-height: 1.3;
}

.fr-status-block {
  text-align: right;
}

.fr-status-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.3;
}

.fr-status-tag.excellent { background: #ECFDF3; color: #22C55E; }
.fr-status-tag.good { background: #EEF4FF; color: #4F7FFF; }
.fr-status-tag.normal { background: #FFF7E8; color: #F59E0B; }
.fr-status-tag.weak { background: #FEF2F2; color: #EF4444; }
.fr-status-tag.empty { background: #F6F9FF; color: #8EA0BA; }

.fr-status-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.4;
}

.fr-divider {
  height: 1rpx;
  background: #E2EAF7;
  margin: 18rpx 0;
}

.fr-grid-2x3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.fr-cell {
  text-align: center;
  padding: 12rpx 4rpx;
  background: #F7FAFF;
  border-radius: 16rpx;
}

.fr-cell-val {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.fr-cell-val.success { color: #22C55E; }
.fr-cell-val.danger { color: #EF4444; }

.fr-cell-lbl {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8EA0BA;
  line-height: 1.3;
}

/* — Progress — */
.fr-progress-card {
  padding: 20rpx 24rpx;
}

.fr-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.fr-progress-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
}

.fr-progress-pct {
  font-size: 26rpx;
  font-weight: 900;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
}

.fr-bar-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: #E2EAF7;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.fr-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF, #22C55E);
  transition: width 0.5s ease;
}

.fr-progress-sub {
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.fr-progress-sub.success { color: #22C55E; }

.fr-progress-em {
  font-weight: 800;
  color: #EF4444;
}

/* — Weakness — */
.fr-weak-card {
  border-left: 6rpx solid #EF4444;
}

.fr-weak-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.fr-weak-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
}

.fr-weak-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #EF4444;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #FEF2F2;
}

.fr-weak-desc {
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.fr-weak-subjects {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.fr-weak-subject-item {
  font-size: 20rpx;
  color: #617089;
  background: #F7FAFF;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.3;
}

/* — Advice — */
.fr-advice {
  border-left: 6rpx solid #4F7FFF;
}

.fr-advice.continue { border-left-color: #22C55E; }
.fr-advice.review { border-left-color: #F59E0B; }
.fr-advice.start { border-left-color: #4F7FFF; }

.fr-advice-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.fr-advice-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #18233A;
  line-height: 1.3;
}

.fr-advice-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  line-height: 1.3;
  flex-shrink: 0;
}

.fr-advice-tag.continue { background: #ECFDF3; color: #22C55E; }
.fr-advice-tag.review { background: #FFF7E8; color: #F59E0B; }
.fr-advice-tag.start { background: #EEF4FF; color: #4F7FFF; }

.fr-advice-desc {
  font-size: 23rpx;
  color: #617089;
  line-height: 1.5;
}

.fr-bottom-safe {
  height: 40rpx;
}

.fr-bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border-top: 1rpx solid #E2EAF7;
  display: flex;
  gap: 14rpx;
  z-index: 20;
}

.fr-action-primary {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #4F7FFF;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: normal;
}
.fr-action-primary:active { opacity: 0.9; transform: scale(0.97); }

.fr-action-secondary {
  width: 180rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #EEF4FF;
  color: #4F7FFF;
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: normal;
}
.fr-action-secondary:active { opacity: 0.85; }

.fr-action-primary::after,
.fr-action-secondary::after { border: none; }

@media (prefers-reduced-motion: reduce) {
  .anim-fr > view {
    animation: none !important;
  }
  .fr-bar-fill {
    transition: none !important;
  }
}

/* ==================== Code block ==================== */
.code-wrapper {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin: 16rpx 0 28rpx;
  overflow: hidden;
}
.code-text {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  white-space: pre;
  font-family: 'Courier New', Courier, monospace;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A2E;
}

/* ==================== 垂直居中修复：按钮和胶囊标签 ==================== */
.submit-group-btn {
  line-height: normal;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.size-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: normal;
}

.mission-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  line-height: 1;
  box-sizing: border-box;
}

.section-chip,
.group-meta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  line-height: 1;
  box-sizing: border-box;
}

.subject-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 15rpx;
  line-height: 1;
  box-sizing: border-box;
}

.blank-group-title {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  line-height: 1;
  box-sizing: border-box;
}

.master-btn-cancel,
.master-btn-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 20rpx;
  line-height: normal;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}

/* Mixed mode blocks */
.mixed-text-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-latex-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-code-block {
  margin: 16rpx 0 28rpx;
}


/* ==================== 概览页（蓝白任务式） ==================== */

.page-blue-white {
  padding: 24rpx;
}

.today-review-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 18rpx;
