  border: 1rpx solid #E2EAF7;
}

.today-review-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.today-review-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #4F7FFF;
  line-height: 1.3;
  letter-spacing: 2rpx;
}

.today-review-count-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 10rpx;
}

.today-review-count {
  font-size: 72rpx;
  font-weight: 900;
  color: #18233A;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.today-review-unit {
  font-size: 28rpx;
  font-weight: 700;
  color: #617089;
}

.today-review-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8EA0BA;
  line-height: 1.4;
}

.today-progress-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
}

.today-progress-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #E2EAF7;
  overflow: hidden;
}

.today-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF, #6EC1FF);
