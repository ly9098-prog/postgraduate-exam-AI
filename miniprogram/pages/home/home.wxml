<view class="card progress-card">
  <view class="progress-top">
    <view class="greeting-block">
      <text class="greeting">{{greeting}}，{{user.nickname || '考研人'}}</text>
      <text class="greeting-subtitle">保持节奏，今天也稳步前进</text>
    </view>
    <text class="date-text">{{dateStr}}</text>
  </view>
  <view class="progress-stats">
    <view class="pstat-item">
      <text class="pstat-num">{{wrongStats.total || 0}}</text>
      <text class="pstat-label">错题总数</text>
    </view>
    <view class="pstat-divider"></view>
    <view class="pstat-item" bindtap="goReview">
      <text class="pstat-num accent">待复习</text>
      <text class="pstat-label">点击开始 →</text>
    </view>
  </view>
</view>

<view class="action-grid">
  <view class="action-card" bindtap="startRandom">
    <view class="icon-badge icon-primary">练</view>
    <view class="action-info">
      <text class="action-title">随机刷题</text>
      <text class="action-desc">开始一组练习</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
  <view class="action-card" bindtap="goWrongBook">
    <view class="icon-badge icon-warning">错</view>
    <view class="action-info">
      <text class="action-title">错题本</text>
      <text class="action-desc">全部错题 · 按条件筛选</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
  <view class="action-card" bindtap="goReview">
    <view class="icon-badge icon-success">复</view>
    <view class="action-info">
      <text class="action-title">今日复习</text>
      <text class="action-desc">SM-2 到期错题 · 科学排期</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
  <view class="action-card" bindtap="goDashboard">
    <view class="icon-badge icon-muted">数</view>
    <view class="action-info">
      <text class="action-title">学习统计</text>
      <text class="action-desc">正确率 · 学科分布 · 趋势</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
  <view class="action-card" bindtap="goPomodoro">
    <view class="icon-badge icon-warning">钟</view>
    <view class="action-info">
      <text class="action-title">番茄钟</text>
      <text class="action-desc">专注计时 · 学习节奏管理</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
  <view class="action-card" bindtap="goImport" wx:if="{{isAdmin}}">
    <view class="icon-badge icon-success">导</view>
    <view class="action-info">
      <text class="action-title">题库导入</text>
      <text class="action-desc">拍照 / 文件上传导题</text>
    </view>
    <text class="action-arrow">›</text>
  </view>
</view>
