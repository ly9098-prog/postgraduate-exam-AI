<app-dialog id="appDialog" theme="mint"></app-dialog>
<view class="home-page" bindtap="dismissLoginGuideFromPage">
  <!-- Custom brand navigation -->
  <view class="home-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="home-nav-inner" style="height: {{navContentHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="brand-lockup">
        <view class="brand-mark">
          <view class="brand-mark-line line-one"></view>
          <view class="brand-mark-line line-two"></view>
          <view class="brand-mark-dot"></view>
        </view>
        <view class="brand-copy">
          <text class="brand-name">MEMOGRAD</text>
          <text class="brand-caption">STUDY DESK</text>
        </view>
      </view>
      <view class="profile-entry">
        <view id="home-profile-chip" class="profile-chip" bindtap="openProfileSheet" hover-class="profile-chip-pressed" aria-role="button" aria-label="{{guestMode ? '登录' : '编辑个人资料'}}" aria-expanded="{{guestMode && showLoginGuide}}" aria-controls="home-login-guide">
          <image wx:if="{{user.avatar_url || user.avatarUrl || user.avatar}}" class="profile-avatar profile-avatar-image" src="{{user.avatar_url || user.avatarUrl || user.avatar}}" mode="aspectFill" />
          <view wx:else class="profile-avatar">{{userInitial}}</view>
          <text class="profile-level">{{guestMode ? '游客' : studyLevel}}</text>
        </view>
        <view wx:if="{{guestMode && showLoginGuide}}" id="home-login-guide" class="login-guide {{loginGuideReady ? '' : 'login-guide-pending'}}" style="left: {{loginGuideLeft}}px;" catchtap="noop" aria-role="group" aria-label="登录引导" aria-hidden="{{!loginGuideReady}}">
          <view class="login-guide-arrow" style="left: {{loginGuideArrowLeft}}px;" aria-hidden="true"></view>
          <view class="login-guide-content">
            <text class="login-guide-title">登录后保存学习记录</text>
            <button class="login-guide-action" size="mini" style="display: flex; font-size: 12px; line-height: 20px;" catchtap="openLoginGuide" hover-class="login-guide-control-pressed"><text class="login-guide-action-label">立即登录</text><view class="login-guide-action-arrow" aria-hidden="true"></view></button>
          </view>
          <button class="login-guide-close" size="mini" catchtap="closeLoginGuide" hover-class="login-guide-control-pressed" aria-label="关闭登录引导，不再提示">
            <view class="line-icon icon-close" aria-hidden="true"></view>
          </button>
        </view>
      </view>
    </view>
  </view>

  <!-- Editorial greeting -->
  <view class="editorial-head page-enter">
    <text class="editorial-date">{{dateStr}}</text>
    <view class="editorial-title-row">
      <text class="editorial-title">{{greeting}}，{{displayName}}</text>
      <view class="editorial-rule"></view>
    </view>
    <text class="editorial-subtitle">今天，先完成最该做的事。</text>
  </view>

  <!-- Top study card rebuilt to match the supplied reference composition -->
  <view class="focus-card page-enter delay-one">
    <image class="focus-bg-art" src="/assets/icons/home-hero/top-card-background-cropped.png" mode="scaleToFill" />
    <view class="focus-bg-wash" aria-hidden="true"></view>
    <view class="focus-hero-visual" aria-hidden="true">
      <image class="focus-curve-image" src="/assets/icons/home-hero/smart-study-curve.png" mode="aspectFit" />
    </view>

    <view class="focus-content {{guestMode ? 'focus-content-guest' : ''}}">
      <view class="focus-topline">
        <view class="focus-status focus-status-light">
          <image class="focus-kicker-icon" src="/assets/icons/home-hero/smart-study-leaf.png" mode="aspectFit" />
          <text>{{primaryTaskKicker}}</text>
        </view>
        <view wx:if="{{!guestMode}}" class="focus-plan-anchor" bindtap="goStudyPlan" hover-class="soft-pressed" aria-role="button" aria-label="查看学习目标">
          <text class="focus-plan-anchor-label">目标</text>
        </view>
      </view>

      <view class="focus-title-line">
        <text class="focus-title">{{primaryTaskTitle}}</text>
      </view>
      <text class="focus-desc">{{primaryTaskDesc}}</text>

      <view wx:if="{{!guestMode}}" class="progress-head">
        <view class="progress-head-copy">
          <text class="progress-label">今日刷题进度</text>
          <text class="progress-head-sub">目标题量 {{todayGoalTotal}} 题</text>
        </view>
        <view class="progress-pair">
          <text class="progress-value">{{_animGoalDone}} / {{todayGoalTotal}}</text>
        </view>
      </view>
      <view wx:if="{{!guestMode}}" class="focus-progress-track">
        <view class="focus-progress-fill" style="width: {{_animLevelProgress}}%;"></view>
      </view>
      <view wx:if="{{!guestMode}}" class="progress-foot">
        <text>{{missionText}}</text>
        <text>{{_animLevelProgress}}%</text>
      </view>
      <text wx:else class="focus-guest-hint">{{missionText}}</text>

      <view class="focus-actions">
        <view class="primary-action" bindtap="startPrimaryTask" hover-class="primary-action-pressed">
          <text>{{primaryTaskAction}}</text>
          <view class="primary-action-arrow">↗</view>
        </view>
        <view wx:if="{{!guestMode}}" class="secondary-action" bindtap="startSecondaryTask" hover-class="secondary-action-pressed">
          <text>查看学习报告</text>
          <image class="secondary-action-icon" src="/assets/icons/home-hero/study-report.png" mode="aspectFit" />
        </view>
        <view wx:else class="secondary-action is-locked" aria-disabled="true">
          <text>学习报告</text><image class="ui-lock" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
        </view>
      </view>

      <view wx:if="{{!guestMode}}" class="focus-metrics">
        <view class="metric-item">
          <text class="metric-value">{{dueReviewCount}}</text>
          <text class="metric-label">到期复习</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item">
          <text class="metric-value">{{_animStreakDays}}</text>
          <text class="metric-label">连续天数</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item metric-level">
          <text class="metric-value level-value">{{studyLevel}}</text>
          <text class="metric-label">当前阶段</text>
        </view>
      </view>
    </view>
  </view>


  <!-- Smart Study Hub tasks -->
  <view class="content-section page-enter delay-two">
    <view class="section-heading">
      <view>
        <text class="section-kicker">SMART STUDY HUB</text>
        <text class="section-title">今日学习</text>
      </view>
      <view class="section-quick-action" bindtap="startRandom" hover-class="section-quick-action-pressed" aria-role="button" aria-label="进入随机练习">
        <image class="section-quick-icon" src="/assets/icons/home-actions/shuffle.svg" mode="aspectFit" />
        <text>随机练习</text><text class="section-quick-arrow">›</text>
      </view>
    </view>

    <view class="route-stack hub-task-stack" wx:if="{{studyHubAvailable}}">
      <view
        wx:for="{{hubTasks}}"
        wx:key="key"
        class="route-card hub-task-card hub-task-{{item.taskType}} {{item.completedToday ? 'hub-task-completed' : ''}}"
        data-task-key="{{item.key}}"
        bindtap="openHubTask"
        hover-class="card-pressed"
      >
        <view class="route-index hub-task-index"><image class="route-icon-image" src="{{item.iconSrc}}" mode="aspectFit" /></view>
        <view class="route-copy">
          <view class="hub-task-eyebrow-row">
            <text class="route-eyebrow">{{item.eyebrow}}</text>
            <text class="hub-task-meta">{{item.metaText}}</text>
          </view>
          <text class="route-title">{{item.title}}</text>
          <text class="route-desc">{{item.reason}}</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <!-- Wrong-book is a permanent Home tool, never hidden by recommendation availability. -->
      <view class="route-card route-wrong wrongbook-tool-card" bindtap="goWrongBook" hover-class="card-pressed">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/wrong-book.svg" mode="aspectFit" /></view>
        <view class="route-copy">
          <text class="route-eyebrow">常用工具</text>
          <text class="route-title">错题本</text>
          <text class="route-desc">聚焦错题，复盘反复出错的知识点</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <!-- Exam paper is also a permanent Home tool and must remain visible with Smart Study Hub recommendations. -->
      <view wx:if="{{!guestMode}}" class="route-card route-exam" bindtap="goExams" hover-class="card-pressed">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/list-checks.svg" mode="aspectFit" /></view>
        <view class="route-copy">
          <text class="route-eyebrow">套卷训练</text>
          <text class="route-title">选择题真题 / 模拟</text>
          <text class="route-desc">仅练适合手机作答的选择题，自动判分并生成四科复盘</text>
        </view>
        <view class="route-arrow">→</view>
      </view>
      <view wx:else class="route-card route-exam is-locked" aria-disabled="true">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/list-checks.svg" mode="aspectFit" /></view>
        <view class="route-copy"><text class="route-eyebrow">套卷训练</text><text class="route-title">选择题真题 / 模拟</text><text class="route-desc">登录后解锁正式套卷训练</text></view>
        <image class="ui-lock" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

    <view class="route-stack" wx:else>
      <view class="route-card route-review" bindtap="goReview" hover-class="card-pressed">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/refresh-cw.svg" mode="aspectFit" /></view>
        <view class="route-copy">
          <text class="route-eyebrow">记忆复习</text>
          <text class="route-title">今日复习</text>
          <text class="route-desc">{{guestMode ? '登录后查看个人复习计划' : (dueReviewCount > 0 ? dueReviewCount + ' 道错题正处于最佳复习窗口' : '暂无到期任务，也可以提前巩固')}}</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <view class="route-card route-wrong" bindtap="goWrongBook" hover-class="card-pressed">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/wrong-book.svg" mode="aspectFit" /></view>
        <view class="route-copy">
          <text class="route-eyebrow">薄弱项管理</text>
          <text class="route-title">错题本</text>
          <text class="route-desc">聚焦错题，复盘反复出错的知识点</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <view wx:if="{{!guestMode}}" class="route-card route-exam" bindtap="goExams" hover-class="card-pressed">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/list-checks.svg" mode="aspectFit" /></view>
        <view class="route-copy">
          <text class="route-eyebrow">套卷训练</text>
          <text class="route-title">选择题真题 / 模拟</text>
          <text class="route-desc">仅练适合手机作答的选择题，自动判分并生成四科复盘</text>
        </view>
        <view class="route-arrow">→</view>
      </view>
      <view wx:else class="route-card route-exam is-locked" aria-disabled="true">
        <view class="route-index"><image class="route-icon-image" src="/assets/icons/home-actions/list-checks.svg" mode="aspectFit" /></view>
        <view class="route-copy"><text class="route-eyebrow">套卷训练</text><text class="route-title">选择题真题 / 模拟</text><text class="route-desc">登录后解锁正式套卷训练</text></view>
        <image class="ui-lock" src="/assets/icons/lock.svg" mode="aspectFit" aria-hidden="true" />
      </view>
    </view>

  </view>

  <!-- Four-subject mastery snapshot · reference card layout -->
  <view class="content-section mastery-section page-enter delay-three" wx:if="{{subjectMastery.length > 0}}">
    <view class="section-heading compact-heading mastery-heading">
      <view class="mastery-heading-copy">
        <text class="section-kicker">MASTERY SNAPSHOT</text>
        <text class="section-title">四科掌握概览</text>
      </view>
    </view>

    <view class="mastery-grid mastery-grid-tech">
      <view wx:for="{{subjectMastery}}" wx:key="subjectCode" class="mastery-card mastery-card-tech {{item.hasData ? 'has-data' : 'no-data'}}" data-subject-id="{{item.subjectId}}" bindtap="openMasterySubject" hover-class="mastery-card-pressed">
        <view class="mastery-card-head">
          <view class="mastery-icon mastery-icon-{{item.iconClass}}">
            <image wx:if="{{item.iconSrc}}" class="mastery-icon-image" src="{{item.iconSrc}}" mode="aspectFit" />
            <text wx:else class="mastery-icon-fallback">{{item.mark}}</text>
          </view>
          <view class="mastery-more" aria-hidden="true"><view></view><view></view><view></view></view>
        </view>

        <view class="mastery-title-row">
          <text class="mastery-subject">{{item.subjectName}}</text>
          <text class="mastery-score {{item.hasData ? '' : 'is-empty'}}">{{item.scoreText}}</text>
        </view>

        <view class="mastery-track mastery-track-tech">
          <!-- Reference rail: independent hexagonal rail + independent hexagonal fill.
               Do not skew the entire rail; both ends use fixed chamfers like the design. -->
          <view class="mastery-hex-rail">
            <view
              wx:if="{{item.hasData && item.score > 0}}"
              class="mastery-hex-fill {{item.score >= 99 ? 'is-full' : ''}}"
              style="width: {{item.barWidth}}%;"
            >
              <view class="mastery-hex-gradient"></view>
              <view class="mastery-hex-stripes" aria-hidden="true">
                <view class="mastery-hex-stripe stripe-one"></view>
                <view class="mastery-hex-stripe stripe-two"></view>
                <view class="mastery-hex-stripe stripe-three"></view>
                <view class="mastery-hex-stripe stripe-four"></view>
                <view class="mastery-hex-stripe stripe-five"></view>
              </view>
              <view class="mastery-hex-toplight" aria-hidden="true"></view>
              <view class="mastery-hex-bottomshade" aria-hidden="true"></view>
            </view>
          </view>
        </view>

        <view class="mastery-foot mastery-foot-tech">
          <text class="mastery-status">{{item.statusText}}</text>
          <text class="mastery-sample-copy">{{item.questionStatText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Compact tool dock -->
  <view class="content-section tool-section page-enter delay-three">
    <view class="section-heading compact-heading">
      <view>
        <text class="section-kicker">TOOLS</text>
        <text class="section-title">学习工作台</text>
      </view>
      <text class="section-note">数据与效率</text>
    </view>

    <view class="tool-panel">
      <view class="tool-item" bindtap="goDashboard" hover-class="tool-pressed">
        <view class="tool-icon chart-icon">
          <view class="bar bar-a"></view><view class="bar bar-b"></view><view class="bar bar-c"></view>
        </view>
        <text class="tool-title">学习报告</text>
        <text class="tool-desc">趋势与薄弱项</text>
      </view>
      <view class="tool-divider"></view>
      <view class="tool-item" bindtap="goPomodoro" hover-class="tool-pressed">
        <view class="tool-icon clock-icon"><view class="clock-hand"></view></view>
        <text class="tool-title">专注计时</text>
        <text class="tool-desc">管理学习节奏</text>
      </view>
      <view class="tool-divider"></view>
      <view class="tool-item" bindtap="goFormulas" hover-class="tool-pressed">
        <view class="tool-icon formula-icon">∑</view>
        <text class="tool-title">速记</text>
        <text class="tool-desc">只展示有效学习内容</text>
      </view>
    </view>
  </view>

  <view class="growth-note page-enter delay-three">
    <view class="growth-note-copy">
      <text class="growth-note-label">TODAY'S NOTE</text>
      <text class="growth-note-text">{{dailyBoostText}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <view
    wx:if="{{showProfileSheet}}"
    class="profile-sheet-mask"
    bindtap="closeProfileSheet"
  >
    <view class="profile-sheet profile-minimal-sheet profile-native-sheet" catchtap="noop">
      <view class="profile-sheet-handle"></view>

      <view class="profile-sheet-head profile-minimal-head">
        <view class="profile-minimal-heading">
          <text class="profile-sheet-kicker">WECHAT PROFILE</text>
          <text class="profile-sheet-title">设置头像和昵称</text>
          <text class="profile-sheet-desc">仅在你主动设置时使用，修改后自动保存。</text>
        </view>
        <view class="profile-sheet-close" catchtap="closeProfileSheet" hover-class="profile-sheet-close-pressed" aria-label="关闭">×</view>
      </view>

      <view class="profile-native-grid">
        <view
          class="profile-native-card profile-native-avatar-card"
          bindtap="chooseProfileAvatar"
          hover-class="profile-native-card-pressed"
          hover-stay-time="90"
          role="button"
          aria-label="{{profileAvatarPreview ? '从相册更换头像' : '从相册选择头像'}}"
        >
          <view class="profile-native-icon profile-native-avatar-icon">
            <image
              wx:if="{{profileAvatarPreview}}"
              class="profile-native-avatar-image"
              src="{{profileAvatarPreview}}"
              mode="aspectFill"
            />
            <view wx:else class="profile-native-avatar-placeholder">
              <view class="profile-native-person-head"></view>
              <view class="profile-native-person-body"></view>
            </view>
            <view class="profile-native-avatar-badge">{{profileAvatarPreview ? '换' : '+'}}</view>
          </view>
          <text class="profile-native-title">{{profileAvatarPreview ? '更换头像' : '选择头像'}}</text>
          <text class="profile-native-subtitle">点击头像直接打开相册</text>
        </view>

        <view class="profile-native-divider" aria-hidden="true"></view>

        <view class="profile-native-card profile-native-nickname-card">
          <view class="profile-native-icon profile-native-nickname-icon">Aa</view>
          <text class="profile-native-title">{{profileNickname ? '更换微信昵称' : '选择微信昵称'}}</text>

          <input
            wx:if="{{!isDevtools}}"
            id="profileNicknameNativeInput"
            class="profile-native-nickname-input"
            type="nickname"
            name="nickname"
            placeholder="选择或输入昵称"
            placeholder-class="profile-native-nickname-placeholder"
            maxlength="32"
            adjust-position="true"
            cursor-spacing="16"
            bindinput="onProfileNicknameInput"
            bindchange="onProfileNicknameChange"
            bindblur="onProfileNicknameBlur"
            bindconfirm="onProfileNicknameConfirm"
            confirm-type="done"
          />

          <input
            wx:else
            id="profileNicknameNativeInput"
            class="profile-native-nickname-input"
            type="text"
            name="nickname"
            placeholder="输入昵称"
            placeholder-class="profile-native-nickname-placeholder"
            maxlength="32"
            adjust-position="true"
            cursor-spacing="16"
            bindinput="onProfileNicknameInput"
            bindchange="onProfileNicknameChange"
            bindblur="onProfileNicknameBlur"
            bindconfirm="onProfileNicknameConfirm"
            confirm-type="done"
          />

          <text class="profile-native-helper">
            {{isDevtools ? '开发者工具仅支持手动输入' : '点击输入框后可使用微信昵称或自定义'}}
          </text>
        </view>
      </view>

      <view class="profile-native-status {{profileSaving || profileSaveState === 'saving' ? 'is-saving' : ''}} {{profileSaveState === 'saved' ? 'is-saved' : ''}} {{profileSaveState === 'error' ? 'is-error' : ''}}">
        <view class="profile-native-status-dot"></view>
        <text wx:if="{{profileSaving || profileSaveState === 'saving'}}">正在保存…</text>
        <text wx:elif="{{profileSaveState === 'saved'}}">已保存，可继续修改</text>
        <text wx:elif="{{profileSaveState === 'error'}}">保存失败，请重试</text>
        <text wx:elif="{{profileAvatarPreview && profileNickname}}">资料已设置，点击任一项即可修改</text>
        <text wx:elif="{{profileAvatarPreview}}">头像已设置，选择昵称后自动保存</text>
        <text wx:elif="{{profileNickname}}">昵称已设置，选择头像后自动保存</text>
        <text wx:else>头像和昵称完成后自动保存</text>
      </view>
    </view>
  </view>

</view>
