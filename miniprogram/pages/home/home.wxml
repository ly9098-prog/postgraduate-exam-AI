<view class="home-page">
  <view class="welcome-section hero-panel motion-card-enter">
    <view class="welcome-glass"></view>
    <view class="welcome-content">
      <view class="welcome-greeting-row">
        <text class="welcome-greeting">{{greeting}}，</text>
        <text class="welcome-user" wx:if="{{user.nickName}}">{{user.nickName}}</text>
        <text class="welcome-user" wx:else>研友</text>
      </view>
      <view class="welcome-date">{{dateStr}}</view>
      <view class="welcome-quote">{{motto}}</view>

      <view class="growth-row">
        <view class="growth-pill">
          <text class="growth-num">{{_animStreakDays}}</text>
          <text class="growth-label">连续学习</text>
        </view>
        <view class="growth-pill level-pill">
          <text class="growth-num small">{{studyLevel}}</text>
          <text class="growth-label">当前等级</text>
        </view>
      </view>
    </view>
  </view>

  <view class="mission-card learning-card motion-card-enter motion-delay-1">
    <view class="mission-head">
      <view>
        <text class="mission-kicker">今日目标</text>
        <text class="mission-title">{{_animGoalDone}} / {{todayGoalTotal}} 题</text>
      </view>
      <view class="mission-side">
        <view class="mission-badge">{{badgeTitle}}</view>
        <view class="goal-config" bindtap="toggleGoalPicker">调整目标</view>
      </view>
    </view>
    <view class="goal-picker" wx:if="{{showGoalPicker}}">
      <view
        wx:for="{{goalOptions}}"
        wx:key="*this"
        class="goal-option {{item === todayGoalTotal ? 'goal-option-active' : ''}}"
        data-goal="{{item}}"
        bindtap="selectTodayGoal"
      >{{item}} 题</view>
    </view>
    <view class="mission-track">
      <view class="mission-fill" style="width:{{levelProgress}}%"></view>
    </view>
    <view class="mission-foot">
      <text>{{missionText}}</text>
      <text class="mission-percent">{{_animLevelProgress}}%</text>
    </view>
    <view class="exp-panel">
      <view class="exp-copy">
        <text class="exp-label">成长经验</text>
        <text class="exp-value">{{expText}}</text>
      </view>
      <text class="exp-next">{{nextLevelText}}</text>
    </view>
    <view class="daily-boost">{{dailyBoostText}}</view>
    <view class="badge-row">
      <view wx:for="{{badgeList}}" wx:key="key" class="badge-chip {{item.unlocked ? 'badge-unlocked' : ''}}">
        <text class="badge-dot"></text>
        <view class="badge-copy">
          <text class="badge-name">{{item.title}}</text>
          <text class="badge-desc">{{item.unlocked ? '已点亮' : item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="route-section">
    <view class="section-headline">
      <text class="section-title">开始今天的学习</text>
      <text class="section-subtitle">优先完成挑战和复习，成长值会更快提升</text>
    </view>
    <view class="primary-routes">
      <view class="route-card random" hover-class="route-pressed" bindtap="startRandom">
        <view class="route-orb"><text class="line-icon icon-book"></text></view>
        <text class="route-title">随机挑战</text>
        <text class="route-desc">挑战新的题目</text>
        <text class="route-cta">开始 →</text>
      </view>
      <view class="route-card review" hover-class="route-pressed" bindtap="goReview">
        <view class="route-orb"><text class="line-icon icon-review"></text></view>
        <text class="route-title">今日复习</text>
        <text class="route-desc">攻克到期错题</text>
        <text class="route-cta">复习 →</text>
      </view>
    </view>
  </view>

  <view class="action-grid">
    <view class="action-card learning-card" hover-class="active-surface" bindtap="goWrongBook">
      <view class="icon-badge icon-warning"><text class="line-icon icon-alert"></text></view>
      <view class="action-info">
        <text class="action-title">错题本</text>
        <text class="action-desc">全部错题 · 按条件筛选</text>
      </view>
      <text class="action-arrow line-icon icon-chevron-right"></text>
    </view>
    <view class="action-card learning-card" hover-class="active-surface" bindtap="goDashboard">
      <view class="icon-badge icon-muted"><text class="line-icon icon-chart"></text></view>
      <view class="action-info">
        <text class="action-title">学习统计</text>
        <text class="action-desc">正确率 · 学科分布 · 趋势</text>
      </view>
      <text class="action-arrow line-icon icon-chevron-right"></text>
    </view>
    <view class="action-card learning-card" hover-class="active-surface" bindtap="goPomodoro">
      <view class="icon-badge icon-warning"><text class="line-icon icon-clock"></text></view>
      <view class="action-info">
        <text class="action-title">番茄钟</text>
        <text class="action-desc">专注计时 · 学习节奏管理</text>
      </view>
      <text class="action-arrow line-icon icon-chevron-right"></text>
    </view>
    <view class="action-card learning-card" hover-class="active-surface" bindtap="goImport" wx:if="{{isAdmin}}">
      <view class="icon-badge icon-success"><text class="line-icon icon-import"></text></view>
      <view class="action-info">
        <text class="action-title">题库导入</text>
        <text class="action-desc">拍照 / 文件上传导题</text>
      </view>
      <text class="action-arrow line-icon icon-chevron-right"></text>
    </view>
  </view>
</view>
