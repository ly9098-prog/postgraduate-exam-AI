<view class="page-title">学习概览</view>

<!-- 学习进度卡片 -->
<view class="card progress-card">
  <view class="progress-top">
    <text class="greeting">{{greeting}}，{{user.nickname || '考研人'}}</text>
    <text class="date-text">{{dateStr}}</text>
  </view>
  <view class="progress-stats">
    <view class="pstat-item">
      <text class="pstat-num">{{wrongStats.total || 0}}</text>
      <text class="pstat-label">错题总</text>
    </view>
    <view class="pstat-divider"></view>
    <view class="pstat-item">
      <text class="pstat-num accent">{{wrongStats.unmastered || 0}}</text>
      <text class="pstat-label">待复习</text>
    </view>
    <view class="pstat-divider"></view>
    <view class="pstat-item">
      <text class="pstat-num">{{practiceCount || 0}}</text>
      <text class="pstat-label">练习次</text>
    </view>
  </view>
</view>

<!-- 快捷入口 -->
<view class="action-grid">
  <view class="action-card" bindtap="startRandom">
    <text class="action-emoji">✍️</text>
    <view class="action-info">
      <text class="action-title">随机刷题</text>
      <text class="action-desc">开始一组练习</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
  <view class="action-card" bindtap="goWrongBook">
    <text class="action-emoji">📖</text>
    <view class="action-info">
      <text class="action-title">错题本</text>
      <text class="action-desc">{{wrongStats.total || 0}} 道待 revisit</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
  <view class="action-card" bindtap="goReview">
    <text class="action-emoji">🔄</text>
    <view class="action-info">
      <text class="action-title">今日复习</text>
      <text class="action-desc">{{wrongStats.unmastered || 0}} 道待复习</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
  <view class="action-card" bindtap="goAnalysis">
    <text class="action-emoji">🤖</text>
    <view class="action-info">
      <text class="action-title">AI 分析</text>
      <text class="action-desc">错因与建议</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
  <view class="action-card" bindtap="goDashboard">
    <text class="action-emoji">📊</text>
    <view class="action-info">
      <text class="action-title">学习统计</text>
      <text class="action-desc">数据看板与分析</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
  <view class="action-card" bindtap="goImport">
    <text class="action-emoji">📥</text>
    <view class="action-info">
      <text class="action-title">题库导入</text>
      <text class="action-desc">Excel 批量导题</text>
    </view>
    <text class="action-arrow">→</text>
  </view>
</view>

<!-- 错题分布 -->
<view class="card" wx:if="{{wrongStats.by_subject && wrongStats.by_subject.length > 0}}">
  <text class="section-title">错题分布</text>
  <view class="subject-row" wx:for="{{wrongStats.by_subject}}" wx:key="subject">
    <text class="subject-name">{{subjectLabel(item.subject)}}</text>
    <view class="sbar-bg"><view class="sbar-fill" style="width:{{maxCount > 0 ? item.count / maxCount * 100 : 0}}%"></view></view>
    <text class="subject-val">{{item.count}}</text>
  </view>
</view>
