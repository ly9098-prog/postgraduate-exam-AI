<view class="home-page">
  <!-- Custom brand navigation -->
  <view class="home-nav" style="height: {{navHeight}}px; padding-top: {{statusBarHeight}}px;">
    <view class="home-nav-inner" style="height: {{navContentHeight}}px; padding-right: {{navRightPadding}}px;">
      <view class="brand-lockup">
        <view class="brand-mark">
          <view class="brand-mark-line line-one"></view>
          <view class="brand-mark-line line-two"></view>
          <view class="brand-mark-dot"></view>
        </view>
        <view class="brand-copy">
          <text class="brand-name">MEMOGRAD</text>
          <text class="brand-caption">STUDY DESK</text>
        </view>
      </view>
      <view class="profile-chip" bindtap="openProfileSheet" hover-class="profile-chip-pressed" aria-label="编辑个人资料">
        <image wx:if="{{user.avatar_url || user.avatarUrl || user.avatar}}" class="profile-avatar profile-avatar-image" src="{{user.avatar_url || user.avatarUrl || user.avatar}}" mode="aspectFill" />
        <view wx:else class="profile-avatar">{{userInitial}}</view>
        <text class="profile-level">{{studyLevel}}</text>
      </view>
    </view>
  </view>

  <!-- Editorial greeting -->
  <view class="editorial-head page-enter">
    <text class="editorial-date">{{dateStr}}</text>
    <view class="editorial-title-row">
      <text class="editorial-title">{{greeting}}，{{displayName}}</text>
      <view class="editorial-rule"></view>
    </view>
    <text class="editorial-subtitle">今天，先完成最该做的事。</text>
  </view>

  <!-- One clear answer to “what should I do today?” -->
  <view class="focus-card page-enter delay-one">
    <view class="focus-grid"></view>
    <view class="focus-glow"></view>
    <view class="focus-chart" aria-hidden="true">
      <view class="chart-line chart-line-a"></view>
      <view class="chart-line chart-line-b"></view>
      <view class="chart-line chart-line-c"></view>
      <view class="chart-node node-a"></view>
      <view class="chart-node node-b"></view>
      <view class="chart-node node-c"></view>
      <view class="chart-node node-d active"></view>
    </view>

    <view class="focus-content">
      <view class="focus-topline">
        <view class="focus-status">
          <view class="focus-status-dot"></view>
          <text>{{primaryTaskKicker}}</text>
        </view>
        <view class="goal-link" bindtap="toggleGoalPicker" hover-class="soft-pressed">目标 {{todayGoalTotal}} 题</view>
      </view>

      <text class="focus-title">{{primaryTaskTitle}}</text>
      <text class="focus-desc">{{primaryTaskDesc}}</text>

      <view class="progress-head">
        <text>今日进度</text>
        <text class="progress-value">{{_animGoalDone}} / {{todayGoalTotal}}</text>
      </view>
      <view class="focus-progress-track">
        <view class="focus-progress-fill" style="width: {{_animLevelProgress}}%;"></view>
      </view>
      <view class="progress-foot">
        <text>{{missionText}}</text>
        <text>{{_animLevelProgress}}%</text>
      </view>

      <view class="goal-picker" wx:if="{{showGoalPicker}}">
        <view
          wx:for="{{goalOptions}}"
          wx:key="*this"
          class="goal-option {{item === todayGoalTotal ? 'goal-option-active' : ''}}"
          data-goal="{{item}}"
          bindtap="selectTodayGoal"
        >{{item}} 题</view>
      </view>

      <view class="focus-actions">
        <view class="primary-action" bindtap="startPrimaryTask" hover-class="primary-action-pressed">
          <text>{{primaryTaskAction}}</text>
          <view class="primary-action-arrow">↗</view>
        </view>
        <view class="secondary-action" bindtap="startSecondaryTask" hover-class="secondary-action-pressed">{{secondaryTaskAction}}</view>
      </view>

      <view class="focus-metrics">
        <view class="metric-item">
          <text class="metric-value">{{dueReviewCount}}</text>
          <text class="metric-label">到期复习</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item">
          <text class="metric-value">{{_animStreakDays}}</text>
          <text class="metric-label">连续天数</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-item metric-level">
          <text class="metric-value level-value">{{studyLevel}}</text>
          <text class="metric-label">当前阶段</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Smart Study Hub tasks -->
  <view class="content-section page-enter delay-two">
    <view class="section-heading">
      <view>
        <text class="section-kicker">408 SMART STUDY HUB</text>
        <text class="section-title">408 今日学习</text>
      </view>
      <text class="section-note">{{studyHubAvailable ? '按优先级安排' : '四科专项'}}</text>
    </view>

    <view class="route-stack hub-task-stack" wx:if="{{studyHubAvailable && hubTasks.length > 0}}">
      <view
        wx:for="{{hubTasks}}"
        wx:key="key"
        class="route-card hub-task-card hub-task-{{item.taskType}}"
        data-task-key="{{item.key}}"
        bindtap="openHubTask"
        hover-class="card-pressed"
      >
        <view class="route-index hub-task-index">{{item.priorityText}}</view>
        <view class="route-copy">
          <view class="hub-task-eyebrow-row">
            <text class="route-eyebrow">{{item.eyebrow}}</text>
            <text class="hub-task-meta">{{item.metaText}}</text>
          </view>
          <text class="route-title">{{item.title}}</text>
          <text class="route-desc">{{item.reason}}</text>
        </view>
        <view class="route-arrow">→</view>
      </view>
    </view>

    <view class="route-stack" wx:else>
      <view class="route-card route-review" bindtap="goReview" hover-class="card-pressed">
        <view class="route-index">01</view>
        <view class="route-copy">
          <text class="route-eyebrow">记忆复习</text>
          <text class="route-title">408 今日复习</text>
          <text class="route-desc">{{dueReviewCount > 0 ? dueReviewCount + ' 道 408 错题正处于最佳复习窗口' : '暂无到期任务，也可以提前巩固'}}</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <view class="route-card route-practice" bindtap="startRandom" hover-class="card-pressed">
        <view class="route-index">02</view>
        <view class="route-copy">
          <text class="route-eyebrow">新题训练</text>
          <text class="route-title">408 随机练习</text>
          <text class="route-desc">从数据结构、计组、操作系统、计网中检查知识边界</text>
        </view>
        <view class="route-arrow">→</view>
      </view>

      <view class="route-card route-wrong" bindtap="goWrongBook" hover-class="card-pressed">
        <view class="route-index">03</view>
        <view class="route-copy">
          <text class="route-eyebrow">薄弱项管理</text>
          <text class="route-title">错题本</text>
          <text class="route-desc">聚焦 408 错题，复盘反复出错的知识点</text>
        </view>
        <view class="route-arrow">→</view>
      </view>
    </view>

    <view class="hub-quick-row" wx:if="{{studyHubAvailable}}">
      <view class="hub-quick-item" bindtap="goReview" hover-class="soft-pressed">今日复习</view>
      <view class="hub-quick-divider"></view>
      <view class="hub-quick-item" bindtap="goWrongBook" hover-class="soft-pressed">错题本</view>
      <view class="hub-quick-divider"></view>
      <view class="hub-quick-item" bindtap="startRandom" hover-class="soft-pressed">自由练习</view>
    </view>
  </view>

  <!-- Four-subject mastery snapshot -->
  <view class="content-section mastery-section page-enter delay-three" wx:if="{{studyHubAvailable && subjectMastery.length > 0}}">
    <view class="section-heading compact-heading">
      <view>
        <text class="section-kicker">408 MASTERY SNAPSHOT</text>
        <text class="section-title">四科掌握概览</text>
      </view>
      <text class="section-note">基于已练知识点</text>
    </view>
    <view class="mastery-grid">
      <view wx:for="{{subjectMastery}}" wx:key="subjectId" class="mastery-card">
        <view class="mastery-card-head">
          <text class="mastery-subject">{{item.subjectName}}</text>
          <text class="mastery-score {{item.hasData ? '' : 'is-empty'}}">{{item.scoreText}}</text>
        </view>
        <view class="mastery-track">
          <view class="mastery-fill" style="width: {{item.barWidth}}%;"></view>
        </view>
        <view class="mastery-foot">
          <text>{{item.statusText}}</text>
          <text>{{item.attemptCount > 0 ? '累计 ' + item.attemptCount + ' 次练习' : '完成练习后生成'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Compact tool dock -->
  <view class="content-section tool-section page-enter delay-three">
    <view class="section-heading compact-heading">
      <view>
        <text class="section-kicker">TOOLS</text>
        <text class="section-title">408 学习工作台</text>
      </view>
      <text class="section-note">数据与效率</text>
    </view>

    <view class="tool-panel">
      <view class="tool-item" bindtap="goDashboard" hover-class="tool-pressed">
        <view class="tool-icon chart-icon">
          <view class="bar bar-a"></view><view class="bar bar-b"></view><view class="bar bar-c"></view>
        </view>
        <text class="tool-title">408 学习报告</text>
        <text class="tool-desc">趋势与薄弱项</text>
      </view>
      <view class="tool-divider"></view>
      <view class="tool-item" bindtap="goPomodoro" hover-class="tool-pressed">
        <view class="tool-icon clock-icon"><view class="clock-hand"></view></view>
        <text class="tool-title">专注计时</text>
        <text class="tool-desc">管理学习节奏</text>
      </view>
      <view class="tool-divider"></view>
      <view class="tool-item" bindtap="goFormulas" hover-class="tool-pressed">
        <view class="tool-icon formula-icon">∑</view>
        <text class="tool-title">408 速记</text>
        <text class="tool-desc">只展示 408 有效内容</text>
      </view>
    </view>
  </view>

  <view class="growth-note page-enter delay-three">
    <view class="growth-note-line"></view>
    <view class="growth-note-copy">
      <text class="growth-note-label">TODAY'S NOTE</text>
      <text class="growth-note-text">{{dailyBoostText}}</text>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <view
    wx:if="{{showProfileSheet}}"
    class="profile-sheet-mask"
    bindtap="closeProfileSheet"
  >
    <view class="profile-sheet profile-minimal-sheet profile-native-sheet" catchtap="noop">
      <view class="profile-sheet-handle"></view>

      <view class="profile-sheet-head profile-minimal-head">
        <view class="profile-minimal-heading">
          <text class="profile-sheet-kicker">WECHAT PROFILE</text>
          <text class="profile-sheet-title">设置头像和昵称</text>
          <text class="profile-sheet-desc">仅在你主动设置时使用，修改后自动保存。</text>
        </view>
        <view class="profile-sheet-close" catchtap="closeProfileSheet" hover-class="profile-sheet-close-pressed" aria-label="关闭">×</view>
      </view>

      <view class="profile-native-grid">
        <view
          class="profile-native-card profile-native-avatar-card"
          bindtap="chooseProfileAvatar"
          hover-class="profile-native-card-pressed"
          hover-stay-time="90"
          role="button"
          aria-label="{{profileAvatarPreview ? '从相册更换头像' : '从相册选择头像'}}"
        >
          <view class="profile-native-icon profile-native-avatar-icon">
            <image
              wx:if="{{profileAvatarPreview}}"
              class="profile-native-avatar-image"
              src="{{profileAvatarPreview}}"
              mode="aspectFill"
            />
            <view wx:else class="profile-native-avatar-placeholder">
              <view class="profile-native-person-head"></view>
              <view class="profile-native-person-body"></view>
            </view>
            <view class="profile-native-avatar-badge">{{profileAvatarPreview ? '换' : '+'}}</view>
          </view>
          <text class="profile-native-title">{{profileAvatarPreview ? '更换头像' : '选择头像'}}</text>
          <text class="profile-native-subtitle">点击头像直接打开相册</text>
        </view>

        <view class="profile-native-divider" aria-hidden="true"></view>

        <view class="profile-native-card profile-native-nickname-card">
          <view class="profile-native-icon profile-native-nickname-icon">Aa</view>
          <text class="profile-native-title">{{profileNickname ? '更换微信昵称' : '选择微信昵称'}}</text>

          <input
            wx:if="{{!isDevtools}}"
            id="profileNicknameNativeInput"
            class="profile-native-nickname-input"
            type="nickname"
            name="nickname"
            placeholder="选择或输入昵称"
            placeholder-class="profile-native-nickname-placeholder"
            maxlength="32"
            adjust-position="true"
            cursor-spacing="16"
            bindinput="onProfileNicknameInput"
            bindchange="onProfileNicknameChange"
            bindblur="onProfileNicknameBlur"
            bindconfirm="onProfileNicknameConfirm"
            confirm-type="done"
          />

          <input
            wx:else
            id="profileNicknameNativeInput"
            class="profile-native-nickname-input"
            type="text"
            name="nickname"
            placeholder="输入昵称"
            placeholder-class="profile-native-nickname-placeholder"
            maxlength="32"
            adjust-position="true"
            cursor-spacing="16"
            bindinput="onProfileNicknameInput"
            bindchange="onProfileNicknameChange"
            bindblur="onProfileNicknameBlur"
            bindconfirm="onProfileNicknameConfirm"
            confirm-type="done"
          />

          <text class="profile-native-helper">
            {{isDevtools ? '开发者工具仅支持手动输入' : '点击输入框后可使用微信昵称或自定义'}}
          </text>
        </view>
      </view>

      <view class="profile-native-status {{profileSaving || profileSaveState === 'saving' ? 'is-saving' : ''}} {{profileSaveState === 'saved' ? 'is-saved' : ''}} {{profileSaveState === 'error' ? 'is-error' : ''}}">
        <view class="profile-native-status-dot"></view>
        <text wx:if="{{profileSaving || profileSaveState === 'saving'}}">正在保存…</text>
        <text wx:elif="{{profileSaveState === 'saved'}}">已保存，可继续修改</text>
        <text wx:elif="{{profileSaveState === 'error'}}">保存失败，请重试</text>
        <text wx:elif="{{profileAvatarPreview && profileNickname}}">资料已设置，点击任一项即可修改</text>
        <text wx:elif="{{profileAvatarPreview}}">头像已设置，选择昵称后自动保存</text>
        <text wx:elif="{{profileNickname}}">昵称已设置，选择头像后自动保存</text>
        <text wx:else>头像和昵称完成后自动保存</text>
      </view>
    </view>
  </view>

</view>
