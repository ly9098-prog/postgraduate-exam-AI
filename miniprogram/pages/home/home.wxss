@import '../../styles/tokens.wxss';

.home-page {
  min-height: 100vh;
  padding-bottom: 52rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  overflow-x: hidden;
}

.welcome-section {
  margin: 24rpx 24rpx 12rpx;
  position: relative;
}

.welcome-glass {
  position: absolute;
  inset: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  z-index: 1;
  pointer-events: none;
}

.welcome-section::before {
  content: '';
  position: absolute;
  top: -38%;
  right: -12%;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.24) 0%, transparent 70%);
  z-index: 0;
}

.welcome-section::after {
  content: '';
  position: absolute;
  bottom: -38%;
  left: -18%;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34,197,94,0.22) 0%, transparent 70%);
  z-index: 0;
}

.welcome-content {
  position: relative;
  z-index: 2;
  padding: 36rpx 30rpx 30rpx;
}

.welcome-greeting-row {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
}

.welcome-greeting {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.35;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.welcome-user {
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.94);
  line-height: 1.35;
  margin-left: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.welcome-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.76);
  margin-top: 12rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.welcome-quote {
  font-size: 27rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 14rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.growth-row {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.growth-pill {
  flex: 1;
  min-height: 104rpx;
  border-radius: 24rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.growth-num {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.growth-num.small {
  font-size: 29rpx;
}

.growth-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.78);
}

.mission-card {
  margin: -4rpx 24rpx 22rpx;
  padding: 28rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.mission-head,
.mission-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
}

.mission-title {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.mission-badge {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFF7E8, #FFE9B8);
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.mission-track {
  height: 16rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  overflow: hidden;
}

.mission-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 62%, #22C55E 100%);
  box-shadow: 0 0 20rpx rgba(79, 127, 255, 0.28);
  transition: width 0.32s ease-out;
}

.mission-foot {
  margin-top: 14rpx;
  color: #5D6B82;
  font-size: 24rpx;
  line-height: 1.4;
}

.mission-percent {
  color: #4F7FFF;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.route-section {
  padding: 0 24rpx;
}

.section-headline {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #617089;
  line-height: 1.45;
}

.primary-routes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.route-card {
  flex: 1;
  min-height: 218rpx;
  border-radius: 30rpx;
  padding: 24rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(43, 60, 80, 0.12);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.route-card.random {
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 100%);
}

.route-card.review {
  background: linear-gradient(145deg, #22C55E 0%, #8BC88B 100%);
}

.route-card::after {
  content: '';
  position: absolute;
  right: -42rpx;
  bottom: -48rpx;
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
}

.route-pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.route-orb {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.24);
  border: 1rpx solid rgba(255,255,255,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-title,
.route-desc,
.route-cta {
  display: block;
  position: relative;
  z-index: 1;
}

.route-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.route-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.4;
}

.route-cta {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.animation-fade-in {
  animation: fadeSlideIn 0.65s ease-out;
  transform: translateZ(0);
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.action-grid {
  padding: 0 24rpx;
  margin-top: 2rpx;
}

.action-card {
  min-height: 104rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  color: #18233A;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #617089;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F7FF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #4F7FFF;
  margin-left: 16rpx;
  flex-shrink: 0;
}

@media (prefers-reduced-motion: reduce) {
  .welcome-section::before,
  .welcome-section::after,
  .mission-fill,
  .route-card,
  .route-pressed {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
