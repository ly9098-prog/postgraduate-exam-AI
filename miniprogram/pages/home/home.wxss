@import '../../styles/tokens.wxss';

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 104rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.action-card:active {
  opacity: 0.88;
  background: #FAF9F6;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #6B7B8D;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F2EF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #9AABBA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

