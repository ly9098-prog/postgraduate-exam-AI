@import '../../styles/tokens.wxss';

.home-page {
  min-height: 100vh;
  padding-bottom: 52rpx;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  overflow-x: hidden;
}

.welcome-section {
  margin: 24rpx 24rpx 12rpx;
  position: relative;
}

.welcome-glass {
  position: absolute;
  inset: 0;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  z-index: 1;
  pointer-events: none;
}

.welcome-section::before {
  content: '';
  position: absolute;
  top: -38%;
  right: -12%;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.24) 0%, transparent 70%);
  z-index: 0;
}

.welcome-section::after {
  content: '';
  position: absolute;
  bottom: -38%;
  left: -18%;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34,197,94,0.22) 0%, transparent 70%);
  z-index: 0;
}

/* 装饰浮动粒子 */
.welcome-particle {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 1;
  animation: welcomeFloat 5s ease-in-out infinite;
}

.wp-1 {
  right: 40rpx;
  top: 22rpx;
  width: 14rpx;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.56);
  animation-delay: 0s;
}

.wp-2 {
  right: 72rpx;
  bottom: 56rpx;
  width: 10rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.42);
  animation-delay: 1.2s;
}

.wp-3 {
  left: 48rpx;
  bottom: 28rpx;
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.5);
  animation-delay: 2.5s;
}

.wp-4 {
  right: 36%;
  top: 46rpx;
  width: 6rpx;
  height: 6rpx;
  background: rgba(34, 197, 94, 0.42);
  animation-delay: 3.6s;
}

.welcome-content {
  position: relative;
  z-index: 2;
  padding: 36rpx 30rpx 30rpx;
}

.welcome-greeting-row {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
}

.welcome-greeting {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.35;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.welcome-user {
  font-size: 38rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.94);
  line-height: 1.35;
  margin-left: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
}

.welcome-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.76);
  margin-top: 12rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.welcome-quote {
  font-size: 27rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 14rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.growth-row {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.growth-pill {
  flex: 1;
  min-height: 104rpx;
  border-radius: 24rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.growth-num {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #FFFFFF;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.growth-num.small {
  font-size: 29rpx;
}

.growth-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,0.78);
}

.mission-card {
  margin: -4rpx 24rpx 22rpx;
  padding: 28rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.mission-head,
.mission-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 800;
  color: #4F7FFF;
  line-height: 1.3;
}

.mission-title {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.18;
  font-variant-numeric: tabular-nums;
}

.mission-badge {
  flex-shrink: 0;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFF7E8, #FFE9B8);
  color: #B87509;
  font-size: 22rpx;
  font-weight: 800;
}

.mission-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.goal-config {
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EEF5FF;
  color: #3157D5;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.goal-config:active { opacity: 0.82; }

.goal-picker {
  margin-top: 22rpx;
  padding: 14rpx;
  border-radius: 24rpx;
  background: #F6F9FF;
  display: flex;
  gap: 12rpx;
}

.goal-option {
  flex: 1;
  min-height: 58rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  color: #5D6B82;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
  box-shadow: inset 0 0 0 1rpx rgba(79, 127, 255, 0.08);
}

.goal-option-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  box-shadow: 0 8rpx 20rpx rgba(79, 127, 255, 0.22);
}

.mission-track {
  height: 16rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  overflow: hidden;
}

.mission-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 62%, #22C55E 100%);
  box-shadow: 0 0 20rpx rgba(79, 127, 255, 0.28);
  transition: width 0.32s ease-out;
}

.mission-foot {
  margin-top: 14rpx;
  color: #5D6B82;
  font-size: 24rpx;
  line-height: 1.4;
}

.mission-percent {
  color: #4F7FFF;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.exp-panel {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F8FBFF 0%, #EEF5FF 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.exp-copy {
  flex-shrink: 0;
}

.exp-label,
.exp-value,
.exp-next,
.daily-boost,
.badge-name,
.badge-desc {
  display: block;
}

.exp-label {
  color: #7B8AA8;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.exp-value {
  margin-top: 6rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.exp-next {
  flex: 1;
  min-width: 0;
  color: #617089;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: right;
}

.daily-boost {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #FFF7ED;
  color: #B87509;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.badge-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
}

.badge-chip {
  flex: 1;
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 22rpx;
  background: #F8FAFC;
  border: 1rpx solid #EEF4FF;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.badge-unlocked {
  background: #EAF8F0;
  border-color: rgba(34, 197, 94, 0.18);
}

.badge-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #C9D5E8;
  flex-shrink: 0;
}

.badge-unlocked .badge-dot {
  background: #22C55E;
  box-shadow: 0 0 14rpx rgba(34, 197, 94, 0.32);
}

.badge-copy {
  min-width: 0;
}

.badge-name {
  color: #172033;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-desc {
  margin-top: 4rpx;
  color: #7B8AA8;
  font-size: 18rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-section {
  padding: 0 24rpx;
}

.section-headline {
  margin-bottom: 16rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #617089;
  line-height: 1.45;
}

.primary-routes {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.route-card {
  flex: 1;
  min-height: 218rpx;
  border-radius: 30rpx;
  padding: 24rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-shadow: 0 14rpx 36rpx rgba(43, 60, 80, 0.12);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.route-card.random {
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 100%);
}

.route-card.review {
  background: linear-gradient(145deg, #22C55E 0%, #8BC88B 100%);
}

.route-card::after {
  content: '';
  position: absolute;
  right: -42rpx;
  bottom: -48rpx;
  width: 158rpx;
  height: 158rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
}

.route-pressed {
  transform: scale(0.97);
  opacity: 0.9;
}

.route-orb {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.24);
  border: 1rpx solid rgba(255,255,255,0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-title,
.route-desc,
.route-cta {
  display: block;
  position: relative;
  z-index: 1;
}

.route-title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.route-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255,255,255,0.82);
  line-height: 1.4;
}

.route-cta {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.animation-fade-in {
  animation: fadeSlideIn 0.65s ease-out;
  transform: translateZ(0);
}

.action-grid {
  padding: 0 24rpx;
  margin-top: 2rpx;
}

.action-card {
  min-height: 104rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
  color: #18233A;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #617089;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F7FF;
  color: #4F7FFF;
  margin-left: 16rpx;
  flex-shrink: 0;
}

@keyframes welcomeFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 1; }
  50% { transform: translateY(-18rpx) scale(1.15); opacity: 0.65; }
}

@media (prefers-reduced-motion: reduce) {
  .welcome-section::before,
  .welcome-section::after,
  .welcome-particle,
  .mission-fill,
  .goal-option,
  .route-card,
  .route-pressed {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}
