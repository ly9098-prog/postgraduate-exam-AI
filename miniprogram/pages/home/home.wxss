@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  background-color: #F4F4EE;
  color: #15231A;
}

.home-page {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 232, 42, .08), transparent 360rpx),
    linear-gradient(180deg, #F6F6F0 0%, #F1F2EC 100%);
}

/* Navigation */
.home-nav {
  width: 100%;
  box-sizing: border-box;
}

.home-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 28rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  background: #153323;
  box-shadow: 0 10rpx 24rpx rgba(21, 51, 35, .16);
}

.brand-mark-line {
  position: absolute;
  left: 12rpx;
  height: 4rpx;
  border-radius: 99rpx;
  background: #FFFFFF;
  transform-origin: left center;
}

.brand-mark-line.line-one {
  width: 25rpx;
  top: 31rpx;
  transform: rotate(-29deg);
}

.brand-mark-line.line-two {
  width: 18rpx;
  left: 28rpx;
  top: 18rpx;
  transform: rotate(24deg);
  background: #B7E82A;
}

.brand-mark-dot {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  right: 8rpx;
  top: 10rpx;
  border-radius: 50%;
  background: #B7E82A;
  box-shadow: 0 0 0 6rpx rgba(183, 232, 42, .12);
}

.brand-copy {
  min-width: 0;
  margin-left: 15rpx;
}

.brand-name,
.brand-caption {
  display: block;
  white-space: nowrap;
}

.brand-name {
  font-size: 25rpx;
  line-height: 1.05;
  font-weight: 950;
  letter-spacing: 1.4rpx;
  color: #142219;
}

.brand-caption {
  margin-top: 5rpx;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #849087;
}

.profile-chip {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 6rpx 12rpx 6rpx 7rpx;
  border: 1rpx solid #DDE2DA;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .58);
}

.profile-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #E2EDC7;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 950;
}

.profile-level {
  max-width: 116rpx;
  margin-left: 9rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #455249;
  font-size: 19rpx;
  font-weight: 850;
}

/* Header */
.editorial-head {
  padding: 28rpx 28rpx 26rpx;
}

.editorial-date,
.section-kicker,
.route-eyebrow,
.growth-note-label {
  display: block;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2.6rpx;
}

.editorial-date {
  color: #7A867D;
}

.editorial-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.editorial-title {
  flex-shrink: 0;
  max-width: 590rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #132118;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 950;
  letter-spacing: -1.2rpx;
}

.editorial-rule {
  flex: 1;
  height: 2rpx;
  min-width: 20rpx;
  background: #D5DAD2;
}

.editorial-subtitle {
  display: block;
  margin-top: 13rpx;
  color: #68756C;
  font-size: 26rpx;
  line-height: 1.5;
}

/* Main task */
.focus-card {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  background: linear-gradient(145deg, #183528 0%, #10251A 56%, #09170F 100%);
  box-shadow: 0 28rpx 68rpx rgba(16, 37, 26, .23);
}

.focus-grid {
  position: absolute;
  right: -64rpx;
  top: -48rpx;
  width: 380rpx;
  height: 300rpx;
  opacity: .045;
  transform: rotate(7deg);
  background-image:
    linear-gradient(#FFFFFF 1rpx, transparent 1rpx),
    linear-gradient(90deg, #FFFFFF 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
}

.focus-glow {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -170rpx;
  top: -170rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(183, 232, 42, .25), rgba(183, 232, 42, 0) 70%);
}

.focus-chart {
  position: absolute;
  right: 30rpx;
  top: 112rpx;
  width: 245rpx;
  height: 130rpx;
  opacity: .42;
  pointer-events: none;
}

.chart-line {
  position: absolute;
  height: 4rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .58);
  transform-origin: left center;
}

.chart-line-a { width: 70rpx; left: 0; top: 88rpx; transform: rotate(-22deg); }
.chart-line-b { width: 84rpx; left: 64rpx; top: 62rpx; transform: rotate(18deg); }
.chart-line-c { width: 88rpx; left: 142rpx; top: 88rpx; transform: rotate(-35deg); background: #B7E82A; }

.chart-node {
  position: absolute;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid rgba(255, 255, 255, .68);
  border-radius: 50%;
  background: #10251A;
  box-sizing: border-box;
}

.node-a { left: -2rpx; top: 82rpx; }
.node-b { left: 65rpx; top: 54rpx; }
.node-c { left: 142rpx; top: 81rpx; }
.node-d { right: 4rpx; top: 27rpx; }
.chart-node.active { border-color: #B7E82A; box-shadow: 0 0 0 13rpx rgba(183, 232, 42, .11); }

.focus-content {
  position: relative;
  z-index: 2;
  padding: 30rpx 28rpx 0;
}

.focus-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.focus-status {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #B7E82A;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.focus-status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #B7E82A;
  box-shadow: 0 0 0 8rpx rgba(183, 232, 42, .12);
}

.goal-link {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .065);
  color: rgba(255, 255, 255, .68);
  font-size: 20rpx;
  font-weight: 800;
}

.soft-pressed { opacity: .72; }

.focus-title,
.focus-desc {
  display: block;
  position: relative;
  max-width: 520rpx;
}

.focus-title {
  margin-top: 36rpx;
  color: #FFFFFF;
  font-size: 47rpx;
  line-height: 1.18;
  font-weight: 950;
  letter-spacing: -1rpx;
}

.focus-desc {
  margin-top: 16rpx;
  color: rgba(239, 245, 240, .68);
  font-size: 24rpx;
  line-height: 1.65;
}

.progress-head,
.progress-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-head {
  margin-top: 34rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 20rpx;
  font-weight: 750;
}

.progress-value {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.focus-progress-track {
  height: 14rpx;
  margin-top: 13rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .10);
}

.focus-progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8FB700 0%, #B7E82A 72%, #D6F681 100%);
  box-shadow: 0 0 22rpx rgba(183, 232, 42, .26);
  transition: width .32s ease-out;
}

.progress-foot {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .46);
  font-size: 19rpx;
  line-height: 1.4;
}

.progress-foot text:first-child {
  flex: 1;
  min-width: 0;
}

.progress-foot text:last-child {
  flex-shrink: 0;
  color: #B7E82A;
  font-weight: 900;
}

.goal-picker {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 11rpx;
  border: 1rpx solid rgba(255, 255, 255, .09);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .055);
}

.goal-option {
  flex: 1;
  min-height: 56rpx;
  border-radius: 16rpx;
  color: rgba(255, 255, 255, .56);
  font-size: 21rpx;
  font-weight: 850;
  line-height: 56rpx;
  text-align: center;
}

.goal-option-active {
  color: #10251A;
  background: #B7E82A;
}

.focus-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
}

.primary-action {
  flex: 1;
  min-height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border-radius: 24rpx;
  background: #B7E82A;
  color: #10251A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 950;
  box-shadow: 0 14rpx 30rpx rgba(104, 140, 0, .18);
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
  font-weight: 700;
}

.secondary-action {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .055);
  color: rgba(255, 255, 255, .78);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 850;
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-pressed,
.secondary-action-pressed {
  transform: scale(.98);
  opacity: .82;
}

.focus-metrics {
  display: flex;
  align-items: stretch;
  margin: 30rpx -28rpx 0;
  padding: 22rpx 28rpx 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
  background: rgba(255, 255, 255, .035);
}

.metric-item {
  flex: 1;
  min-width: 0;
}

.metric-item.metric-level { flex: 1.35; }

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #FFFFFF;
  font-size: 35rpx;
  line-height: 1.1;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.metric-value.level-value {
  max-width: 190rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 1.35;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .43);
  font-size: 18rpx;
  font-weight: 750;
}

.metric-divider {
  width: 1rpx;
  margin: 0 22rpx;
  background: rgba(255, 255, 255, .09);
}

/* Sections */
.content-section {
  margin-top: 50rpx;
  padding: 0 24rpx;
}

.tool-section { margin-top: 46rpx; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 4rpx 18rpx;
}

.compact-heading { margin-bottom: 16rpx; }

.section-kicker {
  color: #7B867E;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  color: #132118;
  font-size: 35rpx;
  line-height: 1.25;
  font-weight: 950;
  letter-spacing: -.5rpx;
}

.section-note {
  padding-bottom: 4rpx;
  color: #858F88;
  font-size: 21rpx;
}

.route-stack {
  overflow: hidden;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .055);
}

.route-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 154rpx;
  padding: 22rpx 22rpx;
  transition: opacity .16s ease, transform .16s ease, background-color .16s ease;
}

.route-card + .route-card {
  border-top: 1rpx solid #E4E7E1;
}

.route-review { background: linear-gradient(90deg, rgba(231, 235, 221, .68), rgba(255, 255, 255, 0) 66%); }
.route-practice { background: rgba(255, 255, 255, .38); }
.route-wrong { background: linear-gradient(90deg, rgba(246, 239, 227, .54), rgba(255, 255, 255, 0) 66%); }

.card-pressed {
  opacity: .72;
  transform: scale(.994);
  background-color: #ECEFE8;
}

.route-index {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #173426;
  color: #B7E82A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.route-practice .route-index {
  background: #DEE8C9;
  color: #36511C;
}

.route-wrong .route-index {
  background: #F0E1D5;
  color: #A45D34;
}

.route-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.route-eyebrow {
  color: #7A867D;
  font-size: 16rpx;
  letter-spacing: 2.2rpx;
}

.route-title,
.route-desc {
  display: block;
}

.route-title {
  margin-top: 6rpx;
  color: #17251B;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 950;
}

.route-desc {
  margin-top: 6rpx;
  max-width: 500rpx;
  color: #7A857D;
  font-size: 21rpx;
  line-height: 1.45;
}

.route-arrow {
  width: 54rpx;
  height: 54rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid #D6DBD3;
  color: #39483E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
}

/* Tool dock */
.tool-panel {
  display: flex;
  align-items: stretch;
  padding: 10rpx;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: #FBFBF7;
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .05);
}

.tool-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 8rpx 18rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: background-color .16s ease, transform .16s ease;
}

.tool-pressed {
  background: #EDF0EA;
  transform: scale(.98);
}

.tool-divider {
  width: 1rpx;
  margin: 20rpx 0;
  background: #E3E6E0;
}

.tool-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: #E8ECDf;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-icon { align-items: flex-end; gap: 5rpx; padding-bottom: 14rpx; }
.chart-icon .bar { width: 7rpx; border-radius: 99rpx; background: #173426; }
.chart-icon .bar-a { height: 15rpx; }
.chart-icon .bar-b { height: 27rpx; background: #7FA300; }
.chart-icon .bar-c { height: 38rpx; background: #B7E82A; }

.clock-icon::before {
  content: '';
  width: 31rpx;
  height: 31rpx;
  border: 4rpx solid #173426;
  border-radius: 50%;
}

.clock-hand {
  position: absolute;
  left: 30rpx;
  top: 18rpx;
  width: 4rpx;
  height: 15rpx;
  border-radius: 99rpx;
  background: #7FA300;
  transform-origin: bottom center;
  transform: rotate(-35deg);
}

.formula-icon {
  font-family: Georgia, serif;
  font-size: 37rpx;
  font-weight: 700;
}

.tool-title,
.tool-desc {
  display: block;
}

.tool-title {
  margin-top: 14rpx;
  color: #1C2A20;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.3;
}

.tool-desc {
  margin-top: 5rpx;
  color: #8A938C;
  font-size: 17rpx;
  line-height: 1.35;
}

/* Closing note */
.growth-note {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 34rpx 28rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #DDE1DA;
}

.growth-note-line {
  width: 5rpx;
  height: 68rpx;
  border-radius: 99rpx;
  flex-shrink: 0;
  background: #B7E82A;
}

.growth-note-copy { min-width: 0; }
.growth-note-label { color: #7B867E; font-size: 16rpx; }
.growth-note-text {
  display: block;
  margin-top: 8rpx;
  color: #4E5C52;
  font-size: 22rpx;
  line-height: 1.55;
}

.safe-bottom {
  height: calc(38rpx + env(safe-area-inset-bottom));
}

/* Motion */
.page-enter {
  opacity: 0;
  animation: pageEnter .42s cubic-bezier(.2, .8, .2, 1) forwards;
}

.delay-one { animation-delay: .05s; }
.delay-two { animation-delay: .10s; }
.delay-three { animation-delay: .15s; }

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .page-enter,
  .focus-progress-fill,
  .route-card,
  .tool-item,
  .primary-action,
  .secondary-action {
    animation: none !important;
    transition: none !important;
    opacity: 1 !important;
    transform: none !important;
  }
}

/* Profile editor */
.profile-chip-pressed {
  opacity: .72;
  transform: scale(.98);
}

.profile-avatar-image {
  display: block;
  overflow: hidden;
}

.profile-sheet-mask {
  position: fixed;
  z-index: 999;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 22, 15, .42);
  backdrop-filter: blur(10rpx);
  animation: profile-mask-in .18s ease-out;
}

.profile-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 18rpx 30rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #F9FAF6;
  box-shadow: 0 -30rpx 80rpx rgba(13, 31, 21, .18);
  animation: profile-sheet-up .24s cubic-bezier(.22, .8, .3, 1);
}

.profile-sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #D7DCD5;
}

.profile-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.profile-sheet-kicker,
.profile-sheet-title,
.profile-sheet-desc,
.profile-field-title,
.profile-field-desc,
.profile-field-label,
.profile-privacy-note {
  display: block;
}

.profile-sheet-kicker {
  color: #7C897F;
  font-size: 17rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2.6rpx;
}

.profile-sheet-title {
  margin-top: 9rpx;
  color: #132118;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 950;
}

.profile-sheet-desc {
  max-width: 590rpx;
  margin-top: 10rpx;
  color: #6A766D;
  font-size: 23rpx;
  line-height: 1.55;
}

.profile-sheet-close {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  border-radius: 50%;
  background: #EDF0EA;
  color: #6A766D;
  font-size: 38rpx;
  font-weight: 400;
  line-height: 1;
}

.profile-native-tip {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #DCE6D6;
  border-radius: 22rpx;
  background: #F1F6EB;
}

.profile-native-tip-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #173426;
  color: #B7E82A;
  font-size: 20rpx;
  font-weight: 950;
}

.profile-native-tip-copy {
  min-width: 0;
}

.profile-native-tip-title,
.profile-native-tip-desc {
  display: block;
}

.profile-native-tip-title {
  color: #2C3D31;
  font-size: 21rpx;
  line-height: 1.3;
  font-weight: 900;
}

.profile-native-tip-desc {
  margin-top: 4rpx;
  color: #78857B;
  font-size: 19rpx;
  line-height: 1.45;
}

.profile-avatar-row {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #E0E5DD;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.profile-avatar-picker {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  min-width: 108rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.profile-avatar-picker::after,
.profile-save-button::after {
  border: 0;
}

.profile-avatar-preview,
.profile-avatar-placeholder {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  border: 2rpx solid #D9E2D3;
  background: #E2EDC7;
}

.profile-avatar-preview {
  display: block;
}

.profile-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #173426;
  font-size: 42rpx;
  font-weight: 950;
}

.profile-avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: 0;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
  border-radius: 50%;
  background: #173426;
  color: #B7E82A;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 900;
}

.profile-avatar-copy {
  min-width: 0;
  margin-left: 24rpx;
}

.profile-field-title,
.profile-field-label {
  color: #25332A;
  font-size: 25rpx;
  font-weight: 900;
}

.profile-field-desc {
  margin-top: 7rpx;
  color: #88938B;
  font-size: 21rpx;
}

.profile-field {
  margin-top: 24rpx;
}

.profile-field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.profile-field-heading .profile-field-label {
  margin-bottom: 0;
}

.profile-field-action {
  color: #708079;
  font-size: 19rpx;
  line-height: 1.2;
  font-weight: 750;
}

.profile-input-shell {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 2rpx solid #DDE3DA;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.profile-nickname-input {
  flex: 1;
  min-width: 0;
  height: 94rpx;
  color: #17251C;
  font-size: 28rpx;
  font-weight: 750;
}

.profile-input-placeholder {
  color: #A2AAA4;
  font-weight: 500;
}

.profile-input-count {
  margin-left: 16rpx;
  color: #A0A8A2;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
}

.profile-nickname-help {
  display: block;
  margin-top: 10rpx;
  color: #8A948D;
  font-size: 18rpx;
  line-height: 1.5;
}

.profile-save-button {
  height: 92rpx;
  margin: 30rpx 0 0;
  padding: 0;
  border-radius: 24rpx;
  background: #173426;
  color: #FFFFFF;
  font-size: 27rpx;
  line-height: 92rpx;
  font-weight: 900;
  letter-spacing: .5rpx;
  box-shadow: 0 18rpx 34rpx rgba(23, 52, 38, .16);
}

.profile-save-button[disabled] {
  background: #A9B3AC;
  color: rgba(255, 255, 255, .8);
  box-shadow: none;
}

.profile-later-button {
  padding: 22rpx 0 8rpx;
  text-align: center;
  color: #66736A;
  font-size: 23rpx;
  font-weight: 800;
}

.profile-privacy-note {
  margin-top: 8rpx;
  text-align: center;
  color: #9AA39C;
  font-size: 18rpx;
  line-height: 1.45;
}

@keyframes profile-mask-in {
  from { background: rgba(10, 22, 15, 0); }
  to { background: rgba(10, 22, 15, .42); }
}

@keyframes profile-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 微信官方 mp-user-avatar 交互模式适配 */
.profile-consent-sheet {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.profile-consent-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(39, 67, 53, .12);
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(21, 49, 35, .06);
}

.profile-consent-heading {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-consent-label {
  color: #73837a;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.profile-consent-title {
  color: #14251d;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.profile-consent-divider {
  height: 1rpx;
  margin: 24rpx 0;
  background: #e8ece7;
}

.profile-consent-more {
  display: block;
  color: #6f7d75;
  font-size: 23rpx;
  line-height: 36rpx;
}

.profile-auto-save-state {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 66rpx;
  padding: 16rpx 4rpx 4rpx;
  color: #77847c;
  font-size: 23rpx;
  line-height: 34rpx;
}

.profile-auto-save-dot {
  flex: 0 0 auto;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a7b1ab;
}

.profile-auto-save-dot.is-ready {
  background: #169255;
  box-shadow: 0 0 0 7rpx rgba(22, 146, 85, .09);
}

.profile-consent-actions {
  display: grid;
  grid-template-columns: 1fr 1.12fr;
  gap: 18rpx;
  margin-top: 20rpx;
}

.profile-consent-cancel,
.profile-consent-allow {
  height: 88rpx;
  margin: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 750;
  line-height: 88rpx;
}

.profile-consent-cancel {
  color: #557066;
  background: #eef1ed;
}

.profile-consent-allow {
  color: #ffffff;
  background: #0b7a43;
  box-shadow: 0 12rpx 26rpx rgba(11, 122, 67, .18);
}

.profile-consent-cancel::after,
.profile-consent-allow::after {
  border: 0;
}

.profile-consent-allow[disabled] {
  color: rgba(255,255,255,.78);
  background: #a9b7af;
  box-shadow: none;
}


/* Compact profile consent refresh */
.profile-sheet-head-compact {
  align-items: center;
}

.profile-consent-card-compact {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
}

.profile-auto-save-state-compact {
  min-height: auto;
  padding: 16rpx 4rpx 0;
  font-size: 22rpx;
}

.profile-consent-actions-compact {
  margin-top: 18rpx;
}

.profile-consent-cancel,
.profile-consent-allow {
  height: 84rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  line-height: 84rpx;
}

.profile-sheet-desc {
  max-width: 560rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
}


/* Profile consent v3: two-step auto-save flow */
.profile-consent-sheet {
  padding: 16rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
}

.profile-sheet-handle {
  margin-bottom: 20rpx;
}

.profile-sheet-title {
  margin-top: 7rpx;
  font-size: 36rpx;
}

.profile-sheet-desc {
  margin-top: 6rpx;
  color: #7a867f;
  font-size: 21rpx;
}

.profile-sheet-close {
  width: 54rpx;
  height: 54rpx;
  font-size: 34rpx;
}

.profile-step-guide {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 6rpx;
}

.profile-step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #98a19b;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.profile-step.is-active {
  color: #274236;
}

.profile-step.is-done {
  color: #14844b;
}

.profile-step-index {
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #d9dfdb;
  border-radius: 50%;
  background: #f7f8f5;
  color: #8b9690;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
}

.profile-step.is-active .profile-step-index {
  border-color: #6f8a7b;
  background: #edf3ef;
  color: #274236;
}

.profile-step.is-done .profile-step-index {
  border-color: #cae8d7;
  background: #e7f6ed;
  color: #14844b;
}

.profile-step-line {
  flex: 1;
  min-width: 50rpx;
  height: 2rpx;
  margin: 0 14rpx;
  background: #e2e6e3;
}

.profile-step-line.is-done {
  background: #bfe0cd;
}

.profile-consent-card-compact {
  margin-top: 20rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 34rpx rgba(21, 49, 35, .045);
}

.profile-flow-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 38rpx;
  padding: 16rpx 4rpx 0;
  color: #78847d;
  font-size: 21rpx;
  line-height: 30rpx;
}

.profile-flow-tip.is-ready {
  color: #4e715f;
}

.profile-consent-actions-single {
  display: block;
  margin-top: 18rpx;
}

.profile-later-only {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  color: #5e7067;
  background: #eef1ed;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1;
  text-align: center;
}

.profile-later-only::after {
  border: 0;
}

.profile-later-only[disabled] {
  color: #9aa49e;
  background: #f1f2ef;
}

/* Home profile editor v5: option 3 / minimal split layout. */
.profile-minimal-sheet {
  max-height: calc(100vh - 20rpx);
  box-sizing: border-box;
  overflow-y: auto;
  padding: 16rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #fafbf7;
}

.profile-minimal-sheet .profile-sheet-handle {
  width: 70rpx;
  height: 7rpx;
  margin-bottom: 24rpx;
  background: #d6dcd5;
}

.profile-minimal-head {
  align-items: flex-start;
}

.profile-minimal-heading {
  min-width: 0;
  flex: 1;
}

.profile-minimal-sheet .profile-sheet-kicker {
  color: #7b8980;
  font-size: 17rpx;
  letter-spacing: 2.4rpx;
}

.profile-minimal-sheet .profile-sheet-title {
  margin-top: 9rpx;
  color: #112219;
  font-size: 39rpx;
  line-height: 1.16;
  font-weight: 950;
  letter-spacing: -.6rpx;
}

.profile-minimal-sheet .profile-sheet-desc {
  margin-top: 9rpx;
  color: #77837b;
  font-size: 22rpx;
  line-height: 1.45;
}

.profile-minimal-sheet .profile-sheet-close {
  width: 58rpx;
  height: 58rpx;
  margin-top: 0;
  background: #eef1ec;
  color: #526158;
  font-size: 38rpx;
  transition: transform .16s ease, background-color .16s ease, opacity .16s ease;
}

.profile-sheet-close-pressed {
  transform: scale(.92) rotate(5deg);
  background: #e4e9e2 !important;
  opacity: .82;
}

.profile-minimal-grid {
  position: relative;
  display: flex;
  align-items: stretch;
  width: 100%;
  min-height: 300rpx;
  margin-top: 46rpx;
}

.profile-minimal-card {
  position: relative;
  min-width: 0;
  flex: 1 1 0;
  min-height: 300rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 38rpx 18rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid transparent;
  border-radius: 30rpx;
  background: rgba(247, 249, 245, .72);
  color: #17281f;
  line-height: 1;
  text-align: center;
  transition:
    transform .18s cubic-bezier(.22, .75, .3, 1),
    border-color .24s ease,
    background-color .24s ease,
    box-shadow .24s ease,
    opacity .24s ease;
  animation: profile-minimal-card-in .34s cubic-bezier(.2, .8, .3, 1) both;
}

.profile-minimal-nickname-card {
  animation-delay: .045s;
}

button.profile-minimal-card::after {
  border: 0;
}

button.profile-minimal-card[disabled] {
  opacity: .68;
}

.profile-minimal-card.is-active {
  z-index: 1;
  border-color: rgba(52, 107, 79, .22);
  background: linear-gradient(145deg, #f4faf6 0%, #edf6f0 100%);
  box-shadow: 0 16rpx 44rpx rgba(31, 73, 51, .07);
}

.profile-minimal-card.is-done {
  border-color: rgba(70, 132, 97, .14);
  background: #f8fbf8;
}

.profile-minimal-card.is-waiting {
  opacity: .78;
  background: rgba(247, 248, 245, .5);
}

.profile-minimal-card-pressed {
  transform: scale(.975);
}

.profile-minimal-divider {
  align-self: center;
  width: 1rpx;
  height: 176rpx;
  flex: 0 0 1rpx;
  margin: 62rpx 22rpx;
  background: linear-gradient(180deg, transparent 0%, #dfe4df 14%, #dfe4df 86%, transparent 100%);
}

.profile-minimal-icon {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  transition: transform .22s ease, background-color .22s ease, border-color .22s ease;
}

.profile-minimal-card.is-active .profile-minimal-icon {
  transform: translateY(-3rpx);
}

.profile-minimal-avatar-icon {
  position: relative;
  overflow: visible;
}

.profile-minimal-avatar-image,
.profile-minimal-avatar-placeholder {
  display: block;
  width: 104rpx;
  height: 104rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid #d7e0d8;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #eff4ef 0%, #e4ece5 100%);
}

.profile-minimal-avatar-image {
  animation: profile-minimal-avatar-in .28s ease-out both;
}

.profile-minimal-avatar-placeholder {
  position: relative;
}

.profile-minimal-person-head {
  position: absolute;
  left: 35rpx;
  top: 22rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #819087;
}

.profile-minimal-person-body {
  position: absolute;
  left: 22rpx;
  bottom: -10rpx;
  width: 60rpx;
  height: 49rpx;
  border-radius: 34rpx 34rpx 10rpx 10rpx;
  background: #819087;
}

.profile-minimal-avatar-badge {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  width: 34rpx;
  height: 34rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #f7faf7;
  border-radius: 50%;
  background: #163e2a;
  color: #d8f56c;
  font-size: 22rpx;
  font-weight: 950;
  line-height: 1;
  box-shadow: 0 5rpx 12rpx rgba(18, 55, 37, .14);
  transition: transform .2s ease, background-color .2s ease;
}

.profile-minimal-card.is-done .profile-minimal-avatar-badge {
  background: #17834d;
  animation: profile-minimal-check-in .28s cubic-bezier(.2, .9, .3, 1.3) both;
}

.profile-minimal-nickname-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #dbe2dc;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #f4f6f2 0%, #edf1ed 100%);
  color: #53665b;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
}

.profile-minimal-card.is-active .profile-minimal-nickname-icon {
  border-color: #cfdfd3;
  background: #edf5ef;
  color: #405e4d;
}

.profile-minimal-card-title,
.profile-minimal-nickname-input {
  display: block;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  color: #14251c;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-align: center;
}

.profile-minimal-nickname-input {
  height: 42rpx;
  padding: 0 4rpx;
}

.profile-minimal-nickname-placeholder {
  color: #14251c;
  font-size: 27rpx;
  font-weight: 900;
  text-align: center;
}

.profile-minimal-card-desc {
  display: block;
  width: 100%;
  min-height: 32rpx;
  box-sizing: border-box;
  margin-top: 9rpx;
  padding: 0 6rpx;
  color: #8a958e;
  font-size: 19rpx;
  line-height: 30rpx;
  text-align: center;
}

.profile-minimal-card-desc.is-error {
  color: #a66058;
}

.profile-minimal-done-mark {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e1f3e7;
  color: #13824a;
  font-size: 18rpx;
  font-weight: 950;
  line-height: 1;
  animation: profile-minimal-check-in .28s cubic-bezier(.2, .9, .3, 1.3) both;
}

.profile-minimal-status {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 40rpx;
  margin-top: 44rpx;
  padding: 0 4rpx;
  color: #75817a;
  font-size: 21rpx;
  line-height: 32rpx;
  transition: color .22s ease;
}

.profile-minimal-status.is-ready,
.profile-minimal-status.is-saving {
  color: #4a715d;
}

.profile-minimal-status.is-error {
  color: #a66058;
}

.profile-minimal-status .profile-auto-save-dot {
  width: 13rpx;
  height: 13rpx;
}

.profile-minimal-status .profile-auto-save-dot.is-ready {
  background: #16864f;
  box-shadow: 0 0 0 7rpx rgba(22, 134, 79, .08);
}

.profile-minimal-status .profile-auto-save-dot.is-saving {
  background: #16864f;
  box-shadow: 0 0 0 7rpx rgba(22, 134, 79, .08);
  animation: profile-minimal-save-pulse .7s ease-in-out infinite alternate;
}

@keyframes profile-minimal-card-in {
  from { opacity: 0; transform: translateY(12rpx) scale(.985); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes profile-minimal-avatar-in {
  from { opacity: .2; transform: scale(.9); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes profile-minimal-check-in {
  0% { opacity: 0; transform: scale(.65); }
  70% { opacity: 1; transform: scale(1.08); }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes profile-minimal-save-pulse {
  from { opacity: .5; transform: scale(.82); }
  to { opacity: 1; transform: scale(1.12); }
}

@media (max-height: 620px) {
  .profile-minimal-sheet {
    padding-top: 12rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  }

  .profile-minimal-sheet .profile-sheet-handle {
    margin-bottom: 15rpx;
  }

  .profile-minimal-sheet .profile-sheet-title {
    font-size: 35rpx;
  }

  .profile-minimal-grid {
    min-height: 252rpx;
    margin-top: 28rpx;
  }

  .profile-minimal-card {
    min-height: 252rpx;
    padding-top: 28rpx;
    padding-bottom: 24rpx;
  }

  .profile-minimal-divider {
    height: 150rpx;
    margin-top: 50rpx;
    margin-bottom: 50rpx;
  }

  .profile-minimal-icon {
    width: 88rpx;
    height: 88rpx;
    flex-basis: 88rpx;
    margin-bottom: 20rpx;
  }

  .profile-minimal-avatar-image,
  .profile-minimal-avatar-placeholder {
    width: 88rpx;
    height: 88rpx;
    border-radius: 26rpx;
  }

  .profile-minimal-person-head {
    left: 30rpx;
    top: 19rpx;
    width: 29rpx;
    height: 29rpx;
  }

  .profile-minimal-person-body {
    left: 19rpx;
    width: 50rpx;
    height: 41rpx;
  }

  .profile-minimal-status {
    margin-top: 28rpx;
  }
}
