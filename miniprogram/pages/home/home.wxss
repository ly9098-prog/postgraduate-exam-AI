/* v15 · mastery progress — fixed chamfer / reference hex rail
 * Reference geometry is NOT a skewed parallelogram. The gray rail and green fill
 * are separate horizontal hexagons: a straight center body with fixed diagonal
 * cuts at both ends. The fill overlays the rail, so its right-pointing chamfer
 * naturally sits on top of the remaining gray segment exactly like the mockup. */
.mastery-track-tech {
  position: relative;
  height: 24rpx;
  margin-top: 23rpx;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.mastery-hex-rail {
  position: absolute;
  left: 1rpx;
  right: 1rpx;
  top: 2rpx;
  height: 20rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #E8ECE8 0%, #E2E7E3 56%, #DFE5E0 100%);
  -webkit-clip-path: polygon(
    11rpx 0,
    calc(100% - 11rpx) 0,
    100% 50%,
    calc(100% - 11rpx) 100%,
    11rpx 100%,
    0 50%
  );
  clip-path: polygon(
    11rpx 0,
    calc(100% - 11rpx) 0,
    100% 50%,
    calc(100% - 11rpx) 100%,
    11rpx 100%,
    0 50%
  );
  box-shadow:
    inset 0 1rpx 0 rgba(255,255,255,.68),
    inset 0 -1rpx 0 rgba(53,73,59,.035);
}

.mastery-hex-fill {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 2;
  height: 100%;
  min-width: 23rpx;
  overflow: hidden;
  -webkit-clip-path: polygon(
    11rpx 0,
    calc(100% - 11rpx) 0,
    100% 50%,
    calc(100% - 11rpx) 100%,
    11rpx 100%,
    0 50%
  );
  clip-path: polygon(
    11rpx 0,
    calc(100% - 11rpx) 0,
    100% 50%,
    calc(100% - 11rpx) 100%,
    11rpx 100%,
    0 50%
  );
  background: #5C854D;
  transition: width .24s ease;
}

/* At 100%, use the rail's exact outline; no rounded cap or extra overhang. */
.mastery-hex-fill.is-full {
  width: 100% !important;
}

.mastery-hex-gradient {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(90deg,
    #4F7746 0%,
    #587F49 28%,
    #628A4E 64%,
    #709958 100%);
}

/* Five short translucent bevel blocks. They stay near the leading side of the
 * fill and are clipped naturally on short percentages, matching the reference. */
.mastery-hex-stripes {
  position: absolute;
  inset: 0;
  z-index: 3;
  overflow: hidden;
  pointer-events: none;
}

.mastery-hex-stripe {
  position: absolute;
  top: 4rpx;
  width: 19rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg,
    rgba(207,228,191,.48) 0%,
    rgba(181,209,160,.43) 70%,
    rgba(146,181,128,.31) 100%);
  transform: skewX(-23deg);
  transform-origin: center center;
  box-shadow:
    inset 2rpx 0 0 rgba(243,249,237,.18),
    inset -2rpx 0 0 rgba(55,89,50,.08);
}

.mastery-hex-stripe.stripe-one   { left: 22rpx; }
.mastery-hex-stripe.stripe-two   { left: 46rpx; }
