/* home — 首页专属样式 */
@import '../../styles/tokens.wxss';

/* 进度卡片 */
.progress-card {
  padding: 28rpx 24rpx;
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.greeting {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D3E50;
}

.date-text {
  font-size: 24rpx;
  color: #9AABBA;
}

.progress-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.pstat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.pstat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #5B7B9A;
}

.pstat-num.accent {
  color: #C49A6B;
}

.pstat-label {
  font-size: 24rpx;
  color: #9AABBA;
  margin-top: 6rpx;
}

.pstat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #EDEBE6;
}

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
}

.action-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
}

.action-card:active {
  opacity: 0.85;
}

.action-emoji {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 44rpx;
  text-align: center;
}

.action-info {
  flex: 1;
}

.action-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #9AABBA;
  margin-top: 4rpx;
  display: block;
}

.action-arrow {
  font-size: 32rpx;
  color: #D0CEC8;
}

/* 错题分布 */
.pie-wrap {
  display: flex;
  align-items: center;
  padding-top: 12rpx;
}

.pie-box {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.pie-canvas {
  width: 240rpx;
  height: 240rpx;
}

.pie-center {
  position: absolute;
  left: 68rpx;
  top: 68rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.08);
}

.pie-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D3E50;
}

.pie-total-label {
  font-size: 20rpx;
  color: #9AABBA;
  margin-top: 2rpx;
}

.pie-legend {
  flex: 1;
  margin-left: 28rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  margin: 12rpx 0;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-main {
  flex: 1;
  min-width: 0;
}

.legend-name {
  display: block;
  font-size: 26rpx;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-percent {
  display: block;
  font-size: 22rpx;
  color: #9AABBA;
  margin-top: 2rpx;
}

.legend-count {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}
