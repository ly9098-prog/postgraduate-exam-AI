@import '../../styles/tokens.wxss';

/* ── Welcome Section ── */
.welcome-section {
  margin: 24rpx 24rpx 12rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #5B7B9A 0%, #7A9BB8 100%);
  position: relative;
  overflow: hidden;
}

.welcome-section::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.06);
}

.welcome-section::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
}

.welcome-content {
  position: relative;
  z-index: 1;
}

.welcome-greeting-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.welcome-greeting {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
}

.welcome-user {
  font-size: 34rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.92);
  line-height: 1.35;
  margin-left: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

.welcome-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 10rpx;
  line-height: 1.4;
}

.welcome-quote {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.animation-fade-in {
  animation: fadeSlideIn 0.6s ease-out;
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
  margin-top: 6rpx;
}

.action-card {
  min-height: 104rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.action-card:active {
  opacity: 0.88;
  background: #FAF9F6;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #6B7B8D;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F2EF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #9AABBA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

