/* home — 首页专属样式 */
@import '../../styles/tokens.wxss';

/* 进度卡片 */
.progress-card {
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(91, 123, 154, 0.08);
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.greeting-block {
  flex: 1;
  min-width: 0;
}

.greeting {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.greeting-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7B8D;
}

.date-text {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: #9AABBA;
  padding-top: 4rpx;
}

.progress-stats {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 22rpx 8rpx;
  background: #F7F6F2;
  border-radius: 18rpx;
}

.pstat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.pstat-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.pstat-num.accent {
  color: #C49A6B;
}

.pstat-label {
  font-size: 24rpx;
  color: #6B7B8D;
  margin-top: 8rpx;
}

.pstat-divider {
  width: 1rpx;
  min-height: 56rpx;
  margin: 6rpx 4rpx;
  background: #E8E5E0;
}

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
}

.action-card {
  min-height: 104rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.action-card:active {
  opacity: 0.88;
  background: #FAF9F6;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #6B7B8D;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F2EF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #9AABBA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 错题分布 */
.pie-card {
  padding-bottom: 32rpx;
}

.pie-wrap {
  display: flex;
  align-items: center;
  padding-top: 8rpx;
}

.pie-box {
  position: relative;
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
}

.pie-canvas {
  width: 240rpx;
  height: 240rpx;
}

.pie-center {
  position: absolute;
  left: 68rpx;
  top: 68rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 18rpx rgba(43, 60, 80, 0.08);
}

.pie-total {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #2D3E50;
  font-variant-numeric: tabular-nums;
}

.pie-total-label {
  font-size: 20rpx;
  color: #9AABBA;
  margin-top: 2rpx;
}

.pie-legend {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  min-height: 52rpx;
  margin: 10rpx 0;
}

.legend-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.legend-main {
  flex: 1;
  min-width: 0;
}

.legend-name {
  display: block;
  font-size: 26rpx;
  line-height: 1.35;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-percent {
  display: block;
  font-size: 22rpx;
  line-height: 1.35;
  color: #9AABBA;
  margin-top: 2rpx;
}

.legend-count {
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}
