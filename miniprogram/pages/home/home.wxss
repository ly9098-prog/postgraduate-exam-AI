@import '../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  background-color: #F4F4EE;
  color: #15231A;
}

.home-page {
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 100% 0%, rgba(183, 232, 42, .08), transparent 360rpx),
    linear-gradient(180deg, #F6F6F0 0%, #F1F2EC 100%);
}

/* Navigation */
.home-nav {
  width: 100%;
  box-sizing: border-box;
}

.home-nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding-left: 28rpx;
}

.brand-lockup {
  display: flex;
  align-items: center;
  min-width: 0;
}

.brand-mark {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 17rpx;
  background: #153323;
  box-shadow: 0 10rpx 24rpx rgba(21, 51, 35, .16);
}

.brand-mark-line {
  position: absolute;
  left: 12rpx;
  height: 4rpx;
  border-radius: 99rpx;
  background: #FFFFFF;
  transform-origin: left center;
}

.brand-mark-line.line-one {
  width: 25rpx;
  top: 31rpx;
  transform: rotate(-29deg);
}

.brand-mark-line.line-two {
  width: 18rpx;
  left: 28rpx;
  top: 18rpx;
  transform: rotate(24deg);
  background: #B7E82A;
}

.brand-mark-dot {
  position: absolute;
  width: 9rpx;
  height: 9rpx;
  right: 8rpx;
  top: 10rpx;
  border-radius: 50%;
  background: #B7E82A;
  box-shadow: 0 0 0 6rpx rgba(183, 232, 42, .12);
}

.brand-copy {
  min-width: 0;
  margin-left: 15rpx;
}

.brand-name,
.brand-caption {
  display: block;
  white-space: nowrap;
}

.brand-name {
  font-size: 25rpx;
  line-height: 1.05;
  font-weight: 950;
  letter-spacing: 1.4rpx;
  color: #142219;
}

.brand-caption {
  margin-top: 5rpx;
  font-size: 14rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: #849087;
}

.profile-chip {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 6rpx 12rpx 6rpx 7rpx;
  border: 1rpx solid #DDE2DA;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .58);
}

.profile-avatar {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: #E2EDC7;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 950;
}

.profile-avatar-image {
  display: block;
  overflow: hidden;
}

.profile-chip-pressed {
  opacity: .76;
  transform: scale(.97);
}

.profile-level {
  max-width: 116rpx;
  margin-left: 9rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #455249;
  font-size: 19rpx;
  font-weight: 850;
}

/* Header */
.editorial-head {
  padding: 28rpx 28rpx 26rpx;
}

.editorial-date,
.section-kicker,
.route-eyebrow,
.growth-note-label {
  display: block;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2.6rpx;
}

.editorial-date {
  color: #7A867D;
}

.editorial-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
}

.editorial-title {
  flex-shrink: 0;
  max-width: 590rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #132118;
  font-size: 48rpx;
  line-height: 1.12;
  font-weight: 950;
  letter-spacing: -1.2rpx;
}

.editorial-rule {
  flex: 1;
  height: 2rpx;
  min-width: 20rpx;
  background: #D5DAD2;
}

.editorial-subtitle {
  display: block;
  margin-top: 13rpx;
  color: #68756C;
  font-size: 26rpx;
  line-height: 1.5;
}

/* Main task */
.focus-card {
  position: relative;
  overflow: hidden;
  margin: 0 24rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  background: linear-gradient(145deg, #183528 0%, #10251A 56%, #09170F 100%);
  box-shadow: 0 28rpx 68rpx rgba(16, 37, 26, .23);
}

.focus-grid {
  position: absolute;
  right: -64rpx;
  top: -48rpx;
  width: 380rpx;
  height: 300rpx;
  opacity: .045;
  transform: rotate(7deg);
  background-image:
    linear-gradient(#FFFFFF 1rpx, transparent 1rpx),
    linear-gradient(90deg, #FFFFFF 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
}

.focus-glow {
  position: absolute;
  width: 360rpx;
  height: 360rpx;
  right: -170rpx;
  top: -170rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(183, 232, 42, .25), rgba(183, 232, 42, 0) 70%);
}

.focus-chart {
  position: absolute;
  right: 30rpx;
  top: 112rpx;
  width: 245rpx;
  height: 130rpx;
  opacity: .42;
  pointer-events: none;
}

.chart-line {
  position: absolute;
  height: 4rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, .58);
  transform-origin: left center;
}

.chart-line-a { width: 70rpx; left: 0; top: 88rpx; transform: rotate(-22deg); }
.chart-line-b { width: 84rpx; left: 64rpx; top: 62rpx; transform: rotate(18deg); }
.chart-line-c { width: 88rpx; left: 142rpx; top: 88rpx; transform: rotate(-35deg); background: #B7E82A; }

.chart-node {
  position: absolute;
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid rgba(255, 255, 255, .68);
  border-radius: 50%;
  background: #10251A;
  box-sizing: border-box;
}

.node-a { left: -2rpx; top: 82rpx; }
.node-b { left: 65rpx; top: 54rpx; }
.node-c { left: 142rpx; top: 81rpx; }
.node-d { right: 4rpx; top: 27rpx; }
.chart-node.active { border-color: #B7E82A; box-shadow: 0 0 0 13rpx rgba(183, 232, 42, .11); }

.focus-content {
  position: relative;
  z-index: 2;
  padding: 30rpx 28rpx 0;
}

.focus-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.focus-status {
  display: flex;
  align-items: center;
  min-width: 0;
  color: #B7E82A;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.focus-status-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 13rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #B7E82A;
  box-shadow: 0 0 0 8rpx rgba(183, 232, 42, .12);
}

.goal-link {
  flex-shrink: 0;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .065);
  color: rgba(255, 255, 255, .68);
  font-size: 20rpx;
  font-weight: 800;
}

.soft-pressed { opacity: .72; }

.focus-title,
.focus-desc {
  display: block;
  position: relative;
  max-width: 520rpx;
}

.focus-title {
  margin-top: 36rpx;
  color: #FFFFFF;
  font-size: 47rpx;
  line-height: 1.18;
  font-weight: 950;
  letter-spacing: -1rpx;
}

.focus-desc {
  margin-top: 16rpx;
  color: rgba(239, 245, 240, .68);
  font-size: 24rpx;
  line-height: 1.65;
}

.progress-head,
.progress-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-head {
  margin-top: 34rpx;
  color: rgba(255, 255, 255, .62);
  font-size: 20rpx;
  font-weight: 750;
}

.progress-value {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.focus-progress-track {
  height: 14rpx;
  margin-top: 13rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .10);
}

.focus-progress-fill {
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8FB700 0%, #B7E82A 72%, #D6F681 100%);
  box-shadow: 0 0 22rpx rgba(183, 232, 42, .26);
  transition: width .32s ease-out;
}

.progress-foot {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .46);
  font-size: 19rpx;
  line-height: 1.4;
}

.progress-foot text:first-child {
  flex: 1;
  min-width: 0;
}

.progress-foot text:last-child {
  flex-shrink: 0;
  color: #B7E82A;
  font-weight: 900;
}

.goal-picker {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 11rpx;
  border: 1rpx solid rgba(255, 255, 255, .09);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .055);
}

.goal-option {
  flex: 1;
  min-height: 56rpx;
  border-radius: 16rpx;
  color: rgba(255, 255, 255, .56);
  font-size: 21rpx;
  font-weight: 850;
  line-height: 56rpx;
  text-align: center;
}

.goal-option-active {
  color: #10251A;
  background: #B7E82A;
}

.focus-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 28rpx;
}

.primary-action {
  flex: 1;
  min-height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border-radius: 24rpx;
  background: #B7E82A;
  color: #10251A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 950;
  box-shadow: 0 14rpx 30rpx rgba(104, 140, 0, .18);
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
  font-weight: 700;
}

.secondary-action {
  flex-shrink: 0;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, .13);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, .055);
  color: rgba(255, 255, 255, .78);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 850;
  transition: transform .16s ease, opacity .16s ease;
}

.primary-action-pressed,
.secondary-action-pressed {
  transform: scale(.98);
  opacity: .82;
}

.focus-metrics {
  display: flex;
  align-items: stretch;
  margin: 30rpx -28rpx 0;
  padding: 22rpx 28rpx 25rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .08);
  background: rgba(255, 255, 255, .035);
}

.metric-item {
  flex: 1;
  min-width: 0;
}

.metric-item.metric-level { flex: 1.35; }

.metric-value,
.metric-label {
  display: block;
}

.metric-value {
  color: #FFFFFF;
  font-size: 35rpx;
  line-height: 1.1;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.metric-value.level-value {
  max-width: 190rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  line-height: 1.35;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .43);
  font-size: 18rpx;
  font-weight: 750;
}

.metric-divider {
  width: 1rpx;
  margin: 0 22rpx;
  background: rgba(255, 255, 255, .09);
}

/* Sections */
.content-section {
  margin-top: 50rpx;
  padding: 0 24rpx;
}

.tool-section { margin-top: 46rpx; }

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 4rpx 18rpx;
}

.compact-heading { margin-bottom: 16rpx; }

.section-kicker {
  color: #7B867E;
}

.section-title {
  display: block;
  margin-top: 6rpx;
  color: #132118;
  font-size: 35rpx;
  line-height: 1.25;
  font-weight: 950;
  letter-spacing: -.5rpx;
}

.section-note {
  padding-bottom: 4rpx;
  color: #858F88;
  font-size: 21rpx;
}

.route-stack {
  overflow: hidden;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .68);
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .055);
}

.route-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 154rpx;
  padding: 22rpx 22rpx;
  transition: opacity .16s ease, transform .16s ease, background-color .16s ease;
}

.route-card + .route-card {
  border-top: 1rpx solid #E4E7E1;
}

.route-review { background: linear-gradient(90deg, rgba(231, 235, 221, .68), rgba(255, 255, 255, 0) 66%); }
.route-practice { background: rgba(255, 255, 255, .38); }
.route-wrong { background: linear-gradient(90deg, rgba(246, 239, 227, .54), rgba(255, 255, 255, 0) 66%); }
.route-exam { background: linear-gradient(90deg, rgba(227, 236, 238, .58), rgba(255, 255, 255, 0) 66%); }

.card-pressed {
  opacity: .72;
  transform: scale(.994);
  background-color: #ECEFE8;
}

.route-index {
  width: 66rpx;
  height: 66rpx;
  border-radius: 22rpx;
  flex-shrink: 0;
  background: #173426;
  color: #B7E82A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 950;
  font-variant-numeric: tabular-nums;
}

.route-practice .route-index {
  background: #DEE8C9;
  color: #36511C;
}

.route-wrong .route-index {
  background: #F0E1D5;
  color: #A45D34;
}

.route-exam .route-index {
  background: #DCEAEC;
  color: #2C6370;
}

.route-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.route-eyebrow {
  color: #7A867D;
  font-size: 16rpx;
  letter-spacing: 2.2rpx;
}

.route-title,
.route-desc {
  display: block;
}

.route-title {
  margin-top: 6rpx;
  color: #17251B;
  font-size: 29rpx;
  line-height: 1.3;
  font-weight: 950;
}

.route-desc {
  margin-top: 6rpx;
  max-width: 500rpx;
  color: #7A857D;
  font-size: 21rpx;
  line-height: 1.45;
}

.route-arrow {
  width: 54rpx;
  height: 54rpx;
  margin-left: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid #D6DBD3;
  color: #39483E;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: Arial, sans-serif;
  font-size: 29rpx;
}

/* Tool dock */
.tool-panel {
  display: flex;
  align-items: stretch;
  padding: 10rpx;
  border: 1rpx solid #DFE3DC;
  border-radius: 30rpx;
  background: #FBFBF7;
  box-shadow: 0 14rpx 38rpx rgba(23, 52, 38, .05);
}

.tool-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 8rpx 18rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: background-color .16s ease, transform .16s ease;
}

.tool-pressed {
  background: #EDF0EA;
  transform: scale(.98);
}

.tool-divider {
  width: 1rpx;
  margin: 20rpx 0;
  background: #E3E6E0;
}

.tool-icon {
  position: relative;
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  background: #E8ECDf;
  color: #173426;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-icon { align-items: flex-end; gap: 5rpx; padding-bottom: 14rpx; }
.chart-icon .bar { width: 7rpx; border-radius: 99rpx; background: #173426; }
.chart-icon .bar-a { height: 15rpx; }
.chart-icon .bar-b { height: 27rpx; background: #7FA300; }
.chart-icon .bar-c { height: 38rpx; background: #B7E82A; }

.clock-icon::before {
  content: '';
  width: 31rpx;
  height: 31rpx;
  border: 4rpx solid #173426;
  border-radius: 50%;
}

.clock-hand {
  position: absolute;
  left: 30rpx;
  top: 18rpx;
  width: 4rpx;
  height: 15rpx;
  border-radius: 99rpx;
  background: #7FA300;
  transform-origin: bottom center;
  transform: rotate(-35deg);
}

.formula-icon {
  font-family: Georgia, serif;
  font-size: 37rpx;
  font-weight: 700;
}

.tool-title,
.tool-desc {
  display: block;
}

.tool-title {
  margin-top: 14rpx;
  color: #1C2A20;
  font-size: 23rpx;
  font-weight: 950;
  line-height: 1.3;
}

.tool-desc {
  margin-top: 5rpx;
  color: #8A938C;
  font-size: 17rpx;
  line-height: 1.35;
}

/* Closing note */
.growth-note {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 34rpx 28rpx 0;
  padding: 24rpx 0;
  border-top: 1rpx solid #DDE1DA;
}

.growth-note-line {
  width: 5rpx;
  height: 68rpx;
  border-radius: 99rpx;
  flex-shrink: 0;
  background: #B7E82A;
}

.growth-note-copy { min-width: 0; }
.growth-note-label { color: #7B867E; font-size: 16rpx; }
.growth-note-text {
  display: block;
  margin-top: 8rpx;
  color: #4E5C52;
  font-size: 22rpx;
  line-height: 1.55;
}

.safe-bottom {
  height: calc(38rpx + env(safe-area-inset-bottom));
}

/* Motion */
.page-enter {
  opacity: 0;
  animation: pageEnter .42s cubic-bezier(.2, .8, .2, 1) forwards;
}

.delay-one { animation-delay: .05s; }
.delay-two { animation-delay: .10s; }
.delay-three { animation-delay: .15s; }

@keyframes pageEnter {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .page-enter,
  .focus-progress-fill,
  .route-card,
  .tool-item,
  .primary-action,
  .secondary-action {
    animation: none !important;
    transition: none;
    opacity: 1 !important;
    transform: none !important;
  }
}

/* Profile editor v11: minimal two-column UI using direct native WeChat controls.
   Keep the native chooseAvatar button and nickname input stable while the host UI is open. */
.profile-sheet-mask {
  position: fixed;
  z-index: 999;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 0;
  background: rgba(8, 18, 12, .42);
  animation: profile-v11-mask-in .18s ease-out;
}

.profile-native-sheet,
.profile-minimal-sheet.profile-native-sheet {
  position: relative;
  bottom: auto !important;
  width: 100%;
  max-height: calc(100vh - 84rpx);
  overflow-y: auto;
  box-sizing: border-box;
  padding: 14rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #fbfcf8;
  box-shadow: 0 -24rpx 64rpx rgba(13, 31, 21, .16);
  transform: translate3d(0, 0, 0);
  transition: none !important;
  animation: profile-v11-sheet-up .24s cubic-bezier(.22, .8, .3, 1);
}

.profile-native-sheet .profile-sheet-handle {
  width: 64rpx;
  height: 6rpx;
  margin: 0 auto 17rpx;
  border-radius: 999rpx;
  background: #d5dbd4;
}

.profile-native-sheet .profile-minimal-head {
  min-height: 98rpx;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.profile-native-sheet .profile-minimal-heading {
  min-width: 0;
  flex: 1;
}

.profile-native-sheet .profile-sheet-kicker {
  display: block;
  margin: 0;
  color: #7f8c84;
  font-size: 16rpx;
  line-height: 22rpx;
  font-weight: 900;
  letter-spacing: 2.3rpx;
}

.profile-native-sheet .profile-sheet-title {
  display: block;
  margin-top: 5rpx;
  color: #14251b;
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.profile-native-sheet .profile-sheet-desc {
  display: block;
  margin-top: 4rpx;
  color: #88928c;
  font-size: 19rpx;
  line-height: 28rpx;
}

.profile-native-sheet .profile-sheet-close {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  margin: 0;
  border-radius: 50%;
  background: #f0f2ed;
  color: #647269;
  font-size: 34rpx;
  line-height: 54rpx;
  text-align: center;
}

.profile-sheet-close-pressed {
