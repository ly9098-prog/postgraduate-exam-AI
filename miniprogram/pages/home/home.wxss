@import '../../styles/tokens.wxss';

/* 进度卡片 */
.progress-card {
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(91, 123, 154, 0.08);
}

.progress-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.greeting-block {
  flex: 1;
  min-width: 0;
}

.greeting {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #2D3E50;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.greeting-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #6B7B8D;
}

.date-text {
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.4;
  color: #9AABBA;
  padding-top: 4rpx;
}

.progress-stats {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  padding: 22rpx 8rpx;
  background: #F7F6F2;
  border-radius: 18rpx;
}

.pstat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.pstat-num {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.15;
  color: #5B7B9A;
  font-variant-numeric: tabular-nums;
}

.pstat-num.accent {
  color: #C49A6B;
}

.pstat-label {
  font-size: 24rpx;
  color: #6B7B8D;
  margin-top: 8rpx;
}

.pstat-divider {
  width: 1rpx;
  min-height: 56rpx;
  margin: 6rpx 4rpx;
  background: #E8E5E0;
}

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 104rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.action-card:active {
  opacity: 0.88;
  background: #FAF9F6;
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #6B7B8D;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F2EF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #9AABBA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 次要入口 */
.secondary-actions {
  padding: 0 24rpx;
  margin-top: 6rpx;
  display: flex;
  justify-content: center;
}

.secondary-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 40rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.secondary-action:active {
  opacity: 0.86;
  background: #FAF9F6;
}

.secondary-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: #EFF5EF;
  color: #6B9B6B;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.secondary-label {
  font-size: 26rpx;
  color: #6B7B8D;
}
