@import '../../styles/tokens.wxss';

/* ── Welcome Section (Glassmorphism) ── */
.welcome-section {
  margin: 24rpx 24rpx 12rpx;
  border-radius: 28rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #4A6F8F 0%, #6B95B5 45%, #8AAFC8 100%);
  box-shadow: 0 8rpx 32rpx rgba(74, 111, 143, 0.2);
}

/* Glass blur overlay */
.welcome-glass {
  position: absolute;
  inset: 0;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  z-index: 1;
  pointer-events: none;
}

/* Decorative orbs — behind glass */
.welcome-section::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -10%;
  width: 340rpx;
  height: 340rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  z-index: 0;
}

.welcome-section::after {
  content: '';
  position: absolute;
  bottom: -35%;
  left: -15%;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(138,175,200,0.35) 0%, transparent 70%);
  z-index: 0;
}

.welcome-content {
  position: relative;
  z-index: 2;
  padding: 34rpx 28rpx;
}

.welcome-greeting-row {
  display: flex;
  align-items: baseline;
  flex-wrap: nowrap;
}

.welcome-greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.welcome-user {
  font-size: 36rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.92);
  line-height: 1.35;
  margin-left: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.welcome-date {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 12rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.welcome-quote {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 14rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,0.06);
}

.animation-fade-in {
  animation: fadeSlideIn 0.65s ease-out;
  transform: translateZ(0);
}

@keyframes fadeSlideIn {
  from {
    opacity: 0;
    transform: translateY(-10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 快捷入口 */
.action-grid {
  padding: 0 24rpx;
  margin-top: 6rpx;
}

.action-card {
  min-height: 104rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 24rpx rgba(43, 60, 80, 0.04);
  border: 1rpx solid rgba(232, 229, 224, 0.7);
}

.action-info {
  flex: 1;
  min-width: 0;
}

.action-title {
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #2D3E50;
  display: block;
}

.action-desc {
  font-size: 24rpx;
  color: #6B7B8D;
  line-height: 1.45;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #F3F2EF;
  font-size: 34rpx;
  line-height: 40rpx;
  text-align: center;
  color: #9AABBA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

