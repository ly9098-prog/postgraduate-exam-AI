<view class="page">
  <view class="nav-bar">
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back line-icon icon-chevron-left" style="width:24rpx;height:24rpx;color:#5B7B9A;margin-right:6rpx;"></text>
      <text>返回</text>
    </view>
    <text class="nav-title">提交详情</text>
    <view class="nav-right"></view>
  </view>
  <text class="page-subtitle" wx:if="{{batch}}">已提交审核，管理员审核后会加入题库 · {{batch.source_file || batch.batch_id}}</text>

  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty-state" wx:elif="{{loadError}}">
    <view class="empty-mark danger"><text class="line-icon icon-exclamation" style="width:32rpx;height:32rpx;color:#FFFFFF;"></text></view>
    <text class="empty-title">加载失败，请返回重试</text>
  </view>

  <view class="empty-state" wx:elif="{{questions.length === 0}}">
    <view class="empty-mark">空</view>
    <text class="empty-title">该批次暂无题目</text>
  </view>

  <view class="q-list" wx:else>
    <view
      class="q-card"
      wx:for="{{questions}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCardTap"
    >
      <view class="q-card-body">
        <view class="q-overview">
          <view class="q-meta">
            <text class="q-subject-tag">{{item._subjectLabel}}</text>
            <text class="q-type-label">{{item._typeLabel}}</text>
            <text class="q-ai-flag" wx:if="{{item.ai_generated}}">AI</text>
            <text class="q-math-flag" wx:if="{{item._hasMath}}" bindtap="showMathPreview" catchtap data-id="{{item.id}}">含公式</text>
          </view>
          <view class="q-status-wrap">
            <text class="q-risk-badge" wx:for="{{item._riskFlags}}" wx:for-item="flag" wx:key="*this">{{flag}}</text>
            <view class="q-status-badge {{item.status}}">{{item._statusLabel}}</view>
          </view>
        </view>
        <text class="q-preview">{{item._preview}}</text>
        <view class="q-expand-hint">
          <text class="expand-arrow {{expanding === item.id ? 'expanded' : ''}} line-icon icon-chevron-down" style="width:24rpx;height:24rpx;color:#B7C4DA;"></text>
        </view>
        <view class="q-detail {{expanding === item.id ? 'show' : ''}}" catchtap>
          <view class="detail-body">
            <text class="detail-label">题目</text>
            <text class="detail-text">{{item.parsed_content && item.parsed_content.text ? item.parsed_content.text : '—'}}</text>
          </view>
          <view class="detail-body" wx:if="{{item._hasBlankOptionGroups}}">
            <text class="detail-label">空位选项组</text>
            <view class="blank-option-groups">
              <view class="blank-option-group" wx:for="{{item._blankOptionGroups}}" wx:for-item="group" wx:key="id">
                <text class="blank-group-title">{{group.id}}</text>
                <view class="detail-options">
                  <view class="option-row" wx:for="{{group.options}}" wx:for-item="opt" wx:key="key">
                    <text class="opt-key">{{opt.key}}.</text>
                    <mp-html wx:if="{{opt._needsRich}}" class="opt-val" content="{{opt._html}}"></mp-html>
                    <text wx:else class="opt-val">{{opt._text}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="detail-body" wx:elif="{{item.parsed_options}}">
            <text class="detail-label">选项</text>
            <view class="detail-options">
              <view class="option-row" wx:for="{{item.parsed_options}}" wx:for-item="optVal" wx:for-index="optKey" wx:key="optKey">
                <text class="opt-key">{{optKey}}.</text>
                <text class="opt-val">{{optVal}}</text>
              </view>
            </view>
          </view>
          <view class="detail-body">
            <text class="detail-label">答案</text>
            <text class="detail-answer">{{item.parsed_answer || '—'}}</text>
          </view>
          <view class="detail-body" wx:if="{{item.parsed_analysis}}">
            <text class="detail-label">解析</text>
            <text class="detail-text">{{item.parsed_analysis}}</text>
          </view>
          <view class="detail-body" wx:if="{{item.ai_generated}}">
            <text class="detail-label">AI / OCR 信息</text>
            <text class="detail-text">{{item.ai_metadata && item.ai_metadata.chapter ? '章节：' + item.ai_metadata.chapter : '—'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
