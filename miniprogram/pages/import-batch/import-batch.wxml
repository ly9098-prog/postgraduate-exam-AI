<view class="page">
  <!-- 页面标题 -->
  <view class="page-head">
    <view class="head-left">
      <text class="page-back" bindtap="goBack">‹ 返回</text>
      <text class="page-title">批次审核</text>
    </view>
    <view class="head-actions" wx:if="{{hasPending}}">
      <button class="btn-ai-batch" bindtap="aiEnrichBatch">AI 补全</button>
      <button class="btn-batch-approve" bindtap="batchApprove">全部通过</button>
    </view>
  </view>
  <text class="page-subtitle" wx:if="{{batch}}">{{batch.source_file || batch.batch_id}}</text>

  <!-- 加载态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空态 -->
  <view class="empty-state" wx:elif="{{questions.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-title">该批次无题目</text>
  </view>

  <!-- 题目列表 -->
  <view class="q-list" wx:else>
    <view
      class="q-card"
      wx:for="{{questions}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="toggleExpand"
    >
      <!-- 概览行 -->
      <view class="q-overview">
        <view class="q-meta">
          <text class="q-subject-tag">{{item._subjectLabel}}</text>
          <text class="q-type-label">{{item.question_type === 'choice' ? '选择题' : item.question_type === 'fill' ? '填空题' : item.question_type || '-'}}</text>
          <text class="q-ai-flag" wx:if="{{item.ai_generated}}">AI</text>
        </view>
        <view class="q-status-badge {{item.status}}">{{item._statusLabel}}</view>
      </view>
      <text class="q-preview">{{item._preview}}</text>

      <!-- 展开箭头 -->
      <view class="q-expand-hint">
        <text class="expand-arrow {{expanding === item.id ? 'expanded' : ''}}">▼</text>
      </view>

      <!-- 展开详情 -->
      <view class="q-detail {{expanding === item.id ? 'show' : ''}}" catchtap>
        <view class="detail-body" wx:if="{{item.parsed_content}}">
          <text class="detail-label">题目</text>
          <text class="detail-text">{{item.parsed_content.text}}</text>
        </view>
        <view class="detail-body" wx:if="{{item.parsed_options}}">
          <text class="detail-label">选项</text>
          <view class="detail-options">
            <view class="option-row" wx:for="{{item.parsed_options}}" wx:for-item="optVal" wx:for-index="optKey" wx:key="optKey">
              <text class="opt-key">{{optKey}}.</text>
              <text class="opt-val">{{optVal}}</text>
            </view>
          </view>
        </view>

        <!-- 答案（可编辑） -->
        <view class="detail-body" wx:if="{{item.status === 'pending' && !item.parsed_answer}}">
          <text class="detail-label">答案 <text class="req">*</text></text>
          <view class="answer-quick-keys">
            <view
              class="answer-key {{editing[item.id].parsedAnswer === k ? 'active' : ''}}"
              wx:for="{{item._optionKeys}}"
              wx:for-item="k"
              wx:key="*this"
              data-id="{{item.id}}"
              data-value="{{k}}"
              bindtap="onAnswerSelect"
              catchtap
            >{{k}}</view>
          </view>
        </view>
        <view class="detail-body" wx:elif="{{item.parsed_answer}}">
          <text class="detail-label">答案</text>
          <text class="detail-answer">{{item.parsed_answer}}</text>
        </view>

        <!-- 科目选择（可编辑） -->
        <view class="detail-body" wx:if="{{item.status === 'pending' && !item.subject}}">
          <text class="detail-label">科目 <text class="req">*</text></text>
          <picker class="detail-picker" mode="selector" range="{{subjectOpts}}" range-key="label" bindchange="onSubjectChange">
            <view class="picker-value">{{editing[item.id].subject ? subjectLabel(editing[item.id].subject) : '请选择科目'}}</view>
          </picker>
        </view>

        <!-- 解析 -->
        <view class="detail-body" wx:if="{{item.parsed_analysis}}">
          <text class="detail-label">解析</text>
          <text class="detail-text">{{item.parsed_analysis}}</text>
        </view>

        <!-- AI 元数据展示 -->
        <view class="detail-body ai-block" wx:if="{{item.ai_generated && (item._aiKps.length || item._aiSuggestion || item.ai_metadata.chapter)}}">
          <view class="ai-head">
            <text class="detail-label">AI 建议</text>
            <text class="ai-confidence" wx:if="{{item._aiConfidencePct !== null}}">置信度 {{item._aiConfidencePct}}%</text>
          </view>
          <text class="ai-chapter" wx:if="{{item.ai_metadata.chapter}}">章节：{{item.ai_metadata.chapter}}</text>
          <view class="ai-tags" wx:if="{{item._aiKps.length}}">
            <text class="ai-tag" wx:for="{{item._aiKps}}" wx:for-item="kp" wx:key="*this">{{kp}}</text>
          </view>
          <view class="ai-suggestion" wx:if="{{item._aiSuggestion}}">
            <text class="ai-sg-row" wx:if="{{item._aiSuggestion.answer}}">
              <text class="ai-warn">⚠ AI 建议答案：</text>{{item._aiSuggestion.answer}}（需人工核对）
            </text>
            <text class="ai-sg-row" wx:if="{{item._aiSuggestion.analysis}}">建议解析：{{item._aiSuggestion.analysis}}</text>
          </view>
          <button class="ai-apply-btn" wx:if="{{item.status === 'pending' && item._aiSuggestion}}" data-id="{{item.id}}" bindtap="applyAiSuggestion" catchtap>采纳 AI 建议</button>
        </view>

        <!-- AI 操作按钮 -->
        <view class="q-ai-actions" wx:if="{{item.status === 'pending'}}">
          <button class="ai-btn" data-id="{{item.id}}" bindtap="aiEnrichOne" catchtap>AI 标知识点</button>
          <button class="ai-btn" data-id="{{item.id}}" bindtap="aiCompleteOne" catchtap>AI 补缺字段</button>
        </view>

        <!-- 操作按钮 -->
        <view class="q-actions" wx:if="{{item.status === 'pending'}}">
          <button class="action-btn action-reject" data-id="{{item.id}}" bindtap="reject" catchtap>拒绝</button>
          <button class="action-btn action-approve" data-id="{{item.id}}" bindtap="approve" catchtap>通过</button>
        </view>
      </view>
    </view>
  </view>
</view>
