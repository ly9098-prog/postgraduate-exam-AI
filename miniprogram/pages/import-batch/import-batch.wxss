@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  padding-bottom: calc(132rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: #F7F5F0;
}

/* ── 顶部导航 ── */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx 16rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.05);
}

.nav-left,
.nav-right {
  min-width: 112rpx;
}

.nav-right {
  display: flex;
  justify-content: flex-end;
}

.nav-back,
.nav-action {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  font-size: 26rpx;
  color: #5B7B9A;
  font-weight: 700;
}

.nav-action {
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
}

.nav-action.cancel {
  color: #C47A7A;
  background: #F5EFEF;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #2D3E50;
}

.page-subtitle {
  font-size: 24rpx;
  color: #9AABBA;
  display: block;
  padding: 10rpx 24rpx 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(43, 60, 80, 0.04);
}

/* ── 选择提示条 ── */
.select-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 22rpx;
  background: #EDF1F5;
  margin: 18rpx 24rpx 0;
  border-radius: 22rpx;
  border: 1rpx solid rgba(91, 123, 154, 0.16);
}

.select-bar-text {
  font-size: 26rpx;
  color: #2D3E50;
  font-weight: 700;
}

.select-bar-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #5B7B9A;
  font-weight: 700;
}

/* ── 顶部操作按钮 ── */
.top-actions {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx 0;
}

.btn-batch-approve,
.btn-ai-batch {
  flex: 1;
  min-height: 76rpx;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  line-height: 76rpx;
}

.btn-batch-approve { background: #6B9B6B; }
.btn-ai-batch { background: #5B7B9A; }

.btn-batch-approve::after,
.btn-ai-batch::after,
.action-btn::after,
.ai-apply-btn::after,
.ai-btn::after,
.bar-btn::after {
  border: none;
}

.btn-batch-approve:active,
.btn-ai-batch:active,
.q-card:active,
.action-btn:active,
.ai-btn:active,
.ai-apply-btn:active,
.bar-btn:active {
  opacity: 0.84;
}

/* ── 加载态 ── */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EDF1F5;
  border-top-color: #5B7B9A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #9AABBA;
  margin-top: 16rpx;
}

/* ── 空态 ── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin: 24rpx;
  padding: 72rpx 36rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
}

.empty-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  font-size: 34rpx;
  line-height: 88rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
}

.empty-mark.danger {
  background: #F5EFEF;
  color: #C47A7A;
}

.empty-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #2D3E50;
}

/* ── 题目列表 ── */
.q-list {
  padding: 18rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.q-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFC 100%);
  border-radius: 26rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
  border: 1rpx solid rgba(232, 229, 224, 0.75);
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.q-card.selected {
  background: #F4F7FA;
  border-color: rgba(91, 123, 154, 0.42);
  box-shadow: 0 0 0 2rpx rgba(91, 123, 154, 0.18), 0 6rpx 28rpx rgba(43, 60, 80, 0.06);
}

/* ── 复选框 ── */
.q-check {
  flex-shrink: 0;
  margin-right: 18rpx;
  margin-top: 4rpx;
  min-width: 52rpx;
  min-height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-box {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 3rpx solid #D0CEC8;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}

.check-box.checked {
  background: #5B7B9A;
  border-color: #5B7B9A;
}

.check-mark {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 800;
}

.q-card-body {
  flex: 1;
  min-width: 0;
}

.q-overview {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.q-meta {
  display: flex;
  gap: 10rpx;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.q-subject-tag,
.q-ai-flag,
.q-math-flag,
.q-status-badge {
  font-size: 21rpx;
  line-height: 1.35;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.q-subject-tag {
  color: #5B7B9A;
  background: #EDF1F5;
}

.q-type-label {
  font-size: 22rpx;
  color: #9AABBA;
  line-height: 1.45;
}

.q-ai-flag {
  color: #FFFFFF;
  background: #5B7B9A;
  letter-spacing: 1rpx;
}

.q-math-flag {
  color: #C49A6B;
  background: #F5F1EB;
}

.q-status-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.q-risk-badge {
  font-size: 20rpx;
  line-height: 1.35;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  color: #FFFFFF;
  background: #C47A7A;
  font-weight: 700;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.q-status-badge {
  flex-shrink: 0;
}

.q-status-badge.pending {
  background: #F5F1EB;
  color: #C49A6B;
}

.q-status-badge.approved,
.q-status-badge.published {
  background: #EFF5EF;
  color: #6B9B6B;
}

.q-status-badge.rejected {
  background: #F5EFEF;
  color: #C47A7A;
}

.q-preview {
  font-size: 27rpx;
  color: #6B7B8D;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.55;
}

/* ── 展开区域 ── */
.q-expand-hint {
  display: flex;
  justify-content: center;
  margin-top: 14rpx;
}

.expand-arrow {
  width: 44rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 18rpx;
  color: #BCC8D4;
  transition: transform 0.2s;
}

.expand-arrow.expanded {
  transform: rotate(180deg);
}

.q-detail {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.q-detail.show {
  max-height: 4000rpx;
}

.detail-body {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EDF1F5;
}

.detail-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #5B7B9A;
  display: block;
  margin-bottom: 10rpx;
}

.req {
  color: #C47A7A;
}

.detail-picker {
  display: block;
  width: auto;
  min-width: 100%;
}

.picker-value {
  padding: 0 24rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  background: #F7F6F2;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #2D3E50;
  box-sizing: border-box;
}

.detail-text {
  font-size: 26rpx;
  color: #2D3E50;
  line-height: 1.7;
  display: block;
  word-break: break-all;
  overflow-wrap: break-word;
}

.detail-options {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-row {
  display: flex;
  gap: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.opt-key {
  color: #5B7B9A;
  font-weight: 800;
  flex-shrink: 0;
}

.opt-val {
  color: #2D3E50;
  word-break: break-all;
}

.blank-option-groups {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.blank-option-group {
  padding: 14rpx;
  border-radius: 16rpx;
  background: #F7F6F2;
}

.blank-group-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #C49A6B;
}

.detail-answer {
  font-size: 28rpx;
  font-weight: 800;
  color: #6B9B6B;
  word-break: break-all;
}

/* ── 答案快捷按钮 ── */
.answer-quick-keys {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.answer-key {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #5B7B9A;
  background: #EDF1F5;
  border-radius: 18rpx;
  border: 2rpx solid transparent;
}

.answer-key.active {
  color: #FFFFFF;
  background: #6B9B6B;
  border-color: #6B9B6B;
  box-shadow: 0 4rpx 12rpx rgba(107, 155, 107, 0.24);
}

.blank-answer-groups {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.blank-answer-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.blank-answer-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #C49A6B;
}

/* ── 操作按钮 ── */
.q-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  min-height: 76rpx;
  font-size: 26rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  line-height: 76rpx;
  font-weight: 700;
}

.action-approve {
  background: #6B9B6B;
  color: #FFFFFF;
}

.action-reject {
  background: #FFFFFF;
  color: #C47A7A;
  border: 2rpx solid #F0D5D5;
}

/* ── AI 辅助 ── */
.ai-block {
  background: #F4F7FA;
  border-radius: 18rpx;
  padding: 18rpx;
  margin-top: 18rpx;
  border-top: none;
}

.ai-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.ai-confidence {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #5B7B9A;
  background: #FFFFFF;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.ai-chapter {
  font-size: 24rpx;
  color: #6B7B8D;
  display: block;
  margin-bottom: 8rpx;
}

.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.ai-tag {
  font-size: 22rpx;
  color: #5B7B9A;
  background: #FFFFFF;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E0E7EE;
}

.ai-suggestion {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ai-sg-row {
  font-size: 24rpx;
  color: #2D3E50;
  line-height: 1.6;
  display: block;
  word-break: break-all;
}

.ai-warn {
  color: #C47A7A;
  font-weight: 800;
}

.ai-apply-btn {
  background: #FFFFFF;
  color: #5B7B9A;
  font-size: 24rpx;
  padding: 0 24rpx;
  min-height: 64rpx;
  border-radius: 999rpx;
  border: 2rpx solid #5B7B9A;
  margin-top: 14rpx;
  line-height: 64rpx;
  display: inline-block;
  font-weight: 700;
}

.q-ai-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ai-btn {
  flex: 1;
  min-height: 68rpx;
  font-size: 24rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #EDF1F5;
  color: #5B7B9A;
  border: none;
  line-height: 68rpx;
  font-weight: 700;
}

/* ── 底部操作栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -6rpx 24rpx rgba(43, 60, 80, 0.08);
  z-index: 10;
}

.safe-bottom {
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.bar-btn {
  flex: 1;
  min-height: 82rpx;
  font-size: 28rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  text-align: center;
  border: none;
  line-height: 82rpx;
  font-weight: 800;
}

.bar-reject {
  background: #FFFFFF;
  color: #C47A7A;
  border: 2rpx solid #F0D5D5;
}

.bar-approve {
  background: #6B9B6B;
  color: #FFFFFF;
}
