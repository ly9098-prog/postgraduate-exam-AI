@import '../../styles/tokens.wxss';

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  padding-bottom: 48rpx;
  overflow-x: hidden;
}

.animation-fade-in {
  animation: fadeSlideIn 0.58s ease-out;
  transform: translateZ(0);
}

/* ==================== 设置页 ==================== */

.setup {
  padding-bottom: 48rpx;
}

.practice-hero {
  margin: 24rpx 24rpx 16rpx;
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  position: relative;
  overflow: hidden;
}

.practice-hero::before {
  content: '';
  position: absolute;
  left: -82rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24) 0%, transparent 70%);
}

.practice-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -78rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.28) 0%, transparent 70%);
}

.hero-orbit {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.26);
  pointer-events: none;
}

.hero-orbit-one {
  width: 210rpx;
  height: 210rpx;
  right: 64rpx;
  top: -38rpx;
}

.hero-orbit-two {
  width: 128rpx;
  height: 128rpx;
  right: 106rpx;
  top: 2rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.28);
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

.hero-badge {
  width: 154rpx;
  height: 154rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 14rpx 34rpx rgba(43, 60, 80, 0.14);
  border: 10rpx solid rgba(255,255,255,0.26);
}

.hero-badge-main {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #617089;
  font-weight: 700;
}

.mission-strip {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 12rpx;

  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
  display: flex;
  align-items: center;
}

.mission-strip-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 0 8rpx;
}

.mission-strip-num {
  display: block;
  font-size: 27rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-strip-label {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
}

.mission-strip-divider {
  width: 1rpx;
  height: 52rpx;
  background: #DDE8FF;
}

.card {
  padding: 28rpx;
  margin: 18rpx 24rpx 0;
}

.challenge-card {
  margin-top: 16rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title,
.section-label {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #172033;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #617089;
}

.section-chip {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-label {
  margin-bottom: 20rpx;
}

/* 科目网格 */
.subject-grid {
  display: flex;
  gap: 16rpx;
}

.subject-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx 22rpx;
  background: #F7FAFF;
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

.subject-item:active,
.tap-scale {
  transform: scale(0.97);
  opacity: 0.92;
}

.subject-item.active {
  background: linear-gradient(180deg, #EEF5FF 0%, #F8FBFF 100%);
  border-color: #4F7FFF;
  box-shadow: 0 10rpx 26rpx rgba(79, 127, 255, 0.13);
}

.subject-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  color: #4F7FFF;
  font-size: 25rpx;
  line-height: 68rpx;
  text-align: center;
  font-weight: 900;
  margin-bottom: 12rpx;
  box-shadow: 0 6rpx 16rpx rgba(79, 127, 255, 0.08);
}

.subject-name {
  font-size: 26rpx;
  color: #172033;
  font-weight: 800;
  line-height: 1.35;
}

.subject-desc {
  margin-top: 5rpx;
  font-size: 20rpx;
  color: #8C9AAD;
  line-height: 1.35;
  text-align: center;
}

.subject-item.active .subject-name,
.subject-item.active .subject-icon {
  color: #4F7FFF;
}

/* 子科目 Tab */
.sub-tab-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}

.sub-tab {
  padding: 12rpx 24rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #617089;
  font-weight: 800;
  border: 2rpx solid transparent;
}

.sub-tab:active {
  transform: scale(0.97);
}

.sub-tab.active {
  background: #E8F0FF;
  color: #4F7FFF;
  border-color: #4F7FFF;
}

.mode-row {
  display: flex;
  gap: 16rpx;
}

.mode-card {
  flex: 1;
  min-height: 118rpx;
  border-radius: 24rpx;
  padding: 22rpx;
  background: #F7FAFF;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-card.active {
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 100%);
  border-color: rgba(255,255,255,0.58);
  box-shadow: 0 12rpx 28rpx rgba(79, 127, 255, 0.2);
}

.mode-title {
  display: block;
  font-size: 29rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.35;
}

.mode-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.mode-card.active .mode-title,
.mode-card.active .mode-desc {
  color: #FFFFFF;
}

/* 题数选择 */
.count-row {
  display: flex;
  gap: 16rpx;
}

.count-btn {
  flex: 1;
  text-align: center;
  min-height: 78rpx;
  line-height: 78rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #617089;
  font-weight: 800;
  transition: transform 0.15s ease, background 0.15s ease;
}

.count-btn:active {
  transform: scale(0.97);
}

.count-btn.active {
  background: linear-gradient(135deg, #E8F0FF, #F2F8FF);
  color: #4F7FFF;
  box-shadow: inset 0 0 0 2rpx rgba(79, 127, 255, 0.18);
}

.reward-preview {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #FFEEC7 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.reward-title {
  display: block;
  font-size: 24rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.35;
}

.reward-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A6425;
  line-height: 1.45;
}

.btn-start {
  display: block;
  margin: 30rpx 24rpx 0;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  min-height: 92rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.btn-start::after { border: none; }

.btn-start:active { transform: scale(0.98); opacity: 0.92; }

.btn-start[disabled] {
  background: #D8E1EF;
  color: #8C9AAD;
  box-shadow: none;
}

.pomodoro-link {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #F59E0B;
  font-weight: 700;
}

.pomodoro-link:active {
  opacity: 0.76;
}

/* ==================== 答题页 ==================== */

.practice {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
}

/* 顶部状态栏 */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 8rpx 26rpx rgba(79, 127, 255, 0.08);
  border-bottom: 1rpx solid rgba(232, 240, 255, 0.9);
}

.bar-left {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5rpx;
  min-width: 0;
}

.bar-subject {
  font-size: 22rpx;
  color: #4F7FFF;
  background: #E8F0FF;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 800;
  line-height: 1.3;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-counter {
  font-size: 31rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.25;
}

.bar-subtitle {
  font-size: 22rpx;
  color: #617089;
  line-height: 1.35;
}

.bar-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.bar-timer {
  font-size: 25rpx;
  color: #4F7FFF;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  padding: 10rpx 16rpx;
  background: #F3F7FF;
  border-radius: 999rpx;
}

.bar-sheet-btn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #172033;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 8rpx 18rpx rgba(23, 32, 51, 0.14);
}

.bar-sheet-btn:active {
  transform: scale(0.96);
}

.sheet-icon {
  color: #FFFFFF;
}

.sheet-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 15rpx;
  background: #22C55E;
  color: #fff;
  font-size: 18rpx;
  text-align: center;
  line-height: 30rpx;
  padding: 0 6rpx;
  border: 3rpx solid #FFFFFF;
  font-weight: 900;
}

/* 进度条 */
.progress-shell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx 6rpx;
}

.progress-track {
  flex: 1;
  height: 12rpx;
  background: #DDE8FF;
  overflow: hidden;
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4F7FFF 0%, #6EC1FF 62%, #22C55E 100%);
  transition: width 0.3s ease;
  border-radius: 999rpx;
  box-shadow: 0 0 18rpx rgba(79, 127, 255, 0.28);
}

.progress-label {
  width: 60rpx;
  text-align: right;
  font-size: 22rpx;
  color: #4F7FFF;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

/* 滑动容器 */
.question-area {
  flex: 1;
  overflow: hidden;
  padding: 18rpx 24rpx 0;
}

/* 题目卡片容器（带动画） */
.q-wrap {
  background: rgba(255,255,255,0.96);
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 14rpx 34rpx rgba(43, 60, 80, 0.08);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  min-height: 220rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

/* 滑出动画 */
.slide-out-left {
  transform: translateX(-60rpx);
  opacity: 0;
}

.slide-out-right {
  transform: translateX(60rpx);
  opacity: 0;
}

/* 滑入动画 */
.slide-in {
  animation: slideIn 0.15s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* 边界阻尼 */
.edge-left {
  animation: edgeBounceLeft 0.2s ease;
}

.edge-right {
  animation: edgeBounceRight 0.2s ease;
}

@keyframes edgeBounceLeft {
  0%   { transform: translateX(0); }
  40%  { transform: translateX(-20rpx); }
  100% { transform: translateX(0); }
}

@keyframes edgeBounceRight {
  0%   { transform: translateX(0); }
  40%  { transform: translateX(20rpx); }
  100% { transform: translateX(0); }
}

.q-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.q-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #4F7FFF;
  background: #E8F0FF;
  padding: 6rpx 15rpx;
  border-radius: 999rpx;
  font-weight: 900;
  line-height: 1.35;
}

.q-card-kicker {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8C9AAD;
  line-height: 1.35;
}

.q-card-index {
  width: 62rpx;
  height: 62rpx;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #FFF7E8 0%, #FFE9B8 100%);
  color: #B87509;
  line-height: 62rpx;
  text-align: center;
  font-size: 29rpx;
  font-weight: 900;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.q-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: #172033;
  word-break: break-word;
  white-space: pre-wrap;
  margin-bottom: 34rpx;
}

.q-text {
  display: block;
  white-space: pre-wrap;
}

/* 选项 */
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  background: #F7FAFF;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
}

/* 波纹反馈 */
.option-item::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(79, 127, 255, 0.12);
  transform: translate(-50%, -50%);
  transition: width 0.45s ease-out, height 0.45s ease-out, opacity 0.45s ease-out;
  opacity: 0;
  pointer-events: none;
}

.option-item:active::after,
.option-pressed::after {
  width: 200%;
  height: 200%;
  opacity: 1;
  transition: width 0.28s ease-out, height 0.28s ease-out, opacity 0s;
}

.option-item:active,
.option-pressed {
  transform: scale(0.985);
  background: #EEF5FF;
}

.option-item.selected {
  background: linear-gradient(180deg, #EEF5FF 0%, #F8FBFF 100%);
  border-color: #4F7FFF;
  box-shadow: 0 8rpx 22rpx rgba(79, 127, 255, 0.1);
}

.option-indicator {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 3rpx solid #B9C8DD;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
  transition: all 0.15s;
}

.option-indicator.checked {
  border-color: #4F7FFF;
  background: #4F7FFF;
}

.check-mark {
  width: 20rpx;
  height: 20rpx;
  color: #fff;
}

.option-item.selected .option-indicator {
  border-color: #4F7FFF;
}

.option-item.selected .option-indicator.checked {
  background: #4F7FFF;
}

.option-body {
  flex: 1;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
}

.option-key {
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
  flex-shrink: 0;
  line-height: 1.6;
}

.option-text {
  font-size: 28rpx;
  color: #18233A;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
}

.blank-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.blank-group {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #F8FBFF;
  border: 1rpx solid rgba(232, 240, 255, 0.95);
}

.blank-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.blank-group-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #4F7FFF;
}

.blank-group-hint {
  font-size: 22rpx;
  color: #8C9AAD;
}

.blank-group-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.blank-option-item {
  background: #FFFFFF;
}

/* ==================== 底部操作栏 ==================== */

.bottom-bar {
  background: rgba(255,255,255,0.94);
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(43, 60, 80, 0.06);
  border-top: 1rpx solid rgba(232, 240, 255, 0.95);
}

.bottom-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0;
  flex-shrink: 0;
}

.nav-btn:active {
  opacity: 0.72;
}

.nav-btn.disabled {
  opacity: 0.3;
}

.nav-arrow {
  width: 36rpx;
  height: 36rpx;
  color: #4F7FFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-label {
  font-size: 26rpx;
  color: #4F7FFF;
  font-weight: 800;
}

.nav-btn.disabled .nav-arrow,
.nav-btn.disabled .nav-label {
  color: #B7C4D8;
}

.nav-center {
  display: flex;
  gap: 8rpx;
  flex: 1;
  justify-content: center;
  overflow: hidden;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #D8E1EF;
  flex-shrink: 0;
  transition: all 0.2s;
}

.dot.done {
  background: #22C55E;
}

.dot.active {
  background: #4F7FFF;
  width: 26rpx;
  border-radius: 999rpx;
}

.dot.done.active {
  background: linear-gradient(90deg, #4F7FFF 0%, #22C55E 100%);
}

.btn-submit {
  width: 100%;
  background: linear-gradient(135deg, #172033 0%, #18233A 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  padding: 23rpx 0;
  border-radius: 20rpx;
  border: none;
  line-height: 1.4;
  margin-top: 16rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(23, 32, 51, 0.14);
}

.btn-submit::after { border: none; }

.btn-submit:active { transform: scale(0.99); opacity: 0.9; }


/* ==================== 答题即时反馈 ==================== */

.answer-feedback {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(178rpx + env(safe-area-inset-bottom));
  z-index: 80;
  pointer-events: none;
  animation: feedbackFloatIn 0.22s ease-out;
}

.feedback-card {
  position: relative;
  overflow: hidden;
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  box-shadow: 0 18rpx 44rpx rgba(43, 60, 80, 0.14);
  display: flex;
  align-items: center;
  gap: 18rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.answer-feedback.correct .feedback-card {
  background: linear-gradient(135deg, rgba(236, 253, 243, 0.98) 0%, rgba(248, 251, 255, 0.98) 100%);
  border-color: rgba(34, 197, 94, 0.22);
  box-shadow: 0 18rpx 44rpx rgba(34, 197, 94, 0.16);
}

.answer-feedback.wrong .feedback-card {
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.98) 0%, rgba(248, 251, 255, 0.98) 100%);
  border-color: rgba(245, 158, 11, 0.22);
  box-shadow: 0 18rpx 44rpx rgba(245, 158, 11, 0.14);
}

.feedback-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(79, 127, 255, 0.2);
  animation: feedbackPop 0.28s ease-out;
}

.answer-feedback.correct .feedback-icon-wrap {
  background: linear-gradient(135deg, #22C55E 0%, #7BD88F 100%);
  box-shadow: 0 10rpx 22rpx rgba(34, 197, 94, 0.22);
}

.answer-feedback.wrong .feedback-icon-wrap {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 10rpx 22rpx rgba(245, 158, 11, 0.2);
}

.feedback-icon {
  width: 40rpx;
  height: 40rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.feedback-copy {
  flex: 1;
  min-width: 0;
}

.feedback-title,
.feedback-detail,
.feedback-combo {
  display: block;
}

.feedback-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.feedback-detail {
  margin-top: 4rpx;
  color: #617089;
  font-size: 23rpx;
  line-height: 1.45;
}

.feedback-combo {
  margin-top: 10rpx;
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF7E8;
  color: #B87509;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  animation: comboPulse 0.5s ease-out;
}

.feedback-stars {
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  width: 112rpx;
  height: 86rpx;
  pointer-events: none;
}

.star {
  position: absolute;
  color: #F59E0B;
  font-size: 22rpx;
  opacity: 0;
  animation: starBurst 0.82s ease-out forwards;
}

.s1 { left: 12rpx; top: 28rpx; animation-delay: 0.04s; }
.s2 { left: 48rpx; top: 4rpx; animation-delay: 0.1s; }
.s3 { right: 10rpx; top: 36rpx; animation-delay: 0.16s; }
.s4 { left: 70rpx; top: 18rpx; animation-delay: 0.2s; }
.s5 { right: 48rpx; top: 8rpx; animation-delay: 0.24s; }
.s6 { left: 36rpx; bottom: 4rpx; animation-delay: 0.28s; }

/* Combo milestone effects */
.answer-feedback.combo-warm .feedback-card {
  box-shadow: 0 18rpx 44rpx rgba(34, 197, 94, 0.2);
}

.answer-feedback.combo-hot .feedback-card {
  background: linear-gradient(135deg, rgba(236, 253, 243, 0.98) 0%, rgba(255, 251, 235, 0.96) 100%);
  border-color: rgba(245, 158, 11, 0.28);
  box-shadow: 0 22rpx 52rpx rgba(245, 158, 11, 0.22);
}
.answer-feedback.combo-hot .feedback-icon-wrap {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 12rpx 28rpx rgba(245, 158, 11, 0.3);
}

.answer-feedback.combo-fire .feedback-card {
  background: linear-gradient(135deg, rgba(254, 242, 242, 0.98) 0%, rgba(255, 247, 237, 0.96) 100%);
  border-color: rgba(239, 68, 68, 0.28);
  box-shadow: 0 24rpx 56rpx rgba(239, 68, 68, 0.22);
}
.answer-feedback.combo-fire .feedback-icon-wrap {
  background: linear-gradient(135deg, #EF4444 0%, #F97316 100%);
  box-shadow: 0 14rpx 32rpx rgba(239, 68, 68, 0.34);
  animation: firePop 0.4s ease-out;
}
.answer-feedback.combo-fire .feedback-combo {
  background: linear-gradient(135deg, #FEF2F2, #FFF7ED);
  color: #DC2626;
  font-size: 26rpx;
  padding: 8rpx 18rpx;
  animation: firePop 0.5s ease-out;
}

@keyframes firePop {
  0% { transform: scale(0.7); }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

@keyframes feedbackFloatIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes feedbackPop {
  0% { transform: scale(0.78); }
  72% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes comboPulse {
  0% { transform: scale(0.9); }
  55% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes starBurst {
  0% { opacity: 0; transform: translateY(18rpx) scale(0.6) rotate(0deg); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx) scale(1.12) rotate(18deg); }
}


.submit-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 180;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(248, 250, 255, 0.72);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.submit-loading-card {
  width: 420rpx;
  padding: 48rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 36rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(238, 245, 255, 0.78));
  box-shadow: 0 28rpx 72rpx rgba(23, 32, 51, 0.18);
}

/* ==================== 加载 ==================== */

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
  min-height: 60vh;
}

/* ==================== 答题卡弹窗 ==================== */

.sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23,32,51,0.42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet-modal {
  width: 100%;
  background: #FFFFFF;
  border-radius: 34rpx 34rpx 0 0;
  padding: 34rpx 24rpx;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  overflow-y: auto;
  box-shadow: 0 -18rpx 42rpx rgba(23, 32, 51, 0.12);
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
}

.sheet-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #617089;
  line-height: 1.4;
}

.sheet-close {
  font-size: 25rpx;
  color: #4F7FFF;
  padding: 8rpx 0 8rpx 16rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.sheet-close:active {
  opacity: 0.7;
}

.sheet-stats {
  margin-bottom: 24rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #F3F7FF;
}

.sheet-stat {
  font-size: 24rpx;
  color: #4F7FFF;
  font-weight: 800;
}

.sheet-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.sheet-cell {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  color: #617089;
  background: #F7FAFF;
  border-radius: 18rpx;
  font-weight: 800;
  border: 2rpx solid transparent;
}

.sheet-cell:active {
  transform: scale(0.96);
}

.sheet-cell.done {
  background: #ECFDF3;
  color: #16823A;
}

.sheet-cell.current {
  border-color: #4F7FFF;
  color: #4F7FFF;
  background: #E8F0FF;
}

.sheet-cell.done.current {
  background: linear-gradient(135deg, #4F7FFF 0%, #22C55E 100%);
  color: #fff;
  border-color: transparent;
}

.sheet-submit {
  margin-top: 0;
}

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .hero-orbit,
  .practice-hero::before,
  .practice-hero::after,
  .subject-item,
  .mode-card,
  .count-btn,
  .progress-fill,
  .q-wrap,
  .slide-in,
  .slide-out-left,
  .slide-out-right,
  .edge-left,
  .edge-right,
  .option-item,
  .option-item::after,
  .option-indicator,
  .dot,
  .sheet-cell,
  .answer-feedback,
  .feedback-icon-wrap,
  .feedback-combo,
  .star {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* ==================== Code block ==================== */
.code-wrapper {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin: 16rpx 0 28rpx;
  overflow: hidden;
}
.code-text {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  white-space: pre;
  font-family: 'Courier New', Courier, monospace;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A2E;
}

/* Mixed mode blocks */
.mixed-text-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-latex-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-code-block {
  margin: 16rpx 0 28rpx;
}

/* ==================== Recommend Reason Bar ==================== */
.recommend-reason-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  margin: 0 0 12rpx 0;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.08) 0%, rgba(34, 197, 94, 0.06) 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #4F7FFF;
}

.recommend-reason-text {
  font-size: 24rpx;
  color: #4F7FFF;
  font-weight: 500;
  line-height: 1.5;
}
