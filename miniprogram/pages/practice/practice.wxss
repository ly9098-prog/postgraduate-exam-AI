@import '../../styles/tokens.wxss';

/* 原生 page 节点负责覆盖滚动回弹、下拉等区域 */
page {
  min-height: 100vh;
  background: #EEF5FF;
  background-color: #EEF5FF;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFF 0%, #EEF5FF 100%);
  background-color: #EEF5FF;
  padding-bottom: 48rpx;
  overflow-x: hidden;
}

.animation-fade-in {
  animation: fadeSlideIn 0.58s ease-out;
  transform: translateZ(0);
}

/* ==================== 设置页 ==================== */

.setup {
  padding: 24rpx 0 48rpx;
}

.practice-hero {
  margin: 0 24rpx 16rpx;
  padding: 36rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  box-shadow: 0 18rpx 46rpx rgba(79, 127, 255, 0.22);
  position: relative;
  overflow: hidden;
  background-color: #4F7FFF;
}

.practice-hero::before {
  content: '';
  position: absolute;
  left: -82rpx;
  bottom: -92rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(34, 197, 94, 0.24) 0%, transparent 70%);
}

.practice-hero::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -78rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,255,255,0.28) 0%, transparent 70%);
}

.hero-orbit {
  position: absolute;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,0.26);
  pointer-events: none;
}

.hero-orbit-one {
  width: 210rpx;
  height: 210rpx;
  right: 64rpx;
  top: -38rpx;
}

.hero-orbit-two {
  width: 128rpx;
  height: 128rpx;
  right: 106rpx;
  top: 2rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: inline-block;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.28);
  font-size: 22rpx;
  line-height: 1.35;
  color: rgba(255,255,255,0.9);
  font-weight: 800;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.16;
  color: #FFFFFF;
  letter-spacing: 0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}

.hero-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255,255,255,0.8);
}

.hero-badge {
  width: 154rpx;
  height: 154rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  box-shadow: 0 14rpx 34rpx rgba(43, 60, 80, 0.14);
  border: 10rpx solid rgba(255,255,255,0.26);
}

.hero-badge-main {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #4F7FFF;
  font-variant-numeric: tabular-nums;
}

.hero-badge-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #617089;
  font-weight: 700;
}

.mission-strip {
  margin: 0 24rpx 18rpx;
  padding: 22rpx 12rpx;
  background: rgba(255, 255, 255, 0.96);
  display: flex;
  align-items: center;
}

.mission-strip-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 0 8rpx;
}

.mission-strip-num {
  display: block;
  font-size: 27rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-strip-label {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #617089;
  line-height: 1.35;
}

.mission-strip-divider {
  width: 1rpx;
  height: 52rpx;
  background: #DDE8FF;
}

.card {
  padding: 28rpx;
  margin: 18rpx 24rpx 0;
}

.challenge-card {
  margin-top: 16rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-title,
.section-label {
  display: block;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.3;
  color: #172033;
}

.section-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #617089;
}

.section-chip {
  flex-shrink: 0;
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-label {
  margin-bottom: 20rpx;
}

/* 纵向科目选择面板 */
.subject-panel {
  padding: 22rpx 24rpx 20rpx;
  margin-top: 16rpx;
}

.subject-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.subject-title {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.3;
}

.subject-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.subject-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #E8F0FF;
  color: #4F7FFF;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

/* 当前选择条 */
.selected-subject-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 68rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(90deg, #F1F6FF 0%, #F7FAFF 100%);
  border: 1rpx solid #E3ECFB;
  border-radius: 14rpx;
}

.selected-label {
  font-size: 22rpx;
  color: #617089;
  font-weight: 700;
  flex-shrink: 0;
}

.selected-name {
  font-size: 26rpx;
  color: #4F7FFF;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

/* 空状态 */
.subject-empty {
  padding: 32rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.subject-empty-text {
  font-size: 26rpx;
  color: #617089;
  font-weight: 800;
}

.subject-empty-hint {
  font-size: 22rpx;
  color: #8EA0BA;
}

/* 父级折叠列表 */
.subject-tree {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.subject-parent-block {
  border-radius: 18rpx;
  background: #F8FAFF;
  border: 1rpx solid #E7EEFB;
  overflow: hidden;
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.subject-parent-block.expanded {
  background: #FFFFFF;
  border-color: #C7D9FF;
  box-shadow: 0 6rpx 18rpx rgba(79, 127, 255, 0.08);
}

.subject-parent-block.selected {
  background: linear-gradient(145deg, #EEF5FF 0%, #F8FBFF 100%);
  border-color: #4F7FFF;
}

.subject-parent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  height: 84rpx;
  padding: 0 20rpx;
  background: transparent;
  transition: background 0.18s ease;
}

.subject-parent-row:active {
  opacity: 0.92;
}

.subject-parent-row.expanded {
  background: rgba(79, 127, 255, 0.05);
}

.subject-parent-row.selected {
  background: transparent;
}

.parent-main {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.parent-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #172033;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.parent-meta {
  font-size: 22rpx;
  color: #8C9AAD;
  line-height: 1.3;
  flex-shrink: 0;
}

.parent-meta-leaf {
  color: #22C55E;
  font-weight: 700;
}

.parent-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.parent-arrow {
  font-size: 24rpx;
  color: #8C9AAD;
  transition: transform 0.22s ease, color 0.22s ease;
}

.parent-arrow.up {
  transform: rotate(180deg);
  color: #4F7FFF;
}

.subject-parent-row.expanded .parent-arrow {
  transform: rotate(180deg);
  color: #4F7FFF;
}

.parent-check {
  font-size: 26rpx;
  color: #22C55E;
  font-weight: 900;
}

/* 子级 chip 网格（嵌套在父级块内部） */
.child-subject-wrap {
  padding: 14rpx 18rpx 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: linear-gradient(180deg, #F4F8FF 0%, #F9FBFF 100%);
  border-top: 1rpx dashed #DDE8FF;
  animation: subjectBodyReveal 0.22s ease-out both;
}

@keyframes subjectBodyReveal {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.child-subject-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1.5rpx solid #E3ECFB;
  color: #405176;
  font-size: 26rpx;
  font-weight: 700;
  transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, transform 0.14s ease;
}

.child-subject-chip:active {
  transform: scale(0.97);
}

.child-subject-chip.active {
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  border-color: #4F7FFF;
  box-shadow: 0 6rpx 16rpx rgba(79, 127, 255, 0.22);
  font-weight: 900;
}

.child-subject-name {
  line-height: 1.2;
}

.child-subject-check {
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}

/* 点击反馈（通用 hover-class） */
.tap-scale {
  transform: scale(0.98);
  opacity: 0.94;
}

.mode-row {
  display: flex;
  gap: 16rpx;
}

.mode-card {
  flex: 1;
  min-height: 118rpx;
  border-radius: 24rpx;
  padding: 22rpx;
  background: #F7FAFF;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-card.active {
  background: linear-gradient(145deg, #4F7FFF 0%, #6EC1FF 100%);
  border-color: rgba(255,255,255,0.58);
  box-shadow: 0 12rpx 28rpx rgba(79, 127, 255, 0.2);
}

.mode-title {
  display: block;
  font-size: 29rpx;
  font-weight: 900;
  color: #172033;
  line-height: 1.35;
}

.mode-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #617089;
  line-height: 1.45;
}

.mode-card.active .mode-title,
.mode-card.active .mode-desc {
  color: #FFFFFF;
}

/* 题数选择 */
.count-row {
  display: flex;
  gap: 16rpx;
}

.count-btn {
  flex: 1;
  text-align: center;
  min-height: 78rpx;
  line-height: 78rpx;
  background: #F7FAFF;
  border-radius: 999rpx;
  font-size: 27rpx;
  color: #617089;
  font-weight: 800;
  transition: transform 0.15s ease, background 0.15s ease;
}

.count-btn:active {
  transform: scale(0.97);
}

.count-btn.active {
  background: linear-gradient(135deg, #E8F0FF, #F2F8FF);
  color: #4F7FFF;
  box-shadow: inset 0 0 0 2rpx rgba(79, 127, 255, 0.18);
}

.reward-preview {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #FFF7E8 0%, #FFEEC7 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.reward-title {
  display: block;
  font-size: 24rpx;
  font-weight: 900;
  color: #B87509;
  line-height: 1.35;
}

.reward-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #8A6425;
  line-height: 1.45;
}

.btn-start {
  display: block;
  margin: 30rpx 24rpx 0;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 900;
  min-height: 92rpx;
  padding: 0;
  border-radius: 999rpx;
  border: none;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(79, 127, 255, 0.24);
}

.btn-start::after { border: none; }

.btn-start:active { transform: scale(0.98); opacity: 0.92; }

.btn-start[disabled] {
  background: #D8E1EF;
  color: #8C9AAD;
  box-shadow: none;
}

.pomodoro-link {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #F59E0B;
  font-weight: 700;
}

.pomodoro-link:active {
  opacity: 0.76;
}

/* ==================== 答题页 (布局容器) ==================== */

/* 顶部状态栏 */
/* ==================== 答题即时反馈 ==================== */

.answer-feedback {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(178rpx + env(safe-area-inset-bottom));
  z-index: 80;
  pointer-events: none;
  animation: feedbackFloatIn 0.22s ease-out;
}

.feedback-card {
  position: relative;
  overflow: hidden;
  min-height: 116rpx;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(232, 240, 255, 0.95);
  box-shadow: 0 18rpx 44rpx rgba(43, 60, 80, 0.14);
  display: flex;
  align-items: center;
  gap: 18rpx;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.answer-feedback.correct .feedback-card {
  background: linear-gradient(135deg, rgba(236, 253, 243, 0.98) 0%, rgba(248, 251, 255, 0.98) 100%);
  border-color: rgba(34, 197, 94, 0.22);
  box-shadow: 0 18rpx 44rpx rgba(34, 197, 94, 0.16);
}

.answer-feedback.wrong .feedback-card {
  background: linear-gradient(135deg, rgba(255, 247, 237, 0.98) 0%, rgba(248, 251, 255, 0.98) 100%);
  border-color: rgba(245, 158, 11, 0.22);
  box-shadow: 0 18rpx 44rpx rgba(245, 158, 11, 0.14);
}

.feedback-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4F7FFF 0%, #6EC1FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 10rpx 22rpx rgba(79, 127, 255, 0.2);
  animation: feedbackPop 0.28s ease-out;
}

.answer-feedback.correct .feedback-icon-wrap {
  background: linear-gradient(135deg, #22C55E 0%, #7BD88F 100%);
  box-shadow: 0 10rpx 22rpx rgba(34, 197, 94, 0.22);
}

.answer-feedback.wrong .feedback-icon-wrap {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 10rpx 22rpx rgba(245, 158, 11, 0.2);
}

.feedback-icon {
  width: 40rpx;
  height: 40rpx;
  color: #FFFFFF;
  flex-shrink: 0;
}

.feedback-copy {
  flex: 1;
  min-width: 0;
}

.feedback-title,
.feedback-detail,
.feedback-combo {
  display: block;
}

.feedback-title {
  color: #172033;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.3;
}

.feedback-detail {
  margin-top: 4rpx;
  color: #617089;
  font-size: 23rpx;
  line-height: 1.45;
}

.feedback-combo {
  margin-top: 10rpx;
  display: inline-block;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF7E8;
  color: #B87509;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
  animation: comboPulse 0.5s ease-out;
}

.feedback-stars {
  position: absolute;
  top: 10rpx;
  right: 16rpx;
  width: 112rpx;
  height: 86rpx;
  pointer-events: none;
}

.star {
  position: absolute;
  color: #F59E0B;
  font-size: 22rpx;
  opacity: 0;
  animation: starBurst 0.82s ease-out forwards;
}

.s1 { left: 12rpx; top: 28rpx; animation-delay: 0.04s; }
.s2 { left: 48rpx; top: 4rpx; animation-delay: 0.1s; }
.s3 { right: 10rpx; top: 36rpx; animation-delay: 0.16s; }
.s4 { left: 70rpx; top: 18rpx; animation-delay: 0.2s; }
.s5 { right: 48rpx; top: 8rpx; animation-delay: 0.24s; }
.s6 { left: 36rpx; bottom: 4rpx; animation-delay: 0.28s; }

/* Combo milestone effects */
.answer-feedback.combo-warm .feedback-card {
  box-shadow: 0 18rpx 44rpx rgba(34, 197, 94, 0.2);
}

.answer-feedback.combo-hot .feedback-card {
  background: linear-gradient(135deg, rgba(236, 253, 243, 0.98) 0%, rgba(255, 251, 235, 0.96) 100%);
  border-color: rgba(245, 158, 11, 0.28);
  box-shadow: 0 22rpx 52rpx rgba(245, 158, 11, 0.22);
}
.answer-feedback.combo-hot .feedback-icon-wrap {
  background: linear-gradient(135deg, #F59E0B 0%, #FFD166 100%);
  box-shadow: 0 12rpx 28rpx rgba(245, 158, 11, 0.3);
}

.answer-feedback.combo-fire .feedback-card {
  background: linear-gradient(135deg, rgba(254, 242, 242, 0.98) 0%, rgba(255, 247, 237, 0.96) 100%);
  border-color: rgba(239, 68, 68, 0.28);
  box-shadow: 0 24rpx 56rpx rgba(239, 68, 68, 0.22);
}
.answer-feedback.combo-fire .feedback-icon-wrap {
  background: linear-gradient(135deg, #EF4444 0%, #F97316 100%);
  box-shadow: 0 14rpx 32rpx rgba(239, 68, 68, 0.34);
  animation: firePop 0.4s ease-out;
}
.answer-feedback.combo-fire .feedback-combo {
  background: linear-gradient(135deg, #FEF2F2, #FFF7ED);
  color: #DC2626;
  font-size: 26rpx;
  padding: 8rpx 18rpx;
  animation: firePop 0.5s ease-out;
}

@keyframes firePop {
  0% { transform: scale(0.7); }
  60% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

@keyframes feedbackFloatIn {
  from { opacity: 0; transform: translateY(24rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes feedbackPop {
  0% { transform: scale(0.78); }
  72% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes comboPulse {
  0% { transform: scale(0.9); }
  55% { transform: scale(1.08); }
  100% { transform: scale(1); }
}

@keyframes starBurst {
  0% { opacity: 0; transform: translateY(18rpx) scale(0.6) rotate(0deg); }
  35% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-22rpx) scale(1.12) rotate(18deg); }
}


.submit-loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 180;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(248, 250, 255, 0.72);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
}

.submit-loading-card {
  width: 420rpx;
  padding: 48rpx 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 36rpx;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.92), rgba(238, 245, 255, 0.78));
  box-shadow: 0 28rpx 72rpx rgba(23, 32, 51, 0.18);
}

/* ==================== 加载 ==================== */

.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 180rpx 0;
  min-height: 60vh;
}

@media (prefers-reduced-motion: reduce) {
  .page { opacity: 1 !important; }
  .hero-orbit,
  .practice-hero::before,
  .practice-hero::after,
  .subject-parent-row,
  .child-subject-chip,
  .mode-card,
  .count-btn,
  .progress-fill,
  .q-wrap,
  .slide-in,
  .slide-out-left,
  .slide-out-right,
  .edge-left,
  .edge-right,
  .option-item,
  .option-item::after,
  .option-indicator,
  .dot,
  .sheet-cell,
  .answer-feedback,
  .feedback-icon-wrap,
  .feedback-combo,
  .star {
    animation: none !important;
    transition: none !important;
    transform: none !important;
  }
}

/* ==================== Code block ==================== */
.code-wrapper {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  margin: 16rpx 0 28rpx;
  overflow: hidden;
}
.code-text {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  white-space: pre;
  font-family: 'Courier New', Courier, monospace;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A2E;
}

/* Mixed mode blocks */
.mixed-text-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-latex-block {
  display: block;
  margin-bottom: 18rpx;
}
.mixed-code-block {
  margin: 16rpx 0 28rpx;
}

/* ==================== Recommend Reason Bar ==================== */
.recommend-reason-bar {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  margin: 0 0 12rpx 0;
  background: linear-gradient(135deg, rgba(79, 127, 255, 0.08) 0%, rgba(34, 197, 94, 0.06) 100%);
  border-radius: 12rpx;
  border-left: 6rpx solid #4F7FFF;
}

.recommend-reason-text {
  font-size: 24rpx;
  color: #4F7FFF;
  font-weight: 500;
  line-height: 1.5;
}
