<view class="page">
  <!-- ==================== 设置页 ==================== -->
  <view class="setup" wx:if="{{!started}}">
    <view class="practice-hero">
      <view class="hero-copy">
        <text class="eyebrow">智能刷题</text>
        <text class="hero-title">随机练习</text>
        <text class="hero-desc">选择科目、模式和题量，开始一组专注练习</text>
      </view>
      <view class="hero-badge">
        <text class="hero-badge-main">练</text>
        <text class="hero-badge-label">本组 {{count}} 题</text>
      </view>
    </view>

    <view class="card">
      <view class="section-head">
        <view>
          <text class="section-title">选择科目</text>
          <text class="section-subtitle">先确定本组练习范围</text>
        </view>
        <text class="section-chip">科目</text>
      </view>
      <view class="subject-grid">
        <view
          class="subject-item {{selectedSubject==='math2' ? 'active' : ''}}"
          bindtap="chooseSubject" data-subject="math2"
        >
          <text class="subject-icon">数</text>
          <text class="subject-name">数学二</text>
        </view>
        <view
          class="subject-item {{selectedSubject==='exam408' ? 'active' : ''}}"
          bindtap="chooseSubject" data-subject="exam408"
        >
          <text class="subject-icon">408</text>
          <text class="subject-name">408</text>
        </view>
        <view
          class="subject-item {{selectedSubject==='english' ? 'active' : ''}}"
          bindtap="chooseSubject" data-subject="english"
        >
          <text class="subject-icon">英</text>
          <text class="subject-name">英语</text>
        </view>
      </view>

      <!-- 408 子科目 -->
      <view wx:if="{{selectedSubject==='exam408' || selectedSubject==='exam408-ds' || selectedSubject==='exam408-os' || selectedSubject==='exam408-co' || selectedSubject==='exam408-cn'}}" class="sub-tab-row">
        <view class="sub-tab {{selectedSubject==='exam408' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="exam408">全部</view>
        <view class="sub-tab {{selectedSubject==='exam408-ds' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="exam408-ds">DS</view>
        <view class="sub-tab {{selectedSubject==='exam408-os' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="exam408-os">OS</view>
        <view class="sub-tab {{selectedSubject==='exam408-co' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="exam408-co">CO</view>
        <view class="sub-tab {{selectedSubject==='exam408-cn' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="exam408-cn">CN</view>
      </view>

      <!-- 数学二子科目 -->
      <view wx:if="{{selectedSubject==='math2' || selectedSubject==='math2-calculus' || selectedSubject==='math2-linalg'}}" class="sub-tab-row">
        <view class="sub-tab {{selectedSubject==='math2' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="math2">全部</view>
        <view class="sub-tab {{selectedSubject==='math2-calculus' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="math2-calculus">高数</view>
        <view class="sub-tab {{selectedSubject==='math2-linalg' ? 'active' : ''}}" bindtap="chooseSubject" data-subject="math2-linalg">线代</view>
      </view>
    </view>

    <view class="card" wx:if="{{selectedSubject}}">
      <view class="section-head">
        <view>
          <text class="section-title">刷题模式</text>
          <text class="section-subtitle">随机更适合查漏，顺序更适合系统复习</text>
        </view>
        <text class="section-chip">模式</text>
      </view>
      <view class="count-row">
        <view class="count-btn {{selectedMode==='random' ? 'active' : ''}}" bindtap="chooseMode" data-mode="random">随机</view>
        <view class="count-btn {{selectedMode==='sequential' ? 'active' : ''}}" bindtap="chooseMode" data-mode="sequential">顺序</view>
      </view>
    </view>

    <view class="card" wx:if="{{selectedSubject}}">
      <view class="section-head">
        <view>
          <text class="section-title">题数</text>
          <text class="section-subtitle">短练习保持手感，长练习适合整组复盘</text>
        </view>
        <text class="section-chip">{{count}} 题</text>
      </view>
      <view class="count-row">
        <view class="count-btn {{count===5 ? 'active' : ''}}" bindtap="setCount" data-count="5">5 题</view>
        <view class="count-btn {{count===10 ? 'active' : ''}}" bindtap="setCount" data-count="10">10 题</view>
        <view class="count-btn {{count===20 ? 'active' : ''}}" bindtap="setCount" data-count="20">20 题</view>
      </view>
    </view>

    <button
      class="btn-start"
      disabled="{{!selectedSubject}}"
      bindtap="startPractice"
    >
      开始练习
    </button>
  </view>

  <!-- ==================== 答题页 ==================== -->
  <view class="practice" wx:if="{{started && !loading}}">
    <!-- 顶部状态栏 -->
    <view class="top-bar">
      <view class="bar-left">
        <text class="bar-subject">{{subjectLabel(selectedSubject)}}</text>
        <text class="bar-counter">{{currentIndex + 1}} / {{totalQuestions || 0}}</text>
      </view>
      <view class="bar-right">
        <text class="bar-timer">{{elapsedText}}</text>
        <view class="bar-sheet-btn" bindtap="toggleSheet">
          <text class="sheet-icon">卡</text>
          <text class="sheet-badge" wx:if="{{answeredCount > 0}}">{{answeredCount}}</text>
        </view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-track">
      <view class="progress-fill" style="width:{{totalQuestions > 0 ? (currentIndex + 1) / totalQuestions * 100 : 0}}%"></view>
    </view>

    <!-- 滑动容器 -->
    <view
      class="question-area"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <!-- 题目卡片 -->
      <view class="q-wrap {{animClass}}" wx:if="{{currentQuestion}}">
        <view class="q-badge">{{currentQuestion.question_type === 'multi_blank_choice' || currentQuestion._hasBlankOptionGroups ? '多空选择题' : currentQuestion.question_type === 'multiple_choice' ? '多选题' : currentQuestion.question_type === 'true_false' || currentQuestion.question_type === 'judgement' ? '判断题' : '单选题'}}</view>
        <block wx:if="{{enableMathImage && currentQuestion.content.render_mode === 'segments'}}">
          <math-question segments="{{currentQuestion._segments}}" />
        </block>
        <block wx:else>
          <mp-html wx:if="{{currentQuestion._stemNeedsRich}}" class="q-content" content="{{currentQuestion._stemHtml}}" lazy-load></mp-html>
          <text wx:else class="q-content q-text">{{currentQuestion._stemText}}</text>
        </block>

        <!-- 多空选择题选项 -->
        <view class="blank-options" wx:if="{{currentQuestion._hasBlankOptionGroups}}">
          <view class="blank-group" wx:for="{{currentQuestion._blankOptionGroups}}" wx:for-item="group" wx:key="id">
            <view class="blank-group-head">
              <text class="blank-group-title">{{group.id}}</text>
              <text class="blank-group-hint">请选择该空答案</text>
            </view>
            <view class="blank-group-options">
              <view
                wx:for="{{group.options}}"
                wx:for-item="opt"
                wx:key="key"
                class="option-item blank-option-item {{opt._selected ? 'selected' : ''}}"
                bindtap="selectBlankOption"
                data-blank-id="{{group.id}}"
                data-option="{{opt.key}}"
              >
                <view class="option-indicator {{opt._selected ? 'checked' : ''}}">
                  <text wx:if="{{opt._selected}}" class="check-mark">●</text>
                </view>
                <view class="option-body">
                  <text class="option-key">{{opt.key}}.</text>
                  <mp-html wx:if="{{opt._needsRich}}" content="{{opt._html}}" style="display:inline-block"></mp-html>
                  <text wx:else class="option-text">{{opt._text}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 选项 -->
        <view class="options" wx:elif="{{optionKeys.length > 0}}">
          <view
            wx:for="{{optionKeys}}"
            wx:key="*this"
            class="option-item {{selectedFlags[item] ? 'selected' : ''}}"
            bindtap="selectOption"
            data-option="{{item}}"
          >
            <view class="option-indicator {{selectedFlags[item] ? 'checked' : ''}}">
              <text wx:if="{{selectedFlags[item]}}" class="check-mark">{{selectedFlags[item] && currentQuestion.question_type === 'multiple_choice' ? '✓' : '●'}}</text>
            </view>
            <view class="option-body">
              <text class="option-key">{{item}}.</text>
              <mp-html wx:if="{{currentQuestion._optNeedsRich[item]}}" content="{{currentQuestion._optHtml[item]}}" style="display:inline-block"></mp-html>
              <text wx:else class="option-text">{{currentQuestion._optText[item]}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <view class="bottom-inner">
        <view class="nav-btn prev {{currentIndex <= 0 ? 'disabled' : ''}}" bindtap="goPrev">
          <text class="nav-arrow">‹</text>
          <text class="nav-label">上一题</text>
        </view>

        <view class="nav-center">
          <view class="dot {{index === currentIndex ? 'active' : ''}}" wx:for="{{questions}}" wx:key="index" data-index="{{index}}" bindtap="goQuestion"></view>
        </view>

        <view class="nav-btn next {{currentIndex >= totalQuestions - 1 ? 'disabled' : ''}}" bindtap="goNext">
          <text class="nav-label">下一题</text>
          <text class="nav-arrow">›</text>
        </view>
      </view>
      <button class="btn-submit" bindtap="doSubmit" loading="{{submitting}}">
        交卷（{{answeredCount || 0}}/{{totalQuestions || 0}}）
      </button>
    </view>
  </view>

  <!-- 加载 -->
  <view class="loading-wrap" wx:if="{{started && loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载题目中...</text>
  </view>

  <!-- ==================== 答题卡弹窗 ==================== -->
  <view class="sheet-overlay" wx:if="{{showSheet}}" bindtap="closeSheet">
    <view class="sheet-modal" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">答题卡</text>
        <text class="sheet-close" bindtap="closeSheet">关闭</text>
      </view>
      <view class="sheet-stats">
        <text class="sheet-stat">已完成 {{answeredCount || 0}} / {{totalQuestions || 0}} 题</text>
      </view>
      <view class="sheet-grid">
        <view
          wx:for="{{questions}}"
          wx:key="id"
          class="sheet-cell {{item._answered ? 'done' : ''}} {{currentIndex === index ? 'current' : ''}}"
          data-index="{{index}}"
          bindtap="goQuestion"
        >
          {{index + 1}}
        </view>
      </view>
      <button class="btn-submit sheet-submit" bindtap="doSubmit">交卷</button>
    </view>
  </view>
</view>
