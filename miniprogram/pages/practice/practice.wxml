<view class="page">
  <view class="submit-loading-mask" wx:if="{{submitting}}" catchtap="noop">
    <view class="submit-loading-card">
      <loading-lottie text="正在批改..." size="large" />
    </view>
  </view>

  <!-- ==================== 设置页 ==================== -->
  <view class="setup" wx:if="{{!started}}">
    <view class="practice-hero hero-panel motion-card-enter">
      <view class="hero-orbit hero-orbit-one"></view>
      <view class="hero-orbit hero-orbit-two"></view>
      <view class="hero-copy">
        <text class="eyebrow">今日挑战 · {{count}} 题</text>
        <text class="hero-title">把薄弱点练成得分点</text>
        <text class="hero-desc">选择一组专注练习，完成后收获成长值和复盘线索</text>
      </view>
      <view class="hero-badge">
        <text class="hero-badge-main">+{{count * 6}}</text>
        <text class="hero-badge-label">成长值</text>
      </view>
    </view>

    <view class="mission-strip learning-card motion-card-enter motion-delay-1">
      <view class="mission-strip-item">
        <text class="mission-strip-num">{{selectedSubjectName || '待选择'}}</text>
        <text class="mission-strip-label">当前科目</text>
      </view>
      <view class="mission-strip-divider"></view>
      <view class="mission-strip-item">
        <text class="mission-strip-num">{{modeLabel(selectedMode)}}</text>
        <text class="mission-strip-label">出题节奏</text>
      </view>
      <view class="mission-strip-divider"></view>
      <view class="mission-strip-item">
        <text class="mission-strip-num">{{count}}题</text>
        <text class="mission-strip-label">本组目标</text>
      </view>
    </view>

    <view class="card learning-card subject-panel">
      <view class="subject-header">
        <view>
          <text class="subject-title">选择科目</text>
          <text class="subject-desc">点击父级展开子级，再选择练习范围</text>
        </view>
        <text class="subject-badge">科目</text>
      </view>

      <view class="selected-subject-bar">
        <text class="selected-label">当前选择</text>
        <text class="selected-name">{{selectedSubjectName || '请选择科目'}}</text>
      </view>

      <!-- 空状态 -->
      <view class="subject-empty" wx:if="{{!subjectTree || subjectTree.length === 0}}">
        <text class="subject-empty-text">暂无可练习科目</text>
        <text class="subject-empty-hint">请先在后台添加并启用科目</text>
      </view>

      <!-- 纵向父级折叠列表 -->
      <view class="subject-tree" wx:else>
        <view
          wx:for="{{subjectTree}}"
          wx:key="subject_id"
          class="subject-parent-block {{expandedSubjectId === item.subject_id ? 'expanded' : ''}} {{selectedSubjectId === item.subject_id && (!item.children || item.children.length === 0) ? 'selected' : ''}}"
        >
          <!-- 父级行：点击展开/收起 -->
          <view
            class="subject-parent-row {{expandedSubjectId === item.subject_id ? 'expanded' : ''}} {{selectedSubjectId === item.subject_id && (!item.children || item.children.length === 0) ? 'selected' : ''}}"
            hover-class="tap-scale"
            bindtap="toggleParentSubject"
            data-subject-id="{{item.subject_id}}"
            data-subject-name="{{item.display_name}}"
            data-has-children="{{item.children && item.children.length > 0}}"
          >
            <view class="parent-main">
              <text class="parent-name">{{item.display_name}}</text>
              <text class="parent-meta" wx:if="{{item.children && item.children.length > 0}}">
                {{item.children.length}} 个子科目
              </text>
              <text class="parent-meta parent-meta-leaf" wx:else>可直接选择</text>
            </view>
            <view class="parent-right">
              <text
                class="parent-check line-icon icon-check"
                wx:if="{{selectedSubjectId === item.subject_id && (!item.children || item.children.length === 0)}}"
              ></text>
              <text
                class="parent-arrow line-icon icon-chevron-down {{expandedSubjectId === item.subject_id ? 'up' : ''}}"
                wx:if="{{item.children && item.children.length > 0}}"
              ></text>
            </view>
          </view>

          <!-- 子级 chip 网格：嵌套在父级内部，仅该父级展开时渲染 -->
          <view
            class="child-subject-wrap"
            wx:if="{{expandedSubjectId === item.subject_id && item.children && item.children.length > 0}}"
          >
            <view
              wx:for="{{item.children}}"
              wx:key="subject_id"
              class="child-subject-chip {{selectedSubjectId === item.subject_id ? 'active' : ''}}"
              hover-class="tap-scale"
              catchtap="chooseChildSubject"
              data-subject-id="{{item.subject_id}}"
              data-subject-name="{{item.display_name}}"
            >
              <text class="child-subject-name">{{item.display_name}}</text>
              <text
                class="child-subject-check line-icon icon-check"
                wx:if="{{selectedSubjectId === item.subject_id}}"
              ></text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="card learning-card" wx:if="{{selectedSubjectId}}">
      <view class="section-head">
        <view>
          <text class="section-title">挑战模式</text>
          <text class="section-subtitle">随机查漏，顺序巩固，把节奏交给今天的状态</text>
        </view>
        <text class="section-chip">{{modeLabel(selectedMode)}}</text>
      </view>
      <view class="mode-row">
        <view class="mode-card {{selectedMode==='random' ? 'active' : ''}}" bindtap="chooseMode" data-mode="random">
          <text class="mode-title">随机挑战</text>
          <text class="mode-desc">更适合查漏补缺</text>
        </view>
        <view class="mode-card {{selectedMode==='sequential' ? 'active' : ''}}" bindtap="chooseMode" data-mode="sequential">
          <text class="mode-title">顺序推进</text>
          <text class="mode-desc">更适合体系复习</text>
        </view>
        <view class="mode-card {{selectedMode==='smart' ? 'active' : ''}}" bindtap="chooseMode" data-mode="smart">
          <text class="mode-title">智能推荐</text>
          <text class="mode-desc">根据薄弱点推荐</text>
        </view>
      </view>
    </view>

    <view class="card learning-card" wx:if="{{selectedSubjectId}}">
      <view class="section-head">
        <view>
          <text class="section-title">设定本组目标</text>
          <text class="section-subtitle">完成越多，成长值越高</text>
        </view>
        <text class="section-chip">+{{count * 6}}</text>
      </view>
      <view class="count-row">
        <view class="count-btn {{count===5 ? 'active' : ''}}" bindtap="setCount" data-count="5">5 题</view>
        <view class="count-btn {{count===10 ? 'active' : ''}}" bindtap="setCount" data-count="10">10 题</view>
        <view class="count-btn {{count===20 ? 'active' : ''}}" bindtap="setCount" data-count="20">20 题</view>
      </view>
      <view class="reward-preview">
        <text class="reward-title">完成奖励</text>
        <text class="reward-desc">成长值 +{{count * 6}} · 连续学习记录 +1 · 生成本组复盘</text>
      </view>
    </view>

    <button
      class="btn-start"
      disabled="{{!selectedSubjectId}}"
      bindtap="startPractice"
    >
      {{selectedSubjectId ? '开始挑战' : '先选择科目'}}
    </button>
    <view class="pomodoro-link" wx:if="{{selectedSubjectId}}" bindtap="goPomodoro">
      <text>先用番茄钟锁定一段专注时间</text>
    </view>
  </view>

  <!-- ==================== 答题页 ==================== -->
  <view class="practice" wx:if="{{started && !loading}}">
    <!-- 顶部状态栏 -->
    <view class="top-bar">
      <view class="bar-left">
        <text class="bar-subject">{{selectedSubjectName}}</text>
        <text class="bar-counter">第 {{currentIndex + 1}} / {{totalQuestions || 0}} 题</text>
        <text class="bar-subtitle">已完成 {{answeredCount || 0}} 题</text>
      </view>
      <view class="bar-right">
        <text class="bar-timer">{{elapsedText}}</text>
        <view class="bar-sheet-btn" bindtap="toggleSheet">
          <text class="sheet-icon line-icon icon-list"></text>
          <text class="sheet-badge" wx:if="{{answeredCount > 0}}">{{answeredCount}}</text>
        </view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-shell">
      <view class="progress-track">
        <view class="progress-fill" style="width:{{totalQuestions > 0 ? (answeredCount || 0) / totalQuestions * 100 : 0}}%"></view>
      </view>
      <text class="progress-label">{{totalQuestions > 0 ? Math.round((answeredCount || 0) / totalQuestions * 100) : 0}}%</text>
    </view>

    <!-- 滑动容器 -->
    <view
      class="question-area"
      bindtouchstart="onTouchStart"
      bindtouchend="onTouchEnd"
    >
      <!-- 题目卡片 -->
      <view class="q-wrap {{animClass}}" wx:if="{{currentQuestion}}" wx:key="{{currentIndex}}-{{_renderKey}}">
        <view class="q-card-head">
          <view>
            <text class="q-badge">{{currentQuestion.question_type === 'multi_blank_choice' || currentQuestion._hasBlankOptionGroups ? '多空选择题' : currentQuestion.question_type === 'multiple_choice' ? '多选题' : currentQuestion.question_type === 'true_false' || currentQuestion.question_type === 'judgement' ? '判断题' : '单选题'}}</text>
            <text class="q-card-kicker">保持节奏，认真读题</text>
          </view>
          <text class="q-card-index">{{currentIndex + 1}}</text>
        </view>
        <!-- Phase 2: 推荐原因标签 -->
        <view class="recommend-reason-bar" wx:if="{{currentQuestion.recommend_reason}}">
          <text class="recommend-reason-text">{{currentQuestion.recommend_reason}}</text>
        </view>
        <block wx:if="{{currentQuestion._renderModel.mode === 'SEGMENTS'}}" wx:key="segments">
          <math-question segments="{{currentQuestion._renderModel.segments}}" />
        </block>
        <rich-text wx:elif="{{currentQuestion._renderModel.mode === 'RICH_TEXT'}}" wx:key="rich-text" class="q-content" nodes="{{currentQuestion._renderModel.richTextNodes}}"></rich-text>
        <scroll-view wx:elif="{{currentQuestion._renderModel.mode === 'CODE'}}" wx:key="code" scroll-x class="code-wrapper"><text decode="false" space="preserve" class="code-text">{{currentQuestion._renderModel.rawText}}</text></scroll-view>
        <mp-html wx:elif="{{currentQuestion._renderModel.mode === 'LATEX'}}" wx:key="latex" class="q-content" content="{{currentQuestion._renderModel.html}}" lazy-load></mp-html>
        <block wx:elif="{{currentQuestion._renderModel.mode === 'MIXED'}}" wx:key="mixed">
          <block wx:for="{{currentQuestion._renderModel.blocks}}" wx:key="index">
            <rich-text wx:if="{{item.type === 'RICH_TEXT'}}" class="q-content mixed-text-block" nodes="{{item.richTextNodes}}" />
            <mp-html wx:elif="{{item.type === 'LATEX'}}" class="q-content mixed-latex-block" content="{{item.html}}" lazy-load />
            <scroll-view wx:elif="{{item.type === 'CODE'}}" scroll-x class="code-wrapper mixed-code-block"><text decode="false" space="preserve" class="code-text">{{item.rawText}}</text></scroll-view>
          </block>
        </block>

        <!-- 多空选择题选项 -->
        <view class="blank-options" wx:if="{{currentQuestion._hasBlankOptionGroups}}">
          <view class="blank-group" wx:for="{{currentQuestion._blankOptionGroups}}" wx:for-item="group" wx:key="id">
            <view class="blank-group-head">
              <text class="blank-group-title">{{group.id}}</text>
              <text class="blank-group-hint">请选择该空答案</text>
            </view>
            <view class="blank-group-options">
              <view
                wx:for="{{group.options}}"
                wx:for-item="opt"
                wx:key="key"
                class="option-item blank-option-item {{opt._selected ? 'selected' : ''}}"
                hover-class="option-pressed"
                bindtap="selectBlankOption"
                data-blank-id="{{group.id}}"
                data-option="{{opt.key}}"
              >
                <view class="option-indicator {{opt._selected ? 'checked' : ''}}">
                  <text wx:if="{{opt._selected}}" class="check-mark line-icon icon-dot"></text>
                </view>
                <view class="option-body">
                  <text class="option-key">{{opt.key}}.</text>
                  <mp-html wx:if="{{opt._needsRich}}" content="{{opt._html}}" style="display:inline-block"></mp-html>
                  <text wx:else class="option-text">{{opt._text}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 选项 -->
        <view class="options" wx:elif="{{currentQuestion._optionList.length > 0}}">
          <view
            wx:for="{{currentQuestion._optionList}}"
            wx:key="key"
            class="option-item {{item._selected ? 'selected' : ''}}"
            hover-class="option-pressed"
            bindtap="selectOption"
            data-option="{{item.key}}"
          >
            <view class="option-indicator {{item._selected ? 'checked' : ''}}">
              <text wx:if="{{item._selected && currentQuestion.question_type === 'multiple_choice'}}" class="check-mark line-icon icon-check"></text>
              <text wx:elif="{{item._selected}}" class="check-mark line-icon icon-dot"></text>
            </view>
            <view class="option-body">
              <text class="option-key">{{item.key}}.</text>
              <mp-html wx:if="{{item._needsRich}}" content="{{item._html}}" style="display:inline-block"></mp-html>
              <text wx:else class="option-text">{{item._text}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar">
      <view class="bottom-inner">
        <view class="nav-btn prev {{currentIndex <= 0 ? 'disabled' : ''}}" bindtap="goPrev">
          <text class="nav-arrow line-icon icon-chevron-left"></text>
          <text class="nav-label">上一题</text>
        </view>

        <view class="nav-center">
          <view class="dot {{item._answered ? 'done' : ''}} {{index === currentIndex ? 'active' : ''}}" wx:for="{{questions}}" wx:key="index" data-index="{{index}}" bindtap="goQuestion"></view>
        </view>

        <view class="nav-btn next {{currentIndex >= totalQuestions - 1 ? 'disabled' : ''}}" bindtap="goNext">
          <text class="nav-label">下一题</text>
          <text class="nav-arrow line-icon icon-chevron-right"></text>
        </view>
      </view>
      <button class="btn-submit" bindtap="doSubmit" disabled="{{submitting}}">
        交卷复盘（{{answeredCount || 0}}/{{totalQuestions || 0}}）
      </button>
    </view>

    <view class="answer-feedback {{feedbackType}} combo-{{feedbackComboLevel}}" wx:if="{{feedbackVisible}}" catchtap="noop">
      <view class="feedback-card">
        <view class="feedback-icon-wrap">
          <text wx:if="{{feedbackType === 'correct'}}" class="feedback-icon line-icon icon-check"></text>
          <text wx:elif="{{feedbackType === 'wrong'}}" class="feedback-icon line-icon icon-exclamation"></text>
          <text wx:else class="feedback-icon line-icon icon-dot"></text>
        </view>
        <view class="feedback-copy">
          <text class="feedback-title">{{feedbackTitle}}</text>
          <text class="feedback-detail">{{feedbackDetail}}</text>
          <text class="feedback-combo" wx:if="{{feedbackComboText}}">{{feedbackComboText}}</text>
        </view>
        <view class="feedback-stars" wx:if="{{feedbackType === 'correct' && feedbackStarCount >= 3}}">
          <text class="star s1">★</text>
          <text class="star s2">★</text>
          <text class="star s3">★</text>
          <text class="star s4" wx:if="{{feedbackStarCount >= 5}}">★</text>
          <text class="star s5" wx:if="{{feedbackStarCount >= 5}}">★</text>
          <text class="star s6" wx:if="{{feedbackStarCount >= 6}}">★</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载 -->
  <view class="loading-wrap" wx:if="{{started && loading}}">
    <loading-lottie text="正在生成挑战题组..." size="large" />
  </view>

  <!-- ==================== 答题卡弹窗 ==================== -->
  <view class="sheet-overlay" wx:if="{{showSheet}}" bindtap="closeSheet">
    <view class="sheet-modal" catchtap="noop">
      <view class="sheet-head">
        <view>
          <text class="sheet-title">答题进度</text>
          <text class="sheet-subtitle">点选题号快速跳转</text>
        </view>
        <text class="sheet-close" bindtap="closeSheet">关闭</text>
      </view>
      <view class="sheet-stats">
        <text class="sheet-stat">已完成 {{answeredCount || 0}} / {{totalQuestions || 0}} 题</text>
      </view>
      <view class="sheet-grid">
        <view
          wx:for="{{questions}}"
          wx:key="id"
          class="sheet-cell {{item._answered ? 'done' : ''}} {{currentIndex === index ? 'current' : ''}}"
          data-index="{{index}}"
          bindtap="goQuestion"
        >
          {{index + 1}}
        </view>
      </view>
      <button class="btn-submit sheet-submit" bindtap="doSubmit" disabled="{{submitting}}">交卷复盘</button>
    </view>
  </view>
</view>
