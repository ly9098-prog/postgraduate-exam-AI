  box-shadow: 0 13px 28px rgba(72, 102, 59, .09), inset 0 1px 0 rgba(255,255,255,.98);
}
.graph-canvas .atlas-node-group::before,
.graph-canvas .atlas-node-point::before {
  content: '';
  position: absolute;
  inset: 1px;
  border-radius: 21px;
  background: linear-gradient(145deg, rgba(255,255,255,.58), transparent 56%);
  pointer-events: none;
}
.graph-canvas .atlas-node-point.node-selected {
  z-index: 4;
  border-color: #7EAF69;
  background: #F0F8EB;
  color: #1F432E;
  box-shadow: 0 0 0 4px rgba(126,175,105,.10), 0 14px 30px rgba(63, 98, 52, .13);
  transform: translateY(-2px);
}
.graph-canvas .atlas-node-point.tone-weak { border-color: #DECDB5; background: #FFF9F0; }
.graph-canvas .atlas-node-point.tone-stable { border-color: #BCD5AF; background: #F7FBF3; }
.graph-node-pressed { transform: scale(.975) !important; }

.graph-node-icon {
  position: relative;
  z-index: 1;
