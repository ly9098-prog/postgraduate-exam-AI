}
.knowledge-index .index-search-empty-icon view {
  animation: index-search-empty-pulse 1.7s ease-in-out infinite;
}
.knowledge-index .index-search-empty-action {
  transition: transform 130ms cubic-bezier(.16,1,.3,1), background 130ms ease, box-shadow 130ms ease;
}
.knowledge-index .index-search-empty-action.index-inline-control-pressed {
  background: #E5F1ED;
  box-shadow: inset 0 0 0 1rpx #D2E7E0;
  transform: scale(.98);
}
@keyframes index-search-empty-float {
  0%, 100% { transform: translate3d(0,0,0); }
  50% { transform: translate3d(0,-3rpx,0); }
}
@keyframes index-search-empty-pulse {
  0%, 100% { opacity: .55; transform: scale(.88); }
  50% { opacity: 1; transform: scale(1.08); }
}

/* Search hits settle as a group; path-only rows remain quieter so users can scan for
   actionable labels quickly without the tree flickering between keywords. */
.knowledge-index .index-results-entering .index-row-context {
  animation: index-search-context-enter 220ms ease-out both;
}
@keyframes index-search-context-enter {
  from { opacity: .35; }
  to { opacity: .72; }
