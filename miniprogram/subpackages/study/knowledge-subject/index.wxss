/* ===== Knowledge index · debounced search & stable result transition v5 ===== */
/* Keep result replacement local to the index. Explicit height is injected only while
   switching, so large -> empty / empty -> large searches no longer collapse abruptly. */
.knowledge-index .index-results-shell {
  position: relative;
  width: 100%;
  overflow: visible;
  transition: height 220ms cubic-bezier(.22,.78,.22,1);
  will-change: height;
}
.knowledge-index .index-results-transitioning {
  overflow: hidden;
}
.knowledge-index .index-results-content {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 0;
  transform-origin: 50% 0;
  will-change: opacity, transform;
}
.knowledge-index .index-results-content.index-results-leaving {
  opacity: .18;
  transform: translate3d(0,-4rpx,0) scale(.998);
  transition: opacity 72ms ease-out, transform 72ms ease-out;
  pointer-events: none;
}
.knowledge-index .index-results-content.index-results-entering {
  animation: index-search-results-enter 210ms cubic-bezier(.16,1,.3,1) both;
}
@keyframes index-search-results-enter {
  0% { opacity: .22; transform: translate3d(0,5rpx,0) scale(.998); }
  62% { opacity: 1; }
  100% { opacity: 1; transform: translate3d(0,0,0) scale(1); }
}

/* Pending feedback is deliberately subtle: old results remain readable during the
   debounce window instead of disappearing under a loading state. */
.knowledge-index .index-inline-search-meta-pending {
  border-color: #DCEAE6;
  background: #F7FAF9;
  color: #78918B;
}
.knowledge-index .index-inline-search-meta-pending .search-pending-dot {
  animation: index-search-pending-pulse 780ms ease-in-out infinite;
}
@keyframes index-search-pending-pulse {
  0%, 100% { opacity: .42; transform: scale(.82); }
  50% { opacity: 1; transform: scale(1.18); }
}

/* The no-result card participates in the same content transition and feels less like
   a hard replacement of the tree. */
.knowledge-index .index-search-empty {
  transform-origin: 50% 0;
}
.knowledge-index .index-results-entering .index-search-empty {
  animation: index-search-empty-enter 240ms cubic-bezier(.16,1,.3,1) both;
}
@keyframes index-search-empty-enter {
  from { opacity: .25; transform: translate3d(0,8rpx,0) scale(.992); }
  to { opacity: 1; transform: translate3d(0,0,0) scale(1); }
}

/* While typing, keep the search field visually active without changing its geometry. */
.knowledge-index .index-inline-search-has-value {
