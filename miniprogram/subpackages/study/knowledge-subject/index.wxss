  border: 1rpx solid rgba(211, 226, 204, .9);
  border-radius: 999rpx;
  background: rgba(255,255,252,.93);
  box-shadow: 0 9rpx 22rpx rgba(70, 99, 58, .055), inset 0 1rpx 0 rgba(255,255,255,.98);
}
.graph-scope {
  display: flex;
  flex: 1 1 auto;
  min-width: 0;
  max-width: none;
  height: 70rpx;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
  padding: 0 18rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #536A57;
  font-size: 18rpx;
  line-height: 70rpx;
  text-align: left;
}
.graph-scope text {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.graph-pagination {
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
  height: 70rpx;
  align-items: center;
  gap: 2rpx;
  padding-right: 7rpx;
}
.graph-page-btn {
  display: flex;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
