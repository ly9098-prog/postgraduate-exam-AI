  from { opacity: .72; transform: translate3d(5rpx,0,0); }
  to { opacity: 1; transform: translate3d(0,0,0); }
}

@media (max-width: 350px) {
  .graph-card-foot { padding-left: 14rpx; padding-right: 14rpx; }
