  line-height: 1.5;
}
.graph-spark {
  position: relative;
  width: 24rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 5rpx;
}
.graph-spark view { position: absolute; left: 50%; top: 50%; width: 3rpx; height: 25rpx; border-radius: 999rpx; background: #6B9A51; transform-origin: center; }
.graph-spark view:nth-child(1) { transform: translate(-50%,-50%) rotate(0deg); }
.graph-spark view:nth-child(2) { transform: translate(-50%,-50%) rotate(45deg); }
.graph-spark view:nth-child(3) { transform: translate(-50%,-50%) rotate(90deg); }
.graph-spark view:nth-child(4) { transform: translate(-50%,-50%) rotate(135deg); }
.graph-count {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8rpx;
  padding-top: 5rpx;
  color: #657665;
  font-size: 18rpx;
  white-space: nowrap;
}
.graph-count-dot { width: 11rpx; height: 11rpx; border-radius: 50%; background: #73A45C; box-shadow: inset 0 0 0 3rpx rgba(255,255,255,.68); }

.graph-canvas.atlas-viewport {
  position: relative;
  height: 760rpx;
  overflow: hidden;
  touch-action: auto;
  background:
    radial-gradient(circle at 50% 49%, rgba(198, 224, 176, .28) 0, rgba(230, 240, 221, .18) 28%, transparent 54%),
    linear-gradient(180deg, #F9FCF6 0%, #F3F8EE 100%);
