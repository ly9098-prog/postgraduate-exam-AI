/* While the debounce/replace cycle is pending, the previous rows stay visible as
   spatial context but are temporarily non-interactive so a fast tap cannot navigate
   using stale results from the previous keyword. */
.knowledge-index .index-results-pending .index-list,
.knowledge-index .index-results-pending .index-more {
