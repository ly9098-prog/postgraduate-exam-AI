  border-radius: 25rpx;
  pointer-events: none;
}
.graph-canvas .atlas-stage {
  width: 800px;
  height: 760px;
  transition: transform .22s cubic-bezier(.16,1,.3,1);
}

.graph-canvas .atlas-edge {
  z-index: 1;
  height: 0;
  border-top: 1.5px solid rgba(115, 158, 83, .50);
  opacity: .8;
}
.graph-canvas .atlas-edge::after {
  top: -2.5px;
  right: -1px;
  width: 4px;
  height: 4px;
  background: #91B96F;
}
.graph-canvas .atlas-edge.edge-hierarchy { border-top-style: solid; }
.graph-canvas .atlas-edge.edge-membership { border-top-style: solid; }
.graph-canvas .atlas-edge.edge-active { border-top-color: #4E8A5E; opacity: 1; }

.graph-canvas .atlas-node {
  z-index: 2;
  box-sizing: border-box;
  cursor: pointer;
  transition: transform .18s cubic-bezier(.16,1,.3,1), border-color .18s ease, background .18s ease, box-shadow .18s ease;
}
.graph-canvas .atlas-node-group,
.graph-canvas .atlas-node-point {
  display: flex;
