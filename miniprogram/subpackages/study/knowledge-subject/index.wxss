    transition: none;
    animation: none;
  }
}

/* ===== Knowledge index · isolated search / explicit graph navigation v6 ===== */
/* Typing only changes the local result surface. A slim progress trace communicates
   debounce/replace work without covering the previous readable result set. */
.knowledge-index .index-results-shell::before {
  content: '';
  position: absolute;
  z-index: 6;
  left: 18rpx;
  right: 18rpx;
  top: 0;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(67,169,143,0), rgba(67,169,143,.62), rgba(67,169,143,0));
  opacity: 0;
  transform: scaleX(.18);
  transform-origin: 0 50%;
  pointer-events: none;
}
.knowledge-index .index-results-pending::before {
  opacity: .72;
  animation: index-search-progress 920ms cubic-bezier(.22,.78,.22,1) infinite;
}
@keyframes index-search-progress {
  0% { transform: translate3d(-34%,0,0) scaleX(.18); opacity: .2; }
  45% { opacity: .72; }
  100% { transform: translate3d(72%,0,0) scaleX(.42); opacity: .08; }
}

/* A real search hit is visually distinct from its ancestor-only path rows. This
   makes it clear which labels are actionable and which rows merely explain context. */
.knowledge-index .index-row-search-target:not(.index-row-selected) {
  background: linear-gradient(90deg, rgba(245,250,248,.72), rgba(255,255,255,0) 78%);
