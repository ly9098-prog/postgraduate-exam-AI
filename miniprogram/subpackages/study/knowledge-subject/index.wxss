/* MEMOGRAD Knowledge Atlas
 * 清新绿意方案：自然白与低饱和绿统一页面。
 * 卡片使用 20-28rpx 软角，输入与内容容器使用 16-20rpx，操作按钮使用 14rpx 或胶囊形。
 */
page { min-height: 100%; background: #EFF5EA; color: #1E3325; font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
.atlas-page { min-height: 100vh; box-sizing: border-box; padding: 20rpx 24rpx 52rpx; padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); background: radial-gradient(circle at 88% 1%, rgba(184,214,139,.22), transparent 370rpx), linear-gradient(180deg, #F8FAF4 0, #F1F6EC 48%, #EAF2E4 100%); }
.atlas-page button { box-sizing: border-box; margin: 0 !important; font-family: inherit; font-weight: 500; }
.atlas-page button::after { border: 0; }
.atlas-pressed { opacity: .82; transform: scale(.985); }

/* 首次加载只编排一次：科目、工具、主题、图谱依次建立。 */
.page-reveal { opacity: 0; transform: translate3d(0, 18rpx, 0); }
.page-entered .page-reveal { opacity: 1; transform: translate3d(0, 0, 0); transition: opacity .5s cubic-bezier(.16,1,.3,1), transform .62s cubic-bezier(.16,1,.3,1); }
.page-entered .reveal-tools { transition-delay: 70ms; }
.page-entered .reveal-themes { transition-delay: 120ms; }
.page-entered .reveal-graph { transition-delay: 165ms; }

/* 科目抬头：不使用卡片，依靠对齐、留白和一条结构线建立层级。 */
.subject-hero { padding: 4rpx 6rpx 28rpx; border-bottom: 1rpx solid #D6E1CF; }
.hero-topline { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 34rpx; }
.hero-context { display: flex; align-items: center; gap: 12rpx; color: #607062; font-size: 19rpx; font-weight: 600; line-height: 28rpx; letter-spacing: .5rpx; }
.hero-mark { position: relative; width: 34rpx; height: 22rpx; flex-shrink: 0; }
.hero-mark::before, .hero-mark::after { content: ''; position: absolute; left: 6rpx; top: 10rpx; width: 22rpx; height: 1rpx; background: #78945D; transform-origin: left center; }
.hero-mark::before { transform: rotate(-27deg); }
.hero-mark::after { transform: rotate(27deg); }
.hero-mark view { position: absolute; z-index: 1; width: 7rpx; height: 7rpx; border: 2rpx solid #F8FAF4; border-radius: 50%; background: #6E8A56; }
.hero-mark view:nth-child(1) { left: 0; top: 7rpx; }
.hero-mark view:nth-child(2) { right: 0; top: 0; }
.hero-mark view:nth-child(3) { right: 0; bottom: 0; background: #A8CA6E; }
.intro-syllabus { min-width: 0; color: #627165; font-size: 18rpx; line-height: 28rpx; text-align: right; }
.hero-main { display: flex; align-items: flex-end; justify-content: space-between; gap: 28rpx; margin-top: 22rpx; }
.hero-copy { flex: 1; min-width: 0; }
.intro-title { display: block; color: #10241A; font-size: 52rpx; font-weight: 760; line-height: 1.12; letter-spacing: -2rpx; overflow-wrap: break-word; }
.hero-description { display: block; margin-top: 10rpx; color: #5F6F63; font-size: 20rpx; line-height: 30rpx; }
.coverage-readout { width: 142rpx; flex-shrink: 0; padding-left: 24rpx; border-left: 1rpx solid #CBD5C9; }
.coverage-number { display: block; color: #385A36; font-size: 39rpx; font-weight: 760; line-height: 42rpx; font-variant-numeric: tabular-nums; letter-spacing: -1rpx; }
.coverage-number text { margin-left: 2rpx; font-size: 20rpx; font-weight: 650; }
.coverage-label { display: block; margin-top: 5rpx; color: #627165; font-size: 18rpx; line-height: 25rpx; }
.coverage-rule { height: 3rpx; margin-top: 10rpx; overflow: hidden; background: #D5DDD2; }
.coverage-rule view { height: 100%; background: #789E4E; }
.metric-rail { display: flex; margin-top: 28rpx; padding: 17rpx 0 15rpx; border-top: 1rpx solid #DDE3DB; }
.subject-metric { flex: 1; min-width: 0; padding: 0 22rpx; }
.subject-metric:first-child { padding-left: 0; }
.subject-metric + .subject-metric { border-left: 1rpx solid #D6DED4; }
.metric-value { display: block; color: #17271E; font-family: 'DIN Alternate', 'Avenir Next Condensed', sans-serif; font-size: 34rpx; font-weight: 700; line-height: 39rpx; font-variant-numeric: tabular-nums; }
.metric-warm { color: #876A45; }
.metric-label { display: block; margin-top: 5rpx; color: #627165; font-size: 18rpx; line-height: 25rpx; }

.refresh-notice { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 13rpx 18rpx; margin: 18rpx 0 0; border-left: 4rpx solid #A98252; background: #EEE9DE; color: #745D3E; font-size: 20rpx; line-height: 30rpx; }
.refresh-notice button { flex-shrink: 0; padding: 5rpx 13rpx; background: transparent; color: #5D4930; font-size: 20rpx; line-height: 30rpx; }

/* 搜索 + 分组标签面板：按参考稿还原层级、尺寸、圆角与选中态。 */
.atlas-tools { margin-top: 24rpx; }
.atlas-search { display: flex; align-items: center; gap: 15rpx; height: 82rpx; padding: 0 17rpx 0 21rpx; border: 1rpx solid #C7D7BE; border-radius: 20rpx; background: rgba(255,255,252,.94); box-shadow: 0 8rpx 24rpx rgba(62,91,47,.045), inset 0 1rpx 0 rgba(255,255,255,.96); transition: border-color .2s ease, box-shadow .2s ease, background .2s ease; }
.atlas-search.search-focused { border-color: #6C9758; background: #FFFFFC; box-shadow: 0 0 0 5rpx rgba(113,151,83,.09), 0 10rpx 28rpx rgba(48,82,41,.07); }
.search-symbol { position: relative; width: 23rpx; height: 23rpx; flex-shrink: 0; border: 2rpx solid #778A7B; border-radius: 50%; transition: border-color .2s ease; }
.search-symbol::after { content: ''; position: absolute; right: -8rpx; bottom: -4rpx; width: 10rpx; height: 2rpx; border-radius: 2rpx; background: #778A7B; transform: rotate(45deg); transition: background .2s ease; }
.search-focused .search-symbol { border-color: #557D43; }
.search-focused .search-symbol::after { background: #557D43; }
.search-input { flex: 1; min-width: 0; height: 78rpx; color: #22362A; font-size: 22rpx; line-height: 78rpx; caret-color: #547E40; }
.search-placeholder { color: #859286; }
.search-clear { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; flex: 0 0 46rpx; border-radius: 50%; background: #EEF2EC; transition: transform .18s ease, background .18s ease; }
.search-clear-pressed { background: #E2E9DF; transform: scale(.92); }
.clear-symbol { position: relative; width: 18rpx; height: 18rpx; transform: rotate(45deg); }
.clear-symbol::before, .clear-symbol::after { content: ''; position: absolute; left: 8rpx; top: 1rpx; width: 2rpx; height: 16rpx; border-radius: 2rpx; background: #718075; }
.clear-symbol::after { transform: rotate(90deg); }
.search-pending-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #759A58; animation: search-pending-pulse .86s ease-in-out infinite; }

.filter-theme-card { position: relative; isolation: isolate; margin-top: 16rpx; padding: 112rpx 30rpx 32rpx; overflow: hidden; border: 1rpx solid #C4D9B7; border-radius: 38rpx; background: linear-gradient(180deg, rgba(253,255,250,.99) 0%, rgba(249,252,246,.985) 52%, rgba(246,250,241,.985) 100%); box-shadow: 0 22rpx 54rpx rgba(48,82,40,.085), inset 0 1rpx 0 rgba(255,255,255,.98); }
.filter-theme-card::after { content: ''; position: absolute; z-index: -1; left: 10rpx; right: 10rpx; bottom: 8rpx; height: 220rpx; pointer-events: none; background: radial-gradient(ellipse at 20% 106%, rgba(177,209,145,.18), transparent 58%), radial-gradient(ellipse at 82% 96%, rgba(211,230,193,.30), transparent 62%), linear-gradient(180deg, transparent, rgba(233,243,225,.18)); }
.filter-card-glow { position: absolute; z-index: -1; top: -72rpx; right: -46rpx; width: 330rpx; height: 230rpx; pointer-events: none; opacity: .74; background: radial-gradient(ellipse at 34% 62%, rgba(166,202,142,.30), transparent 43%), radial-gradient(ellipse at 72% 35%, rgba(215,231,203,.78), transparent 39%); transform: rotate(-11deg); }
.filter-card-glow::before, .filter-card-glow::after { content: ''; position: absolute; border-radius: 65% 35% 62% 38% / 60% 42% 58% 40%; background: linear-gradient(145deg, rgba(129,172,103,.14), rgba(232,243,223,.42)); }
.filter-card-glow::before { width: 126rpx; height: 54rpx; right: 24rpx; top: 82rpx; transform: rotate(-28deg); }
.filter-card-glow::after { width: 98rpx; height: 44rpx; right: 96rpx; top: 112rpx; transform: rotate(15deg); }
.scope-banner { position: absolute; z-index: 2; top: -1rpx; left: -1rpx; display: flex; width: 446rpx; max-width: 68%; height: 78rpx; box-sizing: border-box; align-items: center; gap: 16rpx; padding: 0 28rpx 0 32rpx; border-radius: 33rpx 999rpx 999rpx 0; background: linear-gradient(90deg, #2A6843 0%, #2F6D48 76%, #3A774F 100%); color: #F4F8EF; box-shadow: 0 10rpx 24rpx rgba(36,93,57,.18), inset 0 1rpx 0 rgba(255,255,255,.10); font-size: 22rpx; font-weight: 600; line-height: 1; }
.scope-banner::after { content: ''; position: absolute; right: 15rpx; top: 8rpx; width: 100rpx; height: 62rpx; border-radius: 50%; opacity: .25; background: radial-gradient(ellipse at 35% 50%, rgba(228,241,219,.72), transparent 54%), radial-gradient(ellipse at 70% 48%, rgba(237,246,231,.58), transparent 52%); transform: rotate(-13deg); }
.scope-banner-icon { position: relative; width: 34rpx; height: 30rpx; flex: 0 0 34rpx; }
.scope-banner-icon::before, .scope-banner-icon::after { content: ''; position: absolute; left: 8rpx; top: 14rpx; width: 21rpx; height: 2rpx; border-radius: 2rpx; background: rgba(240,247,236,.72); transform-origin: left center; }
.scope-banner-icon::before { transform: rotate(-31deg); }
.scope-banner-icon::after { transform: rotate(31deg); }
.scope-banner-icon view { position: absolute; z-index: 1; width: 10rpx; height: 10rpx; border: 3rpx solid #2F6D48; border-radius: 50%; background: #F0F7EC; box-sizing: border-box; }
.scope-banner-icon view:nth-child(1) { left: 0; top: 10rpx; }
.scope-banner-icon view:nth-child(2) { right: 0; top: 0; }
.scope-banner-icon view:nth-child(3) { right: 0; bottom: 0; }
.panel-search-result { position: absolute; z-index: 3; top: 24rpx; right: 24rpx; display: flex; max-width: 180rpx; align-items: center; justify-content: flex-end; gap: 7rpx; overflow: hidden; color: #5D725C; font-family: 'DIN Alternate', sans-serif; font-size: 16rpx; line-height: 28rpx; font-variant-numeric: tabular-nums; text-overflow: ellipsis; white-space: nowrap; }
.panel-search-result.is-pending { color: #70816F; }

.filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx 18rpx; }
.atlas-filter { display: flex; width: 100%; min-width: 0; align-items: center; justify-content: center; gap: 12rpx; height: 92rpx; padding: 0 22rpx; border: 1rpx solid #D1DEC9; border-radius: 999rpx; background: rgba(255,255,252,.94); color: #46604E; font-size: 24rpx; line-height: 1.2; box-shadow: 0 7rpx 18rpx rgba(56,83,48,.035), inset 0 1rpx 0 rgba(255,255,255,.98); transition: transform .24s cubic-bezier(.16,1,.3,1), border-color .22s ease, background .22s ease, color .22s ease, box-shadow .22s ease; }
.atlas-filter:active { transform: scale(.982); }
.filter-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.filter-dot { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; background: #9AA79A; box-shadow: 0 0 0 6rpx rgba(154,167,154,.08); }
.filter-dot-weak { background: #C28E40; box-shadow: 0 0 0 6rpx rgba(194,142,64,.10); }
.filter-dot-unseen { background: #9BA89A; }
.filter-dot-mastered { background: #6FA24B; box-shadow: 0 0 0 6rpx rgba(111,162,75,.10); }
.filter-count { min-width: 38rpx; padding: 3rpx 9rpx; border-radius: 999rpx; background: #EEF3EB; color: #718071; text-align: center; font-family: 'DIN Alternate', sans-serif; font-size: 18rpx; line-height: 28rpx; font-variant-numeric: tabular-nums; transition: background .22s ease, color .22s ease; }
.atlas-filter.filter-active { border-color: #2B6743; background: linear-gradient(180deg, #2F7049 0%, #2C6844 100%); color: #F5F9F2; box-shadow: 0 13rpx 30rpx rgba(41,103,66,.19), inset 0 1rpx 0 rgba(255,255,255,.12); transform: translate3d(0,-1rpx,0); }
.filter-active .filter-dot { background: #B9E06E; box-shadow: 0 0 0 6rpx rgba(185,224,110,.14), 0 0 12rpx rgba(185,224,110,.32); }
.filter-active .filter-count { background: rgba(229,244,208,.16); color: #D8EBBC; }

.theme-section { margin-top: 42rpx; }
.theme-section-head { display: flex; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 22rpx; margin-bottom: 24rpx; }
.theme-section-title { display: flex; min-width: 0; align-items: center; gap: 16rpx; color: #294535; font-size: 28rpx; font-weight: 720; line-height: 35rpx; letter-spacing: -.3rpx; }
.theme-section-title > view:last-child { display: flex; min-width: 0; flex-direction: column; gap: 2rpx; }
.theme-section-subtitle { color: #7D8C7B; font-size: 18rpx; font-weight: 400; line-height: 26rpx; }
.theme-rail { width: 7rpx; height: 47rpx; flex: 0 0 7rpx; border-radius: 999rpx; background: #4C9A3B; box-shadow: 0 0 0 1rpx rgba(76,154,59,.06), 0 5rpx 12rpx rgba(76,154,59,.10); }
.theme-more { display: inline-flex; width: 176rpx; min-width: 176rpx; height: 68rpx; flex: 0 0 176rpx; align-items: center; justify-content: center; gap: 10rpx; padding: 0 20rpx; border: 1rpx solid #D4E0CE; border-radius: 999rpx; background: rgba(255,255,252,.94); color: #3D5C45; font-size: 20rpx; line-height: 1; box-shadow: 0 8rpx 22rpx rgba(61,88,52,.045), inset 0 1rpx 0 rgba(255,255,255,.96); transition: transform .2s cubic-bezier(.16,1,.3,1), border-color .2s ease, background .2s ease, box-shadow .2s ease; }
.theme-more-count { min-width: 32rpx; padding: 2rpx 7rpx; border-radius: 999rpx; background: #E9F1E5; color: #668060; font-family: 'DIN Alternate', sans-serif; font-size: 16rpx; line-height: 25rpx; font-variant-numeric: tabular-nums; }
.theme-more-arrow, .theme-card-arrow { width: 14rpx; height: 14rpx; flex: 0 0 14rpx; border-top: 2rpx solid #5F8062; border-right: 2rpx solid #5F8062; transform: rotate(45deg); transition: transform .22s cubic-bezier(.16,1,.3,1), border-color .22s ease; }
.theme-more:active .theme-more-arrow { transform: translate3d(2rpx,0,0) rotate(45deg); }

.theme-quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx 20rpx; }
.theme-quick-chip { position: relative; display: grid; width: 100%; min-width: 0; min-height: 148rpx; grid-template-columns: 76rpx minmax(0, 1fr) 16rpx; align-items: center; column-gap: 16rpx; padding: 20rpx 20rpx; overflow: hidden; border: 1rpx solid #D4E1CE; border-radius: 30rpx; background: rgba(255,255,252,.94); color: #31503A; text-align: left; box-shadow: 0 11rpx 28rpx rgba(54,82,46,.06), inset 0 1rpx 0 rgba(255,255,255,.98); transition: transform .28s cubic-bezier(.16,1,.3,1), border-color .24s ease, background .24s ease, box-shadow .24s ease; }
.theme-quick-chip::after { content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0; background: radial-gradient(circle at 82% 18%, rgba(178,214,138,.20), transparent 42%); transition: opacity .24s ease; }
.theme-quick-chip:active { transform: scale(.985); }
.theme-quick-chip.theme-active { border-color: #8CB46D; background: linear-gradient(135deg, #EEF6E8 0%, #E0EED4 100%); box-shadow: 0 14rpx 32rpx rgba(73,111,55,.12), inset 0 1rpx 0 rgba(255,255,255,.78); transform: translate3d(0,-2rpx,0); }
.theme-quick-chip.theme-active::after { opacity: 1; }
.theme-active .theme-card-arrow { border-color: #46763E; }

.theme-quick-chip.theme-disabled { border-color: #E0E7DC; background: rgba(249,251,247,.68); color: #8F9A8E; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.78); opacity: .68; }
.theme-disabled .theme-card-icon { background: #F0F3EE; color: #9AA69A; }
.theme-disabled .theme-card-arrow { border-color: #A8B2A6; }
.theme-card-icon { position: relative; z-index: 1; display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border-radius: 50%; background: linear-gradient(145deg, #F0F6EC, #E9F1E5); color: #648662; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.96), 0 5rpx 13rpx rgba(77,107,69,.035); transition: background .24s ease, transform .24s cubic-bezier(.16,1,.3,1), box-shadow .24s ease; }
.theme-active .theme-card-icon { background: linear-gradient(145deg, #DCECCF, #D1E6C2); color: #4C7E49; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.72), 0 6rpx 16rpx rgba(80,120,67,.07); transform: scale(1.035); }
.theme-card-copy { position: relative; z-index: 1; display: flex; min-width: 0; flex-direction: column; align-items: flex-start; justify-content: center; }
.theme-quick-name { display: block; width: 100%; overflow: hidden; color: inherit; font-size: 24rpx; font-weight: 680; line-height: 33rpx; text-overflow: ellipsis; white-space: nowrap; letter-spacing: -.2rpx; }
.theme-card-count { display: inline-flex; min-width: 34rpx; height: 28rpx; box-sizing: border-box; align-items: center; justify-content: center; padding: 0 8rpx; margin-top: 10rpx; border-radius: 999rpx; background: #EDF2EA; color: #718370; font-family: 'DIN Alternate', sans-serif; font-size: 16rpx; line-height: 28rpx; font-variant-numeric: tabular-nums; transition: background .22s ease, color .22s ease; }
.theme-active .theme-card-count { background: rgba(98,147,70,.12); color: #527843; }
.theme-card-arrow { position: relative; z-index: 1; }

/* 主题图标全部由 WXSS 绘制，避免额外网络依赖，并贴近参考稿的树/移动/层级/节点/代码语义。 */
.mini-network, .theme-glyph { position: relative; width: 43rpx; height: 43rpx; }
.mini-network::before, .mini-network::after { content: ''; position: absolute; left: 7rpx; top: 19rpx; width: 25rpx; height: 2rpx; border-radius: 2rpx; background: #73906F; transform-origin: left center; }
.mini-network::before { transform: rotate(-31deg); }
.mini-network::after { transform: rotate(31deg); }
.mini-network view { position: absolute; z-index: 1; width: 11rpx; height: 11rpx; border: 3rpx solid #EFF5EB; border-radius: 50%; box-sizing: border-box; background: #688665; }
.theme-active .mini-network view { border-color: #D7E8CB; background: #4D7E49; }
.mini-network view:nth-child(1) { left: 0; top: 14rpx; }
.mini-network view:nth-child(2) { right: 0; top: 0; }
.mini-network view:nth-child(3) { right: 0; bottom: 0; }
.theme-icon-tree .theme-glyph::before { content: ''; position: absolute; left: 17rpx; top: 16rpx; width: 4rpx; height: 20rpx; border-radius: 4rpx; background: currentColor; }
.theme-icon-tree .theme-glyph::after { content: ''; position: absolute; left: 7rpx; top: 3rpx; width: 24rpx; height: 24rpx; border-radius: 50% 50% 48% 48%; background: currentColor; box-shadow: -6rpx 8rpx 0 -2rpx currentColor, 7rpx 7rpx 0 -3rpx currentColor; }
.theme-icon-tree .theme-glyph view { display: none; }
.theme-icon-move .theme-glyph::before, .theme-icon-move .theme-glyph::after { content: ''; position: absolute; left: 4rpx; width: 29rpx; height: 10rpx; border-top: 3rpx solid currentColor; }
.theme-icon-move .theme-glyph::before { top: 10rpx; border-left: 3rpx solid currentColor; transform: skewX(-32deg); }
.theme-icon-move .theme-glyph::after { bottom: 7rpx; border-right: 3rpx solid currentColor; transform: skewX(-32deg) rotate(180deg); }
.theme-icon-move .theme-glyph view { display: none; }
.theme-icon-layers .theme-glyph view { position: absolute; left: 6rpx; width: 27rpx; height: 8rpx; border-radius: 3rpx; background: currentColor; transform: skewY(-20deg); }
.theme-icon-layers .theme-glyph view:nth-child(1) { top: 5rpx; opacity: .72; }
.theme-icon-layers .theme-glyph view:nth-child(2) { top: 15rpx; opacity: .86; }
.theme-icon-layers .theme-glyph view:nth-child(3) { top: 25rpx; }
.theme-icon-nodes .theme-glyph::before, .theme-icon-nodes .theme-glyph::after { content: ''; position: absolute; left: 8rpx; top: 19rpx; width: 23rpx; height: 2rpx; border-radius: 2rpx; background: currentColor; transform-origin: left center; }
.theme-icon-nodes .theme-glyph::before { transform: rotate(-55deg); }
.theme-icon-nodes .theme-glyph::after { transform: rotate(55deg); }
.theme-icon-nodes .theme-glyph view { position: absolute; z-index: 1; width: 9rpx; height: 9rpx; border: 2rpx solid #EFF5EB; border-radius: 50%; box-sizing: border-box; background: currentColor; }
.theme-active .theme-icon-nodes .theme-glyph view { border-color: #D7E8CB; }
.theme-icon-nodes .theme-glyph view:nth-child(1) { left: 1rpx; top: 15rpx; }
.theme-icon-nodes .theme-glyph view:nth-child(2) { right: 1rpx; top: 1rpx; }
.theme-icon-nodes .theme-glyph view:nth-child(3) { right: 1rpx; bottom: 1rpx; }
.theme-icon-code .theme-glyph::before, .theme-icon-code .theme-glyph::after { content: ''; position: absolute; top: 10rpx; width: 13rpx; height: 13rpx; border-top: 4rpx solid currentColor; border-left: 4rpx solid currentColor; border-radius: 2rpx; }
.theme-icon-code .theme-glyph::before { left: 4rpx; transform: rotate(-45deg); }
.theme-icon-code .theme-glyph::after { right: 4rpx; transform: rotate(135deg); }
.theme-icon-code .theme-glyph view { display: none; }

.theme-active-summary { display: flex; min-height: 90rpx; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 32rpx; padding: 12rpx 14rpx 12rpx 20rpx; border: 1rpx solid rgba(214,226,207,.72); border-radius: 26rpx; background: rgba(251,253,248,.92); color: #647663; box-shadow: 0 10rpx 26rpx rgba(55,84,48,.04), inset 0 1rpx 0 rgba(255,255,255,.96); }
.theme-active-copy { display: flex; min-width: 0; align-items: center; gap: 12rpx; font-size: 21rpx; line-height: 30rpx; }
.theme-active-name { min-width: 0; overflow: hidden; color: #30543A; font-size: 23rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.current-scope-icon { position: relative; width: 39rpx; height: 39rpx; flex: 0 0 39rpx; border: 3rpx solid #5F9155; border-radius: 50%; box-sizing: border-box; }
.current-scope-icon::before, .current-scope-icon::after { content: ''; position: absolute; left: 14rpx; top: -6rpx; width: 2rpx; height: 41rpx; background: linear-gradient(#5F9155 7rpx, transparent 7rpx, transparent 34rpx, #5F9155 34rpx); }
.current-scope-icon::after { transform: rotate(90deg); }
.current-scope-icon view { position: absolute; left: 9rpx; top: 9rpx; width: 11rpx; height: 11rpx; border-radius: 50%; background: #5F9155; }
.theme-clear { min-width: 122rpx; height: 56rpx; flex: 0 0 auto; padding: 0 23rpx; border-radius: 999rpx; background: #E8F0E3; color: #426345; font-size: 19rpx; line-height: 56rpx; transition: transform .2s ease, background .2s ease, color .2s ease; }
.theme-clear.theme-clear-disabled, .theme-clear[disabled] { background: #EEF2EC; color: #9AA69A; opacity: .72; }

/* 主题选择使用底部面板承载完整列表，避免横向滑动抢手势。 */
.theme-sheet-layer { position: fixed; z-index: 80; inset: 0; }
.theme-sheet-mask { position: absolute; inset: 0; background: rgba(20,35,25,.34); animation: theme-mask-in .2s ease-out both; }
.theme-sheet-closing .theme-sheet-mask { animation: theme-mask-out .16s ease-in both; }
.theme-sheet { position: absolute; left: 0; right: 0; bottom: 0; display: flex; max-height: 84vh; box-sizing: border-box; flex-direction: column; padding: 12rpx 24rpx 0; border-radius: 30rpx 30rpx 0 0; background: #F8FAF5; box-shadow: 0 -20rpx 60rpx rgba(31,54,35,.16); animation: theme-sheet-in .32s cubic-bezier(.16,1,.3,1) both; }
.theme-sheet-closing .theme-sheet { animation: theme-sheet-out .21s cubic-bezier(.4,0,1,1) both; }
.theme-sheet-handle { width: 66rpx; height: 7rpx; margin: 0 auto 15rpx; border-radius: 999rpx; background: #CBD6C7; }
.theme-sheet-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 0 4rpx 16rpx; }
.theme-sheet-title { display: block; color: #223A29; font-size: 29rpx; font-weight: 680; line-height: 38rpx; }
.theme-sheet-caption { display: block; margin-top: 2rpx; color: #82907F; font-size: 16rpx; line-height: 24rpx; }
.theme-sheet-close, .theme-search-clear { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; flex: 0 0 46rpx; border-radius: 50%; background: #E9EFE6; }
.theme-sheet-search { display: flex; align-items: center; gap: 14rpx; height: 68rpx; padding: 0 14rpx 0 18rpx; border: 1rpx solid #CFDCC8; border-radius: 17rpx; background: #FFFFFC; }
.theme-sheet-search .search-symbol { width: 20rpx; height: 20rpx; border-width: 2rpx; }
.theme-sheet-search input { flex: 1; min-width: 0; height: 64rpx; color: #25392B; font-size: 20rpx; line-height: 64rpx; }
.theme-sheet-scroll { min-height: 0; height: 58vh; max-height: 820rpx; margin-top: 15rpx; }
.theme-sheet-grid { overflow: hidden; border: 1rpx solid #D8E2D3; border-radius: 18rpx; background: #FCFDF9; }
.theme-sheet-chip { display: flex; width: 100%; min-width: 0; min-height: 78rpx; align-items: center; justify-content: space-between; gap: 12rpx; padding: 12rpx 15rpx; border: 0; border-radius: 0; background: transparent; color: #405543; text-align: left; transition: background .18s ease, color .18s ease; }
.theme-sheet-chip + .theme-sheet-chip { border-top: 1rpx solid #E2E9DE; }
.theme-sheet-chip-copy { flex: 1; min-width: 0; }
.theme-sheet-chip-name { display: block; overflow: hidden; font-size: 20rpx; font-weight: 610; line-height: 29rpx; text-overflow: ellipsis; white-space: nowrap; }
.theme-sheet-chip-note { display: block; margin-top: 2rpx; overflow: hidden; color: #8A9688; font-size: 14rpx; line-height: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.theme-sheet-chip-count { min-width: 31rpx; flex-shrink: 0; padding: 2rpx 7rpx; border-radius: 999rpx; background: #EDF2E9; color: #71806E; text-align: center; font-family: 'DIN Alternate', sans-serif; font-size: 15rpx; line-height: 23rpx; font-variant-numeric: tabular-nums; }
.theme-sheet-chip.theme-sheet-active { background: #E5EFD9; color: #2F522F; }
.theme-sheet-chip.theme-sheet-disabled { color: #98A397; opacity: .58; }
.theme-sheet-active .theme-sheet-chip-note { color: #66805C; }
.theme-sheet-active .theme-sheet-chip-count { background: rgba(105,145,76,.13); color: #4F733F; }
.theme-sheet-overview { width: 100%; }
.theme-sheet-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 260rpx; color: #617160; font-size: 20rpx; line-height: 31rpx; }
.theme-sheet-empty text + text { margin-top: 2rpx; color: #929D91; font-size: 16rpx; }
.theme-empty-icon { position: relative; width: 54rpx; height: 54rpx; margin-bottom: 14rpx; border: 2rpx solid #A7B6A2; border-radius: 50%; }
.theme-empty-icon::after { content: ''; position: absolute; right: -9rpx; bottom: 1rpx; width: 18rpx; height: 2rpx; border-radius: 2rpx; background: #A7B6A2; transform: rotate(45deg); }
.theme-sheet-safe { height: calc(28rpx + env(safe-area-inset-bottom)); }

/* 标签切换采用“两阶段轻过渡”：旧内容只轻微退场，新内容再柔和就位，不把整块内容淡到近乎消失。 */
.theme-content-switching { will-change: opacity, transform; }
.atlas-shell.theme-switch-leaving, .point-card.theme-switch-leaving, .knowledge-index.theme-switch-leaving { opacity: .965; transform: translate3d(0, 3rpx, 0) scale(.999); transition: opacity .09s ease-out, transform .09s ease-out; }
.atlas-shell.theme-switch-entering { animation: theme-atlas-enter .28s cubic-bezier(.16,1,.3,1) both; }
.point-card.theme-switch-entering { animation: theme-related-enter .25s 26ms cubic-bezier(.16,1,.3,1) both; }
.knowledge-index.theme-switch-entering { animation: theme-related-enter .25s 48ms cubic-bezier(.16,1,.3,1) both; }
.theme-switch-entering .atlas-node { animation: theme-node-enter .27s cubic-bezier(.16,1,.3,1) both; }
.theme-switch-entering .atlas-edge { animation: theme-edge-enter .25s ease-out both; }

/* 图谱：参考方案一的浅绿画布，用线宽和色块建立层级。 */
.atlas-shell { position: relative; isolation: isolate; overflow: hidden; border: 1rpx solid #D1DFC7; border-radius: 28rpx; background: rgba(250,252,247,.94); color: #233A29; box-shadow: 0 22rpx 48rpx rgba(54,82,42,.10), inset 0 1rpx 0 rgba(255,255,255,.96); }
.atlas-panel-head { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 25rpx 25rpx 4rpx; }
.atlas-heading-copy { flex: 1; min-width: 0; }
.atlas-heading-row { display: flex; align-items: center; gap: 12rpx; }
.atlas-heading { display: block; min-width: 0; color: #243B2A; font-size: 29rpx; font-weight: 680; line-height: 39rpx; letter-spacing: -.4rpx; overflow-wrap: break-word; }
.atlas-node-total { flex-shrink: 0; min-width: 34rpx; padding: 2rpx 9rpx; border-radius: 999rpx; background: #E8F1DE; color: #5B7950; text-align: center; font-family: 'DIN Alternate', sans-serif; font-size: 15rpx; line-height: 24rpx; }
.atlas-description { display: block; margin-top: 3rpx; color: #71806F; font-size: 18rpx; line-height: 28rpx; }
.atlas-reset { display: flex; flex-shrink: 0; align-items: center; gap: 9rpx; height: 58rpx; padding: 0 5rpx 0 10rpx; background: transparent; color: #56704E; font-size: 18rpx; line-height: 1; }
.reset-symbol { position: relative; width: 22rpx; height: 22rpx; border: 2rpx solid #77916D; border-radius: 50%; }
.reset-symbol::before { content: ''; position: absolute; top: 6rpx; left: 6rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: #B8E85A; }
.reset-symbol::after { content: ''; position: absolute; top: -5rpx; left: 8rpx; width: 2rpx; height: 28rpx; background: linear-gradient(#79916F 5rpx, transparent 5rpx, transparent 23rpx, #79916F 23rpx); }
.atlas-viewport { position: relative; width: 100%; height: 700rpx; overflow: hidden; touch-action: none; background-color: #F5F9F1; background-image: radial-gradient(rgba(101,137,84,.13) 1rpx, transparent 1rpx); background-size: 28rpx 28rpx; }
.atlas-ambient { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: radial-gradient(ellipse at 50% 48%, rgba(188,218,149,.24), rgba(246,250,242,.03) 45%, rgba(238,245,232,.72) 86%), linear-gradient(180deg, rgba(250,252,247,.92), transparent 15%, transparent 85%, rgba(250,252,247,.92)); }
.atlas-scan { position: absolute; z-index: 1; top: 2%; bottom: 2%; left: -42%; width: 38%; pointer-events: none; opacity: 0; transform: translate3d(0,0,0) skewX(-14deg); background: linear-gradient(90deg, transparent, rgba(134,174,91,.08), transparent); }
.gesture-tip { position: absolute; z-index: 3; top: 14rpx; left: 18rpx; display: flex; align-items: center; gap: 8rpx; padding: 7rpx 12rpx; border: 1rpx solid rgba(178,198,165,.72); border-radius: 999rpx; background: rgba(252,253,249,.78); color: #72826F; font-size: 15rpx; line-height: 22rpx; pointer-events: none; transition: opacity .18s ease; }
.gesture-tip-dot { width: 6rpx; height: 6rpx; border-radius: 50%; background: #7FA05B; }
.graph-interacting .gesture-tip { opacity: 0; }
.atlas-stage { position: absolute; z-index: 2; top: 0; left: 0; width: 800px; height: 760px; transform-origin: 0 0; will-change: transform; transition: transform .34s cubic-bezier(.16,1,.3,1); }
.graph-interacting .atlas-stage { transition: none; }
.atlas-orbit { position: absolute; pointer-events: none; border: 1px solid rgba(119,153,99,.18); border-radius: 50%; }
.orbit-outer { left: 65px; top: 45px; width: 670px; height: 670px; border-style: dashed; }
.orbit-inner { left: 230px; top: 210px; width: 340px; height: 340px; box-shadow: inset 0 0 0 44px rgba(131,170,91,.015); }
.atlas-edge { position: absolute; z-index: 1; height: 0; border-top: 2px solid #9BB38F; transform-origin: left center; pointer-events: none; opacity: .72; }
.atlas-edge::after { content: ''; position: absolute; top: -3px; right: -1px; width: 5px; height: 5px; border-radius: 50%; background: #89A37B; }
.edge-membership { border-top-style: dashed; border-top-color: #B5C7AC; }
.edge-hierarchy { border-top-width: 3px; border-top-color: #7E9F6E; }
.atlas-edge.edge-active { border-top-color: #5F8B49; opacity: .98; }
.atlas-edge.edge-active::after { background: #5F8B49; }
.atlas-node { position: absolute; z-index: 2; display: flex; box-sizing: border-box; -webkit-user-select: none; user-select: none; transition: transform .24s cubic-bezier(.16,1,.3,1), opacity .24s ease; }
.atlas-node-core { flex-direction: column; align-items: center; justify-content: center; padding: 10px; border: 2px solid #79A05D; border-radius: 50%; background: radial-gradient(circle at 31% 22%, #F1F9D9 0, #D9EDB8 42%, #B8D98B 100%); color: #17301F; box-shadow: inset 0 1px 2px rgba(255,255,255,.86), 0 0 0 9px rgba(125,160,92,.07), 0 14px 30px rgba(56,88,40,.14); }
.atlas-node-core::after { content: ''; position: absolute; inset: 8px; border: 1px solid rgba(52,89,45,.16); border-radius: inherit; pointer-events: none; }
.core-mark { position: relative; display: flex; align-items: center; justify-content: center; gap: 3px; height: 12px; margin-bottom: 5px; }
.core-mark view { width: 5px; height: 5px; border-radius: 50%; background: #5F813F; }
.core-mark view:nth-child(2) { width: 7px; height: 7px; background: #385E35; }
.core-label { width: 100%; max-height: 56px; overflow: hidden; color: #17301F; text-align: center; font-size: 23px; font-weight: 760; line-height: 27px; }
.core-caption { display: block; margin-top: 5px; color: #56763E; font-size: 13px; line-height: 17px; letter-spacing: .3px; }
.atlas-node-group { flex-direction: column; justify-content: center; padding: 11px 14px; border: 1.5px solid #A8C49A; border-radius: 16px; background: linear-gradient(145deg, #F6FAF1, #EAF3E3); box-shadow: inset 0 1px 0 rgba(255,255,255,.88), 0 10px 22px rgba(66,97,53,.09); }
.hub-topline { display: flex; align-items: center; gap: 10px; margin-bottom: 7px; }
.hub-number { color: #5E824D; font-family: 'DIN Alternate', sans-serif; font-size: 14px; font-weight: 650; line-height: 18px; }
.hub-count { color: #778A72; font-size: 13px; line-height: 18px; }
.hub-label { display: block; max-height: 56px; overflow: hidden; color: #28422F; font-size: 22px; font-weight: 620; line-height: 27px; overflow-wrap: break-word; }
.atlas-node-group.node-path { border-color: #71995C; box-shadow: inset 0 1px 0 rgba(255,255,255,.92), 0 0 0 4px rgba(116,151,83,.08), 0 12px 24px rgba(62,96,48,.12); }
.atlas-node-point { align-items: center; gap: 10px; padding: 9px 13px; border: 1px solid #B9CAB1; border-radius: 14px; background: rgba(250,252,247,.97); color: #3E5342; box-shadow: inset 0 1px 0 rgba(255,255,255,.92), 0 7px 17px rgba(74,101,62,.07); }
.point-beacon { position: relative; width: 9px; height: 9px; flex-shrink: 0; border: 2px solid #94A691; border-radius: 50%; background: #F8FAF5; }
.point-beacon::after { content: ''; position: absolute; inset: -5px; border: 1px solid transparent; border-radius: 50%; }
.graph-point-copy { flex: 1; min-width: 0; }
.graph-point-label { display: block; min-width: 0; max-height: 52px; overflow: hidden; font-size: 21px; font-weight: 520; line-height: 25px; overflow-wrap: break-word; }
.graph-point-caption { display: block; margin-top: 3px; color: #82907F; font-size: 12px; line-height: 15px; }
.atlas-node-point.tone-weak { border-color: #D9C5A9; background: #FFF9F0; }
.atlas-node-point.tone-weak .point-beacon { border-color: #B88A58; background: #B88A58; }
.atlas-node-point.tone-stable { border-color: #AFC99D; background: #F2F8EC; }
.atlas-node-point.tone-stable .point-beacon { border-color: #79A151; background: #79A151; }
.atlas-node-point.node-path { border-color: #759A61; color: #2F4934; }
.atlas-node-point.node-selected { z-index: 3; border-color: #6E9855; background: #E2F0D5; color: #203A26; box-shadow: 0 0 0 5px rgba(114,153,82,.10), 0 12px 27px rgba(55,86,42,.14); transform: translate3d(0,-3px,0); }
.node-selected .graph-point-label { font-weight: 650; }
.atlas-node-point.node-selected .graph-point-caption { color: #55704E; }
.atlas-node-point.node-selected .point-beacon { border-color: #628541; background: #628541; }
.atlas-node-point.node-selected .point-beacon::after { border-color: rgba(144,184,91,.55); }
.atlas-empty { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36rpx; text-align: center; }
.empty-orbit { position: relative; width: 100rpx; height: 100rpx; margin-bottom: 24rpx; border: 1rpx dashed #4B6654; border-radius: 50%; }
.empty-orbit::after { content: ''; position: absolute; inset: 31rpx; border: 2rpx solid #789169; border-radius: 50%; }
.atlas-empty-title { color: #3B5540; font-size: 27rpx; line-height: 38rpx; }
.atlas-empty-note { max-width: 490rpx; margin-top: 10rpx; color: #738270; font-size: 21rpx; line-height: 32rpx; }
.empty-reset { height: 64rpx; padding: 0 27rpx; margin-top: 27rpx !important; border: 1rpx solid #79966A; border-radius: 999rpx; background: #E5EFDC; color: #3E5E37; font-size: 21rpx; line-height: 64rpx; }
.atlas-controls { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 14rpx 21rpx 0; background: #FAFCF7; }
.zoom-controls, .graph-pagination { display: flex; align-items: center; }
.zoom-controls { flex: 1; justify-content: space-between; min-width: 0; overflow: hidden; border: 1rpx solid #C6D8BC; border-radius: 14rpx; background: #EDF4E7; box-shadow: inset 0 1rpx 0 rgba(255,255,255,.82); }
.graph-control { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 62rpx; padding: 0; background: transparent; color: #44633E; font-size: 31rpx; line-height: 1; transition: transform .2s ease, opacity .2s ease; }
.graph-control[disabled] { background: transparent; color: #A5B39F; opacity: .52; }
.zoom-value { min-width: 78rpx; color: #3F5B3C; text-align: center; font-family: 'DIN Alternate', sans-serif; font-size: 18rpx; font-variant-numeric: tabular-nums; }
.graph-range { color: #61785C; font-family: 'DIN Alternate', sans-serif; font-size: 18rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }
.graph-prev, .graph-next { width: 47rpx; font-size: 35rpx; }
.atlas-panel-foot { position: relative; z-index: 4; display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 17rpx 27rpx 22rpx; border-top: 1rpx solid #E2E9DE; background: #FAFCF7; color: #71816E; font-size: 17rpx; line-height: 24rpx; }
.edge-key { display: flex; align-items: center; gap: 8rpx; }
.key-line { width: 27rpx; height: 0; border-top: 2rpx solid #759369; }
.key-line.key-dashed { margin-left: 11rpx; border-top-style: dashed; border-top-color: #A6BA9D; }

/* 当前知识点卡片与图谱保持独立间距，避免控制区与详情内容发生视觉重叠。 */
.point-card { position: relative; z-index: 1; padding: 27rpx 27rpx 25rpx; margin: 18rpx 0 0; border: 1rpx solid #D1DFC8; border-radius: 24rpx; background: linear-gradient(135deg, rgba(255,255,252,.98), rgba(242,247,237,.98)); box-shadow: 0 12rpx 28rpx rgba(48,76,37,.065), inset 0 1rpx 0 rgba(255,255,255,.88); }
.point-card-top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.point-card-kicker { display: flex; align-items: center; gap: 10rpx; color: #5F6F63; font-size: 18rpx; line-height: 28rpx; }
.selected-beacon { width: 9rpx; height: 9rpx; border-radius: 50%; background: #7E9F4E; box-shadow: 0 0 0 5rpx #E5EDDB; }
.point-status { padding: 4rpx 13rpx; border-radius: 999rpx; background: #E8ECE6; color: #526257; font-size: 18rpx; line-height: 27rpx; }
.point-status.tone-weak { background: #EEE6DB; color: #8E6A44; }
.point-status.tone-stable { background: #E1EAD6; color: #5F7F42; }
.point-card-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 23rpx; margin-top: 17rpx; }
.point-card-copy { flex: 1; min-width: 0; }
.point-card-name { display: block; color: #203529; font-size: 34rpx; font-weight: 680; line-height: 1.35; overflow-wrap: break-word; }
.point-card-subline { display: flex; flex-wrap: wrap; align-items: center; gap: 7rpx 10rpx; margin-top: 5rpx; }
.point-card-theme { display: block; color: #627165; font-size: 19rpx; line-height: 29rpx; }
.point-match-alias { max-width: 100%; padding: 2rpx 9rpx; border: 1rpx solid #D4E2CA; border-radius: 999rpx; background: #EDF5E7; color: #527047; font-size: 16rpx; line-height: 24rpx; overflow-wrap: anywhere; }
.point-mastery { flex-shrink: 0; text-align: right; }
.point-mastery-value { display: block; color: #4F7138; font-family: 'DIN Alternate', sans-serif; font-size: 35rpx; font-weight: 700; line-height: 40rpx; }
.point-mastery-value.score-empty { color: #8C998B; font-family: inherit; font-size: 21rpx; font-weight: 450; }
.point-mastery-label { display: block; margin-top: 2rpx; color: #627165; font-size: 18rpx; line-height: 26rpx; }
.point-facts { display: flex; margin: 22rpx 0; padding: 17rpx 0; border-top: 1rpx solid #DDE5DB; border-bottom: 1rpx solid #DDE5DB; }
.point-facts > view { display: flex; flex: 1; min-width: 0; align-items: baseline; gap: 8rpx; }
.point-facts > view + view { padding-left: 20rpx; border-left: 1rpx solid #D8E1D6; }
.fact-value { color: #3E5A43; font-family: 'DIN Alternate', sans-serif; font-size: 25rpx; font-weight: 650; line-height: 31rpx; }
.fact-label { color: #627165; font-size: 18rpx; line-height: 27rpx; }
.point-actions { display: flex; gap: 13rpx; }
.point-detail, .point-practice { display: flex; align-items: center; justify-content: center; height: 73rpx; padding: 0 20rpx; border-radius: 14rpx; font-size: 22rpx; line-height: 1; white-space: nowrap; transition: transform .22s cubic-bezier(.16,1,.3,1), opacity .22s ease; }
.point-detail { flex: 1; border: 1rpx solid #C9D5C7; background: #EFF3EB; color: #536A55; }
.point-practice { flex: 1.15; background: #163A29; color: #F0F5ED; box-shadow: 0 8rpx 18rpx rgba(22,58,41,.14); }
.point-practice[disabled] { background: #E2E8DF; color: #8D9B8C; box-shadow: none; }
.point-practice.point-practice-launching { background: #234A36; color: #F4F8F2; opacity: .94; }
.point-practice-spinner { width: 22rpx; height: 22rpx; box-sizing: border-box; margin-right: 10rpx; border: 3rpx solid rgba(244,248,242,.28); border-top-color: #F4F8F2; border-radius: 50%; animation: point-practice-spin .68s linear infinite; }
@keyframes point-practice-spin { to { transform: rotate(360deg); } }

.knowledge-index { margin-top: 40rpx; }
.index-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 14rpx; padding: 0 5rpx 16rpx; }
.index-title { display: block; color: #29412F; font-size: 30rpx; font-weight: 650; line-height: 40rpx; }
.index-title text { margin-left: 7rpx; color: #859781; font-family: 'DIN Alternate', sans-serif; font-size: 21rpx; font-weight: 450; }
.status-key { display: flex; align-items: center; gap: 6rpx; padding-bottom: 4rpx; color: #5F6F63; font-size: 17rpx; white-space: nowrap; }
.status-key-dot { width: 7rpx; height: 7rpx; margin-left: 7rpx; border-radius: 50%; }
.status-key-dot.tone-unseen, .index-dot.tone-unseen { background: #9BA89A; }
.status-key-dot.tone-weak, .index-dot.tone-weak { background: #B88F61; }
.status-key-dot.tone-stable, .index-dot.tone-stable { background: #769B4D; }
.index-list { overflow: hidden; border: 1rpx solid #D3E0CC; border-radius: 20rpx; background: rgba(255,255,252,.72); box-shadow: 0 9rpx 26rpx rgba(58,86,47,.045), inset 0 1rpx 0 rgba(255,255,255,.90); }
.index-row { display: flex; align-items: center; gap: 14rpx; min-height: 103rpx; padding: 18rpx 21rpx; transition: transform .22s cubic-bezier(.16,1,.3,1), opacity .22s ease; }
.index-row + .index-row { border-top: 1rpx solid #DFE6DD; }
.index-row.index-row-selected { background: #E3ECD9; }
.index-pressed { background: #E8EEE4; transform: scale(.994); }
.index-rank { width: 26rpx; flex-shrink: 0; color: #627165; font-family: 'DIN Alternate', sans-serif; font-size: 17rpx; font-variant-numeric: tabular-nums; }
.index-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; border-radius: 50%; }
.index-row-copy { flex: 1; min-width: 0; }
.index-row-copy.index-row-child { position: relative; }
.index-tree-guide { position: absolute; top: 7rpx; bottom: 7rpx; left: 2rpx; width: 12rpx; border-left: 1rpx solid #C7D3C4; border-bottom: 1rpx solid #C7D3C4; border-bottom-left-radius: 5rpx; }
.index-node-name { display: block; color: #3C5542; font-size: 24rpx; line-height: 34rpx; overflow-wrap: break-word; }
.index-meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 5rpx 9rpx; margin-top: 3rpx; }
.index-node-meta { display: block; color: #627165; font-size: 18rpx; line-height: 27rpx; }
.index-alias-match { max-width: 100%; padding: 1rpx 8rpx; border-radius: 999rpx; background: #EDF4E7; color: #56734A; font-size: 15rpx; line-height: 23rpx; overflow-wrap: anywhere; }
.index-locate { display: flex; flex-shrink: 0; align-items: center; gap: 6rpx; color: #50684F; font-size: 18rpx; }
.locate-crosshair { position: relative; width: 18rpx; height: 18rpx; border: 1rpx solid #7B9277; border-radius: 50%; }
.locate-crosshair::before, .locate-crosshair::after { content: ''; position: absolute; background: #7B9277; }
.locate-crosshair::before { left: 8rpx; top: -4rpx; width: 1rpx; height: 25rpx; background: linear-gradient(#7B9277 5rpx, transparent 5rpx, transparent 20rpx, #7B9277 20rpx); }
.locate-crosshair::after { left: -4rpx; top: 8rpx; width: 25rpx; height: 1rpx; background: linear-gradient(90deg, #7B9277 5rpx, transparent 5rpx, transparent 20rpx, #7B9277 20rpx); }
.index-more { display: flex; align-items: center; justify-content: center; gap: 13rpx; width: 100%; padding: 23rpx 16rpx; margin-top: 9rpx !important; background: transparent; color: #657B5F; font-size: 21rpx; line-height: 1.5; }
.index-more text { color: #8B9D86; font-family: 'DIN Alternate', sans-serif; font-size: 18rpx; }

/* 加载与失败状态保持相同的图谱语汇。 */
.atlas-loading { min-height: 78vh; padding: 16rpx 6rpx 40rpx; }
.loading-copy { padding-top: 18rpx; }
.skeleton-line { position: relative; overflow: hidden; border-radius: 4rpx; background: #DDE4DC; }
.skeleton-line::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.62), transparent); transform: translate3d(-110%,0,0); animation: skeleton-sweep 1.45s ease-in-out infinite; }
.skeleton-label { width: 190rpx; height: 20rpx; }
.skeleton-title { width: 245rpx; height: 54rpx; margin-top: 21rpx; }
.skeleton-subtitle { width: 310rpx; height: 18rpx; margin-top: 16rpx; }
.loading-metrics { display: flex; margin-top: 35rpx; padding: 19rpx 0; border-top: 1rpx solid #D7DED6; }
.loading-metric { flex: 1; padding: 0 20rpx; }
.loading-metric:first-child { padding-left: 0; }
.loading-metric + .loading-metric { border-left: 1rpx solid #D7DED6; }
.skeleton-number { width: 72rpx; height: 31rpx; }
.skeleton-caption { width: 90rpx; height: 15rpx; margin-top: 10rpx; }
.loading-atlas { position: relative; height: 620rpx; margin-top: 25rpx; overflow: hidden; border: 1rpx solid #D6E3CE; border-radius: 28rpx; background: radial-gradient(circle at 50% 50%, #F1F7EA, #F8FAF5); }
.loading-orbit { position: absolute; left: 50%; top: 50%; border: 1rpx dashed rgba(113,148,91,.26); border-radius: 50%; transform: translate3d(-50%,-50%,0); }
.loading-orbit-outer { width: 480rpx; height: 480rpx; }
.loading-orbit-inner { width: 250rpx; height: 250rpx; }
.loading-core { position: absolute; left: 50%; top: 50%; width: 94rpx; height: 94rpx; border: 1rpx solid #84A96D; border-radius: 50%; background: #D7EBB7; transform: translate3d(-50%,-50%,0); animation: loading-breathe 1.8s ease-in-out infinite; }
.loading-node { position: absolute; width: 126rpx; height: 52rpx; border: 1rpx solid #B7CBAA; border-radius: 13rpx; background: #EDF5E7; opacity: .88; }
.loading-node:nth-of-type(4) { left: 58rpx; top: 126rpx; }
.loading-node:nth-of-type(5) { right: 58rpx; top: 126rpx; }
.loading-node:nth-of-type(6) { right: 58rpx; bottom: 116rpx; }
.loading-node:nth-of-type(7) { left: 58rpx; bottom: 116rpx; }
.loading-note { display: block; margin-top: 20rpx; color: #5F6F63; text-align: center; font-size: 20rpx; line-height: 30rpx; }
.page-state { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 68vh; padding: 48rpx; text-align: center; }
.error-orbit { position: relative; display: flex; align-items: center; justify-content: center; width: 116rpx; height: 116rpx; margin-bottom: 29rpx; border: 1rpx dashed #A9B7A6; border-radius: 50%; }
.error-orbit::before { content: ''; position: absolute; inset: 17rpx; border: 1rpx solid #D2DBD0; border-radius: 50%; }
.error-core { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 43rpx; height: 43rpx; border-radius: 50%; background: #284A36; color: #DDEBCB; font-family: 'DIN Alternate', sans-serif; font-size: 25rpx; }
.state-title { color: #345840; font-size: 29rpx; font-weight: 620; line-height: 40rpx; }
.state-note { max-width: 500rpx; margin-top: 12rpx; color: #5F6F63; font-size: 22rpx; line-height: 35rpx; }
.state-action { height: 70rpx; padding: 0 38rpx; margin-top: 31rpx !important; border-radius: 14rpx; background: #1C422E; color: #F0F5ED; font-size: 22rpx; line-height: 70rpx; }

@keyframes theme-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes theme-mask-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes theme-sheet-in { from { transform: translate3d(0,100%,0); } to { transform: translate3d(0,0,0); } }
@keyframes theme-sheet-out { from { transform: translate3d(0,0,0); } to { transform: translate3d(0,100%,0); } }
@keyframes search-pending-pulse { 0%, 100% { opacity: .38; transform: scale(.78); } 50% { opacity: 1; transform: scale(1); } }
@keyframes theme-atlas-enter { from { opacity: .965; transform: translate3d(0,3rpx,0) scale(.999); } to { opacity: 1; transform: translate3d(0,0,0) scale(1); } }
@keyframes theme-related-enter { from { opacity: .97; transform: translate3d(0,3rpx,0); } to { opacity: 1; transform: translate3d(0,0,0); } }
@keyframes theme-node-enter { from { opacity: .82; transform: translate3d(0,4px,0) scale(.985); } to { opacity: 1; transform: translate3d(0,0,0) scale(1); } }
@keyframes theme-edge-enter { from { opacity: .35; } to { opacity: .72; } }
@keyframes skeleton-sweep { from { transform: translate3d(-110%,0,0); } to { transform: translate3d(110%,0,0); } }
@keyframes loading-breathe { 0%, 100% { opacity: .62; transform: translate3d(-50%,-50%,0) scale(.94); } 50% { opacity: 1; transform: translate3d(-50%,-50%,0) scale(1); } }
@keyframes atlas-sweep { 0% { opacity: 0; transform: translate3d(0,0,0) skewX(-14deg); } 24% { opacity: 1; } 100% { opacity: 0; transform: translate3d(380%,0,0) skewX(-14deg); } }
@keyframes node-arrive { from { opacity: 0; transform: translate3d(0,12px,0) scale(.92); } to { opacity: 1; transform: translate3d(0,0,0) scale(1); } }
@keyframes edge-arrive { from { opacity: 0; } to { opacity: .66; } }
@keyframes edge-arrive-active { from { opacity: 0; } to { opacity: .95; } }
@keyframes node-arrive-selected { from { opacity: 0; transform: translate3d(0,12px,0) scale(.92); } to { opacity: 1; transform: translate3d(0,-3px,0) scale(1); } }
@keyframes selected-signal { 0%, 100% { opacity: .4; transform: scale(.75); } 50% { opacity: .82; transform: scale(1.15); } }

.scene-animating .atlas-scan { animation: atlas-sweep .78s cubic-bezier(.16,1,.3,1) both; }
.scene-animating .atlas-node { animation: node-arrive .46s cubic-bezier(.16,1,.3,1) both; }
.scene-animating .atlas-edge { animation: edge-arrive .42s ease-out both; }
.scene-animating .atlas-node.node-selected { animation-name: node-arrive-selected; }
.scene-animating .atlas-edge.edge-active { animation-name: edge-arrive-active; }
.atlas-node-point.node-selected .point-beacon::after { animation: selected-signal 1.9s ease-in-out infinite; }

@media (max-width: 350px) {
  .intro-title { font-size: 47rpx; }
  .hero-description { font-size: 18rpx; }
  .coverage-readout { width: 132rpx; padding-left: 18rpx; }
  .subject-metric { padding: 0 14rpx; }
  .atlas-filter { gap: 8rpx; height: 86rpx; padding: 0 12rpx; font-size: 21rpx; }
  .filter-count { font-size: 16rpx; }
  .filter-theme-card { padding-left: 22rpx; padding-right: 22rpx; }
  .scope-banner { width: 410rpx; padding-left: 25rpx; font-size: 20rpx; }
  .theme-more { width: 158rpx; min-width: 158rpx; flex-basis: 158rpx; }
  .theme-quick-grid { gap: 14rpx; }
  .theme-quick-chip { min-height: 132rpx; grid-template-columns: 64rpx minmax(0,1fr) 12rpx; column-gap: 11rpx; padding: 16rpx 13rpx; border-radius: 25rpx; }
  .theme-card-icon { width: 64rpx; height: 64rpx; }
  .theme-quick-name { font-size: 21rpx; }
  .point-facts > view { gap: 5rpx; }
  .point-facts > view + view { padding-left: 12rpx; }
  .fact-label { font-size: 16rpx; }
  .status-key { gap: 4rpx; font-size: 15rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .page-reveal, .page-entered .page-reveal { opacity: 1; transform: none; transition: none; }
  .atlas-stage, .atlas-node, .graph-control, .atlas-filter, .theme-quick-chip, .index-row, .point-detail, .point-practice { transition: none; }
  .scene-animating .atlas-scan, .scene-animating .atlas-node, .scene-animating .atlas-edge, .atlas-node-point.node-selected .point-beacon::after, .skeleton-line::after, .loading-core, .theme-sheet, .theme-sheet-mask, .search-pending-dot, .atlas-shell.theme-switch-entering, .point-card.theme-switch-entering, .knowledge-index.theme-switch-entering, .theme-switch-entering .atlas-node, .theme-switch-entering .atlas-edge { animation: none; }
}

/* v7：紧凑型主题筛选。按现有绿色视觉系统收敛间距，并将主题选择器改为贴底全宽面板。 */
.filter-theme-card {
  position: relative;
  isolation: isolate;
  margin-top: 14rpx;
  padding: 18rpx;
  overflow: hidden;
  border: 1rpx solid #d5e2cf;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(253,255,250,.99) 0%, rgba(248,251,245,.99) 100%);
}
.filter-theme-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: radial-gradient(ellipse at 92% 8%, rgba(184,210,160,.19), transparent 26%), linear-gradient(180deg, transparent 62%, rgba(230,240,223,.13));
}
.filter-card-glow {
  position: absolute;
  z-index: -1;
  right: -34rpx;
  top: -28rpx;
  width: 210rpx;
  height: 104rpx;
  opacity: .62;
  pointer-events: none;
  background: radial-gradient(ellipse at 42% 52%, rgba(165,196,141,.22), transparent 42%), radial-gradient(ellipse at 76% 38%, rgba(213,228,200,.38), transparent 38%);
  transform: rotate(-8deg);
}
.atlas-filter,
.theme-more,
.theme-quick-chip,
.theme-clear,
.theme-sheet-featured,
.theme-sheet-item {
  box-sizing: border-box;
  margin: 0 !important;
}
.panel-search-meta {
  display: flex;
  min-height: 26rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-bottom: 12rpx;
  color: #748472;
  font-size: 17rpx;
  line-height: 26rpx;
}
.panel-search-meta.is-pending { color: #687c67; }
.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.atlas-filter {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 74rpx;
  min-height: 74rpx;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  padding: 0 14rpx;
  border: 1rpx solid #d4e0ce;
  border-radius: 999rpx;
  background: rgba(255,255,253,.98);
  color: #526753;
  font-size: 21rpx;
  line-height: 1;
  transition: transform .18s cubic-bezier(.16,1,.3,1), border-color .18s ease, background .18s ease, color .18s ease;
}
.atlas-filter.filter-active {
  border-color: #2f6d47;
  background: #2f6d47;
  color: #f7faf4;
  transform: translate3d(0,-1rpx,0);
}
.filter-dot { width: 9rpx; height: 9rpx; }
.filter-count {
  min-width: 31rpx;
  padding: 1rpx 7rpx;
  border-radius: 999rpx;
  background: #edf2ea;
  color: #758574;
  font-size: 16rpx;
  line-height: 24rpx;
}
.filter-active .filter-count { background: rgba(236,246,219,.15); color: #deedca; }

.theme-section {
  margin-top: 18rpx;
  padding-top: 2rpx;
}
.theme-section-head {
  display: flex;
  min-height: 54rpx;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 12rpx;
}
.theme-section-title {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11rpx;
  color: #274430;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 31rpx;
}
.theme-section-title > view:last-child {
  display: flex;
  min-width: 0;
  flex-direction: column;
}
.theme-section-subtitle {
  margin-top: 1rpx;
  color: #849182;
  font-size: 16rpx;
  font-weight: 400;
  line-height: 22rpx;
}
.theme-rail {
  width: 6rpx;
  height: 38rpx;
  flex: 0 0 6rpx;
  border-radius: 999rpx;
  background: #529b40;
}
.theme-more {
  display: inline-flex;
  width: 132rpx !important;
  min-width: 132rpx !important;
  max-width: 132rpx;
  height: 52rpx;
  flex: 0 0 132rpx !important;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  padding: 0 11rpx;
  border: 1rpx solid #d7e2d1;
  border-radius: 999rpx;
  background: rgba(255,255,253,.98);
  color: #49614a;
  font-size: 19rpx;
  line-height: 1;
}
.theme-more-count {
  min-width: 28rpx;
  padding: 1rpx 6rpx;
  border-radius: 999rpx;
  background: #edf3e8;
  color: #71836e;
  font-size: 15rpx;
  line-height: 22rpx;
}
.theme-more-arrow,
.theme-card-arrow,
.theme-sheet-item-arrow {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  border-top: 2rpx solid #70856f;
  border-right: 2rpx solid #70856f;
  transform: rotate(45deg);
}
.theme-quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}
.theme-quick-chip {
  position: relative;
  display: grid;
  width: 100%;
  min-width: 0;
  height: 108rpx;
  min-height: 108rpx;
  grid-template-columns: 58rpx minmax(0, 1fr) 10rpx;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 13rpx;
  overflow: hidden;
  border: 1rpx solid #d7e2d1;
  border-radius: 22rpx;
  background: rgba(255,255,253,.98);
  color: #315039;
  text-align: left;
  transition: transform .2s cubic-bezier(.16,1,.3,1), border-color .18s ease, background .18s ease, opacity .18s ease;
}
.theme-quick-chip.theme-active {
  border-color: #a0c283;
  background: #eaf4e1;
  transform: translate3d(0,-1rpx,0);
}
.theme-quick-chip.theme-disabled {
  border-color: #e0e7dc;
  background: rgba(249,251,247,.9);
  color: #95a093;
  opacity: .7;
}
.theme-card-icon,
.theme-sheet-featured-icon,
.theme-sheet-item-icon,
.theme-sheet-brand-icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 50%;
  background: #eef5ea;
}
.theme-card-icon { width: 58rpx; height: 58rpx; }
.theme-sheet-featured-icon { width: 68rpx; height: 68rpx; }
.theme-sheet-item-icon { width: 56rpx; height: 56rpx; }
.theme-sheet-brand-icon { width: 50rpx; height: 50rpx; }
.theme-active .theme-card-icon,
.theme-sheet-active .theme-sheet-featured-icon,
.theme-sheet-active .theme-sheet-item-icon,
.theme-sheet-active .theme-sheet-brand-icon { background: #dceccb; }
.theme-icon-image {
  display: block;
  width: 36rpx;
  height: 36rpx;
}
.theme-card-icon .theme-icon-image { width: 34rpx; height: 34rpx; }
.theme-sheet-featured-icon .theme-icon-image { width: 40rpx; height: 40rpx; }
.theme-sheet-brand-icon .theme-icon-image { width: 31rpx; height: 31rpx; }
.theme-card-copy,
.theme-sheet-featured-copy,
.theme-sheet-item-copy { min-width: 0; }
.theme-card-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
.theme-quick-name,
.theme-sheet-featured-name,
.theme-sheet-item-name {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: inherit;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-quick-name { font-size: 22rpx; line-height: 29rpx; }
.theme-card-count,
.theme-sheet-chip-count {
  display: inline-flex;
  min-width: 29rpx;
  height: 24rpx;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #eef3ea;
  color: #728370;
  font-size: 15rpx;
  line-height: 24rpx;
}
.theme-card-count { margin-top: 4rpx; }
.theme-active .theme-card-count,
.theme-sheet-active .theme-sheet-chip-count { background: rgba(96,142,71,.12); color: #557a45; }
.theme-card-arrow { justify-self: end; }
.theme-active .theme-card-arrow,
.theme-sheet-active .theme-sheet-item-arrow { border-color: #527944; }

.theme-active-summary {
  display: grid;
  min-height: 62rpx;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 7rpx 8rpx 7rpx 13rpx;
  border: 1rpx solid #dce6d6;
  border-radius: 20rpx;
  background: rgba(255,255,253,.97);
}
.theme-active-copy {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
  color: #6b7b69;
  font-size: 18rpx;
  line-height: 26rpx;
}
.theme-active-name {
  min-width: 0;
  overflow: hidden;
  color: #2f5438;
  font-size: 20rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.current-scope-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  border: 2rpx solid #5f9155;
  border-radius: 50%;
  box-sizing: border-box;
  overflow: hidden;
}
.current-scope-icon::before {
  content: '';
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 12rpx;
  height: 12rpx;
  border: 2rpx solid #5f9155;
  border-radius: 50%;
  box-sizing: border-box;
}
.current-scope-icon::after {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 11rpx;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #5f9155;
}
.current-scope-icon view { display: none; }
.theme-clear {
  display: flex;
  width: 92rpx !important;
  min-width: 92rpx !important;
  max-width: 92rpx;
  height: 44rpx;
  flex: 0 0 92rpx !important;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  border-radius: 999rpx;
  background: #eaf1e5;
  color: #446447;
  font-size: 18rpx;
  line-height: 44rpx;
}
.theme-clear.theme-clear-disabled,
.theme-clear[disabled] { background: #eff3ed; color: #9ca89a; opacity: .75; }

/* 选择主题：贴底全宽、列表填满可用宽度，避免右侧和底部悬空。 */
.theme-sheet-layer {
  position: fixed;
  inset: 0;
  z-index: 80;
}
.theme-sheet-mask {
  position: absolute;
  inset: 0;
  background: rgba(18,31,22,.30);
  animation: theme-mask-in .2s ease-out both;
}
.theme-sheet-closing .theme-sheet-mask { animation: theme-mask-out .16s ease-in both; }
.theme-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  width: 100%;
  height: calc(100vh - 44rpx);
  max-height: calc(100vh - 44rpx);
  box-sizing: border-box;
  flex-direction: column;
  padding: 10rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  border-radius: 30rpx 30rpx 0 0;
  background: #f8faf5;
  box-shadow: 0 -18rpx 52rpx rgba(27,48,31,.15);
  animation: theme-sheet-in .3s cubic-bezier(.16,1,.3,1) both;
}
.theme-sheet-closing .theme-sheet { animation: theme-sheet-out .2s cubic-bezier(.4,0,1,1) both; }
.theme-sheet-handle {
  width: 64rpx;
  height: 6rpx;
  flex: 0 0 6rpx;
  margin: 0 auto 12rpx;
  border-radius: 999rpx;
  background: #ccd7c8;
}
.theme-sheet-head {
  display: flex;
  flex: 0 0 auto;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  padding: 0 2rpx;
}
.theme-sheet-title-wrap { min-width: 0; }
.theme-sheet-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.theme-sheet-title {
  color: #223b29;
  font-size: 32rpx;
  font-weight: 720;
  line-height: 42rpx;
}
.theme-sheet-caption {
  display: block;
  margin-top: 4rpx;
  color: #81907d;
  font-size: 17rpx;
  line-height: 24rpx;
}
.theme-sheet-close,
.theme-search-clear {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf0e7;
}
.theme-sheet-search {
  display: flex;
  width: 100%;
  height: 66rpx;
  box-sizing: border-box;
  flex: 0 0 66rpx;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 0 13rpx 0 18rpx;
  border: 1rpx solid #d2decf;
  border-radius: 18rpx;
  background: #fffffc;
}
.theme-sheet-search .search-symbol { width: 20rpx; height: 20rpx; border-width: 2rpx; }
.theme-sheet-search input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  color: #28402d;
  font-size: 20rpx;
  line-height: 62rpx;
}
.theme-sheet-scroll {
  width: 100%;
  min-width: 0;
  min-height: 0;
  flex: 1 1 auto;
  box-sizing: border-box;
  margin-top: 12rpx;
}
.theme-sheet-list,
.theme-sheet-rows,
.theme-sheet-row {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}
.theme-sheet-list { padding: 0 0 4rpx; }
.theme-sheet-featured {
  display: grid;
  width: 100% !important;
  min-width: 0;
  height: 94rpx;
  min-height: 94rpx;
  grid-template-columns: 68rpx minmax(0,1fr) auto 10rpx;
  align-items: center;
  gap: 13rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #d9e5d4;
  border-radius: 22rpx;
  background: #f0f6eb;
  color: #274530;
  text-align: left;
}
.theme-sheet-featured-copy,
.theme-sheet-item-copy { overflow: hidden; }
.theme-sheet-featured-name,
.theme-sheet-item-name { font-size: 23rpx; line-height: 30rpx; }
.theme-sheet-featured-note,
.theme-sheet-item-note {
  display: block;
  margin-top: 1rpx;
  overflow: hidden;
  color: #7c8b79;
  font-size: 16rpx;
  line-height: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.theme-sheet-rows {
  position: relative;
  margin-top: 10rpx;
  padding-left: 27rpx;
}
.theme-sheet-rows::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 7rpx;
  bottom: 12rpx;
  width: 2rpx;
  background: rgba(132,164,126,.34);
}
.theme-sheet-row {
  position: relative;
  display: flex;
  align-items: stretch;
  margin-bottom: 9rpx;
}
.theme-sheet-order {
  position: absolute;
  left: -27rpx;
  top: 26rpx;
  z-index: 2;
  width: 27rpx;
  display: flex;
  justify-content: center;
}
.theme-sheet-order text {
  display: flex;
  width: 26rpx;
  height: 26rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f8faf5;
  border-radius: 50%;
  box-sizing: border-box;
  background: #86a982;
  color: #fff;
  font-size: 13rpx;
  line-height: 1;
}
.theme-sheet-item {
  display: grid;
  width: 100% !important;
  min-width: 0;
  height: 90rpx;
  min-height: 90rpx;
  flex: 1 1 auto;
  grid-template-columns: 56rpx minmax(0,1fr) auto 10rpx;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 15rpx;
  border: 1rpx solid #dce6d7;
  border-radius: 21rpx;
  background: #fff;
  color: #294831;
  text-align: left;
}
.theme-sheet-active {
  border-color: #a4c487;
  background: #eaf4e2;
  transform: none;
}
.theme-sheet-disabled {
  color: #98a397;
  background: #fafbf8;
  opacity: .68;
}
.theme-sheet-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  color: #647261;
  font-size: 20rpx;
  line-height: 30rpx;
}
.theme-sheet-empty text + text { margin-top: 3rpx; color: #98a297; font-size: 17rpx; }
.theme-sheet-safe { height: 4rpx; }

.atlas-shell.theme-switch-leaving,
.point-card.theme-switch-leaving,
.knowledge-index.theme-switch-leaving {
  opacity: .985;
  transform: translate3d(0,4rpx,0);
  transition: opacity .09s ease-out, transform .09s ease-out;
}
.atlas-shell.theme-switch-entering { animation: theme-atlas-enter .22s cubic-bezier(.2,.86,.28,1) both; }
.point-card.theme-switch-entering,
.knowledge-index.theme-switch-entering { animation: theme-related-enter .2s cubic-bezier(.2,.86,.28,1) both; }
.theme-switch-entering .atlas-node { animation: theme-node-enter .2s cubic-bezier(.2,.86,.28,1) both; }
.theme-switch-entering .atlas-edge { animation: theme-edge-enter .18s ease-out both; }

@media (max-width: 360px) {
  .filter-theme-card { padding-left: 16rpx; padding-right: 16rpx; }
  .atlas-filter { height: 70rpx; min-height: 70rpx; padding-left: 10rpx; padding-right: 10rpx; font-size: 20rpx; }
  .theme-section-title { font-size: 23rpx; }
  .theme-more { width: 124rpx !important; min-width: 124rpx !important; max-width: 124rpx; flex-basis: 124rpx !important; }
  .theme-quick-chip { height: 102rpx; min-height: 102rpx; grid-template-columns: 54rpx minmax(0,1fr) 9rpx; gap: 9rpx; padding: 10rpx; }
  .theme-card-icon { width: 54rpx; height: 54rpx; }
  .theme-card-icon .theme-icon-image { width: 31rpx; height: 31rpx; }
  .theme-quick-name { font-size: 20rpx; }
  .theme-sheet { padding-left: 20rpx; padding-right: 20rpx; }
  .theme-sheet-item { grid-template-columns: 52rpx minmax(0,1fr) auto 9rpx; gap: 10rpx; padding-left: 12rpx; padding-right: 12rpx; }
  .theme-sheet-item-icon { width: 52rpx; height: 52rpx; }
}

/* v9：单行状态筛选 + 模块节奏 + 1/3 屏主题选择。 */
.filter-theme-card {
  margin-top: 12rpx;
  padding: 14rpx 16rpx 12rpx;
}
.panel-search-meta { margin-bottom: 8rpx; }

/* 四个掌握状态改为单行。每项等分可用宽度，不依赖 button 的固有宽度。 */
.filter-grid {
  display: flex;
