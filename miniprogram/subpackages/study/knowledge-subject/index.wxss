/* ===== Knowledge index · non-collapsing search surface / interaction polish v7 ===== */
/* A dedicated index-search session keeps the largest result footprint it has shown.
   This is intentionally a min-height (not a fixed height): results may grow naturally,
   but a short or empty result can no longer shrink the document and clamp page scroll
   upward into the graph section. The floor is released only after an idle search is
   explicitly closed. */
.knowledge-index .index-results-layout-locked.index-results-empty-state .index-results-content-empty {
