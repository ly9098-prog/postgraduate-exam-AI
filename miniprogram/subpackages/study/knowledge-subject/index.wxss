page{background:#F5F8FF;color:#17213B}.page{padding:26rpx 24rpx 70rpx}.summary{padding:28rpx;background:#17213B;color:#fff;border-radius:28rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#AFC1EF}.summary-main{display:flex;justify-content:space-between;align-items:flex-end;margin-top:12rpx}.subject-name{font-size:40rpx;font-weight:800}.subject-score{font-size:42rpx;font-weight:800}.summary-note{display:block;margin-top:15rpx;color:#C8D2EA;font-size:23rpx}.filters{display:flex;gap:12rpx;margin:22rpx 0;overflow:hidden}.filter{flex:1;text-align:center;padding:15rpx 6rpx;background:#fff;color:#77839A;font-size:23rpx;border-radius:999rpx}.filter.active{background:#4F7FFF;color:#fff;font-weight:700}.state{margin-top:28rpx;padding:38rpx;background:#fff;border-radius:24rpx;text-align:center;color:#7D889D}.state.error{color:#A05262}.state button{margin-top:18rpx;width:180rpx;font-size:24rpx}.tree{display:flex;flex-direction:column;gap:12rpx}.node{position:relative;display:flex;align-items:center;min-height:116rpx;padding:18rpx 16rpx 18rpx 12rpx;background:#fff;border-radius:22rpx;box-shadow:0 7rpx 26rpx rgba(50,72,120,.05)}.node-pressed{opacity:.88}.node-rail{width:30rpx;align-self:stretch;display:flex;align-items:center;justify-content:center;position:relative}.dot{width:14rpx;height:14rpx;border-radius:50%;background:#B6C0D1;z-index:2}.dot.status-weak{background:#D45B6D}.dot.status-developing{background:#D8A137}.dot.status-good,.dot.status-mastered{background:#3D9B72}.dot.status-insufficient{background:#8290AB}.line{position:absolute;width:2rpx;top:55%;bottom:-34rpx;background:#DDE4F1}.node-body{flex:1;min-width:0}.node-head{display:flex;justify-content:space-between;gap:18rpx;align-items:center}.node-name{font-size:29rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.node-score{font-size:27rpx;font-weight:800;color:#34456B}.node-meta{display:flex;gap:13rpx;align-items:center;flex-wrap:wrap;margin-top:10rpx;font-size:21rpx;color:#8A94A8}.tag{padding:3rpx 9rpx;border-radius:999rpx;background:#EFF2F7}.tag.status-weak{background:#FFF0F1;color:#B64D5F}.tag.status-developing{background:#FFF6E4;color:#9A711E}.tag.status-good,.tag.status-mastered{background:#EAF8F1;color:#287858}.practice{margin-left:12rpx;width:58rpx;height:58rpx;line-height:58rpx;text-align:center;border-radius:50%;background:#EAF0FF;color:#3E61C8;font-size:23rpx;font-weight:800}
.syllabus-note{display:inline-block;margin-top:12rpx;padding:6rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.1);color:#DCE5FA;font-size:20rpx}
