}
.theme-sheet-featured {
  height: 68rpx;
  min-height: 68rpx;
  gap: 9rpx;
  padding: 7rpx 10rpx;
  border-radius: 17rpx;
}
.theme-sheet-featured-icon {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
}
.theme-sheet-featured-icon .theme-icon-image {
