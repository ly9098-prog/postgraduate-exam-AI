  .theme-sheet-item { padding-right: 14rpx; }
}

/* v8 参考稿重构：卡片融合型知识图谱。保留筛选/索引能力，仅替换图谱主体视觉与节点交互。 */
.graph-card {
  margin-top: 18rpx;
  border: 1rpx solid #D5E4CE;
  border-radius: 30rpx;
  background: rgba(250, 253, 247, .97);
  box-shadow: 0 22rpx 52rpx rgba(67, 96, 55, .09), inset 0 1rpx 0 rgba(255,255,255,.96);
}
