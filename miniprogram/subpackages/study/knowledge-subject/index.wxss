}
@keyframes theme-content-fade-in {
  from { opacity: .90; }
  to { opacity: 1; }
}

/* 节点自身保留状态变化的过渡，但取消切换主题时会放大位移感的 transform tween。 */
.theme-content-switching .atlas-node {
  transition: opacity .16s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease;
}
.theme-content-switching .atlas-stage {
