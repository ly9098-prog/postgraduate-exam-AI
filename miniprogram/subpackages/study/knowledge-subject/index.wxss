.graph-canvas .atlas-node-core {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18px;
  border: 1.5px solid rgba(126, 171, 91, .76);
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 22%, rgba(255,255,255,.96) 0, rgba(237,248,221,.95) 24%, rgba(205,231,177,.95) 68%, rgba(184,217,149,.94) 100%);
  color: #244A31;
  box-shadow: 0 18px 38px rgba(76, 110, 55, .16), inset 0 1px 2px rgba(255,255,255,.95), 0 0 0 10px rgba(187, 218, 158, .09);
}
.graph-canvas .atlas-node-core::after {
  inset: 11px;
  border: 1px solid rgba(91, 139, 69, .18);
}
.core-orbit {
  position: absolute;
  inset: -15px;
  border: 1px solid rgba(125, 169, 91, .16);
  border-radius: 50%;
  pointer-events: none;
}
.core-icon-wrap {
  position: relative;
  z-index: 1;
  display: flex;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  margin-bottom: 5px;
}
.core-icon { width: 31px; height: 31px; }
.graph-canvas .core-label {
  position: relative;
  z-index: 1;
  display: -webkit-box;
  width: 100%;
  max-height: 50px;
  overflow: hidden;
  color: #244A31;
  text-align: center;
  font-size: 21px;
  font-weight: 760;
  line-height: 25px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.graph-canvas .core-caption {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 5px;
  color: #74916B;
  font-size: 10.5px;
  line-height: 14px;
  letter-spacing: .6px;
}

.graph-leaf { position: absolute; z-index: 0; width: 98rpx; height: 126rpx; pointer-events: none; opacity: .56; }
.graph-leaf-top { left: -12rpx; top: -22rpx; transform: rotate(19deg); }
.graph-leaf-bottom { right: -11rpx; bottom: -20rpx; transform: rotate(198deg); }
.graph-leaf view {
  position: absolute;
  width: 30rpx;
  height: 62rpx;
  border-radius: 100% 0 100% 0;
  background: linear-gradient(145deg, #B8D998, #82B662);
  transform-origin: bottom center;
}
.graph-leaf view:nth-child(1) { left: 27rpx; bottom: 12rpx; transform: rotate(-28deg); }
.graph-leaf view:nth-child(2) { left: 46rpx; bottom: 34rpx; transform: rotate(12deg) scale(.86); }
.graph-leaf view:nth-child(3) { left: 11rpx; bottom: 42rpx; transform: rotate(-58deg) scale(.72); }

.graph-empty.atlas-empty { background: transparent; }

.graph-card-foot {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 84rpx;
  padding: 14rpx 20rpx 18rpx;
  border-top: 1rpx solid rgba(213, 228, 206, .78);
  background: rgba(250, 253, 247, .96);
}
.graph-scope {
  display: flex;
  min-width: 0;
  max-width: 64%;
  height: 54rpx;
  align-items: center;
  gap: 9rpx;
  padding: 0 14rpx;
  margin: 0 !important;
  border: 1rpx solid #DAE7D4;
  border-radius: 999rpx;
  background: #F5F9F2;
  color: #536B57;
  font-size: 18rpx;
  line-height: 54rpx;
  text-align: left;
}
.graph-scope image { width: 24rpx; height: 24rpx; flex-shrink: 0; }
.graph-scope text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.graph-scope[disabled] { opacity: 1; color: #637763; }
.graph-pagination { display: flex; flex-shrink: 0; align-items: center; gap: 10rpx; }
.graph-page-btn {
  width: 48rpx;
  height: 48rpx;
  padding: 0;
  margin: 0 !important;
  border-radius: 50%;
  background: transparent;
  color: #506B55;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 400;
}
.graph-page-btn[disabled] { color: #B3BFB1; }
.graph-range { min-width: 70rpx; color: #778777; text-align: center; font-family: 'DIN Alternate', sans-serif; font-size: 17rpx; }

.scene-animating .graph-canvas .atlas-node { animation: graph-card-node-in .34s cubic-bezier(.16,1,.3,1) both; }
.scene-animating .graph-canvas .atlas-edge { animation: graph-card-edge-in .28s ease-out both; }
@keyframes graph-card-node-in { from { opacity: .2; transform: translateY(5px) scale(.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes graph-card-edge-in { from { opacity: 0; } to { opacity: .8; } }

@media (max-width: 350px) {
  .graph-card-head { padding-left: 22rpx; padding-right: 22rpx; }
  .graph-card-title { font-size: 31rpx; }
  .graph-count { font-size: 16rpx; }
  .graph-scope { max-width: 58%; }
}

@media (prefers-reduced-motion: reduce) {
  .graph-canvas .atlas-node, .graph-canvas .atlas-stage { transition: none; }
  .scene-animating .graph-canvas .atlas-node, .scene-animating .graph-canvas .atlas-edge { animation: none; }
}

/* v9：继续对齐参考稿。重点修复底部分页越界、触摸高亮，并让节点切换与关联内容有克制的连续过渡。 */
.graph-card {
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}
.graph-canvas.atlas-viewport {
  height: 860rpx;
  -webkit-tap-highlight-color: transparent;
}
.graph-canvas .atlas-stage {
  height: 920px;
}
.graph-canvas .atlas-edge {
  transition: opacity 180ms ease, border-color 220ms ease;
}
.graph-canvas .atlas-edge::after {
  transition: background 220ms ease, transform 220ms cubic-bezier(.16,1,.3,1);
}
.graph-canvas .atlas-edge.edge-active::after {
  transform: scale(1.45);
}

/* 微信小程序 WXSS 不支持通配后代选择器（如 .atlas-node *）。
 * 仅对真实交互容器及其明确子层关闭 WebView 默认高亮，既避免蓝色矩形，也保证 WXSS 可编译。 */
.graph-canvas .atlas-node,
.graph-node-icon,
.graph-node-copy,
.graph-node-label,
.graph-node-caption,
.graph-node-state,
.core-orbit,
.core-icon-wrap,
.core-icon,
.core-label,
.core-caption,
.graph-card-foot,
.graph-footer-bar,
.graph-scope,
.graph-pagination,
.graph-page-btn,
.graph-range,
.index-row,
.index-rank,
.index-dot,
.index-row-copy,
.index-tree-guide,
.index-node-name,
.index-meta-row,
.index-node-meta,
.index-locate,
.locate-crosshair {
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
  outline: none;
}
.graph-canvas .atlas-node {
  -webkit-user-select: none;
  user-select: none;
}
.graph-node-pressed {
  transform: translate3d(0, 1px, 0) scale(.982) !important;
  opacity: .96;
}

/* 中心节点改为更接近参考稿的软质半透明“知识核”，避免正圆过于机械。 */
.graph-canvas .atlas-node-core {
  border-width: 1px;
  border-color: rgba(139, 184, 102, .62);
  border-radius: 43% 57% 49% 51% / 47% 44% 56% 53%;
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.98) 0, rgba(248,253,239,.96) 21%, transparent 44%),
    radial-gradient(circle at 50% 58%, rgba(217,239,190,.96) 0, rgba(201,231,167,.94) 54%, rgba(186,220,150,.91) 100%);
  box-shadow:
    0 20px 42px rgba(78, 112, 57, .14),
    0 0 0 10px rgba(226, 242, 210, .54),
    0 0 0 18px rgba(210, 233, 190, .17),
    inset 0 1px 2px rgba(255,255,255,.98);
}
.graph-canvas .atlas-node-core::before {
  content: '';
  position: absolute;
  inset: 9px 7px 7px 10px;
  border-radius: 48% 52% 45% 55% / 52% 46% 54% 48%;
  background: linear-gradient(145deg, rgba(255,255,255,.46), rgba(255,255,255,0) 48%);
  pointer-events: none;
}
.graph-canvas .atlas-node-core::after {
  inset: 13px;
  border-color: rgba(88, 137, 66, .15);
  border-radius: 47% 53% 52% 48% / 45% 50% 50% 55%;
}
.core-orbit {
  inset: -19px;
  border-color: rgba(133, 174, 100, .13);
}
.graph-canvas .core-icon-wrap { margin-bottom: 7px; }
.graph-canvas .core-label { font-size: 20px; line-height: 24px; }
.graph-canvas .core-caption { margin-top: 7px; color: #7B9871; }

/* 参考稿的底部是一条完整胶囊，不让左右按钮或当前范围挤出卡片。 */
.graph-card-foot {
  display: block;
  width: 100%;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 18rpx 18rpx;
  border-top: 0;
  background: linear-gradient(180deg, #F3F8EE 0%, #F0F6EA 100%);
}
.graph-footer-bar {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  box-sizing: border-box;
  align-items: center;
