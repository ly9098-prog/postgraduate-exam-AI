/* 节点切换：旧详情先轻退，新内容再落位；图谱连线与选中态使用属性过渡，不做大幅位移。 */
.point-card.selection-switching,
.knowledge-index.selection-switching {
  will-change: opacity, transform;
}
.point-card.selection-leaving {
  opacity: .72;
