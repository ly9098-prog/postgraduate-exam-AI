/* v10：半屏主题选择 + 稳定的图谱主题切换 + 细节收口。 */

/* 快捷主题卡片的尾部留白加大，避免箭头贴边；窄屏仍保持两列稳定。 */
.theme-quick-chip {
  grid-template-columns: 58rpx minmax(0, 1fr) 10rpx;
  column-gap: 11rpx;
  padding-left: 12rpx;
  padding-right: 21rpx;
}
.theme-card-arrow {
  justify-self: end;
  margin-right: 1rpx;
}

/* 选择主题：约半屏高度。滚动内容直接延伸到底部，不再预留大块 safe-area 空白。 */
.theme-sheet {
  height: 50vh;
  min-height: 50vh;
  max-height: 50vh;
  padding: 8rpx 20rpx 0;
  border-radius: 28rpx 28rpx 0 0;
}
.theme-sheet-scroll {
  flex: 1 1 0;
  height: 0 !important;
  min-height: 0 !important;
  max-height: none !important;
  margin-top: 7rpx;
  padding-bottom: 0;
}
.theme-sheet-list {
  padding: 0 0 8rpx;
}
.theme-sheet-safe {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
}

/* 弹层列表同样统一箭头安全距离，避免尾部图标贴卡片边线。 */
.theme-sheet-featured,
.theme-sheet-item {
  padding-right: 17rpx;
}
.theme-sheet-item-arrow {
  margin-left: 2rpx;
  margin-right: 2rpx;
}

/* 主题切换不再让节点逐个“弹入”或整体位移。
   只对图谱内容做短促淡出/淡入，避免节点振动、相机跳动与视觉抖动。 */
.atlas-shell.theme-switch-leaving,
.point-card.theme-switch-leaving,
.knowledge-index.theme-switch-leaving {
  opacity: 1;
  transform: none;
  transition: none;
}
.atlas-shell.theme-switch-entering,
.point-card.theme-switch-entering,
.knowledge-index.theme-switch-entering {
  animation: none;
  transform: none;
}
.theme-switch-entering .atlas-node,
.theme-switch-entering .atlas-edge {
  animation: none !important;
}

.atlas-shell.theme-switch-leaving .atlas-viewport,
.atlas-shell.theme-switch-leaving .atlas-panel-head,
.atlas-shell.theme-switch-leaving .atlas-controls,
.atlas-shell.theme-switch-leaving .atlas-panel-foot,
.point-card.theme-switch-leaving,
.knowledge-index.theme-switch-leaving {
  opacity: .90;
  transition: opacity 72ms ease-out;
}
.atlas-shell.theme-switch-entering .atlas-viewport,
.atlas-shell.theme-switch-entering .atlas-panel-head,
.atlas-shell.theme-switch-entering .atlas-controls,
