  width: 46px;
  height: 46px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(199, 219, 190, .84);
  border-radius: 15px;
  background: linear-gradient(145deg, #F9FCF6, #EEF6E8);
  box-shadow: 0 5px 12px rgba(81, 112, 65, .06);
}
.graph-node-icon image { width: 30px; height: 30px; }
.graph-node-copy { position: relative; z-index: 1; flex: 1; min-width: 0; }
.graph-node-label {
  display: -webkit-box;
  overflow: hidden;
  color: #294833;
  font-size: 18px;
  font-weight: 680;
  line-height: 22px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.graph-node-caption {
  display: block;
  overflow: hidden;
  margin-top: 4px;
  color: #82917F;
  font-size: 11.5px;
  line-height: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.graph-node-state {
  position: relative;
  z-index: 1;
  width: 7px;
  height: 7px;
  flex-shrink: 0;
