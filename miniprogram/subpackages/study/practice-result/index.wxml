<view class="page">
  <scroll-view
    class="page-scroll"
    scroll-y="{{!reviewDialogVisible}}"
    enhanced
    bounces="{{false}}"
    show-scrollbar="{{false}}"
  >
  <!-- 顶部成绩区 -->
  <view class="hero" style="padding-top: {{heroTopPaddingPx}}px;">
    <view class="hero-grid"></view>

    <view class="nav">
      <view class="nav-back-hit" bindtap="handleBack" aria-label="返回">
        <view class="nav-back">
          <text class="nav-back-icon">‹</text>
        </view>
      </view>
      <text class="nav-title">练习结果</text>
      <view class="nav-placeholder"></view>
    </view>

    <view class="hero-content">
      <view class="hero-copy">
        <text class="eyebrow">PRACTICE REPORT</text>
        <text class="hero-title">本组练习完成</text>
        <text class="hero-subject">{{subjectName || '本次练习'}}</text>
        <text class="hero-tip">{{resultTip}}</text>
      </view>

      <view
        class="accuracy-ring"
        style="background: conic-gradient(#B8FF13 0% {{accuracyPct}}%, rgba(255,255,255,.16) {{accuracyPct}}% 100%);"
      >
        <view class="ring-halo"></view>
        <view class="ring-inner">
          <view class="ring-value-row">
            <text class="ring-value">{{accuracyPct}}</text>
            <text class="ring-unit">%</text>
          </view>
          <text class="ring-label">作答正确率</text>
        </view>
        <view
          wx:if="{{accuracyPct > 1 && accuracyPct < 99}}"
          class="ring-end-dot"
          style="transform: rotate({{accuracyDotDeg}}deg) translateY(-91rpx);"
        ></view>
      </view>
    </view>
  </view>

  <!-- 主体 -->
  <view class="body">
    <view class="dashboard-card">
      <view class="tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="tab {{activeTab === item.key ? 'tab-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchTab"
        >
          <text>{{item.label}}</text>
          <view wx:if="{{activeTab === item.key}}" class="tab-line"></view>
        </view>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-value success">{{correctCount}}</text>
          <text class="stat-label">答对</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value danger">{{wrongCount}}</text>
          <text class="stat-label">答错</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value skipped">{{skippedCount}}</text>
          <text class="stat-label">跳过</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value partial">{{partialCount}}</text>
          <text class="stat-label">未完成</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{totalCount}}</text>
          <text class="stat-label">总题</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item stat-time">
          <text class="stat-value time-value">{{durationText}}</text>
          <text class="stat-label">用时</text>
        </view>
      </view>
    </view>

    <!-- 结果概览 -->
    <block wx:if="{{activeTab === 'overview'}}">
      <view class="section-card">
        <view class="section-head">
          <view>
            <text class="section-title">作答正确率趋势</text>
            <text class="section-desc">近 7 天练习表现</text>
          </view>
          <view class="section-badge">
            <text>{{trendSummary}}</text>
          </view>
        </view>

        <view class="chart-wrap">
          <view wx:if="{{trendLoading}}" class="chart-loading">正在加载趋势…</view>
          <view wx:elif="{{trendAvailable}}" class="trend-chart">
            <view class="trend-y-axis">
              <text class="trend-y-label trend-y-label-top">100%</text>
              <text class="trend-y-label trend-y-label-mid">50%</text>
              <text class="trend-y-label trend-y-label-bottom">0%</text>
            </view>

            <view class="trend-plot">
              <view class="trend-grid-line trend-grid-line-top"></view>
              <view class="trend-grid-line trend-grid-line-mid"></view>
              <view class="trend-grid-line trend-grid-line-bottom"></view>
              <view wx:if="{{trendAreaStyle}}" class="trend-area" style="{{trendAreaStyle}}"></view>

              <view
                wx:for="{{trendSegments}}"
                wx:key="key"
                class="trend-segment"
                style="left: {{item.leftPct}}%; top: {{item.topPct}}%; width: {{item.widthPct}}%; transform: rotate({{item.angleDeg}}deg);"
              ></view>

              <view
                wx:for="{{trendPoints}}"
                wx:key="key"
                class="trend-point {{item.isLast ? 'trend-point-last' : ''}}"
                style="left: {{item.leftPct}}%; top: {{item.topPct}}%;"
              ></view>

              <view
                wx:if="{{trendLastPoint}}"
                class="trend-last-badge"
                style="left: {{trendLastPoint.leftPct}}%; top: {{trendLastPoint.badgeTopPct}}%;"
              >{{trendLastPoint.accuracy}}%</view>
            </view>

            <view class="trend-x-axis">
              <text
                wx:for="{{trendPoints}}"
                wx:key="key"
                class="trend-x-label"
                style="left: {{item.leftPct}}%;"
              >{{item.dateLabel}}</text>
            </view>
          </view>
          <view wx:else class="chart-loading">{{trendSummary}}</view>
        </view>
      </view>

      <view class="growth-card" wx:if="{{growthAvailable}}">
        <view class="growth-head">
          <view>
            <text class="section-title">{{growthGain > 0 ? '成长值 +' + growthGain : '成长进度'}}</text>
            <text class="section-desc">{{growth.level_title || ('Lv' + growth.level + ' ' + growth.levelTitle)}}</text>
          </view>
          <text class="growth-level">Lv{{growth.level}} {{growth.levelTitle}}</text>
        </view>
        <view class="growth-meta">
          <text>{{growth.exp_current}} / {{growth.exp_to_next}} EXP</text>
          <text>{{growth.level_progress_pct}}%</text>
        </view>
        <view class="progress-track">
          <view class="progress-fill" style="width: {{growth.level_progress_pct}}%;"></view>
        </view>
      </view>
      <view class="growth-card" wx:else>
        <view class="growth-head">
          <view>
            <text class="section-title">成长进度</text>
            <text class="section-desc">成长数据暂不可用，请稍后刷新</text>
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <view>
            <text class="section-title">错题知识点分布</text>
            <text class="section-desc">优先复盘高频薄弱知识点</text>
          </view>
          <text class="wrong-total">{{wrongCount}} 错题</text>
        </view>

        <view class="distribution">
          <view class="donut-wrap">
            <view class="error-donut">
              <image wx:if="{{errorDonutSvg}}" class="error-donut-svg" src="{{errorDonutSvg}}" mode="scaleToFill"></image>
              <view wx:else class="error-donut-fallback" style="background: {{errorDonutGradient}};">
                <view class="error-donut-hole"></view>
              </view>
            </view>
            <view class="donut-center">
              <text class="donut-num">{{wrongCount}}</text>
              <text class="donut-label">错题</text>
            </view>
          </view>

          <view class="legend">
            <view wx:for="{{errorDistribution}}" wx:key="label" class="legend-item">
              <view class="legend-dot" style="background: {{item.color}};"></view>
              <text class="legend-name">{{item.label}}</text>
              <text class="legend-value">{{item.percent}}%</text>
              <text class="legend-count">({{item.count}}题)</text>
            </view>
            <view wx:if="{{!errorDistribution.length}}" class="legend-empty">
              暂无错题分布
            </view>
          </view>
        </view>
      </view>

      <view class="section-card question-preview-card">
        <view class="section-head">
          <view>
            <text class="section-title">题目详情</text>
            <text class="section-desc">快速检查本组作答结果</text>
          </view>
          <view class="filter-pills">
            <view
              wx:for="{{questionFilters}}"
              wx:key="key"
              class="filter-pill {{questionFilter === item.key ? 'filter-pill-active' : ''}}"
              data-key="{{item.key}}"
              bindtap="switchQuestionFilter"
            >
              {{item.label}}
            </view>
          </view>
        </view>

        <view
          class="compact-list"
          style="height: {{questionListHeightRpx}}rpx;"
        >
          <view class="compact-list-content compact-list-content-{{questionFilter}}">
            <view
              wx:for="{{filteredReviewItems}}"
              wx:key="questionId"
              class="compact-row"
              hover-class="result-row-pressed"
              hover-stay-time="80"
              data-id="{{item.questionId}}"
              bindtap="openQuestionDetail"
            >
              <text class="compact-index">{{item.displayIndex}}</text>
              <text class="compact-title">{{item.title}}</text>
              <view class="compact-status {{item.status === 'correct' ? 'status-correct' : (item.status === 'skipped' ? 'status-skipped' : (item.status === 'partial' ? 'status-partial' : 'status-wrong'))}}">
                {{item.status === 'correct' ? '答对' : (item.status === 'skipped' ? '跳过' : (item.status === 'partial' ? '未完成' : '答错'))}}
              </view>
            </view>
            <view wx:if="{{!filteredReviewItems.length}}" class="empty-state">
              当前筛选下暂无题目
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 错题分析 -->
    <block wx:elif="{{activeTab === 'wrong'}}">
      <view class="section-card wrong-list-card">
        <view class="section-head">
          <view>
            <text class="section-title">错题复盘</text>
            <text class="section-desc">共 {{wrongCount}} 道需要重点关注</text>
          </view>
        </view>

        <view wx:if="{{wrongReviewItems.length}}" class="wrong-list">
          <view
            wx:for="{{wrongReviewItems}}"
            wx:key="questionId"
            class="wrong-row"
            hover-class="result-row-pressed"
            hover-stay-time="80"
            data-wqid="{{item.wrongQuestionId}}"
            bindtap="openWrongDetail"
          >
            <view class="wrong-row-top">
              <view class="wrong-index-wrap">
                <text class="wrong-index">{{item.displayIndex}}</text>
                <text class="wrong-tag">错误</text>
              </view>
              <text class="wrong-kp">{{item.knowledgePoint}}</text>
            </view>

            <text class="wrong-title">{{item.title}}</text>

            <view class="wrong-cause-row">
              <view class="wrong-cause-copy">
                <text class="wrong-cause-label">错因</text>
                <text class="wrong-cause-value">{{item.errorDiagnosisLabel || '暂未分类'}}</text>
                <text wx:if="{{item.errorDiagnosis && !item.errorDiagnosis.userConfirmed && item.errorDiagnosis.effectiveSource === 'ai'}}" class="wrong-cause-ai">AI 建议</text>
              </view>
              <button class="wrong-cause-action" data-wqid="{{item.wrongQuestionId}}" catchtap="quickClassifyWrong">快速标记</button>
            </view>

            <view class="answer-summary">
              <view class="answer-inline">
                <text class="answer-inline-label">我的答案：</text>
                <text class="answer-inline-value danger-text">{{item.userAnswer || '未作答'}}</text>
              </view>
              <view class="answer-summary-divider"></view>
              <view class="answer-inline">
                <text class="answer-inline-label">正确答案：</text>
                <text class="answer-inline-value success-text">{{item.correctAnswer || '-'}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="success-empty">
          <view class="success-empty-icon">✓</view>
          <text class="success-empty-title">{{(skippedCount > 0 || partialCount > 0) ? '本组没有答错题' : '本组全部答对'}}</text>
          <text class="success-empty-desc">{{partialCount > 0 ? '还有未完成题，请在题目详情中补充复盘' : (skippedCount > 0 ? '跳过题可在题目详情中单独复盘' : '继续保持当前节奏')}}</text>
        </view>
      </view>
    </block>

    <!-- 成长记录 -->
    <block wx:else>
      <view class="section-card growth-detail-card" wx:if="{{growthAvailable}}">
        <view class="growth-level-hero">
          <view class="level-orb">
            <text>Lv{{growth.level}}</text>
          </view>
          <view class="growth-level-copy">
            <text class="growth-level-title">{{growth.level_title || growth.levelTitle}}</text>
            <text class="growth-level-desc">累计 {{growth.total_exp}} EXP</text>
          </view>
        </view>

        <view class="growth-meta">
          <text>升级进度</text>
          <text>{{growth.exp_current}} / {{growth.exp_to_next}} EXP</text>
        </view>
        <view class="progress-track large">
          <view class="progress-fill" style="width: {{growth.level_progress_pct}}%;"></view>
        </view>

        <view class="growth-grid">
          <view class="growth-grid-item">
            <text class="growth-grid-value">{{growth.streak_days || 0}}</text>
            <text class="growth-grid-label">连续学习天数</text>
          </view>
          <view class="growth-grid-item">
            <text class="growth-grid-value">{{unlockedBadgeCount}}</text>
            <text class="growth-grid-label">已解锁徽章</text>
          </view>
        </view>
      </view>

      <view class="section-card growth-detail-card" wx:else>
        <view class="success-empty">
          <text class="success-empty-title">成长数据暂不可用</text>
          <text class="success-empty-desc">本次答题结果已保存，不影响刷题记录</text>
        </view>
      </view>

      <view class="section-card" wx:if="{{growthAvailable}}">
        <view class="section-head">
          <view>
            <text class="section-title">成长徽章</text>
            <text class="section-desc">{{growth.streak_title || '持续练习，逐步解锁'}}</text>
          </view>
        </view>

        <view wx:if="{{growth.badges && growth.badges.length}}" class="badge-list">
          <view wx:for="{{growth.badges}}" wx:key="key" class="badge-row {{item.unlocked ? '' : 'badge-locked'}}">
            <view class="badge-icon">{{item.unlocked ? '◆' : '◇'}}</view>
            <view class="badge-copy">
              <text class="badge-title">{{item.title}}</text>
              <text class="badge-desc">{{item.desc}}</text>
            </view>
            <text class="badge-progress">{{item.progress_text}}</text>
          </view>
        </view>
        <view wx:else class="empty-state roomy">
          暂无徽章数据
        </view>
      </view>
    </block>

    <view class="bottom-space"></view>
  </view>
  </scroll-view>

  <!-- 题目复盘：使用自定义结构化弹层，避免 wx.showModal 直接暴露后端 JSON -->
  <view wx:if="{{reviewDialogVisible}}" class="review-dialog-mask">
    <view class="review-dialog-backdrop" bindtap="closeReviewDialog" catchtouchmove="noop"></view>
    <view class="review-dialog-sheet" catchtap="stopPropagation">
      <view class="review-dialog-handle" catchtouchmove="noop"></view>

      <view class="review-dialog-head" catchtouchmove="noop">
        <view class="review-dialog-title-wrap">
          <text class="review-dialog-title">{{reviewDialog.title}}</text>
        </view>
        <view class="review-status review-status-{{reviewDialog.status}}">{{reviewDialog.statusLabel}}</view>
      </view>

      <scroll-view
        class="review-dialog-scroll"
        scroll-y
        enhanced
        enable-flex
        bounces="{{false}}"
        scroll-anchoring="{{true}}"
        show-scrollbar="{{false}}"
      >
        <view wx:if="{{reviewDialog.questionTitle}}" class="review-question-card">
          <text class="review-question-label">题目摘要</text>
          <text class="review-question-text">{{reviewDialog.questionTitle}}</text>
        </view>

        <view class="review-answer-grid">
          <view class="review-answer-card">
            <text class="review-answer-label">我的答案</text>
            <text class="review-answer-value review-answer-user review-answer-user-{{reviewDialog.status}}">{{reviewDialog.userAnswer}}</text>
          </view>
          <view class="review-answer-card review-answer-card-correct">
            <text class="review-answer-label">正确答案</text>
            <text class="review-answer-value review-answer-correct">{{reviewDialog.correctAnswer}}</text>
          </view>
        </view>

        <view class="review-analysis-wrap">
          <view class="review-analysis-heading">
            <text class="review-analysis-heading-title">解析与复盘</text>
          </view>

          <view class="review-analysis-list">
            <view
              wx:for="{{reviewDialog.analysisSections}}"
              wx:key="key"
              class="review-analysis-card"
            >
              <view class="review-analysis-index">0{{index + 1}}</view>
              <view class="review-analysis-content">
                <text class="review-analysis-card-title">{{item.title}}</text>
                <view class="review-analysis-paragraphs">
                  <text
                    wx:for="{{item.paragraphs}}"
                    wx:for-item="paragraph"
                    wx:key="key"
                    class="review-analysis-text"
                    selectable="true"
                  >{{paragraph.text}}</text>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{reviewDialog.analysisFormatError}}" class="review-analysis-empty review-analysis-warning">
            <text class="review-analysis-empty-title">解析内容暂无法正常展示</text>
            <text class="review-analysis-empty-desc">解析内容格式异常，已隐藏异常内容，请稍后再试。</text>
          </view>
          <view wx:elif="{{!reviewDialog.analysisSections.length}}" class="review-analysis-empty">
            <text class="review-analysis-empty-title">暂无题目解析</text>
            <text class="review-analysis-empty-desc">答案已保留，可根据正确答案继续复盘。</text>
          </view>
        </view>
      </scroll-view>

      <view class="review-dialog-footer review-dialog-footer-ai" catchtouchmove="noop">
        <view class="review-dialog-ai" bindtap="open408TeacherFromReview">问 408 AI 老师</view>
        <view
          class="review-dialog-confirm"
          hover-class="review-dialog-confirm-pressed"
          hover-stay-time="80"
          bindtap="closeReviewDialog"
        >知道了</view>
      </view>
    </view>
  </view>
</view>

<!-- 普通练习复盘的 408 专项 AI 老师 -->
<view class="teacher-modal-mask" wx:if="{{teacherSheetVisible}}" catchtouchmove="noop">
  <view class="teacher-modal-backdrop" bindtap="close408Teacher"></view>
  <view class="teacher-sheet" catchtap="stopPropagation">
    <view class="teacher-sheet-head">
      <view><text class="teacher-kicker">408 AI TEACHER</text><text class="teacher-sheet-title">{{teacherResult ? teacherResult.title : '408 专项 AI 老师'}}</text></view>
      <text class="teacher-sheet-close" bindtap="close408Teacher">×</text>
    </view>
    <view wx:if="{{!teacherLoading && !teacherErrorText && !teacherResult}}" class="teacher-action-panel">
      <text class="teacher-action-title">选择一个固定教学动作</text>
      <button wx:for="{{teacherActions}}" wx:key="action" class="teacher-action-choice" data-action="{{item.action}}" bindtap="select408TeacherAction">{{item.label}}</button>
    </view>
    <view wx:elif="{{teacherLoading}}" class="teacher-sheet-loading"><view class="teacher-spinner"></view><text>正在结合本题与学习状态生成…</text></view>
    <view wx:elif="{{teacherErrorText}}" class="teacher-sheet-error">{{teacherErrorText}}</view>
    <scroll-view wx:elif="{{teacherResult}}" class="teacher-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <text wx:if="{{teacherResult.summary}}" class="teacher-summary">{{teacherResult.summary}}</text>
      <view wx:for="{{teacherResult.sections}}" wx:key="key" class="teacher-result-section">
        <text class="teacher-result-heading">{{item.heading}}</text>
        <text wx:for="{{item.points}}" wx:for-item="point" wx:key="*this" class="teacher-result-point">• {{point}}</text>
      </view>
      <view wx:if="{{teacherResult.knowledgePoints.length}}" class="teacher-result-section">
        <text class="teacher-result-heading">知识点串联</text>
        <view wx:for="{{teacherResult.knowledgePoints}}" wx:key="key" class="teacher-kp-row">
          <text class="teacher-kp-name">{{item.name}}</text>
          <text wx:if="{{item.relation}}" class="teacher-kp-note">{{item.relation}}</text>
          <text wx:if="{{item.masteryHint}}" class="teacher-kp-note">{{item.masteryHint}}</text>
        </view>
      </view>
      <view wx:if="{{teacherResult.practiceQuestion}}" class="teacher-result-section">
        <text class="teacher-result-heading">练一题</text>
        <text class="teacher-practice-stem">{{teacherResult.practiceQuestion.stem}}</text>
        <view wx:for="{{teacherResult.practiceQuestion.options}}" wx:key="key" class="teacher-practice-option"><text class="teacher-practice-key">{{item.key}}</text><text>{{item.text}}</text></view>
        <text class="teacher-practice-answer">答案：{{teacherResult.practiceQuestion.answer}}</text>
        <text wx:if="{{teacherResult.practiceQuestion.analysis}}" class="teacher-practice-analysis">{{teacherResult.practiceQuestion.analysis}}</text>
      </view>
      <text class="teacher-footnote">{{teacherResult.fromFallback ? '当前使用题库解析兜底；AI 生成暂不可用。' : '内容由 408 专项 AI 老师生成，仅用于本题复盘。'}}</text>
      <view class="teacher-feedback-row">
        <text class="teacher-feedback-label">这次讲解有帮助吗？</text>
        <button class="teacher-feedback-btn {{teacherFeedbackSent === 'helpful' ? 'selected' : ''}}" data-type="helpful" disabled="{{teacherFeedbackSent}}" bindtap="feedback408Teacher">有帮助</button>
        <button class="teacher-feedback-btn {{teacherFeedbackSent === 'inaccurate' ? 'selected' : ''}}" data-type="inaccurate" disabled="{{teacherFeedbackSent}}" bindtap="feedback408Teacher">不准确</button>
      </view>
      <view class="teacher-scroll-space"></view>
    </scroll-view>
  </view>
</view>
