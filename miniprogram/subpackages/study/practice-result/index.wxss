page {
  min-height: 100%;
  background: #F3F5F1;
  color: #17211C;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.page {
  height: 100vh;
  overflow: hidden;
  background: #F3F5F1;
}

.page-scroll {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
}

.hero {
  position: relative;
  box-sizing: border-box;
  min-height: 430rpx;
  padding: 16rpx 32rpx 92rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 0%, rgba(99, 198, 87, .14), transparent 38%),
    linear-gradient(145deg, #0C2A1F 0%, #092217 56%, #071B13 100%);
}

.hero-grid {
  position: absolute;
  top: -40rpx;
  right: -50rpx;
  width: 360rpx;
  height: 300rpx;
  opacity: .16;
  transform: rotate(7deg);
  background-image:
    linear-gradient(rgba(166, 255, 153, .23) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(166, 255, 153, .23) 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
  pointer-events: none;
}

.nav {
  position: relative;
  z-index: 2;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-back-hit,
.nav-placeholder {
  width: 88rpx;
  height: 72rpx;
}

.nav-back-hit {
  position: relative;
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 1rpx solid rgba(255,255,255,.14);
  background: rgba(255,255,255,.08);
}

.nav-back-icon {
  margin-top: -8rpx;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
  color: #FFF;
}

.nav-title {
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FFF;
}

.hero-content {
  position: relative;
  z-index: 2;
  margin-top: 42rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-copy {
  width: 60%;
  min-width: 0;
}

.eyebrow {
  display: block;
  margin-bottom: 18rpx;
  color: #B8FF13;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.hero-title {
  display: block;
  color: #FFF;
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.hero-subject {
  display: block;
  margin-top: 12rpx;
  color: rgba(255,255,255,.7);
  font-size: 23rpx;
  font-weight: 600;
}

.hero-tip {
  display: -webkit-box;
  margin-top: 18rpx;
  overflow: hidden;
  color: rgba(255,255,255,.5);
  font-size: 21rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.accuracy-ring {
  position: relative;
  flex: 0 0 auto;
  width: 196rpx;
  height: 196rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 50%;
  box-shadow:
    0 0 0 1rpx rgba(184,255,19,.12),
    0 0 38rpx rgba(184,255,19,.08);
}

.ring-halo {
  position: absolute;
  inset: -12rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(184,255,19,.12);
  box-shadow: inset 0 0 26rpx rgba(184,255,19,.05);
}

.ring-inner {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 34%, rgba(45, 92, 69, .46), rgba(7, 28, 19, .98) 68%);
  box-shadow:
    inset 0 0 0 1rpx rgba(255,255,255,.05),
    inset 0 14rpx 26rpx rgba(255,255,255,.02);
}

.ring-value-row {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  line-height: 1;
}

.ring-value {
  color: #FFF;
  font-size: 62rpx;
  font-weight: 800;
  letter-spacing: -3rpx;
}

.ring-unit {
  margin: 0 0 8rpx 4rpx;
  color: #B8FF13;
  font-size: 26rpx;
  font-weight: 800;
}

.ring-label {
  margin-top: 5rpx;
  color: rgba(255,255,255,.62);
  font-size: 20rpx;
  font-weight: 600;
}


.ring-end-dot {
  position: absolute;
  z-index: 3;
  left: 50%;
  top: 50%;
  width: 16rpx;
  height: 16rpx;
  margin: -8rpx 0 0 -8rpx;
  border-radius: 50%;
  background: #E8FF8E;
  box-shadow: 0 0 16rpx rgba(184,255,19,.86);
  transform-origin: center;
}

.body {
  position: relative;
  z-index: 3;
  margin-top: -56rpx;
  padding: 0 24rpx;
}

.dashboard-card,
.section-card,
.growth-card {
  box-sizing: border-box;
  border: 1rpx solid #E2E7E3;
  background: rgba(255,255,255,.98);
  box-shadow: 0 12rpx 34rpx rgba(18, 37, 27, .055);
}

.dashboard-card {
  overflow: hidden;
  border-radius: 30rpx;
}

.tabs {
  height: 84rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: stretch;
  border-bottom: 1rpx solid #EDF0ED;
}

.tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #89918D;
  font-size: 22rpx;
  font-weight: 600;
}

.tab-active {
  color: #238D48;
  font-weight: 800;
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 42rpx;
  height: 6rpx;
  border-radius: 8rpx 8rpx 0 0;
  background: #32A852;
  transform: translateX(-50%);
}

.stats-row {
  height: 112rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-divider {
  width: 1rpx;
  height: 54rpx;
  background: #E7EBE8;
}

.stat-value {
  color: #17211C;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
}

.stat-value.success,
.success-text {
  color: #239151;
}

.stat-value.danger,
.danger-text {
  color: #E64B4B;
}

.stat-value.skipped {
  color: #B27A22;
}

.stat-value.partial {
  color: #6D6F9B;
}

.stat-label {
  margin-top: 10rpx;
  color: #A0A7A3;
  font-size: 19rpx;
  white-space: nowrap;
}

.stat-time {
  flex: 1.25;
}

.time-value {
  font-size: 28rpx;
  letter-spacing: -1rpx;
  white-space: nowrap;
}

.section-card,
.growth-card {
  margin-top: 20rpx;
  border-radius: 26rpx;
}

.section-card {
  padding: 28rpx;
}

.section-head {
  min-height: 54rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-title {
  display: block;
  color: #17211C;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 800;
}

.section-desc {
  display: block;
  margin-top: 8rpx;
  color: #A0A7A3;
  font-size: 19rpx;
  line-height: 1.3;
}

.section-badge {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #EDF8EE;
  color: #298B48;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
}

.chart-wrap {
  position: relative;
  height: 274rpx;
  margin-top: 18rpx;
}

.trend-chart {
  position: relative;
  width: 100%;
  height: 274rpx;
  box-sizing: border-box;
}

.trend-y-axis {
  position: absolute;
  left: 0;
  top: 16rpx;
  bottom: 52rpx;
  width: 58rpx;
  color: #99A19C;
  font-size: 18rpx;
  line-height: 1;
  pointer-events: none;
}

.trend-y-label {
  position: absolute;
  right: 10rpx;
  transform: translateY(-50%);
}

.trend-y-label-top {
  top: 0;
  transform: translateY(0);
}

.trend-y-label-mid {
  top: 50%;
}

.trend-y-label-bottom {
  bottom: 0;
  transform: translateY(50%);
}

.trend-plot {
  position: absolute;
  left: 58rpx;
  right: 8rpx;
  top: 16rpx;
  height: 206rpx;
  overflow: visible;
}

.trend-grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #E9EEEA;
}

.trend-grid-line-top {
  top: 0;
}

.trend-grid-line-mid {
  top: 50%;
}

.trend-grid-line-bottom {
  bottom: 0;
}

.trend-area {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(53, 166, 87, .18) 0%, rgba(53, 166, 87, 0) 100%);
  pointer-events: none;
}

.trend-segment {
  position: absolute;
  z-index: 2;
  height: 4rpx;
  margin-top: -2rpx;
  border-radius: 999rpx;
  background: #319D54;
  transform-origin: left center;
  pointer-events: none;
}

.trend-point {
  position: absolute;
  z-index: 3;
  width: 13rpx;
  height: 13rpx;
  box-sizing: border-box;
  border: 4rpx solid #2F9E54;
  border-radius: 50%;
  background: #FFFFFF;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.trend-point-last {
  width: 17rpx;
  height: 17rpx;
  border: 0;
  background: #2F9E54;
}

.trend-last-badge {
  position: absolute;
  z-index: 4;
  min-width: 58rpx;
  box-sizing: border-box;
  padding: 8rpx 11rpx;
  border-radius: 10rpx;
  background: #2E9250;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
  text-align: center;
  transform: translate(-50%, -116%);
  pointer-events: none;
}

.trend-x-axis {
  position: absolute;
  left: 58rpx;
  right: 8rpx;
  bottom: 0;
  height: 38rpx;
  color: #9AA29D;
  font-size: 17rpx;
  line-height: 1;
}

.trend-x-label {
  position: absolute;
  top: 0;
  min-width: 54rpx;
  text-align: center;
  transform: translateX(-50%);
}

.chart-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #A0A7A3;
  font-size: 20rpx;
  background: rgba(255,255,255,.7);
}

.growth-card {
  padding: 26rpx 28rpx;
}

.growth-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.growth-level {
  flex: 0 0 auto;
  color: #65A909;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
}

.growth-meta {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8B938E;
  font-size: 18rpx;
}

.progress-track {
  overflow: hidden;
  background: #E6ECE7;
  border-radius: 999rpx;
}

.progress-track {
  height: 9rpx;
  margin-top: 10rpx;
}

.progress-track.large {
  height: 12rpx;
}

.progress-fill {
  height: 100%;
  min-width: 0;
  max-width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6DD335 0%, #B8FF13 100%);
  box-shadow: 0 0 12rpx rgba(121, 210, 45, .24);
}

.wrong-total {
  flex: 0 0 auto;
  color: #E54E4E;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.distribution {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.donut-wrap {
  position: relative;
  flex: 0 0 auto;
  width: 210rpx;
  height: 210rpx;
}

.error-donut {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.error-donut-svg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.error-donut-fallback {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  overflow: hidden;
}

.error-donut-hole {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #FFFFFF;
  transform: translate(-50%, -50%);
}

.donut-center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.donut-num {
  color: #17211C;
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
}

.donut-label {
  margin-top: 8rpx;
  color: #9AA19D;
  font-size: 18rpx;
}

.legend {
  flex: 1;
  min-width: 0;
}

.legend-item {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  color: #656E69;
  font-size: 19rpx;
}

.legend-dot {
  flex: 0 0 auto;
  width: 14rpx;
  height: 14rpx;
  margin-right: 12rpx;
  border-radius: 4rpx;
}

.legend-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.legend-value {
  flex: 0 0 auto;
  margin-left: 10rpx;
  color: #38423D;
  font-weight: 800;
  white-space: nowrap;
}

.legend-count {
  flex: 0 0 auto;
  margin-left: 5rpx;
  color: #A5ABA7;
  white-space: nowrap;
}

.legend-empty {
  padding: 40rpx 0;
  color: #A0A7A3;
  font-size: 20rpx;
  text-align: center;
}

.question-preview-card {
  padding-bottom: 18rpx;
  overflow: hidden;
}

.question-preview-card .section-head > view:first-child {
  flex: 0 0 auto;
}

.filter-pills {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8rpx;
}

.filter-pill {
  min-width: 62rpx;
  box-sizing: border-box;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: #8F9792;
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
  background: #F4F6F4;
  transition: color 180ms ease, background-color 180ms ease;
}

.filter-pill-active {
  color: #278C49;
  font-weight: 600;
  background: #EAF7EC;
}

.compact-list {
  margin-top: 18rpx;
  overflow: hidden;
  border-top: 1rpx solid #EEF1EE;
  transition: height 220ms cubic-bezier(.22, .61, .36, 1);
}

.compact-list-content {
  transform-origin: top center;
}

.compact-list-content-all {
  animation: question-list-reveal-all 220ms cubic-bezier(.22, .61, .36, 1) both;
}

.compact-list-content-correct {
  animation: question-list-reveal-correct 220ms cubic-bezier(.22, .61, .36, 1) both;
}

.compact-list-content-wrong {
  animation: question-list-reveal-wrong 220ms cubic-bezier(.22, .61, .36, 1) both;
}

.compact-list-content-skipped {
  animation: question-list-reveal-wrong 220ms cubic-bezier(.22, .61, .36, 1) both;
}

@keyframes question-list-reveal-all {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes question-list-reveal-correct {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes question-list-reveal-wrong {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.compact-row {
  height: 86rpx;
  min-height: 86rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid #EEF1EE;
  transition: background-color 90ms ease;
}

.compact-index {
  flex: 0 0 auto;
  width: 42rpx;
  color: #7A837E;
  font-size: 20rpx;
  font-weight: 700;
}

.compact-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #303934;
  font-size: 21rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.compact-status {
  flex: 0 0 auto;
  padding: 6rpx 10rpx;
  border-radius: 7rpx;
  font-size: 17rpx;
  font-weight: 700;
}

.status-correct {
  color: #298F4A;
  background: #EAF7EC;
}

.status-wrong {
  color: #E24E4E;
  background: #FFF0F0;
}

.status-skipped {
  color: #9A681D;
  background: #FFF6E4;
}

.status-partial {
  color: #666A96;
  background: #F0F1FA;
}


.wrong-list-card {
  padding-bottom: 16rpx;
}

.wrong-list {
  margin-top: 14rpx;
  border-top: 1rpx solid #EEF1EE;
}

.wrong-row {
  padding: 22rpx 0 24rpx;
  border-bottom: 1rpx solid #EEF1EE;
  transition: background-color 90ms ease;
}

.result-row-pressed {
  background: #F3F6F3;
}

.wrong-row:last-child {
  border-bottom: 0;
}

.wrong-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.wrong-index-wrap {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
}

.wrong-index {
  color: #27312C;
  font-size: 21rpx;
  font-weight: 800;
}

.wrong-tag {
  margin-left: 12rpx;
  padding: 4rpx 9rpx;
  border-radius: 7rpx;
  color: #E34E4E;
  font-size: 16rpx;
  line-height: 1.35;
  font-weight: 700;
  background: #FFF0F0;
}

.wrong-kp {
  min-width: 0;
  overflow: hidden;
  color: #9AA19D;
  font-size: 17rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.wrong-title {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #313936;
  font-size: 22rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.answer-summary {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.answer-inline {
  min-width: 0;
  display: flex;
  align-items: center;
}

.answer-inline-label {
  flex: 0 0 auto;
  color: #8D9590;
  font-size: 18rpx;
}

.answer-inline-value {
  max-width: 150rpx;
  overflow: hidden;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.answer-summary-divider {
  flex: 0 0 auto;
  width: 1rpx;
  height: 24rpx;
  margin: 0 20rpx;
  background: #E6EAE7;
}

.success-empty,
.empty-state {
  color: #9AA29D;
  text-align: center;
}

.empty-state {
  padding: 36rpx 0;
  font-size: 20rpx;
}

.compact-list .empty-state {
  height: 96rpx;
  box-sizing: border-box;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state.roomy {
  padding: 80rpx 0;
}

.success-empty {
  padding: 90rpx 0 70rpx;
}

.success-empty-icon {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFF;
  font-size: 42rpx;
  background: #39A85D;
}

.success-empty-title {
  display: block;
  margin-top: 20rpx;
  color: #334039;
  font-size: 27rpx;
  font-weight: 800;
}

.success-empty-desc {
  display: block;
  margin-top: 9rpx;
  color: #A0A7A3;
  font-size: 19rpx;
}

.growth-detail-card {
  padding-top: 34rpx;
}

.growth-level-hero {
  display: flex;
  align-items: center;
}

.level-orb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #15391F;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(145deg, #D8FF79 0%, #9DDF42 100%);
  box-shadow: 0 12rpx 24rpx rgba(115, 172, 55, .18);
}

.growth-level-copy {
  margin-left: 22rpx;
}

.growth-level-title {
  display: block;
  color: #27342D;
  font-size: 31rpx;
  font-weight: 800;
}

.growth-level-desc {
  display: block;
  margin-top: 9rpx;
  color: #9AA29D;
  font-size: 20rpx;
}

.growth-grid {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.growth-grid-item {
  padding: 22rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #F5F7F5;
}

.growth-grid-value {
  display: block;
  color: #25352C;
  font-size: 34rpx;
  font-weight: 800;
}

.growth-grid-label {
  display: block;
  margin-top: 6rpx;
  color: #9AA29D;
  font-size: 17rpx;
}

.badge-list {
  margin-top: 18rpx;
}

.badge-row {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #EEF1EE;
}

.badge-icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  margin-right: 16rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3A9D56;
  font-size: 26rpx;
  background: #E9F8EC;
}

.badge-copy {
  flex: 1;
  min-width: 0;
}

.badge-title {
  display: block;
  color: #39443E;
  font-size: 21rpx;
  font-weight: 700;
}

.badge-desc {
  display: block;
  margin-top: 6rpx;
  overflow: hidden;
  color: #A0A7A3;
  font-size: 17rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.badge-progress {
  margin-left: 14rpx;
  color: #67A339;
  font-size: 17rpx;
  font-weight: 700;
}

.badge-locked {
  opacity: .46;
}

.bottom-space {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

/* ── 结构化题目复盘弹层 ─────────────────────────────── */
.review-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.review-dialog-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(7, 18, 13, .58);
  animation: review-mask-in 180ms ease-out both;
}

.review-dialog-sheet {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 82vh;
  max-height: 84vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 38rpx 38rpx 0 0;
  background: #F8FAF7;
  box-shadow: 0 -24rpx 70rpx rgba(3, 16, 10, .22);
  animation: review-sheet-in 240ms cubic-bezier(.22, .61, .36, 1) both;
}

.review-dialog-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 16rpx auto 4rpx;
  border-radius: 999rpx;
  background: #D9DEDA;
}

.review-dialog-head {
  flex: 0 0 auto;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 18rpx 34rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid #E9EDE9;
  background: #FFFFFF;
}

.review-dialog-title-wrap {
  min-width: 0;
}

.review-dialog-title {
  display: block;
  color: #17211C;
  font-size: 31rpx;
  line-height: 1.2;
  font-weight: 850;
}

.review-status {
  flex: 0 0 auto;
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
}

.review-status-correct {
  color: #237D43;
  background: #E8F7EB;
}

.review-status-skipped {
  color: #97651E;
  background: #FFF4DE;
}

.review-status-partial {
  color: #646891;
  background: #EFF0FA;
}

.review-dialog-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 0;
  box-sizing: border-box;
  padding: 26rpx 28rpx 38rpx;
}

.review-question-card {
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  border: 1rpx solid #E7EBE7;
  background: #FFFFFF;
}

.review-question-label,
.review-answer-label {
  display: block;
  color: #98A09B;
  font-size: 17rpx;
  line-height: 1.3;
  font-weight: 650;
}

.review-question-text {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #303934;
  font-size: 21rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.review-answer-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.review-answer-card {
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ECEFEC;
  background: #FFFFFF;
}

.review-answer-card-correct {
  border-color: #DDEDE1;
  background: #F4FBF5;
}

.review-answer-value {
  display: block;
  margin-top: 9rpx;
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 800;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.review-answer-user {
  color: #55615A;
}

.review-answer-user-skipped,
.review-answer-user-partial {
  color: #A17A3B;
}

.review-answer-correct {
  color: #248147;
}

.review-analysis-wrap {
  margin-top: 32rpx;
  padding-bottom: 22rpx;
}

.review-analysis-heading {
  margin-bottom: 4rpx;
}

.review-analysis-heading-title {
  color: #26332C;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

/* 复用错题详情页的“分段复盘”视觉语法：序号 + 分隔线 + 正文。
 * 不再使用彩色边框、彩色底卡和发光圆点，避免看起来像 AI 生成卡片。 */
.review-analysis-list {
  margin-top: 14rpx;
  border-top: 1rpx solid #E4E8E4;
}

.review-analysis-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 0;
  padding: 28rpx 0 30rpx;
  border: 0;
  border-bottom: 1rpx solid #E4E8E4;
  border-radius: 0;
  background: transparent;
}

.review-analysis-card:last-child {
  border-bottom: 0;
}

.review-analysis-index {
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  box-sizing: border-box;
  border: 1rpx solid #CDD3CE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6D7771;
  font-size: 15rpx;
  line-height: 1;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  background: #F8FAF7;
}

.review-analysis-content {
  flex: 1;
  min-width: 0;
}

.review-analysis-card-title {
  display: block;
  color: #27352D;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

.review-analysis-paragraphs {
  margin-top: 12rpx;
}

.review-analysis-text {
  display: block;
  color: #505B55;
  font-size: 23rpx;
  line-height: 1.88;
  letter-spacing: .2rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.review-analysis-text + .review-analysis-text {
  margin-top: 16rpx;
}

.review-analysis-empty {
  padding: 38rpx 26rpx;
  border-radius: 22rpx;
  text-align: center;
  border: 1rpx dashed #DDE3DE;
  background: #F5F7F5;
}

.review-analysis-warning {
  border-color: #E7D7B8;
  background: #FFF9EC;
}

.review-analysis-empty-title {
  display: block;
  color: #66706A;
  font-size: 20rpx;
  font-weight: 750;
}

.review-analysis-empty-desc {
  display: block;
  margin-top: 9rpx;
  color: #9AA29D;
  font-size: 17rpx;
  line-height: 1.55;
}

.review-dialog-footer {
  flex: 0 0 auto;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E6EAE6;
  background: #FFFFFF;
}

.review-dialog-confirm {
  height: 82rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #12351F;
  font-size: 24rpx;
  font-weight: 850;
  background: linear-gradient(135deg, #C9F56A 0%, #9FDF4A 100%);
  box-shadow: 0 10rpx 24rpx rgba(111, 168, 61, .18);
  transition: transform 90ms ease, opacity 90ms ease;
}

.review-dialog-confirm-pressed {
  transform: scale(.985);
  opacity: .88;
}

@keyframes review-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes review-sheet-in {
  from { opacity: .2; transform: translateY(54rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 408-ERROR quick confirmation */
.wrong-cause-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin:18rpx 0 2rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#f5f7f5}.wrong-cause-copy{display:flex;align-items:center;gap:10rpx;min-width:0}.wrong-cause-label{font-size:21rpx;color:#829087}.wrong-cause-value{font-size:23rpx;font-weight:650;color:#2d3a32}.wrong-cause-ai{padding:4rpx 8rpx;border-radius:8rpx;background:#eef0ff;color:#5960a8;font-size:18rpx}.wrong-cause-action{margin:0;padding:0 14rpx;height:52rpx;line-height:52rpx;border-radius:14rpx;background:#17221b;color:#fff;font-size:21rpx;white-space:nowrap}.wrong-cause-action::after{border:0}

