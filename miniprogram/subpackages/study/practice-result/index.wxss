ont-weight:760;color:#244436}.teacher-kp-note{display:block;margin-top:4rpx;font-size:19rpx;line-height:1.5;color:#7B857D}.teacher-practice-stem{display:block;font-size:23rpx;line-height:1.7;color:#263B31}.teacher-practice-option{margin-top:12rpx;padding:14rpx 16rpx;border-radius:13rpx;background:#F6F7F2;display:flex;gap:12rpx;font-size:21rpx;line-height:1.55;color:#3D4B43}.teacher-practice-key{font-weight:820;color:#1F5B40}.teacher-practice-answer{display:block;margin-top:16rpx;font-size:21rpx;font-weight:780;color:#17613F}.teacher-practice-analysis{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:#667168}.teacher-footnote{display:block;margin-top:18rpx;font-size:18rpx;line-height:1.5;color:#949B95;text-align:center}.teacher-scroll-space{height:24rpx}

