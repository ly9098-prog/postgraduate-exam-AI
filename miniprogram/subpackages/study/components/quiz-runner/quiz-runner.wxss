.runner-mode-wrong-detail .runner-option-key, .runner-mode-wrong-detail .runner-option-text{font-size:26rpx;line-height:1.58;}
.runner-mode-wrong-detail .runner-option-key{color:#536159;font-weight:750;}
.runner-mode-wrong-detail .runner-option-text{color:#303A34;font-weight:500;}
.runner-mode-wrong-detail .runner-option-item.runner-user-answer .runner-option-key{color:#A85140;}
