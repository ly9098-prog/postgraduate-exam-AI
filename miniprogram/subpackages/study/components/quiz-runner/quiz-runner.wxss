}
.runner-fallback-text{padding:32rpx 24rpx;font-size:28rpx;color:#555E58;line-height:1.7;white-space:pre-wrap;word-break:break-word;}
.runner-hero-meta-actions{display:flex;align-items:center;gap:14rpx;flex-shrink:0}
.runner-mark-btn{padding:7rpx 15rpx;border-radius:999rpx;border:1rpx solid rgba(255,255,255,.22);font-size:20rpx;color:rgba(255,255,255,.74);font-weight:700}
.runner-mark-btn.runner-marked{border-color:#C8F04A;background:rgba(200,240,74,.14);color:#DDFB7A}
.runner-segment.marked{box-shadow:inset 0 -4rpx 0 #F0B84B}
.runner-legend-dot.marked{background:#F0B84B}
.runner-sheet-cell.runner-marked-cell{box-shadow:inset 0 0 0 3rpx #F0B84B}

/* 推荐原因 · 参考图还原 */
.runner-recommend-bar{min-height:92rpx;margin:-4rpx 0 24rpx;padding:10rpx 16rpx;border:1rpx solid #DDEAE5;border-left:1rpx solid #DDEAE5;border-radius:16rpx;display:flex;align-items:center;gap:12rpx;box-sizing:border-box;box-shadow:0 6rpx 18rpx rgba(20, 73, 48, .025);}
.runner-theme-premium-review .runner-recommend-bar{min-height:92rpx;margin:-4rpx 0 24rpx;padding:10rpx 16rpx;border:1rpx solid #DDEAE5;border-left:1rpx solid #DDEAE5;border-radius:16rpx;background:linear-gradient(105deg, #F8FFFC 0%, #FBFEFC 56%, #F7FBF9 100%);display:flex;align-items:center;gap:12rpx;box-sizing:border-box;box-shadow:0 6rpx 18rpx rgba(20, 73, 48, .025);}

.runner-recommend-icon-wrap{width:46rpx;height:46rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;}

.runner-recommend-icon{width:46rpx;height:46rpx;display:block;}

.runner-recommend-divider{width:2rpx;height:48rpx;border-radius:999rpx;flex-shrink:0;}

.runner-recommend-copy{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx;}

.runner-recommend-label{width:92rpx;flex:0 0 92rpx;font-size:23rpx;line-height:1.22;font-weight:900;letter-spacing:.5rpx;white-space:nowrap;}

.runner-theme-premium-review .runner-recommend-label{width:92rpx;flex:0 0 92rpx;color:#126438;font-size:23rpx;line-height:1.22;font-weight:900;letter-spacing:.5rpx;white-space:nowrap;}

.runner-recommend-copy-divider{width:1rpx;height:48rpx;flex-shrink:0;}

.runner-recommend-text{flex:1;min-width:0;font-size:19rpx;line-height:1.52;font-weight:450;}

.runner-theme-premium-review .runner-recommend-text{flex:1;min-width:0;color:#52645A;font-size:19rpx;line-height:1.52;font-weight:450;}

.runner-mode-wrong-detail .runner-recommend-bar{margin:-2rpx 0 24rpx;padding:18rpx 22rpx;border:1rpx solid #DDEAE5;border-radius:16rpx;background:linear-gradient(105deg, #F8FFFC 0%, #FBFEFC 56%, #F7FBF9 100%);}

.runner-mode-wrong-detail .runner-recommend-label{color:#126438;font-size:23rpx;font-weight:900;}

.runner-mode-wrong-detail .runner-recommend-text{color:#52645A;font-size:23rpx;line-height:1.68;}

@media (max-width: 360px) {
  .runner-recommend-bar, .runner-theme-premium-review .runner-recommend-bar{gap:10rpx;padding-left:14rpx;padding-right:14rpx;}

  .runner-recommend-icon-wrap, .runner-recommend-icon{width:42rpx;height:42rpx;}

  .runner-recommend-copy{gap:11rpx;}

  .runner-recommend-label, .runner-theme-premium-review .runner-recommend-label{width:84rpx;flex-basis:84rpx;font-size:21rpx;}

  .runner-recommend-text, .runner-theme-premium-review .runner-recommend-text{font-size:18rpx;line-height:1.5;}
}

/* Mint focus system: keeps the runner calm, legible, and close to the study setup surface. */
.quiz-runner{background:#F3FBF8;color:#23483C;}
.runner-hero{padding:20rpx 28rpx 26rpx;background:radial-gradient(circle at 92% 0%, rgba(126, 216, 181, .26) 0, rgba(126, 216, 181, 0) 34%),
    linear-gradient(145deg, #EAF9F4 0%, #F7FFFC 72%, #FFFFFF 100%);color:#23483C;box-shadow:inset 0 -1rpx 0 rgba(126, 216, 181, .18);}
.runner-hero-glow{right:-84rpx;bottom:-112rpx;border-color:rgba(126, 216, 181, .22);box-shadow:0 0 0 42rpx rgba(126, 216, 181, .06), 0 0 0 88rpx rgba(126, 216, 181, .03);}
.runner-hero-grid{opacity:0;}
.runner-back-btn{border-color:#CBEDE0;background:rgba(255, 255, 255, .82);}
.runner-back-symbol{color:#2F8066;}
.runner-eyebrow, .runner-number-divider{color:#35A880;}
.runner-sheet-trigger{border-color:#CBEDE0;background:rgba(255, 255, 255, .86);}
.runner-sheet-trigger-icon{color:#35A880;}
.runner-sheet-trigger-text, .runner-subject{color:#23483C;}
.runner-timer{color:#628277;}
.runner-number-current{color:#47B98D;}
.runner-number-total{color:#76968B;}
.runner-segment{background:#D8EEE6;}
.runner-segment.past, .runner-segment.answered{background:#9ADDC3;}
.runner-segment.current{background:#55C89B;box-shadow:0 0 14rpx rgba(85, 200, 155, .2);}
.runner-segment.correct{background:#4CA678;}
.runner-segment.wrong{background:#D98072;}
.runner-subject-chip{border-color:#BEE8D7;background:#E0F7EE;color:#2F8066;}
.runner-question-area{background:#F3FBF8;}
.runner-q-wrap{padding:28rpx 24rpx 32rpx;background:#FFFFFF;border-color:#D8EEE6;border-radius:0 0 28rpx 28rpx;box-shadow:0 14rpx 34rpx rgba(43, 117, 91, .07);}
.runner-q-card-head{margin-bottom:22rpx;}
.runner-q-badge{padding:7rpx 14rpx;border-radius:999rpx;background:#DDF6EC;color:#2F8066;}
.runner-q-badge-smart{background:#EEF9F5;color:#6A8B80;}
.runner-q-content, .runner-mixed-text-block, .runner-mixed-latex-block{color:#23483C;}
.runner-recommend-bar{border-color:#D8EEE6;background:linear-gradient(105deg, #F7FFFC 0%, #FFFFFF 100%);}
.runner-recommend-divider{background:#7ED8B5;}
.runner-recommend-label{color:#2F8066;}
.runner-recommend-copy-divider{background:#E0F1EB;}
.runner-recommend-text{color:#668279;}
.runner-option-item{padding:20rpx 18rpx;border-color:#D8EEE6;border-width:1rpx;border-radius:18rpx;background:#FFFFFF;}
.runner-option-pressed{background:#F4FCF9;}
.runner-option-item.runner-selected{border-color:#7ED8B5;background:#F0FBF6;box-shadow:inset 5rpx 0 0 #7ED8B5;}
.runner-option-item.runner-correct, .runner-option-item.runner-both{border-color:#75C69F;background:#EFF9F3;box-shadow:inset 5rpx 0 0 #4CA678;}
.runner-option-item.runner-user-answer{border-color:#E3A196;background:#FEF3F0;box-shadow:inset 5rpx 0 0 #D98072;}
.runner-option-indicator{border-color:#A9C8BD;}
.runner-option-indicator.runner-checked{border-color:#55C89B;background:#7ED8B5;}
.runner-option-indicator.runner-indicator-correct{border-color:#4CA678;background:#4CA678;}
.runner-option-indicator.runner-indicator-user{border-color:#D98072;background:#D98072;}
.runner-option-key{color:#348C6F;}
.runner-option-text{color:#34564B;}
.runner-option-item.runner-user-answer .runner-option-key{color:#B66758;}
.runner-option-item.runner-correct .runner-option-key, .runner-option-item.runner-both .runner-option-key{color:#348C6F;}
.runner-bottom-bar{padding:12rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));border-top-color:#D8EEE6;background:rgba(255, 255, 255, .97);box-shadow:0 -10rpx 28rpx rgba(43, 117, 91, .055);}
.runner-bottom-inner{gap:12rpx;}
.runner-nav-btn{min-height:76rpx;border-radius:22rpx;border:1rpx solid #D8EEE6;background:#F2FBF7;}
.runner-nav-label{color:#3D6959;}
.runner-nav-arrow{color:#55B990;}
