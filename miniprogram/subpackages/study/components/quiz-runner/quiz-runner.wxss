.runner-nav-btn.runner-disabled, .runner-btn-submit-disabled{opacity:.38;}
.runner-sheet-modal{border-radius:32rpx 32rpx 0 0;background:#FBFFFD;box-shadow:0 -20rpx 52rpx rgba(43, 117, 91, .14);}
.runner-sheet-title{color:#23483C;}
.runner-sheet-subtitle{color:#78958A;}
.runner-sheet-close{color:#3A6F5B;}
.runner-sheet-cell{border-color:#D8EEE6;background:#FFFFFF;color:#648175;}
.runner-sheet-cell.runner-done{background:#EAF9F4;border-color:#BEE8D7;color:#2F8066;}
.runner-sheet-cell.runner-current{border-color:#55C89B;box-shadow:0 0 0 3rpx rgba(85, 200, 155, .16);}
.runner-sheet-cell.runner-correct-cell{background:#EAF7EF;border-color:#75C69F;color:#348C6F;}
.runner-sheet-cell.runner-wrong-cell{background:#FEF0ED;border-color:#E3A196;color:#B66758;}
.runner-state-card{background:#FFFFFF;}
.runner-state-text{color:#6B887D;}
.runner-state-btn{color:#FFFFFF;background:#3A6F5B;border-radius:999rpx;}
.runner-loading-ring{border-color:rgba(126, 216, 181, .28);border-top-color:#55C89B;}
.runner-master-btn{border-color:#CBEDE0;background:#F1FBF7;}
.runner-master-icon, .runner-master-text{color:#2F8066;}
.runner-mode-wrong-detail .runner-next .runner-nav-arrow{border-color:#3A6F5B;background:#3A6F5B;}
.runner-mode-wrong-detail .runner-next .runner-nav-label{color:#3A6F5B;}
.runner-mode-wrong-detail .runner-q-content, .runner-mode-wrong-detail .runner-mixed-text-block, .runner-mode-wrong-detail .runner-mixed-latex-block, .runner-mode-wrong-detail .runner-fallback-text{color:#23483C;}
.runner-mode-wrong-detail .runner-option-item.runner-selected{background:rgba(126, 216, 181, .09);}
.runner-mode-wrong-detail .runner-option-item.runner-correct, .runner-mode-wrong-detail .runner-option-item.runner-both{background:rgba(76, 166, 120, .08);}
.runner-mode-wrong-detail .runner-option-item.runner-user-answer{background:rgba(217, 128, 114, .08);}
@media (prefers-reduced-motion: reduce) {
  .runner-hero, .runner-q-wrap, .runner-option-item, .runner-nav-btn, .runner-final-submit, .runner-btn-submit{transition:none !important;}
}
