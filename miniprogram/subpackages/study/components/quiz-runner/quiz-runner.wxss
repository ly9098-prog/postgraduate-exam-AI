@import '../../../../styles/tokens.wxss';
@import '../code-block/code-block.wxss';
@import './practice-theme.wxss';
.quiz-runner{display:flex;flex-direction:column;height:100%;min-height:0;overflow:hidden;box-sizing:border-box;}
.runner-hero{position:relative;overflow:hidden;flex-shrink:0;box-sizing:border-box;}
.runner-hero-glow{position:absolute;width:300rpx;height:300rpx;border:1rpx solid rgba(174,239,0,0.14);border-radius:50%;pointer-events:none;}
.runner-hero-grid{position:absolute;top:-28rpx;right:-20rpx;width:300rpx;height:220rpx;transform:rotate(8deg);background-image:linear-gradient(rgba(255,255,255,0.7) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(255,255,255,0.7) 1rpx,transparent 1rpx);background-size:28rpx 28rpx;pointer-events:none;}
.runner-hero-nav, .runner-hero-meta, .runner-number-row, .runner-segment-progress{position:relative;z-index:2;}
.runner-hero-nav{display:flex;align-items:center;justify-content:space-between;gap:18rpx;}
.runner-custom-navigation .runner-hero-nav{padding-right:188rpx;}
.runner-hero-left{display:flex;align-items:center;gap:16rpx;min-width:0;}
.runner-back-btn{border-radius:50%;border:1rpx solid rgba(255,255,255,0.18);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.runner-back-symbol{line-height:1;transform:translateY(-2rpx);font-family:Arial,sans-serif;}
.runner-eyebrow{font-weight:800;white-space:nowrap;}
.runner-sheet-trigger{border:1rpx solid rgba(215,255,104,0.24);display:flex;align-items:center;justify-content:center;gap:8rpx;box-sizing:border-box;flex-shrink:0;}
.runner-sheet-trigger-icon{width:24rpx;height:24rpx;}
.runner-sheet-trigger-text{font-weight:700;}
.runner-control-pressed{opacity:0.72;transform:scale(0.96);}
.runner-hero-meta{display:flex;align-items:center;justify-content:space-between;gap:24rpx;}
.runner-subject{min-width:0;max-width:520rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.25;font-weight:900;letter-spacing:1rpx;}
.runner-timer{flex-shrink:0;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:1rpx;}
.runner-number-row{display:flex;align-items:flex-end;justify-content:space-between;}
.runner-number-wrap{display:flex;align-items:baseline;line-height:1;}
.runner-number-current{font-weight:900;font-variant-numeric:tabular-nums;}
.runner-number-divider{font-weight:300;}
.runner-number-total{font-weight:650;font-variant-numeric:tabular-nums;}
.runner-segment-progress{display:flex;align-items:center;width:100%;}
.runner-segment{flex:1;min-width:5rpx;border-radius:999rpx;transition:background 0.2s ease,transform 0.2s ease;}
.runner-segment.current{transform:scaleY(1.45);}
.runner-segment.current.correct, .runner-segment.current.wrong{transform:scaleY(1.45);}
.runner-question-area{flex:1;min-height:0;overflow-y:auto;padding:0 24rpx 22rpx;box-sizing:border-box;}
.runner-q-wrap{position:relative;z-index:3;margin-top:-1rpx;border:1rpx solid rgba(219,226,219,0.92);border-top:none;box-sizing:border-box;transition:transform 0.15s ease,opacity 0.15s ease;}
.runner-q-wrap.slide-out-left{transform:translateX(-52rpx);opacity:0;}
.runner-q-wrap.slide-out-right{transform:translateX(52rpx);opacity:0;}
.runner-q-wrap.slide-in{animation:runnerSlideIn 0.16s ease;}
@keyframes runnerSlideIn{from{opacity:0;transform:translateY(18rpx);}
to{opacity:1;transform:translateY(0);}
}
.runner-q-card-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;}
.runner-q-labels{display:flex;flex-wrap:wrap;align-items:center;gap:10rpx;min-width:0;}
.runner-q-badge{font-size:21rpx;font-weight:800;line-height:1.3;}
.runner-master-btn{height:54rpx;padding:0 16rpx;border-radius:15rpx;border:1rpx solid #DCE8DD;display:flex;align-items:center;gap:7rpx;flex-shrink:0;}
.runner-master-btn-pressed{transform:scale(0.96);background:#F0F6EE;}
.runner-master-icon{width:24rpx;height:24rpx;}
.runner-master-text{font-size:21rpx;font-weight:750;}
.runner-recommend-label{flex-shrink:0;}
.runner-q-content, .runner-mixed-text-block, .runner-mixed-latex-block{display:block;font-size:31rpx;line-height:1.82;word-break:break-word;white-space:pre-wrap;}
.runner-q-content{margin-bottom:30rpx;}
.runner-mixed-text-block, .runner-mixed-latex-block{margin-bottom:20rpx;}

.runner-mixed-code-block{margin:14rpx 0 28rpx;}

.runner-options, .runner-blank-group-options, .runner-blank-options{display:flex;flex-direction:column;}
.runner-options, .runner-blank-group-options{gap:14rpx;}
.runner-blank-options{gap:24rpx;}
.runner-option-item{position:relative;display:flex;align-items:flex-start;gap:15rpx;border:2rpx solid #E3E8E3;box-sizing:border-box;overflow:hidden;transition:transform 0.14s ease,border-color 0.14s ease,background 0.14s ease;}
.runner-option-pressed{transform:scale(0.988);}
.runner-option-indicator{width:34rpx;height:34rpx;margin-top:4rpx;border-radius:50%;border:2rpx solid #B7C0B9;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-sizing:border-box;}
.runner-check-mark{width:18rpx;height:18rpx;color:#10251A;}
.runner-indicator-correct .runner-check-mark, .runner-indicator-user .runner-check-mark{color:#FFFFFF;}
/* .icon-check/.icon-exclamation are drawn for the 30rpx token box (left 8/top 12),
   which lands the glyph below-right of centre once .runner-check-mark shrinks the
   box to 18rpx. Re-centre both marks against the indicator instead. */
.runner-check-mark.icon-check::before{left:50%;top:50%;width:6rpx;height:11rpx;transform:translate(-50%,-56%) rotate(45deg);}
.runner-check-mark.icon-exclamation::before{left:50%;top:2rpx;width:3rpx;height:10rpx;transform:translateX(-50%);}
.runner-check-mark.icon-exclamation::after{left:50%;top:13rpx;width:3rpx;height:3rpx;transform:translateX(-50%);}
.runner-option-body{flex:1;min-width:0;display:flex;align-items:flex-start;gap:8rpx;}
.runner-option-key{flex-shrink:0;font-size:27rpx;line-height:1.62;font-weight:900;}
.runner-option-text{font-size:27rpx;line-height:1.62;word-break:break-word;white-space:pre-wrap;}
.runner-option-image{max-width:100%;max-height:200rpx;border-radius:10rpx;border:2rpx solid rgba(0,0,0,0.06);background:#FFFFFF;display:block;}
.runner-blank-group{padding:20rpx;border-radius:20rpx;border:1rpx solid #E1E7E1;background:#F8FAF7;box-sizing:border-box;}
.runner-blank-group-head{margin-bottom:14rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;}
.runner-blank-group-title{color:#27432F;font-size:27rpx;font-weight:850;}
.runner-blank-group-hint{color:#7B867E;font-size:21rpx;}
.runner-blank-option-item{background:#FFFFFF;}
.runner-blank-option-item:active{background:#F3F7EE;}
.runner-blank-option-item.runner-selected{border-color:#6EA800;background:#F5FBE8;box-shadow:inset 5rpx 0 0 #AEEF00;}
.runner-bottom-bar{flex-shrink:0;border-top:1rpx solid #E3E8E3;box-sizing:border-box;}
.runner-bottom-inner{display:flex;align-items:center;justify-content:space-between;}
.runner-nav-btn{display:flex;align-items:center;justify-content:center;gap:6rpx;}
.runner-nav-pressed{background:#F2F5F1;}
.runner-nav-arrow{width:30rpx;height:30rpx;}
.runner-btn-submit{width:100%;margin-top:12rpx;padding:19rpx 24rpx;border:none;border-radius:18rpx;display:flex;align-items:center;justify-content:center;gap:14rpx;line-height:1.35;box-sizing:border-box;}
.runner-btn-submit::after{border:none;}
.runner-sheet-overlay{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;justify-content:center;background:rgba(4,13,8,0.64);}
.runner-sheet-modal{width:100%;max-height:76vh;padding:16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));overflow-y:auto;box-sizing:border-box;animation:sheetRise 0.22s ease-out both;}
@keyframes sheetRise{from{transform:translateY(40rpx);opacity:0;}
to{transform:translateY(0);opacity:1;}
}
.runner-sheet-handle{width:72rpx;height:7rpx;margin:0 auto 20rpx;border-radius:999rpx;background:#D8DED8;}
.runner-sheet-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;}
.runner-sheet-title{display:block;font-size:33rpx;font-weight:900;}
.runner-sheet-subtitle{display:block;margin-top:7rpx;font-size:23rpx;}
.runner-sheet-close{width:54rpx;height:54rpx;border-radius:50%;background:#F2F4F1;font-size:36rpx;line-height:50rpx;text-align:center;flex-shrink:0;}
.runner-sheet-close-pressed{transform:scale(0.94);}
.runner-sheet-legend{margin-top:24rpx;padding:15rpx 16rpx;border-radius:15rpx;background:#F5F7F3;display:flex;align-items:center;flex-wrap:wrap;gap:16rpx 22rpx;}
.runner-legend-item{display:flex;align-items:center;gap:7rpx;color:#667169;font-size:20rpx;}
.runner-legend-dot{width:18rpx;height:18rpx;border-radius:5rpx;box-sizing:border-box;}
.runner-legend-dot.current{border:3rpx solid #6EA800;background:#FFFFFF;}
.runner-legend-dot.answered{background:#153323;}
.runner-legend-dot.correct{background:#2AB66F;}
.runner-legend-dot.wrong{background:#F05A51;}
.runner-legend-dot.empty{border:2rpx solid #D3D9D3;background:#FFFFFF;}
.runner-sheet-grid{margin-top:24rpx;display:grid;grid-template-columns:repeat(5,1fr);gap:14rpx;}
.runner-sheet-cell{aspect-ratio:1;border:2rpx solid #E0E6E0;display:flex;align-items:center;justify-content:center;font-size:25rpx;font-weight:800;font-variant-numeric:tabular-nums;box-sizing:border-box;}
.runner-sheet-cell-pressed{transform:scale(0.96);}
.runner-sheet-cell.runner-current{border:4rpx solid #AEEF00;}
.runner-sheet-submit{margin-top:26rpx;}
.quiz-runner.runner-compact{min-height:0;height:auto;overflow:visible;display:block;background:transparent;}
.runner-compact .runner-question-area{min-height:0;overflow:visible;padding:10rpx 24rpx 0;}
.runner-compact .runner-q-wrap{margin-top:0;padding:24rpx;border:1rpx solid #E1E6E1;}
.runner-compact .runner-bottom-bar{position:static;margin:8rpx 24rpx 0;padding:5rpx 0 8rpx;border-top:none;background:transparent;box-shadow:none;}
.runner-compact .runner-btn-submit{display:none;}
.quiz-runner.runner-flow{display:block;min-height:0;height:auto;overflow:visible;background:transparent;}
.runner-flow .runner-question-area{min-height:0;overflow:visible;}
.runner-flow.runner-bottom-compact .runner-question-area{padding-bottom:calc(142rpx + env(safe-area-inset-bottom));}
.runner-flow.runner-bottom-compact .runner-bottom-bar{position:fixed;left:0;right:0;bottom:0;width:100%;margin-top:0;padding-bottom:calc(16rpx + env(safe-area-inset-bottom));box-sizing:border-box;background:#FBFBF7;border-top:1rpx solid #DDE2DA;box-shadow:0 -8rpx 24rpx rgba(16,37,26,.045);}
@media (prefers-reduced-motion: reduce){.runner-q-wrap, .runner-q-wrap.slide-in, .runner-q-wrap.slide-out-left, .runner-q-wrap.slide-out-right, .runner-segment, .runner-option-item, .runner-sheet-modal, .runner-sheet-cell, .runner-btn-submit{animation:none !important;transition:none !important;transform:none !important;}
}
.runner-compact-counter{margin-left:auto;color:#59655D;font-size:22rpx;font-weight:800;font-variant-numeric:tabular-nums;flex-shrink:0;}

.runner-hero-nav{min-height:56rpx;}
.runner-back-btn{width:52rpx;height:52rpx;}
.runner-back-symbol{font-size:43rpx;}
.runner-sheet-trigger{height:52rpx;padding:0 15rpx;}
.runner-sheet-trigger-text{font-size:21rpx;}
.runner-eyebrow{font-size:19rpx;letter-spacing:3rpx;}
.runner-hero-meta{margin-top:13rpx;}
.runner-subject{font-size:32rpx;}
.runner-timer{font-size:22rpx;}
.runner-number-row{margin-top:11rpx;}
.runner-number-current{font-size:60rpx;letter-spacing:-2rpx;}
.runner-number-divider{margin:0 8rpx 0 9rpx;font-size:32rpx;}
.runner-number-total{font-size:28rpx;}
.runner-segment-progress{margin-top:14rpx;gap:5rpx;}
.runner-segment{height:6rpx;}
.runner-question-area{height:0;}
.runner-flow .runner-question-area, .runner-compact .runner-question-area{height:auto;}
.runner-nav-btn{min-width:116rpx;}
.runner-final-submit{flex:1.25;min-width:218rpx;padding:0 10rpx 0 22rpx;justify-content:space-between;}
.runner-final-submit-label{color:#10251A;font-weight:900;white-space:nowrap;}
.runner-final-submit-arrow{width:42rpx;height:42rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif;font-size:31rpx;line-height:1;flex-shrink:0;}
.runner-final-submit-arrow-text{transform:translateY(-2rpx);}
@media (max-width: 360px){.runner-custom-navigation .runner-hero-nav{padding-right:170rpx;}
.runner-final-submit{min-width:190rpx;padding-left:16rpx;}
.runner-final-submit-label{font-size:22rpx;}
.runner-nav-btn{min-width:102rpx;}
}
.runner-theme-premium-review{background:#F4F5F1;color:#17251B;}
.runner-theme-premium-review .runner-hero{background:radial-gradient(circle at 88% 10%,rgba(183,232,42,.11) 0,rgba(183,232,42,0) 34%),linear-gradient(145deg,#183528 0%,#10251A 60%,#09170F 100%);padding-left:26rpx;padding-right:26rpx;}
.runner-theme-premium-review .runner-hero-grid{opacity:.035;}
.runner-theme-premium-review .runner-hero-glow{border-color:rgba(183,232,42,.10);box-shadow:0 0 0 42rpx rgba(183,232,42,.018),0 0 0 88rpx rgba(183,232,42,.012);}
.runner-theme-premium-review .runner-eyebrow, .runner-theme-premium-review .runner-number-divider{color:#B7E82A;}
.runner-theme-premium-review .runner-segment.past, .runner-theme-premium-review .runner-segment.answered{background:rgba(183,232,42,.52);}
.runner-theme-premium-review .runner-segment.current{background:#B7E82A;box-shadow:0 0 16rpx rgba(183,232,42,.25);}
.runner-theme-premium-review .runner-sheet-trigger-icon{color:#B7E82A;}
.runner-theme-premium-review .runner-question-area{background:#F4F5F1;}
.runner-theme-premium-review .runner-q-wrap{padding:30rpx 26rpx 32rpx;border-radius:0 0 32rpx 32rpx;border-color:#DEE4DC;box-shadow:0 16rpx 36rpx rgba(16,37,26,.06);}
.runner-theme-premium-review .runner-q-badge{background:#E6ECDD;color:#285D3D;border-radius:999rpx;padding:7rpx 15rpx;}
.runner-theme-premium-review .runner-q-badge-smart{background:#ECEFE9;color:#617067;}
.runner-theme-premium-review .runner-master-btn{border-color:#D5DDCF;background:#F0F3EC;border-radius:999rpx;padding-left:18rpx;padding-right:18rpx;}
.runner-theme-premium-review .runner-master-icon, .runner-theme-premium-review .runner-master-text{color:#285D3D;}
.runner-theme-premium-review .runner-master-btn-pressed{background:#E6EBDD;}
.runner-theme-premium-review .runner-recommend-bar{border-left-color:#B7E82A;}
.runner-theme-premium-review .runner-q-content, .runner-theme-premium-review .runner-mixed-text-block, .runner-theme-premium-review .runner-mixed-latex-block{color:#202E24;line-height:1.78;}
.runner-theme-premium-review .runner-code-wrapper{background:#15221A;border-color:rgba(183,232,42,.10);}
.runner-theme-premium-review .runner-code-no{color:#B7E82A;}
.runner-theme-premium-review .runner-option-item{border-color:#E0E5DD;border-width:1rpx;border-radius:20rpx;padding:22rpx 20rpx;background:#FEFEFB;box-shadow:none;}
.runner-theme-premium-review .runner-option-pressed{background:#F3F5F0;}
.runner-theme-premium-review .runner-option-item.runner-selected{border-color:#86AA18;background:#F3F8E6;box-shadow:inset 5rpx 0 0 #B7E82A;}
.runner-theme-premium-review .runner-option-item.runner-correct, .runner-theme-premium-review .runner-option-item.runner-both{border-color:#3C9D68;background:#E9F4EC;box-shadow:inset 5rpx 0 0 #2F8B59;}
.runner-theme-premium-review .runner-option-item.runner-user-answer{border-color:#C96B58;background:#F8E9E5;box-shadow:inset 5rpx 0 0 #C45D48;}
.runner-theme-premium-review .runner-option-indicator{border-color:#B5BEB6;}
.runner-theme-premium-review .runner-option-indicator.runner-checked{border-color:#8EB21D;background:#B7E82A;}
.runner-theme-premium-review .runner-option-indicator.runner-indicator-correct{border-color:#2F8B59;background:#2F8B59;}
.runner-theme-premium-review .runner-option-indicator.runner-indicator-user{border-color:#C45D48;background:#C45D48;}
.runner-theme-premium-review .runner-option-key{color:#5D7E13;}
.runner-theme-premium-review .runner-option-text{color:#2B382F;}
.runner-theme-premium-review .runner-option-item.runner-user-answer .runner-option-key{color:#B24F3B;}
.runner-theme-premium-review .runner-option-item.runner-correct .runner-option-key, .runner-theme-premium-review .runner-option-item.runner-both .runner-option-key{color:#25754A;}
.runner-theme-premium-review .runner-blank-group{border-color:#DDE3DA;background:#F2F4EF;}
.runner-theme-premium-review .runner-blank-option-item:active{background:#EDF2E0;}
.runner-theme-premium-review .runner-blank-option-item.runner-selected{border-color:#86AA18;background:#EDF4D9;box-shadow:inset 5rpx 0 0 #B7E82A;}
.runner-theme-premium-review .runner-bottom-bar{border-top-color:#DDE2DA;background:#FBFBF7;box-shadow:0 -10rpx 30rpx rgba(16,37,26,.045);}
.runner-theme-premium-review .runner-final-submit, .runner-theme-premium-review .runner-btn-submit{background:#B7E82A;box-shadow:0 10rpx 24rpx rgba(105,139,5,.15);}
.runner-theme-premium-review .runner-final-submit-arrow{background:#10251A;}
.runner-theme-premium-review .runner-sheet-cell.runner-current{border-color:#B7E82A;box-shadow:0 0 0 3rpx rgba(183,232,42,.16);}
.runner-theme-premium-review.runner-compact .runner-question-area{padding:16rpx 24rpx 0;}
.runner-theme-premium-review.runner-compact .runner-q-wrap{padding:26rpx;border-radius:28rpx;border-color:#DEE3DC;background:#FBFBF7;box-shadow:0 14rpx 34rpx rgba(16,37,26,.06);}
.runner-theme-premium-review.runner-compact .runner-bottom-bar{margin-top:12rpx;}
@media (prefers-reduced-motion: reduce){.runner-theme-premium-review .runner-q-wrap, .runner-theme-premium-review .runner-option-item, .runner-theme-premium-review .runner-master-btn{transition:none !important;}
}
.runner-sheet-trigger{min-width:112rpx;border-radius:22rpx;}
.runner-sheet-trigger-text{font-variant-numeric:tabular-nums;}
.runner-bottom-inner > .runner-nav-btn{flex:1;min-width:0;min-height:86rpx;border-radius:26rpx;border:1rpx solid #DDE2DA;background:#F1F3ED;}
.runner-bottom-inner > .runner-next{color:#10251A;border-color:#B7E82A;background:linear-gradient(100deg,#B7E82A 0%,#D1F55B 100%);box-shadow:0 12rpx 26rpx rgba(127,163,0,.17);}
.runner-bottom-inner > .runner-final-submit{flex:1;min-width:0;min-height:86rpx;padding:0 18rpx 0 26rpx;border:0;border-radius:26rpx;background:linear-gradient(100deg,#B7E82A 0%,#D1F55B 100%);box-shadow:0 12rpx 26rpx rgba(127,163,0,.17);}
.runner-nav-label{font-size:27rpx;font-weight:900;}
.runner-prev .runner-nav-label, .runner-prev .runner-nav-arrow{color:#39483E;}
.runner-next .runner-nav-label, .runner-next .runner-nav-arrow{color:#10251A;}
.runner-final-submit-label{font-size:27rpx;}
.runner-sheet-cell{border-radius:18rpx;}
.runner-theme-premium-review .runner-bottom-inner > .runner-nav-btn{border-color:#DDE2DA;}
.runner-theme-premium-review .runner-bottom-inner > .runner-next, .runner-theme-premium-review .runner-bottom-inner > .runner-final-submit{background:linear-gradient(100deg,#B7E82A 0%,#D1F55B 100%);border-color:#B7E82A;}
.runner-custom-navigation .runner-hero-nav{padding-top:12rpx;}
.runner-question-area{padding-bottom:0;}
.runner-scroll-top-anchor{width:1rpx;height:1rpx;opacity:0;pointer-events:none;}
.runner-q-wrap{min-height:100%;padding-bottom:40rpx;border-bottom-left-radius:0;border-bottom-right-radius:0;}
.runner-bottom-bar{position:relative;z-index:8;}
.runner-flow .runner-question-area, .runner-compact .runner-question-area{padding-bottom:22rpx;background:transparent;}
.runner-flow .runner-q-wrap, .runner-compact .runner-q-wrap{min-height:0;border-radius:34rpx;box-shadow:0 10rpx 28rpx rgba(16,37,26,0.055);}
.runner-mode-wrong-detail{background:#FFFEFB;border-bottom:1rpx solid #E2E1DA;}
.runner-mode-wrong-detail.runner-compact .runner-question-area{padding:0 30rpx;background:#FFFEFB;}
.runner-mode-wrong-detail.runner-compact .runner-q-wrap, .runner-mode-wrong-detail.runner-flow .runner-q-wrap{min-height:0;margin:0;padding:24rpx 0 12rpx;border:0;border-radius:0;background:transparent;box-shadow:none;font-weight:400;}
.runner-mode-wrong-detail .runner-q-card-head{min-height:28rpx;margin-bottom:24rpx;align-items:center;}
.runner-mode-wrong-detail .runner-q-labels{gap:14rpx;}
.runner-mode-wrong-detail .runner-q-badge{position:relative;padding:0 0 0 18rpx;border-radius:0;background:transparent;color:#69736C;font-size:19rpx;line-height:1.2;font-weight:700;letter-spacing:1rpx;}
.runner-mode-wrong-detail .runner-q-badge::before{content:'';position:absolute;left:0;top:50%;width:9rpx;height:2rpx;border-radius:999rpx;background:#1A4A36;transform:translateY(-50%);}
.runner-mode-wrong-detail .runner-q-badge-smart{padding-left:0;color:#8A918B;font-weight:600;}
.runner-mode-wrong-detail .runner-q-badge-smart::before, .runner-mode-wrong-detail .runner-compact-counter{display:none;}
.runner-mode-wrong-detail .runner-recommend-bar{border-left:3rpx solid #C4D3CA;}
.runner-mode-wrong-detail .runner-q-content, .runner-mode-wrong-detail .runner-mixed-text-block, .runner-mode-wrong-detail .runner-mixed-latex-block, .runner-mode-wrong-detail .runner-fallback-text{font-size:30rpx;line-height:1.78;font-weight:400;}
