.runner-question-images{margin:24rpx 0 8rpx;display:flex;flex-direction:column;width:100%;gap:16rpx;}
.runner-question-image{max-width:100%;width:100%;border-radius:16rpx;border:2rpx solid rgba(0,0,0,0.06);background:#FFFFFF;}
.runner-state-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24rpx;padding:80rpx 48rpx;min-height:320rpx;}
.runner-state-icon{font-size:52rpx;line-height:1;opacity:0.7;}
.runner-state-text{font-size:28rpx;text-align:center;line-height:1.6;}
.runner-state-btn{margin:0;padding:14rpx 48rpx;font-size:26rpx;border:none;line-height:1.4;}
