.loading-lottie{display: flex;flex-direction: column;align-items: center;justify-content: center;gap: 18rpx;width: 100%;box-sizing: border-box;}.loading-lottie-canvas-wrap{position: relative;overflow: hidden;}.loading-lottie-canvas{display: block;width: 100%;height: 100%;}.loading-lottie-small .loading-lottie-canvas-wrap{width: 96rpx;height: 72rpx;}.loading-lottie-medium .loading-lottie-canvas-wrap{width: 180rpx;height: 136rpx;}.loading-lottie-large .loading-lottie-canvas-wrap{width: 240rpx;height: 180rpx;}.loading-lottie-fallback{width: 56rpx;height: 56rpx;border: 6rpx solid rgba(59,130,246,0.16);border-top-color: #3b82f6;border-radius: 50%;animation: loading-lottie-spin 0.8s linear infinite;box-sizing: border-box;}.loading-lottie-small .loading-lottie-fallback{width: 40rpx;height: 40rpx;border-width: 5rpx;}.loading-lottie-large .loading-lottie-fallback{width: 68rpx;height: 68rpx;border-width: 7rpx;}.loading-lottie-text{color: #64748b;font-size: 26rpx;line-height: 1.5;text-align: center;}.loading-lottie-dark .loading-lottie-text{color: rgba(255,255,255,0.78);}.loading-lottie-dark .loading-lottie-fallback{border-color: rgba(255,255,255,0.18);border-top-color: rgba(255,255,255,0.92);}@keyframes loading-lottie-spin{from{transform: rotate(0deg);}to{transform: rotate(360deg);}}.loading-lottie-brand{margin-top: 22rpx;margin-bottom: 4rpx;}.loading-lottie-brand .loading-lottie-fallback{width: 76rpx;height: 76rpx;border-width: 7rpx;border-color: rgba(23,52,38,.12);border-top-color: #B7E82A;border-right-color: #58D6C6;background: rgba(255,255,255,.72);box-shadow: 0 0 0 12rpx rgba(183,232,42,.08),0 14rpx 30rpx rgba(16,37,26,.14);animation-duration: .9s;}.loading-lottie-brand .loading-lottie-text{color:#526158;}
