.seg-text {
  display: inline;
  font-size: 28rpx;
  color: #2D3E50;
  line-height: 1.8;
}
.seg-math-inline-wrap {
  display: inline-block;
  vertical-align: middle;
}
.seg-math-inline {
  height: 44rpx;
  max-width: 400rpx;
  margin: 0 4rpx;
}
.seg-math-display-wrap {
  display: block;
  text-align: center;
  margin: 16rpx 0;
}
.seg-math-display {
  max-width: 100%;
}
.seg-math-fallback {
  color: #C47A7A;
  font-size: 24rpx;
}
.seg-math-fallback-inline {
  display: inline;
}
.seg-newline {
  display: block;
  height: 16rpx;
}
.seg-image-wrap {
  display: block;
  margin: 16rpx 0;
  text-align: center;
}
.seg-visual-image {
  max-width: 100%;
  border-radius: 8rpx;
}
.seg-image-error {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  border-radius: 8rpx;
  border: 2rpx dashed #ddd;
  background: #fafafa;
  padding: 20rpx;
}
.seg-image-error-text {
  color: #999;
  font-size: 24rpx;
}
.seg-unknown {
  display: none;
}

/* Canonical table.v2 rendering */
.seg-table-wrap {
  display: block;
  margin: 20rpx 0;
  overflow: hidden;
  border: 2rpx solid #dfe6ec;
  border-radius: 14rpx;
  background: #ffffff;
}
.seg-table-review {
  border-color: #e8bd78;
}
.seg-table-caption {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-bottom: 2rpx solid #e7edf2;
  background: #f6f8fa;
}
.seg-table-title {
  color: #26394b;
  font-size: 24rpx;
  font-weight: 600;
}
.seg-table-review-badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1d6;
  color: #9a641d;
  font-size: 20rpx;
  font-weight: 600;
}
.seg-table-scroll {
  width: 100%;
  background: #ffffff;
}
.seg-table-grid {
  display: grid;
  background: #dfe6ec;
  gap: 2rpx;
}
.seg-table-cell {
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 14rpx 16rpx;
  overflow-wrap: anywhere;
  background: #ffffff;
  color: #2d3e50;
  font-size: 24rpx;
  line-height: 1.65;
}
.seg-table-cell-header {
  background: #eef4f8;
  color: #24384a;
  font-weight: 600;
}
.seg-table-cell-text {
  white-space: pre-wrap;
}
.seg-table-cell-newline {
  height: 8rpx;
}
.seg-table-cell-image {
  display: block;
  max-width: 100%;
  margin: 6rpx auto;
  border-radius: 6rpx;
}
.seg-table-cell-image-fallback {
  display: block;
  padding: 8rpx;
  border-radius: 6rpx;
  background: #fff8e9;
  color: #8d5c1e;
  font-size: 22rpx;
  white-space: pre-wrap;
}
.seg-table-cell-rich {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
}
.seg-table-warning {
  padding: 10rpx 16rpx;
  border-top: 2rpx solid #f1d4a8;
  background: #fff8e9;
  color: #8d5c1e;
  font-size: 20rpx;
}
.seg-table-source {
  padding: 14rpx 16rpx 16rpx;
  border-top: 2rpx solid #e7edf2;
  background: #fafbfc;
}
.seg-table-source-label {
  display: block;
  margin-bottom: 10rpx;
  color: #7c8c99;
  font-size: 20rpx;
}
.seg-table-source-image {
  display: block;
  max-width: 100%;
  border-radius: 8rpx;
}
