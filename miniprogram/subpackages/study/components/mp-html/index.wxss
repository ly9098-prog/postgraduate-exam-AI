._root{padding: 1px 0;overflow-x: auto;overflow-y: hidden;-webkit-overflow-scrolling: touch;}._select{-webkit-user-select: text;user-select: text;}._pre{display: block;overflow-x: auto;font-family: 'Courier New',Consolas,monospace;font-size: 26rpx;line-height: 1.6;white-space: pre;-webkit-overflow-scrolling: touch;margin: 16rpx 0;padding: 16rpx 24rpx;background: #f5f5f5;border-radius: 8rpx;}._code{font-family: 'Courier New',Consolas,monospace;font-size: 0.92em;}
