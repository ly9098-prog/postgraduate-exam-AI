<view class="sc-overlay sc-theme-{{theme}} {{visible ? 'sc-visible' : ''}}" catchtap="onCancel" catchtouchmove="noop">
<view class="sc-card scenario-{{scenario}} sc-layout-{{layout}}" catchtap="noop">
<view class="sc-top-accent" wx:if="{{layout !== 'minimal'}}"></view>
<view class="sc-icon-circle" wx:if="{{layout !== 'minimal'}}">
<text class="sc-icon-line line-icon {{scenario === 'all-done' ? 'icon-check' : 'icon-exclamation'}}"></text>
</view>
<text class="sc-eyebrow" wx:if="{{!hideEyebrow && layout !== 'minimal'}}">{{eyebrow || (scenario === 'unanswered' ? 'UNFINISHED' : scenario === 'danger' ? 'IRREVERSIBLE' : scenario === 'info' ? 'NOTICE' : 'SUBMIT PAPER')}}</text>
<text class="sc-title">{{title}}</text>
<text class="sc-msg">{{message}}</text>
<view class="sc-actions">
<button class="sc-btn sc-btn-cancel" wx:if="{{!hideCancel}}" hover-class="sc-btn-cancel-pressed" bindtap="onCancel">{{cancelText}}</button>
<button class="sc-btn sc-btn-confirm" hover-class="sc-btn-confirm-pressed" bindtap="onConfirm">
<text>{{confirmText}}</text>
<view class="sc-confirm-arrow" wx:if="{{layout !== 'minimal'}}"><text class="sc-confirm-arrow-text">›</text></view>
</button>
</view>
</view>
</view>
