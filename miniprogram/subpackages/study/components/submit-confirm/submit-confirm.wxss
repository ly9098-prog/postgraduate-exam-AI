.sc-overlay{position:fixed;inset:0;z-index:160;display:flex;align-items:center;justify-content:center;padding:32rpx;background:rgba(4,13,8,0.68);backdrop-filter:blur(14rpx);-webkit-backdrop-filter:blur(14rpx);opacity:0;pointer-events:none;box-sizing:border-box;transition:opacity 0.22s ease}
.sc-overlay.sc-visible{opacity:1;pointer-events:auto}
.sc-card{position:relative;width:100%;max-width:590rpx;padding:48rpx 34rpx 32rpx;border-radius:36rpx;border:1rpx solid rgba(255,255,255,0.76);background:#FFFFFF;box-shadow:0 30rpx 90rpx rgba(0,0,0,0.28);overflow:hidden;display:flex;flex-direction:column;align-items:center;box-sizing:border-box;transform:translateY(42rpx) scale(0.96);opacity:0;transition:transform 0.26s cubic-bezier(0.22,1,0.36,1),opacity 0.22s ease}
.sc-visible .sc-card{transform:translateY(0) scale(1);opacity:1}
.sc-top-accent{position:absolute;top:0;left:0;right:0;height:8rpx;background:linear-gradient(90deg,#173524 0%,#AEEF00 72%,#D7FF68 100%)}
.sc-card.scenario-unanswered .sc-top-accent{background:linear-gradient(90deg,#173524 0%,#D28A1C 70%,#F0B84B 100%)}
.sc-icon-circle{width:82rpx;height:82rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#173524;box-shadow:0 0 0 12rpx rgba(174,239,0,0.10),0 12rpx 28rpx rgba(16,37,26,0.18)}
.scenario-unanswered .sc-icon-circle{background:#6B4714;box-shadow:0 0 0 12rpx rgba(210,138,28,0.12),0 12rpx 28rpx rgba(107,71,20,0.18)}
.sc-icon-line{width:34rpx;height:34rpx;color:#AEEF00}
.scenario-unanswered .sc-icon-line{color:#FFD27B}
.sc-eyebrow{margin-top:28rpx;color:#6F990E;font-size:18rpx;font-weight:850;letter-spacing:3rpx}
.scenario-unanswered .sc-eyebrow{color:#A36A13}
.sc-title{margin-top:9rpx;color:#17251B;font-size:34rpx;line-height:1.35;font-weight:900;text-align:center}
.sc-msg{margin-top:12rpx;color:#68746C;font-size:25rpx;line-height:1.65;text-align:center;white-space:pre-line}
.sc-actions{width:100%;margin-top:34rpx;display:flex;gap:14rpx}
.sc-btn{height:86rpx;border-radius:18rpx;border:none;padding:0 20rpx;display:flex;align-items:center;justify-content:center;font-size:26rpx;line-height:1;font-weight:850;box-sizing:border-box}
.sc-btn::after{border:none}
.sc-btn-cancel{flex:0.82;color:#4E5D53;background:#F5F7F3;border:1rpx solid #DDE4DD}
.sc-btn-confirm{position:relative;flex:1.18;justify-content:center;padding-left:58rpx;padding-right:58rpx;color:#10251A;background:linear-gradient(100deg,#AEEF00 0%,#C8F72B 100%);box-shadow:0 12rpx 26rpx rgba(123,174,0,0.18)}
.scenario-unanswered .sc-btn-confirm{color:#FFFFFF;background:linear-gradient(110deg,#173524 0%,#0E2218 100%);box-shadow:0 12rpx 26rpx rgba(16,37,26,0.18)}
.sc-confirm-arrow{position:absolute;right:15rpx;top:50%;transform:translateY(-50%);width:40rpx;height:40rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#10251A;color:#FFFFFF;font-family:Arial,sans-serif;font-size:29rpx;flex-shrink:0}
.scenario-unanswered .sc-confirm-arrow{background:#AEEF00;color:#10251A}
.sc-confirm-arrow-text{transform:translateY(-2rpx)}
.sc-btn-cancel-pressed{background:#EBF0E9;transform:scale(0.985)}
.sc-btn-confirm-pressed{opacity:0.86;transform:scale(0.985)}
@media (prefers-reduced-motion:reduce){.sc-overlay,.sc-card{transition:none !important}
.sc-card{transform:none}
}
.sc-card.scenario-danger .sc-top-accent{background:linear-gradient(90deg,#7E2F28 0%,#D9685B 72%,#F0A092 100%)}
.scenario-danger .sc-icon-circle{background:#6D2B25;box-shadow:0 0 0 12rpx rgba(217,104,91,.12),0 12rpx 28rpx rgba(109,43,37,.18)}
.scenario-danger .sc-icon-line{color:#FFD3CC}
.scenario-danger .sc-eyebrow{color:#B24F43}
.scenario-danger .sc-btn-confirm{color:#FFFFFF;background:#C95D52;box-shadow:0 12rpx 26rpx rgba(201,93,82,.20)}
.scenario-danger .sc-confirm-arrow{background:rgba(255,255,255,.2);color:#FFFFFF}
.sc-card.scenario-info .sc-top-accent{background:linear-gradient(90deg,#173524 0%,#6F8B55 72%,#B7E82A 100%)}
.scenario-info .sc-icon-circle{background:#173524}
.scenario-info .sc-icon-line{color:#B7E82A}
.scenario-info .sc-btn-confirm{flex:1;justify-content:center;gap:14rpx}
.sc-actions .sc-btn-confirm:only-child{flex:1;justify-content:center}
/* Practice-only confirmation palette. Scenario warning/danger semantics remain. */ .sc-theme-mint{background:rgba(35,72,60,.42)}
.sc-theme-mint .sc-card .sc-top-accent{background:linear-gradient(90deg,#3A6F5B,#7ED8B5)}
.sc-theme-mint .sc-icon-circle{background:#EAF9F4;box-shadow:0 0 0 12rpx rgba(126,216,181,.12)}
.sc-theme-mint .sc-icon-line{color:#3A6F5B}
.sc-theme-mint .sc-title{color:#23483C}
.sc-theme-mint .sc-msg,.sc-theme-mint .sc-eyebrow{color:#507568}
.sc-theme-mint .sc-btn-cancel{background:#EAF9F4;color:#3A6F5B;border-color:#D8EEE6}
.sc-theme-mint .sc-btn-confirm{color:#FFFFFF;background:#3A6F5B;box-shadow:0 10rpx 24rpx rgba(58,111,91,.15)}
.sc-theme-mint .sc-confirm-arrow{background:#7ED8B5;color:#23483C}
.sc-theme-mint .scenario-unanswered .sc-top-accent{background:linear-gradient(90deg,#3A6F5B,#D28A1C)}
.sc-theme-mint .scenario-danger .sc-btn-confirm{background:#C95D52}
.sc-theme-mint .scenario-danger .sc-top-accent{background:linear-gradient(90deg,#7E2F28,#D9685B)}
/* Component-scoped icon primitive: component styles do not inherit page WXSS. */ .sc-icon-line{position:relative;display:block;width:30rpx;height:30rpx;color:currentColor}
.sc-icon-line::before,.sc-icon-line::after{content:'';position:absolute;box-sizing:border-box}
.sc-icon-line.icon-exclamation::before{left:12rpx;top:5rpx;width:5rpx;height:12rpx;border-radius:4rpx;background:currentColor}
.sc-icon-line.icon-exclamation::after{left:12rpx;top:20rpx;width:5rpx;height:5rpx;border-radius:50%;background:currentColor}
.sc-icon-line.icon-check::before{left:8rpx;top:12rpx;width:7rpx;height:12rpx;border-right:3rpx solid currentColor;border-bottom:3rpx solid currentColor;transform:rotate(45deg);border-radius:2rpx}
.sc-theme-mint .scenario-info .sc-icon-line{color:#3A6F5B}
/* Exit is a quiet choice, not a danger-themed submission prompt. */ .sc-theme-mint .sc-card.sc-layout-minimal{width:100%;max-width:620rpx;padding:42rpx 36rpx 32rpx;border-radius:28rpx;background:#FFFFFF;border:0;box-shadow:0 20rpx 60rpx rgba(35,72,60,.16);align-items:stretch;text-align:left}
.sc-layout-minimal .sc-title{width:100%;margin:0;text-align:left;font-size:36rpx;font-weight:700;line-height:1.35}
.sc-layout-minimal .sc-msg{width:100%;margin-top:16rpx;text-align:left;font-size:27rpx;line-height:1.65}
.sc-layout-minimal .sc-actions{margin-top:32rpx;gap:16rpx}
.sc-layout-minimal .sc-btn{flex:1;min-width:0;height:88rpx;border-radius:18rpx;justify-content:center;font-size:28rpx}
.sc-theme-mint .sc-layout-minimal .sc-btn-confirm{background:#3A6F5B;color:#FFFFFF;box-shadow:none}
.sc-theme-mint .sc-layout-minimal .sc-btn-cancel{background:#EAF9F4;border:0;color:#3A6F5B}
