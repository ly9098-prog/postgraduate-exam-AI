x;border-radius: 12rpx;background: #EFF6EC;}.relation-chip-icon{width: 22rpx;height: 22rpx;opacity: .74;}.relation-chip-name{display: block;max-width: 318rpx;overflow: hidden;color: #3F5F49;font-size: 20rpx;font-weight: 600;line-height: 1.3;text-overflow: ellipsis;white-space: nowrap;}.chip-arrow{flex-shrink: 0;margin-left: 7rpx;color: #91A391;font-size: 24rpx;line-height: 1;transform: translateY(-1rpx);}.relation-chip-pressed{transform: translateY(1rpx) scale(.978);border-color: #C6D9C0;background: #EEF6EA;box-shadow: 0 2rpx 7rpx rgba(59,94,65,.045);}.relation-chip-loading{border-color: #BBD3B5;background: #EFF7EC;opacity: .86;}.chip-spinner{width: 20rpx;height: 20rpx;flex-shrink: 0;margin-left: 8rpx;border: 3rpx solid #D2E4CD;border-top-color: #4E8662;border-radius: 50%;animation: relation-spin .72s linear infinite;}.relation-empty{display: flex;align-items: center;gap: 12rpx;margin-top: 18rpx;padding: 16rpx 17rpx;border-radius: 16rpx;background: #F5F8F2;color: #839083;font-size: 19rpx;line-height: 1.45;}.relation-empty-mark{width: 12rpx;height: 12rpx;flex-shrink: 0;border-radius: 50%;background: #A5BE9D;}.practice-entry{position: relative;z-index: 2;display: flex;box-sizing: border-box;width: calc(100% - 56rpx);min-height: 102rpx;align-items: center;gap: 14rpx;margin: 30rpx auto 0;padding: 14rpx 14rpx 14rpx 21rpx;overflow: hidden;border: 1rpx solid rgba(255,255,255,.13);border-radius: 31rpx;background: linear-gradient(100deg,#2F7753 0%,#3C855E 56%,#4C956B 100%);color: #F7FBF5;text-align: left;box-shadow: 0 13rpx 28rpx rgba(42,96,67,.16),inset 0 1rpx 0 rgba(255,255,255,.12);-webkit-tap-highlight-color: rgba(0,0,0,0);transition: transform 150ms ease-out,opacity 160ms ease-out,box-shadow 180ms ease-out;}.practice-target{display: flex;width: 54rpx;height: 54rpx;flex-shrink: 0;align-items: center;justify-content: center;}.practice-target-icon{width: 50rpx;height: 50rpx;}.practice-copy{flex: 1;min-width: 0;}.practice-title{display: block;color: #FFFFFF;font-size: 27rpx