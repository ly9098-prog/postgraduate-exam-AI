page {
  min-height: 100vh;
  background: #F3F8F2;
  color: #13251A;
}

.plan-page {
  min-height: 100vh;
  background:
    radial-gradient(circle at 92% 2%, rgba(126, 228, 137, .10), transparent 360rpx),
    radial-gradient(circle at 5% 40%, rgba(196, 239, 199, .11), transparent 420rpx),
    linear-gradient(180deg, #F8FBF7 0%, #F2F7F1 54%, #EFF5EE 100%);
}

.plan-shell {
  box-sizing: border-box;
  width: 100%;
  padding: 14rpx 38rpx calc(150rpx + env(safe-area-inset-bottom));
}

.plan-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
  padding: 24rpx 2rpx 42rpx;
}

.plan-hero-copy { flex: 1; min-width: 0; }
.plan-hero-kicker,
.settings-kicker,
.section-kicker {
  display: block;
  color: #6F8375;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: 3.4rpx;
}
.plan-hero-title {
  display: block;
  max-width: 570rpx;
  margin-top: 18rpx;
  color: #123A2D;
  font-size: 56rpx;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: -1.2rpx;
}
.plan-hero-subtitle {
  display: block;
  max-width: 590rpx;
  margin-top: 18rpx;
  color: #7F9086;
  font-size: 23rpx;
  line-height: 1.68;
}
.plan-hero-stepper {
  position: relative;
  width: 64rpx;
  flex: 0 0 64rpx;
  margin-top: 22rpx;
  padding: 14rpx 2rpx 0 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  color: #4F9A5B;
}
.plan-hero-stepper::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: -12rpx;
  width: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(67, 215, 93, .58), rgba(67, 215, 93, .12));
}
.plan-hero-step-current,
.plan-hero-step-total,
.plan-hero-step-divider {
  position: relative;
  z-index: 1;
  display: block;
}
.plan-hero-step-current,
.plan-hero-step-total { font-size: 22rpx; font-weight: 800; }
.plan-hero-step-divider { margin: 2rpx 0; color: rgba(75,116,83,.48); font-size: 18rpx; }

.state-card,
.settings-card,
.strategy-card,
.plan-overview-card,
.explain-card {
  box-sizing: border-box;
  border: 1rpx solid rgba(205, 226, 207, .88);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .90);
  box-shadow: 0 16rpx 42rpx rgba(48, 91, 57, .06);
}
.state-card { padding: 46rpx 28rpx; color: #6E7A71; font-size: 24rpx; text-align: center; }
.error-card { color: #9D4234; }

/* Overview keeps the same home-card visual language. */
.plan-overview-card {
  position: relative;
  overflow: hidden;
  margin-bottom: 26rpx;
  padding: 28rpx 30rpx 0;
  color: #13251A;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FFF7 100%);
}
.plan-overview-bg-art {
  position: absolute;
  z-index: 0;
  right: -1rpx;
  top: 0;
  width: auto;
  height: 100%;
  border-radius: inherit;
  pointer-events: none;
}
.plan-overview-bg-wash {
  position: absolute;
  z-index: 1;
  inset: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(255,255,255,.995) 0%, rgba(255,255,255,.985) 38%, rgba(255,255,255,.90) 54%, rgba(255,255,255,.38) 70%, rgba(255,255,255,.04) 88%, rgba(255,255,255,0) 100%);
  pointer-events: none;
}
.plan-overview-visual {
  position: absolute;
  z-index: 2;
  right: -8rpx;
  top: 62rpx;
  width: 310rpx;
  height: 190rpx;
  pointer-events: none;
}
.plan-overview-curve { position: absolute; right: 0; top: 70rpx; width: 300rpx; height: 126rpx; }
.overview-grid { display: none; }
.overview-topline,
.overview-progress-row,
.overview-progress-foot,
.overview-metrics {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.overview-brand { display: flex; align-items: center; gap: 10rpx; color: #26372B; font-size: 17rpx; font-weight: 900; letter-spacing: 1.55rpx; }
.overview-brand-icon { display: block; width: 34rpx; height: 34rpx; flex: 0 0 34rpx; }
.overview-target-chip {
  min-width: 120rpx;
  padding: 10rpx 18rpx;
  border: 2rpx solid #3C8E4C;
  border-radius: 999rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  color: #173C22;
  background: rgba(255,255,255,.66);
  font-size: 17rpx;
  font-weight: 750;
}
.overview-title { position: relative; z-index: 3; display: block; max-width: 390rpx; margin-top: 30rpx; color: #0F1711; font-size: 52rpx; line-height: 1.12; font-weight: 950; letter-spacing: -1.4rpx; }
.overview-desc { position: relative; z-index: 3; display: block; max-width: 400rpx; margin-top: 12rpx; color: #667366; font-size: 22rpx; line-height: 1.55; }
.overview-progress-row { margin-top: 34rpx; color: #223325; font-size: 23rpx; font-weight: 750; }
.overview-progress-track { position: relative; z-index: 3; height: 14rpx; margin-top: 10rpx; overflow: hidden; border-radius: 999rpx; background: rgba(220,229,220,.88); }
.overview-progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#4BDC62 0%,#92F06E 100%); box-shadow: 0 0 16rpx rgba(104,221,106,.22); }
.overview-progress-foot { margin-top: 12rpx; color: #687668; font-size: 18rpx; line-height: 1.5; }
.overview-progress-foot text:last-child { color: #38B74E; font-weight: 900; }
.overview-metrics { margin: 24rpx -30rpx 0; padding: 22rpx 30rpx 28rpx; align-items: stretch; border-top: 1rpx solid rgba(184,215,186,.56); background: rgba(255,255,255,.18); }
.overview-metric { flex: 1; min-width: 0; }
.overview-metric-value,
.overview-metric-label { display: block; }
.overview-metric-value { color: #101813; font-size: 34rpx; line-height: 1.1; font-weight: 950; }
.overview-metric-label { margin-top: 10rpx; color: #718073; font-size: 18rpx; line-height: 1.4; }
.overview-divider { width: 1rpx; background: rgba(184,215,186,.72); }

/* Settings are intentionally normal-flow blocks. This avoids native picker/flex overlap. */
.settings-card { padding: 30rpx 28rpx 20rpx; overflow: visible; }
.settings-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; padding: 0 4rpx 18rpx; }
.settings-title,
.section-title { display: block; margin-top: 8rpx; color: #173B2D; font-size: 34rpx; line-height: 1.2; font-weight: 950; }
.settings-title { position: relative; display: inline-block; padding-right: 22rpx; }
.settings-title::after { content: ''; position: absolute; left: calc(100% + 12rpx); top: 50%; width: 250rpx; height: 1rpx; transform: translateY(-50%); background: linear-gradient(90deg,#CDE2CF,rgba(205,226,207,0)); }
.settings-list { position: relative; width: 100%; padding: 0; }
.settings-list::before { content: ''; position: absolute; left: 22rpx; top: 46rpx; bottom: 46rpx; width: 1rpx; background: #D5E8D7; }
.setting-picker { display: block; width: 100%; }
.setting-row {
  position: relative;
  width: 100%;
  min-height: 112rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid rgba(222,230,223,.72);
}
.setting-row-last { border-bottom: 0; }
.setting-row-pressed { opacity: .76; transform: translateX(2rpx); }
.setting-index { position: relative; z-index: 1; width: 44rpx; height: 44rpx; flex: 0 0 44rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #EAF8EA; color: #2B6B39; font-size: 17rpx; font-weight: 800; }
.setting-icon { position: relative; width: 72rpx; height: 72rpx; flex: 0 0 72rpx; border: 1rpx solid #C8E2CB; border-radius: 50%; background: linear-gradient(145deg,#F1FAF1 0%,#E3F3E5 100%); box-shadow: inset 0 1rpx 0 rgba(255,255,255,.98),0 6rpx 14rpx rgba(58,117,67,.07); }
.setting-icon::before,
.setting-icon::after { content: ''; position: absolute; }
.setting-icon-flag::before { left: calc(50% - 12rpx); top: calc(50% - 14rpx); width: 6rpx; height: 28rpx; border-radius: 3rpx; background: #295E40; }
.setting-icon-flag::after { left: calc(50% - 6rpx); top: calc(50% - 14rpx); width: 18rpx; height: 12rpx; border-radius: 2rpx 6rpx 6rpx 2rpx; background: #2F6F4A; }
.setting-icon-date::before { left: 50%; top: 50%; box-sizing: border-box; width: 34rpx; height: 30rpx; border: 3rpx solid #295E40; border-radius: 8rpx; transform: translate(-50%,-40%); }
.setting-icon-date::after { left: 50%; top: calc(50% - 20rpx); width: 18rpx; height: 6rpx; border-radius: 6rpx; background: #295E40; box-shadow: -10rpx 0 0 #295E40,10rpx 0 0 #295E40; transform: translateX(-50%); }
.setting-icon-clock::before { left: 50%; top: 50%; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 3rpx solid #295E40; border-radius: 50%; transform: translate(-50%,-50%); }
.setting-icon-clock::after { left: 50%; top: calc(50% - 9rpx); width: 3rpx; height: 14rpx; background: #295E40; box-shadow: 7rpx 9rpx 0 0 #295E40; transform: translateX(-50%) rotate(-42deg); transform-origin: top center; }
.setting-icon-question::before { left: 50%; top: 50%; box-sizing: border-box; width: 36rpx; height: 36rpx; border: 3rpx solid #295E40; border-radius: 50%; transform: translate(-50%,-50%); box-shadow: inset 0 0 0 7rpx rgba(41,94,64,.08); }
.setting-icon-question::after { left: 50%; top: 50%; width: 8rpx; height: 8rpx; border-radius: 50%; background: #295E40; transform: translate(-50%,-50%); }
.setting-icon-week::before { left: 50%; top: 50%; box-sizing: border-box; width: 36rpx; height: 32rpx; border: 3rpx solid #295E40; border-radius: 10rpx; transform: translate(-50%,-50%); }
.setting-icon-week::after { left: 50%; top: calc(50% - 4rpx); width: 22rpx; height: 3rpx; background: #295E40; box-shadow: 0 8rpx 0 #295E40; transform: translateX(-50%); }
.setting-icon-priority::before { left: 50%; top: calc(50% - 18rpx); width: 0; height: 0; border-left: 14rpx solid transparent; border-right: 14rpx solid transparent; border-bottom: 18rpx solid #295E40; transform: translateX(-50%); }
.setting-icon-priority::after { left: 50%; top: calc(50% + 2rpx); width: 16rpx; height: 4rpx; border-radius: 4rpx; background: #295E40; box-shadow: 0 10rpx 0 #295E40; transform: translateX(-50%); }
.setting-copy { flex: 1; min-width: 0; }
.setting-label,
.setting-desc,
.setting-value { display: block; }
.setting-label { color: #17301F; font-size: 29rpx; line-height: 1.25; font-weight: 880; }
.setting-desc { margin-top: 5rpx; color: #718176; font-size: 19rpx; line-height: 1.4; }
.setting-value { max-width: 190rpx; flex: 0 0 auto; color: #42604A; font-size: 22rpx; line-height: 1.35; font-weight: 780; text-align: right; }
.setting-value.is-placeholder { color: #A0AAA4; }
.setting-arrow { flex: 0 0 auto; color: #65A870; font-size: 31rpx; line-height: 1; }
.plan-switch { flex: 0 0 auto; transform: scale(.88); transform-origin: right center; }
.pause-link { padding: 20rpx 0 4rpx; color: #7F8D84; font-size: 20rpx; text-align: center; }

/* 408 strategy lives in its own card so native sliders/pickers never overlap plan rows. */
.strategy-card { margin-top: 24rpx; padding: 28rpx 28rpx 22rpx; }
.strategy-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.strategy-title { display: block; margin-top: 8rpx; color: #173B2D; font-size: 32rpx; font-weight: 900; line-height: 1.25; }
.strategy-total { flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 999rpx; background: #EDF5EC; color: #47705A; font-size: 19rpx; font-weight: 800; }
.strategy-total.is-invalid { background: #FFF1E9; color: #B4653A; }
.strategy-note { display: block; margin-top: 12rpx; color: #88978E; font-size: 19rpx; line-height: 1.55; }
.strategy-list { margin-top: 12rpx; }
.strategy-row { padding: 18rpx 0 20rpx; border-bottom: 1rpx solid rgba(222,230,223,.76); }
.strategy-row:last-child { border-bottom: 0; padding-bottom: 8rpx; }
.strategy-subject { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.strategy-name { color: #1C3A2C; font-size: 25rpx; font-weight: 820; }
.strategy-weight { color: #2F6F4A; font-size: 22rpx; font-weight: 850; font-family: 'DIN Alternate', sans-serif; }
.strategy-controls { display: grid; grid-template-columns: 170rpx minmax(0,1fr); align-items: center; gap: 16rpx; margin-top: 12rpx; }
.strategy-stage-picker { width: 170rpx; }
.strategy-stage { height: 58rpx; box-sizing: border-box; padding: 0 14rpx; display: flex; align-items: center; justify-content: space-between; border: 1rpx solid #DDE8DE; border-radius: 16rpx; background: #F7FAF5; color: #536B5E; font-size: 19rpx; font-weight: 720; }
.strategy-stage text { color: #91A098; font-size: 26rpx; line-height: 1; }
.strategy-slider { width: 100%; margin: 0; }
.strategy-warning { display: block; margin: 8rpx 0 0; color: #B4653A; font-size: 18rpx; text-align: right; }

.allocation-section { margin-top: 30rpx; }
.section-head,
.allocation-topline,
.allocation-metrics,
.explain-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.section-head { padding: 0 4rpx 16rpx; align-items: flex-end; }
.section-note { max-width: 270rpx; color: #718176; font-size: 19rpx; line-height: 1.5; text-align: right; }
.allocation-list { display: flex; flex-direction: column; gap: 14rpx; }
.allocation-card { display: flex; align-items: flex-start; gap: 18rpx; padding: 24rpx 22rpx; border: 1rpx solid #CFE6D1; border-radius: 26rpx; background: linear-gradient(90deg,rgba(235,249,236,.72) 0%,rgba(255,255,255,.82) 64%,rgba(247,253,247,.90) 100%); box-shadow: 0 14rpx 34rpx rgba(58,108,67,.06); }
.allocation-code { width: 58rpx; height: 58rpx; flex: 0 0 58rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid #C9E4CC; border-radius: 18rpx; background: linear-gradient(145deg,#EAF8EA 0%,#DDF2DF 100%); color: #2B6B39; font-size: 23rpx; font-weight: 950; }
.allocation-main { flex: 1; min-width: 0; }
.allocation-label { color: #6F8375; font-size: 19rpx; font-weight: 900; letter-spacing: 1.5rpx; }
.allocation-status { color: #42604A; font-size: 19rpx; font-weight: 850; }
.status-done { color: #2F8A40; }
.status-unavailable { color: #6F8375; }
.allocation-title { display: block; margin-top: 8rpx; color: #17301F; font-size: 27rpx; line-height: 1.35; font-weight: 950; }
.allocation-reason { display: block; margin-top: 9rpx; color: #718176; font-size: 21rpx; line-height: 1.55; }
.allocation-metrics { justify-content: flex-start; gap: 22rpx; margin-top: 14rpx; color: #718176; font-size: 18rpx; }
.allocation-arrow { align-self: center; color: #2F7940; font-size: 34rpx; font-weight: 800; }
.allocation-pressed { transform: scale(.99); opacity: .84; }

.explain-card { margin-top: 24rpx; padding: 26rpx 28rpx 30rpx; }
.explain-head { justify-content: flex-start; }
.explain-mark { width: 34rpx; height: 5rpx; border-radius: 999rpx; background: linear-gradient(90deg,#43D75D,#8BE47D); }
.explain-title { color: #193022; font-size: 23rpx; font-weight: 950; }
.explain-text { display: block; margin-top: 12rpx; color: #718176; font-size: 20rpx; line-height: 1.68; }

.fab-drag-layer { position: fixed; z-index: 70; left: 0; top: 0; width: 100vw; height: 100vh; pointer-events: none; }
.fab-drag-view { position: relative; display: flex; width: 120rpx; height: 120rpx; align-items: center; justify-content: center; pointer-events: auto; overflow: visible; }
.fab-drag-view::after { content: ''; position: absolute; left: 50%; top: 50%; z-index: 2; width: 18rpx; height: 18rpx; border: 3rpx solid rgba(255,255,255,.92); border-radius: 50%; background: #3BCF57; box-shadow: 0 5rpx 14rpx rgba(67,201,88,.24); opacity: 0; transform: translate(-50%,-50%) scale(.7); transition: opacity .18s ease, transform .22s cubic-bezier(.16,1,.3,1); pointer-events: none; }
.save-fab { width: 104rpx; min-width: 104rpx; height: 104rpx; margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 50%; background: linear-gradient(145deg,#3BCF57 0%,#4BDC62 100%); box-shadow: 0 18rpx 38rpx rgba(67,201,88,.25); transition: opacity .2s ease, transform .24s cubic-bezier(.16,1,.3,1), box-shadow .2s ease; }
.save-fab::after { border: 0; }
.save-fab-icon { display: block; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; }
.save-fab-loading { display: block; color: #FFFFFF; font-size: 38rpx; line-height: 1; transform: translateY(-2rpx); }
.save-fab-pressed { opacity: .86; transform: scale(.94); }
.save-fab.is-saving { opacity: .72; }
.fab-drag-view.fab-idle .save-fab { opacity: 0; transform: scale(.72); box-shadow: none; }
.fab-drag-view.fab-idle::after { opacity: .78; transform: translate(-50%,-50%) scale(1); }

@media (max-width: 350px) {
  .plan-shell { padding-left: 28rpx; padding-right: 28rpx; }
  .plan-hero-title { font-size: 50rpx; }
  .plan-hero-subtitle { font-size: 21rpx; }
  .settings-card,
  .strategy-card { padding-left: 22rpx; padding-right: 22rpx; }
  .setting-row { gap: 12rpx; }
  .setting-index { width: 40rpx; height: 40rpx; flex-basis: 40rpx; font-size: 16rpx; }
  .setting-icon { width: 64rpx; height: 64rpx; flex-basis: 64rpx; }
  .setting-label { font-size: 26rpx; }
  .setting-value { max-width: 150rpx; font-size: 20rpx; }
  .strategy-controls { grid-template-columns: 150rpx minmax(0,1fr); gap: 10rpx; }
  .strategy-stage-picker { width: 150rpx; }
  .plan-overview-visual { right: -10rpx; top: 66rpx; width: 270rpx; height: 174rpx; }
  .plan-overview-curve { top: 68rpx; width: 260rpx; height: 112rpx; }
  .overview-title { max-width: 340rpx; font-size: 46rpx; }
  .overview-desc { max-width: 345rpx; font-size: 20rpx; }
}
