.fab-drag-view .save-fab{
  background:linear-gradient(145deg,#3BCF57 0%,#4BDC62 100%);
  box-shadow:0 18rpx 38rpx rgba(67,201,88,.25);
}
.fab-drag-view::after{background:#3BCF57;box-shadow:0 5rpx 14rpx rgba(67,201,88,.24);}

@media (max-width:350px){
  .plan-overview-bg-art{right:-1rpx;width:auto;}
