page{min-height: 100vh;background: #F5F6F1;color: #15231A;}
.plan-page{min-height: 100vh;background: radial-gradient(circle at 100% 0%,rgba(183,232,42,.08),transparent 360rpx),linear-gradient(180deg,#F7F8F3 0%,#F3F5F0 100%);}
.plan-shell{padding: 12rpx 24rpx 72rpx;}
.plan-hero{display: flex;align-items: flex-start;justify-content: space-between;gap: 20rpx;padding: 22rpx 10rpx 34rpx;}
.plan-hero-copy{flex: 1;min-width: 0;}
.plan-hero-kicker,.settings-kicker,.section-kicker{display: block;font-size: 18rpx;line-height: 1.2;font-weight: 900;letter-spacing: 3rpx;color: #88A18D;}
.plan-hero-title{display: block;margin-top: 14rpx;color: #163827;font-size: 56rpx;line-height: 1.2;font-weight: 950;letter-spacing: -1.6rpx;}
.plan-hero-subtitle{display: block;margin-top: 18rpx;color: #7B897F;font-size: 25rpx;line-height: 1.7;}
.plan-hero-stepper{width: 82rpx;flex: 0 0 82rpx;display: flex;flex-direction: column;align-items: center;margin-top: 22rpx;padding-top: 12rpx;position: relative;color: #7BA27D;}
.plan-hero-stepper::before{content: '';position: absolute;top: 0;bottom: -28rpx;left: 40rpx;width: 2rpx;background: linear-gradient(180deg,rgba(73,126,85,.45),rgba(73,126,85,.12));}
.plan-hero-step-current,.plan-hero-step-total,.plan-hero-step-divider{position: relative;z-index: 1;display: block;}
.plan-hero-step-current,.plan-hero-step-total{font-size: 26rpx;font-weight: 800;}
.plan-hero-step-divider{margin: 2rpx 0;font-size: 20rpx;color: rgba(75,116,83,.48);}
.state-card,.settings-card,.explain-card,.plan-overview-card{border: 1rpx solid #DEE6DD;border-radius: 32rpx;background: rgba(255,255,255,.84);box-shadow: 0 16rpx 44rpx rgba(23,53,37,.06);}
.state-card{padding: 44rpx 28rpx;text-align: center;font-size: 24rpx;color: #6E7A71;}
.error-card{color: #9D4234;}
.plan-overview-card{position: relative;overflow: hidden;padding: 28rpx 28rpx 0;color: #FFFFFF;background: linear-gradient(145deg,#173B2A 0%,#102A1E 54%,#0C1C14 100%);}
.overview-grid{position: absolute;right: -40rpx;top: -20rpx;width: 360rpx;height: 260rpx;opacity: .06;background-image: linear-gradient(#FFFFFF 1rpx,transparent 1rpx),linear-gradient(90deg,#FFFFFF 1rpx,transparent 1rpx);background-size: 30rpx 30rpx;transform: rotate(8deg);}
.overview-topline,.overview-progress-row,.overview-progress-foot,.overview-metrics{position: relative;z-index: 1;display: flex;align-items: center;justify-content: space-between;gap: 16rpx;}
.overview-brand{display: flex;align-items: center;gap: 10rpx;color: #C2EC50;font-size: 18rpx;font-weight: 900;letter-spacing: 2rpx;}
.overview-brand-dot{width: 12rpx;height: 12rpx;border-radius: 50%;background: #B7E82A;box-shadow: 0 0 0 8rpx rgba(183,232,42,.12);}
.overview-target-chip{padding: 12rpx 16rpx;border: 1rpx solid rgba(255,255,255,.12);border-radius: 999rpx;background: rgba(255,255,255,.06);display: flex;flex-direction: column;align-items: flex-end;gap: 4rpx;color: rgba(255,255,255,.78);font-size: 17rpx;font-weight: 750;}
.overview-title{position: relative;z-index: 1;display: block;margin-top: 34rpx;max-width: 480rpx;font-size: 48rpx;line-height: 1.2;font-weight: 950;}
.overview-desc{position: relative;z-index: 1;display: block;margin-top: 14rpx;color: rgba(239,245,240,.74);font-size: 24rpx;line-height: 1.6;}
.overview-progress-row{margin-top: 30rpx;color: rgba(255,255,255,.64);font-size: 21rpx;font-weight: 750;}
.overview-progress-track{position: relative;z-index: 1;height: 12rpx;margin-top: 12rpx;overflow: hidden;border-radius: 999rpx;background: rgba(255,255,255,.10);}
.overview-progress-fill{height: 100%;border-radius: inherit;background: linear-gradient(90deg,#8FB700 0%,#B7E82A 100%);box-shadow: 0 0 20rpx rgba(183,232,42,.24);}
.overview-progress-foot{margin-top: 10rpx;color: rgba(255,255,255,.46);font-size: 18rpx;line-height: 1.5;}
.overview-progress-foot text:last-child{color: #C9EF64;font-weight: 900;}
.overview-metrics{margin: 28rpx -28rpx 0;padding: 24rpx 28rpx 28rpx;align-items: stretch;background: rgba(255,255,255,.03);border-top: 1rpx solid rgba(255,255,255,.08);}
.overview-metric{flex: 1;min-width: 0;}
.overview-metric-value,.overview-metric-label{display: block;}
.overview-metric-value{font-size: 34rpx;line-height: 1.1;font-weight: 950;}
.overview-metric-label{margin-top: 10rpx;color: rgba(255,255,255,.46);font-size: 18rpx;line-height: 1.4;}
.overview-divider{width: 1rpx;background: rgba(255,255,255,.08);}
.settings-card{margin-top: 24rpx;overflow: hidden;}
.settings-head{display: flex;align-items: flex-end;justify-content: space-between;gap: 20rpx;padding: 28rpx 28rpx 18rpx;}
.settings-title,.section-title{display: block;margin-top: 8rpx;font-size: 34rpx;line-height: 1.2;font-weight: 950;color: #183126;}
.settings-note,.section-note{max-width: 270rpx;text-align: right;color: #7B897F;font-size: 19rpx;line-height: 1.5;}
.settings-list{padding: 0 20rpx 20rpx;}
.setting-row{display: flex;align-items: center;gap: 16rpx;min-height: 112rpx;padding: 0 12rpx;border-bottom: 1rpx solid #E4EBE3;}
.setting-row-last{border-bottom: 0;}
.setting-index{width: 50rpx;height: 50rpx;flex: 0 0 50rpx;display: flex;align-items: center;justify-content: center;border-radius: 50%;background: #EEF4E9;color: #6B806F;font-size: 18rpx;font-weight: 900;}
.setting-icon{position: relative;width: 68rpx;height: 68rpx;flex: 0 0 68rpx;border-radius: 50%;background: linear-gradient(145deg,#F4F8F1,#E8F0E5);border: 1rpx solid #DBE7D8;box-shadow: inset 0 1rpx 0 rgba(255,255,255,.96);}
.setting-icon::before,.setting-icon::after{content: '';position: absolute;}
.setting-icon-flag::before{left: 24rpx;top: 18rpx;width: 6rpx;height: 28rpx;border-radius: 3rpx;background: #295E40;}
.setting-icon-flag::after{left: 30rpx;top: 18rpx;width: 18rpx;height: 12rpx;border-radius: 2rpx 6rpx 6rpx 2rpx;background: #2F6F4A;}
.setting-icon-date::before{left: 19rpx;top: 20rpx;width: 28rpx;height: 24rpx;border: 3rpx solid #295E40;border-radius: 8rpx;}
.setting-icon-date::after{left: 24rpx;top: 14rpx;width: 18rpx;height: 6rpx;border-radius: 6rpx;background: #295E40;box-shadow: -10rpx 0 0 #295E40,10rpx 0 0 #295E40;}
.setting-icon-clock::before{left: 18rpx;top: 18rpx;width: 30rpx;height: 30rpx;border: 3rpx solid #295E40;border-radius: 50%;}
.setting-icon-clock::after{left: 32rpx;top: 25rpx;width: 3rpx;height: 14rpx;background: #295E40;box-shadow: 7rpx 9rpx 0 0 #295E40;transform-origin: top center;transform: rotate(-42deg);}
.setting-icon-week::before{left: 18rpx;top: 18rpx;width: 30rpx;height: 26rpx;border: 3rpx solid #295E40;border-radius: 10rpx;}
.setting-icon-week::after{left: 22rpx;top: 30rpx;width: 22rpx;height: 3rpx;background: #295E40;box-shadow: 0 8rpx 0 #295E40;}
.setting-icon-priority::before{left: 20rpx;top: 20rpx;width: 0;height: 0;border-left: 14rpx solid transparent;border-right: 14rpx solid transparent;border-bottom: 18rpx solid #295E40;}
.setting-icon-priority::after{left: 26rpx;top: 40rpx;width: 16rpx;height: 4rpx;border-radius: 4rpx;background: #295E40;box-shadow: 0 10rpx 0 #295E40;}
.setting-copy{flex: 1;min-width: 0;}
.setting-label,.setting-desc,.setting-value{display: block;}
.setting-label{color: #173124;font-size: 28rpx;font-weight: 900;}
.setting-desc{margin-top: 6rpx;color: #8A968E;font-size: 19rpx;}
.setting-value{max-width: 180rpx;color: #3D4D44;font-size: 22rpx;line-height: 1.4;font-weight: 850;text-align: right;}
.setting-value.is-placeholder{color: #A0AAA4;}
.setting-arrow{color: #95A097;font-size: 32rpx;font-weight: 500;}
.plan-switch{transform: scale(.92);transform-origin: center right;}
.save-button{margin: 8rpx 28rpx 0;min-height: 92rpx;border: 0;border-radius: 24rpx;background: #173426;color: #FFFFFF;font-size: 25rpx;font-weight: 900;box-shadow: 0 14rpx 30rpx rgba(23,52,38,.14);}
.save-button::after{border: 0;}
.pause-link{padding: 24rpx 0 28rpx;text-align: center;color: #8B625A;font-size: 21rpx;}
.allocation-section{margin-top: 34rpx;}
.section-head,.allocation-topline,.allocation-metrics,.explain-head{display: flex;align-items: center;justify-content: space-between;gap: 18rpx;}
.section-head{padding: 0 4rpx 16rpx;align-items: flex-end;}
.allocation-list{display: flex;flex-direction: column;gap: 14rpx;}
.allocation-card{display: flex;align-items: flex-start;gap: 18rpx;padding: 24rpx 22rpx;border: 1rpx solid #DEE2DA;border-radius: 26rpx;background: rgba(255,255,255,.82);box-shadow: 0 10rpx 30rpx rgba(24,53,40,.05);}
.allocation-code{width: 58rpx;height: 58rpx;flex-shrink: 0;display: flex;align-items: center;justify-content: center;border-radius: 18rpx;background: #E8EDD8;color: #173426;font-size: 23rpx;font-weight: 950;}
.allocation-main{flex: 1;min-width: 0;}
.allocation-label{font-size: 19rpx;font-weight: 900;letter-spacing: 1.5rpx;color: #748078;}
.allocation-status{font-size: 19rpx;font-weight: 850;color: #526159;}
.status-done{color: #477637;}
.status-unavailable{color: #9A8066;}
.allocation-title{display: block;margin-top: 8rpx;font-size: 27rpx;line-height: 1.35;font-weight: 950;color: #17251B;}
.allocation-reason{display: block;margin-top: 9rpx;font-size: 21rpx;line-height: 1.55;color: #68756C;}
.allocation-metrics{justify-content: flex-start;gap: 22rpx;margin-top: 14rpx;color: #879188;font-size: 18rpx;}
.allocation-arrow{align-self: center;font-size: 34rpx;font-weight: 800;color: #173426;}
.allocation-pressed{transform: scale(.99);opacity: .84;}
.explain-card{margin-top: 24rpx;padding: 26rpx 28rpx;}
.explain-head{justify-content: flex-start;}
.explain-mark{width: 38rpx;height: 6rpx;border-radius: 999rpx;background: linear-gradient(90deg,#173426,#B7E82A);}
.explain-title{color: #203025;font-size: 24rpx;font-weight: 950;}
.explain-text{display: block;margin-top: 12rpx;color: #748078;font-size: 21rpx;line-height: 1.68;}
@media (max-width: 350px){.plan-shell{padding-left: 18rpx;padding-right: 18rpx;}
.plan-hero{padding-left: 2rpx;padding-right: 2rpx;}
