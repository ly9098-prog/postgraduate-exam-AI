/* Fill tall real-device viewports with the five setting options. Spare height
   is shared by the rows instead of becoming an empty block below the action. */
.plan-page.is-setup{height:auto;min-height:100vh;overflow:visible;display:flex;flex-direction:column;}
.is-setup .plan-shell{height:auto;min-height:0;flex:1 1 0;overflow:visible;display:flex;flex-direction:column;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));}
.is-setup .settings-card{min-height:0;flex:1 1 auto;display:flex;flex-direction:column;}
.is-setup .settings-head{flex:0 0 auto;}
.is-setup .settings-list{min-height:580rpx;flex:1 1 auto;display:flex;flex-direction:column;}
.is-setup .setting-row-switch,.is-setup .setting-picker{min-height:116rpx;flex:1 1 0;}
.is-setup .setting-picker{display:flex;width:100%;}
.is-setup .setting-picker .setting-row{width:100%;min-height:116rpx;flex:1 1 auto;box-sizing:border-box;}
.is-setup .setting-row{padding-top:18rpx;padding-bottom:18rpx;}
.is-setup .setting-index{width:44rpx;height:44rpx;flex-basis:44rpx;font-size:18rpx;}
.is-setup .setting-icon{width:76rpx;height:76rpx;flex-basis:76rpx;}
.is-setup .setting-label{font-size:30rpx;}
.is-setup .setting-desc{margin-top:5rpx;font-size:20rpx;line-height:1.4;}
.is-setup .setting-value{font-size:22rpx;}
.is-setup .explain-card{margin-top:20rpx;}
.is-setup .save-fab{position:relative;right:auto;bottom:auto;align-self:flex-end;margin:16rpx 0 0 auto;}

/* Draggable assistive action: larger, initially higher, and non-blocking. */
.fab-drag-layer{position:fixed;z-index:70;left:0;top:0;width:100vw;height:100vh;pointer-events:none;}
.fab-drag-view{position:relative;display:flex;width:120rpx;height:120rpx;align-items:center;justify-content:center;pointer-events:auto;overflow:visible;}
.fab-drag-view::after{content:'';position:absolute;left:50%;top:50%;z-index:2;width:18rpx;height:18rpx;border:3rpx solid rgba(255,255,255,.92);border-radius:50%;background:#1C6245;box-shadow:0 5rpx 14rpx rgba(16,61,42,.24);opacity:0;transform:translate(-50%,-50%) scale(.7);transition:opacity .18s ease,transform .22s cubic-bezier(.16,1,.3,1);pointer-events:none;}
.fab-drag-view .save-fab{position:relative;right:auto;bottom:auto;width:104rpx;min-width:104rpx;height:104rpx;margin:0;display:flex;align-items:center;justify-content:center;opacity:1;transform:scale(1);box-shadow:0 20rpx 38rpx rgba(22,62,43,.28);transition:opacity .2s ease,transform .24s cubic-bezier(.16,1,.3,1),box-shadow .2s ease;}
.fab-drag-view .save-fab-icon{width:40rpx;height:40rpx;flex-basis:40rpx;}
.fab-drag-view.fab-idle .save-fab{opacity:0;transform:scale(.72);box-shadow:none;}
.fab-drag-view.fab-idle::after{opacity:.78;transform:translate(-50%,-50%) scale(1);}
.fab-drag-view .save-fab-pressed{opacity:.86;transform:scale(.94);}

/* A centred SVG avoids font-baseline and transform differences on devices. */
.save-fab-icon{display:block;width:34rpx;height:34rpx;flex:0 0 34rpx;}
.save-fab-loading{display:block;color:#FFFFFF;font-size:38rpx;line-height:1;transform:translateY(-2rpx);}

/* Keep every CSS-drawn setting glyph centred as the circular container changes
   size across width and height breakpoints. */
.setting-icon-flag::before{left:calc(50% - 12rpx);top:calc(50% - 14rpx);}
.setting-icon-flag::after{left:calc(50% - 6rpx);top:calc(50% - 14rpx);}
.setting-icon-date::before{left:50%;top:50%;box-sizing:border-box;width:34rpx;height:30rpx;transform:translate(-50%,-40%);}
.setting-icon-date::after{left:50%;top:calc(50% - 20rpx);transform:translateX(-50%);}
.setting-icon-clock::before{left:50%;top:50%;box-sizing:border-box;width:36rpx;height:36rpx;transform:translate(-50%,-50%);}
.setting-icon-clock::after{left:50%;top:calc(50% - 9rpx);transform:translateX(-50%) rotate(-42deg);}
.setting-icon-week::before{left:50%;top:50%;box-sizing:border-box;width:36rpx;height:32rpx;transform:translate(-50%,-50%);}
.setting-icon-week::after{left:50%;top:calc(50% - 4rpx);transform:translateX(-50%);}
.setting-icon-priority::before{left:50%;top:calc(50% - 18rpx);transform:translateX(-50%);}
.setting-icon-priority::after{left:50%;top:calc(50% + 2rpx);transform:translateX(-50%);}

/* The shared card rule above intentionally paints normal cards white. Keep the
   configured overview visually distinct and readable after that rule wins in
   the cascade on real devices. */
.plan-page.is-configured .plan-overview-card{
  color:#FFFFFF;
  border:1rpx solid rgba(255,255,255,.08);
  background:linear-gradient(145deg,#173B2A 0%,#102A1E 54%,#0C1C14 100%);
  box-shadow:0 20rpx 48rpx rgba(15,43,29,.18);
}
.plan-page.is-configured .overview-brand{color:#C2EC50;}
.plan-page.is-configured .overview-target-chip{color:rgba(255,255,255,.82);background:rgba(255,255,255,.07);}
.plan-page.is-configured .overview-title,
.plan-page.is-configured .overview-metric-value{color:#FFFFFF;}
.plan-page.is-configured .overview-desc{color:rgba(239,245,240,.78);}
.plan-page.is-configured .overview-progress-row{color:rgba(255,255,255,.72);}
.plan-page.is-configured .overview-progress-foot,
.plan-page.is-configured .overview-metric-label{color:rgba(255,255,255,.58);}
.plan-page.is-configured .overview-progress-foot text:last-child{color:#C9EF64;}

/* Home visual language: white/mint surfaces, bright study green and dark ink. */
page{
  background:#F3F8F2;
  background-color:#F3F8F2;
  color:#13251A;
}
.plan-page{
  color:#13251A;
  background:
    radial-gradient(circle at 92% 2%,rgba(126,228,137,.10),transparent 360rpx),
    radial-gradient(circle at 5% 40%,rgba(196,239,199,.11),transparent 420rpx),
    linear-gradient(180deg,#F8FBF7 0%,#F2F7F1 54%,#EFF5EE 100%);
}
.plan-hero-kicker,.settings-kicker,.section-kicker{color:#6F8375;}
.plan-hero-title,.settings-title,.section-title{color:#12241A;}
.plan-hero-subtitle,.setting-desc,.section-note,.allocation-reason,.explain-text{color:#718176;}
.plan-hero-step-current,.plan-hero-step-total{color:#4F9A5B;}
.plan-hero-stepper::before{background:linear-gradient(180deg,rgba(67,215,93,.58),rgba(67,215,93,.12));}
.settings-title::after{background:linear-gradient(90deg,#CDE2CF,rgba(205,226,207,0));}
.settings-list::before{background:#D5E8D7;}

/* Match the Home top card composition while keeping plan-specific data. */
.plan-page.is-configured .plan-overview-card{
  position:relative;
  overflow:hidden;
  margin-bottom:28rpx;
  padding:28rpx 30rpx 0;
  border:1rpx solid rgba(186,223,188,.82);
  border-radius:38rpx;
  color:#13251A;
  background:linear-gradient(180deg,#FFFFFF 0%,#F8FFF7 100%);
  box-shadow:0 20rpx 52rpx rgba(74,111,79,.10);
}
.plan-overview-bg-art{
  position:absolute;
  z-index:0;
  display:block;
  right:-1rpx;
  top:0;
  width:auto;
  height:100%;
  border-radius:inherit;
  pointer-events:none;
}
.plan-overview-bg-wash{
  position:absolute;
  z-index:1;
  inset:0;
  border-radius:inherit;
  background:linear-gradient(90deg,rgba(255,255,255,.995) 0%,rgba(255,255,255,.985) 38%,rgba(255,255,255,.90) 54%,rgba(255,255,255,.38) 70%,rgba(255,255,255,.04) 88%,rgba(255,255,255,0) 100%);
  pointer-events:none;
}
.plan-overview-visual{
  position:absolute;
  z-index:2;
  right:-8rpx;
  top:62rpx;
  width:310rpx;
  height:190rpx;
  pointer-events:none;
}
.plan-overview-curve{position:absolute;right:0;top:70rpx;width:300rpx;height:126rpx;}
.plan-page.is-configured .overview-grid{display:none;}
.plan-page.is-configured .overview-topline,
.plan-page.is-configured .overview-title,
.plan-page.is-configured .overview-desc,
.plan-page.is-configured .overview-progress-row,
.plan-page.is-configured .overview-progress-track,
.plan-page.is-configured .overview-progress-foot,
.plan-page.is-configured .overview-metrics{z-index:3;}
.plan-page.is-configured .overview-brand{color:#26372B;font-size:17rpx;letter-spacing:1.55rpx;}
.overview-brand-icon{display:block;width:34rpx;height:34rpx;flex:0 0 34rpx;margin-right:2rpx;}
.plan-page.is-configured .overview-target-chip{
  min-width:120rpx;
  padding:10rpx 18rpx;
  border:2rpx solid #3C8E4C;
  color:#173C22;
  background:rgba(255,255,255,.66);
  box-shadow:none;
}
.plan-page.is-configured .overview-title{
  max-width:390rpx;
  margin-top:30rpx;
  color:#0F1711;
  font-size:52rpx;
  line-height:1.12;
  letter-spacing:-1.4rpx;
}
.plan-page.is-configured .overview-desc{max-width:400rpx;margin-top:12rpx;color:#667366;font-size:22rpx;line-height:1.55;}
.plan-page.is-configured .overview-progress-row{margin-top:34rpx;color:#223325;font-size:23rpx;}
.plan-page.is-configured .overview-progress-track{height:14rpx;margin-top:10rpx;background:rgba(220,229,220,.88);}
.plan-page.is-configured .overview-progress-fill{
  background:linear-gradient(90deg,#4BDC62 0%,#92F06E 100%);
  box-shadow:0 0 16rpx rgba(104,221,106,.22);
}
.plan-page.is-configured .overview-progress-foot{margin-top:12rpx;color:#687668;font-size:18rpx;}
.plan-page.is-configured .overview-progress-foot text:last-child{color:#38B74E;}
.plan-page.is-configured .overview-metrics{
  margin:24rpx -30rpx 0;
  padding-top:22rpx;
  border-top:1rpx solid rgba(184,215,186,.56);
  background:rgba(255,255,255,.18);
}
.plan-page.is-configured .overview-metric-value{color:#101813;}
.plan-page.is-configured .overview-metric-label{color:#718073;}
.plan-page.is-configured .overview-divider{background:rgba(184,215,186,.72);}

/* Settings, task cards and the assistive action use the same Home palette. */
.plan-page .setting-icon{
  border-color:#C8E2CB;
  background:linear-gradient(145deg,#F1FAF1 0%,#E3F3E5 100%);
  box-shadow:inset 0 1rpx 0 rgba(255,255,255,.98),0 6rpx 14rpx rgba(58,117,67,.07);
}
.plan-page .setting-index{background:#EAF8EA;color:#2B6B39;}
.plan-page .setting-label{color:#17301F;}
.plan-page .setting-desc{color:#718176;}
.plan-page .setting-value{color:#42604A;}
.plan-page .setting-arrow{color:#65A870;}
.allocation-card{
  border-color:#CFE6D1;
  background:linear-gradient(90deg,rgba(235,249,236,.72) 0%,rgba(255,255,255,.82) 64%,rgba(247,253,247,.90) 100%);
  box-shadow:0 14rpx 34rpx rgba(58,108,67,.06),inset 0 1rpx 0 rgba(255,255,255,.98);
