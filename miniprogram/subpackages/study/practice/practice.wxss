,242,242,0.98) 0%,rgba(255,247,237,0.96) 100%);border-color: rgba(239,68,68,0.28);box-shadow: 0 24rpx 56rpx rgba(239,68,68,0.22);}.answer-feedback.combo-fire .feedback-icon-wrap{background: linear-gradient(135deg,#EF4444 0%,#F97316 100%);box-shadow: 0 14rpx 32rpx rgba(239,68,68,0.34);animation: firePop 0.4s ease-out;}.answer-feedback.combo-fire .feedback-combo{background: linear-gradient(135deg,#FEF2F2,#FFF7ED);color: #DC2626;font-size: 26rpx;padding: 8rpx 18rpx;animation: firePop 0.5s ease-out;}@keyframes firePop{0%{transform: scale(0.7);}60%{transform: scale(1.12);}100%{transform: scale(1);}}@keyframes feedbackFloatIn{from{opacity: 0;transform: translateY(24rpx) scale(0.98);}to{opacity: 1;transform: translateY(0) scale(1);}}@keyframes feedbackPop{0%{transform: scale(0.78);}72%{transform: scale(1.08);}100%{transform: scale(1);}}@keyframes comboPulse{0%{transform: scale(0.9);}55%{transform: scale(1.08);}100%{transform: scale(1);}}@keyframes starBurst{0%{opacity: 0;transform: translateY(18rpx) scale(0.6) rotate(0deg);}35%{opacity: 1;}100%{opacity: 0;transform: translateY(-22rpx) scale(1.12) rotate(18deg);}}.submit-loading-mask{position: fixed;inset: 0;z-index: 180;display: flex;align-items: center;justify-content: center;padding: 32rpx;background: rgba(11,22,15,.46);backdrop-filter: blur(16rpx);-webkit-backdrop-filter: blur(16rpx);box-sizing: border-box;}.submit-loading-card{position: relative;width: 430rpx;padding: 42rpx 36rpx 38rpx;border: 1rpx solid rgba(255,255,255,.82);border-radius: 38rpx;background: radial-gradient(circle at 50% 35%,rgba(183,232,42,.12),rgba(183,232,42,0) 42%),rgba(251,251,247,.98);box-shadow: 0 30rpx 90rpx rgba(4,13,8,.28);display: flex;flex-direction: column;align-items: center;overflow: hidden;box-sizing: border-box;}.submit-loading-card::before{content:'';position:absolute;top:0;left:0;right:0;height:8rpx;background:linear-gradient(90deg,#173426,#B7E82A 70%,#66DDC4);}.submit-loading-kicker{color:#6C8B18;font-size:17rpx;line-height:1;font-weight:900;letter-spacing:3rpx;}.submit-loading-title{margin-top:8rpx;color:#17251B;font-size:31rpx;line-height:1.35;font-weight:950;text-align:center;}.submit-loading-desc{margin-top:9rpx;color:#7A857D;font-size:22rpx;line-height:1.55;text-align:center;}.submit-loading-dots{margin-top:22rpx;display:flex;align-items:center;gap:9rpx;}.submit-loading-dots > view{width:8rpx;height:8rpx;border-radius:50%;background:#173426;animation:submitDot 1s ease-in-out infinite;}.submit-loading-dots > view:nth-child(2){animation-delay:.14s;background:#8CCB38;}.submit-loading-dots > view:nth-child(3){animation-delay:.28s;background:#58D6C6;}@keyframes submitDot{0%,100%{opacity:.28;transform:translateY(0);}50%{opacity:1;transform:translateY(-7rpx);}}.loading-wrap{display: flex;flex-direction: column;align-items: center;justify-content: center;padding: 180rpx 0;min-height: 60vh;}.loading-wrap.launch-loading{min-height: 100vh;box-sizing: border-box;padding: 0 0 8vh;background: radial-gradient(circle at 78% 18%,rgba(183,216,169,.18),transparent 34%),#F3F4F1;}@media (prefers-reduced-motion: reduce){.page{opacity: 1 !important;}.hero-orbit,.practice-hero::before,.practice-hero::after,.subject-parent-row,.child-subject-chip,.mode-card,.count-btn,.progress-fill,.q-wrap,.slide-in,.slide-out-left,.slide-out-right,.edge-left,.edge-right,.option-item,.option-item::after,.option-indicator,.dot,.sheet-cell,.answer-feedback,.feedback-icon-wrap,.feedback-combo,.star{animation: none !important;transition: none !important;transform: none !important;}}.code-wrapper{display: block;width: 100%;max-width: 100%;box-sizing: border-box;background: #F5F6FA;border-radius: 12rpx;padding: 24rpx 20rpx;margin: 16rpx 0 28rpx;overflow: hidden;}.code-text{display: inline-block;min-width: 100%;box-sizing: border-box;white-space: pre;font-family: 'Courier New',Courier,monospace;font-size: 28rpx;line-height: 1.7;color: #1A1A2E;}.mixed-text-block{display: block;margin-bottom: 18rpx;}.mixed-latex-block{display: block;margin-bottom: 18rpx;}.mixed-code-block{margin: 16rpx 0 28rpx;}.recommend-reason-bar{display: flex;align-items: center;padding: 10rpx 20rpx;margin: 0 0 12rpx 0;background: linear-gradient(135deg,rgba(79,127,255,0.08) 0%,rgba(34,197,94,0.06) 100%);border-radius: 12rpx;border-left: 6rpx solid #4F7FFF;}.recommend-reason-text{font-size: 24rpx;color: #4F7FFF;font-weight: 500;line-height: 1.5;}.setup-content{padding: 22rpx 24rpx calc(46rpx + env(safe-area-inset-bottom));}.practice-hero{border-radius: 40rpx;box-shadow: 0 28rpx 68rpx rgba(16,37,26,.23);}.settings-panel{border-radius: 34rpx;border-color: #DDE2DA;box-shadow: 0 12rpx 34rpx rgba(16,37,26,.055);}.mode-card,.count-btn{border-radius: 26rpx;}.recent-card{border-radius: 24rpx;border-color: #DFE3DC;}.subject-sheet{border-radius: 40rpx 40rpx 0 0;background: #FBFBF7;}.sheet-close{display:flex;align-items:center;justify-content:center;}.sheet-close .line-icon{width: 28rpx;height: 28rpx;color: #324239;}.reward-strip{margin-top: 22rpx;padding: 22rpx 24rpx;border: 1rpx solid #DDE2DA;border-radius: 30rpx;background: rgba(255,255,255,.82);display:flex;align-items:center;justify-content:space-between;gap:20rpx;box-shadow: 0 10rpx 28rpx rgba(16,37,26,.045);}.reward-strip-copy{min-width:0;flex:1;}.reward-strip-title{display:block;color:#17251B;font-size:26rpx;line-height:1.3;font-weight:900;}.reward-strip-desc{display:block;margin-top:6rpx;color:#7B867E;font-size:20rpx;line-height:1.4;}.reward-strip-items{flex-shrink:0;display:flex;align-items:center;min-width:250rpx;}.reward-strip-item{flex:1;min-width:0;text-align:center;}.reward-strip-label{display:block;color:#7A867D;font-size:18rpx;font-weight:750;}.reward-strip-value{display:block;margin-top:4rpx;color:#173426;font-size:25rpx;line-height:1.2;font-weight:950;}.reward-strip-text{font-size:21rpx;white-space:nowrap;}.reward-strip-divider{width:1rpx;height:44rpx;margin:0 14rpx;background:#DDE2DA;}@media (max-width: 360px){.reward-strip{align-items:flex-start;}.reward-strip-desc{display:none;}.reward-strip-items{min-width:226rpx;}}.practice{height: 100vh;min-height: 0;overflow: hidden;box-sizing: border-box;background: #0D2117;}.practice-runner{display: block;width: 100%;height: 100%;min-height: 0;}@media (prefers-reduced-motion: reduce){.loading-wrap.launch-loading{animation: none;}}

/* Mint setup surface: a light, focused workspace before the question flow begins. */
page,
.page { background: #F3FBF8; color: #23483C; }
.setup {
  background:
    radial-gradient(circle at 92% 2%, rgba(126, 216, 181, .18) 0, rgba(126, 216, 181, 0) 30%),
    linear-gradient(180deg, #F7FFFC 0%, #F0FAF6 100%);
}
.setup-content { padding-top: 18rpx; }
.practice-hero {
  border-radius: 32rpx;
  padding: 32rpx 30rpx 24rpx;
  background:
    radial-gradient(circle at 88% 10%, rgba(126, 216, 181, .32) 0, rgba(126, 216, 181, 0) 34%),
    linear-gradient(145deg, #EAF9F4 0%, #F8FFFC 76%, #FFFFFF 100%);
  color: #23483C;
  border: 1rpx solid #D8EEE6;
  box-shadow: 0 16rpx 36rpx rgba(43, 117, 91, .08);
}
.practice-hero::after {
  border-color: rgba(126, 216, 181, .24);
  box-shadow: 0 0 0 34rpx rgba(126, 216, 181, .06), 0 0 0 68rpx rgba(126, 216, 181, .03);
}
.hero-grid { opacity: 0; }
.hero-eyebrow { color: #3D9778; }
.hero-subject { color: #23483C; }
.hero-subject-arrow { border-color: #BEE8D7; color: #2F8066; background: rgba(255, 255, 255, .72); }
.hero-number { color: #3A6F5B; }
.hero-number-unit { color: #35A880; }
.hero-metric-label { color: #76968B; }
.hero-metric-divider { background: #CBEDE0; }
.wave-line { background: #7ED8B5; }
.hero-start {
  background: #3A6F5B;
  color: #FFFFFF;
  border: 1rpx solid #3A6F5B;
  box-shadow: 0 10rpx 22rpx rgba(58, 111, 91, .16);
}
.hero-start-arrow { background: #7ED8B5; color: #23483C; }
.hero-start-pressed { background: #2F8066; }
.hero-config { border-color: #CBEDE0; background: rgba(255, 255, 255, .72); }
.hero-config-text,
.hero-config-edit { color: #4E7566; }
.config-chevron { color: #55B990; }
.settings-panel,
.reward-panel {
  border-color: #D8EEE6;
  background: rgba(255, 255, 255, .88);
  box-shadow: 0 12rpx 30rpx rgba(43, 117, 91, .06);
}
.panel-title,
.surface-title,
.sheet-title { color: #23483C; }
.panel-kicker,
.surface-kicker,
.sheet-kicker { color: #78A193; }
.panel-collapse,
.surface-action { color: #3D8068; }
.setting-title { color: #2D5D4C; }
.setting-desc { color: #78958A; }
.mode-row,
.count-row { gap: 12rpx; }
.mode-card,
.count-btn {
  border-color: #D8EEE6;
  border-radius: 20rpx;
  background: #F6FCF9;
}
.mode-card.active,
.count-btn.active {
  border-color: #7ED8B5;
  background: #EAF9F4;
  box-shadow: inset 0 0 0 2rpx rgba(126, 216, 181, .18);
}
.mode-icon,
.count-main { color: #3A6F5B; }
.mode-title { color: #2D5D4C; }
.mode-desc,
.count-time { color: #78958A; }
.option-check,
.count-check { background: #55C89B; color: #FFFFFF; }
.recent-section { margin-top: 28rpx; }
.recent-card { border-color: #D8EEE6; background: rgba(255, 255, 255, .88); box-shadow: 0 8rpx 20rpx rgba(43, 117, 91, .05); }
.recent-card.active { background: #3A6F5B; border-color: #3A6F5B; }
.recent-mark { background: #EAF9F4; border-color: #D8EEE6; color: #2F8066; }
.recent-card.active .recent-mark { background: rgba(255, 255, 255, .15); color: #BFEEDB; }
.recent-selected-badge { background: #7ED8B5; color: #23483C; }
.recent-name { color: #2D5143; }
.recent-card-footer { color: #7A978C; }
.recent-status-dot { background: #B5D9CA; }
.recent-card.active .recent-name { color: #FFFFFF; }
.recent-card.active .recent-card-footer { color: rgba(255, 255, 255, .72); }
.recent-card.active .recent-status-dot { background: #7ED8B5; box-shadow: 0 0 0 4rpx rgba(126, 216, 181, .14); }
.reward-icon { background: #EAF9F4; color: #3A6F5B; }
.reward-label,
.reward-note { color: #7A978C; }
.reward-value { color: #2D5D4C; }
.reward-divider { background: #D8EEE6; }
.subject-sheet-backdrop { background: rgba(35, 72, 60, .42); }
.subject-sheet { background: #FBFFFD; box-shadow: 0 -20rpx 48rpx rgba(43, 117, 91, .14); }
.sheet-handle { background: #B9DCCE; }
.sheet-section-label,
.parent-name { color: #2D5D4C; }
.parent-meta,
.child-subject-name,
.subject-empty-hint { color: #7A978C; }
.subject-parent-row,
.child-subject-row { border-color: #E0F1EB; }
.subject-parent-row.selected,
.child-subject-row.active { background: #EAF9F4; }
.parent-folder { background: #DDF6EC; color: #2F8066; }
.parent-arrow { color: #55B990; }
.child-select-mark { background: #55C89B; }
.setup-error-card { background: #FFF6F3; border-color: #F0C3B9; }
.setup-error-icon { color: #C36C5C; }
.setup-error-text { color: #A85648; }
.setup-error-retry { color: #FFFFFF; background: #B66758; border-radius: 999rpx; }
.submit-loading-mask { background: rgba(35, 72, 60, .3); }
.submit-loading-card { border-color: #D8EEE6; background: rgba(251, 255, 253, .98); box-shadow: 0 24rpx 64rpx rgba(43, 117, 91, .18); }
.submit-loading-card::before { background: linear-gradient(90deg, #3A6F5B, #7ED8B5); }
.submit-loading-kicker { color: #3D8068; }
.submit-loading-title { color: #23483C; }
.submit-loading-desc { color: #78958A; }
.submit-loading-dots > view { background: #3A6F5B; }
.submit-loading-dots > view:nth-child(2) { background: #7ED8B5; }
.submit-loading-dots > view:nth-child(3) { background: #55C89B; }
.loading-wrap.launch-loading { background: radial-gradient(circle at 78% 18%, rgba(126, 216, 181, .18), transparent 34%), #F3FBF8; }
.practice { background: #F3FBF8; }
@media (prefers-reduced-motion: reduce) {
  .practice-hero,
  .mode-card,
  .count-btn,
  .recent-card,
  .hero-start,
  .subject-sheet { transition: none !important; }
}
