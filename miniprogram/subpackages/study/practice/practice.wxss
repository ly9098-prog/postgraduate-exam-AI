@import '../../../styles/tokens.wxss';page{min-height:100vh;background-color:#F3F4F1;overflow-x:hidden}
.page{min-height:100vh;background-color:#F3F4F1;padding-bottom:0;overflow-x:hidden}
.setup{min-height:100vh;padding-bottom:calc(50rpx + env(safe-area-inset-bottom))}
.soft-pressed,.option-pressed,.recent-card-pressed{opacity:0.78;transform:scale(0.985)}
.setup-error-card{margin:24rpx;padding:32rpx;border:2rpx solid rgba(255,80,80,0.25);border-radius:24rpx;display:flex;flex-direction:column;align-items:center;gap:16rpx}
.setup-error-icon{font-size:48rpx;line-height:1}
.setup-error-text{font-size:26rpx;text-align:center;line-height:1.5}
.setup-error-retry{margin-top:8rpx;padding:16rpx 48rpx;font-size:26rpx;line-height:1.4}
.practice-hero{position:relative;overflow:hidden}
.practice-hero::after{content:'';position:absolute;right:-54rpx;bottom:-76rpx;width:240rpx;height:240rpx;border:1rpx solid rgba(174,238,0,0.12);border-radius:50%;pointer-events:none}
.hero-grid{position:absolute;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,0.35) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(255,255,255,0.35) 1rpx,transparent 1rpx);background-size:28rpx 28rpx}
.hero-grid-a{width:280rpx;height:220rpx;right:-20rpx;top:-20rpx;transform:rotate(8deg)}
.hero-grid-b{width:160rpx;height:120rpx;left:-42rpx;bottom:42rpx;transform:rotate(-7deg)}
.hero-head,.hero-metrics,.hero-start,.hero-config{position:relative;z-index:1}
.hero-eyebrow{display:block;font-size:21rpx;line-height:1;letter-spacing:5rpx;font-weight:800}
.hero-subject-action{margin-top:16rpx;display:inline-flex;align-items:center;gap:12rpx;max-width:100%}
.hero-subject{font-size:52rpx;line-height:1.15;font-weight:900;letter-spacing:1rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.hero-subject-arrow{flex-shrink:0;border:1rpx solid rgba(255,255,255,0.28);font-size:34rpx;text-align:center}
.hero-metrics{margin-top:34rpx;min-height:132rpx;display:flex;align-items:center}
.hero-metric{min-width:150rpx}
.hero-metric-primary{min-width:240rpx}
.hero-number-line{display:flex;align-items:flex-end;gap:8rpx;height:80rpx}
.hero-number{font-size:78rpx;line-height:0.95;font-weight:900;font-family:Arial,sans-serif;font-variant-numeric:tabular-nums;letter-spacing:-3rpx}
.hero-number-small{font-size:58rpx;letter-spacing:-2rpx}
.hero-number-unit{padding-bottom:8rpx;font-size:22rpx;line-height:1;font-weight:900;letter-spacing:1rpx}
.hero-metric-label{display:block;margin-top:11rpx;font-size:18rpx;line-height:1.3;letter-spacing:1.5rpx;font-weight:700}
.hero-metric-divider{width:1rpx;height:88rpx;margin:0 30rpx 0 6rpx}
.metric-wave{flex:1;min-width:90rpx;height:72rpx;position:relative;margin-left:12rpx;opacity:0.92}
.wave-line{position:absolute;left:0;right:0;height:2rpx;border-radius:999rpx;transform-origin:left center}
.wave-1{top:36rpx;transform:skewY(-17deg)}
.wave-2{top:30rpx;width:68%;left:22%;transform:skewY(22deg);opacity:.72}
.wave-3{top:45rpx;width:48%;left:48%;transform:skewY(-12deg);opacity:.48}
.hero-start{margin-top:28rpx;height:102rpx;padding:0 14rpx 0 34rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:space-between;font-size:30rpx;font-weight:900}
.hero-start::after{border:none}
.hero-start[disabled]{background:#3C473E;color:rgba(255,255,255,0.42);box-shadow:none}
.hero-start-arrow{font-size:48rpx;font-weight:400}
.hero-start[disabled] .hero-start-arrow{background:rgba(255,255,255,0.10);color:rgba(255,255,255,0.38)}
.hero-start-pressed{transform:scale(0.988);opacity:0.92}
.hero-config{margin-top:14rpx;justify-content:space-between;border:1rpx solid rgba(255,255,255,0.07)}
.hero-config-text{line-height:1.35;font-weight:700}
.hero-config-edit{height:48rpx}
.config-chevron{font-size:22rpx;transition:transform .2s ease}
.settings-panel{margin-top:22rpx;border:1rpx solid rgba(18,32,22,0.07)}
.settings-panel{padding:28rpx;animation:panelReveal .22s ease-out both}
@keyframes panelReveal{from{opacity:0;transform:translateY(-10rpx)}
to{opacity:1;transform:translateY(0)}
}
.panel-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}
.section-heading-row,.sheet-header{display:flex;justify-content:space-between;gap:20rpx}
.panel-title,.surface-title,.sheet-title{display:block;font-size:30rpx;line-height:1.25;font-weight:900}
.panel-kicker,.surface-kicker,.sheet-kicker{display:block;margin-top:6rpx;font-size:16rpx;line-height:1.2;letter-spacing:3rpx;font-weight:800}
.panel-collapse{flex-shrink:0;height:54rpx;display:flex;align-items:center;gap:7rpx;font-size:21rpx;font-weight:700}
.surface-action{flex-shrink:0;height:54rpx;display:flex;align-items:center;font-size:21rpx;font-weight:700}
.panel-collapse-arrow{font-size:22rpx;color:#151D17}
.setting-block{margin-top:30rpx}
.count-setting-block{padding-top:28rpx;border-top:1rpx solid #EDF0ED}
.setting-title{display:block;font-size:25rpx;line-height:1.3;font-weight:900}
.setting-desc{display:block;margin-top:5rpx;font-size:20rpx;line-height:1.4}
.mode-row,.count-row{margin-top:18rpx;display:flex}
.mode-card,.count-btn{position:relative;flex:1;min-width:0;border:1rpx solid transparent;transition:transform .15s ease,background .15s ease,color .15s ease}
.mode-card{min-height:150rpx;padding:20rpx 18rpx 18rpx;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}
.mode-title{display:block;margin-top:15rpx;font-size:23rpx;line-height:1.25;font-weight:900;white-space:nowrap}
.mode-desc{display:block;margin-top:6rpx;font-size:18rpx;line-height:1.2}
.option-check{position:absolute;right:10rpx;bottom:10rpx;width:32rpx;height:32rpx;border-radius:50%;font-size:20rpx;line-height:32rpx;text-align:center;font-weight:900}
.count-btn{min-height:102rpx;padding:20rpx 14rpx;display:flex;flex-direction:column;align-items:center;justify-content:center}
.count-main{font-size:27rpx;line-height:1.2;font-weight:900}
.count-time{margin-top:8rpx;font-size:18rpx;line-height:1.2}
.count-check{right:8rpx;bottom:8rpx}
.section-heading-row{padding:0 6rpx;align-items:center}
.surface-action{gap:5rpx}
.subject-sheet-layer{position:fixed;left:0;right:0;top:0;bottom:0;z-index:100;pointer-events:auto}
.subject-sheet-backdrop{position:absolute;left:0;right:0;top:0;bottom:0;animation:maskFadeIn .2s ease-out both}
@keyframes maskFadeIn{from{opacity:0}
to{opacity:1}
}
@keyframes maskFadeOut{from{opacity:1}
to{opacity:0}
}
.subject-sheet{position:absolute;left:0;right:0;bottom:0;width:100%;height:82vh;padding:12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box;animation:sheetUp .24s ease-out both;display:flex;flex-direction:column;overflow:hidden}
.subject-sheet-layer.closing{pointer-events:none}
.subject-sheet-layer.closing .subject-sheet-backdrop{animation:maskFadeOut .18s ease-in both}
.subject-sheet-layer.closing .subject-sheet{animation:sheetDown .18s ease-in both}
@keyframes sheetUp{from{transform:translateY(45rpx);opacity:.6}
to{transform:translateY(0);opacity:1}
}
@keyframes sheetDown{from{transform:translateY(0);opacity:1}
to{transform:translateY(36rpx);opacity:.76}
}
.sheet-handle{width:72rpx;height:8rpx;margin:2rpx auto 18rpx;border-radius:999rpx;flex-shrink:0}
.sheet-header{align-items:center;padding:0 4rpx;flex-shrink:0}
.sheet-close{width:62rpx;height:62rpx;border-radius:50%;background:#FFFFFF;border:1rpx solid #E4E8E4;color:#18211B;font-size:38rpx;line-height:60rpx;text-align:center;font-weight:400}
.sheet-section-label{display:block;font-size:23rpx;line-height:1.3;font-weight:900}
.all-subject-label{margin-top:24rpx;padding:0 4rpx 12rpx;flex-shrink:0}
.subject-tree-scroll{flex:1;height:0;min-height:0;width:100%;overflow:hidden}
.subject-empty{padding:56rpx 20rpx;text-align:center;display:flex;flex-direction:column;align-items:center;gap:8rpx}
.subject-empty-text{color:#58615A;font-size:25rpx;font-weight:900}
.subject-empty-hint{font-size:20rpx}
.subject-tree{padding-bottom:12rpx;display:flex;flex-direction:column;gap:12rpx}
.subject-parent-block{border-radius:22rpx;overflow:hidden;background:#FFFFFF;border:1rpx solid #E4E8E4}
.subject-parent-block.expanded{border-color:#CED5CE;box-shadow:0 8rpx 24rpx rgba(25,36,27,0.05)}
.subject-parent-row{min-height:86rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.parent-main{flex:1;min-width:0;display:flex;align-items:center;gap:14rpx}
.parent-folder{width:42rpx;height:42rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20rpx}
.subject-parent-row.selected .parent-folder{background:rgba(174,238,0,.12);color:#AEEE00}
.parent-copy{min-width:0;display:flex;flex-direction:column}
.parent-name{font-size:24rpx;line-height:1.25;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.parent-meta{margin-top:5rpx;font-size:18rpx;line-height:1.2}
.parent-right{display:flex;align-items:center;gap:12rpx;flex-shrink:0}
.parent-expand-hit{margin-right:-8rpx;border-radius:16rpx;flex-shrink:0}
.subject-parent-row.selected .parent-expand-hit{background:rgba(255,255,255,0.07)}
.parent-arrow{transition:transform .2s ease}
.child-subject-wrap{padding:6rpx 12rpx 12rpx 72rpx;border-top:1rpx solid #EEF1EE;background:#FBFCFA}
.child-subject-row{min-height:66rpx;padding:0 12rpx 0 16rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#4D574F}
.child-subject-row + .child-subject-row{border-top:1rpx solid #EFF2EF}
.child-subject-row.active{color:#172019}
.child-subject-name{min-width:0;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:22rpx;line-height:1.35;font-weight:700}
.child-select-mark{width:34rpx;height:34rpx;border-radius:50%;color:#142016;font-size:20rpx;line-height:34rpx;text-align:center;font-weight:900;flex-shrink:0}
.submit-loading-mask{position:fixed;inset:0;z-index:180;display:flex;align-items:center;justify-content:center;padding:32rpx;backdrop-filter:blur(16rpx);-webkit-backdrop-filter:blur(16rpx);box-sizing:border-box}
.submit-loading-card{position:relative;width:430rpx;padding:42rpx 36rpx 38rpx;border:1rpx solid rgba(255,255,255,.82);border-radius:38rpx;display:flex;flex-direction:column;align-items:center;overflow:hidden;box-sizing:border-box}
.submit-loading-card::before{content:'';position:absolute;top:0;left:0;right:0;height:8rpx}
.submit-loading-kicker{font-size:17rpx;line-height:1;font-weight:900;letter-spacing:3rpx}
.submit-loading-title{margin-top:8rpx;font-size:31rpx;line-height:1.35;font-weight:950;text-align:center}
.submit-loading-desc{margin-top:9rpx;font-size:22rpx;line-height:1.55;text-align:center}
.submit-loading-dots{margin-top:22rpx;display:flex;align-items:center;gap:9rpx}
.submit-loading-dots > view{width:8rpx;height:8rpx;border-radius:50%;animation:submitDot 1s ease-in-out infinite}
.submit-loading-dots > view:nth-child(2){animation-delay:.14s}
.submit-loading-dots > view:nth-child(3){animation-delay:.28s}
@keyframes submitDot{0%,100%{opacity:.28;transform:translateY(0)}
50%{opacity:1;transform:translateY(-7rpx)}
}
.loading-wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:180rpx 0;min-height:60vh}
.loading-wrap.launch-loading{min-height:100vh;box-sizing:border-box;padding:0 0 8vh}
@media (prefers-reduced-motion:reduce){.page{opacity:1 !important}
.practice-hero::before,.practice-hero::after,.subject-parent-row,.mode-card,.count-btn{animation:none !important;transition:none !important;transform:none !important}
}
.setup-content{padding:22rpx 24rpx calc(46rpx + env(safe-area-inset-bottom))}
.settings-panel{border-radius:34rpx}
.subject-sheet{border-radius:40rpx 40rpx 0 0}
.sheet-close{display:flex;align-items:center;justify-content:center}
.sheet-close .line-icon{width:28rpx;height:28rpx;color:#324239}
.practice{height:100vh;min-height:0;overflow:hidden;box-sizing:border-box}
.practice-runner{display:block;width:100%;height:100%;min-height:0}
@media (prefers-reduced-motion:reduce){.loading-wrap.launch-loading{animation:none}
}
/* Mint setup surface: a light, focused workspace before the question flow begins. */ page,.page{background:#F3FBF8;color:#23483C}
.setup{background:radial-gradient(circle at 92% 2%,rgba(126,216,181,.18) 0,rgba(126,216,181,0) 30%),linear-gradient(180deg,#F7FFFC 0%,#F0FAF6 100%)}
.setup-content{padding-top:18rpx}
.practice-hero{border-radius:32rpx;padding:32rpx 30rpx 24rpx;background:radial-gradient(circle at 88% 10%,rgba(126,216,181,.32) 0,rgba(126,216,181,0) 34%),linear-gradient(145deg,#EAF9F4 0%,#F8FFFC 76%,#FFFFFF 100%);color:#23483C;border:1rpx solid #D8EEE6;box-shadow:0 16rpx 36rpx rgba(43,117,91,.08)}
.practice-hero::after{border-color:rgba(126,216,181,.24);box-shadow:0 0 0 34rpx rgba(126,216,181,.06),0 0 0 68rpx rgba(126,216,181,.03)}
.hero-grid{opacity:0}
.hero-eyebrow{color:#3D9778}
.hero-subject{color:#23483C}
.hero-subject-arrow{border-color:#BEE8D7;color:#2F8066;background:rgba(255,255,255,.72)}
.hero-number{color:#3A6F5B}
.hero-number-unit{color:#35A880}
.hero-metric-label{color:#76968B}
.hero-metric-divider{background:#CBEDE0}
.wave-line{background:#7ED8B5}
.hero-start{background:#3A6F5B;color:#FFFFFF;border:1rpx solid #3A6F5B;box-shadow:0 10rpx 22rpx rgba(58,111,91,.16)}
.hero-start-arrow{background:#7ED8B5;color:#23483C}
.hero-start-pressed{background:#2F8066}
.hero-config{border-color:#CBEDE0;background:rgba(255,255,255,.72)}
.hero-config-text,.hero-config-edit{color:#4E7566}
.config-chevron{color:#55B990}
.settings-panel{border-color:#D8EEE6;background:rgba(255,255,255,.88);box-shadow:0 12rpx 30rpx rgba(43,117,91,.06)}
.panel-title,.surface-title,.sheet-title{color:#23483C}
.panel-kicker,.surface-kicker,.sheet-kicker{color:#78A193}
.panel-collapse,.surface-action{color:#3D8068}
.setting-title{color:#2D5D4C}
.mode-row,.count-row{gap:12rpx}
.mode-card,.count-btn{border-color:#D8EEE6;border-radius:20rpx;background:#F6FCF9}
.mode-card.active,.count-btn.active{border-color:#7ED8B5;background:#EAF9F4;box-shadow:inset 0 0 0 2rpx rgba(126,216,181,.18)}
.count-main{color:#3A6F5B}
.mode-title{color:#2D5D4C}
.recent-section{margin-top:28rpx}
.subject-sheet-backdrop{background:rgba(35,72,60,.42)}
.subject-sheet{background:#FBFFFD;box-shadow:0 -20rpx 48rpx rgba(43,117,91,.14)}
.sheet-handle{background:#B9DCCE}
.sheet-section-label,.parent-name{color:#2D5D4C}
.parent-meta,.child-subject-name,.subject-empty-hint{color:#7A978C}
.subject-parent-row,.child-subject-row{border-color:#E0F1EB}
.subject-parent-row.selected,.child-subject-row.active{background:#EAF9F4}
.parent-folder{background:#DDF6EC;color:#2F8066}
.parent-arrow{color:#55B990}
.child-select-mark{background:#55C89B}
.setup-error-card{background:#FFF6F3;border-color:#F0C3B9}
.setup-error-icon{color:#C36C5C}
.setup-error-text{color:#A85648}
.setup-error-retry{color:#FFFFFF;background:#B66758;border-radius:999rpx}
.submit-loading-mask{background:rgba(35,72,60,.3)}
.submit-loading-card{border-color:#D8EEE6;background:rgba(251,255,253,.98);box-shadow:0 24rpx 64rpx rgba(43,117,91,.18)}
.submit-loading-card::before{background:linear-gradient(90deg,#3A6F5B,#7ED8B5)}
.submit-loading-kicker{color:#3D8068}
.submit-loading-title{color:#23483C}
.submit-loading-desc{color:#78958A}
.submit-loading-dots > view{background:#3A6F5B}
.submit-loading-dots > view:nth-child(2){background:#7ED8B5}
.submit-loading-dots > view:nth-child(3){background:#55C89B}
.loading-wrap.launch-loading{background:radial-gradient(circle at 78% 18%,rgba(126,216,181,.18),transparent 34%),#F3FBF8}
.practice{background:#F3FBF8}
@media (prefers-reduced-motion:reduce){.practice-hero,.mode-card,.count-btn,.hero-start,.subject-sheet{transition:none !important}
}
/* Mint setup controls: optical centring is relative to the actual drawing box. */ .hero-subject-arrow,.hero-start-arrow,.config-chevron,.panel-collapse-arrow,.surface-action-arrow,.parent-expand-hit,.parent-arrow{display:inline-flex;align-items:center;justify-content:center;line-height:1;box-sizing:border-box}
.hero-subject-arrow{width:38rpx;height:38rpx;flex:0 0 38rpx;padding:0;border-radius:11rpx}
.hero-start{width:100%;margin-left:0;margin-right:0;line-height:1.4}
.hero-start-arrow{width:58rpx;height:58rpx;flex:0 0 58rpx;border-radius:50%}
.hero-start-arrow .line-icon{color:#23483C}
.config-chevron,.panel-collapse-arrow{width:26rpx;height:26rpx;flex:0 0 26rpx}
.config-chevron.up,.panel-collapse-arrow.up{transform:rotate(180deg)}
.surface-action-arrow{width:24rpx;height:24rpx;flex:0 0 24rpx}
.parent-expand-hit{width:68rpx;height:68rpx;flex:0 0 68rpx}
.parent-arrow{width:28rpx;height:28rpx;flex:0 0 28rpx;font-size:0}
.parent-arrow.up{transform:rotate(90deg)}
.parent-leaf-arrow{margin-left:40rpx}
.hero-subject-arrow.icon-chevron-right::before,.hero-start-arrow .icon-chevron-right::before,.surface-action-arrow.icon-chevron-right::before,.parent-arrow.icon-chevron-right::before{left:50%;top:50%;width:12rpx;height:12rpx;transform:translate(-65%,-50%) rotate(-45deg)}
.config-chevron.icon-chevron-down::before,.panel-collapse-arrow.icon-chevron-down::before{left:50%;top:50%;width:12rpx;height:12rpx;transform:translate(-50%,-65%) rotate(-45deg)}
.mode-card.active .mode-title,.count-btn.active .count-main{color:#23483C}
.mode-card.active .mode-desc,.count-btn.active .count-time{color:#507568}
.mode-desc,.count-time,.setting-desc{color:#507568}
.option-check,.count-check{display:flex;align-items:center;justify-content:center;background:#55C89B;color:#23483C}
.setting-check-icon{width:22rpx;height:22rpx}
.setting-check-icon.icon-check::before{left:50%;top:50%;width:7rpx;height:12rpx;transform:translate(-50%,-60%) rotate(45deg)}
.subject-parent-row.selected .parent-name,.subject-parent-row.selected .parent-arrow{color:#23483C}
.subject-parent-row.selected .parent-meta{color:#507568}
/* Reference plan 2: the setup summary is a single calm control row. */ .hero-config{min-height:82rpx;padding:0 18rpx 0 14rpx;border-radius:999rpx;display:flex;align-items:center;gap:14rpx;box-sizing:border-box;box-shadow:0 8rpx 24rpx rgba(43,117,91,.06)}
.hero-config-icon{width:56rpx;height:56rpx;flex:0 0 56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#EAF9F4}
.hero-config-icon image{width:30rpx;height:30rpx;display:block}
.hero-config-text{min-width:0;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:24rpx}
.hero-config-edit{display:inline-flex;align-items:center;gap:6rpx;padding:14rpx 18rpx;border-radius:999rpx;background:#DDF6EC;font-size:24rpx;font-weight:700;white-space:nowrap}
.mode-icon-image{width:42rpx;height:42rpx;display:block;flex:0 0 42rpx}
.subject-sheet-layer .subject-sheet{background:#FBFFFD;box-shadow:0 -18rpx 52rpx rgba(43,117,91,.14)}
.subject-sheet .sheet-title,.subject-sheet .parent-name,.subject-sheet .all-subject-label{color:#23483C}
.subject-sheet .sheet-kicker,.subject-sheet .parent-meta{color:#507568}
.subject-sheet .sheet-close,.subject-sheet .parent-folder{background:#EAF9F4;border-color:#D8EEE6}
.subject-sheet .all-subject-accent{background:#55C89B;box-shadow:none}
.subject-sheet .subject-parent-block{border-color:#D8EEE6;background:#FFFFFF}
.subject-sheet .subject-parent-block.expanded,.subject-sheet .subject-parent-row.selected,.subject-sheet .subject-parent-row.selected .parent-folder,.subject-sheet .child-subject-row.active{background:#EAF9F4}
.subject-sheet .subject-parent-row.selected .parent-name,.subject-sheet .subject-parent-row.selected .parent-arrow,.subject-sheet .child-subject-row.active{color:#23483C}
.subject-sheet .subject-parent-row.selected .parent-meta{color:#507568}
.subject-sheet .child-subject-wrap{background:#F3FBF8;border-color:#D8EEE6}
.subject-sheet .child-select-mark{background:#55C89B}
.subject-sheet .parent-arrow{color:#3A6F5B;font-size:0}
.reward-strip{margin-top:22rpx;padding:22rpx 24rpx;border:1rpx solid #DDE2DA;border-radius:30rpx;background:rgba(255,255,255,.82);display:flex;align-items:center;justify-content:space-between;gap:20rpx;box-shadow:0 10rpx 28rpx rgba(16,37,26,.045)}
.reward-strip-copy{min-width:0;flex:1}
.reward-strip-title{display:block;color:#17251B;font-size:26rpx;line-height:1.3;font-weight:900}
.reward-strip-desc{display:block;margin-top:6rpx;color:#7B867E;font-size:20rpx;line-height:1.4}
.reward-strip-items{flex-shrink:0;display:flex;align-items:center;min-width:250rpx}
.reward-strip-item{flex:1;min-width:0;text-align:center}
.reward-strip-label{display:block;color:#7A867D;font-size:18rpx;font-weight:750}
.reward-strip-value{display:block;margin-top:4rpx;color:#173426;font-size:25rpx;line-height:1.2;font-weight:950}
.reward-strip-text{font-size:21rpx;white-space:nowrap}
.reward-strip-divider{width:1rpx;height:44rpx;margin:0 14rpx;background:#DDE2DA}
.reward-strip{align-items:flex-start}
.reward-strip-desc{display:none}
.reward-strip-items{min-width:226rpx}
/* Recent subjects — single-row capsules; selection carries the state. */
.recent-section .surface-kicker{margin:0 0 6rpx;color:#4F8073;font-size:17rpx;font-weight:500;letter-spacing:2rpx}
.recent-section .surface-title{color:#23483C;font-size:30rpx;line-height:1.3}
.recent-scroll{margin-top:14rpx;width:100%;white-space:nowrap;overflow:hidden}
.recent-list{display:inline-flex;gap:14rpx;padding:2rpx 2rpx 16rpx}
.recent-card{position:relative;box-sizing:border-box;width:280rpx;height:88rpx;padding:12rpx 16rpx;display:inline-flex;align-items:center;gap:12rpx;overflow:hidden;border:1rpx solid #DCEEE6;border-radius:999rpx;background:#FAFFFD;box-shadow:none;transition:transform 150ms cubic-bezier(.16,1,.3,1),opacity 150ms ease}
.recent-card.active{border-color:transparent;background:linear-gradient(115deg,#245D4D,#438F78)}
.recent-mark{width:48rpx;height:48rpx;border-radius:50%;background:#E3F5EE;color:#245D4D;font-size:23rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1;font-weight:700}
.recent-card.active .recent-mark{background:rgba(126,216,181,.22);color:#FFF}
.recent-subject-icon{width:28rpx;height:28rpx}
.recent-card.active .recent-subject-icon{filter:brightness(0) invert(1)}
.recent-card-copy{flex:1;min-width:0}
.recent-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#23483C;font-size:24rpx;line-height:1.4;font-weight:600}
.recent-card.active .recent-name{color:#FFF}
.recent-arrow-line::after{content:'';position:absolute;right:0;top:-5rpx;width:10rpx;height:10rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor;transform:rotate(45deg)}
.recent-card.recent-card-pressed{opacity:.9;transform:scale(.98)}
@media (prefers-reduced-motion:reduce){.recent-card,.recent-card.recent-card-pressed{transition:none;transform:none}}
