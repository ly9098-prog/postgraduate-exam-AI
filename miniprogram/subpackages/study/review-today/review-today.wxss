/* Review overview, context strip and runner now use the same mint-white study
   surface as practice; correctness colors stay semantic. */
.reviewing-page, .review-practice-content { background:#F3FBF8; }
.review-context-bar { background:#EAF9F4; color:#507568; border-top-color:#D8EEE6; }

.reviewing-page { display:flex; flex-direction:column; min-height:0; overflow:hidden; box-sizing:border-box; }
.review-context-bar { flex:0 0 58rpx; box-sizing:border-box; }
.review-practice-content { flex:1; height:0; min-height:0; overflow:hidden; }
.review-practice-content quiz-runner { display:block; width:100%; height:100%; min-height:0; }

/* Overview, completion, empty/error and bottom decisions share study tokens.
   Red/orange correctness and warning states are intentionally not recolored. */
page, .page, .overview-page, .empty-page { background:#F3FBF8; color:#23483C; }
.page-title, .section-title, .decision-title, .batch-sheet-title { color:#23483C; }
.page-intro, .decision-desc, .batch-sheet-desc { color:#507568; }
.mission-panel, .result-celebrate-card { background:linear-gradient(145deg, #EAF9F4, #DDF6EC); color:#23483C; box-shadow:0 16rpx 36rpx rgba(43,117,91,.08); }
.mission-eyebrow, .mission-unit, .result-kicker, .result-score-unit { color:#2F8066; }
.mission-number, .result-score-num, .result-title, .result-score-label { color:#23483C; }
.mission-label, .mission-batch-link, .mission-meta-line, .result-desc, .result-score-note, .result-stat { color:#507568; }
.mission-meta-dot { background:#9ACABA; }
.result-stat-strip { border-color:#CBEDE0; }
.result-stat-value { color:#23483C; }
.result-stat-value.success { color:#2F8066; }
.result-stat-value.danger { color:#B66758; }
.result-stat-value.muted { color:#507568; }
.primary-action, .result-complete-primary, .decision-primary, .batch-sheet-confirm {
  background:#3A6F5B; background-image:none; color:#FFFFFF;
  box-shadow:0 10rpx 24rpx rgba(58,111,91,.15);
}
.primary-action-arrow { background:#7ED8B5; color:#23483C; }
.secondary-action, .empty-secondary-action { color:#3A6F5B; border-color:#B7EBD9; }
.result-complete-secondary, .decision-secondary, .batch-sheet-cancel { background:#EAF9F4; color:#3A6F5B; }
.modal-overlay, .batch-sheet-mask { background:rgba(35,72,60,.42); }
.decision-sheet, .batch-sheet, .result-complete-actions { background:#FBFFFD; box-shadow:0 -18rpx 48rpx rgba(43,117,91,.14); }
.sheet-handle, .batch-sheet-handle { background:#B9DCCE; }
.batch-size-option { background:#FFFFFF; border-color:#D8EEE6; }
.batch-size-option.is-current { background:#F3FBF8; border-color:#7ED8B5; }
.batch-size-option.is-pending { background:#EAF9F4; background-image:none; border-color:#55C89B; box-shadow:0 6rpx 18rpx rgba(58,111,91,.07); }
.batch-size-check, .batch-size-badge { background:#55C89B; color:#23483C; }
.batch-size-option.is-pending .batch-size-label, .batch-size-option.is-pending .batch-size-unit { color:#3A6F5B; }
.batch-size-num { color:#23483C; }
.batch-size-unit, .batch-size-label, .batch-sheet-current-hint { color:#507568; }
.batch-loading-shell { background:#F3FBF8; }
.batch-loading-head { background:#EAF9F4; }
.batch-loading-tag, .batch-loading-line, .batch-loading-option { background:#E3F3EC; }
.loading-mark .line-3, .trail-node, .trail-node.active { background:#55C89B; }
.loading-mark .d-4 { border-color:#55C89B; box-shadow:0 0 0 14rpx rgba(126,216,181,.12); }
.trail-arc, .trail-focus-ring { border-color:rgba(85,200,155,.2); }
.trail-node.active { box-shadow:0 0 0 8rpx rgba(126,216,181,.11); }
.undo-action { color:#7ED8B5; }
.review-context-group { color:#2F8066; }
.cs-4 { background:#55C89B; }
.curve-node.active { border-color:#55C89B; box-shadow:0 0 0 10rpx rgba(126,216,181,.12); }

/* Exit confirmation: centred copy and a calmer, roomier action area. */
.exit-confirm-sheet { padding-top:22rpx; padding-bottom:calc(34rpx + env(safe-area-inset-bottom)); text-align:center; }
.exit-confirm-sheet .sheet-handle { margin-bottom:24rpx; }
.exit-confirm-sheet .decision-kicker { color:#3A8C72; }
.exit-confirm-sheet .decision-title { margin-top:10rpx; }
.exit-confirm-sheet .decision-desc { max-width:560rpx; margin:14rpx auto 0; }
.exit-confirm-sheet .decision-actions { margin-top:30rpx; gap:16rpx; }
.exit-confirm-sheet .decision-primary,
.exit-confirm-sheet .decision-secondary { min-height:88rpx; border-radius:22rpx; }
