@import '../../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  color: #15231A;
  overflow-x: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.page {
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  background: #F4F4EE;
}

.page-ambient {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.ambient-one {
  width: 340rpx;
  height: 340rpx;
  right: -170rpx;
  top: 150rpx;
  background: rgba(187, 215, 169, 0.28);
}

.ambient-two {
  width: 250rpx;
  height: 250rpx;
  left: -130rpx;
  bottom: 150rpx;
  background: rgba(235, 215, 171, 0.28);
}

.motion-page-enter { animation: premiumEnter 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }

/* loading */
.state-page {
  padding: 90rpx 30rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-shell,
.state-shell {
  width: 100%;
  max-width: 650rpx;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.loading-mark {
  width: 280rpx;
  height: 170rpx;
  position: relative;
  margin-bottom: 42rpx;
}

.memory-line,
.curve-segment,
.memory-update-line,
.clear-line {
  position: absolute;
  height: 5rpx;
  border-radius: 999rpx;
  transform-origin: left center;
}

.loading-mark .memory-line { background: #173426; }
.loading-mark .line-1 { width: 78rpx; left: 22rpx; top: 112rpx; transform: rotate(-28deg); }
.loading-mark .line-2 { width: 82rpx; left: 88rpx; top: 76rpx; transform: rotate(17deg); }
.loading-mark .line-3 { width: 90rpx; left: 162rpx; top: 99rpx; transform: rotate(-34deg); background: #A9D800; }

.memory-dot {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  margin: -11rpx 0 0 -11rpx;
  border-radius: 50%;
  background: #F4F4EE;
  border: 6rpx solid #173426;
  box-sizing: border-box;
}
.loading-mark .d-1 { left: 24rpx; top: 113rpx; }
.loading-mark .d-2 { left: 94rpx; top: 77rpx; }
.loading-mark .d-3 { left: 168rpx; top: 100rpx; }
.loading-mark .d-4 { left: 246rpx; top: 48rpx; border-color: #A9D800; box-shadow: 0 0 0 14rpx rgba(169,216,0,0.12); }

.loading-title { font-size: 36rpx; font-weight: 900; line-height: 1.35; color: #15231A; }
.loading-desc { margin-top: 12rpx; font-size: 25rpx; color: #748077; line-height: 1.5; }
.loading-bars { width: 420rpx; margin-top: 44rpx; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.loading-bar { height: 18rpx; border-radius: 999rpx; background: linear-gradient(90deg, #E4E7DF, #F2F3EE, #E4E7DF); animation: skeletonPulse 1.2s ease-in-out infinite; }
.loading-bar.long { width: 100%; }
.loading-bar.medium { width: 78%; animation-delay: .1s; }
.loading-bar.short { width: 52%; animation-delay: .2s; }

/* overview */
.overview-page {
  padding: 28rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 66%, rgba(183, 232, 42, .035), rgba(183, 232, 42, 0) 30%),
    #F7F7F2;
}

/*
 * 方案 A：记忆轨迹背景。
 * 轨迹从主按钮右侧自然进入下半屏，再向左侧的“记忆节点”收束，
 * 最后继续向右下方延展。装饰层只存在于内容之后，不参与交互。
 */
.overview-ambient {
  position: absolute;
  left: 0;
  right: 0;
  top: 615rpx;
  bottom: 0;
  min-height: 640rpx;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.overview-memory-trail {
  position: absolute;
  inset: 0;
  opacity: .92;
}

/* 用低对比度椭圆弧拼出连续的 S 型记忆轨迹，避免折线感过强 */
.trail-arc {
  position: absolute;
  box-sizing: border-box;
  border: 2rpx solid rgba(142, 184, 41, .18);
  border-radius: 50%;
}

.ta-1 {
  width: 470rpx;
  height: 320rpx;
  right: -206rpx;
  top: -130rpx;
  border-left-color: transparent;
  border-top-color: transparent;
  transform: rotate(18deg);
}

.ta-2 {
  width: 560rpx;
  height: 330rpx;
  left: -158rpx;
  top: 112rpx;
  border-left-color: transparent;
  border-bottom-color: transparent;
  transform: rotate(-16deg);
}

.ta-3 {
  width: 520rpx;
  height: 300rpx;
  left: 78rpx;
  top: 356rpx;
  border-right-color: transparent;
  border-top-color: transparent;
  transform: rotate(11deg);
}

.trail-node {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  margin: -6rpx 0 0 -6rpx;
  border-radius: 50%;
  box-sizing: border-box;
  background: #98C817;
  border: 2rpx solid rgba(247, 247, 242, .94);
  box-shadow: 0 0 0 2rpx rgba(133, 177, 33, .08);
}

.tn-1 { right: 48rpx; top: 62rpx; opacity: .78; }
.tn-2 { right: 174rpx; top: 158rpx; opacity: .68; }
.tn-3 { left: 322rpx; top: 236rpx; opacity: .76; }
.tn-4 { left: 154rpx; top: 344rpx; }
.tn-5 { left: 316rpx; top: 432rpx; opacity: .84; }
.tn-6 { left: 470rpx; top: 510rpx; opacity: .64; }

.trail-node.active {
  width: 30rpx;
  height: 30rpx;
  margin: -15rpx 0 0 -15rpx;
  border: 4rpx solid rgba(247, 247, 242, .98);
  background: #9FD20D;
  box-shadow: 0 0 0 8rpx rgba(183, 232, 42, .11), 0 0 34rpx rgba(151, 204, 0, .22);
  animation: overviewTrailPulse 3.1s ease-in-out infinite;
}

.trail-focus-ring {
  position: absolute;
  left: 154rpx;
  top: 344rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 2rpx solid rgba(151, 204, 0, .15);
  transform: translate(-50%, -50%);
}

.trail-focus-ring.ring-inner {
  width: 72rpx;
  height: 72rpx;
  animation: overviewMemoryRing 4.6s ease-in-out infinite;
}

.trail-focus-ring.ring-outer {
  width: 126rpx;
  height: 126rpx;
  border-color: rgba(151, 204, 0, .10);
  animation: overviewMemoryRing 4.6s .3s ease-in-out infinite reverse;
}

.overview-shell {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 694rpx;
  margin: 0 auto;
}

.overview-heading {
  padding: 10rpx 8rpx 26rpx;
}

.page-kicker,
.result-kicker,
.state-kicker,
.section-kicker,
.decision-kicker,
.mission-eyebrow {
  display: block;
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  line-height: 1.35;
}

.page-kicker { color: #748077; }

.page-title {
  display: block;
  margin-top: 16rpx;
  max-width: 610rpx;
  font-size: 48rpx;
  font-weight: 950;
  line-height: 1.16;
  letter-spacing: -1rpx;
  color: #132118;
}

.page-intro {
  display: block;
  margin-top: 14rpx;
  max-width: 610rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: #68756C;
}

.mission-panel {
  position: relative;
  overflow: hidden;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 84% 42%, rgba(183, 232, 42, .055), rgba(183, 232, 42, 0) 28%),
    linear-gradient(145deg, #183528 0%, #10251A 66%, #0D2016 100%);
  color: #FFFFFF;
  box-shadow: 0 20rpx 46rpx rgba(16, 37, 26, .17);
}

.mission-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.mission-eyebrow {
  color: #B7E82A;
}

.mission-label {
  display: block;
  margin-top: 7rpx;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 750;
  color: rgba(255, 255, 255, .62);
}

.mission-batch-link {
  margin-top: 1rpx;
  padding: 6rpx 2rpx 8rpx 12rpx;
  font-size: 19rpx;
  line-height: 1.35;
  font-weight: 750;
  color: rgba(255, 255, 255, .50);
  white-space: nowrap;
}

.mission-batch-link-pressed {
  opacity: .55;
}

.mission-main {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.mission-number-wrap {
  display: flex;
  align-items: baseline;
  min-width: 0;
  line-height: 1;
}

.mission-number {
  font-size: 112rpx;
  line-height: .94;
  font-weight: 950;
  letter-spacing: -6rpx;
  font-variant-numeric: tabular-nums;
  color: #FFFFFF;
}

.mission-unit {
  margin-left: 9rpx;
  font-size: 27rpx;
  font-weight: 900;
  color: #B7E82A;
}

/* 卡片内曲线沿用同一套“记忆轨迹”语言，但保持克制，不抢主数字 */
.curve-stage {
  position: relative;
  width: 238rpx;
  height: 112rpx;
  flex-shrink: 0;
  opacity: .82;
}

.curve-axis {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 13rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, .11);
}

.curve-segment {
  position: absolute;
  height: 4rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .50);
  transform-origin: left center;
}

.cs-1 { width: 50rpx; left: 8rpx; top: 78rpx; transform: rotate(-30deg); }
.cs-2 { width: 54rpx; left: 52rpx; top: 53rpx; transform: rotate(24deg); }
.cs-3 { width: 58rpx; left: 102rpx; top: 74rpx; transform: rotate(-34deg); }
.cs-4 { width: 66rpx; left: 151rpx; top: 42rpx; transform: rotate(18deg); background: #B7E82A; }

.curve-node {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #10251A;
  border: 4rpx solid rgba(255, 255, 255, .68);
  box-sizing: border-box;
}

.cn-1 { left: 7rpx; top: 74rpx; }
.cn-2 { left: 52rpx; top: 50rpx; }
.cn-3 { left: 103rpx; top: 70rpx; }
.cn-4 { left: 153rpx; top: 39rpx; }

.curve-node.active {
  border-color: #B7E82A;
  box-shadow: 0 0 0 10rpx rgba(183, 232, 42, .10);
}

.mission-meta-line {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .10);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, .52);
  font-variant-numeric: tabular-nums;
}

.mission-meta-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .25);
  flex-shrink: 0;
}

.mission-meta-alert {
  color: #E9A481;
}

.overview-note {
  margin: 20rpx 8rpx 0;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.overview-note-label {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 1.5;
  font-weight: 850;
  color: #89938C;
}

.overview-note-text {
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.55;
  color: #758179;
}

.primary-action {
  width: 100%;
  min-height: 94rpx;
  margin-top: 24rpx;
  padding: 0 24rpx 0 32rpx;
  border-radius: 24rpx;
  border: none;
  background: linear-gradient(100deg, #A9E90C 0%, #BDF22A 100%);
  color: #10251A;
  box-shadow: 0 16rpx 32rpx rgba(103,139,0,.18);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.2;
  transition: transform .15s ease, opacity .15s ease;
}

/*
 * 主按钮放在 overview-shell 外层的独立 dock 中。
 * overview-shell 有入场 transform 动画；若 fixed 按钮放在该容器内部，
 * iOS / 微信 WebView 会将它以动画容器为定位参照，出现真机上浮并覆盖任务卡。
 */
.overview-action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 8;
  padding: 0 28rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.overview-primary-action {
  position: relative;
  width: 72%;
  max-width: 520rpx;
  min-width: 0;
  margin: 0;
  pointer-events: auto;
}

.overview-primary-action.primary-action-pressed {
  transform: scale(.985);
}

.primary-action[disabled] { opacity: .46; }
.primary-action-pressed { transform: scale(.985); opacity: .88; }
.primary-action-arrow {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: #10251A;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}
.secondary-action { width: 100%; min-height: 86rpx; margin-top: 12rpx; border-radius: 22rpx; background: transparent; border: 1rpx solid #CDD2C9; color: #173426; font-size: 27rpx; font-weight: 850; }
.secondary-action-pressed { background: #E9ECE5; }

/* reviewing */
.reviewing-page { background: #F4F5F1; overflow: visible; }
.review-context-bar { height: 58rpx; padding: 0 25rpx; display: flex; align-items: center; justify-content: space-between; background: #10251A; color: rgba(255,255,255,.64); border-top: 1rpx solid rgba(255,255,255,.06); font-size: 20rpx; font-weight: 750; }
.review-context-group { color: #B7E82A; letter-spacing: 1rpx; }
.review-practice-content { min-height: calc(100vh - 58rpx); }
.batch-loading-shell { min-height: 75vh; background: #F4F5F1; }
.batch-loading-head { height: 230rpx; background: linear-gradient(145deg,#183528,#10251A); }
.batch-loading-card { margin: -20rpx 24rpx 0; padding: 30rpx 26rpx; border-radius: 28rpx; background: #FFFFFF; border: 1rpx solid #E0E5DE; }
.batch-loading-tag { width: 110rpx; height: 28rpx; border-radius: 8rpx; background: #E9EEE6; animation: skeletonPulse 1.2s ease-in-out infinite; }
.batch-loading-line { height: 24rpx; margin-top: 22rpx; border-radius: 999rpx; background: #E9EEE6; animation: skeletonPulse 1.2s ease-in-out infinite; }
.batch-loading-line.long { width: 92%; }
.batch-loading-line.medium { width: 68%; }
.batch-loading-option { height: 84rpx; margin-top: 16rpx; border-radius: 18rpx; background: #F0F2ED; border: 1rpx solid #E4E8E1; animation: skeletonPulse 1.2s ease-in-out infinite; }

/* group result */
.result-page { padding: 28rpx 26rpx calc(54rpx + env(safe-area-inset-bottom)); overflow: visible; }
.result-shell { max-width: 700rpx; margin: 0 auto; }
.result-celebrate-card { position: relative; overflow: hidden; padding: 34rpx 30rpx; border-radius: 34rpx; background: #153323; color: #FFFFFF; box-shadow: 0 22rpx 48rpx rgba(16,37,26,.16); }
.result-orbit { position: absolute; width: 270rpx; height: 270rpx; right: -100rpx; top: -92rpx; border-radius: 50%; border: 1rpx solid rgba(183,232,42,.16); box-shadow: 0 0 0 42rpx rgba(183,232,42,.025); }
.result-kicker { color: #B7E82A; position: relative; }
.result-title { display: block; position: relative; margin-top: 12rpx; font-size: 44rpx; line-height: 1.2; font-weight: 950; }
.result-desc { display: block; position: relative; margin-top: 12rpx; font-size: 24rpx; line-height: 1.55; color: rgba(255,255,255,.62); }
.result-score-row { position: relative; margin-top: 30rpx; display: flex; align-items: flex-end; gap: 22rpx; }
.result-score-main { display: flex; align-items: baseline; line-height: 1; }
.result-score-num { font-size: 92rpx; font-weight: 950; letter-spacing: -5rpx; }
.result-score-unit { font-size: 28rpx; font-weight: 850; color: #B7E82A; }
.result-score-copy { padding-bottom: 8rpx; }
.result-score-label { display: block; font-size: 22rpx; font-weight: 850; }
.result-score-note { display: block; margin-top: 6rpx; max-width: 310rpx; font-size: 20rpx; line-height: 1.45; color: rgba(255,255,255,.54); }
.result-stat-strip { position: relative; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.10); display: grid; grid-template-columns: repeat(3,1fr); }
.result-stat { display: flex; flex-direction: column; align-items: center; gap: 7rpx; color: rgba(255,255,255,.54); font-size: 19rpx; }
.result-stat-value { font-size: 33rpx; font-weight: 950; color: #FFFFFF; }
.result-stat-value.success { color: #7ED09D; }
.result-stat-value.danger { color: #E9917D; }
.result-stat-value.muted { color: #C4CCC5; }

.memory-update-card,
.wrong-summary-card,
.all-clear-card,
.detail-fold-card { margin-top: 18rpx; border-radius: 26rpx; border: 1rpx solid #E0E3DC; background: #FBFBF7; box-shadow: 0 10rpx 28rpx rgba(23,52,38,.055); }
.memory-update-card { padding: 24rpx; display: flex; align-items: center; gap: 18rpx; background: #E8ECDf; }
.memory-update-icon { width: 68rpx; height: 56rpx; position: relative; flex-shrink: 0; }
.memory-update-line { height: 4rpx; background: #173426; }
.memory-update-line.l1 { width: 22rpx; left: 3rpx; top: 35rpx; transform: rotate(-32deg); }
.memory-update-line.l2 { width: 23rpx; left: 22rpx; top: 23rpx; transform: rotate(24deg); }
.memory-update-line.l3 { width: 27rpx; left: 42rpx; top: 31rpx; transform: rotate(-38deg); background: #91B600; }
.memory-update-title { display: block; font-size: 27rpx; font-weight: 900; color: #173426; }
.memory-update-desc { display: block; margin-top: 5rpx; font-size: 21rpx; line-height: 1.5; color: #788279; }
.wrong-summary-card { padding: 26rpx; }
.section-heading-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.section-kicker { color: #B76838; }
.section-title { display: block; margin-top: 6rpx; font-size: 32rpx; font-weight: 950; color: #17251B; }
.section-count { padding: 8rpx 14rpx; border-radius: 999rpx; background: #F3E4DC; color: #AF5730; font-size: 20rpx; font-weight: 850; }
.wrong-summary-item { display: flex; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid #E8EAE4; }
.wrong-summary-item:last-child { border-bottom: none; padding-bottom: 0; }
.wrong-summary-index { width: 42rpx; height: 42rpx; border-radius: 50%; background: #F2E2DB; color: #B05A35; display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 900; flex-shrink: 0; }
.wrong-summary-body { min-width: 0; flex: 1; }
.wrong-summary-stem { max-height: 108rpx; overflow: hidden; font-size: 25rpx; line-height: 1.55; color: #243229; }
.wrong-summary-answer { display: block; margin-top: 10rpx; font-size: 20rpx; color: #B05A35; }
.all-clear-card { padding: 25rpx; display: flex; align-items: center; gap: 18rpx; }
.all-clear-mark { width: 62rpx; height: 62rpx; border-radius: 50%; background: #DCEBDD; color: #246541; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: 900; flex-shrink: 0; }
.all-clear-title { display: block; font-size: 27rpx; font-weight: 900; color: #173426; }
.all-clear-desc { display: block; margin-top: 5rpx; font-size: 21rpx; color: #788279; }
.detail-fold-card { overflow: hidden; }
.detail-fold-trigger { min-height: 100rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.detail-fold-trigger-pressed { background: #F0F2ED; }
.detail-fold-title { display: block; font-size: 25rpx; font-weight: 900; color: #27352B; }
.detail-fold-desc { display: block; margin-top: 5rpx; font-size: 20rpx; color: #8B948D; }
.detail-fold-arrow { font-size: 34rpx; color: #617067; transition: transform .2s ease; }
.detail-fold-arrow.open { transform: rotate(180deg); }
.detail-list { padding: 0 22rpx 12rpx; border-top: 1rpx solid #E8EAE4; }
.detail-item { display: flex; align-items: flex-start; gap: 12rpx; padding: 20rpx 0; border-bottom: 1rpx solid #ECEEE9; }
.detail-item:last-child { border-bottom: none; }
.detail-status-dot { width: 14rpx; height: 14rpx; margin-top: 10rpx; border-radius: 50%; background: #9AA39C; flex-shrink: 0; }
.detail-item.is-correct .detail-status-dot { background: #2F9A61; }
.detail-item.is-wrong .detail-status-dot { background: #C7624D; }
.detail-item-body { min-width: 0; flex: 1; }
.detail-stem { max-height: 94rpx; overflow: hidden; font-size: 23rpx; line-height: 1.5; color: #344139; }
.detail-answer { display: block; margin-top: 7rpx; font-size: 19rpx; color: #A45A45; }
.detail-status-text { flex-shrink: 0; font-size: 19rpx; font-weight: 800; color: #849087; }
.result-next { margin-top: 20rpx; }
.result-complete-bottom-space { height: calc(176rpx + env(safe-area-inset-bottom)); }
.result-complete-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 60;
  width: calc(100% - 64rpx);
  max-width: 686rpx;
  min-width: 0;
  min-height: 112rpx;
  margin: 0 auto;
  padding: 10rpx;
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(22, 47, 34, .08);
  border-radius: 34rpx;
  background: rgba(251, 251, 247, .96);
  box-shadow: 0 20rpx 50rpx rgba(16, 37, 26, .18), 0 2rpx 8rpx rgba(16, 37, 26, .05);
  box-sizing: border-box;
  opacity: 1;
  transform: translateY(0);
  transition: opacity .28s ease, transform .28s ease;
  will-change: opacity, transform;
}
.result-complete-actions.is-hidden {
  opacity: 0;
  transform: translateY(22rpx);
  pointer-events: none;
}
.result-complete-actions.is-visible {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.result-complete-primary,
.result-complete-secondary {
  flex: 1 1 0%;
  width: 0;
  min-width: 0;
  max-width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0 16rpx;
  border: 0;
  border-radius: 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 900;
}
.result-complete-primary::after,
.result-complete-secondary::after { border: 0; }
.result-complete-primary {
  background: #B7E82A;
  color: #10251A;
  box-shadow: 0 8rpx 20rpx rgba(169, 216, 0, .16);
}
.result-complete-secondary {
  background: #F0F2ED;
  color: #415047;
}
.result-complete-pressed { opacity: .78; }

/* empty/error */
.state-visual { width: 280rpx; height: 220rpx; position: relative; margin-bottom: 36rpx; }
.clear-ring { position: absolute; border-radius: 50%; border: 1rpx solid #BBC5B9; }
.ring-one { width: 180rpx; height: 180rpx; left: 50rpx; top: 18rpx; }
.ring-two { width: 124rpx; height: 124rpx; left: 78rpx; top: 46rpx; border-color: #D7DDD3; }
.clear-check { position: absolute; width: 94rpx; height: 94rpx; left: 93rpx; top: 61rpx; border-radius: 50%; background: #173426; color: #B7E82A; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 900; box-shadow: 0 18rpx 36rpx rgba(23,52,38,.18); }
.clear-line { background: #8B9D89; height: 4rpx; }
.cl-1 { width: 54rpx; left: 12rpx; top: 118rpx; transform: rotate(-24deg); }
.cl-2 { width: 50rpx; right: 4rpx; top: 78rpx; transform: rotate(18deg); background: #B7E82A; }
.cl-3 { width: 46rpx; right: 24rpx; bottom: 28rpx; transform: rotate(-18deg); }
.state-kicker { color: #73806F; }
.state-kicker.danger { color: #B65A47; }
.state-title { display: block; margin-top: 13rpx; font-size: 42rpx; line-height: 1.25; font-weight: 950; color: #142219; }
.state-desc { display: block; margin-top: 14rpx; max-width: 580rpx; font-size: 25rpx; line-height: 1.65; color: #727D75; }
.empty-status-row { width: 100%; margin-top: 32rpx; padding: 22rpx 0; border-radius: 24rpx; background: #FBFBF7; border: 1rpx solid #E0E3DC; display: grid; grid-template-columns: 1fr 1rpx 1fr; align-items: center; }
.empty-status-row > view:not(.empty-status-divider) { display: flex; flex-direction: column; gap: 7rpx; color: #859087; font-size: 20rpx; }
.empty-status-value { color: #173426; font-size: 25rpx; font-weight: 900; }
.empty-status-divider { width: 1rpx; height: 48rpx; background: #E0E3DC; }
.error-mark { width: 106rpx; height: 106rpx; margin-bottom: 30rpx; border-radius: 32rpx; background: #F0DED8; color: #B55B48; display: flex; align-items: center; justify-content: center; font-size: 55rpx; font-weight: 950; }

/* modal and undo */
.modal-overlay { position: fixed; inset: 0; z-index: 120; display: flex; align-items: flex-end; justify-content: center; background: rgba(5,13,8,.60); }
.decision-sheet { width: 100%; padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #FBFBF7; box-shadow: 0 -24rpx 60rpx rgba(0,0,0,.18); animation: sheetRise .22s ease-out both; }
.sheet-handle { width: 72rpx; height: 7rpx; margin: 0 auto 27rpx; border-radius: 999rpx; background: #D1D6CE; }
.decision-kicker { color: #73806F; }
.decision-title { display: block; margin-top: 9rpx; font-size: 38rpx; font-weight: 950; line-height: 1.25; color: #142219; }
.decision-desc { display: block; margin-top: 13rpx; font-size: 24rpx; line-height: 1.65; color: #707B73; }
.decision-actions { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.decision-primary,
.decision-secondary { min-height: 84rpx; border-radius: 21rpx; font-size: 26rpx; font-weight: 900; }
.decision-primary { background: #B7E82A; color: #10251A; }
.decision-secondary { background: #ECEFE8; color: #445249; }
.undo-toast { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); z-index: 150; min-height: 84rpx; padding: 0 22rpx; border-radius: 22rpx; background: #10251A; color: #FFFFFF; display: flex; align-items: center; transform: translateY(150%); opacity: 0; pointer-events: none; transition: transform .22s ease, opacity .22s ease; box-shadow: 0 18rpx 42rpx rgba(16,37,26,.26); }
.undo-toast.show { transform: translateY(0); opacity: 1; pointer-events: auto; }
.undo-toast-text { min-width: 0; flex: 1; font-size: 22rpx; line-height: 1.4; color: rgba(255,255,255,.78); }
.undo-divider { width: 1rpx; height: 36rpx; margin: 0 18rpx; background: rgba(255,255,255,.14); }
.undo-action { flex-shrink: 0; font-size: 24rpx; font-weight: 900; color: #B7E82A; }

@keyframes overviewTrailPulse {
  0%, 100% {
    transform: scale(.94);
    box-shadow: 0 0 0 7rpx rgba(183, 232, 42, .09), 0 0 24rpx rgba(151, 204, 0, .14);
  }
  50% {
    transform: scale(1.08);
    box-shadow: 0 0 0 18rpx rgba(183, 232, 42, 0), 0 0 38rpx rgba(151, 204, 0, .24);
  }
}

@keyframes overviewMemoryRing {
  0%, 100% { opacity: .56; transform: translate(-50%, -50%) scale(.96); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.06); }
}

@keyframes premiumEnter { from { opacity: 0; transform: translateY(22rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes skeletonPulse { 0%,100% { opacity: .52; } 50% { opacity: 1; } }
@keyframes sheetRise { from { transform: translateY(42rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

@media (max-width: 360px) {
  .page-title { font-size: 45rpx; }
  .mission-number { font-size: 102rpx; }
  .curve-stage { width: 214rpx; transform: scale(.92); transform-origin: right center; }
  .overview-primary-action { width: 76%; min-width: 0; }
  .overview-ambient { top: 600rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .motion-page-enter,
  .loading-bar,
  .batch-loading-tag,
  .batch-loading-line,
  .batch-loading-option,
  .decision-sheet,
  .trail-node.active,
  .trail-focus-ring { animation: none !important; }
  .detail-fold-arrow,
  .undo-toast,
  .primary-action { transition: none !important; }
}


/* ==================== 每组题数底部弹层 ==================== */

.batch-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(4, 20, 13, 0.58);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  animation: batchMaskIn 200ms ease-out both;
}

.batch-sheet {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  margin: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  padding: 14rpx 28rpx 28rpx;
  border-radius: 40rpx;
  background: #f7f8f1;
  box-shadow: 0 24rpx 64rpx rgba(4, 22, 14, 0.24);
  animation: batchSheetIn 240ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.batch-sheet-handle {
  width: 72rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #D1D6CE;
}

/* 标题区域 */
.batch-sheet-head { margin-bottom: 24rpx; padding: 0 4rpx; }
.batch-sheet-kicker {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2.6rpx;
  color: #748077;
}
.batch-sheet-title {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 950;
  line-height: 1.2;
  color: #132118;
}
.batch-sheet-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #6C786F;
}

/* 选项网格：两列 */
.batch-size-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.batch-size-option {
  position: relative;
  min-height: 128rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #FBFBF7;
  border: 2rpx solid #E0E3DC;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  transition: transform 0.12s ease, border-color 0.12s ease, background 0.12s ease;
}

.batch-size-option:active {
  transform: scale(0.97);
}

/* 临时选中态 */
.batch-size-option.is-pending {
  background: linear-gradient(135deg, #a9ef12, #c9f83c);
  background-color: #b8f21c;
  border-color: #8bcb00;
  border-width: 3rpx;
  box-shadow: 0 6rpx 20rpx rgba(169, 216, 0, 0.20);
}

/* 当前生效但未临时选择 */
.batch-size-option.is-current {
  border-color: #b8f21c;
  border-width: 3rpx;
  background: #F3F8E8;
}

.batch-size-option-top {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}

.batch-size-num {
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1;
  color: #132118;
  font-variant-numeric: tabular-nums;
}

.batch-size-unit {
  font-size: 22rpx;
  font-weight: 800;
  color: #415047;
}

.batch-size-check {
  margin-left: auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #10251A;
  color: #b8f21c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.batch-size-label {
  font-size: 20rpx;
  color: #6C786F;
  line-height: 1.3;
}

.batch-size-option.is-pending .batch-size-label { color: #3B5F10; }
.batch-size-option.is-pending .batch-size-unit { color: #3B5F10; }

/* 推荐角标（仅 10 道） */
.batch-size-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #10251A;
  color: #b8f21c;
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
  line-height: 1.3;
}

/* 当前选择提示 */
.batch-sheet-current-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #6C786F;
  text-align: center;
  line-height: 1.4;
}

/* 操作按钮 */
.batch-sheet-actions {
  display: flex;
  align-items: stretch;
  width: 100%;
  gap: 16rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

/* 通用按钮重置——修复微信 <button> 默认 margin/padding 导致的溢出 */
.batch-sheet-action {
  flex: 1 1 0;
  min-width: 0;
  width: auto;
  height: 84rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 84rpx;
  text-align: center;
  overflow: visible;
  display: block;
}

.batch-sheet-action::after {
  border: 0;
}

/* 取消按钮 */
.batch-sheet-cancel {
  background: #ECEFE8;
  color: #415047;
  border: 1rpx solid #CDD2C9;
}

.batch-sheet-cancel:active {
  background: #E0E3DC;
}

/* 确认按钮 */
.batch-sheet-confirm {
  background-color: #b8f21c;
  background-image: linear-gradient(135deg, #a9ef12, #c9f83c);
  color: #0b2b1c;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(169, 216, 0, 0.18);
}

.batch-sheet-confirm:active {
  opacity: 0.88;
}

/* 动画 */
@keyframes batchMaskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes batchSheetIn {
  from { opacity: 0; transform: translateY(42rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .batch-sheet-mask { animation: none !important; }
  .batch-sheet { animation: none !important; }
  .batch-size-option { transition: none !important; }
}

@media (max-width: 360px) {
  .batch-sheet-title { font-size: 33rpx; }
  .batch-size-num { font-size: 38rpx; }
  .batch-sheet { margin-left: 16rpx; margin-right: 16rpx; }
}


/* Review mastery status: backend is the single source of truth. */
.detail-status-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
}

.detail-mastery-text {
  font-size: 20rpx;
  line-height: 1.35;
  color: rgba(36, 56, 78, 0.58);
  white-space: nowrap;
}
