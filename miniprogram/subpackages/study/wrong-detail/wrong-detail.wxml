<page-meta page-style="{{diagnosisSheetVisible || teacherSheetVisible ? 'overflow: hidden;' : ''}}"></page-meta>
<premium-nav
  title="错题详情"
  variant="dark"
  bind:back="goBack"
/>
<view wx:if="{{loading}}" class="loading-page">
<view class="loading-hero-skeleton">
<view class="loading-hero-line short"></view>
<view class="loading-hero-line long"></view>
</view>
<view class="loading-question-card">
<view class="loading-chip"></view>
<view class="loading-line long"></view>
<view class="loading-line medium"></view>
<view class="loading-option" wx:for="{{skeletonOptions}}" wx:key="*this"></view>
</view>
<view class="loading-ai-card">
<view class="loading-line short"></view>
<view class="loading-line long"></view>
<view class="loading-line medium"></view>
</view>
</view>
<view wx:elif="{{errorText}}" class="error-state">
<view class="error-mark">!</view>
<text class="error-kicker">RECORD UNAVAILABLE</text>
<text class="error-title">暂时无法打开这道错题。</text>
<text user-select="true" class="error-desc">{{errorText}}，记录可能已被移出错题本。</text>
<button class="error-primary" bindtap="reloadData">重新加载</button>
<button class="error-secondary" bindtap="goBack">返回错题本</button>
</view>
<view class="page" wx:elif="{{!loading && wq}}">
<view wx:if="{{showSwitchMask}}" class="switch-mask">
<view class="switch-pill"><view class="switch-dot"></view><text>正在切换题目</text></view>
</view>
<view class="detail-meta">
<view class="detail-meta-row">
<view class="detail-meta-left">
<text class="detail-meta-subject">{{subjectLabelText || '综合'}}</text>
<view class="detail-meta-separator"></view>
<text class="detail-meta-label">错题复盘</text>
</view>
<view class="detail-meta-progress">
<view class="detail-progress-dots">
<view
            wx:for="{{questionIds}}"
            wx:key="*this"
            class="detail-progress-dot {{currentIdx > index ? 'is-done' : ''}} {{index === currentIdx ? 'is-current' : ''}}"
          ></view>
</view>
<view class="detail-progress-count">
<text class="detail-meta-current">{{currentIdx + 1}}</text>
<text class="detail-meta-slash">/</text>
<text class="detail-meta-total">{{totalQuestions || 1}}</text>
</view>
</view>
</view>
</view>
<view class="detail-switch-content {{contentTransitionClass}}">
<quiz-runner
    theme="premium-review"
    mode="wrong-detail"
    title="错题复盘"
    subtitle="{{currentIdx + 1}} / {{totalQuestions}}"
    subjectName="{{subjectLabelText}}"
    questions="{{wrongQuestions}}"
    currentQuestion="{{currentQuestion}}"
    currentIndex="{{currentIdx}}"
    totalCount="{{totalQuestions}}"
    answeredCount="{{totalQuestions}}"
    progressPercent="{{runnerProgressPercent}}"
    readonly="{{true}}"
    showAnswer="{{true}}"
    showFeedback="{{false}}"
    submitDisabled="{{true}}"
    submitText="继续复盘"
    showSubmitButton="{{false}}"
    showNavigation="{{false}}"
    swipeEnabled="{{true}}"
    swipeThroughOptions="{{true}}"
    allowSwipeInReadonly="{{true}}"
    compactReviewMode="{{true}}"
    externalSwitchAnimation="{{true}}"
    bind:prev="goPrevWrong"
    bind:next="goNextWrong"
    bind:jump="goWrongQuestion"
  />
<view class="diagnosis-card {{errorDiagnosis && errorDiagnosis.userConfirmed ? 'is-confirmed' : 'is-pending'}}">
<view class="diagnosis-summary">
<view class="diagnosis-symbol {{errorDiagnosis && errorDiagnosis.userConfirmed ? 'confirmed' : ''}}" aria-hidden="true"><image class="diagnosis-symbol-image" src="{{errorDiagnosis && errorDiagnosis.userConfirmed ? '/assets/icons/wrong-detail/badge-check.svg' : '/assets/icons/wrong-detail/circle-question-mark.svg'}}" mode="aspectFit" /></view>
<view class="diagnosis-content">
<view class="diagnosis-title-row">
<text class="diagnosis-title">我的错因</text>
<text class="diagnosis-status {{errorDiagnosis && errorDiagnosis.userConfirmed ? 'confirmed' : ''}}">{{errorDiagnosis && errorDiagnosis.userConfirmed ? '已确认' : '待记录'}}</text>
</view>
<text class="diagnosis-primary">{{errorDiagnosis && errorDiagnosis.userConfirmed ? errorDiagnosis.primaryLabel : '暂未分类'}}</text>
<view class="diagnosis-secondary" wx:if="{{errorDiagnosis && errorDiagnosis.secondaryLabels.length && errorDiagnosis.userConfirmed}}">
<text class="diagnosis-chip" wx:for="{{errorDiagnosis.secondaryLabels}}" wx:key="*this">{{item}}</text>
</view>
<text class="diagnosis-helper" wx:if="{{!errorDiagnosis || !errorDiagnosis.userConfirmed}}">记录后用于定制后续复盘与复练</text>
</view>
<button class="diagnosis-edit-btn" bindtap="openDiagnosisSheet" aria-label="{{errorDiagnosis && errorDiagnosis.userConfirmed ? '修改错因' : '记录错因'}}">
<text>{{errorDiagnosis && errorDiagnosis.userConfirmed ? '修改' : '记录'}}</text>
<text class="diagnosis-edit-arrow">›</text>
</button>
</view>
<view class="diagnosis-next-action" wx:if="{{errorDiagnosis && errorDiagnosis.userConfirmed && nextErrorAction}}" bindtap="openNextErrorAction" hover-class="diagnosis-next-action-pressed">
<view class="diagnosis-next-copy"><text class="diagnosis-next-kicker">NEXT ACTION</text><text class="diagnosis-next-title">{{nextErrorAction.title}}</text><text class="diagnosis-next-reason">{{nextErrorAction.reason}}</text></view>
<view class="diagnosis-next-cta" aria-label="{{nextErrorAction.actionLabel}}"><image class="diagnosis-next-icon" src="/assets/icons/wrong-detail/circle-arrow-right.svg" mode="aspectFit" aria-hidden="true" /></view>
</view>
</view>
<view class="ai-card" id="ai-card" bindtouchstart="onAiSwipeStart" bindtouchend="onAiSwipeEnd" bindtouchcancel="onAiSwipeCancel">
<view class="ai-card-head">
<view class="ai-brand">
<view class="ai-brand-icon" aria-hidden="true"><image class="ai-brand-icon-image" src="/assets/icons/wrong-detail/ai-review.png" mode="aspectFit" /></view>
<view class="ai-head-copy">
<text class="ai-title">AI 复盘</text>
<text class="ai-subtitle">先抓住关键，再按需深入</text>
</view>
</view>
<view class="ai-mark {{aiCards && !aiFallback && !aiCards.formatError ? 'is-ready' : ''}}"><view class="ai-mark-dot"></view><text>{{aiCards && !aiFallback ? (aiCards.formatError ? '需更新' : '已生成') : 'AI'}}</text></view>
</view>
<view wx:if="{{!aiCards && (aiSkeletonVisible || aiLoading)}}" class="ai-loading-state">
<view class="ai-skeleton-section" wx:for="{{aiSkeletonSections}}" wx:key="*this">
<view class="skeleton-title-row"><view class="skeleton-index"></view><view class="skeleton-title"></view></view>
<view class="skeleton-line long"></view>
<view class="skeleton-line medium"></view>
<view class="skeleton-line short"></view>
</view>
</view>
<view wx:elif="{{aiCards && !aiFallback}}" class="ai-result-state {{aiRegenerating ? 'is-regenerating' : ''}} {{aiReviewExpanded ? 'is-expanded' : 'is-collapsed'}}">
<view wx:if="{{aiRegenerating}}" class="ai-regenerating-banner">
<view class="loading-spinner mini"></view>
<text>正在重新生成，先保留当前解析</text>
</view>
<view wx:if="{{aiCards.formatError && !aiCards.mistakeDiagnosis.raw && !aiCards.knowledgePatch.raw && !aiCards.reviewTask.raw}}" class="ai-fallback inside">
<view class="fallback-mark">!</view>
<text class="fallback-title">AI 解析格式异常</text>
<text class="fallback-desc">返回数据暂时无法识别，请重新生成。</text>
</view>
<view wx:elif="{{aiCards.mistakeDiagnosis.raw}}" class="ai-section diagnosis">
<view class="ai-section-index">01</view>
<view class="ai-section-copy">
<text class="ai-section-kicker">WHY IT HAPPENED</text>
<text class="ai-section-title">错因诊断</text>
<view class="ai-section-body {{aiReviewExpanded ? '' : 'is-clamped'}}"><mp-html wx:if="{{aiCards.mistakeDiagnosis.needsRich}}" content="{{aiCards.mistakeDiagnosis.html}}" class="ai-rich-text" lazy-load set-title="{{false}}" copy-link="{{false}}" /><text user-select="true" wx:else class="ai-text">{{aiCards.mistakeDiagnosis.text}}</text></view>
</view>
</view>
<view class="ai-section knowledge" wx:if="{{aiCards.knowledgePatch.raw}}">
<view class="ai-section-index">02</view>
<view class="ai-section-copy">
<text class="ai-section-kicker">KNOWLEDGE PATCH</text>
<text class="ai-section-title">补漏重点</text>
<view class="ai-section-body {{aiReviewExpanded ? '' : 'is-clamped'}}"><mp-html wx:if="{{aiCards.knowledgePatch.needsRich}}" content="{{aiCards.knowledgePatch.html}}" class="ai-rich-text" lazy-load set-title="{{false}}" copy-link="{{false}}" /><text user-select="true" wx:else class="ai-text">{{aiCards.knowledgePatch.text}}</text></view>
</view>
</view>
<view class="ai-section task" wx:if="{{aiCards.reviewTask.raw}}">
<view class="ai-section-index">03</view>
<view class="ai-section-copy">
<text class="ai-section-kicker">NEXT ACTION</text>
<text class="ai-section-title">复练任务</text>
<view class="ai-section-body {{aiReviewExpanded ? '' : 'is-clamped'}}"><mp-html wx:if="{{aiCards.reviewTask.needsRich}}" content="{{aiCards.reviewTask.html}}" class="ai-rich-text" lazy-load set-title="{{false}}" copy-link="{{false}}" /><text user-select="true" wx:else class="ai-text">{{aiCards.reviewTask.text}}</text></view>
</view>
</view>
<button wx:if="{{aiCards.mistakeDiagnosis.raw || aiCards.knowledgePatch.raw || aiCards.reviewTask.raw}}" class="ai-expand-btn" hover-class="ai-expand-pressed" hover-stay-time="70" disabled="{{aiRegenerating}}" bindtap="toggleAiReview" aria-label="{{aiReviewExpanded ? '收起完整复盘' : '查看完整复盘'}}"><text>{{aiReviewExpanded ? '收起详情' : '查看完整复盘'}}</text><image class="ai-expand-arrow-icon {{aiReviewExpanded ? 'is-up' : ''}}" src="/assets/icons/wrong-detail/chevron-down.svg" mode="aspectFit" aria-hidden="true" /></button>
<text wx:if="{{aiInlineNotice}}" class="ai-inline-notice">{{aiInlineNotice}}</text>
<view class="ai-result-tools">
<view class="ai-hint-row">
<image class="ai-history-icon-image" src="/assets/icons/wrong-detail/layers.svg" mode="aspectFit" aria-hidden="true" />
<text class="ai-hint">{{aiFromQuestionAnalysis ? '当前展示题库解析' : (aiFromCache ? '来自历史复盘，仅供参考' : '内容由 AI 生成，仅供参考')}}</text>
</view>
<button class="ai-regenerate-link" hover-class="ai-control-pressed" hover-stay-time="90" disabled="{{aiRegenerating}}" bindtap="regenerateAiAnalysis" aria-label="重新生成 AI 复盘"><image class="ai-refresh-icon-image {{aiRegenerating ? 'is-spinning' : ''}}" src="/assets/icons/wrong-detail/refresh-cw.svg" mode="aspectFit" aria-hidden="true" /><text>{{aiRegenerating ? '更新中…' : '重新生成'}}</text></button>
</view>
</view>
<view wx:elif="{{aiFallback && !aiCards}}" class="ai-fallback">
<view class="fallback-mark">!</view>
<text class="fallback-title">AI 复盘暂时不可用</text>
<text user-select="true" class="fallback-desc">{{aiErrorText || '先查看题目与答案，稍后再试。'}}</text>
<button wx:if="{{aiRetryable}}" class="ai-action-btn" bindtap="regenerateAiAnalysis">重新生成</button>
</view>
<view wx:elif="{{!aiRequested && !aiCards}}" class="ai-idle">
<view class="ai-idle-copy">
<text class="ai-idle-title">生成完整复盘</text>
<text class="ai-idle-desc">结合你的答案，梳理错因、补漏重点和下一步</text>
</view>
<button class="ai-action-btn ai-generate-btn" hover-class="ai-control-pressed" hover-stay-time="90" bindtap="onTapAiAnalysis">
<text class="ai-action-btn-label">开始复盘</text>
<text class="ai-action-arrow">→</text>
</button>
</view>
<view class="ai-deep-dive {{aiCards && !aiFallback ? 'has-review' : ''}}">
<view class="ai-deep-head">
<view class="ai-deep-copy">
<text class="ai-deep-title">{{aiCards && !aiFallback ? '继续追问' : '直接提问'}}</text>
<text class="ai-deep-desc">选择一个方向，获取针对性讲解</text>
</view>
<button class="ai-deep-more" hover-class="ai-more-pressed" hover-stay-time="70" disabled="{{teacherLoadingAction || aiLoading || aiRegenerating}}" bindtap="toggleTeacherActions" aria-label="{{teacherActionsExpanded ? '收起更多追问方向' : '查看更多追问方向'}}"><text>{{teacherActionsExpanded ? '收起' : '更多'}}</text><image class="ai-deep-more-arrow-icon {{teacherActionsExpanded ? 'is-up' : ''}}" src="/assets/icons/wrong-detail/chevron-down.svg" mode="aspectFit" aria-hidden="true" /></button>
</view>
<view class="ai-deep-actions">
<button wx:for="{{teacherPrimaryActions}}" wx:key="action" class="ai-deep-action {{teacherLoadingAction === item.action ? 'is-loading' : ''}}" data-action="{{item.action}}" hover-class="ai-deep-action-pressed" hover-stay-time="100" disabled="{{teacherLoadingAction || aiLoading || aiRegenerating}}" bindtap="run408TeacherAction" aria-label="{{item.label}}"><view wx:if="{{teacherLoadingAction === item.action}}" class="ai-action-loading-spinner" aria-hidden="true"></view><image wx:else class="ai-deep-action-icon" src="{{item.icon}}" mode="aspectFit" /><text class="ai-deep-action-label">{{teacherLoadingAction === item.action ? '正在生成' : item.shortLabel}}</text><image class="ai-deep-action-arrow-icon" src="/assets/icons/wrong-detail/chevron-right.svg" mode="aspectFit" aria-hidden="true" /></button>
</view>
<view class="ai-deep-extra {{teacherActionsExpanded ? 'is-expanded' : 'is-collapsed'}}" aria-hidden="{{!teacherActionsExpanded}}">
<text class="ai-deep-extra-label">更多方向</text>
<view class="ai-deep-actions is-extra"><button wx:for="{{teacherMoreActions}}" wx:key="action" class="ai-deep-action secondary {{teacherLoadingAction === item.action ? 'is-loading' : ''}}" data-action="{{item.action}}" hover-class="ai-deep-action-pressed" hover-stay-time="100" disabled="{{teacherLoadingAction || aiLoading || aiRegenerating}}" bindtap="run408TeacherAction" aria-label="{{item.label}}"><view wx:if="{{teacherLoadingAction === item.action}}" class="ai-action-loading-spinner" aria-hidden="true"></view><image wx:else class="ai-deep-action-icon" src="{{item.icon}}" mode="aspectFit" /><text class="ai-deep-action-label">{{teacherLoadingAction === item.action ? '正在生成' : item.shortLabel}}</text><image class="ai-deep-action-arrow-icon" src="/assets/icons/wrong-detail/chevron-right.svg" mode="aspectFit" aria-hidden="true" /></button></view>
</view>
</view>
<view class="ai-card-decoration" aria-hidden="true">
<view class="ai-card-wave wave-1"></view>
<view class="ai-card-wave wave-2"></view>
<view class="ai-card-wave wave-3"></view>
</view>
</view>
</view>
<view class="page-bottom-space"></view>
<view class="detail-bottom-actions {{bottomActionsVisible ? 'is-visible' : 'is-hidden'}}">
<button class="master-action {{isCurrentMastered ? 'is-mastered' : ''}}" hover-class="bottom-action-pressed" hover-stay-time="90" disabled="{{masterSubmitting}}" bindtap="onMasterAction">
<view class="master-action-icon">{{isCurrentMastered ? '✓' : ''}}</view>
<text class="master-action-label">{{isCurrentMastered ? '重新加入复习' : '标记已掌握'}}</text>
</button>
<button class="more-action" hover-class="bottom-action-pressed" hover-stay-time="90" bindtap="openMoreMenu">
<text class="more-action-label">更多</text>
</button>
</view>
</view>
<view class="teacher-modal-mask" wx:if="{{teacherSheetVisible}}" catchtouchmove="noop">
<view class="teacher-modal-backdrop" bindtap="close408TeacherSheet"></view>
<view class="teacher-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<view class="teacher-sheet-head">
<view>
<text class="teacher-kicker">AI 深入讲解</text>
<text class="teacher-sheet-title">{{teacherResult ? teacherResult.title : '正在准备讲解'}}</text>
</view>
<text class="teacher-sheet-close" bindtap="close408TeacherSheet">×</text>
</view>
<view wx:if="{{teacherLoadingAction}}" class="teacher-sheet-loading">
<view class="loading-spinner"></view>
<text>正在结合你的学习上下文生成…</text>
</view>
<view wx:elif="{{teacherErrorText}}" class="teacher-sheet-error">
<text user-select="true">{{teacherErrorText}}</text>
<button class="teacher-retry" wx:if="{{teacherLastAction}}" data-action="{{teacherLastAction}}" bindtap="run408TeacherAction">重新尝试</button>
</view>
<scroll-view wx:elif="{{teacherResult}}" class="teacher-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}">
<view wx:if="{{teacherResult.summary}}" class="teacher-summary-card">
<text class="teacher-summary-label">先看结论</text>
<text class="teacher-summary" user-select="true">{{teacherResult.summary}}</text>
</view>
<view wx:for="{{teacherResult.sections}}" wx:key="key" class="teacher-result-section">
<view class="teacher-section-head"><view class="teacher-section-rule"></view><text class="teacher-result-heading">{{item.heading}}</text></view>
<view class="teacher-point-list">
<view wx:for="{{item.points}}" wx:for-item="point" wx:key="*this" class="teacher-result-point">
<view class="teacher-point-dot"></view><text class="teacher-point-text" user-select="true">{{point}}</text>
</view>
</view>
</view>
<view wx:if="{{teacherResult.knowledgePoints.length}}" class="teacher-result-section teacher-kp-wrap">
<view class="teacher-section-head"><view class="teacher-section-rule"></view><text class="teacher-result-heading">知识点串联</text></view>
<view wx:for="{{teacherResult.knowledgePoints}}" wx:key="key" class="teacher-kp-row">
<text class="teacher-kp-name">{{item.name}}</text>
<view wx:if="{{item.relationItems.length}}" class="teacher-kp-relations">
<view wx:for="{{item.relationItems}}" wx:for-item="relation" wx:key="key" class="teacher-kp-relation-chip">
<text class="teacher-kp-relation-label">{{relation.label}}</text>
<text class="teacher-kp-relation-value">{{relation.value}}</text>
</view>
</view>
<text wx:elif="{{item.relationText}}" class="teacher-kp-relation">{{item.relationText}}</text>
<view wx:if="{{item.masteryText || item.learningHint}}" class="teacher-kp-learning">
<text wx:if="{{item.masteryText}}" class="teacher-kp-mastery">{{item.masteryText}}</text>
<text wx:if="{{item.learningHint}}" class="teacher-kp-hint">{{item.learningHint}}</text>
</view>
</view>
</view>
<view wx:if="{{teacherResult.practiceQuestion}}" class="teacher-result-section teacher-practice-card">
<view class="teacher-section-head"><view class="teacher-section-rule"></view><text class="teacher-result-heading">立即检验</text></view>
<text class="teacher-practice-stem" user-select="true">{{teacherResult.practiceQuestion.stem}}</text>
<view wx:for="{{teacherResult.practiceQuestion.options}}" wx:key="key" class="teacher-practice-option">
<text class="teacher-practice-key">{{item.key}}</text><text user-select="true" class="teacher-practice-option-text">{{item.text}}</text>
</view>
<view class="teacher-practice-answer-row"><text class="teacher-practice-answer-label">答案</text><text class="teacher-practice-answer">{{teacherResult.practiceQuestion.answer}}</text></view>
<text wx:if="{{teacherResult.practiceQuestion.analysis}}" class="teacher-practice-analysis" user-select="true">{{teacherResult.practiceQuestion.analysis}}</text>
</view>
<text class="teacher-footnote">{{teacherResult.fromFallback ? '当前使用可靠的已有内容兜底；AI 生成暂不可用。' : '内容由 AI 深入讲解生成，仅用于学习复盘。'}}</text>
<view class="teacher-feedback-row">
<view class="teacher-feedback-copy">
<text class="teacher-feedback-label">这次讲解有帮助吗？</text>
<text class="teacher-feedback-hint">你的反馈会用于改善后续讲解</text>
</view>
<view class="teacher-feedback-actions">
<button class="teacher-feedback-btn {{teacherFeedbackSent === 'helpful' ? 'selected' : ''}}" data-type="helpful" disabled="{{teacherFeedbackSent}}" bindtap="feedback408Teacher">有帮助</button>
<button class="teacher-feedback-btn {{teacherFeedbackSent === 'inaccurate' ? 'selected' : ''}}" data-type="inaccurate" disabled="{{teacherFeedbackSent}}" bindtap="feedback408Teacher">不准确</button>
</view>
</view>
<view class="teacher-scroll-space"></view>
</scroll-view>
</view>
</view>
<view class="modal-overlay" wx:if="{{diagnosisSheetVisible}}" catchtap="closeDiagnosisSheet" catchtouchmove="noop">
<view class="diagnosis-sheet-shell" catchtap="noop">
<view class="sheet-handle"></view>
<scroll-view class="diagnosis-sheet-scroll" scroll-y enhanced bounces="{{false}}" show-scrollbar="{{false}}">
<text class="decision-kicker">ERROR CAUSE</text>
<text class="decision-title">这次为什么做错？</text>
<text class="decision-desc">选择一个主错因，可再补充最多 3 个次级错因。</text>
<text class="diagnosis-sheet-label">主错因</text>
<view class="diagnosis-option-grid">
<view wx:for="{{diagnosisOptions}}" wx:key="type" data-type="{{item.type}}" bindtap="selectDiagnosisPrimary" class="diagnosis-option {{diagnosisPrimary === item.type ? 'selected' : ''}}">
<text class="diagnosis-option-title">{{item.label}}</text>
<text class="diagnosis-option-desc">{{item.description}}</text>
</view>
</view>
<text class="diagnosis-sheet-label secondary-label">次级错因（可选）</text>
<view class="diagnosis-secondary-options">
<text wx:for="{{diagnosisOptions}}" wx:key="type" wx:if="{{item.type !== diagnosisPrimary}}" data-type="{{item.type}}" bindtap="toggleDiagnosisSecondary" class="diagnosis-secondary-option {{diagnosisSecondaryMap[item.type] ? 'selected' : ''}}">{{item.label}}</text>
</view>
<view class="diagnosis-sheet-scroll-space"></view>
</scroll-view>
<view class="diagnosis-sheet-footer">
<button class="decision-secondary" bindtap="closeDiagnosisSheet">取消</button>
<button class="decision-primary" loading="{{diagnosisSaving}}" disabled="{{diagnosisSaving}}" bindtap="saveDiagnosis">保存错因</button>
</view>
</view>
</view>
<view class="modal-overlay" wx:if="{{masterConfirmVisible}}" catchtap="closeMasterConfirm" catchtouchmove="noop">
<view class="decision-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<text class="decision-kicker">MASTERED</text>
<text class="decision-title">确认已经掌握？</text>
<text class="decision-desc">标记后，这道题将退出正常复习计划；如果之后再次答错，会自动重新加入复习。</text>
<view class="decision-actions"><button class="decision-secondary" bindtap="closeMasterConfirm">继续看看</button><button class="decision-primary" bindtap="confirmMastered">确认掌握</button></view>
</view>
</view>
<view class="modal-overlay" wx:if="{{unmasterConfirmVisible}}" catchtap="closeUnmasterConfirm" catchtouchmove="noop">
<view class="decision-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<text class="decision-kicker">REVIEW AGAIN</text>
<text class="decision-title">重新加入复习？</text>
<text class="decision-desc">恢复这道题的复习资格后，掌握度会按已有复习记录重新计算，后续会按复习计划再次出现。</text>
<view class="decision-actions"><button class="decision-secondary" bindtap="closeUnmasterConfirm">保持掌握</button><button class="decision-primary" loading="{{masterSubmitting}}" disabled="{{masterSubmitting}}" bindtap="confirmUnmastered">加入复习</button></view>
</view>
</view>
<view class="modal-overlay" wx:if="{{moreMenuVisible}}" catchtap="closeMoreMenu" catchtouchmove="noop">
<view class="more-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<text class="more-sheet-title">更多操作</text>
<view class="more-sheet-item danger" bindtap="openRemoveConfirm">
<view><text class="more-item-title">移出错题本</text><text class="more-item-desc">不再出现在错题列表，复习历史仍按后端规则处理</text></view>
<text class="more-item-arrow">›</text>
</view>
<button class="more-cancel" bindtap="closeMoreMenu">取消</button>
</view>
</view>
<view class="modal-overlay" wx:if="{{removeConfirmVisible}}" catchtap="closeRemoveConfirm" catchtouchmove="noop">
<view class="decision-sheet" catchtap="noop">
<view class="sheet-handle"></view>
<text class="decision-kicker danger">REMOVE FROM BOOK</text>
<text class="decision-title">移出这道错题？</text>
<text class="decision-desc">移出后不会提供撤销入口。你仍可通过练习记录或题库重新遇到这道题。</text>
<view class="decision-actions"><button class="decision-secondary" bindtap="closeRemoveConfirm">取消</button><button class="decision-danger" loading="{{removeSubmitting}}" disabled="{{removeSubmitting}}" bindtap="removeFromWrongBook">确认移出</button></view>
</view>
</view>
<view class="undo-toast-layer {{masterUndoVisible ? 'show' : ''}}">
<view class="undo-toast">
<text class="undo-toast-text">已标记掌握，正在查看下一题</text>
<view class="undo-divider"></view>
<button class="undo-action" hover-class="undo-action-pressed" bindtap="undoMastered">撤销</button>
</view>
</view>
