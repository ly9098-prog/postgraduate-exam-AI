}
.diagnosis-rule {
  width: 100%;
  height: 1rpx;
  margin: 37rpx 0 25rpx;
  background: #DEE5DE;
}
.diagnosis-ai-control {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 52rpx;
}
.diagnosis-ai-inline-action,
.diagnosis-ai-inline-action.enabled {
  width: auto !important;
  min-width: 0;
  min-height: 52rpx;
  height: 52rpx;
  margin: 0 !important;
  padding: 0 !important;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #83928B;
  font-size: 25rpx;
  font-weight: 520;
  line-height: 52rpx;
  text-align: right;
  box-shadow: none;
}
.diagnosis-ai-inline-action.enabled {
  color: #57715F;
}
.diagnosis-ai-inline-action::after {
  border: 0;
}
.diagnosis-ai-suggestion {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 18rpx 18rpx 18rpx 20rpx;
  border: 1rpx solid #DCE8D8;
  border-radius: 18rpx;
  background: #F3F8F0;
}
.diagnosis-ai-suggestion-copy {
  flex: 1;
  min-width: 0;
}
.diagnosis-ai-suggestion-label {
  display: block;
  color: #7A897C;
  font-size: 18rpx;
}
.diagnosis-ai-suggestion-value {
  display: block;
  margin-top: 5rpx;
  color: #284735;
  font-size: 23rpx;
  font-weight: 820;
}
.diagnosis-ai-suggestion-reason {
  display: block;
  margin-top: 7rpx;
  color: #68766C;
  font-size: 19rpx;
  line-height: 1.55;
}
.diagnosis-ai-state {
  margin-top: 18rpx;
}
.diagnosis-edit-btn {
  width: 100% !important;
  height: 108rpx;
  min-height: 108rpx;
  margin: auto 0 0 !important;
  padding: 0 48rpx !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #173A2B 0%, #0D2D20 72%, #0B291D 100%);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 108rpx;
  box-shadow: 0 18rpx 40rpx rgba(14, 48, 33, .14);
}
.diagnosis-edit-btn::after {
  border: 0;
}
.diagnosis-edit-arrow {
  display: inline-block;
  color: #E4F1E1;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
  transform: translateY(-1rpx);
}
.diagnosis-card.is-confirmed .diagnosis-primary {
  color: #122E22;
}

