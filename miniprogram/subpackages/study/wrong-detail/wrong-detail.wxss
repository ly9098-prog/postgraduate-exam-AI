/* Diagnosis → next action. Reuses the existing diagnosis card instead of adding a new surface. */
.diagnosis-next-action{margin:18rpx 0 0;padding:20rpx 22rpx;display:flex;align-items:center;gap:18rpx;border-top:1rpx solid #E4EAE5;background:rgba(247,250,247,.72);border-radius:0 0 20rpx 20rpx;transition:opacity .14s ease,transform .14s ease;}
.diagnosis-next-copy{flex:1;min-width:0;}
.diagnosis-next-kicker,.diagnosis-next-title,.diagnosis-next-reason{display:block;}
.diagnosis-next-kicker{color:#8DA096;font-size:15rpx;font-weight:850;letter-spacing:2rpx;}
.diagnosis-next-title{margin-top:5rpx;color:#254334;font-size:22rpx;font-weight:850;}
.diagnosis-next-reason{margin-top:6rpx;color:#849189;font-size:17rpx;line-height:1.5;}
.diagnosis-next-cta{flex:0 0 auto;display:flex;align-items:center;gap:7rpx;color:#2D6848;font-size:18rpx;font-weight:820;}
.diagnosis-next-action-pressed{opacity:.76;transform:scale(.992);}


/* v5 diagnosis polish: icon-led status, no AI recommendation row, compact next action affordance. */
.diagnosis-card {
  padding-bottom: 18rpx;
}
.diagnosis-symbol {
  overflow: hidden;
  background: #F1F4F1;
  border: 1rpx solid #E0E6E1;
}
.diagnosis-symbol.confirmed {
  background: #EAF5E5;
  border-color: #D4E7D2;
}
.diagnosis-symbol-image {
  width: 27rpx;
  height: 27rpx;
  display: block;
}
.diagnosis-next-action {
  margin-top: 18rpx;
  padding-right: 18rpx;
}
.diagnosis-next-cta {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #D9E7DD;
  border-radius: 50%;
  background: #F4F9F4;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.9);
}
.diagnosis-next-icon {
  width: 31rpx;
  height: 31rpx;
  display: block;
}
.diagnosis-next-action-pressed .diagnosis-next-cta {
  background: #EAF4EC;
  transform: scale(.94);
}

/* AI availability: keep the reason visible without replacing existing content. */
.ai-availability-note{position:relative;z-index:1;display:flex;align-items:center;min-height:48rpx;margin:14rpx 0 0;padding:10rpx 14rpx;border-radius:12rpx;background:#F5F2EA;color:#806A4E;font-size:19rpx;line-height:1.5;box-sizing:border-box;}
.ai-availability-note.is-checking{background:#F2F5EF;color:#687A6B;}
.ai-availability-note.is-blocked{background:#F7EFE9;color:#855B47;}
.ai-action-btn[disabled],.ai-deep-action[disabled]{opacity:.52;background:#F1F2ED;color:#7E877F;box-shadow:none;}
.ai-regenerate-link[disabled]{opacity:.48;pointer-events:none;}

.ai-review-error {
  align-items: flex-start;
  padding: 28rpx 0 12rpx;
  text-align: left;
}
.ai-error-heading {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ai-error-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.ai-review-error .fallback-title {
  margin-top: 0;
}
.ai-review-error .fallback-desc {
  margin-top: 16rpx;
  color: #526557;
  font-size: 24rpx;
  line-height: 1.65;
  word-break: break-word;
}
.ai-error-help {
  margin-top: 10rpx;
  color: #526557;
  font-size: 22rpx;
  line-height: 1.6;
}
.ai-review-error .ai-retry-btn {
  min-height: 72rpx;
  height: auto;
  margin-top: 24rpx;
  padding: 12rpx 24rpx !important;
  font-size: 24rpx;
  line-height: 1.4;
}
