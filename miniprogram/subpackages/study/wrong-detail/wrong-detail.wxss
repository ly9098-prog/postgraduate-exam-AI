  .detail-progress-dots { gap: 6rpx; }
  .ai-idle { align-items: flex-start; }
  .ai-idle-desc { display: none; }
  .ai-action-btn { padding: 0 15rpx !important; }
}

@media (prefers-reduced-motion: reduce) {
  .loading-hero-line,
  .loading-line,
  .loading-chip,
  .loading-option,
  .skeleton-index,
  .skeleton-title,
  .skeleton-line,
  .switch-dot,
  .loading-spinner,
  .decision-sheet,
  .more-sheet,
  .detail-switch-content.content-slide-in-right,
  .detail-switch-content.content-slide-in-left { animation: none !important; }
  .detail-switch-content,
  .undo-toast-layer { transition: none !important; transform: none !important; opacity: 1 !important; }
}

