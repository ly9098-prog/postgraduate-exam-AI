@keyframes skeletonPulse { 0%,100% { opacity: .5; } 50% { opacity: 1; } }
@keyframes switchPulse { 0%,100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1); } }
@keyframes sheetRise { from { transform: translateY(42rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes detailContentSlideInRight { from { opacity: 0; transform: translateX(52rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes detailContentSlideInLeft { from { opacity: 0; transform: translateX(-52rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 360px) {
  .detail-meta { padding: 20rpx 24rpx 14rpx; }
