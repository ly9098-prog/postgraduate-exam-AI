@import '../../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F2EC;
  color: #15261D;
  overflow-x: hidden;
}

button { box-sizing: border-box; }
button::after { border: none; }

.page {
  min-height: 100vh;
  padding-bottom: 0;
  overflow-x: hidden;
  background: #F4F2EC;
}

/* loading */
.loading-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #F4F2EC;
}

.loading-hero-skeleton {
  height: 152rpx;
  padding: 34rpx 30rpx;
  box-sizing: border-box;
  background: #0F2D22;
}

.loading-hero-line,
.loading-line,
.loading-chip,
.loading-option {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #E4E5DF, #F2F1EC, #E4E5DF);
  animation: skeletonPulse 1.2s ease-in-out infinite;
}

.loading-hero-line { background: rgba(255,255,255,.12); }
.loading-hero-line.short { width: 142rpx; height: 18rpx; }
.loading-hero-line.long { width: 330rpx; max-width: 72%; height: 26rpx; margin-top: 18rpx; }
.loading-question-card,
.loading-ai-card {
  margin: 0;
  padding: 30rpx;
  border-radius: 0;
  border: 0;
  border-bottom: 1rpx solid #E4E3DC;
  background: #FFFEFB;
  box-shadow: none;
}
.loading-ai-card {
  margin: 24rpx 24rpx 0;
  border: 1rpx solid #E0DFD8;
  border-radius: 18rpx;
  background: rgba(255,255,255,.76);
}
.loading-chip { width: 92rpx; height: 20rpx; }
.loading-line { height: 20rpx; margin-top: 18rpx; }
.loading-line.long { width: 94%; }
.loading-line.medium { width: 72%; }
.loading-line.short { width: 38%; }
.loading-option {
  height: 76rpx;
  margin-top: 0;
  border-radius: 0;
  border-bottom: 1rpx solid #E8E7E1;
  background: transparent;
}

/* error */
.error-state {
  min-height: calc(100vh - 120rpx);
  padding: 80rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #F4F2EC;
}
.error-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 1rpx solid #D9BDB4;
  background: #F6E9E5;
  color: #A95442;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
}
.error-kicker {
  margin-top: 28rpx;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #A85B49;
}
.error-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #14271E;
}
.error-desc {
  margin-top: 12rpx;
  max-width: 560rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: #737B75;
}
.error-primary,
.error-secondary {
  width: 100%;
  max-width: 520rpx;
  min-height: 82rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 750;
}
.error-primary { margin-top: 34rpx; background: #123A2B; color: #FFFFFF; }
.error-secondary { margin-top: 12rpx; border: 1rpx solid #DADCD6; background: #F8F7F2; color: #465149; }

/* compact page context */
.detail-meta {
  padding: 24rpx 30rpx 16rpx;
  background: #FFFEFB;
  box-sizing: border-box;
}
.detail-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.detail-meta-left {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 11rpx;
}
.detail-meta-subject,
.detail-meta-label {
  font-size: 19rpx;
  line-height: 1.2;
  white-space: nowrap;
}
.detail-meta-subject {
  color: #31483C;
  font-weight: 700;
}
.detail-meta-label {
  color: #929790;
  font-weight: 500;
}
.detail-meta-separator {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #B7BDB7;
  flex-shrink: 0;
}
.detail-meta-progress {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #A0A59F;
  font-variant-numeric: tabular-nums;
}
.detail-progress-dots {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.detail-progress-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #D9DDD8;
  box-sizing: border-box;
}
.detail-progress-dot.is-done {
  background: #8FAB63;
}
.detail-progress-dot.is-current {
  width: 12rpx;
  height: 12rpx;
  background: #B7E82A;
  box-shadow: 0 0 0 4rpx rgba(183,232,42,.15);
}
.detail-progress-count {
  display: flex;
  align-items: baseline;
  gap: 5rpx;
}
.detail-meta-current {
  color: #173B2B;
  font-size: 22rpx;
  font-weight: 750;
}
.detail-meta-slash,
.detail-meta-total {
  font-size: 18rpx;
  font-weight: 550;
}

/* switch mask */
.switch-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.switch-pill {
  padding: 13rpx 22rpx;
  border-radius: 999rpx;
  background: #0F2D22;
  color: rgba(255,255,255,.8);
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 16rpx 42rpx rgba(15,45,34,.24);
  font-size: 21rpx;
}
.switch-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #B7E82A;
  animation: switchPulse .8s ease-in-out infinite;
}

/* AI review */
.ai-card {
  margin: 30rpx 24rpx 0;
  padding: 30rpx 28rpx 22rpx;
  border: 1rpx solid #DFDED7;
  border-radius: 18rpx;
  background: rgba(255,255,255,.72);
  box-shadow: 0 12rpx 34rpx rgba(27,46,36,.035);
}
.ai-card.is-idle {
  padding: 0;
  border-color: #D9DBD4;
  background: #FBFAF6;
  box-shadow: none;
  overflow: hidden;
}
.ai-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}
.ai-head-copy { min-width: 0; }
.ai-title {
  display: block;
  font-size: 31rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #172B21;
}
.ai-subtitle {
  display: block;
  margin-top: 7rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #7D857F;
}
.ai-mark {
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(18,58,43,.12);
  background: #123A2B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  box-sizing: border-box;
  font-size: 17rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.ai-mark-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #B7E82A;
}

.ai-result-state {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
}
.ai-section {
  position: relative;
  padding: 26rpx 0 26rpx 54rpx;
  border-top: 1rpx solid #E4E3DD;
  background: transparent;
}
.ai-section::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 34rpx;
  bottom: -10rpx;
  width: 1rpx;
  background: #DADDD6;
}
.ai-section:last-of-type::before { display: none; }
.ai-section-index {
  position: absolute;
  left: 0;
  top: 27rpx;
  width: 33rpx;
  height: 33rpx;
  border-radius: 50%;
  border: 1rpx solid #C9CDC7;
  background: #FBFAF6;
  color: #677168;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
}
.ai-section.diagnosis .ai-section-index { border-color: #D4B2A8; color: #9D5A49; }
.ai-section.knowledge .ai-section-index { border-color: #BEC7B9; color: #65705F; }
.ai-section.task .ai-section-index { border-color: #9EB9AA; color: #2B6D4E; }
.ai-section-copy { min-width: 0; }
.ai-section-kicker { display: none; }
.ai-section-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #1A2D23;
}
.ai-text,
.ai-rich-text {
  display: block;
  font-size: 24rpx;
  line-height: 1.78;
  color: #3A443E;
  word-break: break-word;
  white-space: pre-wrap;
}
.ai-hint,
.ai-inline-notice {
  display: block;
  padding-top: 8rpx;
  text-align: left;
  font-size: 18rpx;
  line-height: 1.45;
  color: #929892;
}
.ai-inline-notice { color: #9A654D; }
.ai-secondary-btn {
  width: 280rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: 16rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  border: 1rpx solid #D7DAD4;
  background: transparent;
  color: #4A554E;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}
.ai-secondary-btn-label {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
}
.ai-secondary-btn[disabled] { opacity: .48; }

.ai-regenerating-banner {
  margin-bottom: 8rpx;
  padding: 12rpx 15rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E5D7CC;
  background: #F8F1EA;
  color: #8D624C;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
}
.loading-spinner {
  width: 42rpx;
  height: 42rpx;
  border: 4rpx solid #DDE1DA;
  border-top-color: #315C48;
  border-radius: 50%;
  animation: spin .8s linear infinite;
  box-sizing: border-box;
}
.loading-spinner.mini { width: 20rpx; height: 20rpx; border-width: 2rpx; }

.ai-idle {
  min-height: 118rpx;
  padding: 20rpx 20rpx 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}
.ai-idle-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.ai-idle-mark {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  border-radius: 16rpx;
  background: #123A2B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.ai-idle-mark-dot {
  position: absolute;
  right: 7rpx;
  top: 7rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #B7E82A;
}
.ai-idle-copy { min-width: 0; }
.ai-idle-title {
  display: block;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #173126;
}
.ai-idle-desc {
  display: block;
  margin-top: 5rpx;
  font-size: 19rpx;
  line-height: 1.45;
  color: #838B84;
}
.ai-action-btn {
  flex-shrink: 0;
  width: auto;
  height: 62rpx;
  min-height: 62rpx;
  margin: 0;
  padding: 0 18rpx !important;
  border-radius: 999rpx;
  border: 1rpx solid #CBD3CD;
  background: #F8F8F3;
  color: #123A2B;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  font-size: 21rpx;
  font-weight: 750;
  box-shadow: none;
}
.ai-action-btn::after { border: 0; }
.ai-action-arrow {
  font-family: Arial, sans-serif;
  font-size: 25rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.ai-loading-state { margin-top: 18rpx; }
.ai-skeleton-section {
  padding: 24rpx 0 24rpx 54rpx;
  border-top: 1rpx solid #E4E3DD;
}
.skeleton-title-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 18rpx; }
.skeleton-index { width: 32rpx; height: 32rpx; margin-left: -54rpx; border-radius: 50%; background: #E1E3DE; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-title { width: 164rpx; height: 20rpx; border-radius: 999rpx; background: #E1E3DE; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-line { height: 18rpx; margin-top: 12rpx; border-radius: 999rpx; background: #E1E3DE; animation: skeletonPulse 1.2s ease-in-out infinite; }
.skeleton-line.long { width: 94%; }
.skeleton-line.medium { width: 72%; }
.skeleton-line.short { width: 48%; }

.ai-fallback {
  margin-top: 22rpx;
  padding: 26rpx 18rpx 4rpx;
  border-top: 1rpx solid #E4E3DD;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.ai-fallback.inside {
  margin-top: 0;
  padding: 22rpx;
  border: 1rpx solid #E4CFC8;
  border-radius: 14rpx;
  background: #FAF1EE;
}
.fallback-mark {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 1rpx solid #DDBDB4;
  background: #F6E9E5;
  color: #A95442;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
}
.fallback-title { margin-top: 14rpx; font-size: 25rpx; font-weight: 800; color: #1B2D23; }
.fallback-desc { margin-top: 8rpx; font-size: 20rpx; line-height: 1.55; color: #7D847E; }
.ai-fallback .ai-action-btn { margin-top: 20rpx; }

/* floating bottom actions */
.page-bottom-space { height: 220rpx; }
.detail-bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 50;
  min-height: 72rpx;
  display: grid;
  grid-template-columns: 112rpx 420rpx 112rpx;
  column-gap: 16rpx;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}
.master-action {
  grid-column: 2;
  width: 420rpx !important;
  min-width: 420rpx !important;
  max-width: 420rpx !important;
  height: 72rpx;
  min-height: 72rpx;
  margin: 0 !important;
  padding: 0 26rpx !important;
  border-radius: 999rpx;
  background: #123A2B;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  text-align: center;
  line-height: 1;
  pointer-events: auto;
  box-shadow: 0 14rpx 34rpx rgba(18,58,43,.22), inset 0 0 0 1rpx rgba(255,255,255,.05);
  box-sizing: border-box;
}
.master-action.is-mastered,
.master-action.is-mastered[disabled] {
  background: #E6EEE9 !important;
  color: #214D39 !important;
  box-shadow: 0 12rpx 30rpx rgba(32,69,51,.12), inset 0 0 0 1rpx rgba(48,91,69,.08);
}
.master-action[disabled] { opacity: 1 !important; }
.master-action-icon {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 2rpx solid #B7E82A;
  color: #B7E82A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 17rpx;
  font-weight: 900;
  flex-shrink: 0;
  box-sizing: border-box;
}
.master-action.is-mastered .master-action-icon {
  border-color: #3E7658;
  background: #3E7658;
  color: #FFFFFF;
}
.master-action-label {
  min-width: 0;
  color: inherit !important;
  font-size: 25rpx;
  font-weight: 780;
  line-height: 1.2;
  white-space: nowrap;
}
.more-action {
  grid-column: 3;
  width: 112rpx !important;
  min-width: 112rpx !important;
  max-width: 112rpx !important;
  height: 68rpx;
  min-height: 68rpx;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx;
  border: 1rpx solid #D8DDD7;
  background: rgba(255,255,252,.98);
  color: #445149;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  pointer-events: auto;
  box-shadow: 0 10rpx 28rpx rgba(31,48,39,.12);
  box-sizing: border-box;
}
.more-action-label {
  display: block;
  color: inherit;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

/* sheets */
.modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 130;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(5,13,8,.60);
}
.decision-sheet,
.more-sheet {
  width: 100%;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #FBFAF6;
  box-shadow: 0 -24rpx 60rpx rgba(0,0,0,.18);
  animation: sheetRise .22s ease-out both;
}
.sheet-handle { width: 66rpx; height: 6rpx; margin: 0 auto 27rpx; border-radius: 999rpx; background: #D1D4CF; }
.decision-kicker { display: block; font-size: 18rpx; font-weight: 750; letter-spacing: 3rpx; color: #738078; }
.decision-kicker.danger { color: #AB5947; }
.decision-title { display: block; margin-top: 9rpx; font-size: 36rpx; font-weight: 820; line-height: 1.25; color: #14271E; }
.decision-desc { display: block; margin-top: 13rpx; font-size: 24rpx; line-height: 1.65; color: #707871; }
.decision-actions { margin-top: 28rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 13rpx; }
.decision-primary,
.decision-secondary,
.decision-danger {
  height: 82rpx;
  min-height: 82rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 780;
  line-height: 1;
}
.decision-primary { background: #123A2B; color: #FFFFFF; }
.decision-secondary { border: 1rpx solid #DADDD7; background: #F3F3EE; color: #445149; }
.decision-danger { background: #B75A47; color: #FFFFFF; }
.more-sheet-title { display: block; font-size: 33rpx; font-weight: 820; color: #14271E; }
.more-sheet-item {
  margin-top: 22rpx;
  min-height: 104rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #F7ECE8;
  border: 1rpx solid #E4D0C9;
}
.more-item-title { display: block; font-size: 26rpx; font-weight: 800; color: #A44F3D; }
.more-item-desc { display: block; margin-top: 6rpx; font-size: 20rpx; line-height: 1.45; color: #947267; }
.more-item-arrow { font-family: Arial,sans-serif; font-size: 42rpx; color: #AC5946; }
.more-cancel { width: 100%; min-height: 82rpx; margin-top: 14rpx; border-radius: 18rpx; border: 1rpx solid #DADDD7; background: #F3F3EE; color: #465149; font-size: 25rpx; font-weight: 780; }

.undo-toast-layer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  z-index: 160;
  display: flex;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  transform: translateY(160%);
  opacity: 0;
  pointer-events: none;
  transition: transform .22s ease, opacity .22s ease;
}
.undo-toast-layer.show { transform: translateY(0); opacity: 1; pointer-events: auto; }
.undo-toast {
  flex: none;
  width: 458rpx;
  max-width: calc(100vw - 48rpx);
  min-height: 76rpx;
  padding: 0 14rpx 0 22rpx;
  border-radius: 999rpx;
  background: #0F2D22;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  box-shadow: 0 18rpx 42rpx rgba(15,45,34,.26);
}
.undo-toast-text {
  flex: 0 1 auto;
  min-width: 0;
  white-space: nowrap;
  font-size: 22rpx;
  line-height: 1.4;
  color: rgba(255,255,255,.8);
}
.undo-divider { flex: 0 0 1rpx; width: 1rpx; height: 30rpx; margin: 0 16rpx; background: rgba(255,255,255,.16); }
.undo-action {
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  height: 48rpx;
  min-height: 48rpx;
  margin: 0 !important;
  padding: 0 !important;
  border: 1rpx solid rgba(183,232,42,.58);
  border-radius: 999rpx;
  background: rgba(183,232,42,.08);
  color: #C8F14D;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1;
}
.undo-action::after { border: 0; }
.undo-action-pressed { background: rgba(183,232,42,.16); }

@keyframes skeletonPulse { 0%,100% { opacity: .5; } 50% { opacity: 1; } }
@keyframes switchPulse { 0%,100% { opacity: .35; transform: scale(.8); } 50% { opacity: 1; transform: scale(1); } }
@keyframes sheetRise { from { transform: translateY(42rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 360px) {
  .detail-meta { padding: 20rpx 24rpx 14rpx; }
  .detail-meta-label,
  .detail-meta-separator { display: none; }
  .detail-meta-progress { gap: 10rpx; }
  .detail-progress-dots { gap: 6rpx; }
  .ai-idle { align-items: flex-start; }
  .ai-idle-desc { display: none; }
  .ai-action-btn { padding: 0 15rpx !important; }
}

@media (prefers-reduced-motion: reduce) {
  .loading-hero-line,
  .loading-line,
  .loading-chip,
  .loading-option,
  .skeleton-index,
  .skeleton-title,
  .skeleton-line,
  .switch-dot,
  .loading-spinner,
  .decision-sheet,
  .more-sheet { animation: none !important; }
  .undo-toast-layer { transition: none !important; }
}
