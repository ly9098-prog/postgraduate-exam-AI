  display: block;
  margin: 0;
  color: #153126;
  font-size: 53rpx;
  font-weight: 900;
  line-height: 1.22;
  letter-spacing: -1rpx;
}
.diagnosis-secondary {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}
.diagnosis-chip {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #F0F4EE;
  color: #617068;
