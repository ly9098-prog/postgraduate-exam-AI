page{background:#F5F8FF;color:#17213B}.page{padding:28rpx 28rpx 72rpx}.hero{padding:28rpx 6rpx 24rpx}.eyebrow{display:block;font-size:22rpx;letter-spacing:3rpx;color:#6B7A99;font-weight:700}.title{display:block;margin-top:12rpx;font-size:48rpx;line-height:1.2;font-weight:800}.subtitle{display:block;margin-top:16rpx;color:#66728A;font-size:27rpx;line-height:1.65}.hero-stats{display:flex;margin-top:26rpx;padding:22rpx 26rpx;background:#EAF0FF;border-radius:24rpx}.hero-stat{flex:1}.hero-divider{width:1rpx;background:#C9D5F5;margin:0 24rpx}.stat-number{display:block;font-size:38rpx;font-weight:800}.stat-label{display:block;margin-top:5rpx;color:#68758F;font-size:23rpx}.state-card,.empty{padding:38rpx;background:#fff;border-radius:24rpx;text-align:center;color:#73809A}.state-card.error{color:#9A5260}.retry{margin-top:22rpx;width:220rpx;font-size:26rpx;border-radius:999rpx;background:#17213B;color:#fff}.retry::after{border:0}.subject-list{display:flex;flex-direction:column;gap:22rpx}.subject-card{padding:30rpx;background:#fff;border-radius:28rpx;box-shadow:0 12rpx 40rpx rgba(57,78,126,.07)}.card-pressed{transform:scale(.99);opacity:.9}.subject-head{display:flex;align-items:flex-start;justify-content:space-between}.subject-name{display:block;font-size:32rpx;font-weight:750}.subject-code{display:block;margin-top:6rpx;color:#9AA5BA;font-size:20rpx}.score-box{text-align:right}.score{display:block;font-size:38rpx;font-weight:800}.status{display:inline-block;margin-top:4rpx;font-size:21rpx;padding:4rpx 12rpx;border-radius:999rpx;background:#EEF2F8;color:#66728A}.status-weak{background:#FFF0F1;color:#B64D5F}.status-developing{background:#FFF6E4;color:#9A711E}.status-good,.status-mastered{background:#EAF8F1;color:#287858}.progress{height:12rpx;margin-top:24rpx;background:#EEF2F8;border-radius:99rpx;overflow:hidden}.progress-fill{height:100%;background:#4F7FFF;border-radius:99rpx}.subject-meta,.subject-foot{display:flex;justify-content:space-between;gap:20rpx;margin-top:14rpx;font-size:23rpx;color:#7D889C}.subject-foot{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #EEF1F6}.arrow{color:#405FBC;font-weight:650;white-space:nowrap}.legend{margin-top:30rpx;padding:28rpx;background:#fff;border-radius:24rpx}.legend-title{display:block;font-size:28rpx;font-weight:750;margin-bottom:14rpx}.legend-row{display:flex;justify-content:space-between;gap:28rpx;padding:11rpx 0;font-size:23rpx;color:#7A8599}.legend-row text:first-child{color:#27334C;font-weight:650;min-width:150rpx}
