page {
  min-height: 100%;
  background: #F5F7F0;
  color: #183025;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 28rpx 46rpx 96rpx;
  overflow: hidden;
  box-sizing: border-box;
  background:
    radial-gradient(ellipse at 106% 19%, rgba(153, 178, 127, .15) 0%, rgba(153, 178, 127, .08) 31%, transparent 58%),
    radial-gradient(ellipse at -12% 7%, rgba(197, 211, 181, .13) 0%, transparent 42%),
    linear-gradient(180deg, #FAFBF6 0%, #F4F7EF 72%, #F6F8F2 100%);
}

/* Header / reference composition */
.hero {
  position: relative;
  z-index: 1;
  min-height: 292rpx;
  padding: 34rpx 8rpx 28rpx;
  overflow: visible;
}

.hero::before {
  content: '';
  position: absolute;
  left: -150rpx;
  top: -58rpx;
  width: 470rpx;
  height: 210rpx;
  border-radius: 0 0 58% 48%;
  background: rgba(221, 230, 210, .18);
  transform: rotate(8deg);
  pointer-events: none;
}

.hero-orbit {
  position: absolute;
  z-index: 0;
  pointer-events: none;
}

.orbit-one {
  right: -188rpx;
  top: 66rpx;
  width: 520rpx;
  height: 290rpx;
  border-radius: 58% 42% 56% 44% / 48% 53% 47% 52%;
  background: rgba(173, 194, 151, .11);
  transform: rotate(-19deg);
}

.orbit-two {
  right: -62rpx;
  top: 112rpx;
  width: 245rpx;
  height: 154rpx;
  border-radius: 50%;
  background: rgba(184, 203, 164, .11);
  transform: rotate(-12deg);
}

.hero-note {
  position: absolute;
  z-index: 2;
  right: -1rpx;
  top: 4rpx;
  color: #6F826F;
  font-size: 18rpx;
  line-height: 1.2;
  font-style: italic;
  letter-spacing: .5rpx;
  transform: rotate(-7deg);
}

.hero-note::after {
  content: '';
  display: block;
  width: 126rpx;
  height: 1rpx;
  margin: 7rpx 0 0 18rpx;
  background: rgba(91, 117, 89, .72);
  transform: rotate(-3deg);
  transform-origin: left center;
}

.eyebrow,
.title,
.subtitle,
.hero-meta-row {
  position: relative;
  z-index: 2;
}

.eyebrow {
  display: block;
  margin-top: 38rpx;
  color: #849286;
  font-size: 18rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 3.4rpx;
}

.title {
  display: block;
  margin-top: 10rpx;
  color: #163025;
  font-size: 42rpx;
  line-height: 1.16;
  font-weight: 900;
  letter-spacing: -1.4rpx;
}

.subtitle {
  display: block;
  max-width: 650rpx;
  margin-top: 12rpx;
  color: #6D7B72;
  font-size: 20rpx;
  line-height: 1.62;
}

.hero-meta-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}

.syllabus-chip {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 17rpx;
  border-radius: 999rpx;
  background: rgba(235, 240, 229, .92);
  box-shadow: inset 0 0 0 1rpx rgba(192, 204, 186, .20);
  color: #707D73;
  font-size: 17rpx;
  white-space: nowrap;
}

.meta-label { color: #77837A; }
.meta-strong {
  margin-left: 9rpx;
  color: #294737;
  font-weight: 850;
}
.meta-dot {
  margin: 0 5rpx;
  color: #8C978F;
}
.chip-divider {
  width: 1rpx;
  height: 22rpx;
  margin: 0 15rpx;
  background: #C7D0C3;
}

/* States */
.state-card {
  margin: 14rpx 0;
  padding: 42rpx 24rpx;
  border: 1rpx solid #DEE5DB;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  background: rgba(255, 255, 252, .92);
  box-shadow: 0 12rpx 30rpx rgba(39, 61, 45, .04);
  color: #6C786F;
  font-size: 21rpx;
  text-align: center;
}
.state-pulse {
  width: 25rpx;
  height: 25rpx;
  border: 4rpx solid #DCE8D4;
  border-top-color: #5E8454;
  border-radius: 50%;
  animation: spin .9s linear infinite;
}
.state-card.error { color: #8C584D; }
.retry {
  min-width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 16rpx;
  background: #18392A;
  color: #FFF;
  font-size: 21rpx;
}
.retry::after { border: 0; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 2 x 2 mastery cards — tall tactile proportion from the reference */
.subject-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.subject-card {
  position: relative;
  min-width: 0;
  height: 500rpx;
  padding: 30rpx 28rpx 0;
  overflow: hidden;
  border: 1rpx solid rgba(216, 225, 214, .92);
  border-radius: 30rpx;
  background:
    linear-gradient(145deg, rgba(255, 255, 253, .995) 0%, rgba(252, 253, 249, .98) 58%, rgba(248, 251, 246, .97) 100%);
  box-shadow:
    0 16rpx 34rpx rgba(44, 68, 49, .055),
    inset 0 1rpx 0 rgba(255, 255, 255, .86);
  box-sizing: border-box;
  transition: transform .12s ease, opacity .12s ease;
}

.subject-card::before {
  content: '';
  position: absolute;
  right: -82rpx;
  top: -84rpx;
  width: 188rpx;
  height: 188rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(144, 169, 128, .055);
  box-shadow: 0 0 0 35rpx rgba(153, 180, 133, .018);
  pointer-events: none;
}

.subject-card::after {
  content: '';
  position: absolute;
  inset: 1rpx;
  border-radius: 29rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.42), transparent 45%, rgba(148,174,130,.018));
  pointer-events: none;
}

.card-pressed {
  transform: scale(.986);
  opacity: .9;
}

.subject-icon-wrap,
.subject-name,
.subject-code,
.subject-mastery,
.subject-foot {
  position: relative;
  z-index: 2;
}

.subject-icon-wrap {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle at 36% 30%, #F7FAF3 0%, #EDF3E8 54%, #E4ECE0 100%);
  box-shadow:
    inset 0 0 0 1rpx rgba(204, 218, 198, .9),
    0 5rpx 12rpx rgba(55, 79, 59, .045);
}

.subject-icon-image {
  width: 66rpx;
  height: 66rpx;
}

.subject-name {
  display: block;
  margin-top: 25rpx;
  overflow: visible;
  color: #1B3024;
  font-size: 28rpx;
  line-height: 1.24;
  font-weight: 900;
  letter-spacing: -.3rpx;
  white-space: nowrap;
}

.subject-code {
  display: block;
  margin-top: 7rpx;
  overflow: hidden;
  color: #869188;
  font-size: 17rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.subject-mastery {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 256rpx;
}

.score {
  display: block;
  min-height: 31rpx;
  color: #20342A;
  font-size: 23rpx;
  line-height: 1.2;
  font-weight: 900;
  text-align: right;
}
.score.is-empty { color: #283D31; }

.progress {
  position: relative;
  height: 12rpx;
  margin-top: 12rpx;
  overflow: visible;
  border-radius: 999rpx;
  background: #DFE5DF;
  box-shadow: inset 0 1rpx 2rpx rgba(66, 89, 68, .04);
}

.progress-dot {
  position: absolute;
  z-index: 2;
  left: 0;
  top: 50%;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #A2B096;
  transform: translateY(-50%);
}

.progress-fill {
  position: relative;
  z-index: 3;
  height: 100%;
  min-width: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #728D69 0%, #94AC83 100%);
}

.subject-progress-text {
  display: block;
  margin-top: 25rpx;
  color: #7C8880;
  font-size: 18rpx;
  line-height: 1.3;
}

.subject-foot {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  min-height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.status {
  min-width: 0;
  overflow: hidden;
  color: #56675D;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.status.status-weak { color: #8D6256; }
.status.status-mastered { color: #49684A; }

.subject-foot-arrow {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #DCE6D6;
  box-shadow: inset 0 0 0 1rpx rgba(180, 197, 174, .65);
  color: #37553D;
  font-size: 27rpx;
  line-height: 1;
  font-weight: 900;
}

.empty {
  grid-column: 1 / -1;
  padding: 52rpx 20rpx;
  color: #8B958D;
  font-size: 21rpx;
  text-align: center;
}

/* Footer ornament */
.map-footer {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  margin-top: 52rpx;
  color: #9BA59D;
  font-size: 11rpx;
  line-height: 1;
  letter-spacing: 3.2rpx;
}

.footer-line {
  width: 78rpx;
  height: 1rpx;
  background: #C5D0C2;
}

.mountain {
  position: relative;
  width: 56rpx;
  height: 30rpx;
  margin-right: -5rpx;
}

.peak {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 27rpx solid #C8D3C3;
  filter: drop-shadow(0 5rpx 5rpx rgba(61, 81, 64, .05));
}
.p1 { left: 0; border-left-width: 12rpx; border-right-width: 12rpx; border-bottom-width: 19rpx; border-bottom-color: #D7E0D3; }
.p2 { left: 16rpx; border-bottom-color: #BCCAB7; }
.p3 { right: -1rpx; border-left-width: 12rpx; border-right-width: 12rpx; border-bottom-width: 18rpx; border-bottom-color: #D3DCCF; }

@media (max-width: 360px) {
  .page {
    padding-left: 36rpx;
    padding-right: 36rpx;
  }
  .hero { padding-left: 4rpx; padding-right: 4rpx; }
  .title { font-size: 39rpx; }
  .subtitle { font-size: 19rpx; }
  .subject-grid { gap: 16rpx; }
  .subject-card {
    height: 478rpx;
    padding-left: 24rpx;
    padding-right: 24rpx;
  }
  .subject-icon-wrap { width: 76rpx; height: 76rpx; }
  .subject-icon-image { width: 61rpx; height: 61rpx; }
  .subject-name { font-size: 25rpx; }
  .subject-code { font-size: 15rpx; }
  .subject-mastery { left: 24rpx; right: 24rpx; top: 242rpx; }
  .subject-foot { left: 24rpx; right: 24rpx; bottom: 21rpx; }
  .status { font-size: 18rpx; }
}
