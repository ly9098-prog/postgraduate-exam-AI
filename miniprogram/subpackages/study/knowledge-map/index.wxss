}
.subject-name {
  min-width: 0;
  margin-top: 0;
  flex: 1;
  color: #1B3024;
  font-size: 25rpx;
  line-height: 1.25;
}
.subject-name-row .score {
  flex: 0 0 auto;
  color: #23392C;
  font-size: 20rpx;
  font-weight: 900;
}
.subject-name-row .score.is-empty { color: #96A099; }
.subject-code {
  margin-top: 5rpx;
  color: #849087;
  font-size: 16rpx;
}
.progress {
  height: 11rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #E4EAE5;
}
.progress::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(101,129,92,.28);
  z-index: 3;
}
.progress-fill {
  position: relative;
  z-index: 4;
  min-width: 0;
  background: linear-gradient(90deg,#698660 0%,#A0B88B 100%);
}
.subject-progress-text {
  margin-top: 15rpx;
  color: #7D8981;
  font-size: 17rpx;
}
.subject-foot {
  left: 20rpx;
  right: 20rpx;
  bottom: 0;
  min-height: 65rpx;
  border-top-color: #E7EBE7;
  color: #68766C;
  font-size: 17rpx;
}
.subject-foot .status { font-size: 17rpx; font-weight: 760; }
.subject-foot-arrow {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #DDE7D7;
  color: #426143;
  font-size: 22rpx;
  font-weight: 900;
}
/* Reference has a calmer, centered composition before mastery data exists. */
.subject-card.no-data .subject-card-top { justify-content: center; }
.subject-card.no-data .subject-name-row {
  justify-content: center;
  gap: 9rpx;
  margin-top: 25rpx;
  text-align: center;
}
.subject-card.no-data .subject-name {
  flex: 0 1 auto;
  max-width: calc(100% - 38rpx);
  text-align: center;
}
.subject-card.no-data .subject-code { text-align: center; }
.subject-card.no-data .subject-progress-text {
  margin-top: 47rpx;
  text-align: center;
}
.subject-card.no-data .subject-foot { text-align: left; }
.map-footer { margin-top: 31rpx; gap: 17rpx; }
@media(max-width:360px) {
  .page { padding-left: 20rpx; padding-right: 20rpx; }
  .hero { padding-left: 8rpx; padding-right: 8rpx; }
  .title { font-size: 40rpx; }
  .subtitle { font-size: 20rpx; }
  .subject-grid { gap: 12rpx; }
  .subject-card { min-height: 330rpx; padding-left: 17rpx; padding-right: 17rpx; }
  .subject-icon { width: 58rpx; height: 58rpx; }
  .subject-name { font-size: 23rpx; }
  .subject-name-row .score { font-size: 19rpx; }
  .subject-foot { left: 17rpx; right: 17rpx; }
  .subject-card.no-data .subject-progress-text { margin-top: 43rpx; }
}
