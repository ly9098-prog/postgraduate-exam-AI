page { background:#F5F6F0; color:#192B21; }
.page { min-height:100vh; padding:24rpx 26rpx 74rpx; overflow:hidden; background:radial-gradient(circle at 90% 13%,rgba(151,181,124,.10),transparent 25%),linear-gradient(180deg,#FAFAF5 0%,#F4F7EF 100%); box-sizing:border-box; }
.hero { position:relative; overflow:hidden; padding:34rpx 12rpx 34rpx; }
.hero-orbit { position:absolute; border-radius:50%; pointer-events:none; }
.orbit-one { right:-110rpx; top:-54rpx; width:300rpx; height:300rpx; border:1rpx solid rgba(105,139,89,.08); box-shadow:0 0 0 42rpx rgba(105,139,89,.025),0 0 0 86rpx rgba(105,139,89,.016); }
.orbit-two { right:42rpx; top:44rpx; width:92rpx; height:92rpx; background:rgba(159,184,128,.07); }
.hero-note { position:absolute; right:18rpx; top:20rpx; z-index:2; color:#6C806D; font-size:18rpx; font-style:italic; transform:rotate(-7deg); }
.hero-note::after { content:''; display:block; width:126rpx; height:1rpx; margin-top:4rpx; background:#788F77; transform:rotate(-3deg); transform-origin:right center; }
.eyebrow { position:relative; z-index:1; display:block; margin-top:30rpx; color:#7C8D80; font-size:18rpx; font-weight:800; letter-spacing:3rpx; }
.title { position:relative; z-index:1; display:block; margin-top:10rpx; color:#193126; font-size:43rpx; line-height:1.18; font-weight:930; letter-spacing:-1rpx; }
.subtitle { position:relative; z-index:1; display:block; max-width:650rpx; margin-top:15rpx; color:#68766D; font-size:22rpx; line-height:1.65; }
.hero-meta-row { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:14rpx; margin-top:22rpx; }
.syllabus-chip { display:inline-flex; align-items:center; gap:10rpx; min-width:0; padding:10rpx 15rpx; border-radius:999rpx; background:#EFF3EB; color:#66736A; font-size:18rpx; }
.chip-divider { width:1rpx; height:17rpx; background:#C9D2C7; }.syllabus-name{color:#2E4C38;font-weight:820}
.hero-observation { display:flex; align-items:center; gap:8rpx; color:#7C887F; font-size:17rpx; white-space:nowrap; }.observation-dot{width:5rpx;height:5rpx;border-radius:50%;background:#92A38D}
.state-card { margin:16rpx 4rpx; padding:40rpx 24rpx; border:1rpx solid #E0E6DD; border-radius:24rpx; display:flex; flex-direction:column; align-items:center; gap:18rpx; background:rgba(255,255,253,.85); color:#6C786F; font-size:22rpx; text-align:center; }
.state-pulse { width:24rpx;height:24rpx;border:4rpx solid #DCE8D4;border-top-color:#5E8454;border-radius:50%;animation:spin .9s linear infinite; }.state-card.error{color:#8C584D}.retry{min-width:180rpx;height:64rpx;line-height:64rpx;border-radius:16rpx;background:#18392A;color:#FFF;font-size:21rpx}.retry::after{border:0}@keyframes spin{to{transform:rotate(360deg)}}
.subject-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.subject-card { position:relative; min-width:0; min-height:330rpx; padding:21rpx 19rpx 0; overflow:hidden; border:1rpx solid #E2E7E0; border-radius:27rpx; background:rgba(255,255,253,.93); box-shadow:0 12rpx 30rpx rgba(35,60,44,.055); box-sizing:border-box; transition:transform .12s ease,opacity .12s ease; }
.subject-card::after { content:''; position:absolute; right:-44rpx; top:-52rpx; width:118rpx; height:118rpx; border-radius:50%; background:rgba(139,171,112,.035); pointer-events:none; }
.card-pressed{transform:scale(.985);opacity:.88}.subject-card-top{display:flex;align-items:center;justify-content:space-between;gap:12rpx}
.subject-icon { position:relative; width:60rpx;height:60rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;overflow:hidden;background:radial-gradient(circle at 35% 30%,#EEF5E9 0 40%,#D7E4D0 100%);box-shadow:inset 0 0 0 1rpx #D5E0D0; }
.subject-icon-fallback{color:#48644C;font-size:22rpx;font-weight:900}.subject-icon-shape{display:none;position:absolute;box-sizing:border-box}.subject-icon.data .subject-icon-fallback,.subject-icon.chip .subject-icon-fallback,.subject-icon.code .subject-icon-fallback,.subject-icon.network .subject-icon-fallback{display:none}
.subject-icon.data .subject-icon-shape{display:block;left:17rpx;width:26rpx;height:9rpx;border:2rpx solid #58725A;border-radius:50%}.subject-icon.data .one{top:14rpx}.subject-icon.data .two{top:24rpx}.subject-icon.data .three{top:34rpx}
.subject-icon.chip .one{display:block;inset:16rpx;border:3rpx solid #5D755E;border-radius:6rpx}.subject-icon.chip .two{display:block;left:28rpx;top:20rpx;width:4rpx;height:20rpx;border-radius:999rpx;background:#5D755E}
.subject-icon.code .one,.subject-icon.code .two{display:block;top:20rpx;width:16rpx;height:16rpx;border-top:3rpx solid #58725A;border-left:3rpx solid #58725A}.subject-icon.code .one{left:14rpx;transform:rotate(-45deg)}.subject-icon.code .two{right:14rpx;transform:rotate(135deg)}
.subject-icon.network .one,.subject-icon.network .two,.subject-icon.network .three{display:block;width:9rpx;height:9rpx;border-radius:50%;background:#58725A}.subject-icon.network .one{left:26rpx;top:12rpx}.subject-icon.network .two{left:14rpx;bottom:14rpx}.subject-icon.network .three{right:14rpx;bottom:14rpx}.subject-icon.network::before,.subject-icon.network::after{content:'';position:absolute;top:26rpx;width:21rpx;height:2rpx;background:#58725A}.subject-icon.network::before{left:16rpx;transform:rotate(-52deg)}.subject-icon.network::after{right:16rpx;transform:rotate(52deg)}
.subject-mini-arrow{width:34rpx;height:34rpx;border:1rpx solid #D9E1D7;border-radius:10rpx;display:flex;align-items:center;justify-content:center;color:#48644C;font-size:28rpx;line-height:1}.subject-name{display:block;margin-top:18rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#1C3024;font-size:24rpx;font-weight:900}.subject-code{display:block;margin-top:5rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#869189;font-size:16rpx}
.subject-score-row{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin-top:22rpx}.status{color:#66736B;font-size:18rpx;font-weight:700}.status.status-weak{color:#A65A49}.status.status-mastered{color:#3D6E3B}.score{color:#20352A;font-size:21rpx;font-weight:900}
.progress{height:10rpx;margin-top:11rpx;overflow:hidden;border-radius:999rpx;background:#E5EAE5}.progress-fill{height:100%;min-width:0;border-radius:inherit;background:linear-gradient(90deg,#678560,#9FB987)}.subject-progress-text{display:block;margin-top:15rpx;color:#7E8982;font-size:17rpx}
.subject-foot{position:absolute;left:19rpx;right:19rpx;bottom:0;min-height:68rpx;border-top:1rpx solid #E9ECE8;display:flex;align-items:center;justify-content:space-between;gap:10rpx;color:#68766C;font-size:17rpx}.subject-foot text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.subject-foot-arrow{flex:0 0 auto;color:#395B40;font-size:25rpx;font-weight:800}
.empty{grid-column:1/-1;padding:40rpx;text-align:center;color:#8B958D;font-size:21rpx}.map-footer{display:flex;align-items:flex-end;justify-content:center;gap:16rpx;margin-top:34rpx;color:#9AA39B;font-size:13rpx;letter-spacing:3rpx}.footer-line{width:66rpx;height:1rpx;margin-bottom:7rpx;background:#CBD3CA}.mountain{position:relative;width:64rpx;height:30rpx}.peak{position:absolute;bottom:0;width:0;height:0;border-left:18rpx solid transparent;border-right:18rpx solid transparent;border-bottom:28rpx solid rgba(117,140,110,.28)}.peak.p1{left:0}.peak.p2{left:20rpx;border-left-width:15rpx;border-right-width:15rpx;border-bottom-width:22rpx;border-bottom-color:rgba(95,126,91,.36)}.peak.p3{left:34rpx;border-left-width:12rpx;border-right-width:12rpx;border-bottom-width:17rpx;border-bottom-color:rgba(145,164,137,.3)}
@media(max-width:360px){.page{padding-left:20rpx;padding-right:20rpx}.subject-grid{gap:12rpx}.subject-card{min-height:314rpx;padding-left:16rpx;padding-right:16rpx}.subject-foot{left:16rpx;right:16rpx}.title{font-size:39rpx}.hero-observation{display:none}.hero-note{font-size:16rpx}}
@media(prefers-reduced-motion:reduce){.state-pulse{animation:none}.subject-card{transition:none}}
