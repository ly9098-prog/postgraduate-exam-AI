@import "../../utils/katex/katex.wxss";
@import "../../utils/katex/katex-fonts-1.wxss";
@import "../../utils/katex/katex-fonts-2.wxss";
@import "../../utils/katex/katex-fonts-3.wxss";

.formula-card-wrap { padding: 0; color: #23483C; }

.fc-header {
  padding: 2rpx 0 24rpx;
  border-bottom: 1rpx solid #D8EEE6;
}

.fc-kicker,
.fc-section-kicker,
.fc-collapse-kicker {
  display: block;
  color: #507568;
  font-size: 17rpx;
  line-height: 1.35;
  font-weight: 900;
  letter-spacing: 2.7rpx;
}

.fc-title {
  display: block;
  margin-top: 8rpx;
  color: #23483C;
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 950;
  letter-spacing: -.5rpx;
}

.fc-tags { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 15rpx; }
.fc-tag { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 19rpx; line-height: 1.35; font-weight: 850; }
.fc-tag-basic { background: #EAF9F4; color: #3A6F5B; }
.fc-tag-high_frequency { background: #FFF0D8; color: #A96518; }
.fc-tag-error_prone { background: #F8E4DF; color: #B24F43; }
.fc-tag-must_memorize { background: #EAE7EF; color: #6E5C82; }

.fc-formula-section {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 8%, rgba(126,216,181,.15), rgba(126,216,181,0) 30%),
    #F6FCF9;
}

.fc-section-heading { margin-bottom: 18rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.fc-section-heading.compact { align-items: center; }
.fc-section-title { display: block; margin-top: 4rpx; color: #23483C; font-size: 28rpx; line-height: 1.35; font-weight: 950; }
.fc-core-mark { width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #3A6F5B; color: #7ED8B5; display: flex; align-items: center; justify-content: center; font-size: 26rpx; font-weight: 950; }

.fc-formula-block { padding: 20rpx 18rpx; border-radius: 22rpx; background: rgba(255,255,255,.72); border: 1rpx solid rgba(216,238,230,.9); }
.fc-formula-block + .fc-formula-block { margin-top: 13rpx; }
.fc-block-head { min-height: 34rpx; margin-bottom: 8rpx; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.fc-block-label { display: block; color: #507568; font-size: 22rpx; line-height: 1.45; font-weight: 800; }
.fc-formula-scroll-hint { flex-shrink: 0; color: #507568; font-size: 17rpx; line-height: 1.35; }
.fc-formula-scroll-shell { position: relative; width: 100%; overflow: hidden; border-radius: 16rpx; }
.fc-formula-scroll-shell.is-scrollable { background: linear-gradient(90deg, rgba(234,249,244,.72), rgba(255,255,255,.1) 14%, rgba(255,255,255,.1) 86%, rgba(234,249,244,.72)); }
.fc-formula-scroll { width: 100%; overflow: hidden; }
.fc-formula-canvas { min-width: 100%; box-sizing: border-box; text-align: center; }
.fc-formula-canvas.is-long { text-align: left; }
.fc-formula-render { display: block; width: 100%; color: #23483C; box-sizing: border-box; }
.fc-scroll-edge { position: absolute; top: 0; bottom: 0; z-index: 3; width: 30rpx; pointer-events: none; }
.fc-scroll-edge-left { left: 0; background: linear-gradient(90deg, rgba(255,255,255,.88), rgba(255,255,255,0)); }
.fc-scroll-edge-right { right: 0; background: linear-gradient(270deg, rgba(255,255,255,.88), rgba(255,255,255,0)); }
.fc-block-note { display: block; margin-top: 9rpx; color: #507568; font-size: 21rpx; line-height: 1.55; }

.fc-graph-section {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 30rpx;
  background: #F6FCF9;
}
.fc-preview-hint { color: #507568; font-size: 18rpx; }
/* Fixed-ratio viewport: height comes from the inline padding-bottom (image
   aspect ratio, clamped 25%–125%), so thumbnail→master swaps cannot shift
   layout and widthFix cannot stretch the card. */
.fc-graph-viewport {
  position: relative;
  width: 100%;
  overflow: hidden;
  border: 1rpx solid #D8EEE6;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}
.fc-graph-image {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
  background: #FFFFFF;
}
/* Hidden preloader for the full-size graph: kept off-screen rather than
   display:none so the native image fetch actually starts. */
.fc-graph-preload {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 10rpx;
  height: 10rpx;
}
.fc-graph-error { border-color: #E5E6E0; background: #F6FCF9; }
.fc-graph-fallback { padding: 30rpx 0; text-align: center; }
.fc-graph-fallback-title { display: block; color: #507568; font-size: 22rpx; font-weight: 800; }
.fc-graph-fallback-desc { display: block; margin-top: 6rpx; color: #507568; font-size: 18rpx; }

.fc-reading-section {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #D8EEE6;
  border-radius: 28rpx;
  background: #F6FCF9;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.fc-reading-section.conditions { background: #EAF9F4; border-color: #D8EEE6; }
.fc-section-index { width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #FFFFFF; color: #507568; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 18rpx; font-weight: 950; font-variant-numeric: tabular-nums; }
.fc-reading-section.conditions .fc-section-index { color: #3A6F5B; }
.fc-section-copy { min-width: 0; flex: 1; }
.fc-section-copy .fc-section-title { margin-bottom: 10rpx; }
.fc-section-copy .fc-rich-text { color: #23483C; font-size: 25rpx; line-height: 1.72; }

.fc-collapse { margin-top: 20rpx; border: 1rpx solid #D8EEE6; border-radius: 28rpx; background: #F6FCF9; overflow: hidden; }
.fc-error-collapse { border-color: #E8D4CB; background: #F8EFEB; }
.fc-collapse-header { min-height: 92rpx; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; transition: opacity .14s ease; }
.fc-collapse-kicker { font-size: 15rpx; letter-spacing: 2.2rpx; }
.fc-collapse-kicker.danger { color: #B25A47; }
.fc-collapse-title { display: block; margin-top: 4rpx; color: #23483C; font-size: 27rpx; line-height: 1.35; font-weight: 900; }
.fc-collapse-arrow { position: relative; width: 34rpx; height: 34rpx; flex-shrink: 0; border-radius: 50%; background: #EAF9F4; }
.fc-collapse-arrow::before { content: ''; position: absolute; left: 11rpx; top: 9rpx; width: 9rpx; height: 9rpx; border-right: 3rpx solid #507568; border-bottom: 3rpx solid #507568; transform: rotate(45deg); transition: transform .2s ease, top .2s ease; }
.fc-collapse-arrow.expanded::before { top: 13rpx; transform: rotate(-135deg); }
.fc-collapse-body { max-height: 0; overflow: hidden; opacity: 0; transition: max-height .22s ease, opacity .18s ease; }
.fc-collapse-body.open { max-height: 6000rpx; opacity: 1; }
.fc-collapse-content { margin: 0 20rpx 20rpx; padding: 20rpx; border-radius: 20rpx; background: #FFFFFF; color: #23483C; font-size: 25rpx; line-height: 1.72; }
.fc-collapse-content.error-content { background: #FFF9F6; border: 1rpx solid #EEDBD3; }
.fc-pressed { opacity: .65; }

.fc-example { margin: 0 20rpx 18rpx; padding: 22rpx; border: 1rpx solid #D8EEE6; border-radius: 24rpx; background: #FFFFFF; }
.fc-example-head { margin-bottom: 14rpx; display: flex; align-items: center; gap: 10rpx; }
.fc-example-index { width: 46rpx; height: 40rpx; border-radius: 14rpx; background: #3A6F5B; color: #7ED8B5; display: flex; align-items: center; justify-content: center; font-size: 17rpx; font-weight: 950; font-variant-numeric: tabular-nums; }
.fc-example-label { color: #507568; font-size: 21rpx; font-weight: 900; }
.fc-example-detail { margin-top: 16rpx; padding: 16rpx; border-radius: 18rpx; background: #F6FCF9; }
.fc-example-detail.answer { background: #EDF7F0; }
.fc-example-detail.error { background: #FAECE8; }
.fc-example-detail-label { display: block; margin-bottom: 7rpx; color: #507568; font-size: 20rpx; font-weight: 900; }
.fc-example-detail.answer .fc-example-detail-label { color: #3A6F5B; }
.fc-example-detail.error .fc-example-detail-label { color: #B45B48; }

@media (prefers-reduced-motion: reduce) {
  .fc-collapse-header,
  .fc-collapse-arrow::before,
  .fc-collapse-body { transition: none !important; }
}

/* ==================== Phase 2.3 flatter editorial formula card ==================== */
.fc-header {
  position: relative;
  padding: 2rpx 78rpx 24rpx 0;
}

.fc-formula-section {
  margin-top: 22rpx;
  padding: 22rpx 20rpx;
  border: 0;
  border-radius: 25rpx;
  background:
    linear-gradient(145deg, rgba(238,245,226,.92), rgba(247,249,242,.96));
}
.fc-core-mark {
  width: 50rpx;
  height: 50rpx;
  border-radius: 17rpx;
  box-shadow: 0 6rpx 16rpx rgba(23,52,38,.08);
}

.fc-formula-block {
  padding: 18rpx 0 20rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.fc-formula-block:first-of-type { padding-top: 8rpx; }
.fc-formula-block + .fc-formula-block {
  margin-top: 0;
  border-top: 1rpx solid rgba(79,104,87,.12);
}
.fc-block-head { margin-bottom: 4rpx; }
.fc-formula-scroll-shell,
.fc-formula-scroll-shell.is-scrollable {
  overflow: hidden;
  border-radius: 0;
  background: transparent;
}
.fc-formula-scroll {
  width: 100%;
  min-height: 92rpx;
}
.fc-formula-canvas {
  min-width: 100%;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.fc-formula-canvas.is-long { justify-content: flex-start; }
.fc-formula-render {
  flex: 0 0 auto;
  min-width: 100%;
}
.fc-scroll-edge { width: 24rpx; }
.fc-scroll-edge-left { background: linear-gradient(90deg, rgba(242,246,235,.96), rgba(242,246,235,0)); }
.fc-scroll-edge-right { background: linear-gradient(270deg, rgba(242,246,235,.96), rgba(242,246,235,0)); }
.fc-block-note { margin-top: 4rpx; }

.fc-graph-section,
.fc-reading-section,
.fc-reading-section.conditions,
.fc-collapse {
  margin-top: 0;
  padding: 26rpx 2rpx 0;
  border: 0;
  border-top: 1rpx solid #D8EEE6;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}
.fc-graph-section { margin-top: 26rpx; }
.fc-reading-section {
  margin-top: 26rpx;
  display: flex;
  align-items: flex-start;
}
.fc-section-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #F6FCF9;
}
.fc-collapse {
  overflow: visible;
  margin-top: 25rpx;
}
.fc-error-collapse {
  border-color: #E7D9D2;
  background: transparent;
}
.fc-collapse-header {
  min-height: 82rpx;
  padding: 0 2rpx;
}
.fc-collapse-content {
  margin: 0 0 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #F6FCF9;
}
.fc-collapse-content.error-content {
  background: #FCF5F1;
  border: 0;
}

@media (prefers-reduced-motion: reduce) {
  .fc-formula-scroll { scroll-behavior: auto; }
}

/* ==================== Phase 2.4 stable natural-width math ==================== */
.fc-formula-scroll-shell,
.fc-formula-scroll-shell.is-scrollable {
  width: 100%;
  overflow: hidden;
  background: transparent;
}

.fc-formula-scroll {
  width: 100%;
  min-height: 94rpx;
  overflow: hidden;
  white-space: nowrap;
}

.fc-formula-canvas,
.fc-formula-canvas.is-long {
  width: auto !important;
  min-width: 100%;
  min-height: 94rpx;
  padding: 12rpx 26rpx 16rpx;
  display: inline-table;
  vertical-align: middle;
  text-align: center !important;
  box-sizing: border-box;
  white-space: nowrap;
}

.fc-formula-render {
  display: inline-block;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  vertical-align: middle;
  white-space: nowrap;
}

.fc-math-html {
  display: inline-block !important;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  vertical-align: middle;
}

.fc-formula-scroll-hint {
  max-width: 250rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fc-section-copy .fc-rich-text,
.fc-collapse-content .fc-rich-text,
.fc-example .fc-rich-text {
  word-break: normal;
  overflow-wrap: break-word;
}
.fc-formula-canvas.is-compact .fc-formula-render {
  font-size: .92em;
}


/* ==================== Formula reader rendering hotfix ====================
 * Render one complete KaTeX tree inside a native rich-text element. This avoids
 * deep KaTeX descendants crossing recursive custom-component boundaries, which
 * caused duplicated glyphs, missing fragments and vertical stacking on Android.
 */
.fc-formula-scroll {
  width: 100%;
  min-height: 94rpx;
  overflow: hidden;
  white-space: nowrap;
}

.fc-formula-track,
.fc-formula-track.is-long {
  display: inline-block;
  min-width: 100%;
  min-height: 94rpx;
  padding: 12rpx 26rpx 16rpx;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
  vertical-align: middle;
}

.fc-formula-track.is-long { text-align: left; }

.fc-formula-rich {
  display: inline-block;
  width: auto;
  max-width: none;
  color: #23483C;
  white-space: nowrap;
  vertical-align: middle;
  line-height: 1.2;
}

.fc-formula-rich .katex {
  display: inline-block;
  width: auto;
  max-width: none;
  white-space: nowrap;
}

.fc-formula-rich .katex-html,
.fc-formula-rich .base {
  white-space: nowrap;
}

.fc-formula-track.is-compact .fc-formula-rich { font-size: .92em; }

.fc-rich-text {
  display: block;
  width: 100%;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  white-space: normal;
  word-break: normal;
  overflow-wrap: break-word;
}

.fc-rich-text .katex {
  display: inline-block;
  max-width: 100%;
  vertical-align: -.08em;
  white-space: nowrap;
}

.fc-section-copy .fc-rich-text,
.fc-collapse-content .fc-rich-text,
.fc-example .fc-rich-text {
  color: #23483C;
  font-size: 25rpx;
  line-height: 1.72;
}

/* ==================== Formula reader visual polish v2 ====================
 * Formula blocks use a centered natural-width layout. Inline formulae in
 * conditions/tips use the same display-style KaTeX scale as core formulae.
 */
.fc-formula-section {
  padding: 22rpx 18rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #EAF9F4 0%, #F6FCF9 100%);
}

.fc-formula-block,
.fc-formula-block:first-of-type {
  padding: 17rpx 14rpx 16rpx;
  border: 1rpx solid rgba(111, 133, 116, .13);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .76);
}

.fc-formula-block + .fc-formula-block {
  margin-top: 14rpx;
  border-top: 1rpx solid rgba(111, 133, 116, .13);
}

.fc-block-head {
  min-height: 32rpx;
  margin-bottom: 3rpx;
  padding: 0 6rpx;
}

.fc-block-label {
  color: #507568;
  font-size: 21rpx;
  letter-spacing: .2rpx;
}

.fc-formula-scroll-hint {
  max-width: 230rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(231, 237, 227, .86);
  color: #507568;
  font-size: 16rpx;
}

.fc-formula-scroll {
  min-height: 112rpx;
}

.fc-formula-track,
.fc-formula-track.is-long {
  min-width: 100%;
  min-height: 112rpx;
  padding: 20rpx 24rpx 22rpx;
  text-align: center;
}

/* A long natural-width formula must start at the left edge of the scroll area.
 * Centering an overflowing inline-block creates an unreachable negative offset,
 * which is why the integral/equality before a cases brace disappeared. */
.fc-formula-track.is-long {
  text-align: left !important;
}

.fc-formula-scroll-shell.is-multiline,
.fc-formula-scroll.is-multiline,
.fc-formula-track.is-multiline {
  min-height: 190rpx;
}

.fc-formula-scroll-shell.has-many-lines,
.fc-formula-scroll.has-many-lines,
.fc-formula-track.has-many-lines {
  min-height: 236rpx;
}

.fc-formula-track.is-multiline {
  padding-top: 28rpx;
  padding-bottom: 30rpx;
  vertical-align: top;
}

.fc-formula-track.is-multiline.is-long {
  padding-left: 28rpx;
  padding-right: 36rpx;
}

.fc-formula-rich {
  font-size: 28rpx;
  line-height: 1.18;
}

.fc-formula-track.is-compact .fc-formula-rich {
  font-size: 25rpx;
}

.fc-formula-track.is-dense .fc-formula-rich {
  font-size: 23rpx;
}

.fc-scroll-edge { width: 18rpx; }
.fc-scroll-edge-left { display: none; }
.fc-scroll-edge-right {
  background: linear-gradient(270deg, rgba(244, 247, 240, .96), rgba(244, 247, 240, 0));
}

.fc-block-note {
  margin: 2rpx 6rpx 0;
  color: #507568;
}

.fc-rich-text {
  line-height: 1.92;
}

.fc-rich-text .katex {
  display: inline-block;
  width: auto;
  max-width: none;
  font-size: 1.34em;
  line-height: 1.18;
  vertical-align: middle;
  white-space: nowrap;
}

.fc-rich-text .katex-html,
.fc-rich-text .base {
  white-space: nowrap;
}

/* JSON-encoded conditions / symbols / conclusions / tips are converted into
 * semantic rows before entering rich-text. These styles reproduce the admin
 * detail page's list treatment without exposing the original JSON source. */
.fc-rich-text .fc-structured-list {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.fc-rich-text .fc-structured-row {
  display: block;
  position: relative;
  margin-top: 12rpx;
  padding: 0;
  box-sizing: border-box;
}

.fc-rich-text .fc-structured-row.is-first { margin-top: 0; }

.fc-rich-text .fc-structured-list.is-bulleted .fc-structured-row {
  padding-left: 26rpx;
}

.fc-rich-text .fc-structured-marker {
  position: absolute;
  left: 2rpx;
  top: 0;
  color: #507568;
  font-weight: 900;
}

.fc-rich-text .fc-structured-primary { color: inherit; }
.fc-rich-text .fc-structured-note { color: #507568; }

.fc-section-copy .fc-rich-text,
.fc-collapse-content .fc-rich-text,
.fc-example .fc-rich-text {
  line-height: 1.92;
}

.fc-collapse-content,
.fc-collapse-content.error-content {
  padding-top: 17rpx;
  padding-bottom: 17rpx;
}

/* Grouped identities wrap naturally instead of exposing a clipped formula row. */
.fc-formula-group {
  min-height: 108rpx;
  padding: 13rpx 12rpx 17rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  column-gap: 30rpx;
  row-gap: 18rpx;
  box-sizing: border-box;
}

.fc-formula-group-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 58rpx;
  padding: 3rpx 2rpx;
  white-space: nowrap;
}

.fc-formula-group-item .fc-formula-rich {
  font-size: 26rpx;
}

/* ==================== Formula reader prose containment v3 ====================
 * Keep prose wrappable and make only the exact KaTeX expression atomic. Long
 * inline expressions scroll inside their own inline box instead of enlarging
 * the page. The math scale matches the core formula area more closely.
 */
.fc-reading-section,
.fc-section-copy,
.fc-collapse-content,
.fc-example,
.fc-example-detail {
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
}

.fc-reading-section,
.fc-section-copy,
.fc-collapse-content,
.fc-example-detail {
  overflow: hidden;
}

.fc-rich-text {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
}

.fc-rich-text .katex {
  font-size: 1.12em;
  line-height: 1.22;
  vertical-align: middle;
}

/* The card title may contain mixed prose and LaTeX (for example, e^x展开). */
.fc-title-rich {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  line-height: 1.28;
}

.fc-title-rich .katex {
  display: inline-block;
  width: auto;
  max-width: 100%;
  font-size: 1em;
  line-height: 1.18;
  vertical-align: middle;
  white-space: nowrap;
}

/* Formula-block labels may mix prose and LaTeX, e.g. e^x展开. */
.fc-block-label-rich {
  flex: 1;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
}

.fc-block-label-rich .katex {
  display: inline-block;
  width: auto;
  max-width: 100%;
  font-size: 1em;
  line-height: 1.18;
  vertical-align: middle;
  white-space: nowrap;
}

/* 408 semantic card templates */
.fc-tag-study { background:#EAF9F4; color:#3A6F5B; }
.template-contrast .fc-header { border-bottom-color:#7ED8B5; }
.template-contrast .fc-reading-section { background:linear-gradient(135deg,#F6FCF9,#EAF9F4); }
.template-trap .fc-header { border-bottom-color:#E9CFC8; }
.template-trap .fc-error-collapse { border-color:#E7BDB4; background:#FFF8F6; }
.template-rule .fc-reading-section.conditions { background:#F6FCF9; }
.template-memory .fc-reading-section { background:#F6FCF9; }

/* Mint formula reading: spend horizontal space on mathematics, not nesting. */
.fc-formula-section {
  padding: 22rpx 0 0;
  border: none;
  border-radius: 0;
  background: transparent;
}
.fc-section-heading { padding: 0 2rpx; }
.fc-core-mark { background: #EAF9F4; color: #3A6F5B; }
.fc-formula-block {
  padding: 18rpx 0;
  border: none;
  border-radius: 0;
  background: transparent;
}
.fc-formula-block + .fc-formula-block {
  margin-top: 16rpx;
  border-top: 1rpx solid #D8EEE6;
}
.fc-block-head { align-items: flex-start; margin-bottom: 14rpx; }
.fc-block-label { min-width: 0; flex: 1; color: #3A6F5B; font-size: 24rpx; }
.fc-expand-button {
  flex-shrink: 0;
  min-height: 88rpx;
  margin: -20rpx -10rpx -20rpx 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  color: #3A6F5B;
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 500;
}
.fc-reading-close {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 88rpx;
  margin: -14rpx -12rpx -14rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3A6F5B;
}
.fc-close-icon { position: relative; width: 36rpx; height: 36rpx; }
.fc-close-icon::before,
.fc-close-icon::after {
  content: '';
  position: absolute;
  top: 17rpx;
  left: 0;
  width: 36rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
}
.fc-close-icon::after { transform: rotate(-45deg); }
.fc-control-pressed { opacity: .75; }
.fc-formula-list,
.fc-formula-row { min-width: 0; width: 100%; box-sizing: border-box; }
.fc-formula-row + .fc-formula-row {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #E5F2ED;
}
.fc-formula-line-scroll { width: 100%; white-space: nowrap; }
.fc-reading-line {
  display: inline-block;
  min-width: 100%;
  box-sizing: border-box;
  padding: 18rpx 6rpx 22rpx;
  text-align: center;
  white-space: nowrap;
  vertical-align: top;
}
.fc-reading-line.is-long { text-align: left; }
.fc-reading-line.is-continuation { padding-top: 6rpx; padding-left: 22rpx; }
.fc-reading-line .fc-formula-rich { font-size: 28rpx; color: #23483C; }
.fc-row-scroll-hint { display: block; color: #507568; font-size: 20rpx; line-height: 1.5; padding: 0 6rpx 4rpx; }
.fc-expanded-reading { height: 100%; display: flex; flex-direction: column; color: #23483C; }
.fc-expanded-header {
  flex-shrink: 0;
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #D8EEE6;
  background: #FBFFFD;
}
.fc-expanded-heading { flex: 1; min-width: 0; }
.fc-expanded-title { display: block; font-size: 28rpx; line-height: 1.4; font-weight: 800; }
.fc-expanded-subtitle { display: block; margin-top: 8rpx; color: #507568; font-size: 22rpx; line-height: 1.5; }
.fc-expanded-scroll { flex: none; min-height: 0; }
.fc-expanded-content { padding: 16rpx 18rpx calc(24rpx + env(safe-area-inset-bottom)); }
.fc-expanded-content .fc-reading-line .fc-formula-rich { font-size: 32rpx; }
