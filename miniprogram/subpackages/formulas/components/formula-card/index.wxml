<view class="formula-card-wrap template-{{card.template_type || 'standard'}} study-{{card.study_card_type || 'formula'}}">
  <view class="fc-header">
    <text class="fc-kicker">MEMORY NOTE · {{card.studyCardTypeLabel || '速记'}}</text>
    <rich-text
      class="fc-title fc-title-rich"
      nodes="{{content.titleNodes}}"
      user-select="{{true}}"
    />
    <view class="fc-tags"><text class="fc-tag fc-tag-study">{{card.studyCardTypeLabel || '速记'}}</text>
      <text class="fc-tag {{'fc-tag-' + tag.code}}" wx:for="{{card.tags}}" wx:key="id">{{tag.name}}</text>
    </view>
  </view>

  <view class="fc-formula-section" wx:if="{{formulaBlocks && formulaBlocks.length}}">
    <view class="fc-section-heading compact">
      <view>
        <text class="fc-section-kicker">CORE FORMULA</text>
        <text class="fc-section-title">核心公式</text>
      </view>
      <view class="fc-core-mark">Σ</view>
    </view>

    <view class="fc-formula-block fc-formula-block-{{blockIndex}}" wx:for="{{formulaBlocks}}" wx:for-item="block" wx:for-index="blockIndex" wx:key="_key">
      <view class="fc-block-head">
        <rich-text
          class="fc-block-label fc-block-label-rich"
          wx:if="{{block.labelNodes && block.labelNodes.length}}"
          nodes="{{block.labelNodes}}"
          user-select="{{true}}"
        />
        <view class="fc-expand-button" data-index="{{blockIndex}}" bindtap="openFormulaReading" hover-class="fc-control-pressed" role="button" aria-label="放大查看公式"><text>放大查看</text></view>
      </view>
      <view class="fc-formula-list">
        <view class="fc-formula-row" wx:for="{{block.readingRows}}" wx:for-item="row" wx:key="_key">
          <scroll-view
            class="fc-formula-line-scroll"
            wx:for="{{row.lineItems}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="_key"
            scroll-x enhanced show-scrollbar="{{false}}" bounces="{{false}}"
            bindtouchstart="onFormulaTouchStart" bindtouchend="onFormulaTouchEnd" bindtouchcancel="onFormulaTouchEnd"
          >
            <view class="fc-reading-line {{row.isScrollable ? 'is-long' : ''}} {{lineIndex > 0 ? 'is-continuation' : ''}}">
              <rich-text class="fc-formula-rich" nodes="{{line.mathNodes}}" user-select="{{true}}" />
            </view>
          </scroll-view>
        </view>
      </view>
      <text class="fc-row-scroll-hint" wx:if="{{block.hasWideRows}}">超出屏幕的部分可左右滑动查看</text>
      <rich-text
        class="fc-block-note"
        wx:if="{{block.noteNodes && block.noteNodes.length}}"
        nodes="{{block.noteNodes}}"
        user-select="{{true}}"
      />
    </view>
  </view>

  <view class="fc-graph-section" wx:if="{{(card.card_type === 'function_graph' || card.is_function_graph || card.isFunctionGraph) && (displayGraphUrl || graphImageUrl) && !graphLoadError}}">
    <view class="fc-section-heading">
      <view>
        <text class="fc-section-kicker">FUNCTION GRAPH</text>
        <text class="fc-section-title">函数图像</text>
      </view>
      <text class="fc-preview-hint">点击查看大图</text>
    </view>
    <view class="fc-graph-viewport" style="padding-bottom:{{graphViewportRatio}}%;" bindtap="previewGraph">
      <!-- Progressive load inside a fixed-ratio viewport: the thumbnail and the
           master image letterbox into the same box (aspectFit), so the swap
           never changes the section height and `widthFix` never lets an
           unusually tall master image stretch the card. -->
      <image
        class="fc-graph-image"
        src="{{displayGraphUrl || graphImageUrl}}"
        mode="aspectFit"
        lazy-load
        bindload="onGraphLoad"
        binderror="onGraphError"
      />
      <image
        class="fc-graph-preload"
        wx:if="{{graphImageUrl && displayGraphUrl !== graphImageUrl}}"
        src="{{graphImageUrl}}"
        bindload="onFullGraphLoad"
        binderror="onFullGraphError"
      />
    </view>
  </view>

  <view class="fc-graph-section fc-graph-error" wx:elif="{{(card.card_type === 'function_graph' || card.is_function_graph || card.isFunctionGraph) && (graphLoadError || (!displayGraphUrl && !graphImageUrl))}}">
    <view class="fc-section-heading">
      <view>
        <text class="fc-section-kicker">FUNCTION GRAPH</text>
        <text class="fc-section-title">函数图像</text>
      </view>
    </view>
    <view class="fc-graph-fallback">
      <text class="fc-graph-fallback-title">函数图像暂时无法加载</text>
      <text class="fc-graph-fallback-desc">仍可继续查看公式与函数性质</text>
    </view>
  </view>

  <view class="fc-reading-section" wx:if="{{content.summaryNodes && content.summaryNodes.length}}">
    <view class="fc-section-index">01</view>
    <view class="fc-section-copy">
      <text class="fc-section-kicker">SUMMARY</text>
      <text class="fc-section-title">{{card.study_card_type === 'formula' ? '摘要' : '核心记忆'}}</text>
      <rich-text class="fc-rich-text" nodes="{{content.summaryNodes}}" user-select="{{true}}" />
    </view>
  </view>

  <view class="fc-reading-section conditions" wx:if="{{content.conditionsNodes && content.conditionsNodes.length}}">
    <view class="fc-section-index">02</view>
    <view class="fc-section-copy">
      <text class="fc-section-kicker">CONDITIONS</text>
      <text class="fc-section-title">{{card.study_card_type === 'protocol_rule' ? '规则边界' : '适用条件'}}</text>
      <rich-text class="fc-rich-text" nodes="{{content.conditionsNodes}}" user-select="{{true}}" />
    </view>
  </view>

  <view class="fc-collapse" wx:if="{{content.symbolNotesNodes && content.symbolNotesNodes.length}}">
    <view class="fc-collapse-header" hover-class="fc-pressed" bindtap="toggleSection" data-key="showSymbolNotes">
      <view>
        <text class="fc-collapse-kicker">SYMBOLS</text>
        <text class="fc-collapse-title">符号说明</text>
      </view>
      <view class="fc-collapse-arrow {{showSymbolNotes ? 'expanded' : ''}}"></view>
    </view>
    <view class="fc-collapse-body {{showSymbolNotes ? 'open' : ''}}">
      <view class="fc-collapse-content">
        <rich-text class="fc-rich-text" nodes="{{content.symbolNotesNodes}}" user-select="{{true}}" />
      </view>
    </view>
  </view>

  <view class="fc-collapse" wx:if="{{content.secondaryNodes && content.secondaryNodes.length}}">
    <view class="fc-collapse-header" hover-class="fc-pressed" bindtap="toggleSection" data-key="showSecondary">
      <view>
        <text class="fc-collapse-kicker">CONCLUSIONS</text>
        <text class="fc-collapse-title">{{card.template_type === 'contrast' ? '对比要点' : '常见结论'}}</text>
      </view>
      <view class="fc-collapse-arrow {{showSecondary ? 'expanded' : ''}}"></view>
    </view>
    <view class="fc-collapse-body {{showSecondary ? 'open' : ''}}">
      <view class="fc-collapse-content">
        <rich-text class="fc-rich-text" nodes="{{content.secondaryNodes}}" user-select="{{true}}" />
      </view>
    </view>
  </view>

  <view class="fc-collapse fc-error-collapse" wx:if="{{content.errorTipsNodes && content.errorTipsNodes.length}}">
    <view class="fc-collapse-header" hover-class="fc-pressed" bindtap="toggleSection" data-key="showErrorTips">
      <view>
        <text class="fc-collapse-kicker danger">ERROR ALERT</text>
        <text class="fc-collapse-title">{{card.template_type === 'trap' || card.study_card_type === 'trap' ? '考试陷阱' : '易错提醒'}}</text>
      </view>
      <view class="fc-collapse-arrow {{showErrorTips ? 'expanded' : ''}}"></view>
    </view>
    <view class="fc-collapse-body {{showErrorTips ? 'open' : ''}}">
      <view class="fc-collapse-content error-content">
        <rich-text class="fc-rich-text" nodes="{{content.errorTipsNodes}}" user-select="{{true}}" />
      </view>
    </view>
  </view>

  <view class="fc-collapse" wx:if="{{content.examples && content.examples.length}}">
    <view class="fc-collapse-header" hover-class="fc-pressed" bindtap="toggleSection" data-key="showExamples">
      <view>
        <text class="fc-collapse-kicker">EXAMPLES</text>
        <text class="fc-collapse-title">典型例题 · {{content.examples.length}} 道</text>
      </view>
      <view class="fc-collapse-arrow {{showExamples ? 'expanded' : ''}}"></view>
    </view>
    <view class="fc-collapse-body {{showExamples ? 'open' : ''}}">
      <view class="fc-example" wx:for="{{content.examples}}" wx:for-item="ex" wx:key="_key">
        <view class="fc-example-head">
          <text class="fc-example-index">{{index + 1 < 10 ? '0' : ''}}{{index + 1}}</text>
          <text class="fc-example-label">典型例题</text>
        </view>
        <rich-text class="fc-rich-text" nodes="{{ex.questionNodes}}" user-select="{{true}}" />
        <view class="fc-example-detail" wx:if="{{ex.solutionNodes && ex.solutionNodes.length}}">
          <text class="fc-example-detail-label">解法</text>
          <rich-text class="fc-rich-text" nodes="{{ex.solutionNodes}}" user-select="{{true}}" />
        </view>
        <view class="fc-example-detail answer" wx:if="{{ex.answerNodes && ex.answerNodes.length}}">
          <text class="fc-example-detail-label">答案</text>
          <rich-text class="fc-rich-text" nodes="{{ex.answerNodes}}" user-select="{{true}}" />
        </view>
        <view class="fc-example-detail error" wx:if="{{ex.errorTipNodes && ex.errorTipNodes.length}}">
          <text class="fc-example-detail-label">易错</text>
          <rich-text class="fc-rich-text" nodes="{{ex.errorTipNodes}}" user-select="{{true}}" />
        </view>
      </view>
    </view>
  </view>
</view>

<!-- Native page-container consumes Back while expanded; the reader's scroll
     position remains unchanged because its card is never replaced. -->
<page-container
  show="{{!!expandedBlock}}" position="bottom" round="{{false}}"
  close-on-slide-down="{{false}}" bind:afterleave="closeFormulaReading"
  custom-style="height:{{expandedHeight}}px;background:#FBFFFD;border-radius:24px 24px 0 0;overflow:hidden;"
>
  <view class="fc-expanded-reading" catchtap="containFormulaReading" catchtouchmove="containFormulaReading">
    <view class="fc-expanded-header" style="height:{{expandedHeaderHeight}}px;">
      <view class="fc-expanded-heading">
        <rich-text class="fc-expanded-title" wx:if="{{expandedBlock.labelNodes.length}}" nodes="{{expandedBlock.labelNodes}}" />
        <text class="fc-expanded-title" wx:else>公式阅读</text>
        <text class="fc-expanded-subtitle" wx:if="{{expandedBlock.hasWideRows}}">保留完整公式，超宽部分可左右滑动</text>
      </view>
      <view class="fc-reading-close" bindtap="closeFormulaReading" hover-class="fc-control-pressed" role="button" aria-label="关闭公式阅读"><view class="fc-close-icon" aria-hidden="true"></view></view>
    </view>
    <scroll-view class="fc-expanded-scroll" style="height:{{expandedScrollHeight}}px;" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="fc-expanded-content">
        <view class="fc-formula-row" wx:for="{{expandedBlock.readingRows}}" wx:for-item="row" wx:key="_key">
          <scroll-view class="fc-formula-line-scroll"
            wx:for="{{row.lineItems}}" wx:for-item="line" wx:for-index="lineIndex" wx:key="_key"
            scroll-x enhanced show-scrollbar="{{false}}" bounces="{{false}}"
          >
            <view class="fc-reading-line {{row.isScrollable ? 'is-long' : ''}} {{lineIndex > 0 ? 'is-continuation' : ''}}">
              <rich-text class="fc-formula-rich" nodes="{{line.mathNodes}}" user-select="{{true}}" />
            </view>
          </scroll-view>
        </view>
        <rich-text class="fc-block-note" wx:if="{{expandedBlock.noteNodes.length}}" nodes="{{expandedBlock.noteNodes}}" user-select="{{true}}" />
      </view>
    </scroll-view>
  </view>
</page-container>
