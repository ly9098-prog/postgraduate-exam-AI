<view class="fl-page">
  <!-- Subject Tabs -->
  <view class="fl-subject-bar">
    <view class="fl-subject-tab {{s.active ? 'active' : ''}}"
      wx:for="{{subjects}}" wx:key="code"
      data-code="{{s.code}}"
      bindtap="onSubjectChange">
      <text>{{s.name}}</text>
    </view>
  </view>

  <!-- Search + Filter Row -->
  <view class="fl-toolbar">
    <view class="fl-search-box">
      <text class="fl-search-icon">🔍</text>
      <input class="fl-search-input" placeholder="搜索公式名称或关键词"
        value="{{searchValue}}" bindinput="onSearchInput" />
      <text class="fl-search-clear" wx:if="{{searchValue}}" bindtap="onSearchClear">✕</text>
    </view>
  </view>

  <!-- Filter Chips -->
  <view class="fl-filter-row">
    <view class="fl-filter-chip {{activeChapterId ? 'active' : ''}}"
      bindtap="toggleChapterPicker">
      <text>{{activeChapterId ? '已选章节' : '章节筛选'}}</text>
    </view>
    <view class="fl-filter-chip {{activeTags.length ? 'active' : ''}}"
      bindtap="toggleTagPicker">
      <text>{{activeTags.length ? '已选标签' : '标签筛选'}}</text>
    </view>
    <view class="fl-filter-chip {{onlyFavorites ? 'active' : ''}}"
      bindtap="toggleFavoritesOnly">
      <text>只看收藏</text>
    </view>
    <view class="fl-filter-chip random" bindtap="goToRandom">
      <text>随机背诵</text>
    </view>
  </view>

  <!-- Chapter Picker -->
  <view class="fl-picker-overlay" wx:if="{{showChapterPicker}}" bindtap="toggleChapterPicker">
    <view class="fl-picker-content" catchtap="noop">
      <view class="fl-picker-item {{!activeChapterId ? 'active' : ''}}"
        bindtap="onChapterSelect" data-id="0">
        <text>全部章节</text>
      </view>
      <view class="fl-picker-item {{activeChapterId === c.id ? 'active' : ''}}"
        wx:for="{{chapters}}" wx:key="id"
        data-id="{{c.id}}"
        bindtap="onChapterSelect">
        <text>{{c.name}}</text>
      </view>
    </view>
  </view>

  <!-- Tag Picker -->
  <view class="fl-picker-overlay" wx:if="{{showTagPicker}}" bindtap="toggleTagPicker">
    <view class="fl-picker-content fl-tag-picker" catchtap="noop">
      <view class="fl-tag-item {{activeTags.includes(t.id) ? 'active' : ''}}"
        wx:for="{{tags}}" wx:key="id"
        data-id="{{t.id}}"
        bindtap="onTagSelect">
        <text>{{t.name}}</text>
      </view>
    </view>
  </view>

  <!-- Initial Loading State -->
  <view class="fl-loading" wx:if="{{initialLoading}}">
    <text>加载中...</text>
  </view>

  <!-- Error State -->
  <view class="fl-empty" wx:if="{{!initialLoading && loadError}}">
    <text class="fl-empty-icon">⚠️</text>
    <text class="fl-empty-text">{{loadErrorMessage || '加载失败'}}</text>
    <view class="fl-reload-btn" bindtap="reload">
      <text>重新加载</text>
    </view>
  </view>

  <!-- Formula List -->
  <view class="fl-list" wx:if="{{!loadError && formulas.length > 0}}">
    <view class="fl-card" wx:for="{{formulas}}" wx:key="id"
      data-id="{{item.id}}" bindtap="goToReader"
      hover-class="fl-card-pressed">
      <text class="fl-card-title">{{item.title}}</text>
      <view class="fl-card-tags" wx:if="{{item.tags && item.tags.length}}">
        <text class="fl-card-tag {{'tag-' + t.code}}"
          wx:for="{{item.tags}}" wx:for-item="t" wx:key="id">{{t.name}}</text>
      </view>
      <text class="fl-card-summary" wx:if="{{item.summary}}">{{item.summary}}</text>
      <view class="fl-card-formula">
        <text wx:for="{{item.formula_blocks.slice(0, 2)}}" wx:for-item="b" wx:key="*this"
          class="fl-card-latex">{{b.latex}}</text>
      </view>
      <text class="fl-card-arrow">→</text>
    </view>
    <!-- Loading More -->
    <view class="fl-loading-more" wx:if="{{loadingMore}}">
      <text>加载更多...</text>
    </view>
  </view>

  <!-- Empty State (not loading, no error) -->
  <view class="fl-empty" wx:if="{{!initialLoading && !loadError && formulas.length === 0}}">
    <text class="fl-empty-icon">📝</text>
    <text class="fl-empty-text">{{searchValue ? '没有找到匹配的公式' : '暂无公式数据'}}</text>
  </view>
</view>
