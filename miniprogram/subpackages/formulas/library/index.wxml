<view class="fl-page">
  <premium-nav title="速记卡" variant="light" bind:back="goBack" />

  <view class="fl-content">
    <view class="fl-compact-head">
      <view class="fl-compact-copy">
        <text class="fl-compact-title">速记卡</text>
        <text class="fl-compact-note">{{activeLibraryType === 'function_graph' ? '函数图像速查' : '公式 · 定义 · 易混点 · 陷阱'}}</text>
      </view>
      <view class="fl-head-actions">
        <view class="fl-compact-total" wx:if="{{!initialLoading && !loadError}}">
          <text class="fl-compact-total-number">{{total || formulas.length || 0}}</text>
          <text class="fl-compact-total-unit">{{activeLibraryType === 'function_graph' ? '张' : '条'}}</text>
        </view>
        <view class="fl-more-button" hover-class="fl-pressed" bindtap="toggleMoreSheet" aria-label="更多功能">
          <view class="fl-more-dots"><view class="fl-dot"></view><view class="fl-dot"></view><view class="fl-dot"></view></view>
          <view class="fl-more-active-dot" wx:if="{{activeTags.length}}"></view>
        </view>
      </view>
    </view>

    <view class="fl-sticky-tools" style="top: {{navHeight}}px;">
      <view class="fl-filter-row">
        <view class="fl-subject-select" hover-class="fl-pressed" bindtap="toggleSubjectPicker">
          <view class="fl-subject-select-copy">
            <text class="fl-control-label">学科</text>
            <text class="fl-subject-select-name">{{activeSubjectName}}</text>
          </view>
          <text class="line-icon icon-chevron-down fl-control-chevron"></text>
        </view>

        <view class="fl-library-switch">
          <view
            class="fl-library-tab {{tab.active ? 'active' : ''}}"
            wx:for="{{libraryTabs}}"
            wx:for-item="tab"
            wx:key="key"
            data-type="{{tab.key}}"
            hover-class="fl-pressed"
            bindtap="onLibraryTypeChange"
          >
            <text class="fl-library-tab-name">{{tab.name}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="fl-search-box">
      <view class="fl-search-icon"></view>
      <input
        class="fl-search-input"
        placeholder="{{activeLibraryType === 'function_graph' ? '搜索函数图像名称或关键词' : '搜索速记卡名称或关键词'}}"
        placeholder-class="fl-search-placeholder"
        value="{{searchValue}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
      <view class="fl-search-clear" wx:if="{{searchValue}}" hover-class="fl-pressed" bindtap="onSearchClear">
        <text class="line-icon icon-close"></text>
      </view>
    </view>

    <view class="fl-quick-row">
      <view
        class="fl-quick-action {{onlyFavorites ? 'active' : ''}}"
        hover-class="fl-pressed"
        bindtap="toggleFavoritesOnly"
      >
        <view class="fl-quick-icon"><text class="line-icon icon-book"></text></view>
        <text class="fl-quick-title">{{onlyFavorites ? '已筛选收藏' : '只看收藏'}}</text>
        <view class="fl-quick-status" wx:if="{{onlyFavorites}}"></view>
      </view>

      <view class="fl-quick-action fl-random-action" hover-class="fl-pressed" bindtap="goToRandom">
        <view class="fl-quick-icon"><text class="line-icon icon-review"></text></view>
        <text class="fl-quick-title">随机背诵</text>
        <text class="line-icon icon-chevron-right fl-quick-arrow"></text>
      </view>
    </view>

    <view class="fl-study-type-head" wx:if="{{activeSubject === 'exam408' && activeLibraryType !== 'function_graph'}}">
      <text class="fl-study-type-title">内容类型</text>
      <text class="fl-study-type-note">按记忆用途筛选</text>
    </view>
    <scroll-view wx:if="{{activeSubject === 'exam408' && activeLibraryType !== 'function_graph'}}" scroll-x enhanced show-scrollbar="{{false}}" class="fl-study-type-scroll">
      <view class="fl-study-type-row">
        <view
          class="fl-study-type-chip {{item.active ? 'active' : ''}}"
          wx:for="{{studyTypeTabs}}"
          wx:key="key"
          data-type="{{item.key}}"
          hover-class="fl-pressed"
          bindtap="onStudyCardTypeChange"
        >{{item.name}}</view>
      </view>
    </scroll-view>

    <view class="fl-section-head">
      <view>
        <text class="fl-section-title">章节筛选</text>
        <text class="fl-section-kicker">CHAPTERS</text>
      </view>
      <text class="fl-section-filter-note" wx:if="{{activeTags.length}}">已选 {{activeTags.length}} 个标签</text>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="fl-chapter-scroll">
      <view class="fl-chapter-row">
        <view
          class="fl-chapter-chip {{!activeChapterId ? 'active' : ''}}"
          hover-class="fl-pressed"
          bindtap="onChapterSelect"
          data-id="0"
        >全部章节</view>
        <view
          class="fl-chapter-chip {{c.active ? 'active' : ''}}"
          wx:for="{{chapters}}"
          wx:for-item="c"
          wx:key="id"
          data-id="{{c.id}}"
          hover-class="fl-pressed"
          bindtap="onChapterSelect"
        >{{c.name}}<text wx:if="{{c.available_count > 0}}" class="fl-chapter-count"> {{c.available_count}}</text></view>
      </view>
    </scroll-view>

    <view class="fl-active-tags" wx:if="{{_shownActiveTags.length}}">
      <text class="fl-active-tags-label">当前标签</text>
      <view
        class="fl-active-tag"
        wx:for="{{_shownActiveTags}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onTagSelect"
      >
        <text>{{item.name}}</text>
        <text class="fl-active-tag-close">×</text>
      </view>
    </view>

    <view class="fl-list-head" wx:if="{{!initialLoading && !loadError}}">
      <text class="fl-list-title">{{activeLibraryType === 'function_graph' ? '函数图像' : '速记卡列表'}}</text>
      <text class="fl-list-meta">{{formulas.length}} / {{total || formulas.length || 0}}</text>
    </view>

    <view class="fl-loading" wx:if="{{initialLoading}}">
      <view class="fl-loading-ring"></view>
      <text class="fl-state-title">{{activeLibraryType === 'function_graph' ? '正在整理函数图像' : '正在整理速记卡'}}</text>
      <text class="fl-state-desc">请稍候</text>
    </view>

    <view class="fl-empty" wx:if="{{!initialLoading && loadError}}">
      <view class="fl-state-icon fl-state-error"><text class="line-icon icon-exclamation"></text></view>
      <text class="fl-state-title">{{activeLibraryType === 'function_graph' ? '函数图像加载失败' : '速记卡加载失败'}}</text>
      <text class="fl-state-desc">{{loadErrorMessage || '请检查网络后重试'}}</text>
      <view class="fl-reload-btn" hover-class="fl-pressed" bindtap="reload">重新加载</view>
    </view>

    <view class="fl-list {{activeLibraryType === 'function_graph' ? 'fl-graph-list' : ''}}" wx:if="{{!loadError && formulas.length > 0}}">
      <view
        class="fl-card {{activeLibraryType === 'function_graph' ? 'fl-card-graph' : ''}}"
        wx:for="{{formulas}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="goToReader"
        hover-class="fl-card-pressed"
      >
        <view class="fl-card-head">
          <view class="fl-card-title-wrap">
            <rich-text
              class="fl-card-title fl-card-title-rich"
              wx:if="{{item.titleNodes && item.titleNodes.length}}"
              nodes="{{item.titleNodes}}"
              user-select="{{true}}"
            />
            <text class="fl-card-title" wx:else>{{item.title}}</text>
            <view class="fl-card-tags" wx:if="{{item.tags && item.tags.length || item.isFunctionGraph || (activeSubject === 'exam408' && item.studyCardTypeLabel)}}">
              <text class="fl-card-tag tag-study-type" wx:if="{{activeSubject === 'exam408'}}">{{item.studyCardTypeLabel}}</text>
              <text
                class="fl-card-tag tag-function-graph"
                wx:if="{{item.isFunctionGraph}}"
              >函数图像</text>
              <text
                class="fl-card-tag {{'tag-' + t.code}}"
                wx:for="{{item.tags}}"
                wx:for-item="t"
                wx:key="id"
              >{{t.name}}</text>
            </view>
          </view>
          <view
            class="fl-favorite-btn {{item.isFavorited || item.is_favorited ? 'active' : ''}}"
            data-id="{{item.id}}"
            catchtap="toggleFormulaFavorite"
            hover-class="fl-pressed"
          >
            <view class="fl-bookmark-icon"></view>
          </view>
        </view>

        <view class="fl-graph-preview" wx:if="{{activeLibraryType === 'function_graph'}}">
          <image
            class="fl-graph-preview-img"
            wx:if="{{item.graphPreviewUrl && !item.graphLoadError}}"
            src="{{item.graphPreviewUrl}}"
            mode="aspectFit"
            lazy-load
            data-id="{{item.id}}"
            binderror="onGraphImageError"
          />
          <view class="fl-graph-placeholder" wx:else>
            <view class="fl-graph-placeholder-icon">
              <view class="fl-graph-axis-x"></view>
              <view class="fl-graph-axis-y"></view>
              <text class="fl-graph-curve">⌁</text>
            </view>
            <text class="fl-graph-placeholder-title">图像暂未上传</text>
            <text class="fl-graph-placeholder-desc">该条目已标记为函数图像</text>
          </view>
        </view>

        <view class="fl-card-thumb" wx:if="{{activeLibraryType !== 'function_graph' && item.isFunctionGraph && item.graphThumbnailUrl && !item.graphLoadError}}">
          <image
            class="fl-card-thumb-img"
            src="{{item.graphThumbnailUrl}}"
            mode="aspectFit"
            lazy-load
            data-id="{{item.id}}"
            binderror="onGraphImageError"
          />
        </view>

        <view class="fl-card-foot">
          <text class="fl-card-hint">{{activeLibraryType === 'function_graph' ? '查看大图、适用条件与完整解析' : '查看核心记忆、易混点与考试陷阱'}}</text>
          <text class="line-icon icon-chevron-right fl-card-arrow"></text>
        </view>
      </view>

      <view class="fl-loading-more" wx:if="{{loadingMore}}">
        <view class="fl-loading-dot"></view>
        <text>正在加载更多</text>
      </view>
    </view>

    <view class="fl-empty" wx:if="{{!initialLoading && !loadError && formulas.length === 0}}">
      <view class="fl-state-icon"><text class="line-icon {{activeLibraryType === 'function_graph' ? 'icon-review' : 'icon-book'}}"></text></view>
      <text class="fl-state-title">{{searchValue ? (activeLibraryType === 'function_graph' ? '没有匹配的函数图像' : '没有匹配的速记卡') : (activeLibraryType === 'function_graph' ? '暂无函数图像' : '暂无速记卡数据')}}</text>
      <text class="fl-state-desc">{{searchValue ? '换一个关键词或清除筛选试试' : (activeLibraryType === 'function_graph' ? '当前筛选下尚未录入函数图像' : '当前科目尚未录入对应速记卡')}}</text>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showSubjectPicker}}" bindtap="toggleSubjectPicker" catchtouchmove="noop">
    <view class="fl-bottom-sheet fl-subject-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <view>
          <text class="fl-sheet-title">选择学科</text>
          <text class="fl-sheet-subtitle">切换后将重新加载章节与内容</text>
        </view>
        <view class="fl-sheet-close" bindtap="toggleSubjectPicker" hover-class="fl-pressed">
          <text class="line-icon icon-close"></text>
        </view>
      </view>
      <view class="fl-subject-options">
        <view
          class="fl-subject-option {{s.active ? 'active' : ''}}"
          wx:for="{{subjects}}"
          wx:for-item="s"
          wx:key="code"
          data-code="{{s.code}}"
          hover-class="fl-pressed"
          bindtap="onSubjectChange"
        >
          <view class="fl-subject-option-mark"><view class="fl-subject-option-dot"></view></view>
          <text class="fl-subject-option-name">{{s.name}}</text>
          <text class="line-icon icon-check" wx:if="{{s.active}}"></text>
        </view>
      </view>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showMoreSheet}}" bindtap="toggleMoreSheet" catchtouchmove="noop">
    <view class="fl-bottom-sheet fl-more-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <view>
          <text class="fl-sheet-title">更多功能</text>
          <text class="fl-sheet-subtitle">管理标签和当前筛选条件</text>
        </view>
        <view class="fl-sheet-close" bindtap="toggleMoreSheet" hover-class="fl-pressed">
          <text class="line-icon icon-close"></text>
        </view>
      </view>
      <view class="fl-more-list">
        <view class="fl-more-item" hover-class="fl-pressed" bindtap="openTagPickerFromMore">
          <view class="fl-more-item-icon fl-more-tag-icon"><view class="fl-filter-bar fl-filter-bar-one"></view><view class="fl-filter-bar fl-filter-bar-two"></view><view class="fl-filter-bar fl-filter-bar-three"></view></view>
          <view class="fl-more-item-copy">
            <text class="fl-more-item-title">标签筛选</text>
            <text class="fl-more-item-desc">{{activeTags.length ? '已选择 ' + activeTags.length + ' 个标签' : '按高频、易错等标签筛选'}}</text>
          </view>
          <view class="fl-more-item-badge" wx:if="{{activeTags.length}}">{{activeTags.length}}</view>
          <text class="line-icon icon-chevron-right fl-more-item-arrow"></text>
        </view>
        <view class="fl-more-item {{!searchValue && !activeChapterId && !activeTags.length && !onlyFavorites ? 'disabled' : ''}}" hover-class="fl-pressed" bindtap="resetFilters">
          <view class="fl-more-item-icon fl-more-reset-icon"><view class="fl-reset-ring"></view><view class="fl-reset-arrow"></view></view>
          <view class="fl-more-item-copy">
            <text class="fl-more-item-title">清除当前筛选</text>
            <text class="fl-more-item-desc">保留学科与内容分类，恢复全部章节</text>
          </view>
          <text class="line-icon icon-chevron-right fl-more-item-arrow"></text>
        </view>
      </view>
    </view>
  </view>

  <view class="fl-picker-overlay" wx:if="{{showTagPicker}}" bindtap="toggleTagPicker" catchtouchmove="noop">
    <view class="fl-tag-sheet" catchtap="noop">
      <view class="fl-sheet-handle"></view>
      <view class="fl-sheet-head">
        <view>
          <text class="fl-sheet-title">筛选{{activeLibraryType === 'function_graph' ? '图像' : '公式'}}标签</text>
          <text class="fl-sheet-subtitle">可同时选择多个标签</text>
        </view>
        <view class="fl-sheet-close" bindtap="toggleTagPicker" hover-class="fl-pressed">
          <text class="line-icon icon-close"></text>
        </view>
      </view>
      <view class="fl-tag-grid">
        <view
          class="fl-tag-item {{t._active ? 'active' : ''}}"
          wx:for="{{tags}}"
          wx:for-item="t"
          wx:key="id"
          data-id="{{t.id}}"
          hover-class="fl-pressed"
          bindtap="onTagSelect"
        >
          <text>{{t.name}}</text>
          <text class="line-icon icon-check" wx:if="{{t._active}}"></text>
        </view>
      </view>
      <view class="fl-sheet-done" hover-class="fl-pressed" bindtap="toggleTagPicker">完成筛选</view>
    </view>
  </view>
</view>
