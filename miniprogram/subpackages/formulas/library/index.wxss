@import '../../../styles/tokens.wxss';

page {
  min-height: 100vh;
  background: #F4F4EE;
  color: #17251B;
}

.fl-page {
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 92% 4%, rgba(183,232,42,.10), rgba(183,232,42,0) 25%),
    #F4F4EE;
}

.fl-content { padding: 18rpx 32rpx 0; }
.fl-pressed { opacity: .74; transform: scale(.985); }

.fl-intro { padding: 16rpx 2rpx 24rpx; }
.fl-kicker { display:block; color:#6B796F; font-size:18rpx; font-weight:850; letter-spacing:4rpx; }
.fl-intro-row { margin-top:10rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:24rpx; }
.fl-intro-copy { min-width:0; }
.fl-title { display:block; color:#17251B; font-size:42rpx; line-height:1.18; font-weight:900; letter-spacing:.5rpx; }
.fl-subtitle { display:block; margin-top:9rpx; color:#7A857D; font-size:22rpx; line-height:1.55; }
.fl-total-pill { flex-shrink:0; min-width:90rpx; height:58rpx; padding:0 17rpx; border-radius:999rpx; background:#E9EEE5; display:flex; align-items:baseline; justify-content:center; gap:4rpx; }
.fl-total-number { color:#173123; font-size:27rpx; font-weight:900; font-variant-numeric:tabular-nums; }
.fl-total-unit { color:#6F7B72; font-size:19rpx; font-weight:700; }

.fl-subject-switch { padding:7rpx; border:1rpx solid #DEE3DA; border-radius:24rpx; background:#EDEFEA; display:flex; gap:7rpx; }
.fl-subject-tab { flex:1; min-height:70rpx; border-radius:18rpx; color:#6C776E; font-size:25rpx; font-weight:800; display:flex; align-items:center; justify-content:center; transition:all .16s ease; }
.fl-subject-tab.active { color:#FFFFFF; background:#10251A; box-shadow:0 10rpx 22rpx rgba(16,37,26,.14); }

.fl-search-box { margin-top:22rpx; height:88rpx; padding:0 18rpx 0 24rpx; border:1rpx solid #DDE3DA; border-radius:24rpx; background:#FFFFFF; display:flex; align-items:center; gap:16rpx; box-shadow:0 8rpx 22rpx rgba(16,37,26,.035); }
.fl-search-icon { width:27rpx; height:27rpx; border:3rpx solid #66746A; border-radius:50%; position:relative; flex-shrink:0; }
.fl-search-icon::after { content:''; position:absolute; right:-8rpx; bottom:-5rpx; width:11rpx; height:3rpx; border-radius:3rpx; background:#66746A; transform:rotate(45deg); }
.fl-search-input { flex:1; min-width:0; height:88rpx; color:#18261C; font-size:26rpx; font-weight:650; }
.fl-search-placeholder { color:#A1AAA2; font-weight:500; }
.fl-search-clear { width:52rpx; height:52rpx; border-radius:50%; background:#F0F2ED; color:#748077; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-search-clear .line-icon { width:26rpx; height:26rpx; transform:scale(.78); }

.fl-quick-row { margin-top:18rpx; display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.fl-quick-action { min-width:0; min-height:126rpx; padding:20rpx 17rpx; border:1rpx solid #DEE3DB; border-radius:28rpx; background:#FFFFFF; display:flex; align-items:center; gap:13rpx; box-shadow:0 8rpx 22rpx rgba(16,37,26,.035); }
.fl-quick-action.active { border-color:#B7E82A; background:#F5FBE7; }
.fl-quick-icon { width:56rpx; height:56rpx; border-radius:17rpx; background:#EAF1E3; color:#2D613A; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-quick-icon .line-icon { width:28rpx; height:28rpx; }
.fl-quick-copy { min-width:0; flex:1; }
.fl-quick-title { display:block; color:#1B2A20; font-size:23rpx; font-weight:900; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.fl-quick-desc { display:block; margin-top:5rpx; color:#89928B; font-size:18rpx; line-height:1.35; }
.fl-quick-arrow { width:22rpx; height:22rpx; color:#97A098; flex-shrink:0; }
.fl-random-action { border-color:#203B2A; background:#10251A; }
.fl-random-action .fl-quick-icon { background:rgba(183,232,42,.14); color:#B7E82A; }
.fl-random-action .fl-quick-title { color:#FFFFFF; }
.fl-random-action .fl-quick-desc { color:rgba(255,255,255,.5); }
.fl-random-go { width:44rpx; height:44rpx; border-radius:50%; background:#B7E82A; color:#10251A; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-random-go .line-icon { width:22rpx; height:22rpx; }

.fl-section-head { margin-top:30rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:18rpx; }
.fl-section-title { display:block; color:#1A2820; font-size:28rpx; font-weight:900; }
.fl-section-kicker { display:block; margin-top:3rpx; color:#98A098; font-size:17rpx; font-weight:800; letter-spacing:2rpx; }
.fl-tag-filter { height:58rpx; padding:0 15rpx 0 20rpx; border:1rpx solid #DDE2DA; border-radius:999rpx; background:#FFFFFF; color:#657168; font-size:21rpx; font-weight:800; display:flex; align-items:center; gap:5rpx; }
.fl-tag-filter.active { border-color:#BCD96D; background:#F3F9E8; color:#365C27; }
.fl-tag-filter .line-icon { width:23rpx; height:23rpx; }

.fl-chapter-scroll { width:calc(100% + 64rpx); margin-left:-32rpx; margin-top:16rpx; white-space:nowrap; }
.fl-chapter-row { padding:0 32rpx 4rpx; display:inline-flex; gap:12rpx; }
.fl-chapter-chip { flex-shrink:0; min-height:62rpx; padding:0 23rpx; border:1rpx solid #DDE2DA; border-radius:999rpx; background:#FFFFFF; color:#68736B; font-size:22rpx; line-height:62rpx; font-weight:750; }
.fl-chapter-chip.active { border-color:#10251A; background:#10251A; color:#B7E82A; }

.fl-active-tags { margin-top:14rpx; display:flex; align-items:center; flex-wrap:wrap; gap:9rpx; }
.fl-active-tags-label { color:#89938B; font-size:19rpx; font-weight:750; }
.fl-active-tag { min-height:48rpx; padding:0 13rpx 0 16rpx; border-radius:999rpx; background:#E9F2E3; color:#376144; display:flex; align-items:center; gap:8rpx; font-size:19rpx; font-weight:800; }
.fl-active-tag-close { font-size:25rpx; line-height:1; color:#6F8B72; }

.fl-list-head { margin:30rpx 2rpx 14rpx; display:flex; align-items:center; justify-content:space-between; }
.fl-list-title { color:#1A2820; font-size:29rpx; font-weight:900; }
.fl-list-meta { color:#8A948C; font-size:20rpx; font-weight:750; font-variant-numeric:tabular-nums; }
.fl-list { display:flex; flex-direction:column; gap:16rpx; }
.fl-card { padding:25rpx 24rpx 21rpx; border:1rpx solid #DEE3DB; border-radius:30rpx; background:#FFFFFF; box-shadow:0 10rpx 28rpx rgba(16,37,26,.045); transition:transform .15s ease, opacity .15s ease; }
.fl-card-pressed { opacity:.78; transform:scale(.989); }
.fl-card-head { display:flex; align-items:flex-start; gap:18rpx; }
.fl-card-title-wrap { flex:1; min-width:0; }
.fl-card-title { display:block; padding-top:3rpx; color:#17251B; font-size:29rpx; line-height:1.35; font-weight:900; }
.fl-card-tags { margin-top:10rpx; display:flex; flex-wrap:wrap; gap:8rpx; }
.fl-card-tag { padding:5rpx 12rpx; border-radius:999rpx; background:#EEF2EA; color:#637067; font-size:18rpx; line-height:1.2; font-weight:800; }
.fl-card-tag.tag-basic { background:#EDF4E8; color:#3D754F; }
.fl-card-tag.tag-high_frequency { background:#FFF3DF; color:#A96518; }
.fl-card-tag.tag-error_prone { background:#FDEBE8; color:#B24F43; }
.fl-card-tag.tag-must_memorize { background:#F0EBF6; color:#735C8A; }
.fl-favorite-btn { width:58rpx; height:58rpx; border:1rpx solid #DFE4DC; border-radius:18rpx; background:#F6F7F3; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-favorite-btn.active { border-color:#B7E82A; background:#F0F8D8; }
.fl-bookmark-icon { width:20rpx; height:26rpx; border:3rpx solid #7B867D; border-radius:4rpx 4rpx 2rpx 2rpx; position:relative; box-sizing:border-box; }
.fl-bookmark-icon::after { content:''; position:absolute; left:2rpx; right:2rpx; bottom:-4rpx; height:9rpx; background:#F6F7F3; border-left:3rpx solid #7B867D; border-bottom:3rpx solid #7B867D; transform:rotate(-45deg) scale(.72); }
.fl-favorite-btn.active .fl-bookmark-icon { border-color:#456600; background:#B7E82A; }
.fl-favorite-btn.active .fl-bookmark-icon::after { border-color:#456600; background:#F0F8D8; }
.fl-card-formula { margin-top:19rpx; padding:18rpx 19rpx; border:1rpx solid #E3E7DF; border-radius:20rpx; background:#F7F8F4; display:flex; flex-direction:column; gap:9rpx; overflow:hidden; }
.fl-formula-line { min-width:0; display:flex; align-items:baseline; gap:10rpx; }
.fl-formula-label { flex-shrink:0; color:#8A958D; font-size:18rpx; font-weight:750; }
.fl-card-latex { min-width:0; color:#21352A; font-size:23rpx; line-height:1.55; font-family:Menlo,Consolas,monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.fl-card-foot { margin-top:17rpx; display:flex; align-items:center; justify-content:space-between; gap:14rpx; }
.fl-card-hint { color:#909991; font-size:19rpx; line-height:1.4; }
.fl-card-arrow { width:24rpx; height:24rpx; color:#66736A; flex-shrink:0; }

.fl-loading, .fl-empty { min-height:430rpx; padding:70rpx 28rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; }
.fl-loading-ring { width:52rpx; height:52rpx; border:5rpx solid #E1E7DC; border-top-color:#6D9822; border-radius:50%; animation:flSpin .8s linear infinite; }
@keyframes flSpin { to { transform:rotate(360deg); } }
.fl-state-icon { width:82rpx; height:82rpx; border-radius:26rpx; background:#EAF2E3; color:#3B6746; display:flex; align-items:center; justify-content:center; }
.fl-state-icon.fl-state-error { background:#FCECE8; color:#C55A4E; }
.fl-state-icon .line-icon { width:34rpx; height:34rpx; }
.fl-state-title { margin-top:20rpx; color:#243229; font-size:27rpx; font-weight:900; }
.fl-state-desc { margin-top:7rpx; color:#8A948C; font-size:21rpx; }
.fl-reload-btn { margin-top:24rpx; min-width:190rpx; height:70rpx; padding:0 28rpx; border-radius:22rpx; background:#B7E82A; color:#10251A; font-size:24rpx; line-height:70rpx; font-weight:900; }
.fl-loading-more { padding:28rpx 0 8rpx; color:#89938B; font-size:20rpx; display:flex; align-items:center; justify-content:center; gap:10rpx; }
.fl-loading-dot { width:12rpx; height:12rpx; border-radius:50%; background:#7DA525; animation:flPulse .9s ease-in-out infinite alternate; }
@keyframes flPulse { from { opacity:.35; transform:scale(.78); } to { opacity:1; transform:scale(1); } }

.fl-picker-overlay { position:fixed; inset:0; z-index:120; display:flex; align-items:flex-end; background:rgba(4,13,8,.62); }
.fl-tag-sheet { width:100%; max-height:72vh; padding:13rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:40rpx 40rpx 0 0; background:#FBFBF7; box-shadow:0 -22rpx 56rpx rgba(0,0,0,.18); animation:flSheetUp .2s ease-out both; }
@keyframes flSheetUp { from { opacity:.5; transform:translateY(36rpx); } to { opacity:1; transform:translateY(0); } }
.fl-sheet-handle { width:72rpx; height:7rpx; margin:0 auto 20rpx; border-radius:999rpx; background:#D4D9D2; }
.fl-sheet-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.fl-sheet-title { display:block; color:#17251B; font-size:32rpx; font-weight:900; }
.fl-sheet-subtitle { display:block; margin-top:6rpx; color:#879188; font-size:21rpx; }
.fl-sheet-close { width:56rpx; height:56rpx; border:1rpx solid #E0E4DD; border-radius:50%; background:#FFFFFF; color:#6F7A71; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.fl-sheet-close .line-icon { width:26rpx; height:26rpx; transform:scale(.8); }
.fl-tag-grid { max-height:42vh; margin-top:25rpx; display:grid; grid-template-columns:1fr 1fr; gap:12rpx; overflow-y:auto; }
.fl-tag-item { min-height:74rpx; padding:0 20rpx; border:1rpx solid #DFE4DC; border-radius:21rpx; background:#FFFFFF; color:#657169; font-size:23rpx; font-weight:800; display:flex; align-items:center; justify-content:space-between; gap:10rpx; }
.fl-tag-item.active { border-color:#AACF43; background:#F0F8DC; color:#345328; }
.fl-tag-item .line-icon { width:24rpx; height:24rpx; color:#5C7F13; }
.fl-sheet-done { margin-top:24rpx; height:84rpx; border-radius:25rpx; background:#B7E82A; color:#10251A; font-size:27rpx; line-height:84rpx; text-align:center; font-weight:900; }

@media (max-width:360px) {
  .fl-content { padding-left:24rpx; padding-right:24rpx; }
  .fl-chapter-scroll { width:calc(100% + 48rpx); margin-left:-24rpx; }
  .fl-chapter-row { padding-left:24rpx; padding-right:24rpx; }
  .fl-quick-action { padding-left:14rpx; padding-right:14rpx; gap:9rpx; }
  .fl-quick-icon { width:48rpx; height:48rpx; }
  .fl-quick-desc { font-size:17rpx; }
}

@media (prefers-reduced-motion:reduce) {
  .fl-subject-tab, .fl-card, .fl-tag-sheet, .fl-loading-ring, .fl-loading-dot { transition:none!important; animation:none!important; }
}

/* ==================== Phase 2.3 cleaner list cards ==================== */
.fl-card { padding-bottom: 23rpx; }
.fl-card-foot {
  margin-top: 20rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid #ECEFEA;
}
