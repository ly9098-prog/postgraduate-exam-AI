.fl-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.fl-subject-bar {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.fl-subject-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: #666;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
}

.fl-subject-tab.active {
  color: #4F7FFF;
  border-bottom-color: #4F7FFF;
}

.fl-toolbar {
  padding: 16rpx 30rpx;
  background: #fff;
}

.fl-search-box {
  display: flex;
  align-items: center;
  background: #f0f2f5;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 64rpx;
}

.fl-search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.fl-search-input {
  flex: 1;
  font-size: 26rpx;
  height: 64rpx;
}

.fl-search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

.fl-filter-row {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 30rpx;
  background: #fff;
  overflow-x: auto;
  white-space: nowrap;
}

.fl-filter-chip {
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  background: #f0f2f5;
  flex-shrink: 0;
}

.fl-filter-chip.active {
  color: #4F7FFF;
  background: #e8f0ff;
}

.fl-filter-chip.random {
  color: #fff;
  background: #4F7FFF;
}

.fl-picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.fl-picker-content {
  background: #fff;
  border-radius: 0 0 24rpx 24rpx;
  width: 100%;
  max-height: 60vh;
  overflow-y: auto;
}

.fl-picker-item {
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #f0f0f0;
}

.fl-picker-item.active {
  color: #4F7FFF;
  font-weight: 600;
}

.fl-tag-picker {
  display: flex;
  flex-wrap: wrap;
  padding: 24rpx;
  gap: 16rpx;
}

.fl-tag-item {
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f0f2f5;
}

.fl-tag-item.active {
  color: #4F7FFF;
  background: #e8f0ff;
}

.fl-list {
  padding: 16rpx 30rpx;
}

.fl-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.fl-card-pressed {
  opacity: 0.9;
}

.fl-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
}

.fl-card-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 12rpx;
}

.fl-card-tag {
  padding: 2rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

.fl-card-summary {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
  line-height: 1.5;
}

.fl-card-formula {
  font-size: 24rpx;
  color: #4F7FFF;
  margin-top: 12rpx;
  font-family: monospace;
}

.fl-card-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #ccc;
  font-size: 32rpx;
}

.fl-empty, .fl-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.fl-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
