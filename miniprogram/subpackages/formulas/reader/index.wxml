<view class="fr-page">
  <premium-nav title="速记" variant="light" bind:back="goBack" />

  <view class="fr-loading" wx:if="{{loading}}">
    <view class="fr-loading-mark">
      <view class="fr-loading-line line-one"></view>
      <view class="fr-loading-line line-two"></view>
      <view class="fr-loading-line line-three"></view>
    </view>
    <text class="fr-state-title">正在整理速记内容</text>
    <text class="fr-state-desc">核心记忆、边界与易错点正在加载</text>
    <view class="fr-skeleton-card">
      <view class="fr-skeleton-title"></view>
      <view class="fr-skeleton-formula"></view>
      <view class="fr-skeleton-line long"></view>
      <view class="fr-skeleton-line medium"></view>
    </view>
  </view>

  <view class="fr-error" wx:elif="{{loadError}}">
    <view class="fr-error-mark">!</view>
    <text class="fr-state-title">暂时无法打开这张速记卡</text>
    <text class="fr-state-desc">{{errorText || '请检查网络后重新加载'}}</text>
    <button class="fr-retry" hover-class="fr-control-pressed" bindtap="retryLoad">重新加载</button>
    <button class="fr-back-link" hover-class="fr-control-pressed" bindtap="goBack">返回速记卡库</button>
  </view>

  <!-- 非加载、非错误但没有有效卡片 -->
  <view class="fr-error" wx:elif="{{!currentCard}}">
    <view class="fr-error-mark">?</view>
    <text class="fr-state-title">速记内容暂不可用</text>
    <text class="fr-state-desc">该速记卡可能存在格式问题或已被移除</text>
    <button class="fr-retry" hover-class="fr-control-pressed" bindtap="retryLoad">重新加载</button>
    <button class="fr-back-link" hover-class="fr-control-pressed" bindtap="goBack">返回速记卡库</button>
  </view>

  <scroll-view
    wx:else
    class="fr-card-scroll"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    scroll-top="{{readerScrollTop}}"
    bindtouchstart="onReaderTouchStart"
    bindtouchmove="onReaderTouchMove"
    bindtouchend="onReaderTouchEnd"
    bindtouchcancel="onReaderTouchCancel"
  >
    <view class="fr-card-wrap">
      <view class="fr-transition-stage {{transitionClass}}">
        <view class="fr-reader-meta">
          <view class="fr-reader-copy">
            <text class="fr-kicker">{{isRandom ? 'RANDOM REVIEW' : 'MEMORY CARD'}}</text>
            <text class="fr-reader-mode">{{isRandom ? '随机背诵模式' : (currentCard.studyCardTypeLabel || '速记阅读')}}</text>
          </view>
          <view class="fr-index-pill" wx:if="{{isRandom || sequenceIds.length > 1}}">
            <text>{{isRandom ? currentIndex + 1 : sequenceIndex + 1}}</text>
            <text class="fr-index-unit">{{isRandom ? '/ ' + displayCards.length : '/ ' + sequenceIds.length}}</text>
          </view>
        </view>

        <view class="fr-card-surface">
          <view
            class="fr-card-favorite {{currentCard.isFavorited ? 'active' : ''}} {{favoriteBusy ? 'disabled' : ''}}"
            data-id="{{currentCard.id}}"
            hover-class="fr-control-pressed"
            bindtap="toggleFavorite"
            role="button"
            aria-label="{{currentCard.isFavorited ? '取消收藏' : '收藏公式'}}"
          >
            <view class="fr-bookmark-icon"></view>
          </view>
          <formula-card
            card="{{currentCard}}"
            graphImageUrl="{{currentCard.graphImageUrl}}"
            bind:formulastart="onFormulaGestureStart"
            bind:formulaend="onFormulaGestureEnd"
          />
        </view>

        <view class="fr-swipe-note" wx:if="{{isRandom || sequenceIds.length > 1}}">
          <view class="fr-swipe-line"></view>
          <view class="fr-swipe-copy">
            <text>页面左右滑动切换速记卡</text>
            <text class="fr-swipe-sub">公式区域可独立横向滑动</text>
          </view>
          <view class="fr-swipe-line"></view>
        </view>
      </view>
      <view class="fr-bottom-space"></view>
    </view>
  </scroll-view>

  <view class="fr-nav-capsule" wx:if="{{!loading && !loadError && currentCard}}">
    <view
      class="fr-nav-hit {{!canGoPrev || loadingNext ? 'disabled' : ''}}"
      hover-class="fr-nav-pressed"
      bindtap="goPrev"
      role="button"
      aria-label="上一张速记卡"
    >
      <text class="fr-arrow fr-arrow-left"></text>
    </view>
    <view class="fr-nav-status">
      <view class="fr-nav-loader" wx:if="{{loadingNext}}"></view>
      <text wx:else>{{isRandom ? currentIndex + 1 : sequenceIndex + 1}} / {{isRandom ? displayCards.length : sequenceIds.length || 1}}</text>
    </view>
    <view
      class="fr-nav-hit next {{!canGoNext || loadingNext ? 'disabled' : ''}}"
      hover-class="fr-nav-pressed"
      bindtap="goNext"
      role="button"
      aria-label="下一张速记卡"
    >
      <text class="fr-arrow fr-arrow-right"></text>
    </view>
  </view>
</view>
