.fr-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}

.fr-swiper {
  flex: 1;
}

.fr-card-scroll {
  height: 100%;
}

.fr-card-wrap {
  padding: 20rpx 30rpx 40rpx;
  position: relative;
}

.fr-fav-btn {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  z-index: 5;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.fr-fav-btn.favorited {
  color: #ff6b6b;
}

.fr-fav-btn:not(.favorited) {
  color: #ccc;
}

.fr-nav-row {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}

.fr-nav-btn {
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4F7FFF;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.fr-nav-spacer {
  flex: 1;
}

.fr-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}
