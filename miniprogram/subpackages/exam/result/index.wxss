page{height:100%;background:#F6FBF8;color:#23483A;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Segoe UI","Hiragino Sans GB","Microsoft YaHei",sans-serif}
button{font-family:inherit}
.page{position:relative;height:100%;overflow:hidden;background:linear-gradient(180deg,#FFFFFF 0,#FAFDFC 15%,#F3F9F6 100%)}
.nav-shell{position:fixed;z-index:50;left:0;right:0;top:0;box-sizing:content-box;background:rgba(255,255,255,.98);border-bottom:1rpx solid rgba(25,91,67,.07);backdrop-filter:blur(18rpx)}
.nav-bar{position:relative;display:flex;align-items:center;justify-content:center;padding:0 26rpx;box-sizing:border-box}
.nav-back-hit{position:absolute;left:20rpx;top:50%;width:64rpx;height:64rpx;margin-top:-32rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #E2ECE7;border-radius:50%;background:#FFFFFF;box-shadow:0 5rpx 18rpx rgba(25,84,61,.035)}
.nav-back-hit-pressed{background:#F0F7F3;transform:scale(.97)}
.nav-back-icon{position:relative;width:22rpx;height:22rpx;border-left:3rpx solid #284438;border-bottom:3rpx solid #284438;transform:rotate(45deg) translate(2rpx,-2rpx);box-sizing:border-box}
.nav-title{color:#1B3027;font-size:32rpx;font-weight:700;letter-spacing:.2rpx}
.nav-right-space{position:absolute;right:0;width:190rpx;height:100%;pointer-events:none}
.page-scroll{position:absolute;left:0;right:0;bottom:0;box-sizing:border-box;overflow:hidden}
.content{height:100%;padding:10rpx 22rpx calc(10rpx + env(safe-area-inset-bottom));box-sizing:border-box;overflow:hidden;display:flex;flex-direction:column}

.state-card{min-height:430rpx;margin-top:8rpx;padding:76rpx 34rpx;box-sizing:border-box;border:1rpx solid #E1EEE7;border-radius:28rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#FFFFFF;box-shadow:0 14rpx 40rpx rgba(31,99,73,.05);text-align:center}
.state-spinner{width:48rpx;height:48rpx;border:5rpx solid #E1F0E8;border-top-color:#24AD7C;border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.state-title{margin-top:24rpx;color:#1D3C2F;font-size:28rpx;font-weight:800}
.state-desc{margin-top:12rpx;color:#819188;font-size:21rpx;line-height:1.65}
.state-action{margin-top:22rpx;padding:12rpx 24rpx;border-radius:999rpx;background:#EAF8F1;color:#159A6C;font-size:20rpx;font-weight:700}
.state-error .state-title{color:#A74646}

/* 方案四：圆环成绩 + 浅绿结果主视觉 */
.score-card{margin:0 2rpx;padding:10rpx 12rpx 12rpx;border:1rpx solid #DCEDE5;border-radius:28rpx;background:linear-gradient(145deg,#F2FBF7 0%,#F9FDFB 58%,#EFF9F5 100%);box-shadow:0 8rpx 24rpx rgba(32,117,82,.04)}
.score-main{height:188rpx;padding:0 28rpx 0 20rpx;box-sizing:border-box;display:flex;align-items:center;gap:34rpx}
.score-ring{position:relative;flex:0 0 auto;width:184rpx;height:184rpx;padding:14rpx;box-sizing:border-box;border-radius:50%;box-shadow:0 10rpx 26rpx rgba(31,157,111,.065)}
.score-ring-inner{position:relative;z-index:2;width:100%;height:100%;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#FFFFFF;box-shadow:inset 0 0 0 1rpx #E1EDE7,0 8rpx 22rpx rgba(27,102,74,.03)}
.score-ring-cap{position:absolute;z-index:1;width:14rpx;height:14rpx;margin:-7rpx 0 0 -7rpx;border-radius:50%;background:#37B987;box-shadow:0 1rpx 2rpx rgba(20,140,96,.08)}
.score-ring-cap-start{left:50%;top:3.7%}
.score-ring-cap-end{transform:translateZ(0)}
.score-value-row{display:flex;align-items:flex-end;justify-content:center;line-height:1}
.score-value{color:#174D3B;font-size:58rpx;font-weight:760;letter-spacing:-1.5rpx}
.score-label{margin-top:6rpx;color:#71857B;font-size:18rpx;font-weight:500}
.score-copy{flex:1;min-width:0;padding:2rpx 4rpx 0 0}
.encourage-row{display:flex;align-items:center;gap:12rpx}
.encourage-icon{width:32rpx;height:32rpx;flex:0 0 auto}
.encourage-title{min-width:0;color:#12966B;font-size:29rpx;font-weight:700;line-height:1.3;letter-spacing:.3rpx}
.encourage-desc{display:block;margin-top:18rpx;color:#72867C;font-size:20rpx;line-height:1.55;white-space:nowrap}
.encourage-highlight-value{margin-left:4rpx;color:#0C9F70;font-size:29rpx;font-weight:780;letter-spacing:-.3rpx}
.encourage-highlight-sign{margin-right:4rpx;color:#0C9F70;font-size:19rpx;font-weight:700;letter-spacing:-.2rpx}

.stats-panel{height:104rpx;margin:4rpx 0 0;display:flex;align-items:center;border:1rpx solid #DDEAE4;border-radius:18rpx;background:rgba(255,255,255,.97);box-shadow:0 5rpx 16rpx rgba(26,93,67,.03)}
.stat-item{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:visible}
.stat-divider{flex:0 0 auto;width:1rpx;height:48rpx;background:#D7E5DF}
.stat-value{max-width:100%;padding:2rpx 4rpx 3rpx;box-sizing:border-box;overflow:visible;color:#21483A;font-size:27rpx;font-weight:700;line-height:1.26;white-space:nowrap}
.stat-value-wrong{color:#E15A5D}
.stat-value-percent{display:flex;align-items:baseline;justify-content:center;line-height:1.22}
.stat-percent-value{font-size:29rpx;font-weight:760;letter-spacing:-.4rpx}
.stat-percent-sign{margin-left:1rpx;font-size:19rpx;font-weight:700;letter-spacing:-.2rpx}
.stat-value-time{font-size:28rpx;font-weight:760;line-height:1.26;letter-spacing:-.35rpx}
.stat-label{margin-top:3rpx;color:#74877E;font-size:18rpx;font-weight:400;line-height:1.3}

.result-card{margin-top:12rpx;padding:18rpx 20rpx 14rpx;border:1rpx solid #DCE9E3;border-radius:26rpx;background:#FFFFFF;box-shadow:0 7rpx 22rpx rgba(25,92,66,.035)}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}
.card-title-group{min-width:0;display:flex;align-items:center;gap:10rpx}
.card-icon-shell{flex:0 0 auto;width:42rpx;height:42rpx;border-radius:14rpx 14rpx 14rpx 7rpx;display:flex;align-items:center;justify-content:center}
.radar-icon-shell{background:linear-gradient(145deg,#51C99B,#32B987)}
.radar-mark{position:relative;width:20rpx;height:20rpx;border:3rpx solid #FFFFFF;border-radius:7rpx;box-sizing:border-box;transform:rotate(-6deg)}
.radar-mark::before{content:"";position:absolute;left:50%;top:50%;width:7rpx;height:7rpx;margin:-3.5rpx 0 0 -3.5rpx;border:2rpx solid #FFFFFF;border-radius:50%;box-sizing:border-box}
.radar-mark::after{content:"";position:absolute;right:-5rpx;top:2rpx;width:5rpx;height:5rpx;border-radius:50%;background:#FFFFFF}
.radar-mark-core{position:absolute;left:50%;top:-7rpx;width:4rpx;height:4rpx;margin-left:-2rpx;border-radius:50%;background:#FFFFFF;opacity:.9}
.card-title{min-width:0;color:#243F34;font-size:25rpx;font-weight:700;white-space:nowrap;letter-spacing:0}
.weak-badge{flex:0 0 auto;min-height:38rpx;padding:0 15rpx;border-radius:999rpx;display:flex;align-items:center;background:#F1F5F3;color:#77877F;font-size:17rpx;font-weight:500;box-sizing:border-box}
.weak-badge-pressed{background:#E5F2EB;transform:scale(.98)}

/* 雷达主体加大、标签内收，匹配方案四紧凑的五边形布局 */
.radar-card{display:flex;flex:1;min-height:0;flex-direction:column}
.radar-stage{position:relative;flex:1;min-height:520rpx;margin-top:4rpx;overflow:visible}
.radar-plot{position:absolute;left:50%;top:52%;width:432rpx;height:432rpx;transform:translate(-50%,-50%)}
.radar-grid-image{position:absolute;inset:0;width:100%;height:100%;opacity:.82}
.radar-data-fill{position:absolute;z-index:1;inset:0;background:rgba(46,187,136,.24);transition:clip-path .28s ease,-webkit-clip-path .28s ease}
.radar-edge{position:absolute;z-index:3;height:4rpx;margin-top:-2rpx;transform-origin:0 50%;border-radius:999rpx;background:#15A977}
.radar-point{position:absolute;z-index:4;width:14rpx;height:14rpx;margin:-7rpx 0 0 -7rpx;border:2rpx solid #FFFFFF;border-radius:50%;box-sizing:border-box;background:#18AA79;box-shadow:0 1rpx 5rpx rgba(7,123,83,.12)}
.radar-center-dot{position:absolute;z-index:2;left:50%;top:50%;width:6rpx;height:6rpx;margin:-3rpx 0 0 -3rpx;border-radius:50%;background:rgba(20,168,117,.16)}
.radar-axis-dot{position:absolute;z-index:2;width:5rpx;height:5rpx;margin:-2.5rpx 0 0 -2.5rpx;border-radius:50%;background:#72C8AA;box-shadow:0 0 0 2rpx #FFFFFF}
.radar-axis-dot-0{left:50%;top:7.5%}
.radar-axis-dot-1{left:90.4%;top:36.9%}
.radar-axis-dot-2{left:75%;top:84.4%}
.radar-axis-dot-3{left:25%;top:84.4%}
.radar-axis-dot-4{left:9.6%;top:36.9%}
.radar-label{position:absolute;z-index:5;min-width:126rpx;max-width:188rpx;display:flex;flex-direction:column;align-items:center;text-align:center}
.radar-label-0{left:50%;top:52%;transform:translate(-50%,-250rpx)}
.radar-label-1{left:50%;top:52%;transform:translate(150rpx,-120rpx);align-items:flex-start;text-align:left}
.radar-label-2{left:50%;top:52%;transform:translate(120rpx,110rpx);align-items:flex-start;text-align:left}
.radar-label-3{right:50%;top:52%;transform:translate(-120rpx,110rpx);align-items:flex-end;text-align:right}
.radar-label-4{right:50%;top:52%;transform:translate(-150rpx,-120rpx);align-items:flex-end;text-align:right}
.radar-label-clickable{cursor:pointer}
.radar-label-name{max-width:100%;overflow:hidden;color:#3D544A;font-size:19rpx;font-weight:500;white-space:nowrap;text-overflow:ellipsis}
.radar-label-score-row{margin-top:7rpx;display:flex;align-items:center;gap:13rpx;max-width:100%}
.radar-label-score{color:#058A60;font-size:28rpx;font-weight:760;line-height:1.1}
.radar-tag{padding:4rpx 9rpx;border-radius:7rpx;font-size:15rpx;line-height:1.15;font-weight:600;white-space:nowrap}
.radar-tag-excellent{color:#168C67;background:#E1F7ED;border:1rpx solid #AEE5CF}
.radar-tag-good{color:#2F8E68;background:#E8F7F0;border:1rpx solid #BDE6D3}
.radar-tag-fair{color:#A97624;background:#FFF6E4;border:1rpx solid #F2D9A9}
.radar-tag-weak{color:#D85E5E;background:#FFF0F0;border:1rpx solid #F3C5C5}

.top-card{padding:15rpx 20rpx 10rpx}
.top-card-head{padding-bottom:4rpx}
.crown-title-icon{flex:0 0 auto;width:35rpx;height:35rpx}
.crown-mark{position:relative;background:#F7B522;clip-path:polygon(3% 25%,25% 48%,37% 8%,51% 48%,70% 14%,81% 51%,98% 27%,88% 77%,12% 77%);-webkit-clip-path:polygon(3% 25%,25% 48%,37% 8%,51% 48%,70% 14%,81% 51%,98% 27%,88% 77%,12% 77%)}
.crown-mark::after{content:"";position:absolute;left:18%;right:18%;bottom:1rpx;height:4rpx;border-radius:999rpx;background:#F7B522}
.top-card .card-title{font-size:22rpx;font-weight:700}
.top-card-title{display:flex;align-items:center;gap:10rpx;letter-spacing:.8rpx}
.top-title-main,.top-title-suffix{display:inline-block;white-space:nowrap}
.top-title-suffix{letter-spacing:.5rpx}
.top-list{margin-top:2rpx}
.top-row{min-height:61rpx;display:grid;grid-template-columns:30rpx 154rpx minmax(0,1fr) 64rpx;align-items:center;gap:8rpx;border-bottom:1rpx solid #EDF2EF}
.top-row:last-child{border-bottom:0}
.top-rank{color:#224B3B;font-size:19rpx;font-weight:700;text-align:center}
.top-name{min-width:0;overflow:hidden;color:#475B52;font-size:17rpx;font-weight:500;letter-spacing:.8rpx;white-space:nowrap;text-overflow:ellipsis}
.top-progress{width:100%;height:10rpx;overflow:hidden;border-radius:999rpx;background:#E3EEEA}
.top-progress-fill{height:100%;border-radius:999rpx;background:#37BD8B}
.top-percent{color:#138B65;font-size:23rpx;font-weight:760;text-align:right}

.continue-button{flex:0 0 auto;height:72rpx;margin:12rpx 28rpx 0;display:flex;align-items:center;justify-content:center;box-sizing:border-box;border-radius:999rpx;background:linear-gradient(90deg,#37BB87,#31B982);color:#FFFFFF;font-size:25rpx;font-weight:700;box-shadow:0 10rpx 24rpx rgba(37,159,112,.12)}
.continue-button-pressed{opacity:.9;transform:translateY(1rpx)}
.bottom-safe-space{flex:0 0 auto;height:2rpx}

@media (max-width:360px){
  .content{padding-left:20rpx;padding-right:20rpx}
  .score-main{padding-left:14rpx;padding-right:14rpx;gap:24rpx}
  .score-ring{width:174rpx;height:174rpx}
  .score-value{font-size:55rpx}
  .encourage-title{font-size:27rpx}
  .encourage-desc{font-size:18rpx}
  .stat-value{font-size:26rpx}
  .stat-percent-value{font-size:28rpx}
  .stat-percent-sign{font-size:18rpx}
  .stat-value-time{font-size:27rpx}
  .result-card{padding-left:20rpx;padding-right:20rpx}
  .radar-stage{min-height:500rpx}
  .radar-plot{width:400rpx;height:400rpx}
  .radar-label{min-width:112rpx;max-width:160rpx}
  .radar-label-name{font-size:18rpx}
  .radar-label-score{font-size:26rpx}
  .radar-label-0{transform:translate(-50%,-232rpx)}
  .radar-label-1{transform:translate(140rpx,-110rpx)}
  .radar-label-2{transform:translate(108rpx,100rpx)}
  .radar-label-3{transform:translate(-108rpx,100rpx)}
  .radar-label-4{transform:translate(-140rpx,-110rpx)}

  .top-row{grid-template-columns:28rpx 138rpx minmax(0,1fr) 58rpx;gap:7rpx}
  .top-progress{width:100%}
  .continue-button{margin-left:24rpx;margin-right:24rpx}
}

/* 小屏设备仍保持单屏展示，不启用页面滚动 */
@media (max-height:720px){
  .content{padding-top:8rpx;padding-bottom:calc(8rpx + env(safe-area-inset-bottom))}
  .score-card{padding-top:8rpx;padding-bottom:10rpx}
  .score-main{height:170rpx}
  .score-ring{width:166rpx;height:166rpx;padding:13rpx}
  .score-value{font-size:52rpx}
  .encourage-desc{margin-top:13rpx}
  .stats-panel{height:94rpx}
  .result-card{margin-top:10rpx;padding-top:15rpx;padding-bottom:11rpx}
  .radar-stage{min-height:430rpx}
  .radar-plot{width:358rpx;height:358rpx}
  .radar-label-0{transform:translate(-50%,-210rpx)}
  .radar-label-1{transform:translate(126rpx,-100rpx)}
  .radar-label-2{transform:translate(98rpx,90rpx)}
  .radar-label-3{transform:translate(-98rpx,90rpx)}
  .radar-label-4{transform:translate(-126rpx,-100rpx)}

  .top-card{padding-top:12rpx;padding-bottom:8rpx}
  .top-row{min-height:54rpx}
  .continue-button{height:66rpx;margin-top:10rpx}
  .bottom-safe-space{height:4rpx}
}

/* v7：单屏布局细节修正 */
.score-card,.top-card,.continue-button,.bottom-safe-space{flex-shrink:0}
.top-card{margin-top:10rpx}
@media (min-height:721px){
  .radar-card{min-height:540rpx}
}

/* 交卷后专项 AI 老师 */
.teacher-modal-mask{position:fixed;inset:0;z-index:260;display:flex;align-items:flex-end}.teacher-modal-backdrop{position:absolute;inset:0;background:rgba(9,25,18,.5)}.teacher-sheet{position:relative;z-index:1;width:100%;max-height:84vh;min-height:38vh;padding:22rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#FBFAF6;box-sizing:border-box;box-shadow:0 -20rpx 60rpx rgba(18,45,33,.18)}.teacher-sheet-head{display:flex;justify-content:space-between;gap:18rpx;align-items:flex-start;padding-bottom:18rpx}.teacher-kicker{display:block;font-size:17rpx;letter-spacing:2rpx;font-weight:850;color:#6D776F}.teacher-sheet-title{display:block;margin-top:7rpx;font-size:31rpx;line-height:1.35;font-weight:850;color:#183327}.teacher-sheet-close{width:54rpx;height:54rpx;border-radius:50%;background:#ECEFE9;color:#5F6B63;font-size:40rpx;line-height:54rpx;text-align:center}.teacher-sheet-loading,.teacher-sheet-error{min-height:260rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;padding:20rpx;text-align:center;font-size:22rpx;line-height:1.6;color:#68736B}.teacher-sheet-error{color:#9B5847}.teacher-spinner{width:42rpx;height:42rpx;border:4rpx solid #DDE1DA;border-top-color:#315C48;border-radius:50%;animation:teacherSpin .8s linear infinite;box-sizing:border-box}@keyframes teacherSpin{to{transform:rotate(360deg)}}.teacher-sheet-scroll{max-height:68vh}.teacher-summary{display:block;padding:20rpx 22rpx;border-radius:18rpx;background:#EEF3EE;color:#29483A;font-size:24rpx;line-height:1.7}.teacher-result-section{margin-top:22rpx;padding:22rpx;border-radius:18rpx;border:1rpx solid #E0E3DD;background:#fff}.teacher-result-heading{display:block;margin-bottom:12rpx;font-size:24rpx;font-weight:820;color:#1B3529}.teacher-result-point{display:block;margin-top:8rpx;font-size:22rpx;line-height:1.68;color:#455249}.teacher-kp-row{padding:12rpx 0;border-top:1rpx solid #EEF0EB}.teacher-kp-name{display:block;font-size:22rpx;font-weight:760;color:#244436}.teacher-kp-note{display:block;margin-top:4rpx;font-size:19rpx;line-height:1.5;color:#7B857D}.teacher-practice-stem{display:block;font-size:23rpx;line-height:1.7;color:#263B31}.teacher-practice-option{margin-top:12rpx;padding:14rpx 16rpx;border-radius:13rpx;background:#F6F7F2;display:flex;gap:12rpx;font-size:21rpx;line-height:1.55;color:#3D4B43}.teacher-practice-key{font-weight:820;color:#1F5B40}.teacher-practice-answer{display:block;margin-top:16rpx;font-size:21rpx;font-weight:780;color:#17613F}.teacher-practice-analysis{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:#667168}.teacher-footnote{display:block;margin-top:18rpx;font-size:18rpx;line-height:1.5;color:#949B95;text-align:center}.teacher-scroll-space{height:24rpx}.teacher-feedback-row{display: flex;align-items: center;gap: 12rpx;margin-top: 24rpx;padding-top: 20rpx;border-top: 1rpx solid rgba(15,23,42,.08);}.teacher-feedback-label{flex: 1;font-size: 22rpx;color: #64748b;}.teacher-feedback-btn{margin: 0;padding: 0 18rpx;min-width: 108rpx;height: 52rpx;line-height: 52rpx;border-radius: 26rpx;background: #f6f7f4;color: #475569;font-size: 22rpx;font-weight: 600;}.teacher-feedback-btn::after{border: 0;}.teacher-feedback-btn.selected{background: #151a12;color: #fff;}.teacher-action-panel{padding:8rpx 0 10rpx}.teacher-action-title{display:block;margin-bottom:14rpx;font-size:22rpx;font-weight:800;color:#445149}.teacher-action-choice{margin:12rpx 0 0!important;padding:0 20rpx!important;height:68rpx;line-height:68rpx;border-radius:18rpx;background:#F1F4EF;color:#214333;text-align:left;font-size:22rpx;font-weight:750}.teacher-action-choice::after{border:0}.teacher-modal-mask{z-index: 1200;}.teacher-feedback-row{display: block;}.teacher-feedback-label{display: block;width: 100%;margin-bottom: 14rpx;line-height: 1.4;}.teacher-feedback-actions{display: grid;grid-template-columns: 1fr 1fr;gap: 14rpx;width: 100%;}.teacher-feedback-btn{width: 100%;min-width: 0;}
