page{background:#F3F4F1;color:#14261F}.page{min-height:100vh}.state{margin:120rpx 28rpx 0;padding:60rpx 30rpx;border-radius:28rpx;background:#fff;text-align:center;color:#718078}.state.error{color:#A25144}.score-hero{margin:24rpx 28rpx 30rpx;padding:38rpx 34rpx;border-radius:34rpx;background:#173B31;color:#F6F8F0;box-shadow:0 18rpx 50rpx rgba(20,38,31,.14)}.kicker{display:block;color:#C8F04A;font-size:20rpx;letter-spacing:4rpx;font-weight:700}.score-line{display:flex;align-items:baseline;margin-top:14rpx}.score-main{font-size:92rpx;line-height:1;font-weight:900}.score-total{margin-left:12rpx;color:rgba(255,255,255,.58);font-size:30rpx;font-weight:700}.score-label{display:block;margin-top:8rpx;font-size:27rpx;font-weight:800}.score-note{display:block;margin-top:12rpx;color:rgba(255,255,255,.62);font-size:22rpx;line-height:1.5}.hero-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid rgba(255,255,255,.13)}.hero-metrics view{text-align:center}.metric-value,.metric-label{display:block}.metric-value{font-size:29rpx;font-weight:900}.metric-label{margin-top:6rpx;color:rgba(255,255,255,.58);font-size:19rpx}.section{margin:0 28rpx 26rpx;padding:30rpx;border-radius:28rpx;background:#fff;border:1rpx solid rgba(20,38,31,.07)}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:22rpx;font-size:29rpx;font-weight:800}.section-head text:last-child{font-size:21rpx;color:#839088;font-weight:500}.subject-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.subject-card{padding:22rpx;border-radius:22rpx;background:#F3F5F0}.subject-top{display:flex;justify-content:space-between;gap:12rpx}.subject-name{font-size:23rpx;font-weight:800}.subject-acc{font-size:23rpx;color:#173B31;font-weight:900}.subject-score{display:block;margin-top:13rpx;font-size:24rpx;font-weight:800}.subject-meta{display:block;margin-top:7rpx;color:#7B8780;font-size:20rpx}.tag-row{display:flex;flex-wrap:wrap;gap:12rpx}.tag{padding:10rpx 16rpx;border-radius:999rpx;background:#EAF1D0;color:#33442E;font-size:21rpx}.review-card{padding:24rpx 0;border-top:1rpx solid #EEF0EC}.review-card:first-of-type{border-top:0}.review-top{display:flex;justify-content:space-between;gap:20rpx}.review-index{font-size:22rpx;color:#66756C;font-weight:700}.status{padding:5rpx 11rpx;border-radius:999rpx;font-size:19rpx}.status.wrong{color:#994B3F;background:#FBE6E0}.status.unanswered{color:#776226;background:#F7EECF}.stem{display:block;margin-top:15rpx;font-size:26rpx;line-height:1.55;font-weight:700}.answers{display:flex;flex-wrap:wrap;gap:10rpx 24rpx;margin-top:15rpx;color:#58685F;font-size:21rpx}.kp{display:block;margin-top:12rpx;color:#688044;font-size:20rpx}.analysis{display:block;margin-top:12rpx;padding:16rpx;border-radius:16rpx;background:#F5F6F2;color:#667169;font-size:21rpx;line-height:1.55}.empty-review{padding:28rpx;text-align:center;color:#718078;background:#F4F6F1;border-radius:20rpx}.wrong-btn{margin-top:20rpx;background:#EEF2E9;color:#173B31;border-radius:22rpx;font-size:24rpx;font-weight:800}.actions{display:flex;gap:16rpx;padding:0 28rpx}.actions button{flex:1;border-radius:24rpx;font-size:24rpx;font-weight:800}.secondary{background:#E8ECE6;color:#173B31}.primary{background:#C8F04A;color:#173B31}.safe-bottom{height:70rpx}

/* 408-ERROR exam review */
.exam-cause-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-top:18rpx;padding:16rpx;border-radius:16rpx;background:#f4f7f4}.exam-cause-copy{display:flex;align-items:center;gap:10rpx;min-width:0}.exam-cause-kicker{font-size:20rpx;color:#849087}.exam-cause-value{font-size:22rpx;font-weight:650;color:#2b3830}.exam-cause-ai{padding:4rpx 8rpx;border-radius:8rpx;background:#eef0ff;color:#5b62a8;font-size:17rpx}.exam-cause-action{margin:0;padding:0 14rpx;height:50rpx;line-height:50rpx;border-radius:14rpx;background:#17221b;color:#fff;font-size:20rpx;white-space:nowrap}.exam-cause-action::after{border:0}

/* 408-AI teacher, only available on result page after submit */
.exam-teacher-btn{margin:16rpx 0 0;padding:0 18rpx;height:58rpx;line-height:58rpx;border-radius:999rpx;background:#173B31;color:#C8F04A;font-size:21rpx;font-weight:800}.exam-teacher-btn::after{border:0}
.teacher-modal-mask{position:fixed;inset:0;z-index:200;display:flex;align-items:flex-end}.teacher-modal-backdrop{position:absolute;inset:0;background:rgba(9,25,18,.5)}.teacher-sheet{position:relative;z-index:1;width:100%;max-height:84vh;min-height:38vh;padding:22rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:34rpx 34rpx 0 0;background:#FBFAF6;box-sizing:border-box;box-shadow:0 -20rpx 60rpx rgba(18,45,33,.18)}.teacher-sheet-head{display:flex;justify-content:space-between;gap:18rpx;align-items:flex-start;padding-bottom:18rpx}.teacher-kicker{display:block;font-size:17rpx;letter-spacing:2rpx;font-weight:850;color:#6D776F}.teacher-sheet-title{display:block;margin-top:7rpx;font-size:31rpx;line-height:1.35;font-weight:850;color:#183327}.teacher-sheet-close{width:54rpx;height:54rpx;border-radius:50%;background:#ECEFE9;color:#5F6B63;font-size:40rpx;line-height:54rpx;text-align:center}.teacher-sheet-loading,.teacher-sheet-error{min-height:260rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;padding:20rpx;text-align:center;font-size:22rpx;line-height:1.6;color:#68736B}.teacher-sheet-error{color:#9B5847}.teacher-spinner{width:42rpx;height:42rpx;border:4rpx solid #DDE1DA;border-top-color:#315C48;border-radius:50%;animation:teacherSpin .8s linear infinite;box-sizing:border-box}@keyframes teacherSpin{to{transform:rotate(360deg)}}.teacher-sheet-scroll{max-height:68vh}.teacher-summary{display:block;padding:20rpx 22rpx;border-radius:18rpx;background:#EEF3EE;color:#29483A;font-size:24rpx;line-height:1.7}.teacher-result-section{margin-top:22rpx;padding:22rpx;border-radius:18rpx;border:1rpx solid #E0E3DD;background:#fff}.teacher-result-heading{display:block;margin-bottom:12rpx;font-size:24rpx;font-weight:820;color:#1B3529}.teacher-result-point{display:block;margin-top:8rpx;font-size:22rpx;line-height:1.68;color:#455249}.teacher-kp-row{padding:12rpx 0;border-top:1rpx solid #EEF0EB}.teacher-kp-name{display:block;font-size:22rpx;font-weight:760;color:#244436}.teacher-kp-note{display:block;margin-top:4rpx;font-size:19rpx;line-height:1.5;color:#7B857D}.teacher-practice-stem{display:block;font-size:23rpx;line-height:1.7;color:#263B31}.teacher-practice-option{margin-top:12rpx;padding:14rpx 16rpx;border-radius:13rpx;background:#F6F7F2;display:flex;gap:12rpx;font-size:21rpx;line-height:1.55;color:#3D4B43}.teacher-practice-key{font-weight:820;color:#1F5B40}.teacher-practice-answer{display:block;margin-top:16rpx;font-size:21rpx;font-weight:780;color:#17613F}.teacher-practice-analysis{display:block;margin-top:8rpx;font-size:20rpx;line-height:1.6;color:#667168}.teacher-footnote{display:block;margin-top:18rpx;font-size:18rpx;line-height:1.5;color:#949B95;text-align:center}.teacher-scroll-space{height:24rpx}

.teacher-feedback-row { display: flex; align-items: center; gap: 12rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(15, 23, 42, .08); }
.teacher-feedback-label { flex: 1; font-size: 22rpx; color: #64748b; }
.teacher-feedback-btn { margin: 0; padding: 0 18rpx; min-width: 108rpx; height: 52rpx; line-height: 52rpx; border-radius: 26rpx; background: #f6f7f4; color: #475569; font-size: 22rpx; font-weight: 600; }
.teacher-feedback-btn::after { border: 0; }
.teacher-feedback-btn.selected { background: #151a12; color: #fff; }
.teacher-action-panel{padding:8rpx 0 10rpx}.teacher-action-title{display:block;margin-bottom:14rpx;font-size:22rpx;font-weight:800;color:#445149}.teacher-action-choice{margin:12rpx 0 0!important;padding:0 20rpx!important;height:68rpx;line-height:68rpx;border-radius:18rpx;background:#F1F4EF;color:#214333;text-align:left;font-size:22rpx;font-weight:750}.teacher-action-choice::after{border:0}
