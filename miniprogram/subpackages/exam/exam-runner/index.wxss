page{background:#F3F4F1;color:#14261F}.page,.exam{height:100vh;box-sizing:border-box}.loading,.error-card{margin:220rpx 36rpx 0;padding:60rpx 34rpx;text-align:center;border-radius:28rpx;background:#fff;color:#6F7B74;font-size:26rpx}.error-card button{margin-top:24rpx;width:220rpx;background:#C8F04A;color:#173B31;font-size:24rpx}.submit-mask{position:fixed;inset:0;z-index:999;background:rgba(14,28,23,.48);display:flex;align-items:center;justify-content:center}.submit-card{width:480rpx;padding:42rpx 32rpx;border-radius:30rpx;background:#fff;text-align:center;color:#77827B;font-size:23rpx}.submit-title{display:block;margin-bottom:12rpx;color:#173B31;font-size:29rpx;font-weight:800}
