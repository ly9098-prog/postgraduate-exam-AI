<view class="page">
  <app-dialog id="appDialog" theme="mint"></app-dialog>
  <view class="loading" wx:if="{{loading}}">正在恢复选择题考试…</view>
  <view class="error-card" wx:elif="{{errorText}}">
    <text>{{errorText}}</text>
    <button bindtap="retry">重新加载</button>
  </view>
  <view class="exam" wx:else style="padding-top: {{statusBarHeight}}px;">
    <quiz-runner
      class="exam-runner"
      mode="exam"
      title="选择题考试"
      subjectName="{{paperTitle}}"
      questions="{{questions}}"
      currentQuestion="{{currentQuestion}}"
      answerState="{{currentAnswerState}}"
      currentIndex="{{currentIndex}}"
      totalCount="{{totalCount}}"
      answeredCount="{{answeredCount}}"
      progressPercent="{{progressPercent}}"
      elapsedText="{{remainingText}}"
      readonly="{{timeExpired || submitting}}"
      submitting="{{submitting}}"
      submitted="{{false}}"
      showFeedback="{{false}}"
      showAnswer="{{false}}"
      showBackButton="{{true}}"
      customNavigation="{{true}}"
      navigationBarHeight="{{navBarHeight}}"
      swipeThroughOptions="{{true}}"
      showMarkButton="{{true}}"
      markedForReview="{{markedForReview}}"
      submitText="交卷"
      bind:selectoption="selectOption"
      bind:togglemark="toggleMark"
      bind:prev="goPrev"
      bind:next="goNext"
      bind:jump="goQuestion"
      bind:submit="submitExam"
      bind:exit="requestExit"
    />
  </view>
  <view class="submit-mask" wx:if="{{submitting}}"><view class="submit-card"><text class="submit-title">正在提交选择题答卷</text><text>请勿关闭小程序</text></view></view>
</view>
