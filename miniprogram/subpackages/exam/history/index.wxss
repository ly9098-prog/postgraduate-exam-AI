page{background:#F3F4F1;color:#14261F}.page{min-height:100vh}.header{padding:26rpx 30rpx 34rpx}.kicker{display:block;font-size:20rpx;letter-spacing:4rpx;color:#6B7A70;font-weight:700}.title{display:block;margin-top:12rpx;font-size:36rpx;line-height:1.3;font-weight:800}.list{padding:0 28rpx}.item{padding:28rpx;margin-bottom:20rpx;border-radius:28rpx;background:#fff;border:1rpx solid rgba(20,38,31,.07)}.item-head{display:flex;justify-content:space-between;gap:24rpx;align-items:flex-start}.item-title{font-size:29rpx;line-height:1.35;font-weight:800;flex:1}.score{font-size:28rpx;font-weight:900;color:#173B31;white-space:nowrap}.meta{display:flex;flex-wrap:wrap;gap:12rpx 22rpx;margin-top:20rpx;color:#718078;font-size:22rpx}.foot{display:flex;justify-content:space-between;margin-top:22rpx;padding-top:18rpx;border-top:1rpx solid #EEF0EC;color:#738078;font-size:22rpx}.foot text:last-child{color:#173B31;font-weight:700}.state{margin:0 28rpx;padding:60rpx 30rpx;text-align:center;border-radius:28rpx;background:#fff;color:#718078;font-size:25rpx}.state.error{color:#A25144}.pressed{opacity:.72}.safe-bottom{height:60rpx}
