page {
  background: #F8FCFA;
  color: #173A31;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 100% 88%, rgba(73, 205, 164, 0.08), transparent 260rpx),
    #F8FCFA;
}

.history-shell {
  padding: 22rpx 30rpx 18rpx;
}

.overview-card {
  position: relative;
  min-height: 178rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  padding: 24rpx 76rpx 22rpx 24rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(70, 201, 160, 0.15);
  background: linear-gradient(135deg, #E8FAF4 0%, #F4FCF8 56%, #E8F9F4 100%);
  box-shadow: 0 12rpx 28rpx rgba(38, 122, 95, 0.06);
  overflow: hidden;
}

.overview-card::after {
  content: '';
  position: absolute;
  right: -34rpx;
  bottom: -74rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(67, 199, 157, 0.10);
}

.overview-icon {
  width: 66rpx;
  height: 66rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #45C8A2, #2DB98F);
  box-shadow: 0 10rpx 20rpx rgba(47, 185, 143, 0.20);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  padding: 15rpx 13rpx;
  box-sizing: border-box;
}

.overview-icon .bar {
  width: 6rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
}

.bar-1 { height: 18rpx; }
.bar-2 { height: 28rpx; }
.bar-3 { height: 22rpx; }
.bar-4 { height: 36rpx; }

.overview-body {
  min-width: 0;
  flex: 1;
}

.overview-count {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  color: #6B8179;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.overview-highlight {
  color: #0E9E73;
  font-size: 29rpx;
  font-weight: 900;
}

.overview-stats {
  display: flex;
  align-items: center;
  margin-top: 19rpx;
}

.overview-stat {
  min-width: 0;
  flex: 1;
}

.overview-stat-accuracy {
  padding-left: 27rpx;
}

.overview-label,
.record-label {
  display: block;
  color: #7B8C86;
  font-size: 20rpx;
  line-height: 1.3;
}

.overview-value-row,
.record-score-row {
  display: flex;
  align-items: baseline;
  gap: 7rpx;
  margin-top: 4rpx;
}

.overview-value {
  color: #17624F;
  font-size: 35rpx;
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: 0.2rpx;
}

.overview-denominator {
  color: #7E918A;
  font-size: 22rpx;
  font-weight: 600;
}

.overview-divider {
  width: 1rpx;
  height: 58rpx;
  margin-left: 18rpx;
  background: rgba(50, 147, 117, 0.14);
}

.overview-trend {
  position: absolute;
  top: 26rpx;
  right: 28rpx;
  color: #55C8A6;
  font-family: Arial, sans-serif;
  font-size: 38rpx;
  font-weight: 500;
  transform: rotate(-2deg);
}

.timeline {
  margin-top: 20rpx;
}

.history-entry {
  display: flex;
  align-items: stretch;
  min-height: 190rpx;
}

.timeline-meta {
  position: relative;
  width: 122rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  padding: 14rpx 8rpx 18rpx 42rpx;
}

.timeline-line {
  position: absolute;
  left: 13rpx;
  top: 36rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: linear-gradient(180deg, #50CDA9, rgba(80, 205, 169, 0.38));
}

.timeline-dot {
  position: absolute;
  left: 5rpx;
  top: 24rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #3BC39A;
  box-shadow: 0 0 0 7rpx #F8FCFA;
}

.timeline-date-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.timeline-date {
  color: #4A6860;
  font-size: 24rpx;
  line-height: 1.15;
  font-weight: 850;
  white-space: nowrap;
}

.timeline-year {
  margin-top: 8rpx;
  color: #A0AEA9;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 600;
}

.timeline-time {
  margin-top: 7rpx;
  color: #70A092;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 650;
  letter-spacing: 0.3rpx;
}

.record-card {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 166rpx;
  box-sizing: border-box;
  padding: 22rpx 58rpx 19rpx 25rpx;
  border: 1rpx solid rgba(25, 74, 60, 0.055);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 24rpx rgba(30, 92, 74, 0.055);
  transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease;
  will-change: transform;
}

.record-card-pressed {
  transform: scale(0.992);
  opacity: 0.86;
  box-shadow: 0 4rpx 14rpx rgba(30, 92, 74, 0.04);
}

.record-title-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.record-title {
  display: block;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #285A4B;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 850;
}

.record-arrow {
  position: absolute;
  right: 22rpx;
  top: 50%;
  color: #8DA6A0;
  font-family: Arial, sans-serif;
  font-size: 40rpx;
  line-height: 1;
  transform: translateY(-50%);
}

.record-metrics {
  display: flex;
  align-items: flex-end;
  margin-top: 22rpx;
}

.record-metric {
  min-width: 0;
  width: 50%;
}

.record-metric-accuracy {
  padding-left: 24rpx;
  border-left: 1rpx solid #EEF4F1;
}

.record-value {
  display: inline-block;
  margin-top: 4rpx;
  color: #17624F;
  font-size: 31rpx;
  line-height: 1.12;
  font-weight: 900;
}

.record-total {
  color: #83958E;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 600;
}

.state-card {
  margin-top: 24rpx;
  padding: 72rpx 38rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 58, 49, 0.06);
  text-align: center;
  color: #7D8E87;
  font-size: 23rpx;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.loading-dot {
  width: 17rpx;
  height: 17rpx;
  border-radius: 50%;
  background: #38BE96;
  animation: history-pulse 1.1s ease-in-out infinite alternate;
}

.loading-dot.small {
  width: 12rpx;
  height: 12rpx;
}

@keyframes history-pulse {
  from { opacity: 0.34; transform: scale(0.78); }
  to { opacity: 1; transform: scale(1); }
}

.state-title {
  display: block;
  color: #284D42;
  font-size: 28rpx;
  font-weight: 850;
}

.state-copy {
  display: block;
  max-width: 500rpx;
  margin: 13rpx auto 0;
  color: #87958F;
  font-size: 22rpx;
  line-height: 1.7;
}

.state-action {
  display: inline-block;
  margin-top: 22rpx;
  color: #18A879;
  font-size: 22rpx;
  font-weight: 800;
}

/* Empty history: reference-style illustration state, intentionally not carded. */
.empty-state {
  min-height: calc(100vh - 230rpx - env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 102rpx 16rpx 38rpx;
  text-align: center;
}

.empty-illustration {
  display: block;
  width: 606rpx;
  max-width: 100%;
  height: auto;
  flex-shrink: 0;
}

.empty-title {
  display: block;
  margin-top: 20rpx;
  color: #173A36;
  font-size: 44rpx;
  line-height: 1.28;
  font-weight: 850;
  letter-spacing: 1.6rpx;
}

.empty-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
  color: #78908B;
  font-size: 29rpx;
  line-height: 1.65;
  font-weight: 500;
  letter-spacing: 0.6rpx;
}

@media screen and (max-height: 720px) {
  .empty-state {
    min-height: calc(100vh - 214rpx - env(safe-area-inset-bottom));
    padding-top: 64rpx;
  }

  .empty-illustration {
    width: 540rpx;
  }

  .empty-title {
    margin-top: 12rpx;
    font-size: 40rpx;
  }

  .empty-copy {
    margin-top: 20rpx;
    font-size: 27rpx;
  }
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 0 6rpx;
  color: #84958F;
  font-size: 21rpx;
}

.safe-bottom {
  height: calc(18rpx + env(safe-area-inset-bottom));
}

@media (prefers-reduced-motion: reduce) {
  .record-card,
  .loading-dot {
    transition: none !important;
    animation: none !important;
  }
}
