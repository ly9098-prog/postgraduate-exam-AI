<view class="page">
  <app-dialog id="appDialog" />
  <premium-nav title="选择题套卷" variant="light" bind:back="goBack" />

  <view class="hero-stage">
    <image class="hero-art" src="./assets/paper-list-bg.jpg" mode="widthFix" aria-hidden="true" />
    <view class="hero-wash" aria-hidden="true"></view>

    <view class="search-shell {{searchFocused ? 'is-focused' : ''}}">
      <view class="search-icon" aria-hidden="true">
        <view class="search-icon-ring"></view>
        <view class="search-icon-handle"></view>
      </view>
      <input
        class="search-input"
        value="{{searchInput}}"
        focus="{{searchFocused}}"
        placeholder="搜索题目 / 题库 / 关键词"
        placeholder-class="search-placeholder"
        confirm-type="search"
        maxlength="60"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
        aria-label="搜索选择题套卷"
      />
      <view
        wx:if="{{searchInput}}"
        class="search-clear"
        catchtap="clearSearch"
        hover-class="search-clear-pressed"
        aria-role="button"
        aria-label="清空搜索"
      >×</view>
      <view
        class="search-submit"
        catchtap="onSearchConfirm"
        hover-class="search-submit-pressed"
        aria-role="button"
        aria-label="搜索"
      >
        <view class="search-submit-ring"></view>
        <view class="search-submit-handle"></view>
      </view>
    </view>

    <view class="hero-copy">
      <text class="hero-title">让刷题</text>
      <text class="hero-title">更简单</text>
      <text class="hero-subtitle">精选真题 · 高效备考</text>
      <view class="hero-rule"></view>
    </view>
  </view>

  <view class="content-panel">
    <view class="section-toolbar" wx:if="{{!loading && !errorText && visiblePapers.length > 0}}">
      <view class="section-toolbar-copy">
        <text class="section-kicker">CHOICE PAPER</text>
        <text class="section-title">真题与模拟</text>
      </view>
      <view class="history-link" bindtap="goHistory" hover-class="soft-pressed" aria-role="button" aria-label="查看历史考试">
        <text>考试记录</text>
        <text class="history-arrow">→</text>
      </view>
    </view>

    <view class="search-summary" wx:if="{{activeQuery && !loading && !errorText && visiblePapers.length > 0}}">
      <text class="search-summary-main">“{{activeQuery}}”</text>
      <text class="search-summary-sub">找到 {{visiblePapers.length}} 套</text>
    </view>

    <view class="skeleton-list" wx:if="{{loading}}">
      <view class="paper-card skeleton-card">
        <view class="skeleton-line skeleton-chip"></view>
        <view class="skeleton-line skeleton-title"></view>
        <view class="skeleton-line skeleton-desc"></view>
        <view class="skeleton-divider"></view>
        <view class="skeleton-line skeleton-year"></view>
        <view class="skeleton-meta-row"><view></view><view></view><view></view></view>
      </view>
      <view class="paper-card skeleton-card skeleton-card-secondary">
        <view class="skeleton-line skeleton-chip"></view>
        <view class="skeleton-line skeleton-title"></view>
        <view class="skeleton-line skeleton-desc"></view>
      </view>
    </view>

    <view class="state-card error" wx:elif="{{errorText}}">
      <view class="state-icon state-icon-error">!</view>
      <text class="state-title">试卷加载失败</text>
      <text class="state-sub">{{errorText}}</text>
      <view class="state-action" bindtap="retryLoad" hover-class="state-action-pressed">重新加载</view>
    </view>

    <view class="empty-state-card" wx:elif="{{(activeQuery || searchInput) && visiblePapers.length === 0}}">
      <image
        class="empty-state-art"
        src="./assets/paper-search-empty.png"
        mode="widthFix"
        aria-hidden="true"
      />
      <text class="empty-state-title">没有找到相关套卷</text>
      <text class="empty-state-desc">试试在搜索框中输入题目名称、来源或“真题 / 模拟”等关键词。</text>
    </view>

    <view class="empty-state-card" wx:elif="{{papers.length === 0}}">
      <image
        class="empty-state-art"
        src="./assets/paper-search-empty.png"
        mode="widthFix"
        aria-hidden="true"
      />
      <text class="empty-state-title">暂时没有可用套卷</text>
      <text class="empty-state-desc">已发布的选择题套卷会自动出现在这里。</text>
    </view>

    <view class="paper-list" wx:else>
      <view
        class="paper-card {{item.isSuggested ? 'paper-card-suggested' : ''}} {{startingId === item.id ? 'paper-card-starting' : ''}} {{cancellingAttemptId === item.latest_attempt_id ? 'paper-card-cancelling' : ''}}"
        wx:for="{{visiblePapers}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openPaper"
        hover-class="card-pressed"
        aria-role="button"
        aria-label="{{item.title}}，{{item.question_count}}题，{{item.scoreText}}分"
      >
        <view class="paper-card-head">
          <view class="paper-card-type-wrap">
            <view class="paper-card-icon" aria-hidden="true">
              <view class="paper-card-icon-page">
                <view class="paper-card-icon-line paper-card-icon-line-top"></view>
                <view class="paper-card-icon-line paper-card-icon-line-bottom"></view>
              </view>
            </view>
            <text class="paper-type">{{item.typeLabel}}</text>
          </view>
          <text class="paper-year-pill" wx:if="{{item.year}}">{{item.year}}</text>
          <text class="paper-year-pill paper-year-pill-text" wx:else>{{item.typeLabel}}</text>
        </view>

        <text class="paper-title">{{item.title}}</text>

        <view class="paper-meta-line">
          <text>{{item.question_count}} 题</text>
          <text>{{item.scoreText}} 分（选择题）</text>
          <text wx:if="{{item.durationMinutes}}">{{item.durationMinutes}} 分钟</text>
          <text wx:else>不限时</text>
        </view>

        <view class="paper-divider"></view>

        <view class="paper-foot">
          <view class="paper-foot-left">
            <view
              wx:if="{{item.canResume}}"
              class="paper-cancel-resume {{cancellingAttemptId === item.latest_attempt_id ? 'is-loading' : ''}}"
              data-id="{{item.id}}"
              data-attempt-id="{{item.latest_attempt_id}}"
              catchtap="cancelResume"
              hover-class="paper-cancel-resume-pressed"
              hover-stop-propagation="true"
              aria-role="button"
              aria-label="取消 {{item.title}} 的当前作答进度"
            >
              <text>{{cancellingAttemptId === item.latest_attempt_id ? '取消中…' : '取消作答'}}</text>
            </view>
            <text class="paper-source">{{item.source || 'MemoGrad'}}</text>
          </view>
          <view class="paper-action-wrap">
            <text class="paper-action" wx:if="{{startingId === item.id}}">正在创建…</text>
            <text class="paper-action" wx:elif="{{item.canResume}}">继续作答</text>
            <text class="paper-action" wx:elif="{{item.bestScoreText}}">再做一次</text>
            <text class="paper-action" wx:else>开始作答</text>
            <text class="paper-action-arrow" wx:if="{{startingId !== item.id && cancellingAttemptId !== item.latest_attempt_id}}">→</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
