page { background: #F3F4F1; color: #14261F; }
.page { min-height: 100vh; box-sizing: border-box; padding-bottom: 48rpx; }
.hero { margin: 24rpx 28rpx 34rpx; padding: 38rpx 34rpx; border-radius: 34rpx; background: #173B31; color: #F5F7EF; box-shadow: 0 18rpx 48rpx rgba(20,38,31,.13); }
.hero-kicker { display:block; font-size: 20rpx; letter-spacing: 4rpx; color:#C8F04A; font-weight:700; }
.hero-title { display:block; margin-top:18rpx; font-size:42rpx; line-height:1.25; font-weight:800; }
.hero-desc { display:block; margin-top:16rpx; font-size:25rpx; line-height:1.65; color:rgba(245,247,239,.72); }
.history-link { display:flex; justify-content:space-between; align-items:center; margin-top:30rpx; padding-top:24rpx; border-top:1rpx solid rgba(255,255,255,.13); color:#C8F04A; font-size:25rpx; font-weight:700; }
.paper-list { padding: 0 28rpx; }
.paper-card { margin-bottom:22rpx; padding:30rpx; border-radius:28rpx; background:#fff; border:1rpx solid rgba(20,38,31,.07); box-shadow:0 8rpx 24rpx rgba(20,38,31,.045); }
.paper-head { display:flex; justify-content:space-between; gap:20rpx; }
.paper-type { display:block; color:#6A786F; font-size:21rpx; letter-spacing:2rpx; }
.paper-title { display:block; margin-top:9rpx; font-size:31rpx; line-height:1.35; font-weight:800; }
.paper-year { min-width:86rpx; text-align:center; font-size:23rpx; padding:10rpx 12rpx; border-radius:999rpx; color:#173B31; background:#E9F4BE; height:max-content; }
.paper-meta { display:flex; flex-wrap:wrap; gap:12rpx 22rpx; margin-top:24rpx; font-size:23rpx; color:#59685F; }
.paper-foot { display:flex; justify-content:space-between; gap:20rpx; margin-top:26rpx; padding-top:22rpx; border-top:1rpx solid #EDF0EB; font-size:23rpx; }
.paper-source { color:#829087; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.paper-action { color:#173B31; font-weight:800; flex-shrink:0; }
.state-card { margin:0 28rpx; padding:58rpx 34rpx; text-align:center; border-radius:28rpx; background:#fff; color:#6D7A72; font-size:26rpx; }
.state-card.error { color:#9B4B40; }
.state-sub,.retry { display:block; margin-top:12rpx; font-size:22rpx; color:#929D96; }
.retry { color:#173B31; font-weight:700; }
.card-pressed,.soft-pressed { opacity:.72; transform:scale(.99); }
.safe-bottom { height:60rpx; }

.paper-card-suggested { border-color:#C9DA8F; box-shadow:0 10rpx 30rpx rgba(95,121,54,.10); }
.paper-type-row { display:flex; align-items:center; gap:12rpx; flex-wrap:wrap; }
.paper-suggested { padding:5rpx 10rpx; border-radius:999rpx; background:#E9F4BE; color:#47612F; font-size:18rpx; font-weight:800; }
