/* 推荐原因 · 参考图还原 */
.runner-recommend-bar,
.runner-theme-premium-review .runner-recommend-bar {
  min-height: 92rpx;
  margin: -4rpx 0 24rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid #DDEAE5;
  border-left: 1rpx solid #DDEAE5;
  border-radius: 16rpx;
  background: linear-gradient(105deg, #F8FFFC 0%, #FBFEFC 56%, #F7FBF9 100%);
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 18rpx rgba(20, 73, 48, .025);
}

.runner-recommend-icon-wrap {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.runner-recommend-icon {
  width: 46rpx;
  height: 46rpx;
  display: block;
}

.runner-recommend-divider {
  width: 2rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #78CEA2;
  flex-shrink: 0;
}

.runner-recommend-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.runner-recommend-label,
.runner-theme-premium-review .runner-recommend-label {
  width: 92rpx;
  flex: 0 0 92rpx;
  color: #126438;
  font-size: 23rpx;
  line-height: 1.22;
  font-weight: 900;
  letter-spacing: .5rpx;
  white-space: nowrap;
}

.runner-recommend-copy-divider {
  width: 1rpx;
  height: 48rpx;
  background: #E7EEEA;
  flex-shrink: 0;
}

.runner-recommend-text,
.runner-theme-premium-review .runner-recommend-text {
  flex: 1;
  min-width: 0;
  color: #52645A;
  font-size: 19rpx;
  line-height: 1.52;
  font-weight: 450;
}

.runner-mode-wrong-detail .runner-recommend-bar {
  margin: -2rpx 0 24rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #DDEAE5;
  border-radius: 16rpx;
  background: linear-gradient(105deg, #F8FFFC 0%, #FBFEFC 56%, #F7FBF9 100%);
}

.runner-mode-wrong-detail .runner-recommend-label {
  color: #126438;
  font-size: 23rpx;
  font-weight: 900;
}

.runner-mode-wrong-detail .runner-recommend-text {
  color: #52645A;
  font-size: 23rpx;
  line-height: 1.68;
}

@media (max-width: 360px) {
  .runner-recommend-bar,
  .runner-theme-premium-review .runner-recommend-bar {
    gap: 10rpx;
    padding-left: 14rpx;
    padding-right: 14rpx;
  }

  .runner-recommend-icon-wrap,
  .runner-recommend-icon {
    width: 42rpx;
    height: 42rpx;
  }

  .runner-recommend-copy {
    gap: 11rpx;
  }

  .runner-recommend-label,
  .runner-theme-premium-review .runner-recommend-label {
    width: 84rpx;
    flex-basis: 84rpx;
    font-size: 21rpx;
  }

  .runner-recommend-text,
  .runner-theme-premium-review .runner-recommend-text {
    font-size: 18rpx;
    line-height: 1.5;
  }
}
