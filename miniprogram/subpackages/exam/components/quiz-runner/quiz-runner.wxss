@import '../../../../styles/tokens.wxss';.quiz-runner{display: flex;flex-direction: column;height: 100%;min-height: 0;overflow: hidden;background: #F4F5F2;color: #18231C;box-sizing: border-box;}
.runner-hero{position: relative;overflow: hidden;flex-shrink: 0;padding: 22rpx 30rpx 30rpx;background: radial-gradient(circle at 88% 8%,rgba(174,239,0,0.16) 0,rgba(174,239,0,0) 34%),linear-gradient(145deg,#163122 0%,#0D2117 58%,#09150F 100%);color: #FFFFFF;box-sizing: border-box;}
.runner-hero-glow{position: absolute;right: -90rpx;bottom: -110rpx;width: 300rpx;height: 300rpx;border: 1rpx solid rgba(174,239,0,0.14);border-radius: 50%;box-shadow: 0 0 0 42rpx rgba(174,239,0,0.028),0 0 0 88rpx rgba(174,239,0,0.018);pointer-events: none;}
.runner-hero-grid{position: absolute;top: -28rpx;right: -20rpx;width: 300rpx;height: 220rpx;opacity: 0.055;transform: rotate(8deg);background-image: linear-gradient(rgba(255,255,255,0.7) 1rpx,transparent 1rpx),linear-gradient(90deg,rgba(255,255,255,0.7) 1rpx,transparent 1rpx);background-size: 28rpx 28rpx;pointer-events: none;}
.runner-hero-nav,.runner-hero-meta,.runner-number-row,.runner-segment-progress{position: relative;z-index: 2;}
.runner-hero-nav{display: flex;align-items: center;justify-content: space-between;gap: 18rpx;min-height: 64rpx;}
.runner-custom-navigation .runner-hero-nav{padding-right: 188rpx;}
.runner-hero-left{display: flex;align-items: center;gap: 16rpx;min-width: 0;}
.runner-back-btn{width: 58rpx;height: 58rpx;border-radius: 50%;border: 1rpx solid rgba(255,255,255,0.18);display: flex;align-items: center;justify-content: center;background: rgba(255,255,255,0.06);flex-shrink: 0;}
.runner-back-symbol{color: #FFFFFF;font-size: 48rpx;line-height: 1;transform: translateY(-2rpx);font-family: Arial,sans-serif;}
.runner-eyebrow{color: #AEEF00;font-size: 21rpx;font-weight: 800;letter-spacing: 4rpx;white-space: nowrap;}
.runner-sheet-trigger{min-width: 112rpx;height: 58rpx;padding: 0 18rpx;border-radius: 18rpx;border: 1rpx solid rgba(215,255,104,0.24);display: flex;align-items: center;justify-content: center;gap: 8rpx;background: rgba(255,255,255,0.065);box-sizing: border-box;flex-shrink: 0;}
.runner-sheet-trigger-icon{width: 24rpx;height: 24rpx;color: #AEEF00;}
.runner-sheet-trigger-text{color: #FFFFFF;font-size: 22rpx;font-weight: 700;}
.runner-control-pressed{opacity: 0.72;transform: scale(0.96);}
.runner-hero-meta{margin-top: 24rpx;display: flex;align-items: center;justify-content: space-between;gap: 24rpx;}
.runner-subject{min-width: 0;max-width: 520rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;font-size: 38rpx;line-height: 1.25;font-weight: 900;letter-spacing: 1rpx;}
.runner-timer{flex-shrink: 0;font-size: 23rpx;color: rgba(255,255,255,0.76);font-weight: 700;font-variant-numeric: tabular-nums;letter-spacing: 1rpx;}
.runner-number-row{margin-top: 22rpx;display: flex;align-items: flex-end;justify-content: space-between;}
.runner-number-wrap{display: flex;align-items: baseline;line-height: 1;}
.runner-number-current{font-size: 78rpx;font-weight: 900;letter-spacing: -3rpx;font-variant-numeric: tabular-nums;}
.runner-number-divider{margin: 0 10rpx 0 12rpx;color: #AEEF00;font-size: 42rpx;font-weight: 300;}
.runner-number-total{color: rgba(255,255,255,0.62);font-size: 34rpx;font-weight: 650;font-variant-numeric: tabular-nums;}
.runner-number-caption{padding-bottom: 8rpx;color: rgba(255,255,255,0.36);font-size: 19rpx;letter-spacing: 4rpx;font-weight: 700;}
.runner-segment-progress{margin-top: 24rpx;display: flex;align-items: center;gap: 6rpx;width: 100%;}
.runner-segment{flex: 1;min-width: 5rpx;height: 7rpx;border-radius: 999rpx;background: rgba(255,255,255,0.22);transition: background 0.2s ease,transform 0.2s ease;}
.runner-segment.past,.runner-segment.answered{background: rgba(174,239,0,0.64);}
.runner-segment.current{background: #AEEF00;transform: scaleY(1.45);box-shadow: 0 0 18rpx rgba(174,239,0,0.34);}
.runner-segment.correct{background: #2AB66F;}
.runner-segment.wrong{background: #F05A51;}
.runner-segment.current.correct,.runner-segment.current.wrong{transform: scaleY(1.45);}
.runner-question-area{flex: 1;min-height: 0;overflow-y: auto;padding: 0 24rpx 22rpx;background: #F4F5F2;box-sizing: border-box;}
.runner-q-wrap{position: relative;z-index: 3;margin-top: -1rpx;padding: 30rpx 26rpx 32rpx;background: #FFFFFF;border-radius: 0 0 30rpx 30rpx;border: 1rpx solid rgba(219,226,219,0.92);border-top: none;box-shadow: 0 18rpx 42rpx rgba(16,37,26,0.07);box-sizing: border-box;transition: transform 0.15s ease,opacity 0.15s ease;}
.runner-q-wrap.slide-out-left{transform: translateX(-52rpx);opacity: 0;}
.runner-q-wrap.slide-out-right{transform: translateX(52rpx);opacity: 0;}
.runner-q-wrap.slide-in{animation: runnerSlideIn 0.16s ease;}
@keyframes runnerSlideIn{from{opacity: 0;transform: translateY(18rpx);}
to{opacity: 1;transform: translateY(0);}
}
.runner-q-card-head{display: flex;align-items: center;justify-content: space-between;gap: 16rpx;margin-bottom: 24rpx;}
.runner-q-labels{display: flex;flex-wrap: wrap;align-items: center;gap: 10rpx;min-width: 0;}
.runner-q-badge{padding: 7rpx 14rpx;border-radius: 8rpx;background: #EDF7E8;color: #1D6D3E;font-size: 21rpx;font-weight: 800;line-height: 1.3;}
.runner-q-badge-smart{background: #F1F3EE;color: #59665D;}
.runner-q-badge-review{background: #FFF0EE;color: #D74E45;}
.runner-master-btn{height: 54rpx;padding: 0 16rpx;border-radius: 15rpx;border: 1rpx solid #DCE8DD;display: flex;align-items: center;gap: 7rpx;flex-shrink: 0;background: #F8FAF7;}
.runner-master-btn-pressed{transform: scale(0.96);background: #F0F6EE;}
.runner-master-icon{width: 24rpx;height: 24rpx;color: #1D6D3E;}
.runner-master-text{color: #1D6D3E;font-size: 21rpx;font-weight: 750;}
.runner-recommend-bar{margin: -4rpx 0 24rpx;padding: 14rpx 16rpx;border-left: 5rpx solid #AEEF00;background: #F5F7F2;display: flex;align-items: flex-start;gap: 12rpx;box-sizing: border-box;}
.runner-recommend-label{flex-shrink: 0;color: #25352A;font-size: 21rpx;font-weight: 800;}
.runner-recommend-text{color: #6B756E;font-size: 22rpx;line-height: 1.55;}
.runner-q-content,.runner-mixed-text-block,.runner-mixed-latex-block{display: block;color: #18231C;font-size: 31rpx;line-height: 1.82;word-break: break-word;white-space: pre-wrap;}
.runner-q-content{margin-bottom: 30rpx;}
.runner-mixed-text-block,.runner-mixed-latex-block{margin-bottom: 20rpx;}
.runner-code-wrapper{display: block;width: 100%;max-width: 100%;margin: 12rpx 0 30rpx;padding: 22rpx 0;border-radius: 18rpx;background: linear-gradient(180deg,rgba(255,255,255,0.025),rgba(255,255,255,0)),#17211B;border: 1rpx solid rgba(215,255,104,0.12);overflow: hidden;box-sizing: border-box;}
.runner-mixed-code-block{margin: 14rpx 0 28rpx;}
.runner-code-lines{display: inline-block;min-width: 100%;padding-right: 26rpx;box-sizing: border-box;}
.runner-code-line{display: flex;align-items: flex-start;min-height: 42rpx;white-space: nowrap;}
.runner-code-no{width: 62rpx;padding-right: 16rpx;border-right: 1rpx solid rgba(255,255,255,0.1);color: #AEEF00;opacity: 0.78;text-align: right;font-family: Menlo,Monaco,Consolas,'Courier New',monospace;font-size: 23rpx;line-height: 1.72;font-variant-numeric: tabular-nums;flex-shrink: 0;box-sizing: border-box;user-select: none;}
.runner-code-text{display: block;padding-left: 18rpx;color: #F2F5F0;font-family: Menlo,Monaco,Consolas,'Courier New',monospace;font-size: 25rpx;line-height: 1.72;white-space: pre;}
.runner-options,.runner-blank-group-options,.runner-blank-options{display: flex;flex-direction: column;}
.runner-options,.runner-blank-group-options{gap: 14rpx;}
.runner-blank-options{gap: 24rpx;}
.runner-option-item{position: relative;display: flex;align-items: flex-start;gap: 15rpx;padding: 21rpx 20rpx;border-radius: 17rpx;border: 2rpx solid #E3E8E3;background: #FFFFFF;box-sizing: border-box;overflow: hidden;transition: transform 0.14s ease,border-color 0.14s ease,background 0.14s ease;}
.runner-option-pressed{transform: scale(0.988);background: #F8FAF7;}
.runner-option-item.runner-selected{border-color: #6EA800;background: #FBFFF2;box-shadow: inset 5rpx 0 0 #AEEF00;}
.runner-option-item.runner-correct,.runner-option-item.runner-both{border-color: #2AB66F;background: #EFFAF3;box-shadow: inset 5rpx 0 0 #2AB66F;}
.runner-option-item.runner-user-answer{border-color: #F05A51;background: #FFF2F0;box-shadow: inset 5rpx 0 0 #F05A51;}
.runner-option-indicator{width: 34rpx;height: 34rpx;margin-top: 4rpx;border-radius: 50%;border: 2rpx solid #B7C0B9;display: flex;align-items: center;justify-content: center;flex-shrink: 0;box-sizing: border-box;}
.runner-option-indicator.runner-checked{border-color: #6EA800;background: #AEEF00;}
.runner-option-indicator.runner-indicator-correct{border-color: #2AB66F;background: #2AB66F;}
.runner-option-indicator.runner-indicator-user{border-color: #F05A51;background: #F05A51;}
.runner-check-mark{width: 18rpx;height: 18rpx;color: #10251A;}
.runner-indicator-correct .runner-check-mark,.runner-indicator-user .runner-check-mark{color: #FFFFFF;}
.runner-option-body{flex: 1;min-width: 0;display: flex;align-items: flex-start;gap: 8rpx;}
.runner-option-key{flex-shrink: 0;color: #527D00;font-size: 27rpx;line-height: 1.62;font-weight: 900;}
.runner-option-text{color: #263129;font-size: 27rpx;line-height: 1.62;word-break: break-word;white-space: pre-wrap;}
.runner-option-image{max-width: 100%;max-height: 200rpx;border-radius: 10rpx;border: 2rpx solid rgba(0,0,0,0.06);background: #FFFFFF;display: block;}
.runner-option-item.runner-user-answer .runner-option-key{color: #D94C44;}
.runner-option-item.runner-correct .runner-option-key,.runner-option-item.runner-both .runner-option-key{color: #18894F;}
.runner-blank-group{padding: 20rpx;border-radius: 20rpx;border: 1rpx solid #E1E7E1;background: #F8FAF7;box-sizing: border-box;}
.runner-blank-group-head{margin-bottom: 14rpx;display: flex;align-items: center;justify-content: space-between;gap: 16rpx;}
.runner-blank-group-title{color: #27432F;font-size: 27rpx;font-weight: 850;}
.runner-blank-group-hint{color: #7B867E;font-size: 21rpx;}
.runner-blank-option-item{background: #FFFFFF;}
.runner-blank-option-item:active{background: #F3F7EE;}
.runner-blank-option-item.runner-selected{border-color: #6EA800;background: #F5FBE8;box-shadow: inset 5rpx 0 0 #AEEF00;}
.runner-bottom-bar{flex-shrink: 0;padding: 14rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));border-top: 1rpx solid #E3E8E3;background: rgba(255,255,255,0.97);box-shadow: 0 -12rpx 34rpx rgba(16,37,26,0.055);box-sizing: border-box;}
.runner-bottom-inner{display: flex;align-items: center;justify-content: space-between;gap: 16rpx;}
.runner-nav-btn{min-width: 142rpx;min-height: 64rpx;display: flex;align-items: center;justify-content: center;gap: 6rpx;border-radius: 16rpx;}
.runner-nav-pressed{background: #F2F5F1;}
.runner-nav-btn.runner-disabled{opacity: 0.28;}
.runner-nav-arrow{width: 30rpx;height: 30rpx;color: #1B3022;}
.runner-nav-label{color: #1B3022;font-size: 25rpx;font-weight: 800;}
.runner-nav-status{flex: 1;min-height: 64rpx;border-radius: 16rpx;display: flex;align-items: center;justify-content: center;gap: 9rpx;background: #F3F5F1;}
.runner-nav-status-pressed{background: #E9EEE7;}
.runner-nav-status-value{color: #24342A;font-size: 24rpx;font-weight: 850;font-variant-numeric: tabular-nums;}
.runner-nav-status-label{color: #7B867E;font-size: 21rpx;}
.runner-btn-submit{width: 100%;margin-top: 12rpx;padding: 19rpx 24rpx;border: none;border-radius: 18rpx;background: linear-gradient(100deg,#AEEF00 0%,#C8F72B 100%);color: #10251A;box-shadow: 0 12rpx 26rpx rgba(123,174,0,0.17);display: flex;align-items: center;justify-content: center;gap: 14rpx;line-height: 1.35;box-sizing: border-box;}
.runner-btn-submit::after{border: none;}
.runner-btn-submit-disabled{opacity: 0.48;}
.runner-btn-submit-pressed{transform: scale(0.99);opacity: 0.88;}
.runner-submit-main{font-size: 28rpx;font-weight: 900;}
.runner-submit-meta{font-size: 21rpx;font-weight: 700;opacity: 0.68;}
.runner-sheet-overlay{position: fixed;inset: 0;z-index: 100;display: flex;align-items: flex-end;justify-content: center;background: rgba(4,13,8,0.64);}
.runner-sheet-modal{width: 100%;max-height: 76vh;padding: 16rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));border-radius: 34rpx 34rpx 0 0;background: #FFFFFF;box-shadow: 0 -22rpx 54rpx rgba(0,0,0,0.18);overflow-y: auto;box-sizing: border-box;animation: sheetRise 0.22s ease-out both;}
@keyframes sheetRise{from{transform: translateY(40rpx);opacity: 0;}
to{transform: translateY(0);opacity: 1;}
}
.runner-sheet-handle{width: 72rpx;height: 7rpx;margin: 0 auto 20rpx;border-radius: 999rpx;background: #D8DED8;}
.runner-sheet-head{display: flex;align-items: flex-start;justify-content: space-between;gap: 18rpx;}
.runner-sheet-title{display: block;color: #17251B;font-size: 33rpx;font-weight: 900;}
.runner-sheet-subtitle{display: block;margin-top: 7rpx;color: #7A857D;font-size: 23rpx;}
.runner-sheet-close{width: 54rpx;height: 54rpx;border-radius: 50%;background: #F2F4F1;color: #24342A;font-size: 36rpx;line-height: 50rpx;text-align: center;flex-shrink: 0;}
.runner-sheet-close-pressed{transform: scale(0.94);}
.runner-sheet-legend{margin-top: 24rpx;padding: 15rpx 16rpx;border-radius: 15rpx;background: #F5F7F3;display: flex;align-items: center;flex-wrap: wrap;gap: 16rpx 22rpx;}
.runner-legend-item{display: flex;align-items: center;gap: 7rpx;color: #667169;font-size: 20rpx;}
.runner-legend-dot{width: 18rpx;height: 18rpx;border-radius: 5rpx;box-sizing: border-box;}
.runner-legend-dot.current{border: 3rpx solid #6EA800;background: #FFFFFF;}
.runner-legend-dot.answered{background: #153323;}
.runner-legend-dot.correct{background: #2AB66F;}
.runner-legend-dot.wrong{background: #F05A51;}
.runner-legend-dot.empty{border: 2rpx solid #D3D9D3;background: #FFFFFF;}
.runner-sheet-grid{margin-top: 24rpx;display: grid;grid-template-columns: repeat(5,1fr);gap: 14rpx;}
.runner-sheet-cell{aspect-ratio: 1;border-radius: 14rpx;border: 2rpx solid #E0E6E0;background: #FFFFFF;color: #59655D;display: flex;align-items: center;justify-content: center;font-size: 25rpx;font-weight: 800;font-variant-numeric: tabular-nums;box-sizing: border-box;}
.runner-sheet-cell-pressed{transform: scale(0.96);}
.runner-sheet-cell.runner-done{border-color: #153323;background: #153323;color: #FFFFFF;}
.runner-sheet-cell.runner-correct-cell{border-color: #2AB66F;background: #2AB66F;color: #FFFFFF;}
.runner-sheet-cell.runner-wrong-cell{border-color: #F05A51;background: #F05A51;color: #FFFFFF;}
.runner-sheet-cell.runner-current{border: 4rpx solid #AEEF00;box-shadow: 0 0 0 3rpx rgba(174,239,0,0.18);}
.runner-sheet-submit{margin-top: 26rpx;}
.quiz-runner.runner-compact{min-height: 0;height: auto;overflow: visible;display: block;background: transparent;}
.runner-compact .runner-question-area{min-height: 0;height: auto;overflow: visible;padding: 10rpx 24rpx 0;background: transparent;}
.runner-compact .runner-q-wrap{margin-top: 0;padding: 24rpx;border: 1rpx solid #E1E6E1;border-radius: 24rpx;box-shadow: 0 10rpx 28rpx rgba(16,37,26,0.055);}
.runner-compact .runner-bottom-bar{position: static;margin: 8rpx 24rpx 0;padding: 5rpx 0 8rpx;border-top: none;background: transparent;box-shadow: none;}
.runner-compact .runner-nav-status{background: #FFFFFF;border: 1rpx solid #E1E6E1;}
.runner-compact .runner-btn-submit{display: none;}
.quiz-runner.runner-flow{display: block;min-height: 0;height: auto;overflow: visible;background: transparent;}
.runner-flow .runner-question-area{min-height: 0;height: auto;overflow: visible;}
.runner-flow .runner-q-wrap{min-height: 200rpx;}
.runner-flow.runner-bottom-compact .runner-question-area{padding-bottom: calc(142rpx + env(safe-area-inset-bottom));}
.runner-flow.runner-bottom-compact .runner-bottom-bar{position: fixed;left: 0;right: 0;bottom: 0;width: 100%;margin-top: 0;padding-bottom: calc(16rpx + env(safe-area-inset-bottom));box-sizing: border-box;background: #FBFBF7;border-top: 1rpx solid #DDE2DA;box-shadow: 0 -8rpx 24rpx rgba(16,37,26,.045);}
@media (prefers-reduced-motion: reduce){.runner-q-wrap,.runner-q-wrap.slide-in,.runner-q-wrap.slide-out-left,.runner-q-wrap.slide-out-right,.runner-segment,.runner-option-item,.runner-sheet-modal,.runner-sheet-cell,.runner-btn-submit{animation: none !important;transition: none !important;transform: none !important;}
}
.runner-compact-counter{margin-left: auto;color: #59655D;font-size: 22rpx;font-weight: 800;font-variant-numeric: tabular-nums;flex-shrink: 0;}
.runner-hero{padding: 14rpx 24rpx 20rpx;transition: padding 0.2s ease,min-height 0.2s ease;}
.runner-hero-nav{min-height: 56rpx;}
.runner-back-btn{width: 52rpx;height: 52rpx;}
.runner-back-symbol{font-size: 43rpx;}
.runner-sheet-trigger{min-width: 104rpx;height: 52rpx;padding: 0 15rpx;border-radius: 16rpx;}
.runner-sheet-trigger-text{font-size: 21rpx;}
.runner-eyebrow{font-size: 19rpx;letter-spacing: 3rpx;}
.runner-hero-meta{margin-top: 13rpx;}
.runner-subject{font-size: 32rpx;}
.runner-timer{font-size: 22rpx;}
.runner-number-row{margin-top: 11rpx;}
.runner-number-current{font-size: 60rpx;letter-spacing: -2rpx;}
.runner-number-divider{margin: 0 8rpx 0 9rpx;font-size: 32rpx;}
.runner-number-total{font-size: 28rpx;}
.runner-segment-progress{margin-top: 14rpx;gap: 5rpx;}
.runner-segment{height: 6rpx;}
.runner-collapsed-copy{display: none;min-width: 0;flex-direction: column;justify-content: center;}
.runner-collapsed-subject{max-width: 270rpx;overflow: hidden;text-overflow: ellipsis;white-space: nowrap;color: #FFFFFF;font-size: 25rpx;line-height: 1.25;font-weight: 850;}
.runner-collapsed-meta{margin-top: 2rpx;color: rgba(255,255,255,0.58);font-size: 18rpx;font-weight: 700;font-variant-numeric: tabular-nums;}
.runner-expand-btn{width: 52rpx;height: 52rpx;border-radius: 50%;border: 1rpx solid rgba(215,255,104,0.24);background: rgba(255,255,255,0.065);display: flex;align-items: center;justify-content: center;flex-shrink: 0;}
.runner-expand-icon{width: 26rpx;height: 26rpx;color: #AEEF00;transform: translateY(-2rpx);}
.runner-hero.runner-hero-collapsed{padding-top: 10rpx;padding-bottom: 11rpx;}
.runner-hero-collapsed .runner-eyebrow,.runner-hero-collapsed .runner-hero-meta,.runner-hero-collapsed .runner-number-row{display: none;}
.runner-hero-collapsed .runner-collapsed-copy{display: flex;}
.runner-hero-collapsed .runner-sheet-trigger{width: 52rpx;min-width: 52rpx;padding: 0;border-radius: 50%;}
.runner-hero-collapsed .runner-sheet-trigger-text{display: none;}
.runner-hero-collapsed .runner-segment-progress{margin-top: 8rpx;}
.runner-hero-collapsed .runner-hero-glow{opacity: 0.35;}
.runner-hero-collapsed .runner-hero-grid{opacity: 0.035;}
.runner-question-area{height: 0;}
.runner-flow .runner-question-area,.runner-compact .runner-question-area{height: auto;}
.runner-bottom-bar{padding: 12rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));}
.runner-bottom-inner{gap: 10rpx;}
.runner-nav-btn{min-width: 116rpx;min-height: 68rpx;border-radius: 17rpx;}
.runner-nav-status{min-height: 68rpx;border-radius: 17rpx;gap: 7rpx;}
.runner-nav-label{font-size: 24rpx;}
.runner-nav-status-value{font-size: 23rpx;}
.runner-nav-status-label{font-size: 19rpx;}
.runner-final-submit{flex: 1.25;min-width: 218rpx;padding: 0 10rpx 0 22rpx;background: linear-gradient(100deg,#AEEF00 0%,#C8F72B 100%);box-shadow: 0 10rpx 24rpx rgba(123,174,0,0.18);justify-content: space-between;}
.runner-final-submit-pressed{transform: scale(0.985);opacity: 0.88;}
.runner-final-submit-label{color: #10251A;font-size: 24rpx;font-weight: 900;white-space: nowrap;}
.runner-final-submit-arrow{width: 42rpx;height: 42rpx;border-radius: 50%;display: flex;align-items: center;justify-content: center;background: #10251A;color: #FFFFFF;font-family: Arial,sans-serif;font-size: 31rpx;line-height: 1;flex-shrink: 0;}
.runner-final-submit-arrow-text{transform: translateY(-2rpx);}
@media (max-width: 360px){.runner-custom-navigation .runner-hero-nav{padding-right: 170rpx;}
.runner-collapsed-subject{max-width: 210rpx;}
.runner-final-submit{min-width: 190rpx;padding-left: 16rpx;}
.runner-final-submit-label{font-size: 22rpx;}
.runner-nav-btn{min-width: 102rpx;}
}
.runner-theme-premium-review{background: #F4F5F1;color: #17251B;}
.runner-theme-premium-review .runner-hero{background: radial-gradient(circle at 88% 10%,rgba(183,232,42,.11) 0,rgba(183,232,42,0) 34%),linear-gradient(145deg,#183528 0%,#10251A 60%,#09170F 100%);padding-left: 26rpx;padding-right: 26rpx;}
.runner-theme-premium-review .runner-hero-grid{opacity: .035;}
.runner-theme-premium-review .runner-hero-glow{border-color: rgba(183,232,42,.10);box-shadow: 0 0 0 42rpx rgba(183,232,42,.018),0 0 0 88rpx rgba(183,232,42,.012);}
.runner-theme-premium-review .runner-eyebrow,.runner-theme-premium-review .runner-number-divider{color: #B7E82A;}
