/* reference-plan.png: shared mint study layout for full practice and review.
   Compact review, wrong-detail and exam preserve their existing layouts. */ .runner-reference:not(.runner-compact){background:#F3FCF9;color:#23483C;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif}
.runner-reference .runner-reference-hero{padding:0 32rpx 24rpx;background:transparent;color:#23483C;box-shadow:none}
.runner-reference .runner-reference-wave{position:absolute;top:-180rpx;left:-80rpx;width:690rpx;height:400rpx;border-radius:0 0 72% 36%;background:linear-gradient(130deg,#EAF9F4 16%,#D8F5E9 70%,#EAF9F4 100%);transform:rotate(-15deg);pointer-events:none}
.runner-reference .runner-hero-nav{min-height:64rpx;padding-top:0}
.runner-reference.runner-custom-navigation .runner-hero-nav{padding-right:184rpx}
.runner-reference .runner-hero-left{min-width:0;gap:12rpx}
.runner-reference .runner-back-btn{width:64rpx;height:64rpx;margin-left:-16rpx;border:0;border-radius:50%;background:transparent}
.runner-reference .runner-back-symbol.line-icon{width:32rpx;height:32rpx;color:#3A6F5B;font-size:0;transform:none}
.runner-reference .runner-sheet-trigger{width:64rpx;min-width:64rpx;height:64rpx;padding:0;border:0;border-radius:50%;background:rgba(255,255,255,.75)}
.runner-reference .runner-sheet-trigger-icon{display:block;width:36rpx;height:36rpx}
.runner-reference .runner-hero-meta{margin-top:10rpx;gap:16rpx}
.runner-reference .runner-subject{max-width:100%;color:#23483C;font-size:40rpx;line-height:1.4;letter-spacing:0;font-weight:700}
.runner-reference .runner-number-row{margin-top:8rpx;align-items:center;gap:20rpx}
.runner-reference .runner-number-actions{display:flex;align-items:center;gap:24rpx;flex-shrink:0}
.runner-reference .runner-number-wrap{min-width:0}
.runner-reference .runner-number-current{color:#37B78F;font-size:80rpx;line-height:1.1;font-weight:700;letter-spacing:-2rpx}
.runner-reference .runner-number-divider{margin:0 6rpx 0 12rpx;color:#77988D;font-size:32rpx;font-weight:400}
.runner-reference .runner-number-total{color:#77988D;font-size:28rpx;font-weight:400}
.runner-reference .runner-timer-pill{display:flex;align-items:center;flex-shrink:0;gap:8rpx;padding:10rpx 16rpx;border-radius:999rpx;background:#FFFFFF;box-shadow:0 6rpx 18rpx rgba(58,111,91,.06)}
.runner-reference .runner-timer-icon{color:#25A980}
.runner-reference .runner-timer{color:#3A6F5B;font-size:24rpx;font-weight:500;letter-spacing:0}
.runner-reference .runner-segment-progress{margin-top:20rpx;gap:4rpx}
.runner-reference .runner-segment{min-width:0;height:8rpx;border-radius:999rpx;background:#D4EEE5;box-shadow:none;transform:none}
.runner-reference .runner-segment.past,.runner-reference .runner-segment.answered{background:#A0E1CD}
.runner-reference .runner-segment.correct{background:#3A9C74}
.runner-reference .runner-segment.wrong{background:#C47767}
.runner-reference .runner-segment.current{background:linear-gradient(90deg,#20BC8D,#7ED8B5);box-shadow:none;transform:none}
.runner-reference .runner-question-area{padding:16rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));background:transparent}
.runner-reference .runner-q-wrap{min-height:0;margin:0;padding:28rpx 28rpx 40rpx;border:0;border-radius:32rpx;background:#FFFFFF;box-shadow:0 12rpx 32rpx rgba(58,111,91,.065)}
.runner-reference .runner-q-card-head{gap:12rpx;margin-bottom:20rpx}
.runner-reference .runner-q-badge{padding:6rpx 14rpx;border-radius:12rpx;background:#CCF4E6;color:#257559;font-size:24rpx;line-height:1.5;font-weight:500}
.runner-reference .runner-q-badge-smart{background:#EAF9F4;color:#507568}
.runner-reference .runner-master-btn{border-color:#CBEDE0;background:#EAF9F4}
.runner-reference .runner-master-icon,.runner-reference .runner-master-text{color:#3A6F5B}
.runner-reference .runner-stem{margin-bottom:28rpx}
.runner-reference .runner-q-content,.runner-reference .runner-mixed-text-block,.runner-reference .runner-mixed-latex-block,.runner-reference .runner-fallback-text{color:#23483C;font-size:32rpx;line-height:1.6;font-weight:400}
.runner-reference .runner-q-content{margin-bottom:0}
.runner-reference .runner-recommend-bar{background:#EAF9F4;border-color:#CBEDE0;box-shadow:none}
.runner-reference .runner-recommend-divider{background:#7ED8B5}
.runner-reference .runner-recommend-label{color:#3A6F5B}
.runner-reference .runner-recommend-text{color:#507568}
.runner-reference .runner-options,.runner-reference .runner-blank-group-options{gap:16rpx}
.runner-reference .runner-option-item{min-height:88rpx;padding:20rpx 24rpx;gap:16rpx;border:1rpx solid #D9F1E9;border-radius:24rpx;background:#FFFFFF;box-shadow:0 4rpx 12rpx rgba(58,111,91,.025)}
.runner-reference .runner-option-pressed{background:#EAF9F4;transform:none}
.runner-reference .runner-option-indicator{width:32rpx;height:32rpx;margin-top:6rpx;border:2rpx solid #75C8AE;background:#FFFFFF}
.runner-reference .runner-option-item.runner-selected{border-color:#B7EBD9;background:#EAF9F4;box-shadow:none}
.runner-reference .runner-option-item.runner-correct,.runner-reference .runner-option-item.runner-both{border-color:#79BF9F;background:#EDF8F2;box-shadow:none}
.runner-reference .runner-option-item.runner-user-answer{border-color:#D4A096;background:#FFF1ED;box-shadow:none}
.runner-reference .runner-option-indicator.runner-checked{border-color:#36AE88;background:#FFFFFF}
.runner-reference .runner-check-mark{color:#2B9975}
.runner-reference .runner-option-indicator.runner-indicator-correct{border-color:#3A9C74;background:#3A9C74}
.runner-reference .runner-option-indicator.runner-indicator-user{border-color:#BD715F;background:#BD715F}
.runner-reference .runner-indicator-correct .runner-check-mark,.runner-reference .runner-indicator-user .runner-check-mark{color:#FFFFFF}
.runner-reference .runner-option-key{color:#3A6F5B;font-size:28rpx;font-weight:400}
.runner-reference .runner-option-text{color:#23483C;font-size:28rpx;line-height:1.6}
.runner-reference .runner-blank-group{border-color:#D9F1E9;background:#F3FCF9}
.runner-reference .runner-blank-group-title{color:#3A6F5B}
.runner-reference .runner-blank-group-hint{color:#507568}
.runner-reference .runner-bottom-inner{gap:28rpx}
.runner-reference .runner-bottom-inner > .runner-nav-btn{flex:1;min-width:0;min-height:88rpx;padding:0 20rpx;border:0;border-radius:999rpx;gap:10rpx;background:#EAF9F4;box-shadow:none;justify-content:center}
.runner-reference .runner-nav-label{font-size:28rpx;font-weight:500;color:#3A6F5B}
.runner-reference .runner-final-submit-label{font-size:28rpx;font-weight:500}
.runner-reference .runner-nav-arrow{width:24rpx;height:24rpx;color:#39A88A}
/* Match/exceed the specificity of the legacy lime primary-button selector. */ .runner-reference .runner-bottom-inner > .runner-next,.runner-reference .runner-bottom-inner > .runner-final-submit{background:linear-gradient(110deg,#32AF8B 0%,#3A6F5B 100%);color:#FFFFFF;box-shadow:0 8rpx 20rpx rgba(58,111,91,.08)}
.runner-reference .runner-next .runner-nav-label,.runner-reference .runner-next .runner-nav-arrow,.runner-reference .runner-final-submit-label{color:#FFFFFF}
.runner-reference .runner-final-submit-arrow{width:24rpx;height:24rpx;border-radius:0;background:transparent;color:#FFFFFF}
.runner-reference .runner-final-submit-arrow-text.line-icon{width:24rpx;height:24rpx;font-size:0;color:#FFFFFF;transform:none}
.runner-reference .runner-nav-btn.runner-disabled{opacity:.55;box-shadow:none}
.runner-reference .runner-sheet-overlay{background:rgba(35,72,60,.4)}
.runner-reference .runner-sheet-modal{background:#FFFFFF}
.runner-reference .runner-sheet-title{color:#23483C}
.runner-reference .runner-sheet-subtitle,.runner-reference .runner-legend-item{color:#507568}
.runner-reference .runner-sheet-close,.runner-reference .runner-sheet-legend{background:#EAF9F4;color:#3A6F5B}
.runner-reference .runner-sheet-handle{background:#B5DACE}
.runner-reference .runner-sheet-cell{border-color:#D9F1E9;background:#FFFFFF;color:#3A6F5B}
.runner-reference .runner-legend-dot.marked{background:#B79962}
.runner-reference .runner-sheet-cell.runner-done{background:#EAF9F4;border-color:#B7EBD9;color:#3A6F5B}
.runner-reference .runner-sheet-cell.runner-correct-cell{background:#3A9C74;color:#FFFFFF}
.runner-reference .runner-sheet-cell.runner-wrong-cell{background:#BD715F;color:#FFFFFF}
.runner-reference .runner-sheet-cell.runner-marked-cell{border-style:dashed;border-color:#B79962;box-shadow:none}
.runner-reference .runner-sheet-cell.runner-current{border-color:#37B78F;box-shadow:none}
.runner-reference .runner-legend-dot.current{border-color:#37B78F}
.runner-reference .runner-legend-dot.answered{background:#7ED8B5}
.runner-reference .runner-legend-dot.correct{background:#3A9C74}
.runner-reference .runner-legend-dot.wrong{background:#BD715F}
.runner-reference.runner-theme-default .runner-btn-submit,.runner-reference.runner-theme-premium-review .runner-btn-submit{background:#3A6F5B;color:#FFFFFF;border-radius:999rpx;box-shadow:none}
.runner-reference .runner-state-card{background:#FFFFFF;border-radius:32rpx}
.runner-reference .runner-state-text{color:#507568}
.runner-reference .runner-state-btn{color:#FFFFFF;background:#3A6F5B;border-radius:999rpx}
.runner-reference .runner-loading-ring{border-color:#D9F1E9;border-top-color:#37B78F}
/* Optical centring must follow the actual icon dimensions, not the 30rpx token offsets. */ .runner-reference .icon-chevron-right::before{left:50%;top:50%;width:12rpx;height:12rpx;transform:translate(-65%,-50%) rotate(-45deg)}
.runner-reference .icon-chevron-left::before{left:50%;top:50%;width:12rpx;height:12rpx;transform:translate(-35%,-50%) rotate(45deg)}
.runner-reference .icon-chevron-down::before{left:50%;top:50%;width:12rpx;height:12rpx;transform:translate(-50%,-65%) rotate(-45deg)}
@media (prefers-reduced-motion:reduce){.runner-reference .runner-hero,.runner-reference .runner-q-wrap,.runner-reference .runner-option-item,.runner-reference .runner-nav-btn{transition:none;animation:none}
}
/* Stable viewport: the action bar is a page-level control, never part of the
   question's scroll content. Reserve its footprint inside the viewport so the
   last lines remain reachable above the fixed bar. */ .runner-reference:not(.runner-compact) .runner-bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:40;width:100%;box-sizing:border-box;margin:0;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(243,252,249,.97);border-top:1rpx solid #D8EEE6;box-shadow:0 -10rpx 28rpx rgba(43,117,91,.08)}
/* Opaque card, directional content motion; never hide the incoming stem. */
.runner-reference:not(.runner-compact) .runner-q-wrap{transition:none;animation:none;opacity:1;transform:none}
.runner-reference:not(.runner-compact) .runner-question-motion{opacity:1;transform:translateX(0);transition:opacity 100ms ease-out,transform 100ms cubic-bezier(.4,0,.7,1)}
.runner-reference:not(.runner-compact) .question-fade-out .runner-question-motion{opacity:.88;pointer-events:none;will-change:transform,opacity}
.runner-reference:not(.runner-compact) .question-dir-left.question-fade-out .runner-question-motion{transform:translateX(-12rpx)}
.runner-reference:not(.runner-compact) .question-dir-right.question-fade-out .runner-question-motion{transform:translateX(12rpx)}
.runner-reference:not(.runner-compact) .slide-in-left .runner-question-motion{transition:none;animation:runnerQuestionInLeft 220ms cubic-bezier(.16,1,.3,1) both;pointer-events:none;will-change:transform,opacity}
.runner-reference:not(.runner-compact) .slide-in-right .runner-question-motion{transition:none;animation:runnerQuestionInRight 220ms cubic-bezier(.16,1,.3,1) both;pointer-events:none;will-change:transform,opacity}
@keyframes runnerQuestionInLeft{from{opacity:.88;transform:translateX(36rpx)}to{opacity:1;transform:translateX(0)}}
@keyframes runnerQuestionInRight{from{opacity:.88;transform:translateX(-36rpx)}to{opacity:1;transform:translateX(0)}}
@media (prefers-reduced-motion:reduce){.runner-reference:not(.runner-compact) .runner-question-motion,.runner-reference:not(.runner-compact) .question-fade-out .runner-question-motion,.runner-reference:not(.runner-compact) .slide-in-left .runner-question-motion,.runner-reference:not(.runner-compact) .slide-in-right .runner-question-motion{animation:none;transition:none;transform:none;opacity:1}}
.runner-reference:not(.runner-compact) .runner-bottom-inner{max-width:686rpx;margin:0 auto}
.runner-reference .runner-timer-icon{display:block;width:30rpx;height:30rpx;flex:0 0 30rpx}
.runner-reference.runner-no-navigation .runner-question-area{padding-bottom:32rpx}
.runner-reference .runner-nav-btn{transition:opacity .12s ease}
.runner-reference .runner-nav-pressed,.runner-reference .runner-final-submit-pressed{transform:none;opacity:.84}
.runner-reference .runner-mark-btn{color:#3A6F5B;border-color:#B7EBD9;background:#EAF9F4}
.runner-reference .runner-mark-btn.runner-marked{color:#23483C;border-color:#8DCBB7;background:#B7EBD9}
/* Code retains a readable dark surface; line numbers use mint, not neon lime. */ .runner-reference .runner-code-wrapper{background:#23483C;border-color:#3A6F5B}
.runner-reference .runner-code-no{color:#B7EBD9;opacity:1}
.runner-reference .runner-code-text{color:#F3FCF9}
