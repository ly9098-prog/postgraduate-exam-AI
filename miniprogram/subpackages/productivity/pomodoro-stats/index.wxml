<view class="page theme-{{themeMode}}">
  <view class="theme-backdrop"></view>
  <view class="page-inner animation-entrance {{pageEntered ? 'entered' : ''}}">

    <block wx:if="{{loading}}">
      <view class="loading-wrap">
        <loading-lottie text="加载中..." size="large" theme="{{themeMode}}" />
      </view>
    </block>

    <block wx:elif="{{errorText}}">
      <view class="error-state">
        <view class="error-icon-wrap">
          <text class="line-icon icon-exclamation" style="width:48rpx;height:48rpx;color:#EF4444;"></text>
        </view>
        <text class="error-title">{{errorText}}</text>
        <view class="error-actions">
          <button class="gradient-btn" hover-class="gradient-btn-pressed" hover-start-time="20" hover-stay-time="80" bindtap="loadData">重新加载</button>
        </view>
      </view>
    </block>

    <block wx:elif="{{!loading}}">
      <view class="stats-content">
        <!-- ===== OVERVIEW ===== -->
        <view class="overview-section">
          <view class="overview-main-card">
            <view class="overview-main-head">
              <view class="overview-main-copy">
                <text class="overview-kicker">DAILY FOCUS</text>
                <text class="overview-main-label">{{selectedDurationLabel}}</text>
              </view>
              <view class="overview-session-chip">
                <view class="overview-session-dot"></view>
                <text class="overview-session-number">{{_dispTodaySessions}}</text>
                <text class="overview-session-unit">次专注</text>
              </view>
            </view>
            <view class="overview-duration-row">
              <text class="overview-duration duration-value {{durationValueAnimating ? 'duration-value-updating' : ''}}">{{_dispTodayDurationText}}</text>
              <text class="overview-duration-note">专注时长</text>
            </view>
            <view class="overview-accent-line"><view class="overview-accent-glow"></view></view>
          </view>

          <view class="overview-secondary-row">
            <view class="overview-secondary-card">
              <view class="overview-secondary-head">
                <view class="overview-mini-mark overview-mini-mark-count"></view>
                <text class="overview-secondary-kicker">WEEKLY SESSIONS</text>
              </view>
              <text class="overview-secondary-value">{{_dispWeekSessions}}</text>
              <text class="overview-secondary-label">本周专注次数</text>
            </view>
            <view class="overview-secondary-card overview-secondary-card-duration">
              <view class="overview-secondary-head">
                <view class="overview-mini-mark overview-mini-mark-time"></view>
                <text class="overview-secondary-kicker">WEEKLY DURATION</text>
              </view>
              <text class="overview-secondary-value overview-secondary-value-green">{{_dispWeekDurationText}}</text>
              <text class="overview-secondary-label">本周专注时长</text>
            </view>
          </view>
        </view>

        <!-- ===== TREND CHART ===== -->
        <view class="card-section">
          <text class="section-title">最近 7 天趋势</text>
          <view class="chart-wrap">
            <canvas class="trend-canvas" type="2d" id="trend-bars-canvas" hidden="{{!!selectedSubjectDetail}}"></canvas>
          </view>
          <view class="chart-legend">
            <view class="legend-item"><view class="legend-dot legend-dot-record"></view><text class="legend-text">有记录</text></view>
            <view class="legend-item"><view class="legend-dot legend-dot-empty"></view><text class="legend-text">无记录</text></view>
          </view>
        </view>

        <!-- ===== SUBJECTS DISTRIBUTION ===== -->
        <view class="card-section pie-card-section">
          <view class="section-header pie-section-header">
            <view class="pie-title-wrap">
              <text class="section-title">{{pieDateLabel}}科目分布</text>
              <text class="pie-section-subtitle">各科目专注时长占比</text>
            </view>
            <view class="header-actions">
              <view
                class="today-btn"
                wx:if="{{selectedDate !== _todayDate}}"
                hover-class="today-btn-pressed"
                hover-start-time="20"
                hover-stay-time="80"
                catchtap="goToToday"
              >
                <text class="today-btn-text">今天</text>
              </view>
              <picker mode="date" value="{{selectedDate}}" end="{{_todayDate}}" bindchange="onDateChange">
                <view class="date-picker-btn pie-date-picker-btn">
                  <text class="date-picker-text">{{selectedDate}}</text>
                  <text class="date-picker-arrow">▾</text>
                </view>
              </picker>
            </view>
          </view>
          <!-- Pie Chart -->
          <view class="pie-wrap {{pieTapped ? 'pie-tapped' : ''}}" id="pie-chart-wrap">
            <canvas class="pie-canvas" type="2d" id="pie-canvas" catchtap="onPieTap" hidden="{{!!selectedSubjectDetail}}"></canvas>
            <view class="pie-loading-mask" wx:if="{{pieLoading}}">
              <view class="pie-loading-ring"></view>
              <text>正在切换日期</text>
            </view>
          </view>
          <view class="subject-legend" aria-label="学科图例" wx:if="{{subjects.length > 0}}">
            <view class="subject-legend-item" wx:for="{{subjects}}" wx:key="subject">
              <view class="subject-legend-dot" style="background: {{item._color}};"></view>
              <text class="subject-legend-name">{{item._label}}</text>
              <text class="subject-legend-percent">{{item._pctText}}</text>
            </view>
          </view>
        </view>

        <!-- ===== HISTORY ===== -->
        <view class="card-section">
          <view class="section-header">
            <text class="section-title">最近记录</text>
          </view>
          <view wx:if="{{history.length === 0}}" class="empty-hint">
            <view class="empty-icon"></view>
            <text class="empty-text" wx:if="{{selectedDate === _todayDate}}">今天还没有学习记录<br/>开始一个番茄钟吧</text>
            <text class="empty-text" wx:else>{{selectedDate}} 暂无学习记录</text>
          </view>
          <view class="history-list" wx:if="{{history.length > 0}}">
            <view class="history-item" wx:for="{{history}}" wx:key="id"
                  style="--idx: {{index}};">
              <view class="hist-accent" style="background: {{item._color}};"></view>
              <view class="hist-left">
                <text class="hist-subject">{{item._subjectLabel}}</text>
                <text class="hist-meta">{{item._date}} {{item._time}} · {{item._duration}}</text>
              </view>
              <view class="hist-right">
                <view class="hist-status-dot {{item._statusClass}}"></view>
                <text class="hist-status {{item._statusClass}}">{{item._statusLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- bottom spacer -->
        <view class="bottom-spacer"></view>
      </view>
    </block>

  </view>

  <!-- ===== DETAIL POPUP ===== -->
  <view class="detail-overlay {{selectedSubjectDetail ? 'visible' : ''}}" catchtap="closeDetail"
        catchtouchmove="noop">
    <view class="detail-card" catchtap="noop" wx:if="{{selectedSubjectDetail}}">
      <view class="detail-header">
        <view class="detail-dot" style="background: {{selectedSubjectDetail._color}};"></view>
        <text class="detail-subject">{{selectedSubjectDetail._label}}</text>
      </view>
      <view class="detail-body">
        <view class="detail-item">
          <text class="detail-label">学习时长</text>
          <text class="detail-value">{{selectedSubjectDetail._durationText}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">{{pieDateLabel}}占比</text>
          <text class="detail-value">{{selectedSubjectDetail._pctText}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">完成次数</text>
          <text class="detail-value">{{selectedSubjectDetail.sessions || 0}} 次</text>
        </view>
      </view>
      <view class="detail-close-wrap" catchtap="closeDetail">
        <text class="detail-close-text">点击关闭</text>
      </view>
    </view>
  </view>

</view>
