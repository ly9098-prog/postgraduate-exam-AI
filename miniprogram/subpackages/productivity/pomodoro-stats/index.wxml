<view class="page theme-{{themeMode}}">
  <image class="theme-backdrop" src="{{themeMode === 'light' ? './assets/stats-bg-light.jpg' : './assets/stats-bg-dark.jpg'}}" mode="aspectFill" aria-hidden="true"></image>
  <view class="page-inner">

    <view class="initial-state-layer" wx:if="{{loading && !contentReady}}" catchtouchmove="noop">
      <view class="loading-wrap">
        <view class="initial-loading-ring"></view>
        <text class="initial-loading-text">加载中...</text>
      </view>
    </view>

    <view class="initial-state-layer" wx:elif="{{errorText}}" catchtouchmove="noop">
      <view class="error-state">
        <view class="error-icon-wrap">
          <text class="line-icon icon-exclamation" style="width:48rpx;height:48rpx;color:#EF4444;"></text>
        </view>
        <text class="error-title">{{errorText}}</text>
        <view class="error-actions">
          <button class="gradient-btn" hover-class="gradient-btn-pressed" hover-start-time="20" hover-stay-time="80" bindtap="loadData">重新加载</button>
        </view>
      </view>
    </view>

    <view class="stats-content {{contentReady ? 'stats-content-ready' : 'stats-content-pending'}}">
        <!-- ===== 累计专注 ===== -->
        <view class="card-section cumulative-focus-card">
          <view class="focus-card-head">
            <view class="focus-card-title-line">
              <text class="focus-card-title">累计专注</text>
              <picker mode="date" value="{{cumulativeStartDate}}" start="{{cumulativePickerStartDate}}" end="{{_todayDate}}" bindchange="onCumulativeStartChange">
                <view class="cumulative-start-picker" hover-class="soft-control-pressed" hover-start-time="20" hover-stay-time="80" aria-label="选择累计专注起始日期">
                  <text>自 {{cumulativeStartDate || _todayDate}} 起</text>
                  <view class="micro-chevron" aria-hidden="true"></view>
                </view>
              </picker>
            </view>
            <picker mode="time" value="{{dayStartTime}}" bindchange="onDayStartChange">
              <view class="study-day-chip" hover-class="soft-control-pressed" hover-start-time="20" hover-stay-time="80" aria-label="调整统计日开始时间">
                <text>统计日 {{dayStartTime}}</text>
                <view class="micro-chevron" aria-hidden="true"></view>
              </view>
            </picker>
          </view>

          <view class="cumulative-metrics {{cumulativeLoading ? 'cumulative-metrics-loading' : ''}}">
            <view class="cumulative-metric">
              <text class="metric-label">次数</text>
              <view class="metric-value-row"><text class="metric-value">{{cumulativeSessions}}</text><text class="metric-unit">次</text></view>
            </view>
            <view class="metric-divider"></view>
            <view class="cumulative-metric cumulative-metric-wide">
              <text class="metric-label">时长</text>
              <text class="metric-value metric-value-text">{{cumulativeDurationText}}</text>
            </view>
            <view class="metric-divider"></view>
            <view class="cumulative-metric cumulative-metric-wide">
              <text class="metric-label">日均时长</text>
              <text class="metric-value metric-value-text">{{cumulativeAverageText}}</text>
            </view>
          </view>
          <view class="cumulative-foot">
            <text>{{studyDayRangeText}}</text><text class="cumulative-foot-sep">·</text><text>{{cumulativeActiveDays}} 个活跃日</text>
          </view>
        </view>

        <!-- ===== 当日专注 ===== -->
        <view class="card-section daily-focus-card">
          <view class="focus-card-head daily-focus-head">
            <view class="focus-card-title-line daily-title-line">
              <text class="focus-card-title">当日专注</text>
              <picker mode="date" value="{{selectedDate}}" start="{{datePickerMinDate}}" end="{{_todayDate}}" bindchange="onDateChange">
                <view class="daily-date-picker" hover-class="soft-control-pressed" hover-start-time="20" hover-stay-time="80" aria-label="选择统计日期">
                  <text>{{selectedDate}}</text>
                </view>
              </picker>
            </view>
            <view class="daily-date-nav" aria-label="切换统计日期">
              <view class="daily-date-nav-btn" hover-class="daily-date-nav-pressed" hover-start-time="20" hover-stay-time="80" catchtap="goPrevDay" aria-role="button" aria-label="前一天"><view class="daily-nav-chevron daily-nav-chevron-prev" aria-hidden="true"></view></view>
              <view class="daily-date-nav-btn {{canGoNextDate ? '' : 'daily-date-nav-disabled'}}" hover-class="{{canGoNextDate ? 'daily-date-nav-pressed' : ''}}" hover-start-time="20" hover-stay-time="80" catchtap="goNextDay" aria-role="button" aria-label="后一天" aria-disabled="{{!canGoNextDate}}"><view class="daily-nav-chevron daily-nav-chevron-next" aria-hidden="true"></view></view>
            </view>
          </view>
          <view class="daily-focus-metrics">
            <view class="daily-count-metric">
              <text class="daily-metric-label">次数</text>
              <text class="daily-count-value {{durationValueAnimating ? 'daily-number-updating' : ''}}">{{_dispTodaySessions}}</text>
            </view>
            <view class="daily-duration-metric">
              <text class="daily-metric-label daily-duration-label">学习时长</text>
              <view class="daily-duration-value-row duration-value {{durationValueAnimating ? 'daily-number-updating duration-value-updating' : ''}}">
                <block wx:for="{{_dispTodayDurationSegments}}" wx:key="index">
                  <text class="{{item.type === 'num' ? 'daily-duration-segment-num' : 'daily-duration-segment-unit'}}">{{item.text}}</text>
                </block>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== 专注时长分布：默认扇形图，柱状图按需挂载 ===== -->
        <view class="card-section pie-card-section distribution-card">
          <view class="section-header distribution-section-header">
            <text class="section-title distribution-title">专注时长分布</text>
            <view class="chart-switch-btn" hover-class="chart-switch-pressed" hover-start-time="20" hover-stay-time="80" catchtap="toggleChartMode" aria-role="button" aria-label="{{chartMode === 'pie' ? '切换到柱状图' : '切换到扇形图'}}">
              <view class="chart-switch-icon-shell" aria-hidden="true">
                <view class="chart-switch-icon chart-switch-icon-bars" wx:if="{{chartMode === 'pie'}}">
                  <view class="chart-switch-icon-bar chart-switch-icon-bar-a"></view>
                  <view class="chart-switch-icon-bar chart-switch-icon-bar-b"></view>
                  <view class="chart-switch-icon-bar chart-switch-icon-bar-c"></view>
                </view>
                <view class="chart-switch-icon chart-switch-icon-pie" wx:else>
                  <view class="chart-switch-icon-pie-ring"></view>
                  <view class="chart-switch-icon-pie-slice"></view>
                  <view class="chart-switch-icon-pie-divider"></view>
                </view>
              </view>
              <text class="chart-switch-target">{{chartMode === 'pie' ? '柱状图' : '扇形图'}}</text>
            </view>
          </view>


          <view class="distribution-period-stage {{chartMode === 'pie' ? 'distribution-period-stage-active' : 'distribution-period-stage-hidden'}}" hidden="{{chartMode !== 'pie'}}">
            <view class="distribution-period-shell" aria-label="选择分布统计周期">
              <view class="period-slot">
                <view class="period-segment {{distributionPeriod === 'day' ? 'period-segment-active' : ''}}" data-period="day" catchtap="onDistributionPeriodTap" hover-class="period-segment-pressed">日</view>
              </view>
              <view class="period-slot">
                <view class="period-segment {{distributionPeriod === 'week' ? 'period-segment-active' : ''}}" data-period="week" catchtap="onDistributionPeriodTap" hover-class="period-segment-pressed">周</view>
              </view>
              <view class="period-slot">
                <view class="period-segment {{distributionPeriod === 'month' ? 'period-segment-active' : ''}}" data-period="month" catchtap="onDistributionPeriodTap" hover-class="period-segment-pressed">月</view>
              </view>
              <view class="period-slot period-slot-picker {{distributionPeriod === 'custom' ? 'period-slot-active' : ''}}">
                <view class="period-segment period-segment-custom {{distributionPeriod === 'custom' ? 'period-segment-active' : ''}}">自定义</view>
                <picker class="period-custom-picker-hitbox" mode="date" value="{{customRangeStartDate}}" start="{{customRangePickerStartDate}}" end="{{selectedDate}}" bindchange="onCustomRangeStartChange">
                  <view class="period-custom-picker-hitbox-inner"></view>
                </picker>
              </view>
            </view>
          </view>

          <view class="distribution-chart-stage distribution-chart-stage-{{chartMode}}">
            <view class="distribution-chart-panel distribution-chart-panel-pie distribution-chart-panel-animate {{chartMode === 'pie' ? 'distribution-chart-panel-active' : 'distribution-chart-panel-hidden'}}" hidden="{{chartMode !== 'pie'}}">
              <view class="pie-wrap {{pieTapped ? 'pie-tapped' : ''}} {{distributionHasData ? '' : 'pie-wrap-empty'}}" id="pie-chart-wrap">
                <canvas class="pie-canvas {{distributionHasData ? '' : 'pie-canvas-empty'}}" type="2d" id="pie-canvas" catchtap="onPieTap" hidden="{{!distributionHasData || !!selectedSubjectDetail}}"></canvas>
                <view class="distribution-empty-state" wx:if="{{!pieLoading && !distributionHasData}}">
                  <image class="distribution-empty-image" src="./assets/empty-duration.png" mode="aspectFit"></image>
                  <text class="distribution-empty-title" wx:if="{{distributionPeriod === 'day'}}">{{pieDateLabel}}暂无数据</text>
                  <text class="distribution-empty-title" wx:elif="{{distributionPeriod === 'week'}}">该周暂无数据</text>
                  <text class="distribution-empty-title" wx:elif="{{distributionPeriod === 'month'}}">该月暂无数据</text>
                  <text class="distribution-empty-title" wx:else>所选区间暂无数据</text>
                  <text class="distribution-empty-subtitle">开始专注，记录你的每一段时光吧</text>
                </view>
                <view class="pie-loading-mask" wx:if="{{chartMode === 'pie' && pieLoading}}">
                  <view class="pie-loading-ring"></view>
                  <text>正在更新分布</text>
                </view>
              </view>
            </view>

            <view class="distribution-chart-panel distribution-chart-panel-bar distribution-chart-panel-animate {{chartMode === 'bar' ? 'distribution-chart-panel-active' : 'distribution-chart-panel-hidden'}}" wx:if="{{barCanvasMounted}}" hidden="{{chartMode !== 'bar'}}">
              <view class="bar-chart-wrap {{trendHasData ? '' : 'bar-chart-wrap-empty'}}">
                <canvas class="trend-canvas {{trendHasData ? '' : 'trend-canvas-empty'}}" type="2d" id="trend-bars-canvas" hidden="{{!trendHasData || !!selectedSubjectDetail}}"></canvas>
                <view class="distribution-empty-state distribution-empty-state-bar" wx:if="{{!barRendering && !trendHasData}}">
                  <image class="distribution-empty-image distribution-empty-image-bar" src="./assets/empty-duration.png" mode="aspectFit"></image>
                  <text class="distribution-empty-title distribution-empty-title-bar">近7日暂无数据</text>
                  <text class="distribution-empty-subtitle distribution-empty-subtitle-bar">开始专注，记录你的每一段时光吧</text>
                </view>
                <view class="bar-loading-mask" wx:if="{{barRendering}}"><view class="pie-loading-ring"></view><text>正在生成柱状图</text></view>
              </view>
            </view>
          </view>

          <view class="distribution-legend-stage {{(chartMode === 'pie' && !distributionHasData) || (chartMode === 'bar' && !trendHasData) ? 'distribution-legend-stage-empty' : ''}}">
            <view class="distribution-legend-panel distribution-legend-panel-animate {{chartMode === 'bar' ? 'distribution-legend-panel-active' : 'distribution-legend-panel-hidden'}}" hidden="{{chartMode !== 'bar'}}">
              <view class="chart-legend distribution-bar-legend" wx:if="{{trendHasData}}">
                <view class="legend-item"><view class="legend-dot legend-dot-record"></view><text class="legend-text">有记录</text></view>
                <view class="legend-item"><view class="legend-dot legend-dot-empty"></view><text class="legend-text">无记录</text></view>
              </view>
            </view>
            <view class="distribution-legend-panel distribution-legend-panel-animate {{chartMode === 'pie' ? 'distribution-legend-panel-active' : 'distribution-legend-panel-hidden'}}" hidden="{{chartMode !== 'pie'}}">
              <view class="subject-legend" aria-label="学科图例" wx:if="{{subjects.length > 0}}">
                <view class="subject-legend-item" wx:for="{{subjects}}" wx:key="subject_id">
                  <view class="subject-legend-dot" style="background: {{item._color}};"></view>
                  <view class="subject-legend-copy">
                    <view class="subject-legend-head">
                      <text class="subject-legend-name">{{item._label}}</text>
                      <text class="subject-legend-percent">{{item._pctText}}</text>
                    </view>
                    <text class="subject-legend-duration">{{item._durationBadgeText}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- ===== HISTORY ===== -->
        <view class="card-section history-card-section">
          <view class="section-header history-section-header">
            <text class="section-title history-section-title">最近记录</text>
          </view>
          <view wx:if="{{!historyReady}}" class="history-placeholder">
            <view class="history-placeholder-row">
              <view class="history-placeholder-icon"></view>
              <view class="history-placeholder-copy">
                <view class="history-placeholder-line history-placeholder-line-long"></view>
                <view class="history-placeholder-line history-placeholder-line-short"></view>
              </view>
              <view class="history-placeholder-status"></view>
            </view>
            <view class="history-placeholder-row">
              <view class="history-placeholder-icon"></view>
              <view class="history-placeholder-copy">
                <view class="history-placeholder-line"></view>
                <view class="history-placeholder-line history-placeholder-line-short"></view>
              </view>
              <view class="history-placeholder-status"></view>
            </view>
            <view class="history-placeholder-row">
              <view class="history-placeholder-icon"></view>
              <view class="history-placeholder-copy">
                <view class="history-placeholder-line history-placeholder-line-long"></view>
                <view class="history-placeholder-line history-placeholder-line-short"></view>
              </view>
              <view class="history-placeholder-status"></view>
            </view>
          </view>
          <view wx:elif="{{history.length === 0}}" class="empty-hint history-empty-state">
            <image class="history-empty-image" src="./assets/empty-history.png" mode="aspectFit"></image>
            <view class="history-empty-copy" wx:if="{{selectedDate === _todayDate && _crossDayBleedIn}}">
              <text class="history-empty-title">今日暂无当日开始的学习记录</text>
              <text class="history-empty-subtitle">已有跨统计日的学习时长</text>
            </view>
            <view class="history-empty-copy" wx:elif="{{selectedDate === _todayDate}}">
              <text class="history-empty-title">今天还没有学习记录</text>
              <text class="history-empty-subtitle">开始专注或刷一组题吧，记录你的每一段时光</text>
            </view>
            <view class="history-empty-copy" wx:else>
              <text class="history-empty-title">{{selectedDate}} 暂无学习记录</text>
              <text class="history-empty-subtitle">换个日期看看，或开始一段新的专注吧</text>
            </view>
          </view>
          <view class="history-list" wx:elif="{{history.length > 0}}">
            <view class="bleed-hint" wx:if="{{selectedDate === _todayDate && _crossDayBleedIn}}">部分时长来自跨统计日（前一统计日开始）</view>
            <view class="history-item" wx:for="{{history}}" wx:key="record_key">
              <view class="hist-icon" style="color: {{item._color}};" aria-hidden="true">
                <view class="hist-icon-tint"></view>
                <view class="hist-pomodoro-body"></view>
                <view class="hist-pomodoro-stem"></view>
                <view class="hist-pomodoro-leaf hist-pomodoro-leaf-left"></view>
                <view class="hist-pomodoro-leaf hist-pomodoro-leaf-right"></view>
                <view class="hist-pomodoro-clock"></view>
                <view class="hist-pomodoro-hand hist-pomodoro-hand-hour"></view>
                <view class="hist-pomodoro-hand hist-pomodoro-hand-minute"></view>
              </view>
              <view class="hist-left">
                <text class="hist-subject">{{item._subjectLabel}}</text>
                <text class="hist-meta" wx:if="{{item._taskTypeLabel}}">{{item._taskTypeLabel}} · {{item._time}} · {{item._duration}}</text>
                <text class="hist-meta" wx:else>{{item._time}} · {{item._duration}}</text>
              </view>
              <view class="hist-right">
                <text class="hist-status {{item._statusClass}}">{{item._statusLabel}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- bottom spacer -->
        <view class="bottom-spacer"></view>
    </view>

  </view>

  <!-- ===== DETAIL POPUP ===== -->
  <view class="detail-overlay {{selectedSubjectDetail ? 'visible' : ''}}" catchtap="closeDetail"
        catchtouchmove="noop">
    <view class="detail-card" catchtap="noop" wx:if="{{selectedSubjectDetail}}">
      <view class="detail-header">
        <view class="detail-dot" style="background: {{selectedSubjectDetail._color}};"></view>
        <text class="detail-subject">{{selectedSubjectDetail._label}}</text>
      </view>
      <view class="detail-body">
        <view class="detail-item">
          <text class="detail-label">学习时长</text>
          <text class="detail-value">{{selectedSubjectDetail._durationText}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">{{distributionPeriod === 'day' ? pieDateLabel : '区间'}}占比</text>
          <text class="detail-value">{{selectedSubjectDetail._pctText}}</text>
        </view>
        <view class="detail-item">
          <text class="detail-label">{{distributionPeriod === 'day' ? '当日开始次数' : '区间开始次数'}}</text>
          <text class="detail-value">{{selectedSubjectDetail.sessions || 0}} 次</text>
        </view>
      </view>
      <view class="detail-close-wrap" catchtap="closeDetail">
        <text class="detail-close-text">点击关闭</text>
      </view>
    </view>
  </view>

</view>
