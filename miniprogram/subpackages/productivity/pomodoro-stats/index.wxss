/* ============================================
   🎯 极夜·专注 — Pomodoro Stats
   Dark immersive theme for focus analytics
   ============================================ */

page {
  min-height: 100vh;
  background: #F4F4EE;
  background-color: #F4F4EE;
}

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0B1121 0%, #1A1F35 50%, #111827 100%);
}

.page-inner {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.stats-content {
  flex: 1;
  padding-top: 48rpx;
}

.stats-content-pending {
  visibility: hidden;
}

/* ── Loading ── */
.initial-state-layer {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  background: #0B1121;
}

.loading-wrap {
  flex: 1;
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.initial-loading-ring {
  width: 54rpx;
  height: 54rpx;
  border: 4rpx solid rgba(96, 165, 250, 0.16);
  border-top-color: #60A5FA;
  border-radius: 50%;
  animation: initial-loading-spin 720ms linear infinite;
}

.initial-loading-text {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.42);
  letter-spacing: 2rpx;
}

@keyframes initial-loading-spin {
  to { transform: rotate(360deg); }
}

/* ============================================
   OVERVIEW SECTION — one primary + two supporting cards
   ============================================ */
.overview-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.overview-main-card {
  position: relative;
  overflow: hidden;
  padding: 28rpx 30rpx 24rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 88% 4%, rgba(96, 165, 250, 0.18), transparent 190rpx),
    linear-gradient(135deg, rgba(59, 130, 246, 0.13), rgba(255, 255, 255, 0.035));
  border: 1rpx solid rgba(96, 165, 250, 0.18);
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.13);
}

.overview-main-card::before {
  content: '';
  position: absolute;
  width: 190rpx;
  height: 190rpx;
  right: -78rpx;
  top: -92rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.overview-main-head,
.overview-duration-row,
.overview-secondary-head {
  display: flex;
  align-items: center;
}

.overview-main-head {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-main-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.overview-kicker,
.overview-secondary-kicker {
  font-size: 17rpx;
  font-weight: 750;
  letter-spacing: 3rpx;
  color: rgba(147, 197, 253, 0.72);
}

.overview-main-label {
  font-size: 24rpx;
  font-weight: 650;
  color: rgba(255, 255, 255, 0.58);
}

.overview-session-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.065);
  border: 1rpx solid rgba(255, 255, 255, 0.085);
}

.overview-session-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #93C5FD;
  box-shadow: 0 0 12rpx rgba(147, 197, 253, 0.42);
}

.overview-session-number {
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
}

.overview-session-unit {
  font-size: 19rpx;
  font-weight: 550;
  color: rgba(255, 255, 255, 0.4);
}

.overview-duration-row {
  position: relative;
  z-index: 1;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 22rpx;
}

.overview-duration {
  font-size: 58rpx;
  font-weight: 850;
  line-height: 1.08;
  letter-spacing: -2rpx;
  color: #60A5FA;
}

.overview-duration-note {
  font-size: 20rpx;
  font-weight: 550;
  color: rgba(255, 255, 255, 0.3);
}

.overview-accent-line {
  position: relative;
  z-index: 1;
  height: 4rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.055);
}

.overview-accent-glow {
  width: 46%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #3B82F6, #22D3EE);
  box-shadow: 0 0 16rpx rgba(59, 130, 246, 0.35);
}

.overview-secondary-row {
  display: flex;
  gap: 16rpx;
}

.overview-secondary-card {
  position: relative;
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.055);
}

.overview-secondary-head {
  gap: 9rpx;
  margin-bottom: 13rpx;
}

.overview-mini-mark {
  width: 10rpx;
  height: 10rpx;
  flex-shrink: 0;
  border-radius: 3rpx;
  transform: rotate(45deg);
}

.overview-mini-mark-count {
  background: #A78BFA;
  box-shadow: 0 0 12rpx rgba(167, 139, 250, 0.28);
}

.overview-mini-mark-time {
  background: #34D399;
  box-shadow: 0 0 12rpx rgba(52, 211, 153, 0.25);
}

.overview-secondary-kicker {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 1.5rpx;
}

.overview-secondary-value {
  display: block;
  font-size: 39rpx;
  font-weight: 800;
  line-height: 1.12;
  color: rgba(255, 255, 255, 0.86);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-secondary-value-green {
  color: #34D399;
}

.overview-secondary-label {
  display: block;
  margin-top: 7rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   CARD SECTIONS
   ============================================ */
.card-section {
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
  letter-spacing: 2rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* ── 统计日设置 ── */
.day-start-section {
  padding: 24rpx 28rpx;
}

.day-start-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.day-start-left {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.day-start-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 6rpx;
}

.day-start-note {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.42);
  line-height: 1.5;
}

.day-start-edit {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 18rpx;
  background: rgba(59, 130, 246, 0.12);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.day-start-edit-text {
  font-size: 22rpx;
  color: #60A5FA;
}

.day-start-arrow {
  font-size: 24rpx;
  color: #60A5FA;
  line-height: 1;
}

/* ── Today Quick Button ── */
.today-btn {
  padding: 8rpx 18rpx;
  background: rgba(59, 130, 246, 0.12);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
  border-radius: 999rpx;
  transition: all 0.2s;
}

.today-btn-pressed {
  background: rgba(59, 130, 246, 0.2);
  transform: scale(0.95);
}

.today-btn-text {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(59, 130, 246, 0.85);
  line-height: 1.3;
}

/* ── Date Picker ── */
.date-picker-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 999rpx;
  transition: all 0.2s;
}

.date-picker-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

.date-picker-arrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.25);
  line-height: 1;
  margin-top: 2rpx;
}

/* ============================================
   TREND CHART
   ============================================ */
.chart-wrap {
  width: 100%;
  height: 280rpx;
}

.trend-canvas {
  width: 100%;
  height: 280rpx;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 28rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chart-legend .legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* ============================================
   HISTORY — 方案一：简约清新列表
   ============================================ */
.history-card-section {
  padding: 30rpx 28rpx 10rpx;
}

.history-section-header {
  margin-bottom: 4rpx;
  padding-bottom: 8rpx;
}

.history-section-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.9);
}

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 0 52rpx;
  gap: 20rpx;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  border: 2rpx dashed rgba(255, 255, 255, 0.08);
  position: relative;
}

.empty-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  transform: translate(-50%, -60%);
}

.empty-icon::after {
  content: '';
  position: absolute;
  top: 58%;
  left: 50%;
  width: 20rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 2rpx;
  transform: translateX(-50%);
}

.empty-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.2);
  text-align: center;
  line-height: 1.6;
}

.empty-text-line {
  display: block;
}

.bleed-hint {
  margin: 4rpx 0 8rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(96, 165, 250, 0.07);
  border: 1rpx solid rgba(96, 165, 250, 0.1);
  font-size: 21rpx;
  color: rgba(191, 219, 254, 0.62);
  line-height: 1.5;
}

/* ── History List ── */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.history-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 20rpx 0;
  background: transparent;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
  -webkit-tap-highlight-color: transparent;
}

.history-item:last-child {
  border-bottom: 0;
}

.hist-icon {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  overflow: hidden;
}

.hist-icon-tint {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: 50%;
  opacity: 0.16;
}

.hist-icon-label {
  position: relative;
  z-index: 1;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
}

.hist-left {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  padding-left: 18rpx;
  flex: 1;
  min-width: 0;
}

.hist-subject {
  font-size: 27rpx;
  line-height: 1.28;
  color: rgba(255, 255, 255, 0.84);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hist-meta {
  font-size: 21rpx;
  line-height: 1.28;
  color: rgba(255, 255, 255, 0.34);
}

.hist-right {
  display: flex;
  align-items: center;
  padding-left: 18rpx;
  flex-shrink: 0;
}

.hist-status {
  min-width: 58rpx;
  padding: 9rpx 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.2;
  text-align: center;
  box-sizing: border-box;
}

.hist-status.status-done {
  color: #6EE7B7;
  background: rgba(16, 185, 129, 0.11);
}

.hist-status.status-interrupt {
  color: #FDA4AF;
  background: rgba(244, 63, 94, 0.11);
}

/* ── Loading placeholder aligned with the new row layout ── */
.history-placeholder {
  display: flex;
  flex-direction: column;
  padding: 4rpx 0 0;
}

.history-placeholder-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.history-placeholder-row:last-child {
  border-bottom: 0;
}

.history-placeholder-icon {
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

.history-placeholder-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 0 18rpx;
}

.history-placeholder-line {
  width: 64%;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.045);
}

.history-placeholder-line-long {
  width: 82%;
}

.history-placeholder-line-short {
  width: 46%;
  height: 14rpx;
}

.history-placeholder-status {
  width: 72rpx;
  height: 38rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.045);
}

/* ============================================
   PIE CHART
   ============================================ */
.pie-card-section {
  position: relative;
  overflow: hidden;
}

.pie-section-header {
  align-items: flex-start;
  margin-bottom: 4rpx;
}

.pie-title-wrap {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.pie-section-subtitle {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.24);
  line-height: 1.3;
}

.pie-date-picker-btn {
  background: rgba(59, 130, 246, 0.08);
  border-color: rgba(96, 165, 250, 0.14);
}

.pie-date-picker-btn .date-picker-text {
  color: rgba(191, 219, 254, 0.76);
  font-size: 21rpx;
}

.pie-wrap {
  position: relative;
  width: 100%;
  height: 560rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 12rpx;
  overflow: visible;
}

.pie-wrap::before {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 38rpx;
  width: 380rpx;
  height: 80rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.06) 50%, rgba(0, 0, 0, 0) 72%);
  filter: blur(8rpx);
}

.pie-canvas {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 560rpx;
}

.pie-loading-mask {
  position: absolute;
  z-index: 4;
  inset: 34rpx 26rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  border-radius: 28rpx;
  background: rgba(11, 17, 33, 0.66);
  backdrop-filter: blur(8rpx);
  color: rgba(255,255,255,0.5);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  animation: pie-loading-fade 180ms ease-out both;
}

.pie-loading-ring {
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid rgba(96,165,250,0.14);
  border-top-color: rgba(96,165,250,0.88);
  border-radius: 50%;
  animation: pie-loading-spin 720ms linear infinite;
}

@keyframes pie-loading-spin {
  to { transform: rotate(360deg); }
}

@keyframes pie-loading-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.subject-legend {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx 20rpx;
  padding: 20rpx 10rpx 4rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.subject-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 42rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.025);
}

.subject-legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.08);
}

.subject-legend-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.48);
  font-weight: 500;
  line-height: 1.4;
}

.subject-legend-percent {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 600;
  line-height: 1.4;
}

/* ── Pie Tap Feedback ── */
.pie-wrap.pie-tapped {
  animation: pie-tap-feedback 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes pie-tap-feedback {
  0% { transform: scale(1); }
  40% { transform: scale(0.96); }
  100% { transform: scale(1); }
}

/* ============================================
   DETAIL POPUP
   ============================================ */
.detail-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.detail-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.detail-overlay::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(11, 17, 33, 0.85);
  backdrop-filter: blur(12rpx);
}

.detail-card {
  position: relative;
  z-index: 2;
  width: 520rpx;
  padding: 40rpx 36rpx;
  background: linear-gradient(180deg, #1A1F35 0%, #111827 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 32rpx;
  animation: popup-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes popup-in {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.detail-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.detail-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.detail-subject {
  font-size: 36rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
}

.detail-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 400;
}

.detail-value {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 600;
}

.detail-close-wrap {
  text-align: center;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

.detail-close-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
  letter-spacing: 2rpx;
}

/* ── Bottom Spacer ── */
.bottom-spacer {
  height: 40rpx;
}

@media (prefers-reduced-motion: reduce) {
  .page,
  .initial-loading-ring,
  .pie-wrap,
  .pie-loading-mask,
  .pie-loading-ring {
    animation: none !important;
    transition: none !important;
  }
}

/* Selected-date duration count transition */
.duration-value {
  transform: translateZ(0) scale(1);
  transform-origin: center;
  opacity: 1;
  text-shadow: 0 0 0 rgba(59, 130, 246, 0);
  transition: transform 220ms ease, opacity 220ms ease, text-shadow 260ms ease;
  will-change: transform, opacity;
}

.duration-value-updating {
  transform: translateZ(0) translateY(-1rpx) scale(1.025);
  opacity: 0.96;
  text-shadow: 0 0 20rpx rgba(59, 130, 246, 0.28);
}

