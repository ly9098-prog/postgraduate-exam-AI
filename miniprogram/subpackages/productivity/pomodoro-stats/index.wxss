  white-space: nowrap;
}

.cumulative-focus-card,
.daily-focus-card,
.distribution-card {
  border-radius: 26rpx;
}
.cumulative-focus-card { padding: 28rpx 28rpx 22rpx; }
.cumulative-start-picker {
  gap: 7rpx;
  min-height: 44rpx;
  padding: 0 4rpx;
  color: rgba(255,255,255,.46);
  font-size: 20rpx;
  line-height: 1.2;
}
.study-day-chip {
  gap: 8rpx;
  min-height: 52rpx;
  padding: 0 17rpx;
  border: 1rpx solid rgba(255,255,255,.075);
  border-radius: 999rpx;
  background: rgba(255,255,255,.045);
  color: rgba(255,255,255,.5);
  font-size: 18rpx;
  white-space: nowrap;
}
.micro-chevron {
  width: 9rpx;
  height: 9rpx;
  box-sizing: border-box;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg) translateY(-2rpx);
  opacity: .72;
}
.soft-control-pressed { opacity: .7; transform: scale(.97); }

.focus-card-title-line > picker,
.focus-card-head > picker,
.distribution-period-shell > picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}
.focus-card-title-line > picker .cumulative-start-picker,
.focus-card-title-line > picker .daily-date-picker {
  min-height: 88rpx;
}

.cumulative-metrics {
  display: grid;
  grid-template-columns: .8fr 1rpx 1.35fr 1rpx 1.35fr;
  align-items: stretch;
  gap: 22rpx;
  margin-top: 24rpx;
  padding: 4rpx 0 17rpx;
  transition: opacity 180ms ease;
}
.cumulative-metrics-loading { opacity: .48; }
.cumulative-metric { min-width: 0; }
.metric-divider { width: 1rpx; min-height: 70rpx; background: rgba(255,255,255,.08); }
.metric-label,
.daily-metric-label {
  display: block;
  color: rgba(255,255,255,.36);
  font-size: 18rpx;
  line-height: 1.35;
}
.metric-value-row { align-items: baseline; gap: 5rpx; margin-top: 8rpx; }
.metric-value {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #52D4A1;
  font-size: 35rpx;
  font-weight: 780;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.metric-value-text { margin-top: 8rpx; font-size: 29rpx; letter-spacing: -.6rpx; }
.metric-unit { color: rgba(255,255,255,.31); font-size: 16rpx; }
.cumulative-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7rpx;
  padding-top: 17rpx;
  border-top: 1rpx solid rgba(255,255,255,.06);
  color: rgba(255,255,255,.3);
  font-size: 17rpx;
  line-height: 1.45;
}
.cumulative-foot-sep { opacity: .55; }

.daily-focus-card { padding: 27rpx 28rpx 26rpx; }
.daily-focus-head { margin-bottom: 21rpx; }
.daily-title-line { gap: 14rpx; }
.daily-date-picker {
  min-height: 40rpx;
  padding: 0 3rpx;
  color: #53CBA2;
  font-size: 19rpx;
  font-weight: 520;
  letter-spacing: .2rpx;
}
.daily-date-nav {
  overflow: hidden;
  flex-shrink: 0;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,.045);
}
