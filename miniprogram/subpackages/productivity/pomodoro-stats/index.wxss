/* ============================================
   Reference polish v2 — keep accents inside cards + cleaner empty states
   ============================================ */
.cumulative-focus-card,
.daily-focus-card {
  overflow: hidden;
}

/* The reference uses two separate soft shapes in the cumulative card:
   a cloud tucked into the top-right edge and a small wave at the bottom-right. */
.cumulative-card-decor {
  top: -26rpx;
  right: -12rpx;
  width: 98rpx;
  height: 72rpx;
  border-radius: 45% 55% 58% 42%;
  transform: rotate(14deg);
}

.cumulative-card-decor::before {
  width: 66rpx;
  height: 54rpx;
  left: -28rpx;
  top: 18rpx;
}

.cumulative-card-decor::after {
  width: 58rpx;
  height: 54rpx;
  right: 5rpx;
  bottom: -22rpx;
}

.cumulative-card-decor-bottom {
  z-index: 0;
  right: -18rpx;
  bottom: -30rpx;
  width: 132rpx;
  height: 72rpx;
  border-radius: 54% 46% 0 0 / 72% 68% 0 0;
  background: rgba(151, 199, 163, .10);
  transform: rotate(-7deg);
}

.cumulative-card-decor-bottom::before {
  content: '';
  position: absolute;
  left: -44rpx;
  bottom: 2rpx;
  width: 94rpx;
  height: 42rpx;
  border-radius: 70% 42% 0 0 / 100% 88% 0 0;
  background: inherit;
  transform: rotate(8deg);
}

/* Daily card only keeps the small tomato-green dot cluster seen in the reference. */
.daily-card-decor {
  top: 50rpx;
  right: 20rpx;
  width: 27rpx;
  height: 27rpx;
}

.daily-card-decor::before {
  width: 9rpx;
  height: 9rpx;
  left: -13rpx;
  top: -8rpx;
}

/* Tune the distribution corners to read as clipped organic accents rather than floating blobs. */
.distribution-corner-top-left {
  left: -48rpx;
  top: -46rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 42% 58% 64% 36%;
  transform: rotate(20deg);
}

.distribution-corner-bottom-left {
  left: -38rpx;
  bottom: -48rpx;
  width: 92rpx;
  height: 88rpx;
  border-radius: 58% 42% 38% 62%;
  transform: rotate(-16deg);
}

.distribution-corner-bottom-right {
  right: -40rpx;
  bottom: -48rpx;
  width: 132rpx;
  height: 94rpx;
  border-radius: 56% 44% 34% 66%;
  transform: rotate(12deg);
}

.distribution-dot-a {
  left: 34rpx;
  bottom: 88rpx;
  width: 11rpx;
  height: 11rpx;
}

.distribution-dot-b {
  left: 58rpx;
  bottom: 55rpx;
  width: 8rpx;
  height: 8rpx;
}

.distribution-dot-c {
  left: 78rpx;
  bottom: 29rpx;
  width: 6rpx;
  height: 6rpx;
}

/* No decoration belongs to the top edge of the history card in the reference. */
.history-card-decor {
  display: none;
}

/* Native Canvas can live on its own composition layer on some WeChat runtimes.
   hidden=... in WXML is the primary guard; these rules are the visual fallback. */
.pie-canvas-empty,
.trend-canvas-empty {
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
}

.pie-wrap-empty {
  pointer-events: none;
}

.distribution-empty-state {
  padding-top: 0;
  padding-bottom: 18rpx;
  animation: statsEmptyStateIn 240ms cubic-bezier(.22, 1, .36, 1) both;
}

.distribution-empty-image {
  width: 374rpx;
  height: 214rpx;
  margin-bottom: 18rpx;
}

.distribution-empty-title {
  font-size: 30rpx;
  line-height: 1.3;
}

.distribution-empty-subtitle {
  margin-top: 14rpx;
  line-height: 1.45;
}

.history-empty-state {
  overflow: hidden;
  animation: statsEmptyStateIn 240ms cubic-bezier(.22, 1, .36, 1) both;
}

.history-empty-image {
  margin-bottom: 12rpx;
}

/* Make the compact segmented control feel tappable without changing its visual height. */
.period-segment {
  transition: background 150ms ease, color 150ms ease, opacity 120ms ease, transform 120ms cubic-bezier(.22, 1, .36, 1);
}

.period-segment-pressed {
  transform: scale(.965);
  opacity: .72;
}

.chart-switch-btn {
  transition: transform 140ms cubic-bezier(.22, 1, .36, 1), background 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
}

.theme-light .cumulative-card-decor-bottom {
  background: rgba(174, 216, 183, .25);
}

.theme-light .chart-switch-pressed {
  background: #EDF4EF;
  border-color: #D3E2D7;
  box-shadow: 0 2rpx 6rpx rgba(21, 51, 35, .025);
}

@keyframes statsEmptyStateIn {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .distribution-empty-state,
  .history-empty-state {
    animation: none !important;
  }
}

@media (max-width: 350px) {
  .distribution-empty-image {
    width: 338rpx;
    height: 194rpx;
  }
}
