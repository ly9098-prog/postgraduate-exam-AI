}
.daily-date-nav-pressed { transform: scale(.9); background: rgba(255,255,255,.08); }
.daily-nav-chevron {
  width: 14rpx;
  height: 14rpx;
  box-sizing: border-box;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
}
.daily-nav-chevron-prev { transform: rotate(-135deg); margin-left: 5rpx; }
.daily-nav-chevron-next { transform: rotate(45deg); margin-right: 5rpx; }
.daily-date-nav-disabled { opacity: .22; }
.daily-focus-metrics {
  display: grid;
  grid-template-columns: .86fr 1.45fr;
  gap: 22rpx;
  align-items: stretch;
}
.daily-count-metric { padding: 14rpx 4rpx 10rpx; }
.daily-value-row { align-items: baseline; gap: 7rpx; margin-top: 8rpx; }
.daily-count-value {
  color: #4ED2A0;
  font-size: 49rpx;
  font-weight: 760;
  line-height: 1.08;
  letter-spacing: -1rpx;
}
.daily-count-unit { color: rgba(255,255,255,.28); font-size: 17rpx; }
.daily-duration-metric {
  padding: 18rpx 22rpx 17rpx;
  border: 1rpx solid rgba(82,212,161,.08);
  border-radius: 18rpx;
  background: rgba(82,212,161,.07);
}
