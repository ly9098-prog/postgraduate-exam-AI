/* ============================================
   2026 REFINEMENT — cumulative / day / chart switch
   Applied last so the new statistics hierarchy remains intentional in both themes.
   ============================================ */
.stats-content { padding-top: 28rpx; }
.card-section { margin-bottom: 20rpx; }

.focus-card-head,
.focus-card-title-line,
.cumulative-start-picker,
.study-day-chip,
.metric-value-row,
.daily-value-row,
.daily-date-picker,
.daily-date-nav,
.daily-date-nav-btn,
.chart-switch-btn,
.chart-switch-glyph,
.subject-legend-copy {
  display: flex;
  align-items: center;
}

.focus-card-head { justify-content: space-between; gap: 18rpx; }
.focus-card-title-line { min-width: 0; gap: 14rpx; }
.focus-card-title {
  color: rgba(255,255,255,.92);
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1.25;
