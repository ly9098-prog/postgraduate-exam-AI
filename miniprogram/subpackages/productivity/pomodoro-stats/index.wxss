/* Complete the existing loading/error states in both themes. */
.error-state {
  flex: 1;
  min-height: 65vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
}

.error-icon-wrap {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(239, 68, 68, 0.08);
}

.error-title {
  font-size: 27rpx;
  color: rgba(255, 255, 255, 0.58);
}

.gradient-btn {
  min-width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #3B82F6, #06B6D4);
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
}

.gradient-btn::after {
  border: 0;
}

.gradient-btn-pressed {
  opacity: 0.82;
  transform: scale(0.97);
}

.theme-light .error-title {
  color: #5D6A61;
}

.theme-light .error-icon-wrap {
  background: rgba(239, 68, 68, 0.07);
  border: 1rpx solid rgba(239, 68, 68, 0.12);
}

.theme-light .gradient-btn {
  background: linear-gradient(135deg, #153323, #24543A);
  box-shadow: 0 10rpx 26rpx rgba(21, 51, 35, 0.18);
}

@media (prefers-reduced-motion: reduce) {
  .theme-backdrop {
    transition: none !important;
  }
}
