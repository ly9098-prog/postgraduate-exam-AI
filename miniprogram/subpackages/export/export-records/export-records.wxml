<!-- Export records page -->

<view class="page export-records-page">
  <premium-nav title="导出记录" show-back="{{true}}" bind:back="onBack" />

  <scroll-view
    class="records-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    bindscrolltolower="onLoadMore"
  >
    <view class="records-content">
      <!-- Safe default: unavailable until capability check succeeds -->
      <view wx:if="{{!exportAvailable}}" class="unavailable-state">
        <view class="unavailable-icon" aria-hidden="true">
          <view class="unavailable-icon-line"></view>
          <view class="unavailable-icon-dot"></view>
        </view>
        <text class="unavailable-title">当前导出功能不可用</text>
        <text class="unavailable-text">
          {{exportCapabilityLoading ? '正在检查导出服务状态，请稍候。' : (exportUnavailableText || '请稍后再试。')}}
        </text>
        <button
          wx:if="{{exportCapabilityRetryable}}"
          class="unavailable-action"
          hover-class="button-pressed"
          disabled="{{exportCapabilityLoading}}"
          loading="{{exportCapabilityLoading}}"
          bindtap="onRetryCapability"
        >{{exportCapabilityLoading ? '正在检查' : '重新检查'}}</button>
      </view>

      <!-- First-load skeleton -->
      <view wx:elif="{{loading && list.length === 0}}" class="skeleton-list">
        <view wx:for="{{skeletonItems}}" wx:key="*this" class="skeleton-card">
          <view class="skeleton-row skeleton-row-top">
            <view class="skeleton-circle"></view>
            <view class="skeleton-copy">
              <view class="skeleton-line skeleton-line-status"></view>
              <view class="skeleton-line skeleton-line-caption"></view>
            </view>
            <view class="skeleton-pill"></view>
          </view>
          <view class="skeleton-line skeleton-line-title"></view>
          <view class="skeleton-line skeleton-line-meta"></view>
          <view class="skeleton-actions">
            <view class="skeleton-button"></view>
            <view class="skeleton-button"></view>
            <view class="skeleton-button"></view>
          </view>
        </view>
      </view>

      <!-- Empty state -->
      <view wx:elif="{{list.length === 0}}" class="empty-state">
        <view class="empty-illustration" aria-hidden="true">
          <view class="empty-paper">
            <view class="empty-paper-fold"></view>
            <view class="empty-paper-line line-one"></view>
            <view class="empty-paper-line line-two"></view>
            <view class="empty-paper-line line-three"></view>
          </view>
          <view class="empty-check">✓</view>
        </view>
        <text class="empty-title">还没有导出记录</text>
        <text class="empty-text">完成导出后，文件会集中保存在这里，方便预览和分享。</text>
        <button class="empty-action" hover-class="button-pressed" bindtap="onGoExport">去导出错题</button>
      </view>

      <block wx:else>
        <view class="records-intro">
          <view class="intro-title-row">
            <text class="intro-title">最近导出</text>
            <text class="intro-count">{{totalRecords}} 条</text>
          </view>
          <text class="intro-caption">文件到期前可随时预览或分享</text>
        </view>

        <view
          wx:for="{{list}}"
          wx:key="id"
          class="record-card record-card-{{item.visualStatus}} {{highlightId === item.id ? 'record-card-highlight' : ''}}"
        >
          <view class="record-status-row">
            <view class="status-identity">
              <view class="status-mark status-mark-{{item.visualStatus}}">
                <view wx:if="{{item.status === 'processing'}}" class="status-spinner"></view>
                <text wx:else class="status-glyph">{{item.statusGlyph}}</text>
              </view>
              <view class="status-copy">
                <text class="status-title">{{item.statusLabel}}</text>
                <text class="status-summary">{{item.statusSummary}}</text>
              </view>
            </view>

            <text class="record-format format-{{item.file_format}}">{{item.formatText}}</text>
          </view>

          <view class="record-file-block">
            <text class="record-filename">{{item.displayFileName}}</text>
            <text class="record-date">导出于 {{item.dateText}}</text>
            <text wx:if="{{item.layoutSummary}}" class="record-layout">{{item.layoutSummary}}</text>
          </view>

          <view class="record-facts">
            <view class="fact-item">
              <text class="fact-label">题目</text>
              <text class="fact-value">{{item.questionCountText}}</text>
            </view>
            <view wx:if="{{item.fileSizeText}}" class="fact-divider"></view>
            <view wx:if="{{item.fileSizeText}}" class="fact-item">
              <text class="fact-label">大小</text>
              <text class="fact-value">{{item.fileSizeText}}</text>
            </view>
            <view wx:if="{{item.resultText}}" class="fact-divider"></view>
            <view wx:if="{{item.resultText}}" class="fact-item fact-item-wide">
              <text class="fact-label">结果</text>
              <text class="fact-value {{item.skip_count > 0 ? 'fact-value-warning' : ''}}">{{item.resultText}}</text>
            </view>
          </view>

          <view
            wx:if="{{item.expiresText}}"
            class="expiry-row {{item.expiresSoon ? 'expiry-row-soon' : ''}} {{item.status === 'expired' ? 'expiry-row-expired' : ''}}"
          >
            <view class="expiry-clock">
              <view class="expiry-clock-hand"></view>
            </view>
            <view class="expiry-copy">
              <text class="expiry-text">{{item.expiresText}}</text>
              <text class="expiry-relative">{{item.expiresRelativeText}}</text>
            </view>
          </view>

          <view wx:if="{{item.error_message && (item.status === 'failed' || item.reexport_failed)}}" class="message-panel {{item.reexport_failed ? 'message-panel-warning' : 'message-panel-error'}}">
            <view class="message-icon">!</view>
            <text class="message-text">{{item.error_message}}</text>
          </view>

          <view wx:if="{{item._warning && (item.status === 'pending' || item.status === 'processing')}}" class="message-panel message-panel-warning">
            <view class="message-icon">!</view>
            <text class="message-text">{{item._warning}}</text>
          </view>

          <view wx:if="{{item.status === 'pending' || item.status === 'processing'}}" class="progress-panel">
            <view class="progress-track">
              <view class="progress-bar progress-bar-{{item.status}}"></view>
            </view>
            <text class="progress-caption">
              {{item.is_reexporting ? '正在生成新版文件，上一版仍可正常打开' : (item.status === 'pending' ? '正在等待处理，状态会自动更新' : '正在排版并生成文件，完成后状态会自动更新')}}
            </text>
          </view>

          <!-- Actions by status -->
          <view class="record-actions">
            <!-- Pending / Processing -->
            <block wx:if="{{item.status === 'pending' || item.status === 'processing'}}">
              <view wx:if="{{item.hasPreviousFile}}" class="two-actions">
                <button
                  class="action-btn action-btn-secondary"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{previewingTaskId === item.id}}"
                  bindtap="onPreview"
                >{{previewingTaskId === item.id ? '打开中' : '预览旧版'}}</button>
                <button
                  class="action-btn action-btn-subtle action-btn-danger-text"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{deletingTaskId === item.id}}"
                  loading="{{deletingTaskId === item.id}}"
                  bindtap="onDelete"
                >{{deletingTaskId === item.id ? '删除中' : '删除任务'}}</button>
              </view>
              <button
                wx:else
                class="action-btn action-btn-subtle action-btn-danger-text action-btn-full"
                hover-class="button-pressed"
                data-id="{{item.id}}"
                disabled="{{deletingTaskId === item.id}}"
                loading="{{deletingTaskId === item.id}}"
                bindtap="onDelete"
              >{{deletingTaskId === item.id ? '删除中' : '删除任务'}}</button>
            </block>

            <!-- Completed -->
            <block wx:elif="{{item.status === 'completed'}}">
              <view class="completed-actions completed-actions-two">
                <button
                  class="action-btn action-btn-primary"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{previewingTaskId === item.id}}"
                  bindtap="onPreview"
                >{{previewingTaskId === item.id ? '打开中' : '打开文件'}}</button>
                <button
                  class="action-btn action-btn-secondary"
                  hover-class="button-pressed"
                  open-type="share"
                  data-id="{{item.id}}"
                >转发记录</button>
              </view>

              <button
                class="more-toggle"
                hover-class="more-toggle-pressed"
                data-id="{{item.id}}"
                bindtap="onToggleMore"
              >
                <text>其他操作</text>
                <view class="more-chevron {{expandedActionId === item.id ? 'more-chevron-open' : ''}}"></view>
              </button>

              <view wx:if="{{expandedActionId === item.id}}" class="secondary-actions">
                <button
                  class="secondary-action"
                  hover-class="secondary-action-pressed"
                  data-id="{{item.id}}"
                  disabled="{{reExportingTaskId === item.id}}"
                  loading="{{reExportingTaskId === item.id}}"
                  bindtap="onReExport"
                >{{reExportingTaskId === item.id ? '提交中' : '重新导出'}}</button>
                <view class="secondary-divider"></view>
                <button
                  class="secondary-action secondary-action-danger"
                  hover-class="secondary-action-pressed"
                  data-id="{{item.id}}"
                  disabled="{{deletingTaskId === item.id}}"
                  loading="{{deletingTaskId === item.id}}"
                  bindtap="onDelete"
                >{{deletingTaskId === item.id ? '删除中' : '删除记录'}}</button>
              </view>
            </block>

            <!-- Failed -->
            <block wx:elif="{{item.status === 'failed'}}">
              <view class="two-actions">
                <button
                  wx:if="{{item.hasPreviousFile}}"
                  class="action-btn action-btn-secondary"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  bindtap="onPreview"
                >预览旧版</button>
                <button
                  wx:else
                  class="action-btn action-btn-primary"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{retryingTaskId === item.id}}"
                  loading="{{retryingTaskId === item.id}}"
                  bindtap="onRetry"
                >{{retryingTaskId === item.id ? '提交中' : '重试导出'}}</button>
                <button
                  class="action-btn action-btn-subtle action-btn-danger-text"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{deletingTaskId === item.id}}"
                  loading="{{deletingTaskId === item.id}}"
                  bindtap="onDelete"
                >{{deletingTaskId === item.id ? '删除中' : '删除记录'}}</button>
              </view>
            </block>

            <!-- Expired -->
            <block wx:elif="{{item.status === 'expired'}}">
              <view class="two-actions">
                <button
                  class="action-btn action-btn-primary"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{reExportingTaskId === item.id}}"
                  loading="{{reExportingTaskId === item.id}}"
                  bindtap="onReExport"
                >{{reExportingTaskId === item.id ? '提交中' : '重新导出'}}</button>
                <button
                  class="action-btn action-btn-subtle action-btn-danger-text"
                  hover-class="button-pressed"
                  data-id="{{item.id}}"
                  disabled="{{deletingTaskId === item.id}}"
                  loading="{{deletingTaskId === item.id}}"
                  bindtap="onDelete"
                >{{deletingTaskId === item.id ? '删除中' : '删除记录'}}</button>
              </view>
            </block>
          </view>
        </view>

        <view wx:if="{{loading}}" class="loading-more">
          <view class="loading-spinner"></view>
          <text>正在加载更多</text>
        </view>
        <view wx:elif="{{!hasMore}}" class="no-more">
          <view class="no-more-line"></view>
          <text>已经到底了</text>
          <view class="no-more-line"></view>
        </view>
      </block>

      <view class="safe-bottom-space"></view>
    </view>
  </scroll-view>

  <!-- Unified custom dialog -->
  <view wx:if="{{dialogVisible}}" class="dialog-layer" catchtouchmove="onDialogMaskTap">
    <view class="dialog-mask" bindtap="onDialogMaskTap"></view>
    <view class="custom-dialog dialog-tone-{{dialogTone}}" catchtap="onDialogPanelTap">
      <text class="dialog-title">{{dialogTitle}}</text>
      <text class="dialog-content">{{dialogContent}}</text>
      <view class="dialog-actions {{!dialogShowCancel ? 'dialog-actions-single' : ''}}">
        <button
          wx:if="{{dialogShowCancel}}"
          class="dialog-button dialog-button-cancel"
          hover-class="dialog-button-pressed"
          bindtap="onDialogCancel"
        >{{dialogCancelText}}</button>
        <button
          class="dialog-button dialog-button-confirm dialog-button-confirm-{{dialogTone}}"
          hover-class="dialog-button-pressed"
          bindtap="onDialogConfirm"
        >{{dialogConfirmText}}</button>
      </view>
    </view>
  </view>
</view>
