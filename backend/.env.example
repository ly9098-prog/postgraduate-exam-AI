# 2240AI — 环境变量配置

# --- 通用 ---
APP_ENV=development                    # development | production
APP_SECRET=change-me-in-production     # 生产环境请使用 64 位随机字符串
PROCESS_ROLE=all                       # web | worker | scheduler | all（all 仅开发环境）
DEPLOYMENT_PROFILE=                    # "local_import" | "cloud_api" — 显式覆盖 APP_ENV 行为
JWT_EXPIRE_DAYS=7
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- 数据库 ---
# 开发环境（SQLite）
# 注意：SQLite 的相对路径会跟随启动时 cwd；本地调试建议改成绝对路径，避免在不同目录启动时读到不同的 DB。
DATABASE_URL=sqlite+aiosqlite:///./postgraduate.db
# 生产环境（PostgreSQL，部署时取消注释）
# DATABASE_URL=postgresql+asyncpg://pguser:pgpass@localhost:5432/postgraduate

# --- 数据库连接池（生产按角色拆分） ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# 每角色覆盖（web/worker/scheduler 进程各自设置）
# DB_POOL_SIZE_WEB=3
# DB_MAX_OVERFLOW_WEB=5
# DB_POOL_SIZE_WORKER=2
# DB_MAX_OVERFLOW_WORKER=3
# DB_POOL_SIZE_SCHEDULER=1
# DB_MAX_OVERFLOW_SCHEDULER=2
# PostgreSQL 最大连接数（用于启动校验）
# MAX_CONNECTIONS=50

# --- Redis（生产必需） ---
# REDIS_URL=redis://localhost:6379/0
# 任务队列内存降级开关（仅 local_import 开发环境可用，production 强制禁用）
# ALLOW_IN_MEMORY_TASK_QUEUE=false

# --- AI (DeepSeek) ---
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_TIMEOUT=60
# AI_DAILY_TOKEN_LIMIT=50000

# --- 文本导入 LLM 结构化层 ---
# TEXT_IMPORT_LLM_ENABLED=true
# TEXT_IMPORT_LLM_MODEL=deepseek-v4-flash
# TEXT_IMPORT_LLM_DAILY_TOKEN=50000
# TEXT_IMPORT_LLM_MAX_BLOCK_CHARS=6000

# --- AI 模型配置加密 ---
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_CONFIG_ENCRYPT_KEY=

# --- 微信小程序 ---
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret

# --- CORS ---
# CORS_ORIGINS=["https://your-domain.com"]

# --- Worker 内部认证 ---
# INTERNAL_API_KEY=

# --- OCR ---
OCR_ENABLED=false
# OCR_EXECUTION_BACKEND=paddlex_http       # "local_process" | "paddlex_http" | "disabled"
OCR_USE_GPU=false                          # cloud_api/production 必须 false
# OCR_REMOTE_URL=http://127.0.0.1:8080/ocr # PaddleOCR-VL 外部 API 地址
# OCR_REMOTE_TOKEN=                        # 外部 OCR API 认证 token
# OCR_REMOTE_MAX_CONCURRENCY=1             # cloud 建议 1
# OCR_REMOTE_CONNECT_TIMEOUT_SEC=5.0
# OCR_REMOTE_READ_TIMEOUT_SEC=600.0
# OCR_MAX_WORKERS=2
# OCR_EXECUTOR_WORKERS=2
# OCR_MAX_CONCURRENCY=2
# OCR_MAX_QUEUE_SIZE=10
# OCR_TASK_TIMEOUT_SEC=600

# --- PDF 导入 ---
# PDF_MAX_FILE_SIZE_BYTES=10485760         # cloud: 5MB (5242880)
# PDF_MAX_PAGES=30                         # cloud: 30
# PDF_MAX_PAGE_PIXELS=4096
# PDF_RENDER_PAGE_WINDOW=1                 # 单页窗口：cloud=1, local=0（全部）
# PDF_MAX_RENDER_PAGES_CONCURRENT=1        # cloud: 1
# PDF_RENDER_DPI=150

# --- Staging 存储（生产使用持久卷） ---
# STAGING_STORAGE_DIR=/opt/2240ai-v2/staging
# STAGING_DISK_QUOTA=2147483648            # 2GB

# --- Sentry ---
# SENTRY_DSN=https://key@oXXXX.ingest.us.sentry.io/XXXX
# SENTRY_ENV=development

# --- 批量导题 ---
# BATCH_IMAGE_MAX_FILES=100
# BATCH_IMAGE_DEFAULT_CONCURRENCY=2

# --- 向量搜索 (pgvector) ---
# VECTOR_ENABLED=false
# VECTOR_MODE=off
# VECTOR_ALLOWLIST=
# VECTOR_CACHE_TTL_SEC=300
# VECTOR_TOP_K=100
# VECTOR_SIMILARITY_THRESHOLD=0.15

# --- 数据库备份 ---
# BACKUP_DIR=./backups
# BACKUP_PREFIX=postgraduate
# BACKUP_RETENTION_DAYS=14

# --- Embedding ---
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIM=1024

# --- Gunicorn ---
# GUNICORN_WORKERS=2                       # 2核服务器

# --- COS ---
# COS_BUCKET=
# COS_REGION=
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_ALLOW_LOCAL_FALLBACK=false           # production 必须显式 false

# --- 审计日志清理 ---
# AUDIT_LOG_CLEANUP_ENABLED=true
# AUDIT_LOG_RETENTION_DAYS=180
# AUDIT_LOG_CLEANUP_HOUR_UTC=3
# AUDIT_LOG_CLEANUP_BATCH_SIZE=1000
