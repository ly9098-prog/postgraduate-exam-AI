# 2240AI — 环境变量配置

# --- 通用 ---
APP_ENV=development                    # development | production
APP_SECRET=change-me-in-production     # 生产环境请使用 64 位随机字符串
JWT_EXPIRE_DAYS=7
LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR

# --- 数据库 ---
# 开发环境（SQLite）
# 注意：SQLite 的相对路径会跟随启动时 cwd；本地调试建议改成绝对路径，避免在不同目录启动时读到不同的 DB。
# 例如：DATABASE_URL=sqlite+aiosqlite:////home/yourname/projects/postgraduate-ai/backend/postgraduate.db
DATABASE_URL=sqlite+aiosqlite:///./postgraduate.db
# 生产环境（PostgreSQL，部署时取消注释）
# DATABASE_URL=postgresql+asyncpg://pguser:pgpass@localhost:5432/postgraduate

# --- AI (DeepSeek) ---
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# AI_TIMEOUT=60
# AI_DAILY_TOKEN_LIMIT=50000

# --- 文本导入 LLM 结构化层（仅做格式整理，不补全/不推测） ---
# 在规则解析结构完整度低时（题干为空 / 选项漏检 / 答案标签未解析 / 单行压平 / 多空题误判）
# 调用 LLM 兜底。LLM 输出全部经过反幻觉守门，禁止生成或补全任何字段。
# TEXT_IMPORT_LLM_ENABLED=true             # 关闭后退化为纯规则解析
# TEXT_IMPORT_LLM_MODEL=deepseek-v4-flash  # 与 DEEPSEEK 默认模型保持一致
# TEXT_IMPORT_LLM_DAILY_TOKEN=50000        # 每日 token 预算（独立计数）
# TEXT_IMPORT_LLM_MAX_BLOCK_CHARS=6000     # 单块最大字符上限，超过跳过 LLM

# --- AI 模型配置加密 ---
# 用于加密 admin_ai_model_configs.api_key_encrypted 字段的 Fernet 密钥
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_CONFIG_ENCRYPT_KEY=

# --- 微信小程序 ---
# WECHAT_APP_ID=wx-your-app-id
# WECHAT_APP_SECRET=your-app-secret

# --- CORS（使用凭证请求时必须配置为显式域名） ---
# 本地后台管理前端默认已支持：http://localhost:3000 / http://127.0.0.1:3000
# CORS_ORIGINS=["https://your-domain.com"]

# --- OCR（扫描版 PDF 识别） ---
# OCR_ENABLED=true                       # 关闭可退化为仅文本型 PDF 解析
# OCR_MAX_WORKERS=4                      # OCR 并发线程数
# OCR_LANGUAGE=ch                        # ch=中文，en=英文
# OCR_USE_GPU=false                      # 生产环境如有 GPU 可设为 true

# --- Sentry 异常监控 ---
# SENTRY_DSN=https://key@oXXXX.ingest.us.sentry.io/XXXX
# SENTRY_ENV=development                # development | production | test

# --- 批量导题（多图片） ---
# BATCH_IMAGE_MAX_FILES=100              # 单次最多上传图片数（前后端需同步，见 admin-frontend/.env）
# BATCH_IMAGE_DEFAULT_CONCURRENCY=2      # 默认并发，仍被 clamp 到 1~4

# --- SQLAlchemy 日志与慢查询 ---
# SQL_ECHO=false                          # true 时输出完整 SQL 日志（仅本地调试用）
# SQL_LOG_LEVEL=WARNING                   # sqlalchemy.engine 日志级别：DEBUG | INFO | WARNING
# SLOW_QUERY_MS=500                       # 慢查询阈值（毫秒），<=0 关闭慢查询日志
