                    {"label": "对数定义", "latex": "N = a^{\\log_a N}\\ (a>0,a\\neq1)"},
                    {"label": "积的对数", "latex": "\\log_a(MN) = \\log_a M + \\log_a N"},
                    {"label": "商的对数", "latex": "\\log_a\\left(\\frac{M}{N}\\right) = \\log_a M - \\log_a N"},
                    {"label": "幂的对数", "latex": "\\log_a(M^n) = n\\log_a M"},
                    {"label": "根式的对数", "latex": "\\log_a \\sqrt[n]{M} = \\frac{1}{n}\\log_a M"},
                    {"label": "换底公式", "latex": "\\log_a M = \\frac{\\log_b M}{\\log_b a}"},
                    {"label": "特殊值", "latex": "\\log_a 1 = 0,\\ \\log_a a = 1"}
