                    {"label": "商的乘方", "latex": "\\left(\\frac{a}{b}\\right)^m = \\frac{a^m}{b^m}"},
                    {"label": "负指数", "latex": "a^{-m} = \\frac{1}{a^m}\\ (a \\neq 0)"},
                    {"label": "零指数", "latex": "a^0 = 1\\ (a>0)"}
