                  "formula_blocks": [
                    {"label": "同底数幂乘法", "latex": "a^m \\cdot a^n = a^{m+n}"},
                    {"label": "同底数幂除法", "latex": "a^m \\div a^n = a^{m-n}"},
                    {"label": "幂的乘方", "latex": "(a^m)^n = a^{mn}"},
