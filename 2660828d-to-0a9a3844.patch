@@ -0,0 +1,774 @@
+"""408 专项 AI 老师。
+
+固定动作 + 固定题目版本 + 用户知识状态上下文。考试进行中 fail-closed，
+避免通过通用 AI 端点绕过考试不展示答案/解析的产品边界。
+"""
+
+from __future__ import annotations
+
+import json
+import logging
