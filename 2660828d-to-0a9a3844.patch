+from datetime import datetime
+
+from pydantic import Field, field_validator, model_validator
+
+from app.schemas.base import BaseModel
+
+ERROR_TYPES = (
+    "knowledge_gap",
+    "concept_confusion",
+    "memory_error",
+    "calculation_error",
+    "misread",
+    "reasoning_error",
+    "time_pressure",
+    "careless",
+    "unknown",
+)
