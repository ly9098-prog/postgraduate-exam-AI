+    ? api.getErrorMessage(error)
+    : cleanText(error && error.message)
+  if (raw.includes('exam_in_progress_ai_blocked') || raw.includes('考试进行中')) {
+    return '考试进行中不开放答案型 AI 讲解，请交卷后再使用。'
+  }
+  return raw || '408 AI 老师暂不可用，请稍后重试'
+}
+
