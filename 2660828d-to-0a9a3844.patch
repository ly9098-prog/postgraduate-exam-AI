+            PracticeRecord.user_id == user_id,
+            PracticeRecord.subject_id.in_(core_subject_ids),
+            PracticeRecord.answered_at >= today_start,
+            PracticeRecord.answered_at < tomorrow_start,
+        )
+    )).scalar_one() or 0
+    return int(total), int(today)
