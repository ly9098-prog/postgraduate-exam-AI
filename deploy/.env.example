# 22408AI 生产环境变量（复制为 backend/.env）
# 复制为 backend/.env 并填入真实值

# 应用
APP_ENV=production
APP_SECRET=change-me-to-a-random-string
ENVIRONMENT=production
LOG_LEVEL=info

# 数据库
DATABASE_URL=postgresql+asyncpg://postgraduate:change-me@postgres:5432/postgraduate
POSTGRES_USER=postgraduate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgraduate

# Redis
REDIS_URL=redis://redis:6379/0

# DeepSeek AI
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 微信小程序
WECHAT_APP_ID=wx-xxx
WECHAT_APP_SECRET=xxx

# 生产入口
PRODUCTION_DOMAIN=your-production-domain.example
PRODUCTION_CERT_NAME=your-production-domain.example
CORS_ORIGINS=["https://your-production-domain.example","https://www.your-production-domain.example"]
ALLOWED_HOSTS=["your-production-domain.example","www.your-production-domain.example"]
PUBLIC_BASE_URL=https://your-production-domain.example
HEALTH_HOST=your-production-domain.example

# OCR
OCR_ENABLED=false
OCR_EXECUTION_BACKEND=disabled
# 启用 OCR 时切换为 paddlex_http，并同时填写下列 HTTPS 地址与有效 token。
# OCR_EXECUTION_BACKEND=paddlex_http
# OCR_REMOTE_URL=https://your-ocr-endpoint.example/api/v2/ocr/jobs
# OCR_REMOTE_TOKEN=
OCR_REMOTE_CONNECT_TIMEOUT_SEC=5
OCR_REMOTE_READ_TIMEOUT_SEC=600

# 批量导题（多图片）
BATCH_IMAGE_MAX_FILES=100
BATCH_IMAGE_DEFAULT_CONCURRENCY=2

# SQLAlchemy 日志
SQL_ECHO=false
SQL_LOG_LEVEL=WARNING
SLOW_QUERY_MS=500

# 部署
WORKERS=4
MAX_CONNECTIONS=100
GUNICORN_WORKERS=1

# Vector Search (pgvector)
VECTOR_ENABLED=false
VECTOR_MODE=off                        # off | shadow | allowlist | all
VECTOR_ALLOWLIST=                      # JSON: user ids [1,2] or subjects '["exam408-ds","exam408-os"]'
VECTOR_CACHE_TTL_SEC=300
VECTOR_TOP_K=100
VECTOR_SIMILARITY_THRESHOLD=0.15

# Embedding API (OpenAI-compatible)
EMBEDDING_API_KEY=                     # 与 DEEPSEEK_API_KEY 共用 key 时填相同值
EMBEDDING_BASE_URL=                    # 例如 https://api.deepseek.com
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=30

# --- 数据库备份（PostgreSQL pg_dump custom format） ---
# 备份脚本：scripts/postgres_backup.py（通过 systemd timer 或 crontab 定时执行）
# 文档：docs/postgres_backup.md
BACKUP_DIR=/var/backups/postgraduate       # 备份文件输出目录
BACKUP_PREFIX=postgraduate                 # 备份文件名前缀
BACKUP_RETENTION_DAYS=14                   # 备份保留天数
BACKUP_LOG_FILE=/opt/22408-ai/logs/postgres_backup.log
BACKUP_COMMAND_TIMEOUT_SEC=3600            # pg_dump 超时秒数
BACKUP_COMPRESSION_LEVEL=6                 # pg_dump 压缩级别 (0-9)
BACKUP_LOCK_FILE=/tmp/postgraduate_postgres_backup.lock

# Sentry（可选，不填则禁用）
SENTRY_DSN=

# JWT
JWT_EXPIRE_DAYS=7
