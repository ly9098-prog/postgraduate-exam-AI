# === 2240AI 生产环境变量 ===
# 复制为 backend/.env 并填入真实值

# 应用
APP_ENV=production
APP_SECRET=change-me-to-a-random-string
ENVIRONMENT=production
LOG_LEVEL=info

# 数据库
DATABASE_URL=postgresql+asyncpg://postgraduate:change-me@postgres:5432/postgraduate
POSTGRES_USER=postgraduate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgraduate

# Redis
REDIS_URL=redis://redis:6379/0

# DeepSeek AI
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 微信小程序
WECHAT_APP_ID=wx-xxx
WECHAT_APP_SECRET=xxx

# OCR
OCR_ENABLED=false

# 部署
WORKERS=4
MAX_CONNECTIONS=100
GUNICORN_WORKERS=4

# Sentry（可选，不填则禁用）
SENTRY_DSN=

# JWT
JWT_EXPIRE_DAYS=7
