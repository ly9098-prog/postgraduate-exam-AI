[Unit]
Description=Postgraduate PostgreSQL Database Backup (Docker mode)
Documentation=https://github.com/ly9098-prog/postgraduate-ai
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Environment=DOCKER_CONFIG=/opt/2240ai-v2/.docker
Type=oneshot
WorkingDirectory=/opt/2240ai-v2
ExecStartPre=-/usr/bin/docker compose --profile manual -f /opt/2240ai-v2/deploy/docker-compose.prod.yml --env-file /opt/2240ai-v2/backend/.env build backup
ExecStart=/usr/bin/docker compose --profile manual -f /opt/2240ai-v2/deploy/docker-compose.prod.yml --env-file /opt/2240ai-v2/backend/.env run --rm backup

SyslogIdentifier=pg-backup

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# docker compose 需要写 DOCKER_CONFIG（/root/.docker 被 ProtectHome 只读，
# 故指向 /opt/2240ai-v2/.docker 并加入可写路径）
ReadWritePaths=/var/backups/postgraduate /opt/2240ai-v2/logs /opt/2240ai-v2/.docker

TimeoutStopSec=60
Restart=no
StandardOutput=journal+console
StandardError=journal+console
