[Unit]
Description=Postgraduate PostgreSQL Database Backup
Documentation=https://github.com/ly9098-prog/postgraduate-ai
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot

# === 方案 A：宿主机直接执行（默认） ===
# 前提：宿主机已安装 postgresql-client，Python 虚拟环境位于 /opt/2240ai-v2/.venv
WorkingDirectory=/opt/2240ai-v2
EnvironmentFile=/opt/2240ai-v2/.env
ExecStart=/opt/2240ai-v2/.venv/bin/python scripts/postgres_backup.py

# === 方案 B：Docker Compose 执行（替换上面三行） ===
# 前提：宿主机已安装 docker compose v2，以下路径需根据实际情况调整
# WorkingDirectory=/opt/2240ai-v2
# EnvironmentFile=/opt/2240ai-v2/backend/.env
# ExecStart=/usr/bin/docker compose -f /opt/2240ai-v2/deploy/docker-compose.prod.yml --env-file /opt/2240ai-v2/backend/.env run --rm backup

# 低权限用户运行
User=deploy
Group=deploy

# 日志标识（journalctl -u postgres-backup.service）
SyslogIdentifier=pg-backup

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/backups/postgraduate /opt/2240ai-v2/logs /opt/2240ai-v2/backups

# 资源限制（防止 pg_dump 耗尽系统内存）
CPUQuota=80%
MemoryMax=1G

# 超时：pg_dump 超时由脚本内部 BACKUP_COMMAND_TIMEOUT_SEC 控制，
# 这里设置更大的系统级超时防止 systemd 被意外冻结
TimeoutStopSec=30

# 失败后不自动重启（由 systemd timer 控制下次触发）
Restart=no

# 标准日志也写入 systemd journal
StandardOutput=journal+console
StandardError=journal+console
