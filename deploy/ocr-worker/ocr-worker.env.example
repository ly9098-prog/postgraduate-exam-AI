# OCR Worker Environment Configuration
# Permissions: 0600 (readable only by owner)
# Path: /opt/22408-ai/deploy/ocr-worker/ocr-worker.env

# Production server URL
OCR_WORKER_SERVER_URL=https://your-production-domain.example

# Worker identity — must match credential registered on server
OCR_WORKER_ID=local-ocr-01

# Worker API key — generated by `python -m app.services.worker_credential_service:generate_key`
# Store only the raw key here. Server stores the SHA-256 hash.
OCR_WORKER_API_KEY=

# Concurrency (must be 1 for single-GPU)
OCR_WORKER_CONCURRENCY=1

# Workspace path (must have 20GB+ free space)
OCR_WORKER_WORKSPACE=/data/ocr-worker
OCR_WORKER_MAX_WORKSPACE_GB=20
OCR_WORKER_RESULT_RETENTION_HOURS=72

# Polling/lease timing
OCR_WORKER_POLL_INTERVAL_SECONDS=5
OCR_WORKER_LEASE_SECONDS=300
OCR_WORKER_HEARTBEAT_SECONDS=45

# Process management
OCR_WORKER_MAX_TASKS_PER_CHILD=20
OCR_WORKER_OCR_TIMEOUT_SECONDS=600

# GPU resource limits (RTX 3050 = 4096 MB total, leaving ~500MB headroom)
OCR_WORKER_GPU_MEMORY_LIMIT_MB=3600
OCR_WORKER_CPU_FALLBACK=false

# Adapter mode: "conversion_shadow" | "adapter"
LOCAL_OCR_ADAPTER_MODE=conversion_shadow

# Circuit breaker state persistence path
OCR_WORKER_CIRCUIT_BREAKER_PATH=/data/ocr-worker/.circuit_breaker.json
