[Unit]
Description=22408AI Local OCR Worker — deprecated legacy pull-mode daemon
Documentation=https://github.com/ly9098-prog/postgraduate-exam-AI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocr-worker
Group=ocr-worker
WorkingDirectory=/opt/22408-ai/backend

# Use the backend runtime, not the removed WSL GPU venv.
# Current local GPU OCR runs as: WSL backend -> httpx -> Windows PaddleX GPU service.
ExecStart=/opt/22408-ai/backend/.venv/bin/python \
    -m app.ocr_worker.daemon \
    --server https://your-production-domain.example \
    --worker-id local-ocr-01

# Environment file (0600 permissions required)
EnvironmentFile=/opt/22408-ai/deploy/ocr-worker/ocr-worker.env

# Logging
StandardOutput=journal
StandardError=journal

# Resource limits
LimitNOFILE=65536
LimitNPROC=64

# CPU/Restart
CPUSchedulingPolicy=other
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# OOM prevention
OOMScoreAdjust=500

# Runtime isolation
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
