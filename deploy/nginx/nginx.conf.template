upstream backend {
    server app:8000;
    keepalive 32;
}

upstream admin_frontend {
    server admin:3000;
    keepalive 16;
}

# Admin 文档防旧构建滞留（2026-11-07，详见 docs/project/BUGS_HISTORY.md 同日条目）：
# Next 预渲染 HTML 自带 cache-control: s-maxage=31536000（仅约束共享缓存），
# 浏览器会对 HTML 启发式缓存；部署重建 admin 镜像后旧 chunk 随旧构建消失，
# 旧标签页继续执行旧代码并引用 404 资源（Illegal invocation / This page couldn't load）。
# 此处按上游 Content-Type 对文档类响应追加 no-cache，强制部署后浏览器重取 HTML
# （新 HTML 引用新 chunk）。/_next/static 哈希资源仍由 Next 自带 immutable 长缓存，
# 不受影响；add_header 空值不发送头，JSON/JS/图片/事件流响应均无变化。
# 用正则匹配是因为实际响应带 charset 后缀（text/html; charset=utf-8），精确匹配会漏。
map $upstream_http_content_type $admin_doc_cache_control {
    default              "";
    ~*^text/html         "no-cache";
    ~*^text/x-component  "no-cache";
}

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name ${PRODUCTION_DOMAIN} www.${PRODUCTION_DOMAIN} api.${PRODUCTION_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${PRODUCTION_DOMAIN} www.${PRODUCTION_DOMAIN} api.${PRODUCTION_DOMAIN};

    ssl_certificate     /etc/nginx/ssl/${PRODUCTION_CERT_NAME}.pem;
    ssl_certificate_key /etc/nginx/ssl/${PRODUCTION_CERT_NAME}.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # 安全头
    add_header Strict-Transport-Security "max-age=63072000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    # CSP（Next.js App Router 需要 script/style 'unsafe-inline'；无 'unsafe-eval'）
    # 题目/选项图片以绝对 URL（https://${PRODUCTION_DOMAIN}/static/...）存储；页面可能经
    # www/api 子域访问，此时 'self' 源与资源源不同，须显式放行资源源。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://${PRODUCTION_DOMAIN} https://www.${PRODUCTION_DOMAIN} https://api.${PRODUCTION_DOMAIN}; font-src 'self' data:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # Admin 文档 no-cache：仅对 HTML/RSC 生效（map 空值不发送头），与上面的安全头同级，
    # 避免 location 级 add_header 覆盖继承（nginx add_header 继承规则：location 有自己的
    # add_header 时 server 级全部失效，故不可写进 location）。
    add_header Cache-Control $admin_doc_cache_control always;

    client_max_body_size 20M;

    gzip on;
    gzip_types application/json text/plain;
    gzip_min_length 256;

    # 健康检查（不记录日志）
    # 内部详细健康/指标端点仅允许内网访问（同主机 Docker 网络 / 私有网段）。
    # compose 健康探针只用 /health/live，不受影响。若后续接入外部 LB 探活，
    # 需把 LB 出口 IP 加入 allow 列表。
    location = /health/metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
    }

    location = /health/ready {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    location /health {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        access_log off;
    }

    # Admin frontend
    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        proxy_pass http://admin_frontend/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # API
    location /static/formulas/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /static/question-assets/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /static/avatars/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Export task WebSocket — must be before general /api/ block
    # because it needs HTTP/1.1, Upgrade, and long timeouts.
    location /api/v1/exports/ws {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }

    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
        proxy_connect_timeout 5s;

        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # WebSocket 通用兜底
    location /ws/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        proxy_pass http://admin_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
