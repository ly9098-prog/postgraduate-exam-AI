# 2240AI — Docker Compose 环境变量
# 复制为 .env 并修改

APP_SECRET=change-me-in-production
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OCR（扫描版 PDF 识别，可选）
OCR_ENABLED=true
OCR_MAX_WORKERS=4
OCR_LANGUAGE=ch
OCR_USE_GPU=false

# SQLAlchemy 日志（可选）
# SQL_ECHO=false
# SQL_LOG_LEVEL=WARNING
# SLOW_QUERY_MS=500

# --- PostgreSQL 备份（仅生产环境，开发 SQLite 不需要） ---
# BACKUP_DIR=./backups
# BACKUP_PREFIX=postgraduate
# BACKUP_RETENTION_DAYS=14
# BACKUP_LOG_FILE=logs/postgres_backup.log
# BACKUP_COMMAND_TIMEOUT_SEC=3600
# BACKUP_COMPRESSION_LEVEL=6
