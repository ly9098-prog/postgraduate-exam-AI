# 2240AI — Docker Compose 环境变量
# 复制为 .env 并修改

APP_SECRET=change-me-in-production
WECHAT_APP_ID=
WECHAT_APP_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OCR（扫描版 PDF 识别，可选）
OCR_ENABLED=true
OCR_MAX_WORKERS=4
OCR_LANGUAGE=ch
OCR_USE_GPU=false

# SQLAlchemy 日志（可选）
# SQL_ECHO=false
# SQL_LOG_LEVEL=WARNING
# SLOW_QUERY_MS=500

# --- 错题导出 PDF ---
# EXPORT_POLL_INTERVAL_SEC=5
# EXPORT_PROCESSING_TIMEOUT_SEC=900
# EXPORT_MAX_CONCURRENT=1
# EXPORT_DIR=static/exports
# PRODUCT_NAME=MemoGrad
# EXPORT_DOCX_ENABLED=true        # Word 格式开关
# EXPORT_WEBSOCKET_ENABLED=true   # 实时推送开关

# --- 进程角色（web / worker / scheduler / all）---
# PROCESS_ROLE=web
