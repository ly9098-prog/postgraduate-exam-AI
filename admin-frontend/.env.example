# 统一环境模板：复制为 .env.development / .env.production / .env.test
# 详见 .env.development.example、.env.production.example、.env.test.example
ADMIN_API_ORIGIN=http://localhost:8000
NEXT_PUBLIC_ADMIN_API_BASE_URL=/api/admin/v1
NEXT_PUBLIC_API_BASE=
# 批量导题（需与后端 BATCH_IMAGE_* 保持一致；前端仅做 UX 提示/截断，后端为强校验兜底）
NEXT_PUBLIC_BATCH_IMAGE_MAX_FILES=100
NEXT_PUBLIC_BATCH_IMAGE_DEFAULT_CONCURRENCY=2
